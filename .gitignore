# Local macOS debris and Python bytecode caches
.DS_Store
__pycache__/
*.pyc

# Generated Rust build output and packaged editor extensions
/compiler/target
/dev-server/target

# Package-local Cargo/native/Wasm build output
/packages/**/target/

# Node workspace output
node_modules/
/.pnpm-store/
.turbo/
# Stray tsc emits next to sources (no package emits outside dist/;
# test/ keeps one tracked .js worker)
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts.map
packages/*/dist/
packages/*/coverage/
coverage/
.wrangler/
.mf/
miniflare.sqlite*
*.tsbuildinfo
editors/vscode/out/
# Playwright run output; keep authored references and screenshot baselines.
test-results/
playwright-report/
**/playwright/.cache/
**/playwright/results/
**/playwright/screenshots/

# Ad hoc browser previews; curated captures live beside the app's tests.

# Generated release inventory
dist-manifest.json

# Local worker worktrees
/.worktrees/

# Build-generation tooling state (candidates, journals, leases, ledgers)
.can/

# Offline Soda tool archives and disposable integration state
/.artifacts/

# Generated root output
/output/

/host/target/
