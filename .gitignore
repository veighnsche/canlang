# Local macOS debris and Python bytecode caches
.DS_Store
__pycache__/
*.pyc

# Generated Rust build output and packaged editor extensions
/compiler/target/
/output/editor/*.vsix

# Package-local Cargo/native/Wasm build output
/packages/**/target/

# Node workspace output (lane 07)
node_modules/
/.pnpm-store/
.turbo/
# Stray tsc emits next to sources (no package emits outside dist/;
# PR22 pollution guard — test/ keeps one tracked .js worker, untouched)
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts.map
packages/*/dist/
packages/*/coverage/
coverage/
.wrangler/
.mf/
miniflare.sqlite*
*.tsbuildinfo
editors/vscode/out/
# Playwright run output (lane 07 e2e)
test-results/
playwright-report/
playwright/.cache/
/output/prompt-pipeline/playwright/

# B5 release verification artifact (regenerate: bun run release)
dist-manifest.json
/output/release-artifacts/

# Local worker worktrees
/.worktrees/

# Build-generation tooling state (candidates, journals, leases, ledgers)
.can/

# Generated artifacts removed by the 2026-10-14 history cleanup.
/output/build-in-public/
/implementation/compiler-completion/corpus-admission/independent-review/probe
/docs/research/**/*.log
/docs/research/**/*.stdout
/docs/research/**/*.stderr
/implementation/**/*.log
/implementation/**/*.stdout
/implementation/**/*.stderr
