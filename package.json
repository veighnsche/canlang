{
  "name": "canlang",
  "version": "0.1.0",
  "private": true,
  "description": "CanLang: AI-native SaaS DSL on workerd. Root Node workspace (lane 07 integrates).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/contracts packages/cloudflare packages/testkit",
    "build:joins": "npm run build -w @canlang/values",
    "typecheck": "tsc -p tsconfig.check.json",
    "pretest": "npm run build && npm run build:joins",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config=playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
