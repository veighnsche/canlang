{
  "name": "canlang",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "CanLang: AI-native SaaS DSL on workerd. Root bun workspace (lane 07 integrates).",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/run-tasks.mjs build",
    "build:joins": "node scripts/run-tasks.mjs build --filter=@canlang/values",
    "release:stamp": "node ./packages/cloudflare/dist/release/stamp.js",
    "release:manifest": "node ./packages/cloudflare/dist/release/manifest.js",
    "release:verify": "node ./packages/cloudflare/dist/release/manifest.js --verify",
    "release": "node scripts/run-tasks.mjs release:verify",
    "release:pack": "node scripts/run-tasks.mjs release:pack:run",
    "release:pack:run": "node scripts/pack-release.mjs",
    "typecheck": "node scripts/run-tasks.mjs typecheck:check typecheck:root",
    "typecheck:e2e": "node scripts/run-tasks.mjs typecheck:e2e:check",
    "test": "node scripts/run-tasks.mjs test:root",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-tasks.mjs test:e2e:run",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "test:boundaries": "node --test scripts/check-package-boundaries.test.mjs",
    "verify:installed-types": "node scripts/verify-installed-types.mjs",
    "build:uncached": "node scripts/run-tasks.mjs build --cache=",
    "typecheck:root": "tsc -p tsconfig.check.json",
    "typecheck:e2e:check": "tsc -p tests/e2e/tsconfig.json",
    "test:root": "vitest run",
    "test:ci": "node scripts/run-tasks.mjs test:ci:run",
    "test:ci:run": "node --test .github/ci/*.test.mjs",
    "test:packages": "node scripts/run-tasks.mjs test:unit --concurrency=1",
    "test:all": "node scripts/run-tasks.mjs test:root test:unit test:runtime --concurrency=1",
    "test:e2e:run": "playwright test --config=playwright.config.ts",
    "catalog": "node scripts/run-tasks.mjs catalog:emit --filter=@canlang/values",
    "verify:turbo-cache": "node scripts/verify-turbo-cache.mjs",
    "build:compiler": "node scripts/run-tasks.mjs native:compiler:build",
    "test:compiler": "node scripts/run-tasks.mjs native:compiler:test",
    "lint:compiler": "node scripts/run-tasks.mjs native:compiler:lint",
    "native:compiler:build": "cargo build --locked --manifest-path compiler/Cargo.toml",
    "native:compiler:test": "cargo test --locked --manifest-path compiler/Cargo.toml",
    "native:compiler:lint": "cargo fmt --manifest-path compiler/Cargo.toml --check && cargo clippy --locked --manifest-path compiler/Cargo.toml --all-targets -- -D warnings",
    "test:tools": "node scripts/run-tasks.mjs tools:jev",
    "tools:jev": "python3 -m unittest discover -s tools -p test_jev.py",
    "build:values-wasm": "node scripts/run-tasks.mjs build:semantics --filter=@canlang/values",
    "build:work-wasm": "node scripts/run-tasks.mjs build:wasm --filter=@canlang/work-kernel"
  },
  "devDependencies": {
    "@canlang/cloudflare": "workspace:*",
    "@canlang/contracts": "workspace:*",
    "@canlang/testkit": "workspace:*",
    "@canlang/values": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "24.19.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@canlang/work-kernel": "workspace:*",
    "@canlang/identity": "workspace:*",
    "@canlang/ui": "workspace:*",
    "@canlang/interfaces": "workspace:*",
    "@canlang/state": "workspace:*",
    "@canlang/services": "workspace:*",
    "@canlang/files": "workspace:*",
    "@canlang/work": "workspace:*",
    "@canlang/stdlib": "workspace:*",
    "turbo": "2.11.7"
  }
}
