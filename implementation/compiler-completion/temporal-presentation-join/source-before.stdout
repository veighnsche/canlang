 {other}}\"@{}\n message styled(x:date) = \"{x,date,short}|{x,date,medium}|{x,date,long}|{x,date,full}\"@{}\n message pair(x:date,later:text) = \"{x,date}|{later}\"@{}\n message defaults(x:date=date(\"0001-01-01\"),at:datetime=now,later:text=\"D\") = \"{x,date}|{at,time,short}|{later}\"@{}\n message inherited(x:date=date(\"0001-01-01\"),second:date=x) = \"{x,date}|{second,date}\"@{}\n message hygiene(c:date,class:text,await:datetime) = \"{c,date}|{class}|{await,time,short}\"@{}\n derive direct(v:Inputs):pair = pair(x=v.first,later=v.later)\n derive named(v:Inputs):pair = pair(later=v.later,x=v.first)\n derive defaulted():defaults = defaults()\n derive supplied_before_default(v:Inputs):defaults = defaults(x=v.first,later=v.later)\n derive supplied_defaults(v:Inputs):defaults = defaults(at=v.instant,later=v.later,x=v.first)\n derive dependent_default():inherited = inherited()\n derive override_default(v:Inputs):inherited = inherited(x=v.first)\n derive native_identity(x:date):date = x\n derive nested(v:Inputs):pair = pair(later=v.later,x=native_identity(v.first))\n derive reserved(v:Inputs):hygiene = hygiene(await=v.instant,class=v.later,c=v.first)\n derive decimal_operand(v:Inputs):number = number(v.amount)\n derive datetime_operand(v:Inputs):clock = clock(v.instant)\n derive construction(v:Inputs,raw:text):pair = pair(x=date(raw),later=v.later)\n derive instant_construction(raw:text):clock = clock(datetime(raw))\nWhen\nThen\n page /date0001 title=\"Temporal\"\n  text calendar(x=date(\"0001-01-01\"))\n page /date0099 title=\"Temporal\"\n  text calendar(x=date(\"0099-01-01\"))\n page /date2001 title=\"Temporal\"\n  text calendar(x=date(\"2001-01-01\"))\n page /date2024 title=\"Temporal\"\n  text calendar(x=date(\"2024-02-29\"))\n page /instant title=\"Temporal\"\n  text clock(x=datetime(\"2024-03-31T22:30:00Z\"))\n page /offset title=\"Temporal\"\n  text clock(x=datetime(\"2024-03-31T22:30:00+02:00\"))\n page /instant0001 title=\"Temporal\"\n  text clock(x=datetime(\"0001-01-01T00:00:00Z\"))\n page /instant0099 title=\"Temporal\"\n  text clock(x=datetime(\"0099-01-01T00:00:00Z\"))\n page /decimal title=\"Temporal\"\n  text number(x=1.50)\n page /decimalexact title=\"Temporal\"\n  text number(x=12345678901234567890.123456789012345678)\n page /integer title=\"Temporal\"\n  text integer(x=2)\n page /ordinal title=\"Temporal\"\n  text ordinal(x=2)\n page /styles title=\"Temporal\"\n  text styled(x=date(\"0004-02-29\"))\n"],"names":["page /date0001","page /date0099","page /date2001","page /date2024","page /instant","page /offset","page /instant0001","page /instant0099","page /decimal","page /decimalexact","page /integer","page /ordinal","page /styles","appDefinition","TemporalPresentation.direct","TemporalPresentation.named","TemporalPresentation.defaulted","TemporalPresentation.supplied_before_default","TemporalPresentation.supplied_defaults","TemporalPresentation.dependent_default","TemporalPresentation.override_default","TemporalPresentation.native_identity","TemporalPresentation.nested","TemporalPresentation.reserved","TemporalPresentation.decimal_operand","TemporalPresentation.datetime_operand","TemporalPresentation.construction","TemporalPresentation.instant_construction","canApp"],"mappings":"AAAA;AAAA;AAAA;AA8BIA;AAAAA;AAEiCC;AAAAA;AAEAC;AAAAA;AAEAC;AAAAA;AAEAC;AAAAA;AAEWC;AAAAA;AAEKC;AAAAA;AAELC;AAAAA;AAEAC;AAAAA;AAE3BC;AAAAA;AAEmCC;AAAAA;AAErCC;AAAAA;AAEAC;AAAAA;AAtDnBC;AAeOC;AACAC;AACAC;AACAC;AACAC;AACAC;AACAC;AACAC;AACAC;AACAC;AACAC;AACAC;AACAC;AACAC;AA5BPC;AAAAA;AAeOd;AACAC;AACAC;AACAC;AACAC;AACAC;AACAC;AACAC;AACAC;AACAC;AACAC;AACAC;AACAC;AACAC;AA5BPC"}}],"callables":[{"id":"TemporalPresentation.direct","kind":"pure","module":"$can$m$54656d706f72616c50726573656e746174696f6e.mjs","export":"$can$s$54656d706f72616c50726573656e746174696f6e2e646972656374","member":["TemporalPresentation.direct"]},{"id":"TemporalPresentation.named","kind":"pure","module":"$can$m$54656d706f72616c50726573656e746174696f6e.mjs","export":"$can$s$54