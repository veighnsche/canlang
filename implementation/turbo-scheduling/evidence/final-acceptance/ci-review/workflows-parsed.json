{
  ".github/workflows/b1-join.yml": {
    "name": "b1-join",
    "true": {
      "pull_request": {
        "paths": [
          "compiler/**",
          "packages/values/**",
          "packages/contracts/src/artifact.ts",
          "examples/TeamTasks.can",
          ".github/workflows/b1-join.yml"
        ]
      },
      "push": {
        "branches": [
          "main"
        ],
        "paths": [
          "compiler/**",
          "packages/values/**",
          "packages/contracts/src/artifact.ts",
          "examples/TeamTasks.can",
          ".github/workflows/b1-join.yml"
        ]
      }
    },
    "jobs": {
      "build-catalog": {
        "runs-on": "ubuntu-latest",
        "steps": [
          {
            "uses": "actions/checkout@v4"
          },
          {
            "uses": "actions/setup-node@v4",
            "with": {
              "node-version": "24"
            }
          },
          {
            "uses": "oven-sh/setup-bun@v2",
            "with": {
              "bun-version": "1.4.2"
            }
          },
          {
            "name": "Install from lock",
            "run": "bun install --frozen-lockfile"
          },
          {
            "name": "Build values dist and emit catalog",
            "run": "bun run catalog"
          },
          {
            "name": "Print catalog version and entry count",
            "run": "node -e \"const c = require('./packages/values/dist/catalog.json'); console.log('catalog', c.catalog_version + ':', c.entries.length, 'entries,', c.features.length, 'features');\""
          },
          {
            "name": "Upload catalog",
            "uses": "actions/upload-artifact@v4",
            "with": {
              "name": "values-catalog",
              "path": "packages/values/dist/catalog.json"
            }
          }
        ]
      },
      "b1-gate": {
        "runs-on": "ubuntu-latest",
        "needs": "build-catalog",
        "steps": [
          {
            "uses": "actions/checkout@v4"
          },
          {
            "uses": "dtolnay/rust-toolchain@89b12181fb390509a0842a86cc55eeb8eb928c1d",
            "with": {
              "toolchain": "1.99.0"
            }
          },
          {
            "uses": "actions/setup-node@v4",
            "with": {
              "node-version": "24"
            }
          },
          {
            "uses": "oven-sh/setup-bun@v2",
            "with": {
              "bun-version": "1.4.2"
            }
          },
          {
            "name": "Download catalog into dist",
            "uses": "actions/download-artifact@v4",
            "with": {
              "name": "values-catalog",
              "path": "packages/values/dist/"
            }
          },
          {
            "name": "B1 join test (must PASS STRICT, not skip)",
            "run": "set -o pipefail\ncargo test --locked --test b1_join -- --nocapture 2>&1 | tee /tmp/b1_join.log\ngrep -q \"2 passed\" /tmp/b1_join.log || { echo \"FAIL: b1_join did not pass both joins\"; exit 1; }\ngrep -q \"SKIP b1_teamtasks_artifact\\|SKIP b2_expenseflow_artifact\" /tmp/b1_join.log && { echo \"FAIL: b1_join SKIPPED (catalog missing?) — strict proof required\"; exit 1; }\necho \"proves: b1_join passed STRICT against the real catalog (both joins, zero SKIP)\"\n",
            "working-directory": "compiler"
          },
          {
            "name": "Build can",
            "run": "cargo build --locked",
            "working-directory": "compiler"
          },
          {
            "name": "Honest-gap pin (exit 10, 3xE6008, zero other codes)",
            "run": "set +e\n./target/debug/can compile ../examples/TeamTasks.can --catalog ../packages/values/dist/catalog.json > /tmp/team_tasks.log 2>&1\ncode=$?\ncat /tmp/team_tasks.log\n[ \"$code\" -eq 10 ] || { echo \"FAIL: expected exit 10, got $code\"; exit 1; }\ne6008=$(grep -c \"E6008\" /tmp/team_tasks.log)\n[ \"$e6008\" -eq 3 ] || { echo \"FAIL: expected exactly 3 E6008 lines, got $e6008\"; exit 1; }\nother=$(grep -oE \"E[0-9]{4}\" /tmp/team_tasks.log | grep -v \"E6008\" | wc -l)\n[ \"$other\" -eq 0 ] || { echo \"FAIL: $other non-E6008 error codes present\"; exit 1; }\necho \"proves: TeamTasks.can exits 10 with exactly 3 E6008 (tooltip/delete/collapse) and zero other codes\"\n",
            "working-directory": "compiler"
          }
        ]
      }
    }
  },
  ".github/workflows/b2-join.yml": {
    "name": "b2-join",
    "true": {
      "pull_request": {
        "paths": [
          "tests/integration/b2-*.ts",
          "packages/testkit/src/fixtures/b2-*.ts",
          "packages/testkit/src/fixtures/playback*.ts",
          "packages/services/src/scenarios.ts",
          "packages/services/src/mail/**",
          "packages/services/src/http/**",
          "packages/state/src/storage/**",
          "packages/identity/src/**",
          "packages/contracts/src/examples.ts",
          "packages/contracts/src/services.ts",
          "packages/contracts/src/state.ts",
          "packages/contracts/src/identity.ts",
          "packages/cloudflare/src/dev/**",
          "vitest.config.ts",
          ".github/workflows/b2-join.yml"
        ]
      },
      "push": {
        "branches": [
          "main"
        ],
        "paths": [
          "tests/integration/b2-*.ts",
          "packages/testkit/src/fixtures/b2-*.ts",
          "packages/testkit/src/fixtures/playback*.ts",
          "packages/services/src/scenarios.ts",
          "packages/services/src/mail/**",
          "packages/services/src/http/**",
          "packages/state/src/storage/**",
          "packages/identity/src/**",
          "packages/contracts/src/examples.ts",
          "packages/contracts/src/services.ts",
          "packages/contracts/src/state.ts",
          "packages/contracts/src/identity.ts",
          "packages/cloudflare/src/dev/**",
          "vitest.config.ts",
          ".github/workflows/b2-join.yml"
        ]
      }
    },
    "jobs": {
      "build": {
        "runs-on": "ubuntu-latest",
        "steps": [
          {
            "uses": "actions/checkout@v4"
          },
          {
            "uses": "actions/setup-node@v4",
            "with": {
              "node-version": "24"
            }
          },
          {
            "uses": "oven-sh/setup-bun@v2",
            "with": {
              "bun-version": "1.4.2"
            }
          },
          {
            "name": "Install from lock",
            "run": "bun install --frozen-lockfile"
          },
          {
            "name": "Build lane-07 dists",
            "run": "bun run build"
          },
          {
            "name": "Build values join producers",
            "run": "bun run build:joins"
          },
          {
            "name": "Print dist versions",
            "run": "node -e \"for (const p of ['contracts','cloudflare','testkit']) { const m = require('./packages/' + p + '/package.json'); console.log('@canlang/' + p, m.version); }\""
          },
          {
            "name": "Pack dists",
            "run": "tar -czf /tmp/b2-dists.tgz packages/*/dist"
          },
          {
            "name": "Upload dists",
            "uses": "actions/upload-artifact@v4",
            "with": {
              "name": "b2-dists",
              "path": "/tmp/b2-dists.tgz"
            }
          }
        ]
      },
      "b2-gate": {
        "runs-on": "ubuntu-latest",
        "needs": "build",
        "steps": [
          {
            "uses": "actions/checkout@v4"
          },
          {
            "uses": "actions/setup-node@v4",
            "with": {
              "node-version": "24"
            }
          },
          {
            "uses": "oven-sh/setup-bun@v2",
            "with": {
              "bun-version": "1.4.2"
            }
          },
          {
            "name": "Install from lock",
            "run": "bun install --frozen-lockfile"
          },
          {
            "name": "Download and unpack dists",
            "uses": "actions/download-artifact@v4",
            "with": {
              "name": "b2-dists",
              "path": "/tmp/b2-dists"
            }
          },
          {
            "name": "Unpack dists",
            "run": "tar -xzf /tmp/b2-dists/b2-dists.tgz"
          },
          {
            "name": "Typecheck lane-07 sources and assembly",
            "run": "bun run typecheck"
          },
          {
            "name": "B2 journey specs (must PASS, not skip)",
            "run": "set -o pipefail\nbunx vitest run tests/integration/b2-delivery.test.ts tests/integration/b2-d1-fence.test.ts tests/integration/b2-do-local.test.ts tests/integration/b2-revocation.test.ts 2>&1 | tee /tmp/b2_join.log\ngrep -q \"Test Files.*4 passed\" /tmp/b2_join.log || { echo \"FAIL: B2 specs did not pass (skipped or failed)\"; exit 1; }\ngrep -q \"Tests.*4 passed\" /tmp/b2_join.log || { echo \"FAIL: B2 spec count drifted (expected 4 tests passing)\"; exit 1; }\necho \"proves: 4 B2 journey specs passed against the real producers (not skipped)\"\n"
          }
        ]
      }
    }
  },
  ".github/workflows/e2e.yml": {
    "name": "e2e",
    "true": {
      "pull_request": {
        "paths": [
          "tests/e2e/**",
          "playwright.config.ts",
          "package.json",
          "bun.lock",
          "bunfig.toml",
          "turbo.json",
          "scripts/**",
          "tsconfig*.json",
          "compiler/**",
          ".github/workflows/e2e.yml",
          "packages/**",
          "examples/**"
        ]
      },
      "push": {
        "branches": [
          "main"
        ],
        "paths": [
          "tests/e2e/**",
          "playwright.config.ts",
          "package.json",
          "bun.lock",
          "bunfig.toml",
          "turbo.json",
          "scripts/**",
          "tsconfig*.json",
          "compiler/**",
          ".github/workflows/e2e.yml",
          "packages/**",
          "examples/**"
        ]
      },
      "workflow_dispatch": null
    },
    "jobs": {
      "playwright": {
        "runs-on": "ubuntu-latest",
        "steps": [
          {
            "uses": "actions/checkout@v4"
          },
          {
            "uses": "actions/setup-node@v4",
            "with": {
              "node-version": "24"
            }
          },
          {
            "uses": "oven-sh/setup-bun@v2",
            "with": {
              "bun-version": "1.4.2"
            }
          },
          {
            "uses": "dtolnay/rust-toolchain@89b12181fb390509a0842a86cc55eeb8eb928c1d",
            "with": {
              "toolchain": "1.99.0"
            }
          },
          {
            "name": "Install from lock",
            "run": "bun install --frozen-lockfile"
          },
          {
            "name": "Cache Playwright browsers",
            "uses": "actions/cache@v4",
            "with": {
              "path": "~/.cache/ms-playwright",
              "key": "playwright-${{ runner.os }}-${{ hashFiles('bun.lock') }}"
            }
          },
          {
            "name": "Install chromium",
            "run": "bunx playwright install --with-deps chromium"
          },
          {
            "name": "Build lane-07 dists",
            "run": "bun run build"
          },
          {
            "name": "Build compiler for compiled fixtures",
            "run": "bun run build:compiler"
          },
          {
            "name": "Typecheck e2e harness",
            "run": "bun run typecheck:e2e"
          },
          {
            "name": "Run e2e (or report pending)",
            "run": "set -u\nif [ ! -f playwright.config.ts ]; then\n  echo \"e2e pending: playwright.config.ts not yet authored.\"\n  exit 0\nfi\nif [ -z \"$(find tests/e2e -name '*.spec.ts' -print -quit 2>/dev/null)\" ]; then\n  echo \"e2e pending: no tests/e2e specs yet.\"\n  exit 0\nfi\nbun run test:e2e\n"
          }
        ]
      }
    }
  },
  ".github/workflows/integration.yml": {
    "name": "integration",
    "true": {
      "pull_request": null,
      "push": {
        "branches": [
          "main"
        ]
      },
      "workflow_dispatch": null
    },
    "jobs": {
      "workspace": {
        "runs-on": "ubuntu-latest",
        "steps": [
          {
            "uses": "actions/checkout@v4"
          },
          {
            "uses": "actions/setup-node@v4",
            "with": {
              "node-version": "24"
            }
          },
          {
            "uses": "oven-sh/setup-bun@v2",
            "with": {
              "bun-version": "1.4.2"
            }
          },
          {
            "uses": "dtolnay/rust-toolchain@89b12181fb390509a0842a86cc55eeb8eb928c1d",
            "with": {
              "toolchain": "1.99.0"
            }
          },
          {
            "name": "Install from lock",
            "run": "bun install --frozen-lockfile"
          },
          {
            "name": "Build workspace packages",
            "run": "bun run build"
          },
          {
            "name": "Check declared package boundaries",
            "run": "bun run check:boundaries"
          },
          {
            "name": "Test package boundary guard",
            "run": "bun run test:boundaries"
          },
          {
            "name": "Test CI gates and receipt verification",
            "run": "bun run test:ci"
          },
          {
            "name": "Typecheck workspace assembly",
            "run": "bun run typecheck"
          },
          {
            "name": "Build native preparation test prerequisite",
            "env": {
              "CARGO_TARGET_DIR": "${{ runner.temp }}/can-integration-preparation"
            },
            "run": "cargo +1.99.0 build --locked --bin can-preparation --manifest-path packages/cloudflare/preparation/Cargo.toml"
          },
          {
            "name": "Generate catalog for emission fixture",
            "run": "bun run catalog"
          },
          {
            "name": "Test all package and integration suites",
            "env": {
              "CAN_PREPARATION_BIN": "${{ runner.temp }}/can-integration-preparation/debug/can-preparation"
            },
            "run": "bun run test:all"
          },
          {
            "name": "Verify installed package declarations",
            "run": "bun run verify:installed-types --skip-build"
          },
          {
            "name": "Verify installed Worker and assets",
            "run": "bun run verify:installed-worker --skip-build"
          },
          {
            "name": "Verify deterministic library build (B5 reproducibility)",
            "run": "set -euo pipefail\nhash_dist() {\n  local files\n  files=$(find packages/*/dist \\\n    -type f \\( -name '*.js' -o -name '*.d.ts' -o -name '*.map' \\) | sort)\n  if [ -z \"$files\" ]; then\n    echo \"determinism gate: no dist files found\" >&2\n    return 1\n  fi\n  echo \"$files\" | xargs sha256sum | sha256sum\n}\nbun run build:uncached\nhash_dist | tee /tmp/build-first.sha\nrm -rf packages/*/dist \\\n  packages/*/*.tsbuildinfo\nbun run build:uncached\nhash_dist | tee /tmp/build-second.sha\ncmp /tmp/build-first.sha /tmp/build-second.sha\n"
          },
          {
            "name": "Verify Turbo graph and cache restoration in isolation",
            "run": "bun run verify:turbo-cache"
          }
        ]
      },
      "tools": {
        "runs-on": "ubuntu-latest",
        "steps": [
          {
            "uses": "actions/checkout@v4",
            "with": {
              "submodules": "recursive"
            }
          },
          {
            "name": "Run JEV caller tests (mocked, no credentials)",
            "run": "python3 -m unittest discover -s tools -p \"test_jev.py\""
          },
          {
            "name": "Run parser boundary tests (excluding stale corpus test)",
            "run": "python3 -c \"\nimport sys, unittest\nsys.path.insert(0, 'tools')\nimport test_can_parser\nloader = unittest.TestLoader()\nsuite = unittest.TestSuite()\nfor name in loader.getTestCaseNames(test_can_parser.CanParserTests):\n    if 'corpus' not in name:\n        suite.addTest(test_can_parser.CanParserTests(name))\nresult = unittest.TextTestRunner(verbosity=1).run(suite)\nsys.exit(0 if result.wasSuccessful() else 1)\n\"\n"
          },
          {
            "name": "Parse the .can corpus (informational; known prototype drift)",
            "continue-on-error": true,
            "run": "python3 tools/can_parser.py draft examples"
          }
        ]
      }
    }
  },
  ".github/workflows/lane-01.yml": {
    "name": "lane-01 language and toolchain",
    "true": {
      "push": {
        "branches": [
          "muse/lane-01-language/**"
        ],
        "paths": [
          "compiler/**",
          "draft",
          ".gitmodules",
          "editors/vscode/**",
          "packages/contracts/src/artifact.ts",
          "packages/contracts/src/diagnostic.ts",
          ".github/workflows/lane-01.yml"
        ]
      },
      "pull_request": {
        "paths": [
          "compiler/**",
          "draft",
          ".gitmodules",
          "editors/vscode/**",
          "packages/contracts/src/artifact.ts",
          "packages/contracts/src/diagnostic.ts",
          ".github/workflows/lane-01.yml"
        ]
      }
    },
    "jobs": {
      "rust": {
        "runs-on": "ubuntu-latest",
        "steps": [
          {
            "uses": "actions/checkout@v4",
            "with": {
              "submodules": "recursive"
            }
          },
          {
            "uses": "dtolnay/rust-toolchain@89b12181fb390509a0842a86cc55eeb8eb928c1d",
            "with": {
              "toolchain": "1.99.0",
              "components": "rustfmt, clippy"
            }
          },
          {
            "name": "Format check",
            "run": "cargo fmt --check",
            "working-directory": "compiler"
          },
          {
            "name": "Clippy (warnings denied)",
            "run": "cargo clippy --locked --all-targets -- -D warnings",
            "working-directory": "compiler"
          },
          {
            "name": "Build",
            "run": "cargo build --locked",
            "working-directory": "compiler"
          },
          {
            "name": "Test",
            "run": "cargo test --locked",
            "working-directory": "compiler"
          }
        ]
      },
      "contracts": {
        "runs-on": "ubuntu-latest",
        "steps": [
          {
            "uses": "actions/checkout@v4"
          },
          {
            "uses": "actions/setup-node@v4",
            "with": {
              "node-version": "24"
            }
          },
          {
            "uses": "oven-sh/setup-bun@v2",
            "with": {
              "bun-version": "1.4.2"
            }
          },
          {
            "name": "Typecheck owned contract boundaries",
            "run": "bunx -p typescript@5.9.3 tsc --noEmit --strict --skipLibCheck packages/contracts/src/artifact.ts packages/contracts/src/diagnostic.ts"
          }
        ]
      },
      "editor": {
        "runs-on": "ubuntu-latest",
        "steps": [
          {
            "uses": "actions/checkout@v4"
          },
          {
            "uses": "actions/setup-node@v4",
            "with": {
              "node-version": "24"
            }
          },
          {
            "uses": "oven-sh/setup-bun@v2",
            "with": {
              "bun-version": "1.4.2"
            }
          },
          {
            "name": "Validate extension manifests and grammar JSON",
            "run": "node -e \"for (const f of ['editors/vscode/package.json','editors/vscode/syntaxes/can.tmLanguage.json']) { JSON.parse(require('fs').readFileSync(f,'utf8')); console.log('ok', f); }\"\n"
          },
          {
            "name": "Typecheck LSP client (no emit)",
            "run": "mkdir -p /tmp/empty-typeroot\nbunx -p typescript@5.9.3 tsc --noEmit --strict --target es2022 --lib es2022 --typeRoots /tmp/empty-typeroot editors/vscode/src/extension.ts editors/vscode/src/client.ts\n"
          },
          {
            "uses": "dtolnay/rust-toolchain@89b12181fb390509a0842a86cc55eeb8eb928c1d",
            "with": {
              "toolchain": "1.99.0"
            }
          },
          {
            "name": "Build can (debug, for LSP round-trip)",
            "run": "cargo build --locked",
            "working-directory": "compiler"
          },
          {
            "name": "LSP capability round-trip (real binary)",
            "run": "node test/lsp-capabilities.cjs",
            "working-directory": "editors/vscode",
            "env": {
              "CAN_BIN": "${{ github.workspace }}/compiler/target/debug/can"
            }
          }
        ]
      }
    }
  },
