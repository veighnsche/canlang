            "name": "Build and test",
            "working-directory": "packages/state",
            "run": "bun run test"
          }
        ]
      },
      "stdlib": {
        "runs-on": "ubuntu-latest",
        "steps": [
          {
            "uses": "actions/checkout@v4"
          },
          {
            "uses": "actions/setup-node@v4",
            "with": {
              "node-version": "24"
            }
          },
          {
            "uses": "oven-sh/setup-bun@v2",
            "with": {
              "bun-version": "1.4.2"
            }
          },
          {
            "name": "Install workspace",
            "run": "bun install --frozen-lockfile"
          },
          {
            "name": "Build consumed contracts",
            "run": "bun run build --filter=@canlang/contracts"
          },
          {
            "name": "Build @canlang/values",
            "run": "bun run build --filter=@canlang/values"
          },
          {
            "name": "Typecheck stdlib",
            "run": "bun run --filter @canlang/stdlib typecheck"
          },
          {
            "name": "Build and test stdlib",
            "run": "bun run --filter @canlang/stdlib test"
          }
        ]
      }
    }
  },
  ".github/workflows/lane-04.yml": {
    "name": "lane-04",
    "true": {
      "push": {
        "branches": [
          "muse/lane-04-work-services-files/**"
        ],
        "paths": [
          "packages/work/**",
          "packages/services/**",
          "packages/files/**",
          "packages/contracts/src/work.ts",
          "packages/contracts/src/services.ts",
          "packages/contracts/src/files.ts",
          ".github/workflows/lane-04.yml"
        ]
      },
      "pull_request": {
        "paths": [
          "packages/work/**",
          "packages/services/**",
          "packages/files/**",
          "packages/contracts/src/work.ts",
          "packages/contracts/src/services.ts",
          "packages/contracts/src/files.ts",
          ".github/workflows/lane-04.yml"
        ]
      }
    },
    "jobs": {
      "package": {
        "runs-on": "ubuntu-latest",
        "strategy": {
          "fail-fast": false,
          "matrix": {
            "package": [
              "work",
              "services",
              "files"
            ]
          }
        },
        "defaults": {
          "run": {
            "working-directory": "packages/${{ matrix.package }}"
          }
        },
        "steps": [
          {
            "uses": "actions/checkout@v4"
          },
          {
            "uses": "actions/setup-node@v4",
            "with": {
              "node-version": 24
            }
          },
          {
            "uses": "oven-sh/setup-bun@v2",
            "with": {
              "bun-version": "1.4.2"
            }
          },
          {
            "name": "Install workspace",
            "working-directory": ".",
            "run": "bun install --frozen-lockfile"
          },
          {
            "name": "Build consumed contracts",
            "working-directory": ".",
            "run": "bun run build --filter=@canlang/contracts"
          },
          {
            "name": "Build work and files producers",
            "working-directory": ".",
            "run": "case '${{ matrix.package }}' in\n  work) bun run build --filter=@canlang/state ;;\n  files) bun run build --filter=@canlang/services ;;\nesac\n"
          },
          {
            "run": "bun run typecheck"
          },
          {
            "run": "bun run test"
          }
        ]
      }
    }
  },
  ".github/workflows/lane-05.yml": {
    "name": "lane-05",
    "permissions": {
      "contents": "read"
    },
    "true": {
      "push": {
        "branches": [
          "muse/lane-05-ui/**"
        ],
        "paths": [
          "packages/ui/**",
          "packages/contracts/src/presentation.ts",
          ".github/workflows/lane-05.yml"
        ]
      },
      "pull_request": {
        "paths": [
          "packages/ui/**",
          "packages/contracts/src/presentation.ts",
          ".github/workflows/lane-05.yml"
        ]
      }
    },
    "jobs": {
      "check": {
        "runs-on": "ubuntu-latest",
        "timeout-minutes": 10,
        "steps": [
          {
            "uses": "actions/checkout@v4"
          },
          {
            "uses": "actions/setup-node@v4",
            "with": {
              "node-version": 24
            }
          },
          {
            "uses": "oven-sh/setup-bun@v2",
            "with": {
              "bun-version": "1.4.2"
            }
          },
          {
            "name": "Guard package API imports",
            "run": "# Consumers use declared exports; a sibling source path bypasses the producer build.\nif grep -RnE \"(\\.\\./)+contracts/(src|dist)/\" packages/ui/src packages/ui/test; then\n  exit 1\nfi\n"
          },
          {
            "name": "Install workspace",
            "run": "bun install --frozen-lockfile"
          },
          {
            "name": "Build consumed contracts",
            "run": "bun run build --filter=@canlang/contracts"
          },
          {
            "name": "Test owned package",
            "run": "bun run --filter @canlang/ui test"
          }
        ]
      }
    }
  },
