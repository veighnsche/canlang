  ".github/workflows/release.yml": {
    "name": "release",
    "true": {
      "push": {
        "tags": [
          "v*"
        ]
      },
      "workflow_dispatch": null
    },
    "jobs": {
      "rust-binary": {
        "strategy": {
          "matrix": {
            "include": [
              {
                "runner": "ubuntu-latest",
                "name": "can-linux-x86_64"
              },
              {
                "runner": "macos-latest",
                "name": "can-macos-aarch64"
              }
            ]
          }
        },
        "runs-on": "${{ matrix.runner }}",
        "steps": [
          {
            "uses": "actions/checkout@v4"
          },
          {
            "uses": "dtolnay/rust-toolchain@89b12181fb390509a0842a86cc55eeb8eb928c1d",
            "with": {
              "toolchain": "1.99.0"
            }
          },
          {
            "name": "Build can (release, locked)",
            "run": "cargo build --release --locked",
            "working-directory": "compiler"
          },
          {
            "name": "Size report",
            "run": "ls -l target/release/can\nprintf 'bytes=%s\\n' \"$(wc -c < target/release/can | tr -d ' ')\"\n",
            "working-directory": "compiler"
          },
          {
            "name": "Checksums (sha256)",
            "run": "cd compiler/target/release\nshasum -a 256 can > \"SHA256SUMS-${{ matrix.name }}.txt\"\ncat \"SHA256SUMS-${{ matrix.name }}.txt\"\nshasum -a 256 -c \"SHA256SUMS-${{ matrix.name }}.txt\"\n"
          },
          {
            "uses": "actions/upload-artifact@v4",
            "with": {
              "name": "${{ matrix.name }}",
              "path": "compiler/target/release/can\ncompiler/target/release/SHA256SUMS-${{ matrix.name }}.txt\n"
            }
          }
        ]
      },
      "node-libraries": {
        "runs-on": "ubuntu-latest",
        "steps": [
          {
            "uses": "actions/checkout@v4"
          },
          {
            "uses": "actions/setup-node@v4",
            "with": {
              "node-version": "24"
            }
          },
          {
            "uses": "oven-sh/setup-bun@v2",
            "with": {
              "bun-version": "1.4.2"
            }
          },
          {
            "name": "Install from lock",
            "run": "bun install --frozen-lockfile"
          },
          {
            "name": "Build, verify and pack complete workspace artifacts",
            "run": "bun run release:pack"
          },
          {
            "uses": "actions/upload-artifact@v4",
            "with": {
              "name": "node-libraries",
              "path": "output/release-artifacts/*"
            }
          }
        ]
      },
      "editor-bundle": {
        "runs-on": "ubuntu-latest",
        "steps": [
          {
            "uses": "actions/checkout@v4"
          },
          {
            "uses": "actions/setup-node@v4",
            "with": {
              "node-version": "24"
            }
          },
          {
            "uses": "oven-sh/setup-bun@v2",
            "with": {
              "bun-version": "1.4.2"
            }
          },
          {
            "name": "Compile the LSP client (L1 slice 2a sources)",
            "run": "mkdir -p /tmp/empty-typeroot\ncd editors/vscode\nbunx -p typescript@5.9.3 tsc --strict --target es2022 --module commonjs --lib es2022 --typeRoots /tmp/empty-typeroot --outDir out --rootDir src src/extension.ts src/client.ts\n"
          },
          {
            "name": "Archive the VSCode/Cursor extension payload",
            "run": "mkdir -p release-artifacts\ncd editors/vscode\nzip -r ../../release-artifacts/canlang-vscode.zip package.json README.md token-colors.json syntaxes out src\n"
          },
          {
            "name": "Package VS Code extension (vsix)",
            "run": "cd editors/vscode\nnpx -y @vscode/vsce package --out ../../release-artifacts/canlang-vscode.vsix\n"
          },
          {
            "uses": "actions/upload-artifact@v4",
            "with": {
              "name": "editor-bundle",
              "path": "release-artifacts/canlang-vscode.zip\nrelease-artifacts/canlang-vscode.vsix\n"
            }
          }
        ]
      }
    }
  },
  ".github/workflows/ts-gates.yml": {
    "name": "ts-gates",
    "run-name": "TS gates · ${{ inputs.task_id || github.ref_name }} · ${{ inputs.gate || 'values' }}",
    "true": {
      "push": {
        "branches": [
          "codex/ci-gates/**"
        ]
      },
      "workflow_dispatch": {
        "inputs": {
          "source_sha": {
            "description": "Exact committed source SHA to test (empty tests the workflow commit)",
            "type": "string",
            "required": false
          },
          "task_id": {
            "description": "Coordinator task or grant ID for the receipt",
            "type": "string",
            "required": true
          },
          "gate": {
            "description": "Package gate; all runs independent jobs",
            "type": "choice",
            "required": true,
            "default": "values",
            "options": [
              "values",
              "state",
              "stdlib",
              "identity",
              "ui",
              "interfaces",
              "work",
              "cloudflare",
              "testkit",
              "workspace",
              "all"
            ]
          }
        }
      }
    },
    "permissions": {
      "contents": "read"
    },
    "concurrency": {
      "group": "ts-gates-${{ github.ref }}-${{ inputs.source_sha || github.sha }}-${{ inputs.gate || 'values' }}",
      "cancel-in-progress": false
    },
    "jobs": {
      "request": {
        "runs-on": "ubuntu-24.04",
        "timeout-minutes": 5,
        "outputs": {
          "matrix": "${{ steps.request.outputs.matrix }}",
          "source_sha": "${{ steps.request.outputs.source_sha }}",
          "task_id": "${{ steps.request.outputs.task_id }}"
        },
        "steps": [
          {
            "id": "request",
            "name": "Validate finite gate request",
            "env": {
              "REQUEST_SHA": "${{ inputs.source_sha || github.sha }}",
              "REQUEST_GATE": "${{ inputs.gate || 'values' }}",
              "REQUEST_TASK": "${{ inputs.task_id || github.ref_name }}"
            },
            "run": "python3 - <<'PYREQ'\nimport json, os, re\nprofiles = ['values', 'state', 'stdlib', 'identity', 'ui', 'interfaces', 'work', 'cloudflare', 'testkit', 'workspace']\nsha, gate, task = (os.environ[k] for k in ['REQUEST_SHA', 'REQUEST_GATE', 'REQUEST_TASK'])\nif not re.fullmatch(r'[0-9a-f]{40}', sha): raise SystemExit('source_sha must be a full lowercase commit SHA')\nif gate != 'all' and gate not in profiles: raise SystemExit('unknown gate')\nif not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}', task): raise SystemExit('invalid task ID')\nselected = profiles if gate == 'all' else [gate]\nwith open(os.environ['GITHUB_OUTPUT'], 'a') as f:\n    f.write('matrix=' + json.dumps({'profile': selected}) + '\\n')\n    f.write('source_sha=' + sha + '\\n')\n    f.write('task_id=' + task + '\\n')\nPYREQ\n"
          }
        ]
      },
      "gate": {
        "name": "TS / ${{ matrix.profile }}",
        "needs": "request",
        "runs-on": "ubuntu-24.04",
        "timeout-minutes": 45,
        "strategy": {
          "fail-fast": false,
          "max-parallel": 7,
          "matrix": "${{ fromJSON(needs.request.outputs.matrix) }}"
        },
        "steps": [
          {
            "id": "tooling",
            "name": "Checkout pinned gate tooling",
            "uses": "actions/checkout@11d5960a326750d5838078e36cf38b85af677262",
            "with": {
              "ref": "${{ github.workflow_sha }}",
              "path": "gate-tools",
              "persist-credentials": false,
              "submodules": false
            }
          },
          {
            "id": "source",
            "name": "Checkout exact source snapshot",
            "uses": "actions/checkout@11d5960a326750d5838078e36cf38b85af677262",
            "with": {
              "ref": "${{ needs.request.outputs.source_sha }}",
              "path": "candidate",
              "persist-credentials": false,
              "submodules": false
            }
          },
          {
            "id": "node",
            "uses": "actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020",
            "with": {
              "node-version": "24"
            }
          },
          {
            "id": "bun",
            "uses": "oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6",
            "with": {
              "bun-version": "1.4.2"
            }
          },
          {
            "id": "gate",
            "name": "Run gate and write command receipts",
            "working-directory": "candidate",
            "env": {
              "CI_GATE_PROFILE": "${{ matrix.profile }}",
              "CI_EXPECTED_SHA": "${{ needs.request.outputs.source_sha }}",
              "CI_TASK_ID": "${{ needs.request.outputs.task_id }}",
              "CI_RECEIPT_DIR": "${{ runner.temp }}/ts-gate-receipt",
              "GITHUB_WORKFLOW_SHA": "${{ github.workflow_sha }}"
            },
            "run": "node \"$GITHUB_WORKSPACE/gate-tools/.github/ci/ts-gate.mjs\""
          },
          {
            "name": "Preserve setup failure and summarize receipt",
            "if": "always()",
            "env": {
              "RECEIPT_DIR": "${{ runner.temp }}/ts-gate-receipt",
              "SOURCE_SHA": "${{ needs.request.outputs.source_sha }}",
              "PROFILE": "${{ matrix.profile }}",
              "TASK_ID": "${{ needs.request.outputs.task_id }}",
              "WORKFLOW_SHA": "${{ github.workflow_sha }}",
              "TOOLING_OUTCOME": "${{ steps.tooling.outcome }}",
              "SOURCE_OUTCOME": "${{ steps.source.outcome }}",
              "NODE_OUTCOME": "${{ steps.node.outcome }}",
              "BUN_OUTCOME": "${{ steps.bun.outcome }}",
              "GATE_OUTCOME": "${{ steps.gate.outcome }}"
            },
            "run": "python3 - <<'PYRECEIPT'\nimport json, os\nfrom pathlib import Path\nd = Path(os.environ['RECEIPT_DIR']); d.mkdir(parents=True, exist_ok=True)\np = d / 'receipt.json'\nurl = f\"{os.environ['GITHUB_SERVER_URL']}/{os.environ['GITHUB_REPOSITORY']}/actions/runs/{os.environ['GITHUB_RUN_ID']}\"\nreceipt = json.loads(p.read_text()) if p.exists() else {\n    'version': 1, 'status': 'infrastructure-failure', 'error': 'Gate did not write a receipt',\n    'expected_sha': os.environ['SOURCE_SHA'], 'source_sha': None,\n    'workflow_sha': os.environ['WORKFLOW_SHA'], 'profile': os.environ['PROFILE'],\n    'task_id': os.environ['TASK_ID'], 'run_id': os.environ['GITHUB_RUN_ID'],\n    'attempt': os.environ['GITHUB_RUN_ATTEMPT'], 'run_url': url, 'commands': []}\nreceipt['workflow_steps'] = {k.lower().removesuffix('_outcome'): os.environ[k] for k in\n    ['TOOLING_OUTCOME', 'SOURCE_OUTCOME', 'NODE_OUTCOME', 'BUN_OUTCOME', 'GATE_OUTCOME']}\nif any(v != 'success' for v in receipt['workflow_steps'].values()): receipt['status'] = 'failed'\np.write_text(json.dumps(receipt, indent=2) + '\\n')\nwith open(os.environ['GITHUB_STEP_SUMMARY'], 'a') as f:\n    f.write(f\"### {receipt['profile']} — {receipt['status']}\\n\\n\")\n    f.write(f\"Task: `{receipt['task_id']}`\\n\\nSource: `{receipt['source_sha']}`\\n\\n[Run]({url})\\n\\n\")\n    f.write('| Command | Exit | Status |\\n|---|---:|---|\\n')\n    for c in receipt['commands']:\n        cmd = ' '.join(c['argv']).replace('|', r'\\|')\n        f.write(f\"| `{cmd}` | {c.get('exit')} | {c['status']} |\\n\")\nPYRECEIPT\n"
          },
          {
            "name": "Upload immutable receipt and raw logs",
            "if": "always()",
            "uses": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02",
            "with": {
              "name": "ts-gate-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.profile }}",
              "path": "${{ runner.temp }}/ts-gate-receipt/",
              "if-no-files-found": "error",
              "retention-days": 14
            }
          }
        ]
      }
    }
  }
}
