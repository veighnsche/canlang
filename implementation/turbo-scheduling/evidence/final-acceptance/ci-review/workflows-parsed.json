              "node-version": 24
            }
          },
          {
            "uses": "oven-sh/setup-bun@v2",
            "with": {
              "bun-version": "1.4.2"
            }
          },
          {
            "name": "Guard package API imports",
            "run": "# Consumers use declared exports; a sibling source path bypasses the producer build.\nif grep -RnE \"(\\.\\./)+contracts/(src|dist)/\" packages/identity/src packages/identity/test packages/interfaces/src packages/interfaces/test; then\n  exit 1\nfi\n"
          },
          {
            "name": "Install workspace",
