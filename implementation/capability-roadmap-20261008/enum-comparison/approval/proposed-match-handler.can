  ## Added bounded comparison handler; PROPOSED enum-only match syntax; uncompiled evidence.
  scenario review_state_text(submission:Submission) read=true -> text by=members
   do
    if not (submission.parent.submitter==actor)
     if coordinator
      if submission.parent.location!=null
       let person=actor
       let location=submission.parent.location
       let worker=first(Employee as e where e.user==person and e.active)
       let allowed=worker!=null and active_member(person,team) and (worker.operator_wide or worker.home==location or location in worker.locations)
       if not allowed
        require reviewer and submission.reviewer==actor and submission.state!=withdrawn
        let person=actor
        let location=submission.parent.location
        let worker=first(Employee as e where e.user==person and e.active)
        require worker!=null and active_member(person,team) and (worker.operator_wide or worker.home==location or location in worker.locations)
     else
      require reviewer and submission.reviewer==actor and submission.state!=withdrawn
      if submission.parent.location!=null
       let person=actor
       let location=submission.parent.location
       let worker=first(Employee as e where e.user==person and e.active)
       require worker!=null and active_member(person,team) and (worker.operator_wide or worker.home==location or location in worker.locations)
    let state=submission.state
    match state
     case pending
      return "Pending"
     case approved
      return "Approved"
     case rejected
      return "Rejected"
     case withdrawn
      return "Withdrawn"
   examples seed=[reviewer_worker] submission=pending_version
    as,submission.state -> result
    reviewer_user,pending -> "Pending"
    reviewer_user,approved -> "Approved"
    reviewer_user,rejected -> "Rejected"
    self,withdrawn -> "Withdrawn"
