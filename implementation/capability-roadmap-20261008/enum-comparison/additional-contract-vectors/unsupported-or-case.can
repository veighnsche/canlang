## PROPOSED, uncompiled source input; match itself is not accepted grammar.
app AdditionalEnumVector
Given
 Probe {state:enum(a,b)=a}
 Other {state:enum(a,c)=a}
 policy Probe read=members
 policy Other read=members
 fixture probe=Probe {}
 fixture other=Other {}
When
 scenario inspect(probe:Probe) read=true -> text by=members
  do
   let state=probe.state
   match state
    case a or b
     return "Both"
Then
 page / title="Enum vector"
  list Probe
   text row.state
