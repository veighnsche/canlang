  ## Added bounded comparison handler; current grammar, uncompiled evidence.
  scenario stage_text(candidate:Candidate) read=true -> text by=recruiter
   do
    let person=actor
    let location=candidate.parent.location
    let worker=first(Employee as e where e.user==person and e.active)
    require worker!=null and active_member(person,team) and (worker.operator_wide or worker.home==location or location in worker.locations)
    let state=candidate.stage
    if state==applied
     return "Applied"
    else
     if state==interview
      return "Interview"
     else
      if state==offer
       return "Offer"
      else
       if state==hired
        return "Hired"
       else
        if state==rejected
         return "Rejected"
        else
         return "Withdrawn"
   examples seed=[test_worker] candidate=applicant
    as,candidate.stage -> result
    recruiter,applied -> "Applied"
    recruiter,interview -> "Interview"
    recruiter,offer -> "Offer"
    recruiter,hired -> "Hired"
    recruiter,rejected -> "Rejected"
    recruiter,withdrawn -> "Withdrawn"
