# Request departmental equipment privately, manage your unresolved requests, and review only departments you manage.
app EquipmentRequests
Given
 role steward label="Review access steward"
 ReviewGrant { reviewer:user label="Temporary reviewer", until:datetime label="Review access expiry", granted_by:user server=actor label="Granted by", granted_at:datetime server=now label="Granted at", revoked_by:user? label="Revoked by", revoked_at:datetime? label="Revoked at" } label="Department A review access"
 policy ReviewGrant read=members where=owner or steward or row.reviewer==actor
 lock ReviewGrant fields=reviewer,until,granted_by,granted_at
 lock ReviewGrant fields=revoked_by,revoked_at when=row.revoked_at!=null
 invariant ReviewGrant: (row.revoked_at==null and row.revoked_by==null) or (row.revoked_at!=null and row.revoked_by!=null)
 ## Department assignments are business data; canonical teams still owns authentication and team membership.
 Employee { user:user unique label="Employee", department:enum(A,B,C) label={text="Department",values={A="Department A",B="Department B",C="Department C"}}, manager:bool=false label="Department manager", enabled:bool=true } label="Department assignment"
 policy Employee read=members where=owner or row.user==actor
 lock Employee fields=user
 Request { title:text trim min=1 max=120 label="Request", archive_reason:text? trim min=1 label="Archive reason", details:text? label="Details", cost_centre:text? max=40 label="Cost centre", submitted_by:user server=actor label="Request owner", department:Employee.department? server=first(Employee as employee where employee.user==actor and employee.enabled)?.department label="Department" } label="Equipment request"
 ## Nullable lookup representation permits an absent assignment to be rejected, never stored as a departmentless request.
 invariant Request: row.department!=null
 invariant Request: row.archived_at==null or row.archive_reason!=null
 lock Request fields=archive_reason when=row.archive_reason!=null
 lock Request fields=submitted_by,department
 policy Request read=members where=row.submitted_by==actor or any(Employee as employee,employee.user==actor and employee.enabled and employee.manager and employee.department==row.department) or (row.department==A and any(ReviewGrant as grant,grant.reviewer==actor and grant.revoked_at==null and now<grant.until))
 preferences { view:enum(open,archived,all)=open label={text="Request state",values={open="Open",archived="Archived",all="All"}} }
 fixture temporary_review=ReviewGrant {reviewer=self,until=datetime("2030-01-01T00:00:00Z"),granted_by=other}
 fixture current_employee=Employee {user=self,department=A}
 fixture other_employee=Employee {user=other,department=B}
 fixture mine=Request {title="Monitor",submitted_by=self,department=A}
 fixture colleague_a=Request {title="Keyboard",submitted_by=other,department=A}
 fixture colleague_b=Request {title="Dock",submitted_by=other,department=B}
When
 # Grant a current member read-only review of department A until an explicit future instant.
 scenario grant_review(reviewer:user,until:datetime) by=owner or steward label="Grant temporary review"
  require active_member(reviewer,team)
  require until>now message="Choose a future expiry."
  do create ReviewGrant {reviewer,until} as grant
 # Revoke a grant for new admissions immediately, retaining who revoked it and when.
 scenario revoke_review(grant:ReviewGrant) by=owner or steward label="Revoke temporary review"
  require grant.revoked_at==null
  do set grant {revoked_by=actor,revoked_at=now}
  examples grant=temporary_review
   as -> temporary_review.revoked_by,temporary_review.revoked_at!=null,temporary_review.version
   owner -> self,true,2
   steward -> self,true,2
   members -> error(forbidden)
 ## The owner maintains current department assignments through browser forms or the same MCP CRUD.
 crud Employee by=owner fields=department,manager,enabled create_fields=user,department,manager,enabled delete=none when=active_member(row.user,team)
 crud Request by=members fields=title,details,cost_centre when=row.submitted_by==actor and row.archived_at==null and any(Employee as employee,employee.user==actor and employee.enabled) label={delete="Archive"}
  examples create seed=[current_employee]
   as,title,details -> count(Request),first(Request)?.title,first(Request)?.submitted_by,first(Request)?.department
   members,"  Monitor  ",null -> 1,"Monitor",self,A
   members,"   ",null -> error(validation)
   public,"Monitor",null -> error(forbidden)
  examples create seed=[current_employee]
   as,title,cost_centre -> count(Request)
   members,"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",null -> error(validation)
   members,"Monitor","ccccccccccccccccccccccccccccccccccccccccc" -> error(validation)
   members,"Monitor","Dept-A" -> 1
  examples update record=mine seed=[current_employee]
   as,changes.title,changes.details,request.record.version -> mine.title,mine.details,mine.version
   members,"  Wide monitor  ","For desk",1 -> "Wide monitor","For desk",2
   members,"Monitor",null,0 -> error(conflict)
   members,"   ",null,1 -> error(validation)
  examples update record=colleague_a seed=[current_employee]
   as,changes.title -> colleague_a.title
   members,"Changed claim" -> error(rule_failed)
  ## Direct canonical delete cannot bypass archive evidence; the final invariant rejects it.
  examples delete record=mine seed=[current_employee]
   as,request.record.version -> mine.archived_at!=null
   members,1 -> error(rule_failed)
  examples update record=colleague_a seed=[current_employee,temporary_review]
   as,changes.title,temporary_review.until -> colleague_a.title
   members,"Reviewer edit",now+1h -> error(rule_failed)
 # Archive your open request with a trimmed nonempty reason, preserving its claim and evidence.
 scenario archive(request:Request,reason:text) by=members label="Archive with reason"
  require request.submitted_by==actor and request.archived_at==null
  require trim(reason)!="" message="Enter an archive reason."
  do
   set request {archive_reason=trim(reason)}
   call Request.delete {record=request}
  examples request=mine seed=[current_employee]
   as,reason,request.request.version -> mine.archived_at!=null,mine.title,mine.archive_reason,mine.version
   members,"  No longer needed  ",1 -> true,"Monitor","No longer needed",2
   members,"   ",1 -> error(rule_failed)
   members,"No longer needed",0 -> error(conflict)
  examples request=colleague_a seed=[current_employee]
   as,reason -> colleague_a.archived_at!=null
   members,"Change another claim" -> error(rule_failed)
  examples request=colleague_a seed=[current_employee,temporary_review]
   as,reason,temporary_review.until -> colleague_a.archived_at!=null
   members,"Reviewer archive",now+1h -> error(rule_failed)
 # Read authorized requests including preserved archives; this typed view also supplies scoped CSV export.
 scenario browse() by=members read=true -> Request[]
  do return Request archived=include
  examples seed=[current_employee,mine,colleague_a,colleague_b]
   as,current_employee.manager -> count(result),count(result as request where request.department==B)
   members,false -> 1,0
   members,true -> 2,0
   owner,false -> 1,0
   public,false -> error(forbidden)
  examples seed=[current_employee,mine,colleague_a,colleague_b,temporary_review]
   as,temporary_review.until,temporary_review.revoked_at,temporary_review.revoked_by -> count(result),count(result as request where request.department==B)
   members,now+1h,null,null -> 2,0
   members,now,null,null -> 1,0
   members,now-1h,null,null -> 1,0
   members,now+1h,now,other -> 1,0
 # Find readable exact-title candidates before explicitly choosing whether to create a new request.
 scenario duplicates(title:Request.title,details:Request.details) by=members read=true -> Request[]
  do return Request archived=include as request where request.title==title
  examples seed=[current_employee,mine,colleague_a,colleague_b]
   as,title,details -> count(result)
   members,"  Monitor  ",null -> 1
   members,"Dock",null -> 0
Then
 # Create a request or review a CSV intake; each confirmed row uses the same guarded create operation.
 page / title="Equipment requests"
  require members
  card "New equipment request"
   form Request.create import=csv review=duplicates display=inline
  card "Your requests and managed departments"
   tabs preferences.view
   table Request archived=include as request where preferences.view==all or (preferences.view==open and request.archived_at==null) or (preferences.view==archived and request.archived_at!=null) columns=title,details,cost_centre,department,submitted_by,archived_at order=-created search=title,details filter=department,archived_at display=split empty="No matching requests."
    details "Request evidence"
     text row.title,row.details,row.cost_centre,row.department,row.submitted_by,row.archived_at,row.archive_reason
     history
    card "Manage your open request"
     require row.submitted_by==actor and row.archived_at==null
     edit
     action archive
 # Maintain current employee department and manager assignments. This grants no unrelated request access.
 page /assignments title="Department assignments"
  require owner
  form Employee.create
  table Employee columns=user,department,manager,enabled filter=department,manager,enabled
   edit
 # Manage temporary read grants without granting review stewards department administration rights.
 page /review-access title="Temporary review access"
  require owner or steward
  form grant_review
  table ReviewGrant columns=reviewer,until,granted_by,granted_at,revoked_by,revoked_at filter=reviewer,until,revoked_at
   details "Grant attribution"
    history
   card "Revoke active grant"
    require row.revoked_at==null
    action revoke_review
