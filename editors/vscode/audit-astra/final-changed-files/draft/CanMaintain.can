# Help workspace managers move facility faults in offices, meeting rooms, common areas, and equipment through repair and return to service. @{nl="Help werkplekmanagers storingen in kantoren, vergaderruimten, gemeenschappelijke ruimten en apparatuur te herstellen en voorzieningen terug in gebruik te nemen."}
app CanMaintain uses=[maintain]

# Maintain equipment, verify repairs, dispatch technicians and track consumable stock. @{nl="Onderhoud apparatuur, verifieer reparaties, plan technici en volg de verbruiksvoorraad."}
app Facilities uses=[CanMaintain,CanField,CanStock]

# Own equipment, immutable inspection evidence and manager-verified repairs. @{nl="Beheer apparatuur, onveranderlijk inspectiebewijs en door managers geverifieerde reparaties."}
package maintain
 use rent_catalog {Location,test_site}
 use supplier {Supplier}
 use employee {can_work,test_worker}
 use field {ReportSubmitted}
 use std {EmailV1 as Mail} from=deployment.mail
 use rent_reservations {RoomsV1 as Rooms} from=deployment.rooms
 Given
  export contract WorkItem { reference:text, revision:int, location:text?, title:text, detail:text?, due:datetime?, action:action(inspect) } label="Authorized inspection"@{nl="Toegestane inspectie"}
  export contract WorkBatch { items:WorkItem[]! max=500 } label="Authorized inspections"@{nl="Toegestane inspecties"}
  message label_Plan_checklist = "Checklist"@{nl="Checklist"}
  message label_Inspection_answers = "Answers"@{nl="Antwoorden"}
  message label_Inspection_result_pending = "Pending"@{nl="In afwachting"}
  message label_Inspection_result_failed = "Failed"@{nl="Mislukt"}
  message label_Repair_photo = "Photo"@{nl="Foto"}
  preferences { location:Location?, severity:Repair.severity? }
  role maintenance_manager label="Maintenance manager"@{nl="Onderhoudsbeheerder"}
  role technician label="Technician"@{nl="Technicus"}
  Asset { location:Location, identifier:text unique label="Identifier"@{nl="Identificatie"}, name:text, category:text label="Category"@{nl="Categorie"}, supplier:Supplier?, resource:text? label="Resource reference"@{nl="Referentie voorziening"}, serial:text? label="Serial number"@{nl="Serienummer"}, warranty:date? label="Warranty expiry"@{nl="Garantie-einddatum"}, manual:file? label="Manual"@{nl="Handleiding"}, retired:bool=false label="Retired"@{nl="Buiten gebruik"} } label="Asset"@{nl="Bedrijfsmiddel"}
  Plan in Asset { name:text, assignee:user label="Assignee"@{nl="Toegewezen persoon"}, assignee_email:email label="Reminder destination"@{nl="Bestemming herinnering"}, cadence_days:int min=1 label="Interval in days"@{nl="Interval in dagen"}, next_due:date label="Next inspection date"@{nl="Volgende inspectiedatum"}, checklist:text[]! label=label_Plan_checklist, revision:int=1, active:bool=true } label="Inspection plan"@{nl="Inspectieplan"}
  export Inspection in Plan { cancelled:bool=false label="Cancelled"@{nl="Geannuleerd"}, cancellation:text? label="Cancellation reason"@{nl="Reden annulering"}, cancelled_by:user? label="Cancelled by"@{nl="Geannuleerd door"}, cancelled_at:datetime? label="Cancelled at"@{nl="Geannuleerd op"}, reminder_email:email label="Reminder destination"@{nl="Bestemming herinnering"}, reminded_at:datetime? label="Reminded at"@{nl="Herinnerd op"}, occurrence:text unique label="Occurrence reference"@{nl="Referentie uitvoering"}, due:date, checklist:text[]! label=label_Plan_checklist, template_version:int label="Template version"@{nl="Templateversie"}, inspector:user label="Inspector"@{nl="Inspecteur"}, answers:text[] label=label_Inspection_answers, result:enum(pending,passed,failed,blocked)=pending label={text="Inspection result"@{nl="Inspectieresultaat"},values={pending=label_Inspection_result_pending,passed="Passed"@{nl="Goedgekeurd"},failed=label_Inspection_result_failed,blocked="Blocked"@{nl="Geblokkeerd"}}}, evidence:text?, inspected_at:datetime? label="Inspected at"@{nl="Geïnspecteerd op"}, repair:Repair? } label="Inspection"@{nl="Inspectie"}
  export Repair in Asset { assignment:Assignment? label="Current assignment"@{nl="Huidige opdracht"}, block_from:datetime? label="Downtime start"@{nl="Begin uitval"}, block_until:datetime? label="Downtime end"@{nl="Einde uitval"}, block_action:enum(downtime,restore)=downtime label={text="Availability action"@{nl="Beschikbaarheidsactie"},values={downtime="Downtime"@{nl="Uitval"},restore="Restore"@{nl="Herstellen"}}}, block_revision:int=0, restore_evidence:text? label="Release evidence"@{nl="Vrijgavebewijs"}, visit_review:bool=false label="Visit report needs review"@{nl="Bezoekverslag vereist beoordeling"}, title:text trim min=1, description:text, severity:enum(low,normal,urgent)=normal label={text="Severity"@{nl="Ernst"},values={low="Low"@{nl="Laag"},normal="Normal"@{nl="Normaal"},urgent="Urgent"@{nl="Dringend"}}}, reporter:user? label="Reporter"@{nl="Melder"}, reporter_email:email? label="Reporter email"@{nl="E-mailadres melder"}, photo:file? label=label_Repair_photo, contractor:Supplier? label="Contractor"@{nl="Uitvoerder"}, due:date?, cost:money? label="Cost"@{nl="Kosten"}, state:enum(open,assigned,in_progress,awaiting_verification,fixed)=open label={text="State"@{nl="Status"},values={open="Open"@{nl="Open"},assigned="Assigned"@{nl="Toegewezen"},in_progress="In progress"@{nl="In uitvoering"},awaiting_verification="Awaiting verification"@{nl="Wacht op verificatie"},fixed="Fixed"@{nl="Hersteld"}}}, completion:text? label="Completion evidence"@{nl="Afrondingsbewijs"}, verified_by:user? label="Verified by"@{nl="Geverifieerd door"}, block_resource:text? label="Blocked resource"@{nl="Geblokkeerde voorziening"}, block_source:text? label="Downtime reference"@{nl="Uitvalreferentie"}, block_state:enum(none,pending,confirmed,failed,unknown,released)=none label={text="Downtime outcome"@{nl="Uitvalresultaat"},values={pending=label_Inspection_result_pending,failed=label_Inspection_result_failed,none="None"@{nl="Geen"},confirmed="Confirmed"@{nl="Bevestigd"},unknown="Unknown"@{nl="Onbekend"},released="Released"@{nl="Vrijgegeven"}}}, delivery:text? label="Delivery reference"@{nl="Verzendingsreferentie"} } label="Repair"@{nl="Reparatie"}
  Assignment in Repair { body:text label="Frozen assignment details"@{nl="Vastgelegde opdrachtdetails"}, supplier:Supplier, contact:email label="Contact"@{nl="Contact"}, reason:text, author:user server=actor label="Author"@{nl="Auteur"} } label="Contractor assignment"@{nl="Opdracht aan leverancier"}
  Notice in Assignment { delivery:text, state:enum(pending,succeeded,failed,unknown,skipped)=pending label={text="Delivery outcome"@{nl="Verzendingsresultaat"},values={pending=label_Inspection_result_pending,succeeded="Delivered"@{nl="Bezorgd"},failed=label_Inspection_result_failed,unknown="Unknown"@{nl="Onbekend"},skipped="Superseded"@{nl="Vervangen"}}} } label="Assignment delivery"@{nl="Opdrachtverzending"}
  event Reminder { inspection:Inspection, revision:int }
  policy Asset read=authenticated where=not row.retired fields=location,identifier,name
  policy Asset read=maintenance_manager or technician where=can_work(actor,row.location)
  policy Plan read=maintenance_manager where=can_work(actor,row.parent.location)
  policy Inspection read=maintenance_manager where=can_work(actor,row.parent.parent.location)
  policy Inspection read=technician where=row.inspector==actor and can_work(actor,row.parent.parent.location)
  policy Repair read=maintenance_manager or technician where=can_work(actor,row.parent.location)
  policy Repair read=authenticated where=row.reporter==actor fields=title,description,severity,state,due,completion
  policy Assignment read=maintenance_manager where=can_work(actor,row.parent.parent.location)
  policy Notice read=maintenance_manager where=can_work(actor,row.parent.parent.parent.location)
  require Plan: row.cadence_days>0 and count(row.checklist)>0 and (not row.active or (not row.parent.retired and technician(row.assignee) and can_work(row.assignee,row.parent.location)))
  require Inspection: row.result==pending or (row.evidence!=null and row.inspected_at!=null and count(row.answers)==count(row.checklist))
  require Repair: row.state!=fixed or (row.completion!=null and row.verified_by!=null)
  lock Inspection fields=occurrence,due,checklist,template_version,inspector
  lock Inspection fields=answers,result,evidence,inspected_at when=row.result!=pending
  lock Assignment fields=supplier,contact,reason,author,body
  fixture equipment=Asset {location=test_site,identifier="HVAC-1",name="Air conditioner",category="HVAC"}
  fixture awaiting=Repair {parent=equipment,title="Fault",description="No cooling",state=awaiting_verification,completion="Repaired"}
 When
  crud Asset by=maintenance_manager fields=name,category,supplier,resource,serial,warranty,manual,retired create_fields=location,identifier,name,category,supplier,resource,serial,warranty,manual when=can_work(actor,row.location) delete=none
  crud Plan by=maintenance_manager fields=name,assignee,assignee_email,cadence_days,next_due,checklist,active when=can_work(actor,row.parent.location) delete=none
  crud Repair by=maintenance_manager fields=title,description,severity,due,photo,cost when=can_work(actor,row.parent.location) and row.state==open delete=none
  ## Revision changes supersede only undispatched future instances; today's and completed evidence remains.
  scenario revise_plan on=before Plan.update
   do
    set event.after {revision=event.before.revision+1}
    for inspection in event.before.Inspection as item where item.result==pending and not item.cancelled and item.due>local_date(now,event.before.parent.location.timezone) limit=100
     set inspection {cancelled=true,cancellation="Plan revised",cancelled_by=actor,cancelled_at=now}
     cancel inspection.id
  scenario retire_asset on=before Asset.update
   do
    if event.after.retired and not event.before.retired
     for plan in event.before.Plan limit=100
      set plan {active=false,revision=plan.revision+1}
      for inspection in plan.Inspection as item where item.result==pending and not item.cancelled and item.due>local_date(now,event.before.location.timezone) limit=100
       set inspection {cancelled=true,cancellation="Asset retired",cancelled_by=actor,cancelled_at=now}
       cancel inspection.id
  # Report your own facility fault without browsing unrelated repairs. @{nl="Meld je eigen facilitaire storing zonder niet-gerelateerde reparaties te bekijken."}
  scenario report(asset:Asset,title:text,description:text,photo:file? label=label_Repair_photo) by=authenticated label="Report fault"@{nl="Storing melden"}
   require not asset.retired and trim(title)!="" and trim(description)!=""
   do create Repair {parent=asset,title,description,photo,reporter=actor,reporter_email=actor.email} as repair
  # Assign an active supplier and freeze the notification destination. @{nl="Wijs een actieve leverancier toe en leg de meldingsbestemming vast."}
  scenario assign(repair:Repair,supplier:Supplier,reason:text) by=maintenance_manager
   require can_work(actor,repair.parent.location) and supplier.active and repair.parent.location in supplier.locations and repair.state!=fixed and trim(reason)!=""
   do
    create Assignment {parent=repair,supplier,contact=supplier.contact,reason,body=repair.description} as assignment
    set repair {contractor=supplier,assignment,state=assigned}
    send Mail.send {to=assignment.contact,subject=format("Repair assignment"@{nl="Reparatieopdracht"},locale=null),body=assignment.body} when=repair.assignment==assignment and supplier.active and repair.state in [assigned,in_progress] as notice
    create Notice {parent=assignment,delivery=notice.id} as receipt
  # Retry a definitely failed assignment notice only for its current active destination. @{nl="Probeer een definitief mislukte opdrachtmelding opnieuw voor de huidige actieve bestemming."}
  scenario retry_notice(notice:Notice) by=maintenance_manager label="Retry assignment notice"@{nl="Opdrachtmelding opnieuw sturen"}
   require can_work(actor,notice.parent.parent.parent.location) and notice.state==failed and notice.parent.parent.assignment==notice.parent and notice.parent.supplier.active and notice.parent.parent.state in [assigned,in_progress]
   do
    send Mail.send {to=notice.parent.contact,subject=format("Repair assignment"@{nl="Reparatieopdracht"},locale=null),body=notice.parent.body} when=notice.parent.parent.assignment==notice.parent and notice.parent.supplier.active and notice.parent.parent.state in [assigned,in_progress] as delivery
    create Notice {parent=notice.parent,delivery=delivery.id} as receipt
  scenario notice_result on=Mail.send.completed
   do
    for notice in Notice as item where item.delivery==event.delivery_id and item.state in [pending,unknown] limit=1
     set notice {state=event.status}
  # Start an assigned repair without claiming acceptance from assignment delivery. @{nl="Start een toegewezen reparatie zonder aanvaarding af te leiden uit de opdrachtverzending."}
  scenario start(repair:Repair) by=technician label="Start repair"@{nl="Reparatie starten"}
   require can_work(actor,repair.parent.location) and repair.state==assigned and repair.contractor!=null and repair.contractor.active
   do set repair {state=in_progress}
  # Request canonical room downtime while preserving affected customer bookings. @{nl="Vraag canonieke ruimte-uitval aan en behoud de getroffen klantboekingen."}
  scenario block(repair:Repair,from:datetime label="Start"@{nl="Begin"},until:datetime? label="End"@{nl="Einde"}) by=maintenance_manager label="Record blocker"@{nl="Blokkade registreren"}
   require can_work(actor,repair.parent.location) and repair.parent.resource!=null and repair.state!=fixed and repair.block_state in [none,released] and (until==null or from<until)
   do
    send Rooms.downtime {source=operation.id,resource=repair.parent.resource,from,until} as delivery
    set repair {block_resource=repair.parent.resource,block_source=operation.id,block_from=from,block_until=until,block_action=downtime,block_revision=0,block_state=pending,delivery=delivery.id}
  # Capture technician evidence for manager verification rather than automatic resale. @{nl="Leg technicusbewijs vast voor managerverificatie in plaats van automatische herverkoop."}
  scenario finish(repair:Repair,evidence:text) by=technician label="Submit repair evidence"@{nl="Reparatiebewijs indienen"}
   require can_work(actor,repair.parent.location) and repair.state in [assigned,in_progress] and trim(evidence)!=""
   do set repair {state=awaiting_verification,completion=evidence}
  # Verify a repair and request release of only its own downtime block. @{nl="Verifieer een reparatie en vraag vrijgave van uitsluitend haar eigen uitvalblokkade aan."}
  scenario verify(repair:Repair,evidence:text) by=maintenance_manager label="Verify repair"@{nl="Reparatie verifiëren"}
   require can_work(actor,repair.parent.location) and repair.state==awaiting_verification and repair.completion!=null and trim(evidence)!=""
   do
    set repair {state=fixed,verified_by=actor,visit_review=false}
    if repair.block_source!=null and repair.block_state!=released
     require repair.block_resource!=null
     send Rooms.restore {source=repair.block_source,resource=repair.block_resource,evidence} as delivery
     set repair {block_action=restore,restore_evidence=evidence,block_state=pending,delivery=delivery.id}
   examples seed=[test_worker] repair=awaiting
    as,evidence -> repair.state,repair.verified_by
    maintenance_manager,"Checked cooling" -> fixed,self
    maintenance_manager,"" -> error(rule_failed)
    technician,"Checked cooling" -> error(forbidden)
  # Reopen a recurrence without erasing previous inspection or completion evidence. @{nl="Heropen een terugkerende storing zonder eerder inspectie- of afrondingsbewijs te wissen."}
  scenario reopen(repair:Repair,reason:text) by=maintenance_manager
   require can_work(actor,repair.parent.location) and repair.state==fixed and repair.block_state in [none,released,confirmed] and (repair.block_action==downtime or repair.block_state in [none,released]) and trim(reason)!=""
   do set repair {state=open,description=reason,verified_by=null}
  # Record one attributable checklist result; a failed or blocked result opens a corrective repair. @{nl="Registreer één herleidbaar checklistresultaat; een mislukt of geblokkeerd resultaat opent een corrigerende reparatie."}
  export scenario inspect(inspection:Inspection,answers:text[] label=label_Inspection_answers,result:Inspection.result,evidence:text) by=technician label="Record inspection"@{nl="Inspectie registreren"}
   require can_work(actor,inspection.parent.parent.location) and inspection.inspector==actor and inspection.result==pending and not inspection.cancelled and result in [passed,failed,blocked] and count(answers)==count(inspection.checklist) and trim(evidence)!=""
   do
    set inspection {answers,result,evidence,inspected_at=now}
    cancel inspection.id
    if result in [failed,blocked]
     create Repair {parent=inspection.parent.parent,title=inspection.parent.name,description=evidence,reporter=actor} as repair
     set inspection {repair}
  ## A visit report is evidence for the owning repair, never permission to restore room availability.
  scenario visit_report on=ReportSubmitted
   do
    let job=event.report.parent
    if job.repair!=null
     require job.location==job.repair.parent.location and job.state==done
     if job.repair.state in [assigned,in_progress,awaiting_verification]
      set job.repair {state=awaiting_verification,completion=event.report.notes,visit_review=true}
     else
      set job.repair {visit_review=true}
  scenario generate on=every(1h)
   do
    for plan in Plan as p where p.active and not p.parent.retired and technician(p.assignee) and can_work(p.assignee,p.parent.location) and p.next_due<=local_date(now,p.parent.location.timezone) limit=100
     let occurrence=format("{plan}:{due}:{revision}",{plan=plan.id,due=plan.next_due,revision=plan.revision})
     if not any(plan.Inspection as inspection,not inspection.cancelled and inspection.due==plan.next_due)
      create Inspection {parent=plan,occurrence,due=plan.next_due,checklist=plan.checklist,template_version=plan.revision,inspector=plan.assignee,reminder_email=plan.assignee_email} as inspection
      schedule inspection.id at=max([now,local_instant(inspection.due,"09:00",plan.parent.location.timezone,fold=earlier)]) event=Reminder {inspection,revision=inspection.template_version}
     set plan {next_due=add_days(plan.next_due,plan.cadence_days)}
  scenario remind on=Reminder
   do
    let inspection=event.inspection
    if inspection.result==pending and not inspection.cancelled and inspection.template_version==event.revision and inspection.parent.active and not inspection.parent.parent.retired and technician(inspection.inspector) and can_work(inspection.inspector,inspection.parent.parent.location)
     send Mail.send {to=inspection.reminder_email,subject=format("Inspection due"@{nl="Inspectie gepland"},locale=null),body=inspection.parent.name} when=inspection.result==pending and not inspection.cancelled and inspection.template_version==event.revision and inspection.parent.active and not inspection.parent.parent.retired and technician(inspection.inspector) and can_work(inspection.inspector,inspection.parent.parent.location) as notice
     set inspection {reminded_at=now}
  # Recover an uncertain availability request using its original frozen business identity. @{nl="Herstel een onzekere beschikbaarheidsaanvraag met haar oorspronkelijke vastgelegde bedrijfsidentiteit."}
  scenario retry_availability(repair:Repair) by=maintenance_manager label="Retry availability request"@{nl="Beschikbaarheidsaanvraag opnieuw proberen"}
   require can_work(actor,repair.parent.location) and repair.block_state in [failed,unknown] and repair.block_source!=null and repair.block_resource!=null
   do
    if repair.block_action==downtime
     require repair.block_from!=null and repair.state!=fixed
     send Rooms.downtime {source=repair.block_source,resource=repair.block_resource,from=repair.block_from,until=repair.block_until} as delivery
     set repair {delivery=delivery.id,block_state=pending}
    else
     require repair.state==fixed and repair.restore_evidence!=null
     send Rooms.restore {source=repair.block_source,resource=repair.block_resource,evidence=repair.restore_evidence} as delivery
     set repair {delivery=delivery.id,block_state=pending}
  scenario downtime_result on=Rooms.downtime.completed
   do
    for repair in Repair as r where r.delivery==event.delivery_id and r.block_action==downtime and r.block_state in [pending,unknown] limit=1
     if event.status==succeeded and event.result!=null and event.result.source==repair.block_source and event.result.revision>=repair.block_revision
      if event.result.state==confirmed
       set repair {block_state=confirmed,block_revision=event.result.revision}
      else
       if event.result.state in [failed,unavailable]
        set repair {block_state=failed,block_revision=event.result.revision}
       else
        set repair {block_state=unknown}
     else
      if event.status==failed
       set repair {block_state=failed}
      else
       set repair {block_state=unknown}
  scenario restore_result on=Rooms.restore.completed
   do
    for repair in Repair as r where r.delivery==event.delivery_id and r.block_action==restore and r.block_state in [pending,unknown] limit=1
     if event.status==succeeded and event.result!=null and event.result.source==repair.block_source and event.result.revision>=repair.block_revision and event.result.state==released
      set repair {block_state=released,block_revision=event.result.revision}
     else
      if event.status==failed
       set repair {block_state=failed}
      else
       set repair {block_state=unknown}
  ## Verified owning outcomes may reconcile lost transport responses; old block confirmation cannot undo a release request.
  scenario availability_changed on=Rooms.changed
   do
    for repair in Repair as r where r.block_source==event.value.source and event.value.revision>r.block_revision limit=1
     if repair.block_action==downtime and event.value.state==confirmed
      set repair {block_state=confirmed,block_revision=event.value.revision}
     if repair.block_action==restore and event.value.state==released
      set repair {block_state=released,block_revision=event.value.revision}
  # Expose only your pending inspection titles and authorized completion actions. @{nl="Toon alleen je openstaande inspectietitels en toegestane afrondingsacties."}
  export scenario work(locations:text[]) read=true scope=authority -> WorkBatch by=technician
   do return WorkBatch {items=Inspection as item where item.inspector==actor and item.result==pending and not item.cancelled and can_work(actor,item.parent.parent.location) and (count(locations)==0 or item.parent.parent.location.id in locations) select WorkItem {reference=item.id,revision=item.version,location=item.parent.parent.location.id,title=item.parent.name,detail=item.parent.parent.name,due=local_instant(item.due,"00:00",item.parent.parent.location.timezone,fold=earlier),action=action(inspect,{inspection=item})}}
  # Recheck the selected inspection before showing its source-owned checklist form. @{nl="Controleer de gekozen inspectie opnieuw voordat het bronformulier met checklist wordt getoond."}
  export scenario work_detail(record:Inspection) read=true scope=authority -> WorkItem by=technician
   require record.inspector==actor and record.result==pending and not record.cancelled and can_work(actor,record.parent.parent.location)
   do return WorkItem {reference=record.id,revision=record.version,location=record.parent.parent.location.id,title=record.parent.name,detail=record.parent.parent.name,due=local_instant(record.due,"00:00",record.parent.parent.location.timezone,fold=earlier),action=action(inspect,{inspection=record})}
 Then
  # Keep assets, overdue inspections and repair verification connected. @{nl="Houd bedrijfsmiddelen, achterstallige inspecties en reparatieverificatie met elkaar verbonden."}
  page /facilities title="Facilities"@{nl="Faciliteiten"}
   require maintenance_manager or technician
   card "Asset directory"@{nl="Bedrijfsmiddelenregister"}
    form Asset.create
    list Asset filter=location,category,retired search=name defaults={location=preferences.location} display=split
     edit
     tabs
      tab "Inspection plans and checklists"@{nl="Inspectieplannen en checklists"}
       form Plan.create
       list row.Plan
        edit
        table row.Inspection columns=due,inspector,result,cancelled,evidence,repair,reminded_at
         text row.checklist
         form inspect
      tab "Repairs and verification"@{nl="Reparaties en verificatie"}
       form Repair.create
       table row.Repair columns=title,severity,due,state,contractor,block_state,visit_review filter=state,severity defaults={severity=preferences.severity}
        edit
        actions assign,start,block,finish,verify,retry_availability,reopen
        list row.Assignment
         text row.reason,row.contact
         table row.Notice columns=state,delivery
          action retry_notice
        history

  # Submit and follow your own fault report. @{nl="Dien je eigen storingsmelding in en volg deze."}
  page /facilities/my-reports title="My facility reports"@{nl="Mijn storingsmeldingen"}
   require authenticated
   card "Own fault intake"@{nl="Eigen storing melden"}
    form report
   card "Own report outcomes"@{nl="Eigen meldingsresultaten"}
    table Repair columns=title,description,state,due,completion filter=severity,state defaults={severity=preferences.severity}
