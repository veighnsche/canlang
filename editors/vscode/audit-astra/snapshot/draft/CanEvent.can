# Help workspace community teams sell or allocate places at networking sessions, workshops, and customer events. @{nl="Help werkplekcommunityteams plaatsen voor netwerksessies, workshops en klantevenementen verkopen of toewijzen."}
app CanEvent uses=[events]

# Own event ticket capacity and admission, with separate venue and customer collection owners. @{nl="Beheer toegangscapaciteit en toelating met afzonderlijke eigenaren voor evenementlocatie en klantinning."}
package events
 use rent_catalog {Location,test_site}
 use employee {can_work,test_worker}
 use customer {Customer,owns,has_location_role}
 use std {EmailV1 as Mail} from=deployment.mail
 use invoice {BillingV1 as Billing} from=deployment.billing
 Given
  role organizer label="Event organizer"@{nl="Evenementorganisator"}
  role check_in label="Admission staff"@{nl="Toegangsmedewerker"}
  Program { name:text unique } label="Event program"@{nl="Evenementprogramma"}
  Event in Program { location:Location, name:text, description:text, timezone:timezone, from:datetime label="From"@{nl="Vanaf"}, until:datetime label="Until"@{nl="Tot"}, capacity:int min=1 label="Capacity"@{nl="Capaciteit"}, price:money, sales_until:datetime label="Sales close at"@{nl="Verkoop sluit op"}, refund_before:datetime label="Refund cutoff"@{nl="Terugbetalingsgrens"}, terms:text label="Terms"@{nl="Voorwaarden"}, venue:text? label="Venue reference"@{nl="Locatiereferentie"}, venue_source:text? label="Venue source"@{nl="Bron evenementlocatie"}, venue_confirmed:bool=false label="Venue confirmed"@{nl="Evenementlocatie bevestigd"}, published:bool=false label="Published"@{nl="Gepubliceerd"}, cancelled:bool=false label=label_Event_cancelled } label="Event"@{nl="Evenement"}
  Registration in Event { settlement_revision:int=0 min=0, account:user label="Account"@{nl="Account"}, name:text, email:email, source:text unique label="Source reference"@{nl="Bronreferentie"}, price:money, expires:datetime label="Expires at"@{nl="Verloopt op"}, state:enum(held,pending,confirmed,expired,cancelled,review)=held label={text="State"@{nl="Status"},values={cancelled=label_Event_cancelled,held="Held"@{nl="Gereserveerd"},pending=label_Registration_state_pending,confirmed="Confirmed"@{nl="Bevestigd"},expired="Expired"@{nl="Verlopen"},review="Needs resolution"@{nl="Vereist beoordeling"}}}, payment:enum(free,unpaid,pending,paid,refunded,unknown)=unpaid label={text="Payment state"@{nl="Betaalstatus"},values={pending=label_Registration_state_pending,free="Free"@{nl="Gratis"},unpaid="Unpaid"@{nl="Onbetaald"},paid="Paid"@{nl="Betaald"},refunded="Refunded"@{nl="Terugbetaald"},unknown="Unknown"@{nl="Onbekend"}}}, ticket:text unique label="Ticket"@{nl="Toegangsbewijs"}, checked_in:datetime? label="Admission time"@{nl="Toegelaten op"}, checked_by:user? label="Admitted by"@{nl="Toegelaten door"}, invoice:text? label="Invoice reference"@{nl="Factuurreferentie"}, delivery:text? label="Delivery reference"@{nl="Afleverreferentie"} } label="Event registration"@{nl="Evenementregistratie"}
  event HoldDue { registration:Registration }
  derive Event.available:int = row.capacity-count(row.Registration as registration where registration.state in [held,pending,confirmed])
  policy Event read=public where=row.published and not row.cancelled fields=location,name,description,timezone,from,until,capacity,price,sales_until,refund_before,terms
  policy Event read=organizer and can_work(actor,row.location)
  policy Registration read=organizer or check_in where=can_work(actor,row.parent.location)
  policy Registration read=authenticated where=row.account==actor
  require Event: row.from<row.until and row.sales_until<=row.from and row.price.minor>=0 and row.price.currency==row.location.currency and row.available>=0
  lock Registration fields=account,name,email,source,price,ticket
  fixture program=Program {name="Community"}
  fixture workshop=Event {parent=program,location=test_site,name="Workshop",description="Networking",timezone="Europe/Brussels",from=datetime("2099-01-02T09:00:00Z"),until=datetime("2099-01-02T10:00:00Z"),capacity=1,price=money(0,"EUR"),sales_until=datetime("2099-01-02T08:00:00Z"),refund_before=datetime("2099-01-01T09:00:00Z"),terms="Free",published=true}
  fixture free_ticket=Registration {parent=workshop,account=other,name="Guest",email="guest@example.test",source="free",price=money(0,"EUR"),expires=datetime("2099-01-02T08:00:00Z"),state=confirmed,payment=free,ticket="ticket"}
  preferences { location:Location?, ticket_state:Registration.state? label="Initial ticket state filter"@{nl="Eerste filter toegangsbewijsstatus"} }
  message label_Event_cancelled = "Cancelled"@{nl="Geannuleerd"}
  message label_Registration_state_pending = "Pending"@{nl="In behandeling"}
 When
  crud Event by=organizer fields=name,description,price,sales_until,refund_before,terms create_fields=location,name,description,timezone,from,until,capacity,price,sales_until,refund_before,terms,venue when=can_work(actor,row.location) and not row.published delete=none
  # Publish only a free-standing event or one whose canonical venue reservation is confirmed. @{nl="Publiceer uitsluitend een losstaand evenement of een evenement met bevestigde canonieke locatiereservering."}
  scenario publish(event:Event) by=organizer
   require can_work(actor,event.location) and not event.cancelled and event.from>now and (event.venue==null or event.venue_confirmed)
   do set event {published=true}
  # Reserve one ticket at the current frozen price; free tickets require no invented payment. @{nl="Reserveer één toegangsbewijs tegen de huidige vastgelegde prijs; gratis toegang vereist geen verzonnen betaling."}
  scenario register(event:Event,name:text,email:email,customer:Customer?) by=authenticated label="Register for event"@{nl="Registreren voor evenement"}
   require event.published and not event.cancelled and now<event.sales_until and event.available>0 and trim(name)!=""
   require actor.email_verified and email==actor.email
   require event.price.minor==0 or (customer!=null and customer.active and event.location in customer.locations and (owns(actor,customer) or has_location_role(actor,customer,booker,event.location) or has_location_role(actor,customer,administrator,event.location)))
   do
    create Registration {parent=event,account=actor,name,email,source=operation.id,price=event.price,expires=now+15m,ticket=operation.id} as registration
    if event.price.minor==0
     set registration {state=confirmed,payment=free}
    else
     require customer!=null
     send Billing.charge {value={source=registration.source,customer=customer.id,location=event.location.id,description=event.name,amount=registration.price,due=local_date(now,event.timezone)}} as delivery
     set registration {state=pending,payment=pending,delivery=delivery.id}
     schedule registration.id at=registration.expires event=HoldDue {registration}
  # Scan a fulfilled ticket once without modifying room occupancy. @{nl="Scan een voldaan toegangsbewijs één keer zonder ruimtebezetting te wijzigen."}
  scenario admit(registration:Registration) by=check_in label="Admit ticket"@{nl="Toegangsbewijs toelaten"}
   require can_work(actor,registration.parent.location) and not registration.parent.cancelled and registration.state==confirmed and registration.payment in [free,paid] and registration.checked_in==null
   do set registration {checked_in=now,checked_by=actor}
   examples seed=[test_worker] registration=free_ticket
    as,registration.state -> registration.checked_by
    check_in,confirmed -> self
    check_in,cancelled -> error(rule_failed)
    organizer,confirmed -> error(forbidden)
  # Cancel own unconsumed admission and request the applicable full-ticket refund separately. @{nl="Annuleer eigen ongebruikte toegang en vraag de toepasselijke volledige terugbetaling afzonderlijk aan."}
  scenario cancel(registration:Registration,reason:text) by=authenticated or organizer
   require registration.account==actor or (organizer and can_work(actor,registration.parent.location))
   require registration.state in [held,pending,confirmed] and registration.checked_in==null and trim(reason)!=""
   do
    set registration {state=cancelled}
    cancel registration.id
    send Billing.cancel {source=registration.source,reason} as cancellation
    if registration.payment==paid and now<registration.parent.refund_before
     send Billing.refund {source=registration.source,amount=registration.price,reason} as refund
  scenario expired on=HoldDue
   require event.registration.state in [held,pending] and event.registration.expires<=now
   do set event.registration {state=expired}
  scenario money on=Billing.settled
   do
    for registration in Registration as row where row.source==event.value.source limit=1
     require registration.price==event.value.amount
     if event.value.revision>registration.settlement_revision
      let was_confirmed=registration.state==confirmed
      set registration {settlement_revision=event.value.revision,invoice=event.value.invoice}
      if event.value.refunded>=registration.price and registration.price.minor>0
       set registration {payment=refunded,state=cancelled}
      else
       if event.value.collected-event.value.refunded>=registration.price and not event.value.collection_pending and not event.value.refund_pending and event.value.state==issued
        set registration {payment=paid}
        if not registration.parent.cancelled and registration.state in [held,pending,confirmed] and registration.parent.from>now
         set registration {state=confirmed}
        else
         if registration.state==expired and not registration.parent.cancelled and registration.parent.available>0 and registration.parent.from>now
          set registration {state=confirmed}
         else
          set registration {state=review}
        if registration.state==confirmed and not was_confirmed
         send Mail.send {to=registration.email,subject=format("Event ticket"@{nl="Toegangsbewijs evenement"},locale=null),body=registration.parent.name} when=registration.state==confirmed and not registration.parent.cancelled as confirmation
       else
        if event.value.collection_pending or event.value.refund_pending
         set registration {payment=unknown}
        else
         if event.value.state==void
          set registration {payment=unpaid,state=cancelled}
         else
          if event.value.collected.minor>0 or event.value.refunded.minor>0
           set registration {payment=unknown,state=review}
  # Cancel the event without hiding received funds or completed scans. @{nl="Annuleer het evenement zonder ontvangen geld of voltooide scans te verbergen."}
  scenario cancel_event(event:Event,reason:text) by=organizer label="Cancel event"@{nl="Evenement annuleren"}
   require can_work(actor,event.location) and not event.cancelled and trim(reason)!=""
   do
    set event {cancelled=true}
    for registration in event.Registration as row where row.state in [held,pending,confirmed] limit=500
     set registration {state=cancelled}
     cancel registration.id
     send Mail.send {to=registration.email,subject=format("Event cancelled"@{nl="Evenement geannuleerd"},locale=null),body=reason} as notice
     if registration.payment==paid
      send Billing.refund {source=registration.source,amount=registration.price,reason} as refund
 Then
  # Discover published events and retrieve only your own tickets. @{nl="Ontdek gepubliceerde evenementen en haal uitsluitend je eigen toegangsbewijzen op."}
  page /events title="Events"@{nl="Evenementen"}
   card "Published event discovery"@{nl="Gepubliceerde evenementen ontdekken"}
    list Event columns=name,location,from,until,price filter=location defaults={location=preferences.location} search=name order=from display=split
     text row.description,row.timezone,row.from,row.until,row.price,row.sales_until,row.refund_before,row.terms
     form register
   card "Own tickets and admission"@{nl="Eigen toegangsbewijzen en toelating"}
    list Registration filter=state defaults={state=preferences.ticket_state} display=split
     text row.ticket,row.state,row.payment,row.expires,row.checked_in
     action cancel
  # Author events and perform scoped reception admission. @{nl="Beheer evenementen en voer beperkte receptietoelating uit."}
  page /events/work title="Event operations"@{nl="Evenementuitvoering"}
   require organizer or check_in
   card "Event intake"@{nl="Evenement aanmaken"}
    form Event.create
   list Event columns=name,location,from filter=location defaults={location=preferences.location} display=split
    card "Event and venue outcome"@{nl="Evenement en locatie-uitkomst"}
     text row.timezone,row.capacity,row.sales_until,row.refund_before,row.terms
     edit
     actions publish,cancel_event
    table row.Registration columns=name,email,state,payment,ticket,checked_in filter=state,payment search=name display=split
     action admit
     details "Ticket evidence and history"@{nl="Toegangsbewijs en historie"}
      text row.expires,row.price,row.checked_by,row.invoice,row.delivery
      history
