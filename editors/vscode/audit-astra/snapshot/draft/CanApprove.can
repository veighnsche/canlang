# Help workspace managers review fit-out plans, signage, supplier documents, and operating procedures before they are used at a location. @{nl="Help werkplekbeheerders verbouwingsplannen, bewegwijzering, leveranciersdocumenten en werkprocedures beoordelen voordat ze op een locatie worden gebruikt."}
app CanApprove uses=[approve]

# Review immutable submitted document versions with current reviewer and no self-approval. @{nl="Beoordeel onveranderlijke ingediende documentversies met de huidige beoordelaar en zonder zelfgoedkeuring."}
package approve label="Document review"@{nl="Documentbeoordeling"}
 use rent_catalog {Location,test_site}
 use employee {can_work,test_worker}
 use std {EmailV1 as Mail} from=deployment.mail
 Given
  role coordinator label="Coordinator"@{nl="Coördinator"}
  role reviewer label=label_reviewer
  Document { location:Location, title:text, category:text label="Category"@{nl="Categorie"}, subject:text?, submitter:user server=actor label="Submitter"@{nl="Indiener"}, email:email, current:int=0 label="Current revision"@{nl="Huidige revisie"} } label="Document"@{nl="Document"}
  Submission in Document { revision:int, file:file, note:text label=label_Submission_note, reviewer:user label=label_reviewer, reviewer_email:email label=label_Submission_reviewer_email, due:datetime, state:enum(pending,approved,rejected,withdrawn)=pending label={text="State"@{nl="Status"},values={pending="Pending"@{nl="In behandeling"},approved="Approved"@{nl="Goedgekeurd"},rejected="Rejected"@{nl="Afgewezen"},withdrawn="Withdrawn"@{nl="Ingetrokken"}}}, reason:text?, decided_by:user? label="Decision maker"@{nl="Beslist door"}, decided_at:datetime? label="Decision time"@{nl="Beslist op"} } label="Submitted version"@{nl="Ingediende versie"}
  event Due { submission:Submission, version:int }
  policy Document read=members where=row.submitter==actor
  policy Document read=coordinator and can_work(actor,row.location)
  policy Document read=reviewer where=any(row.Submission as submission,submission.reviewer==actor and submission.state!=withdrawn)
  policy Submission read=members where=row.parent.submitter==actor
  policy Submission read=coordinator and can_work(actor,row.parent.location)
  policy Submission read=reviewer where=row.reviewer==actor and row.state!=withdrawn and can_work(actor,row.parent.location)
  unique Submission fields=revision
  lock Submission fields=revision,file,note,due
  lock Submission fields=state,reason,decided_by,decided_at when=row.state in [approved,rejected,withdrawn]
  fixture document=Document {location=test_site,title="Plan",category="Signage",submitter=self,email="submitter@example.test"}
  preferences { review_state:Submission.state? label="Initial review state filter"@{nl="Eerste filter beoordelingsstatus"}, versions_open:bool=false label="Expand submitted version history"@{nl="Ingediende versiehistorie uitklappen"} }
  message label_reviewer = "Reviewer"@{nl="Beoordelaar"}
  message label_Submission_note = "Note"@{nl="Notitie"}
  message label_Submission_reviewer_email = "Reviewer email"@{nl="E-mail beoordelaar"}
 When
  crud Document by=members fields=title,category,subject create_fields=location,title,category,subject,email when=row.submitter==actor and can_work(actor,row.location) delete=none
   examples update seed=[test_worker] record=document
    as,changes.title -> document.title
    members,"New title" -> "New title"
    outsider,"New title" -> error(not_found)
  # Replace a pending file with a new submitted revision and invalidate its old decision. @{nl="Vervang een wachtend bestand door een nieuwe ingediende revisie en maak het oude besluit ongeldig."}
  scenario submit(document:Document,file:file,note:text label=label_Submission_note,reviewer:user label=label_reviewer,reviewer_email:email label=label_Submission_reviewer_email,due:datetime) by=members
   require document.submitter==actor and reviewer!=actor and can_work(reviewer,document.location) and due>now
   do
    let revision=document.current+1
    for old in document.Submission as submission where submission.state==pending limit=100
     set old {state=withdrawn}
     cancel old.id
    create Submission {parent=document,revision,file,note,reviewer,reviewer_email,due} as submission
    set document {current=revision}
    send Mail.send {to=reviewer_email,subject=format("Document review requested"@{nl="Documentbeoordeling aangevraagd"},locale=null),body=document.title} when=submission.state==pending and submission.reviewer==reviewer as notice
    schedule submission.id at=due event=Due {submission,version=submission.version}
  # Reassign the current pending review, retaining assignment history. @{nl="Wijs de huidige wachtende beoordeling opnieuw toe en behoud de toewijzingshistorie."}
  scenario assign(submission:Submission,reviewer:user label=label_reviewer,email:email) by=coordinator
   require can_work(actor,submission.parent.location) and submission.state==pending and reviewer!=submission.parent.submitter and can_work(reviewer,submission.parent.location)
   do
    set submission {reviewer,reviewer_email=email}
    schedule submission.id at=submission.due event=Due {submission,version=submission.version+1}
  # Decide exactly the current pending file version with rejection reason or approval conditions. @{nl="Beslis over precies de huidige ingediende bestandsversie met afwijzingsreden of goedkeuringsvoorwaarden."}
  scenario decide(submission:Submission,approve:bool label="Approve"@{nl="Goedkeuren"},reason:text) by=reviewer label="Record decision"@{nl="Besluit vastleggen"}
   require submission.reviewer==actor and submission.parent.submitter!=actor and submission.state==pending and submission.revision==submission.parent.current and can_work(actor,submission.parent.location) and (approve or trim(reason)!="")
   do
    if approve
     set submission {state=approved,reason,decided_by=actor,decided_at=now}
    else
     set submission {state=rejected,reason,decided_by=actor,decided_at=now}
    cancel submission.id
    send Mail.send {to=submission.parent.email,subject=format("Document review decision"@{nl="Besluit documentbeoordeling"},locale=null),body=reason} as notice
  # Withdraw your pending version without erasing prior decisions. @{nl="Trek je wachtende versie in zonder eerdere besluiten te wissen."}
  scenario withdraw(submission:Submission) by=members label="Withdraw"@{nl="Intrekken"}
   require submission.parent.submitter==actor and submission.state==pending
   do
    set submission {state=withdrawn}
    cancel submission.id
  scenario remind on=Due
   require event.submission.state==pending and event.submission.version==event.version
   do send Mail.send {to=event.submission.reviewer_email,subject=format("Document review due"@{nl="Deadline documentbeoordeling"},locale=null),body=event.submission.parent.title} when=event.submission.state==pending as notice
 Then
  # Submit and follow your own exact document versions. @{nl="Dien je eigen exacte documentversies in en volg ze."}
  page /documents title="My submissions"@{nl="Mijn inzendingen"}
   require members
   card "Document intake"@{nl="Document aanmaken"}
    form Document.create
   list Document columns=title,location,category,current filter=location,category search=title display=split
    card "Current document"@{nl="Huidig document"}
     edit
     form submit
    details "Submitted version history"@{nl="Ingediende versiehistorie"} open=preferences.versions_open
     table row.Submission columns=revision,file,note,reviewer,due,state,reason order=-revision
      action withdraw
      details "Version decision history"@{nl="Besluithistorie versies"}
       text row.decided_by,row.decided_at
       history
  # Review assigned submissions or coordinate permitted assignments. @{nl="Beoordeel toegewezen inzendingen of coördineer toegestane toewijzingen."}
  page /documents/review title="Review queue"@{nl="Beoordelingswachtrij"}
   require reviewer or coordinator
   table Submission columns=parent,revision,file,note,reviewer,due,state order=due filter=state defaults={state=preferences.review_state} display=split
    card "Exact submitted version"@{nl="Exact ingediende versie"}
     text row.revision,row.file,row.note,row.due,row.state,row.reason
     actions decide,assign
    details "Review history"@{nl="Beoordelingshistorie"}
     text row.decided_by,row.decided_at
     history
