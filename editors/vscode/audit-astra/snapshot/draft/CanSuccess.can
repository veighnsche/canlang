# Help workspace account managers retain business customers by coordinating move-in, usage reviews, issues, and membership or agreement renewals. @{nl="Help werkplekklantbeheerders zakelijke klanten te behouden door ingebruikname, gebruiksbesprekingen, problemen en lidmaatschaps- of contractverlengingen te coördineren."}
app CanSuccess uses=[success]

# Track account milestones and private follow-up without treating tasks as paid renewal. @{nl="Volg klantmijlpalen en privéopvolging zonder taken als betaalde verlenging te behandelen."}
package success
 use customer {Customer,test_company}
 use rent_catalog {Location,test_site}
 use employee {can_work,staff,test_worker}
 use std {EmailV1 as Mail} from=deployment.mail
 Given
  export contract WorkItem { reference:text, revision:int, location:text?, title:text, detail:text?, due:datetime?, action:action(complete) } label="Authorized work item"@{nl="Toegestaan werkitem"}
  export contract WorkBatch { items:WorkItem[]! max=500 } label="Authorized work batch"@{nl="Toegestane werkverzameling"}
  preferences { location:Location?, risk_filter:Account.risk? label="Initial risk filter"@{nl="Eerste risicofilter"} }
  message label_account_manager = "Account manager"@{nl="Klantbeheerder"}
  message label_Milestone_completed_by = "Completed by"@{nl="Afgerond door"}
  message label_Milestone_completed_at = "Completed at"@{nl="Afgerond op"}
  message label_FollowUp = "Follow-up"@{nl="Opvolgtaak"}
  role account_manager label=label_account_manager
  Account in Customer { location:Location, manager:user label=label_account_manager, email:email, renewal:date? label="Renewal date"@{nl="Verlengingsdatum"}, risk:enum(low,medium,high)=low label={text="Assessed renewal risk"@{nl="Beoordeeld verlengingsrisico"},values={low="Low"@{nl="Laag"},medium="Medium"@{nl="Gemiddeld"},high="High"@{nl="Hoog"}}}, risk_reason:text? label="Risk assessment reason"@{nl="Reden voor risicobeoordeling"}, notes:text?, agreement:text? label="Agreement reference"@{nl="Overeenkomstreferentie"}, membership:text? label="Membership reference"@{nl="Lidmaatschapsreferentie"}, active:bool=true } label="Customer account"@{nl="Klantdossier"}
  Milestone in Account { title:text trim min=1, due:date, done:bool=false, completed_by:user? label=label_Milestone_completed_by, completed_at:datetime? label=label_Milestone_completed_at } label="Account milestone"@{nl="Klantmijlpaal"}
  export FollowUp in Account { title:text, due:datetime, assignee:user label="Assignee"@{nl="Toegewezen aan"}, email:email, done:bool=false, completed_by:user? label=label_Milestone_completed_by, completed_at:datetime? label=label_Milestone_completed_at } label=label_FollowUp
  event RenewalDue { account:Account, revision:int }
  event FollowUpDue { followup:FollowUp, revision:int, account_revision:int }
  derive Account.progress:decimal = count(row.Milestone as item where item.done)*100/max([1,count(row.Milestone)]) label="Milestone completion percentage"@{nl="Percentage afgeronde mijlpalen"}
  policy Account read=account_manager and can_work(actor,row.location)
  policy Milestone read=account_manager and can_work(actor,row.parent.location)
  policy FollowUp read=account_manager and can_work(actor,row.parent.location)
  require Account: staff(row.manager) and (row.risk==low or row.risk_reason!=null)
  require FollowUp: staff(row.assignee)
  fixture managed=Account {parent=test_company,location=test_site,manager=self,email="manager@example.test"}
  fixture followup=FollowUp {parent=managed,title="Renewal conversation",due=datetime("2099-01-01T09:00:00Z"),assignee=self,email="manager@example.test"}
 When
  crud Account by=account_manager fields=manager,email,renewal,risk,risk_reason,notes,agreement,membership,active create_fields=location,manager,email,renewal,risk,risk_reason,notes,agreement,membership when=can_work(actor,row.location) delete=none
  crud Milestone by=account_manager fields=title,due when=can_work(actor,row.parent.location)
  crud FollowUp by=account_manager fields=title,due,assignee,email when=can_work(actor,row.parent.location) delete=none
  # Complete a current account milestone with attribution. @{nl="Rond een huidige klantmijlpaal met toeschrijving af."}
  scenario milestone(milestone:Milestone) by=account_manager label="Complete milestone"@{nl="Mijlpaal afronden"}
   require can_work(actor,milestone.parent.location) and milestone.parent.active and not milestone.done
   do set milestone {done=true,completed_by=actor,completed_at=now}
  # Complete a follow-up without renewing the underlying paid term. @{nl="Rond een opvolgtaak af zonder de onderliggende betaalde periode te verlengen."}
  export scenario complete(followup:FollowUp label=label_FollowUp) by=account_manager
   require can_work(actor,followup.parent.location) and followup.parent.active and not followup.done
   do
    set followup {done=true,completed_by=actor,completed_at=now}
    cancel followup.id
   examples seed=[test_worker] followup=followup
    as,followup.done -> followup.done
    account_manager,false -> true
    account_manager,true -> error(rule_failed)
    members,false -> error(forbidden)
  # Reassign open follow-ups to an active manager and its entered delivery destination. @{nl="Wijs open opvolgtaken opnieuw toe aan een actieve beheerder en diens ingevoerde verzendbestemming."}
  scenario reassign(account:Account,manager:user label=label_account_manager,email:email) by=account_manager label="Reassign account"@{nl="Klantdossier opnieuw toewijzen"}
   require can_work(actor,account.location) and staff(manager)
   do
    set account {manager,email}
    cancel account.id
    if account.active and account.renewal!=null
     let due=local_instant(account.renewal,"00:00",account.location.timezone,fold=earlier)
     if due>now
      schedule account.id at=due event=RenewalDue {account,revision=account.version+1}
    for followup in account.FollowUp as item where not item.done limit=100
     set followup {assignee=manager,email}
     cancel followup.id
     if account.active and followup.due>now
      schedule followup.id at=followup.due event=FollowUpDue {followup,revision=followup.version+1,account_revision=account.version+1}
  scenario arm on=FollowUp.create
   do
    if event.after.parent.active and not event.after.done and event.after.due>now
     schedule event.after.id at=event.after.due event=FollowUpDue {followup=event.after,revision=event.after.version,account_revision=event.after.parent.version}
  scenario reschedule on=FollowUp.update
   do
    cancel event.after.id
    if event.after.parent.active and not event.after.done and event.after.due>now
     schedule event.after.id at=event.after.due event=FollowUpDue {followup=event.after,revision=event.after.version,account_revision=event.after.parent.version}
  scenario account_created on=Account.create
   do
    if event.after.active and event.after.renewal!=null
     let due=local_instant(event.after.renewal,"00:00",event.after.location.timezone,fold=earlier)
     if due>now
      schedule event.after.id at=due event=RenewalDue {account=event.after,revision=event.after.version}
  scenario account_changed on=Account.update
   do
    cancel event.after.id
    if event.after.active and event.after.renewal!=null
     let due=local_instant(event.after.renewal,"00:00",event.after.location.timezone,fold=earlier)
     if due>now
      schedule event.after.id at=due event=RenewalDue {account=event.after,revision=event.after.version}
    for followup in event.after.FollowUp as item where not item.done limit=100
     cancel followup.id
     if event.after.active and followup.due>now
      schedule followup.id at=followup.due event=FollowUpDue {followup,revision=followup.version,account_revision=event.after.version}
  scenario remind on=FollowUpDue
   require event.followup.version==event.revision and event.followup.parent.version==event.account_revision and not event.followup.done and event.followup.parent.active
   do send Mail.send {to=event.followup.email,subject=format("Account follow-up"@{nl="Klantopvolging"},locale=null),body=event.followup.title} when=event.followup.version==event.revision and event.followup.parent.version==event.account_revision and not event.followup.done and event.followup.parent.active as notice
  # Remind the current manager at the location's renewal-date boundary without renewing paid terms. @{nl="Herinner de huidige beheerder op de lokale verlengingsdatum zonder betaalde voorwaarden te verlengen."}
  scenario renewal_due on=RenewalDue
   require event.account.version==event.revision and event.account.active and event.account.renewal!=null
   do send Mail.send {to=event.account.email,subject=format("Account renewal due"@{nl="Klantverlenging nodig"},locale=null),body=format("Review the recorded renewal date; renewal remains a separate agreement action."@{nl="Controleer de vastgelegde verlengingsdatum; verlenging blijft een afzonderlijke overeenkomstactie."},locale=null)} when=event.account.version==event.revision and event.account.active and event.account.renewal!=null as notice
  # Return only current eligible work under the canonical completion authority. @{nl="Geef alleen actueel uitvoerbaar werk terug binnen de canonieke afrondingsbevoegdheid."}
  export scenario work(locations:text[]) read=true scope=authority -> WorkBatch by=account_manager
   do return WorkBatch {items=FollowUp as item where (can_work(actor,item.parent.location) and item.parent.active and not item.done) and (count(locations)==0 or item.parent.location.id in locations) select WorkItem {reference=item.id,revision=item.version,location=item.parent.location.id,title=item.title,detail=null,due=item.due,action=action(complete,{followup=item})}}
  # Revalidate the selected item before presenting its protected canonical action. @{nl="Controleer het gekozen item opnieuw voordat de beschermde canonieke actie wordt getoond."}
  export scenario work_detail(record:FollowUp) read=true scope=authority -> WorkItem by=account_manager
   require can_work(actor,record.parent.location) and record.parent.active and not record.done
   do return WorkItem {reference=record.id,revision=record.version,location=record.parent.location.id,title=record.title,detail=null,due=record.due,action=action(complete,{followup=record})}
 Then
  # Review renewal risk, dated milestones and source agreement references. @{nl="Beoordeel verlengingsrisico, gedateerde mijlpalen en bronreferenties naar overeenkomsten."}
  page /customer-success title="Customer success"@{nl="Klantopvolging"}
   require account_manager
   card "Customer selection"@{nl="Klantselectie"}
    list Customer
     form Account.create
   card "Renewal portfolio"@{nl="Verlengingsportefeuille"}
    list Account filter=location,manager,risk,active defaults={location=preferences.location,risk=preferences.risk_filter} order=renewal display=split
     edit
     text row.renewal,row.risk,row.risk_reason,row.agreement,row.membership
     metrics row.progress
     form reassign
     details "Risk assessment and source references"@{nl="Risicobeoordeling en bronreferenties"}
      text row.notes
     tabs
      tab "Account milestones"@{nl="Klantmijlpalen"}
       form Milestone.create
       table row.Milestone columns=title,due,done order=due filter=done
        edit
        action milestone
      tab "Dated follow-ups"@{nl="Gedateerde opvolgtaken"}
       form FollowUp.create
       table row.FollowUp columns=title,due,assignee,done order=due filter=done
        edit
        action complete
     history
