# Help reception and support teams handle booking changes, billing questions, Wi-Fi problems, and member service requests across workspace locations. @{nl="Help receptie- en supportteams boekingswijzigingen, factuurvragen, wifi-problemen en ledenserviceverzoeken op werkpleklocaties behandelen."}
app CanDesk uses=[desk]

# Keep customer-visible support messages separate from private staff notes and unrelated business actions. @{nl="Houd klantzichtbare supportberichten gescheiden van privénotities en andere bedrijfsacties."}
package desk
 use customer {Customer}
 use rent_catalog {Location,test_site}
 use employee {can_work,staff,test_worker}
 use std {EmailV1 as Mail} from=deployment.mail
 use desk {InboxV1 as Inbox} from=deployment.support_inbox
 Given
  export contract IncomingMail { id:text, sender:email label=label_IncomingMail_sender, recipient:email label=label_IncomingMail_recipient, thread:text? label=label_IncomingMail_thread, subject:text max=300, body:text max=30000, attachments:file[] label=label_IncomingMail_attachments } label="Incoming support mail"@{nl="Inkomende supportmail"}
  export capability InboxV1 version=1
   event received { value:IncomingMail }
  role support label="Support staff"@{nl="Supportmedewerker"}
  Ticket { location:Location, customer:Customer? label="Customer"@{nl="Klant"}, subject:text trim min=1, email:email, thread:text unique label=label_IncomingMail_thread, category:text label=label_Ticket_category, priority:enum(low,normal,urgent)=normal label={text="Priority"@{nl="Prioriteit"},values={low="Low"@{nl="Laag"},normal="Normal"@{nl="Normaal"},urgent="Urgent"@{nl="Urgent"}}}, assignee:user? label="Assignee"@{nl="Toegewezen aan"}, queue:text label=label_Ticket_queue, state:enum(open,waiting_on_customer,resolved)=open label={text=label_Ticket_state,values={open="Open"@{nl="Open"},waiting_on_customer="Waiting on customer"@{nl="Wacht op klant"},resolved="Resolved"@{nl="Opgelost"}}}, escalation:text? label="Escalation"@{nl="Escalatie"}, related:text? label="Related work reference"@{nl="Referentie gerelateerd werk"} } label="Support request"@{nl="Supportverzoek"}
  Message in Ticket { external_id:text unique label=label_Message_external_id, kind:enum(customer,reply,note) label={text="Kind"@{nl="Soort"},values={customer="Customer message"@{nl="Klantbericht"},reply="Customer reply"@{nl="Antwoord aan klant"},note="Private staff note"@{nl="Privénotitie"}}}, body:text max=30000, sender:email label=label_IncomingMail_sender, recipient:email label=label_IncomingMail_recipient, author:user? label="Author"@{nl="Auteur"}, attachments:file[] label=label_IncomingMail_attachments, delivery:text? label="Delivery reference"@{nl="Afleverreferentie"}, state:enum(received,queued,sent,failed,unknown)=received label={text=label_Ticket_state,values={received="Received"@{nl="Ontvangen"},queued="Queued"@{nl="In wachtrij"},sent="Sent"@{nl="Verzonden"},failed="Failed"@{nl="Mislukt"},unknown="Unknown"@{nl="Onbekend"}}} } label="Support message"@{nl="Supportbericht"}
  Unmatched { external_id:text unique label=label_Message_external_id, sender:email label=label_IncomingMail_sender, recipient:email label=label_IncomingMail_recipient, subject:text, body:text, thread:text? label=label_IncomingMail_thread, received:datetime server=now label="Received at"@{nl="Ontvangen op"} } label="Unmatched support mail"@{nl="Ongekoppelde supportmail"}
  policy Ticket read=support and can_work(actor,row.location)
  policy Ticket read=authenticated where=actor.email_verified and row.email==actor.email fields=subject,category,priority,state
  policy Message read=support and can_work(actor,row.parent.location)
  policy Message read=authenticated where=actor.email_verified and row.parent.email==actor.email and row.kind!=note fields=kind,body,sender,recipient,attachments,state,created
  policy Unmatched read=support
  require Ticket: row.assignee==null or (staff(row.assignee) and can_work(row.assignee,row.location))
  lock Message fields=external_id,kind,body,sender,recipient,author,attachments
  fixture conversation=Ticket {location=test_site,subject="Wi-Fi",email="customer@example.test",thread="thread",category="Connectivity",queue="Reception"}
  preferences { state:Ticket.state?, priority:Ticket.priority? }
  message label_IncomingMail_sender = "Sender"@{nl="Afzender"}
  message label_IncomingMail_recipient = "Recipient"@{nl="Ontvanger"}
  message label_IncomingMail_thread = "Conversation token"@{nl="Gesprekstoken"}
  message label_IncomingMail_attachments = "Attachments"@{nl="Bijlagen"}
  message label_Ticket_category = "Category"@{nl="Categorie"}
  message label_Ticket_queue = "Queue"@{nl="Wachtrij"}
  message label_Ticket_state = "State"@{nl="Status"}
  message label_Message_external_id = "External identity"@{nl="Externe identiteit"}
 When
  crud Ticket by=support fields=subject,category,priority,assignee,queue,state,escalation,related create_fields=location,customer,subject,email,thread,category,priority,assignee,queue when=can_work(actor,row.location) delete=none
  # Append a staff reply to the frozen conversation destination before queueing delivery. @{nl="Voeg een personeelsantwoord toe aan de vastgelegde gespreksbestemming voordat levering in de wachtrij komt."}
  scenario reply(ticket:Ticket,body:text,attachments:file[] label=label_IncomingMail_attachments) by=support label="Reply to customer"@{nl="Klant beantwoorden"}
   require can_work(actor,ticket.location) and trim(body)!=""
   do
    create Message {parent=ticket,external_id=operation.id,kind=reply,body,sender=actor.email,recipient=ticket.email,author=actor,attachments,state=queued} as message
    send Mail.send {to=message.recipient,subject=ticket.subject,body=message.body} as delivery
    set message {delivery=delivery.id}
    set ticket {state=waiting_on_customer}
  # Record a staff-only note that is never emailed to the customer. @{nl="Leg een personeelsnotitie vast die nooit naar de klant wordt gemaild."}
  scenario note(ticket:Ticket,body:text,attachments:file[] label=label_IncomingMail_attachments) by=support label="Add private staff note"@{nl="Privénotitie toevoegen"}
   require can_work(actor,ticket.location) and trim(body)!=""
   do create Message {parent=ticket,external_id=operation.id,kind=note,body,sender=actor.email,recipient=actor.email,author=actor,attachments} as note
   examples seed=[test_worker] ticket=conversation attachments=[]
    as,body -> count(conversation.Message),conversation.state
    support,"Restarted the router" -> 1,open
    support,"" -> error(rule_failed)
    members,"Restarted the router" -> error(forbidden)
  scenario incoming on=Inbox.received
   do
    require not any(Message as message,message.external_id==event.value.id) and not any(Unmatched as message,message.external_id==event.value.id)
    let ticket=first(Ticket as ticket where event.value.thread!=null and ticket.thread==event.value.thread and ticket.email==event.value.sender order=ticket.id)
    if ticket!=null
     create Message {parent=ticket,external_id=event.value.id,kind=customer,body=event.value.body,sender=event.value.sender,recipient=event.value.recipient,attachments=event.value.attachments} as message
     set ticket {state=open}
    else
     create Unmatched {external_id=event.value.id,sender=event.value.sender,recipient=event.value.recipient,subject=event.value.subject,body=event.value.body,thread=event.value.thread} as unmatched
  # Resolve a new or unknown thread through scoped staff triage, never a sender-supplied ticket ID. @{nl="Beoordeel een nieuwe of onbekende thread via beperkte personeelstriage, nooit via een ticket-ID van de afzender."}
  scenario triage(incoming:Unmatched label="Unmatched incoming mail"@{nl="Ongekoppelde inkomende mail"},location:Location,category:text label=label_Ticket_category,queue:text label=label_Ticket_queue) by=support label="Triage unmatched mail"@{nl="Ongekoppelde mail beoordelen"}
   require can_work(actor,location) and not any(Message as message,message.external_id==incoming.external_id)
   do
    create Ticket {location,subject=incoming.subject,email=incoming.sender,thread=operation.id,category,queue} as ticket
    create Message {parent=ticket,external_id=incoming.external_id,kind=customer,body=incoming.body,sender=incoming.sender,recipient=incoming.recipient} as message
  scenario sent on=Mail.send.completed
   do
    for message in Message as row where row.delivery==event.delivery_id limit=1
     if event.status==succeeded
      set message {state=sent}
     else
      if event.status==failed
       set message {state=failed}
      else
       set message {state=unknown}
 Then
  # Triage location queues and distinguish internal notes from customer replies. @{nl="Beoordeel locatiewachtrijen en onderscheid interne notities van klantantwoorden."}
  page /support title="Support"@{nl="Support"}
   require support
   card "Ticket intake"@{nl="Supportverzoek aanmaken"}
    form Ticket.create
   details "Unmatched mail triage"@{nl="Ongekoppelde mail beoordelen"}
    table Unmatched columns=sender,subject,received order=-received
     text row.recipient,row.body
     form triage
   list Ticket columns=subject,customer,queue,priority,state,assignee filter=location,state,priority,assignee,category,queue defaults={state=preferences.state,priority=preferences.priority} search=subject display=split
    card "Request and responsible queue"@{nl="Verzoek en verantwoordelijke wachtrij"}
     text row.location,row.customer,row.email,row.category,row.queue,row.priority,row.assignee,row.state,row.escalation,row.related
     edit
    tabs
     tab "Customer conversation"@{nl="Klantgesprek"}
      form reply
      table row.Message as message where message.kind!=note columns=kind,body,sender,recipient,attachments,state order=created
       text row.author,row.created
     tab "Private staff notes"@{nl="Privénotities"}
      form note
      table row.Message as message where message.kind==note columns=body,author,created order=created
       text row.kind,row.sender,row.recipient,row.attachments,row.state
    history
  # Read only your authenticated customer conversation. @{nl="Lees uitsluitend je geauthenticeerde klantgesprek."}
  page /support/mine title="My support requests"@{nl="Mijn supportverzoeken"}
   require authenticated
   list Ticket filter=state,priority defaults={state=preferences.state,priority=preferences.priority} display=split
    text row.subject,row.category,row.priority,row.state
    table row.Message columns=kind,body,sender,recipient,attachments,state,created order=created
