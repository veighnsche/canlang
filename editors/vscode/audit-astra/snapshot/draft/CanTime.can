# Help workspace teams record time spent on customer services, facilities work, and location projects. @{nl="Help werkplekteams tijd voor klantdiensten, facilitair werk en locatieprojecten te registreren."}
app CanTime uses=[time]

# Record observed or manual employee time, freeze review evidence and export stable billable sources. @{nl="Registreer gemeten of handmatig ingevoerde medewerkerstijd, leg beoordelingsbewijs vast en exporteer stabiele factureerbare bronnen."}
package time label="Time tracking"@{nl="Tijdregistratie"}
 use employee {Employee,can_work,test_worker}
 use customer {Customer}
 use rent_catalog {Location,test_site}
 use invoice {BillingV1 as Billing} from=deployment.billing
 Given
  preferences { project:Project? label=label_Project, billable_filter:bool? label="Initial billable filter"@{nl="Eerste facturatiefilter"} }
  message label_Project = "Time project"@{nl="Tijdregistratieproject"}
  message label_Entry_from = "Started at"@{nl="Gestart op"}
  message label_Entry_until = "Stopped at"@{nl="Gestopt op"}
  message label_Entry_billable = "Billable"@{nl="Factureerbaar"}
  role project_manager label="Project manager"@{nl="Projectmanager"}
  Project { name:text, location:Location, customer:Customer? label="Customer"@{nl="Klant"}, rate:money label="Current hourly rate"@{nl="Huidig uurtarief"}, active:bool=true } label=label_Project
  Entry in Employee { project:Project label="Project"@{nl="Project"}, description:text, from:datetime label=label_Entry_from, until:datetime? label=label_Entry_until, rate:money label="Frozen rate"@{nl="Vastgelegd tarief"}, billable:bool=true label=label_Entry_billable, origin:enum(timer,manual) label={text="Time origin"@{nl="Herkomst tijdregistratie"},values={timer="Observed timer"@{nl="Gemeten timer"},manual="Manual entry"@{nl="Handmatige registratie"}}}, reason:text?, state:enum(draft,submitted,approved,rejected,exported)=draft label={text="State"@{nl="Status"},values={draft="Draft"@{nl="Concept"},submitted="Submitted"@{nl="Ingediend"},approved="Approved"@{nl="Goedgekeurd"},rejected="Rejected"@{nl="Afgewezen"},exported="Sent for billing"@{nl="Verzonden voor facturatie"}}}, decision:text? label="Review decision"@{nl="Beoordelingsbesluit"}, exported_source:text? label="Billing source reference"@{nl="Facturatiebronreferentie"}, delivery:text? label="Delivery reference"@{nl="Verzendingsreferentie"} } label="Time entry"@{nl="Tijdregistratie"}
  Correction in Entry { reason:text, replacement:Entry label="Replacement entry"@{nl="Vervangende registratie"}, author:user server=actor label="Recorded by"@{nl="Vastgelegd door"} } label="Time correction"@{nl="Tijdcorrectie"}
  derive Entry.duration:duration = (row.until ?? now)-row.from
  derive Entry.amount:money = row.rate*(row.duration/1h)
  policy Project read=members and can_work(actor,row.location)
  policy Entry read=members where=row.parent.user==actor
  policy Entry read=project_manager and can_work(actor,row.project.location)
  policy Correction read=members where=row.parent.parent.user==actor
  policy Correction read=project_manager and can_work(actor,row.parent.project.location)
  require Entry: row.until==null or row.until>row.from
  unique Entry fields=parent where=row.until==null
  lock Entry fields=project,description,from,until,rate,billable,origin,reason when=row.state in [submitted,approved,exported]
  lock Correction fields=reason,replacement,author
  fixture project=Project {name="Repair",location=test_site,rate=money(30,"EUR")}
  fixture stopped=Entry {parent=test_worker,project=project,description="Visit",from=datetime("2026-10-01T22:00:00Z"),until=datetime("2026-10-02T02:00:00Z"),rate=money(30,"EUR"),origin=timer}
 When
  crud Project by=project_manager fields=name,rate,active create_fields=name,location,customer,rate when=can_work(actor,row.location) delete=none
  # Start your sole running timer at server time and snapshot the current rate. @{nl="Start je enige lopende timer op servertijd en leg het huidige tarief vast."}
  scenario start(employee:Employee,project:Project,description:text,billable:bool=true label=label_Entry_billable) by=members label="Start timer"@{nl="Timer starten"}
   require employee.user==actor and employee.active and project.active and can_work(actor,project.location) and not any(employee.Entry as entry,entry.until==null)
   do create Entry {parent=employee,project,description,from=now,rate=project.rate,billable,origin=timer} as entry
  # Fix a running timer's end exactly once. @{nl="Leg de eindtijd van een lopende timer precies eenmaal vast."}
  scenario stop(entry:Entry) by=members label="Stop timer"@{nl="Timer stoppen"}
   require entry.parent.user==actor and entry.state==draft
   do
    if entry.until==null
     require now>entry.from
     set entry {until=now}
   examples entry=stopped
    as,entry.state -> entry.until,entry.duration,entry.amount
    members,draft -> datetime("2026-10-02T02:00:00Z"),4h,money(120,"EUR")
    members,approved -> error(rule_failed)
    public,draft -> error(forbidden)
  # Record entered time explicitly and reject overlaps with existing work. @{nl="Registreer ingevoerde tijd expliciet en weiger overlap met bestaand werk."}
  scenario manual(employee:Employee,project:Project,description:text,from:datetime label=label_Entry_from,until:datetime label=label_Entry_until,billable:bool label=label_Entry_billable,reason:text) by=members label="Record manual time"@{nl="Tijd handmatig registreren"}
   require employee.user==actor and employee.active and can_work(actor,project.location) and from<until and trim(reason)!=""
   require not any(employee.Entry as entry,entry.state!=rejected and overlaps(from,until,entry.from,entry.until ?? now))
   do create Entry {parent=employee,project,description,from,until,rate=project.rate,billable,origin=manual,reason} as entry
  # Submit finished own time for review without allowing edits underneath the reviewer. @{nl="Dien afgeronde eigen tijd ter beoordeling in zonder wijzigingen onder de beoordelaar toe te staan."}
  scenario submit(entry:Entry) by=members
   require entry.parent.user==actor and entry.state==draft and entry.until!=null
   do set entry {state=submitted}
  # Decide frozen finished time with an attributed reason. @{nl="Beoordeel vastgelegde afgeronde tijd met een toegeschreven reden."}
  scenario decide(entry:Entry,approve:bool label="Approve"@{nl="Goedkeuren"},reason:text) by=project_manager label="Review time"@{nl="Tijd beoordelen"}
   require can_work(actor,entry.project.location) and entry.state==submitted and trim(reason)!=""
   do
    if approve
     set entry {state=approved,decision=reason}
    else
     set entry {state=rejected,decision=reason}
  # Create replacement evidence for rejected or previously approved work. @{nl="Maak vervangend bewijs voor afgewezen of eerder goedgekeurd werk."}
  scenario correct(entry:Entry,from:datetime label="Replacement start"@{nl="Vervangend begin"},until:datetime label="Replacement end"@{nl="Vervangend einde"},reason:text) by=project_manager label="Correct time"@{nl="Tijd corrigeren"}
   require can_work(actor,entry.project.location) and entry.state in [rejected,approved,exported] and from<until and trim(reason)!=""
   do
    create Entry {parent=entry.parent,project=entry.project,description=entry.description,from,until,rate=entry.rate,billable=entry.billable,origin=manual,reason} as replacement
    create Correction {parent=entry,reason,replacement} as correction
  # Queue an approved billable charge once; export is distinct from invoice issue and payment. @{nl="Zet goedgekeurde factureerbare kosten eenmalig in de wachtrij; export staat los van factuuruitgifte en betaling."}
  scenario bill(entry:Entry) by=project_manager label="Send billable time"@{nl="Factureerbare tijd verzenden"}
   require can_work(actor,entry.project.location) and entry.state==approved and entry.billable and entry.project.customer!=null and entry.amount.minor>0
   do
    send Billing.charge {value={source=entry.id,customer=entry.project.customer.id,location=entry.project.location.id,description=entry.description,amount=entry.amount,due=local_date(now,entry.project.location.timezone)}} as delivery
    set entry {state=exported,exported_source=entry.id,delivery=delivery.id}
 Then
  # Start, stop and submit your time with clear observed versus entered evidence. @{nl="Start, stop en dien je tijd in met duidelijk onderscheid tussen gemeten en ingevoerd bewijs."}
  page /time/mine title="My time"@{nl="Mijn tijd"}
   require members
   card "Timer and manual time intake"@{nl="Timer- en handmatige tijdinvoer"} layout=columns
    form start display=inline
    form manual
   card "Your time entries"@{nl="Jouw tijdregistraties"}
    table Entry columns=project,description,from,until,origin,duration,amount,state filter=project,billable,state defaults={project=preferences.project,billable=preferences.billable_filter} order=-from display=split
     actions stop,submit
     details "Observed and entered evidence"@{nl="Gemeten en ingevoerd bewijs"}
      text row.rate,row.billable,row.reason,row.decision
     history
  # Review frozen entries and authorized billable sources grouped by currency. @{nl="Beoordeel vastgelegde registraties en toegestane factureerbare bronnen per valuta."}
  page /time/review title="Time review"@{nl="Tijdbeoordeling"}
   require project_manager
   card "Project rates"@{nl="Projecttarieven"}
    form Project.create
    table Project columns=name,location,rate,active
     edit
   card "Frozen entries for review"@{nl="Vastgelegde registraties ter beoordeling"}
    table Entry columns=parent,project,from,until,rate,amount,state filter=project,state,billable defaults={project=preferences.project,billable=preferences.billable_filter} order=-from display=split
     actions decide,correct,bill
     details "Correction and billing evidence"@{nl="Correctie- en facturatiebewijs"}
      text row.origin,row.billable,row.reason,row.decision,row.exported_source,row.delivery
      table row.Correction columns=reason,replacement,author
     history
