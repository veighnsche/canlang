{
  "name": "@canlang/cloudflare",
  "version": "0.1.0",
  "license": "MIT",
  "description": "CanLang Cloudflare delivery: local dev, deploy plans, compatibility checks, upgrade orchestration (lane 07). Node-side tooling only; Worker entry is a separate export.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "can-platform": "./dist/cli/platform.js",
    "can-dev": "./dist/dev/control-cli.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/entry.d.ts",
      "default": "./dist/worker/entry.js"
    },
    "./runtime/artifact": {
      "types": "./dist/runtime/artifact.d.ts",
      "default": "./dist/runtime/artifact.js"
    },
    "./deploy/compat": {
      "types": "./dist/deploy/compat.d.ts",
      "default": "./dist/deploy/compat.js"
    },
    "./worker/assembly": {
      "types": "./dist/worker/assembly.d.ts",
      "default": "./dist/worker/assembly.js"
    },
    "./runtime/modules": {
      "types": "./dist/runtime/modules.d.ts",
      "default": "./dist/runtime/modules.js"
    },
    "./runtime/mcp-registry": {
      "types": "./dist/runtime/mcp-registry.d.ts",
      "default": "./dist/runtime/mcp-registry.js"
    },
    "./deploy/bundle": {
      "types": "./dist/deploy/bundle.d.ts",
      "default": "./dist/deploy/bundle.js"
    },
    "./dev/local-run": {
      "types": "./dist/dev/local-run.d.ts",
      "default": "./dist/dev/local-run.js"
    },
    "./runtime/stdlib": {
      "types": "./dist/runtime/stdlib.d.ts",
      "default": "./dist/runtime/stdlib.js"
    },
    "./dev/row-scope": {
      "types": "./dist/dev/row-scope.d.ts",
      "default": "./dist/dev/row-scope.js"
    },
    "./worker/main": {
      "types": "./dist/worker/main.d.ts",
      "default": "./dist/worker/main.js"
    },
    "./deploy/package-assets": {
      "types": "./dist/deploy/package-assets.d.ts",
      "default": "./dist/deploy/package-assets.js"
    },
    "./deploy/producer-files": {
      "types": "./dist/deploy/producer-files.d.ts",
      "default": "./dist/deploy/producer-files.js"
    },
    "./runtime/invoke": {
      "types": "./dist/runtime/invoke.d.ts",
      "default": "./dist/runtime/invoke.js"
    },
    "./runtime/bound-mail": {
      "types": "./dist/runtime/bound-mail.d.ts",
      "default": "./dist/runtime/bound-mail.js"
    },
    "./runtime/bound-text-generation": {
      "types": "./dist/runtime/bound-text-generation.d.ts",
      "default": "./dist/runtime/bound-text-generation.js"
    },
    "./runtime/bound-images": {
      "types": "./dist/runtime/bound-images.d.ts",
      "default": "./dist/runtime/bound-images.js"
    },
    "./runtime/bound-dispatch": {
      "types": "./dist/runtime/bound-dispatch.d.ts",
      "default": "./dist/runtime/bound-dispatch.js"
    },
    "./runtime/bound-files": {
      "types": "./dist/runtime/bound-files.d.ts",
      "default": "./dist/runtime/bound-files.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "node ../../scripts/run-tasks.mjs typecheck:check --filter=@canlang/cloudflare",
    "build:emit": "tsc -p tsconfig.json && chmod +x dist/cli/platform.js dist/dev/control-cli.js",
    "typecheck:check": "tsc --noEmit -p tsconfig.json",
    "test:runtime": "cd ../.. && node --test \"packages/cloudflare/dist/**/*.test.js\"",
    "build:prepare": "node ../../scripts/build-package.mjs --prepare"
  },
  "dependencies": {
    "@canlang/contracts": "workspace:*",
    "@canlang/interfaces": "workspace:*",
    "miniflare": "4.20260730.0",
    "@canlang/identity": "workspace:*",
    "@canlang/state": "workspace:*",
    "@canlang/work": "workspace:*",
    "@canlang/ui": "workspace:*",
    "@canlang/stdlib": "workspace:*",
    "@canlang/values": "workspace:*",
    "@canlang/services": "workspace:*",
    "es-module-lexer": "3.0.3",
    "magic-string": "1.4.3",
    "@jridgewell/sourcemap-codec": "1.6.0",
    "@jridgewell/remapping": "2.3.5",
    "acorn": "8.18.0",
    "eslint-scope": "8.4.0",
    "estree-walker": "3.0.3",
    "@canlang/files": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@types/node": "24.19.1",
    "happy-dom": "20.14.5",
    "vitest": "^3.2.4",
    "@types/eslint-scope": "3.7.7"
  }
}
