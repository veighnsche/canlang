app AuthorityProbe
Given
 Anchor {label:text}
 Secret in Anchor {blocked:bool,hidden:bool}
 policy Anchor read=members
 policy Secret read=members and not row.hidden
 derive copy(anchor:Anchor):Anchor = anchor
 derive has_block(anchor:Anchor):bool = any(anchor.Secret as secret,secret.blocked)
When
 scenario enter(anchor:Anchor) -> bool by=members
  require not has_block(copy(anchor))
  do
   set anchor {label="entered"}
   return true
Then
