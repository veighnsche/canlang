## Original CanInvoice terminal handlers with their financial helpers.
app CanInvoice uses=[invoice]

package rent_catalog
 Given
  export Location {active:bool=true}
 When
 Then

package employee
 use rent_catalog {Location}
 Given
  export Employee {user:user,home:Location,locations:Location[],operator_wide:bool=false,active:bool=true,hidden:bool=false}
  export derive can_work(person:user,location:Location):bool = any(Employee as e,e.user==person and e.active and active_member(person,team) and (e.operator_wide or e.home==location or location in e.locations))
  policy Employee read=members and not row.hidden
 When
 Then

package customer
 Given
  export Customer {kind:enum(individual,company),hidden:bool=false}
  export Contact in Customer {account:user?,verified:bool=false,hidden:bool=false}
  export CompanyRole in Customer {account:user,role:enum(administrator,booker,billing),active:bool=true,hidden:bool=false}
  export derive has_role(person:user,org:Customer,role:CompanyRole.role):bool = any(org.CompanyRole as grant,grant.account==person and grant.role==role and grant.active)
  export derive owns(person:user,org:Customer):bool = org.kind==individual and any(org.Contact as contact,contact.account==person and contact.verified)
  policy Customer read=members and not row.hidden
  policy Contact read=members and not row.hidden
  policy CompanyRole read=members and not row.hidden
 When
 Then

package invoice
 use customer {Customer,Contact,CompanyRole,has_role,owns}
 use rent_catalog {Location}
 use employee {can_work}
 use std {PaymentState}
 use std {PaymentsV1 as Payments} from=deployment.payments
 Given
  role finance
  export Invoice in Customer {location:Location,source:text,currency:currency,state:enum(draft,issued,void_pending,void)=draft,total:money,next_collection:datetime?,ledger_revision:int=0,first_paid_at:datetime?,hidden:bool=false}
  Attempt in Invoice {reference:text unique,amount:money,kind:enum(collection,refund),status:PaymentState.status=pending,failure:PaymentState.failure,disabled:bool=false,delivery:text?,checkout:url?,outcome_at:datetime?,received:datetime?,reference_readable:bool=true,hidden:bool=false}
  Credit in Invoice {amount:money,hidden:bool=false}
  ExternalPayment in Invoice {amount:money,received:datetime,hidden:bool=false}
  ExternalRefund in Invoice {amount:money,hidden:bool=false}
  PaymentRequest in Attempt {kind:enum(cancel,reconcile),cancellation:delivery(Payments.cancel)?,reconciliation:delivery(Payments.reconcile)?}
  event ProviderReceipt {value:PaymentState}
  CommercialHistory in Customer {complete:bool=false,first_invoice:Invoice?,evidence:text,hidden:bool=false}
  CommercialSale in Customer {source:text}
  event SaleCheck {sale:CommercialSale}
  contract Settlement {source:text,invoice:text,revision:int,amount:money,collected:money,refunded:money,collection_pending:bool,refund_pending:bool,state:Invoice.state,recorded_at:datetime}
  export event InvoiceSettlement {value:Settlement}
  derive first_receipt(invoice:Invoice):datetime? = min((invoice.Attempt as attempt where attempt.kind==collection and attempt.status==succeeded and attempt.received!=null select attempt.received)+(invoice.ExternalPayment as payment select payment.received))
  derive first_paid_invoice(customer:Customer):Invoice? = first(customer.Invoice as invoice where invoice.received.minor>0 and first_receipt(invoice)!=null order=first_receipt(invoice))
  derive settlement(invoice:Invoice):Settlement = Settlement {source=invoice.source,invoice=invoice.id,revision=invoice.ledger_revision,amount=invoice.total,collected=invoice.received,refunded=invoice.refunded,collection_pending=any(invoice.Attempt as attempt,attempt.kind==collection and attempt.status in [pending,unknown]),refund_pending=any(invoice.Attempt as attempt,attempt.kind==refund and attempt.status in [pending,unknown]),state=invoice.state,recorded_at=now}
  derive Invoice.credits:money = sum(row.Credit as credit select credit.amount,row.currency)
  derive Invoice.received:money = sum(row.Attempt as attempt where attempt.kind==collection and attempt.status==succeeded select attempt.amount,row.currency)+sum(row.ExternalPayment as payment select payment.amount,row.currency)
  derive Invoice.refunded:money = sum(row.Attempt as attempt where attempt.kind==refund and attempt.status==succeeded select attempt.amount,row.currency)+sum(row.ExternalRefund as refund select refund.amount,row.currency)
  derive Invoice.balance:money = max([money(0,row.currency),row.total-row.credits-row.received])
  policy CommercialHistory read=members and not row.hidden
  policy CommercialSale read=members
  policy Invoice read=members and not row.hidden
  policy Attempt read=members where=not row.hidden fields=amount,kind,status,failure,disabled,delivery,checkout,outcome_at,received
  policy Attempt read=members where=not row.hidden and row.reference_readable fields=reference
  policy Credit read=members and not row.hidden
  policy ExternalPayment read=members and not row.hidden
  policy ExternalRefund read=members and not row.hidden
 When
  scenario collect(invoice:Invoice) by=authenticated or finance label="Collect payment"@{nl="Betaling innen"}
   require invoice.state==issued and invoice.balance.minor>0 and (has_role(actor,invoice.parent,billing) or owns(actor,invoice.parent) or (finance and can_work(actor,invoice.location)))
   require not any(invoice.Attempt as attempt,attempt.kind==collection and (attempt.status in [pending,unknown] or (attempt.status==failed and attempt.failure==permanent)))
   do
    cancel format("{invoice}:collection",{invoice=invoice.id})
    set invoice {next_collection=null}
    create Attempt {parent=invoice,reference=operation.id,amount=invoice.balance,kind=collection} as attempt
    send Payments.collect {customer=invoice.parent.id,amount=attempt.amount,reference=attempt.reference,consent=null} when=invoice.state==issued and invoice.balance==attempt.amount and not attempt.disabled as delivery
    set attempt {delivery=delivery.id}
    set invoice {ledger_revision=invoice.ledger_revision+1}
    emit InvoiceSettlement {value=settlement(invoice)}
  scenario request_collect(reference:text,amount:money) -> int by=members
   do
    send Payments.collect {customer="customer",amount=amount,reference=reference,consent=null} as delivery
    return 1
  scenario request_refund(reference:text,amount:money) -> int by=members
   do
    send Payments.refund {payment=reference,reference=reference,amount=amount} as delivery
    return 1
  scenario request_cancel(retained:PaymentRequest,reference:text) -> int by=members
   do
    send Payments.cancel {reference=reference} as delivery
    set retained {cancellation=delivery}
    return 1
  scenario request_reconcile(retained:PaymentRequest,reference:text) -> int by=members
   do
    send Payments.reconcile {reference=reference} as delivery
    set retained {reconciliation=delivery}
    return 1
  scenario collected on=Payments.collect.completed
   do
    for attempt in Attempt as row where row.delivery==event.delivery_id and row.kind==collection limit=1
     if event.status==succeeded and event.result!=null
      require event.result.reference==attempt.reference and event.result.amount==attempt.amount
      emit ProviderReceipt {value=event.result}
     else
      if attempt.status in [pending,unknown] and event.status in [failed,unknown]
       set attempt {status=unknown,outcome_at=now}
       if attempt.parent.state==void_pending and not any(attempt.parent.Attempt as candidate,candidate.status in [pending,unknown]) and attempt.parent.received.minor==0
        set attempt.parent {state=void}
       set attempt.parent {ledger_revision=attempt.parent.ledger_revision+1}
       emit InvoiceSettlement {value=settlement(attempt.parent)}
     if attempt.status in [pending,unknown] and event.status==skipped
      set attempt {status=failed,failure=cancelled,outcome_at=now,checkout=null,disabled=true}
      if attempt.parent.state==void_pending and not any(attempt.parent.Attempt as candidate,candidate.status in [pending,unknown]) and attempt.parent.received.minor==0
       set attempt.parent {state=void}
      set attempt.parent {ledger_revision=attempt.parent.ledger_revision+1}
      emit InvoiceSettlement {value=settlement(attempt.parent)}
  scenario refunded on=Payments.refund.completed
   do
    for attempt in Attempt as row where row.delivery==event.delivery_id and row.kind==refund limit=1
     if event.status==succeeded and event.result!=null
      require event.result.reference==attempt.reference and event.result.amount==attempt.amount
      emit ProviderReceipt {value=event.result}
     else
      if attempt.status in [pending,unknown] and event.status in [failed,unknown]
       set attempt {status=unknown,outcome_at=now}
       set attempt.parent {ledger_revision=attempt.parent.ledger_revision+1}
       emit InvoiceSettlement {value=settlement(attempt.parent)}
  scenario checkout_cancelled on=Payments.cancel.completed
   do
    for request in PaymentRequest as row where row.cancellation?.id==event.delivery_id and row.kind==cancel limit=1
     let attempt=request.parent
     if event.status==succeeded and event.result!=null
      require event.result.reference==attempt.reference and event.result.amount==attempt.amount
      emit ProviderReceipt {value=event.result}
  scenario reconciled on=Payments.reconcile.completed
   do
    for request in PaymentRequest as row where row.reconciliation?.id==event.delivery_id and row.kind==reconcile limit=1
     let attempt=request.parent
     if event.status==succeeded and event.result!=null
      require event.result.reference==attempt.reference and event.result.amount==attempt.amount
      emit ProviderReceipt {value=event.result}
  scenario observe_commercial_payment on=InvoiceSettlement
   do
    for invoice in Invoice as invoice where invoice.id==event.value.invoice limit=1
     if invoice.received.minor>0
      let history=first(invoice.parent.CommercialHistory as history order=history.id)
      if history==null
       create CommercialHistory {parent=invoice.parent,complete=false,first_invoice=first_paid_invoice(invoice.parent),evidence="Unreviewed customer payment history"} as history
      else
       if history.first_invoice==null
        set history {first_invoice=first_paid_invoice(invoice.parent)}
      if invoice.first_paid_at==null
       let received=first_receipt(invoice)
       if received!=null
        set invoice {first_paid_at=received}
     for sale in invoice.parent.CommercialSale as sale limit=500
      emit SaleCheck {sale}
  scenario cancel_pending(invoice:Invoice) by=finance
   require can_work(actor,invoice.location)
   do
    for attempt in invoice.Attempt as candidate where candidate.kind==collection and candidate.status in [pending,unknown] limit=100
     set attempt {disabled=true,checkout=null}
     send Payments.cancel {reference=attempt.reference} as delivery
     create PaymentRequest {parent=attempt,kind=cancel,cancellation=delivery} as request
 Then
