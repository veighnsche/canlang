app HookFirstDelivery
Given
 Slot {label:text}
 Budget {source:text,approved:bool}
 event Tick {source:text}
 policy Slot read=public
 policy Budget read=public
When
 crud Slot by=owner fields=label
 crud Budget by=owner fields=source,approved
 ## Stage one declared-event occurrence keyed by a stored slot row.
 scenario arm(slot:Slot,at:datetime,source:text) -> int by=owner
  do
   schedule slot.id at=at event=Tick {source}
   return slot.version
 ## C23 hook slice: single unordered text-operand first over the event
 ## payload, consumed by one non-null conjunction. The plain pipeline
 ## reads it through the ordinary record scan; the native pipeline carries
 ## the checked query correspondence (firstQuery + plan + markers).
 scenario probe on=Tick
  do
   let budget=first(Budget as row where row.source==event.source)
   require budget!=null and budget.approved
Then
