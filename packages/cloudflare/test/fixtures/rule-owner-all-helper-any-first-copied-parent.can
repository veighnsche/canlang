app AllHelperAnyFirstCopiedParentProbe
Given
 Location {name:text}
 P {v:int,locations:Location[]=[]}
 C in P {account:user,role:enum(administrator,booker),locations:Location[]=[],active:bool=true,hidden:bool=false}
 I in P {role:C.role,invited_by:user,locations:Location[],done:bool=false}
 derive copy(parent:P):P = parent
 derive authorized(person:user,parent:P,role:C.role):bool = any(parent.C as grant,grant.account==person and grant.role==role and grant.active)
 derive authorized_at(person:user,parent:P,role:C.role,location:Location):bool = any(parent.C as grant,grant.account==person and grant.role==role and grant.active and location in grant.locations)
 policy Location read=members
 policy P read=members fields=v,locations
 policy C read=members and not row.hidden fields=parent,account,role,locations,active,hidden
 policy I read=members fields=parent,role,invited_by,locations,done
When
 crud P by=members fields=v
 crud C by=members fields=parent,account,role,active
 crud I by=members fields=parent,role,done
 scenario accept(invitation:I) by=members
  require authorized(invitation.invited_by,invitation.parent,administrator) and all(invitation.locations as location, location in invitation.parent.locations and authorized_at(invitation.invited_by,copy(invitation.parent),administrator,location))
  require not any(invitation.parent.C as grant,grant.account==actor and grant.role==invitation.role and grant.active)
  do
   let previous=first(invitation.parent.C as grant where grant.account==actor and grant.role==invitation.role order=grant.id)
   if previous==null
    create C {parent=invitation.parent,account=actor,role=invitation.role,locations=invitation.locations} as grant
   else
    set previous {active=true,locations=invitation.locations}
   set invitation {done=true}
Then
