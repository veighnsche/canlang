app SourceGuardEmit
Given
 Root {capacity:int=1,checked:bool=false,seen:bool=false,secret:text="Hidden field"}
 Child in Root {active:bool=true}
 event Checked {root:Root,message:text}
 derive Root.remaining:int=row.capacity-count(row.Child as child where child.active)
 derive allowed(root:Root):bool=any(root.Child as child,child.active)
 policy Root read=owner
 policy Child read=owner
 invariant Root: row.capacity>=0
When
 scenario notify(root:Root,message:text) -> date by=members
  require root.remaining>0
  require allowed(root)
  do
   set root {checked=true}
   emit Checked {root,message}
   return add_days(local_date(now,"UTC"),1)
 scenario abort(root:Root,message:text) -> date by=members
  require allowed(root)
  do
   set root {checked=true}
   emit Checked {root,message}
   set root {capacity=-1}
   return add_days(local_date(now,"UTC"),1)
 scenario observe on=Checked
  do
   set event.root {seen=true}
Then
