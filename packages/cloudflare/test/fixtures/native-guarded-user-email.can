app NativeGuardedEmail
use std {EmailV1 as Mail} from=deployment.mail
Given
 Entry {count:int=0,attempt:delivery(Mail.send_user)?}
 policy Entry read=members fields=count,attempt.status,attempt.result
When
 crud Entry by=owner fields=count
 scenario deliver(entry:Entry,enabled:bool,note:text?,values:int[],person:user,accept:bool) -> int by=owner
  do
   send Mail.send_user {to=person,subject="Original guarded Email",body="Frozen original lexical values"} when=enabled and (note==null or note!="deny") and count(values)>=0 and active_member(person,team) as attempt
   set entry {count=entry.count+1,attempt=attempt}
   require accept
   return entry.count
 scenario plain() -> int by=owner
  do
   send Mail.send_user {to=actor,subject="Original plain Email",body="Legacy native send"} as attempt
   return 1
Then
