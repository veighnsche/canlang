app NativeFileDeferred
Given
 Entry {label:text="Queued",attachment:file?}
 policy Entry read=owner fields=label,attachment
 policy Entry read=members fields=label
 event Retained {entry:Entry,attachment:file,note:text min=1 max=16 trim}
When
 crud Entry by=owner fields=label
 ## The File payload and schedule must share the original business fence.
 scenario arm(entry:Entry,attachment:file,due:datetime,accept:bool) by=owner
  do
   schedule "retained-file" at=due event=Retained {entry=entry,attachment=attachment,note=" Retained "}
   require accept
 scenario cancel_pending(entry:Entry) by=owner
  do cancel "retained-file"
 scenario fire on=Retained
  do require event.note=="Retained"
Then
