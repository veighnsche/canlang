{
  "compilerOptions": {
    "target": "ES2022",
    // Interim, mirroring lane 03 S1: ESNext/Bundler until the contracts
    // package import replaces relative source imports; NodeNext would emit
    // CJS for files outside this package. Relative imports keep explicit
    // .js suffixes throughout.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "noEmitOnError": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "bindings/**/*.ts", "../../contracts/src/values.ts"]
}
