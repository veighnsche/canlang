  "operationSamples": {
    "schema": {
      "contracts": {
        "TodoForm": {
          "fields": {
            "title": { "type": "text", "min": 1, "max": 140, "trim": true },
            "status": { "type": "TodoStatus", "default": "open" },
            "priority": { "type": "int", "min": "1", "max": "5", "default": "3" },
            "due": { "type": "date?" },
            "tags": { "type": "text[]!" }
          }
        },
        "BoundedList": {
          "fields": {
            "items": { "type": "text[]", "min": 1 }
          }
        }
      },
      "enums": {
        "TodoStatus": { "cases": ["open", "doing", "done"] }
      },
      "operations": {
        "listTodos": {
          "inputs": {
            "status": { "type": "TodoStatus?" },
            "limit": { "type": "int", "min": "1", "max": "100", "default": "25" }
          }
        },
        "completeTodo": {
          "inputs": {
            "todo": { "type": "Todo" },
            "note": { "type": "text", "max": 280 }
          },
          "mutation": true
        }
      }
    },
    "valueCases": [
      {
        "typeId": "TodoForm",
        "mode": "create",
        "wire": { "title": "Buy milk", "tags": ["home"] },
        "expected": {
          "$value": {
            "title": "Buy milk",
            "status": "open",
            "priority": { "$t": "int", "$w": "3" },
            "due": null,
            "tags": ["home"]
          }
        }
      },
      {
        "typeId": "TodoForm",
        "mode": "create",
        "wire": { "title": "Plan trip", "status": "doing", "priority": "5", "due": "2026-12-31", "tags": [] },
        "expected": {
          "$value": {
            "title": "Plan trip",
            "status": "doing",
            "priority": { "$t": "int", "$w": "5" },
            "due": { "$t": "date", "$w": "2026-12-31" },
            "tags": []
          }
        }
      },
      {
        "typeId": "TodoForm",
        "mode": "create",
        "wire": { "title": "x" },
        "expectedViolations": [{ "path": ["tags"], "code": "required" }]
      },
      {
        "typeId": "TodoForm",
        "mode": "create",
        "wire": { "title": "", "tags": [] },
        "expectedViolations": [{ "path": ["title"], "code": "bound" }]
      },
      {
        "typeId": "TodoForm",
        "mode": "create",
        "wire": { "title": "x", "tags": [], "priority": "0" },
        "expectedViolations": [{ "path": ["priority"], "code": "bound" }]
      },
      {
        "typeId": "TodoForm",
        "mode": "create",
        "wire": { "title": "x", "tags": [], "bogus": 1 },
        "expectedViolations": [{ "path": ["bogus"], "code": "unknown-field" }]
      },
      {
        "typeId": "TodoForm",
        "mode": "create",
        "wire": { "title": "x", "tags": [], "status": "archived" },
        "expectedViolations": [{ "path": ["status"], "code": "format" }]
      },
      {
        "typeId": "TodoForm",
        "mode": "update",
        "wire": { "title": "New" },
        "expected": {
          "$value": {
            "title": "New",
            "status": { "$omitted": true },
            "priority": { "$omitted": true },
            "due": { "$omitted": true },
            "tags": { "$omitted": true }
          }
        }
      },
      {
        "typeId": "TodoForm",
        "mode": "create",
        "wire": { "title": "  Buy milk  ", "tags": ["home"] },
        "expected": {
          "$value": {
            "title": "Buy milk",
            "status": "open",
            "priority": { "$t": "int", "$w": "3" },
            "due": null,
            "tags": ["home"]
          }
        }
      },
      {
        "typeId": "BoundedList",
        "mode": "create",
        "wire": {},
        "expectedViolations": [{ "path": ["items"], "code": "bound" }]
      },
      {
        "typeId": "BoundedList",
        "mode": "create",
        "wire": { "items": ["a"] },
        "expected": { "$value": { "items": ["a"] } }
      }
    ],
    "inputCases": [
      {
        "op": "listTodos",
        "args": {},
        "expected": { "$value": { "status": null, "limit": { "$t": "int", "$w": "25" } } }
      },
      {
        "op": "listTodos",
        "args": { "status": "doing", "limit": "10" },
        "expected": { "$value": { "status": "doing", "limit": { "$t": "int", "$w": "10" } } }
      },
      {
        "op": "listTodos",
        "args": { "bogus": 1 },
        "expectedViolations": [{ "path": ["bogus"], "code": "unknown-argument" }]
      },
      {
        "op": "listTodos",
        "args": { "limit": "0" },
        "expectedViolations": [{ "path": ["limit"], "code": "bound" }]
      },
      {
        "op": "listTodos",
        "args": { "operation_id": "x" },
        "expectedViolations": [{ "path": ["operation_id"], "code": "unknown-argument" }]
      },
      {
        "op": "completeTodo",
        "args": { "todo": { "id": "t1", "version": "3" }, "note": "done", "operation_id": "op-1" },
        "expected": {
          "$value": {
            "todo": { "$t": "Todo", "$w": { "id": "t1", "version": "3" } },
            "note": "done",
            "operation_id": "op-1"
          }
        }
      },
      {
        "op": "completeTodo",
        "args": { "todo": { "id": "t1", "version": "3" }, "note": "done" },
        "expectedViolations": [{ "path": ["operation_id"], "code": "required" }]
      },
      {
        "op": "completeTodo",
        "args": { "todo": { "id": "t1" }, "note": "done", "operation_id": "op-1" },
        "expectedViolations": [{ "path": ["todo", "version"], "code": "required" }]
      },
      {
        "op": "completeTodo",
        "args": { "todo": { "id": "t1", "version": "3" }, "note": "done", "operation_id": "op-1", "bogus": 1 },
        "expectedViolations": [{ "path": ["bogus"], "code": "unknown-argument" }]
      }
    ]
  }
}
