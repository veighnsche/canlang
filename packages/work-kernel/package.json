{
  "name": "@canlang/work-kernel",
  "version": "0.1.1",
  "license": "MIT",
  "description": "CanLang work/state transition kernel: pure decision mechanisms with swappable TS/wasm backends (W02 foundation; semantic modules arrive W02.2-W02.4).",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./distribution": {
      "types": "./dist/src/distribution.d.ts",
      "default": "./dist/src/distribution.js"
    },
    "./rows": {
      "types": "./dist/src/rows.d.ts",
      "default": "./dist/src/rows.js"
    },
    "./retry": {
      "types": "./dist/src/retry.d.ts",
      "default": "./dist/src/retry.js"
    },
    "./lifecycle": {
      "types": "./dist/src/lifecycle.d.ts",
      "default": "./dist/src/lifecycle.js"
    },
    "./receipt": {
      "types": "./dist/src/receipt.d.ts",
      "default": "./dist/src/receipt.js"
    },
    "./every": {
      "types": "./dist/src/every.d.ts",
      "default": "./dist/src/every.js"
    },
    "./recovery": {
      "types": "./dist/src/recovery.d.ts",
      "default": "./dist/src/recovery.js"
    },
    "./linkage": {
      "types": "./dist/src/linkage.d.ts",
      "default": "./dist/src/linkage.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "node ../../scripts/run-tasks.mjs typecheck:check --filter=@canlang/work-kernel",
    "build:wasm": "cargo build --locked --manifest-path Cargo.toml --target wasm32-unknown-unknown --release && node scripts/stage-recovery-wasm.mjs",
    "test": "node ../../scripts/run-tasks.mjs test:unit --filter=@canlang/work-kernel",
    "clean": "rm -rf dist/ target/",
    "build:emit": "tsc -p tsconfig.json && mkdir -p dist/conformance/fixtures && cp conformance/numeric-text.oracle.mjs dist/conformance/ && cp conformance/fixtures/numeric-text.json dist/conformance/fixtures/",
    "typecheck:check": "tsc --noEmit -p tsconfig.json",
    "test:unit": "node --test 'dist/conformance/**/*.test.js'",
    "test:recovery-wasm": "node --test dist/conformance/native-recovery.wasm-test.js",
    "build:prepare": "node ../../scripts/build-package.mjs --prepare"
  },
  "dependencies": {
    "@canlang/contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
