{
  "name": "@canlang/work-kernel",
  "version": "0.1.0",
  "license": "MIT",
  "description": "CanLang work/state transition kernel: pure decision mechanisms with swappable TS/wasm backends (W02 foundation; semantic modules arrive W02.2-W02.4).",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./distribution": {
      "types": "./dist/src/distribution.d.ts",
      "default": "./dist/src/distribution.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "node ../../scripts/run-tasks.mjs typecheck:check --filter=@canlang/work-kernel",
    "build:wasm": "cargo build --locked --manifest-path Cargo.toml --target wasm32-unknown-unknown --release",
    "test": "node ../../scripts/run-tasks.mjs test:unit --filter=@canlang/work-kernel",
    "clean": "rm -rf dist/ target/",
    "build:emit": "tsc -p tsconfig.json",
    "typecheck:check": "tsc --noEmit -p tsconfig.json",
    "test:unit": "node --test 'dist/conformance/**/*.test.js'",
    "build:prepare": "node ../../scripts/build-package.mjs --prepare"
  },
  "dependencies": {
    "@canlang/contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
