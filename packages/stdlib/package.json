{
  "name": "@canlang/stdlib",
  "version": "0.1.0",
  "license": "MIT",
  "description": "CanLang public standard library fa\u00e7ade: thin export assembly from producer packages (lane 03)",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "node ../../scripts/run-tasks.mjs typecheck:check --filter=@canlang/stdlib",
    "test": "node ../../scripts/run-tasks.mjs test:unit --filter=@canlang/stdlib",
    "clean": "rm -rf dist/",
    "build:emit": "tsc -p tsconfig.json",
    "typecheck:check": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --test \"dist/test/**/*.test.js\"",
    "build:prepare": "node ../../scripts/build-package.mjs --prepare"
  },
  "dependencies": {
    "@canlang/values": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./distribution": {
      "types": "./dist/src/distribution.d.ts",
      "default": "./dist/src/distribution.js"
    }
  }
}
