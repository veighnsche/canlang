{
  "name": "@canlang/ui",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Server-rendered CanLang presentation library (daisyUI/HTMX owned markup and behavior)",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./distribution": {
      "types": "./dist/src/distribution.d.ts",
      "default": "./dist/src/distribution.js"
    },
    "./browser/export": {
      "types": "./dist/src/browser/export.d.ts",
      "default": "./dist/src/browser/export.js"
    },
    "./browser/print": {
      "types": "./dist/src/browser/print.d.ts",
      "default": "./dist/src/browser/print.js"
    },
    "./browser/bootstrap": {
      "types": "./dist/src/browser/bootstrap.d.ts",
      "default": "./dist/src/browser/bootstrap.js"
    },
    "./csv/grammar": {
      "types": "./dist/src/csv/grammar.d.ts",
      "default": "./dist/src/csv/grammar.js"
    }
  },
  "files": [
    "dist",
    "themes.css"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "node ../../scripts/run-tasks.mjs typecheck:check --filter=@canlang/ui",
    "test": "node ../../scripts/run-tasks.mjs test:unit --filter=@canlang/ui",
    "clean": "rm -rf dist/",
    "build:emit": "tsc -p tsconfig.json && node scripts/build-browser.mjs",
    "typecheck:check": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --test \"dist/test/**/*.test.js\"",
    "build:prepare": "node ../../scripts/build-package.mjs --prepare"
  },
  "dependencies": {
    "@canlang/contracts": "workspace:*",
    "@canlang/values": "workspace:*",
    "csv-parse": "7.0.3"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "daisyui": "5.7.47",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
