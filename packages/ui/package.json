{
  "name": "@canlang/ui",
  "version": "0.1.0",
  "description": "Server-rendered CanLang presentation library (daisyUI/HTMX owned markup and behavior)",
  "type": "module",
  "main": "./dist/ui/src/index.js",
  "types": "./dist/ui/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ui/src/index.d.ts",
      "default": "./dist/ui/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/ui/test/**/*.test.js\"",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true
}
