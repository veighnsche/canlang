{
  "compilerOptions": {
    "target": "ES2022",
    // Interim: ESNext/Bundler until lane 07 assembles the workspace and the
    // contracts package manifest; NodeNext would emit CJS for files outside
    // this package. Relative imports keep explicit .js suffixes throughout.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "noEmitOnError": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "../../contracts/src/state.ts"]
}
