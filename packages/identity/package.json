{
  "name": "@canlang/identity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CanLang account/session/team identity (lane 06).",
  "main": "./dist/identity/src/index.js",
  "types": "./dist/identity/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/identity/src/index.d.ts",
      "default": "./dist/identity/src/index.js"
    },
    "./testing": {
      "types": "./dist/identity/src/testing.d.ts",
      "default": "./dist/identity/src/testing.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -r test/fixtures dist/identity/test/fixtures",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/identity/test/**/*.test.js\"",
    "clean": "rm -rf dist/"
  },
  "dependencies": {
    "@canlang/contracts": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
