{
  "name": "@canlang/identity",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "CanLang account/session/team identity (lane 06).",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "default": "./dist/src/testing.js"
    },
    "./distribution": {
      "types": "./dist/src/distribution.d.ts",
      "default": "./dist/src/distribution.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "node ../../scripts/run-tasks.mjs typecheck:check --filter=@canlang/identity",
    "test": "node ../../scripts/run-tasks.mjs test:unit --filter=@canlang/identity",
    "clean": "rm -rf dist/",
    "build:emit": "tsc -p tsconfig.json && mkdir -p dist/test/fixtures && cp -r test/fixtures/. dist/test/fixtures/",
    "typecheck:check": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --test \"dist/test/**/*.test.js\"",
    "build:prepare": "node ../../scripts/build-package.mjs --prepare"
  },
  "dependencies": {
    "@canlang/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
