{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "..",
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": true
  },
  "include": ["test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
