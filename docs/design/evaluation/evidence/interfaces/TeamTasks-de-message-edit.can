# Manage team tasks, assign active teammates, and track completion. @{nl="Beheer teamtaken, wijs actieve teamleden toe en volg de voortgang.",de="Verwalte Teamaufgaben, weise aktive Teammitglieder zu und verfolge den Fortschritt."}
app TeamTasks
Given
 preferences { view:enum(all,unfinished,finished)=all label={text="Task view"@{nl="Taakweergave",de="Aufgabenansicht"},values={all="All tasks"@{nl="Alle taken",de="Alle Aufgaben"},unfinished="Unfinished tasks"@{nl="Open taken",de="Offene Aufgaben"},finished="Finished tasks"@{nl="Afgeronde taken",de="Erledigte Aufgaben"}}} }
 Todo { title:text trim max=200 label=field_title, done:bool=false label={text=done,values={true=done,false="Open"@{nl="Open",de="Offen"}}}, assignee:member? label="Assignee"@{nl="Toegewezen aan",de="Zugewiesen an"} } label="Task"@{nl="Taak",de="Aufgabe"}
 policy Todo read=members
 fixture task=Todo {title="Ship prototype"}
 export message add = "Add"@{nl="Toevoegen",de="Hinzufügen"}
 export message field_title = "Title"@{nl="Titel",de="Titel"}
 message done = "Done"@{nl="Klaar",de="Erledigt"}
 message task_count(n:int) = "{n, plural, one {# active task} other {# active tasks}}"@{nl="{n, plural, one {# actieve taak} other {# actieve taken}}",de="{n, plural, one {# aktive Aufgabe} other {# aktive Aufgaben}}"}
When
 crud Todo by=members fields=title,done,assignee label={create=add}
  examples update record=task
   as,changes.done,request.record.version -> record.done,format(task_count(count(Todo)),locale="nl")
   members,true,1 -> true,"1 actieve taak"
   members,true,0 -> error(conflict)
   public,true,1 -> error(forbidden)
Then
 # Add work, assign teammates, and track what is finished. @{nl="Voeg werk toe, wijs teamleden toe en volg wat klaar is.",de="Füge Arbeit hinzu, weise Teammitglieder zu und verfolge die erledigten Aufgaben."}
 page / title="Team tasks"@{nl="Teamtaken",de="Teamaufgaben"}
  card "Add team work"@{nl="Teamwerk toevoegen",de="Teamaufgabe hinzufügen"}
   form Todo.create fields=title,assignee display=inline
  card "Tasks and completion"@{nl="Taken en voortgang",de="Aufgaben und Fortschritt"}
   text task_count(count(Todo))
   tabs preferences.view
   list Todo as task where preferences.view==all or (preferences.view==unfinished and not task.done) or (preferences.view==finished and task.done) order=-created search=title filter=done empty="No tasks yet. Add your first task."@{nl="Nog geen taken. Voeg je eerste taak toe.",de="Noch keine Aufgaben. Füge deine erste Aufgabe hinzu."}
    edit
    delete
# Keep shared team notes. @{nl="Bewaar gedeelde teamnotities.",de="Bewahre gemeinsame Teamnotizen auf."}
app TeamNotes
use TeamTasks {add,field_title}
Given
 preferences { show_content:bool=true label="Expand note content"@{nl="Notitie-inhoud uitklappen",de="Notizinhalt ausklappen"} }
 Note { title:text trim max=200 label=field_title, content:text? label="Content"@{nl="Inhoud",de="Inhalt"} } label="Note"@{nl="Notitie",de="Notiz"}
 policy Note read=members
When
 crud Note by=members fields=title,content label={create=add}
Then
 # Write and browse the team's notes. @{nl="Schrijf en bekijk de notities van het team.",de="Schreibe und lies die Notizen des Teams."}
 page /notes title="Team notes"@{nl="Teamnotities",de="Teamnotizen"}
  card "Write a note"@{nl="Een notitie schrijven",de="Notiz schreiben"}
   form Note.create display=inline
  card "Shared notes"@{nl="Gedeelde notities",de="Gemeinsame Notizen"}
   list Note search=title display=split
    edit
    delete
    details "Note content"@{nl="Notitie-inhoud",de="Notizinhalt"} open=preferences.show_content
     text row.content
# Manage tasks and notes together. @{nl="Beheer taken en notities samen.",de="Verwalte Aufgaben und Notizen gemeinsam."}
app TeamOffice uses=[TeamTasks,TeamNotes]
