{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"167430e8fb5914b2b3428527c01b30b5523f20b652f4a6b58d184915961f09b2","before_projection_sha256":"167430e8fb5914b2b3428527c01b30b5523f20b652f4a6b58d184915961f09b2","changed":false,"idempotent":true,"structure_equal":true,"text":"# Review finalized creative assets and share approved collections without exposing private conversations. @{nl=\"Beoordeel afgeronde creatieve bestanden en deel goedgekeurde collecties zonder privégesprekken openbaar te maken.\"}\napp CanGallery uses=[chat,creative,gallery]\ncontext\n files types=\"application/pdf,image/png,image/jpeg,text/plain,application/json\"\n\npackage gallery\n use creative {Output,can_view,output,completed,completed_request}\n use std {ImageRun,GeneratedImage}\n Given\n  role curator label=\"Collection curator\"@{nl=\"Collectiebeheerder\"}\n  role reviewer label=\"Image reviewer\"@{nl=\"Beeldbeoordelaar\"}\n  Collection { name:text trim max=200, owner:user server=actor, active:bool=true } label=\"Image collection\"@{nl=\"Beeldcollectie\"}\n  Access in Collection { account:user, active:bool=true } label=\"Collection access\"@{nl=\"Collectietoegang\"}\n  Submission in Collection { output:Output, image:file, author:user server=actor, title:text trim max=200, statement:text max=4000, rights:text max=4000, state:enum(pending,approved,rejected,withdrawn)=pending label={text=\"Review state\"@{nl=\"Beoordelingsstatus\"},values={pending=\"Awaiting review\"@{nl=\"Wacht op beoordeling\"},approved=\"Approved\"@{nl=\"Goedgekeurd\"},rejected=\"Changes required\"@{nl=\"Wijzigingen nodig\"},withdrawn=\"Withdrawn\"@{nl=\"Ingetrokken\"}}}, decision:enum(approved,rejected)?, reviewed_by:user?, reason:text?, decided_at:datetime?, withdraw_reason:text?, withdrawn_by:user?, withdrawn_at:datetime? } label=\"Submitted image\"@{nl=\"Ingediend beeld\"}\n  derive can_read(person:user?,collection:Collection):bool = person!=null and active_member(person,team) and collection.active and (collection.owner==person or any(collection.Access as access,access.account==person and access.active))\n  derive can_review(person:user?,collection:Collection):bool = person!=null and reviewer(person) and can_read(person,collection)\n  policy Collection read=members fields=name,owner,active\n  policy Access read=members and (row.account==actor or row.parent.owner==actor)\n  policy Submission read=members and row.author==actor\n  policy Submission read=can_review(actor,row.parent) fields=parent,image,author,title,statement,rights,state,decision,reviewed_by,reason,decided_at,withdraw_reason,withdrawn_by,withdrawn_at,created,updated\n  policy Submission read=can_read(actor,row.parent) and row.state==approved fields=parent,image,author,title,statement,rights,state,decision,reviewed_by,reason,decided_at,created,updated\n  unique Access fields=account\n  unique Submission fields=output where=row.state in [pending,approved]\n  invariant Submission: (row.decision==null and row.reviewed_by==null and row.decided_at==null) or (row.decision!=null and row.reviewed_by!=null and row.decided_at!=null and row.reviewed_by!=row.author)\n  lock Collection fields=owner\n  lock Access fields=account\n  lock Submission fields=output,image,author,title,statement,rights\n  lock Submission fields=decision,reviewed_by,reason,decided_at when=row.decision!=null\n  lock Submission fields=state,withdraw_reason,withdrawn_by,withdrawn_at when=row.state==withdrawn\n  fixture gallery_curator=user {roles=[curator]}\n  fixture gallery_reviewer=user {roles=[reviewer]}\n  fixture collection=Collection {name=\"Approved campaign art\",owner=gallery_curator}\n  fixture reviewer_access=Access {parent=collection,account=gallery_reviewer}\n  fixture audience=Access {parent=collection,account=self}\n  fixture submission=Submission {parent=collection,output,image=output.image,author=self,title=\"Quiet garden\",statement=\"For the launch presentation\",rights=\"Original generated artwork reviewed for company use\"}\n When\n  crud Collection by=curator fields=name,active create_fields=name when=row.owner==actor delete=none\n  crud Access by=curator fields=active create_fields=account when=row.parent.owner==actor and (not row.active or active_member(row.account,team)) delete=none\n  # Submit a readable successful output and explicit rights evidence, copying only the selected finalized image. @{nl=\"Dien een leesbaar succesvol resultaat in met expliciet rechtenbewijs en kopieer alleen het geselecteerde afgeronde beeld.\"}\n  scenario submit(output:Output,collection:Collection,title:text,statement:text,rights:text) by=members -> Submission label=\"Submit for review\"@{nl=\"Ter beoordeling indienen\"}\n   require can_view(actor,output.parent) and output.parent.state==succeeded and collection.active\n   require trim(title)!=\"\" and trim(statement)!=\"\" and trim(rights)!=\"\"\n   require not any(collection.Submission as row,row.output==output and row.state in [pending,approved])\n   do\n    create Submission {parent=collection,output,image=output.image,title,statement,rights} as submission\n    return submission\n   examples output=output collection=collection title=\"Quiet garden\" statement=\"For the launch presentation\" rights=\"Company use reviewed\"\n    as,completed_request.result,collection.active -> count(collection.Submission)\n    self,ImageRun {source=\"creative-completed\",revision=1,sequence=2,state=succeeded,outputs=[GeneratedImage {position=0,image=output.image}],charged_jobs=1,detail=null},true -> 1\n    self,ImageRun {source=\"creative-completed\",revision=1,sequence=2,state=failed,outputs=[GeneratedImage {position=0,image=output.image}],charged_jobs=1,detail=null},true -> error(rule_failed)\n    self,ImageRun {source=\"creative-completed\",revision=1,sequence=2,state=succeeded,outputs=[GeneratedImage {position=0,image=output.image}],charged_jobs=1,detail=null},false -> error(rule_failed)\n    other,ImageRun {source=\"creative-completed\",revision=1,sequence=2,state=succeeded,outputs=[GeneratedImage {position=0,image=output.image}],charged_jobs=1,detail=null},true -> error(rule_failed)\n  # Record an independent review of exactly the frozen image and evidence. @{nl=\"Leg een onafhankelijke beoordeling vast van precies het vastgelegde beeld en bewijs.\"}\n  scenario review(submission:Submission,approve:bool,reason:text) by=reviewer label=\"Review image\"@{nl=\"Beeld beoordelen\"}\n   require can_review(actor,submission.parent) and submission.state==pending and submission.author!=actor and trim(reason)!=\"\"\n   do\n    if approve\n     set submission {state=approved,decision=approved,reviewed_by=actor,reason,decided_at=now}\n    else\n     set submission {state=rejected,decision=rejected,reviewed_by=actor,reason,decided_at=now}\n   examples seed=[reviewer_access] submission=submission approve=true reason=\"Rights and image reviewed\"\n    as,reviewer_access.active,submission.author,completed.author -> submission.state,submission.reviewed_by\n    gallery_reviewer,true,self,self -> approved,gallery_reviewer\n    gallery_reviewer,false,self,self -> error(rule_failed)\n    gallery_reviewer,true,gallery_reviewer,gallery_reviewer -> error(rule_failed)\n    self,true,self,self -> error(forbidden)\n   examples seed=[reviewer_access,audience,submission]\n    do\n     call approved {collection} by=self as before\n     count(before) -> 0\n     call review {submission,approve=true,reason=\"Approved for company launch materials\"} by=gallery_reviewer\n     call approved {collection} by=self as shared\n     count(shared),first(shared)?.image,first(shared)?.decision -> 1,output.image,approved\n     call Access.update {record=audience,changes={active=false}} by=gallery_curator\n     call approved {collection} by=self -> error(rule_failed)\n     call withdraw {submission,reason=\"Usage consent withdrawn\"} by=self\n     submission.state,submission.decision,submission.reason,submission.withdraw_reason -> withdrawn,approved,\"Approved for company launch materials\",\"Usage consent withdrawn\"\n     call approved {collection} by=gallery_reviewer as after\n     count(after) -> 0\n  # Withdraw visibility while retaining the original approval or rejection and who made it. @{nl=\"Trek de zichtbaarheid in en behoud de oorspronkelijke goed- of afkeuring en de beoordelaar.\"}\n  scenario withdraw(submission:Submission,reason:text) by=members label=\"Withdraw image\"@{nl=\"Beeld intrekken\"}\n   require submission.author==actor or can_review(actor,submission.parent) or (curator and submission.parent.owner==actor)\n   require submission.state!=withdrawn and trim(reason)!=\"\"\n   do set submission {state=withdrawn,withdraw_reason=reason,withdrawn_by=actor,withdrawn_at=now}\n  # Return only approved assets under current collection access and normal field/file grants. @{nl=\"Toon alleen goedgekeurde bestanden binnen actuele collectietoegang en gewone veld- en bestandsrechten.\"}\n  scenario approved(collection:Collection) by=members read=true -> Submission[] label=\"Open approved collection\"@{nl=\"Goedgekeurde collectie openen\"}\n   require can_read(actor,collection)\n   do return collection.Submission as row where row.state==approved order=-row.decided_at\n Then\n  page /gallery title=\"Approved collections\"@{nl=\"Goedgekeurde collecties\"} poll=1s\n   require members\n   ## Breadcrumbs show current declared ancestry; the shared right-sidebar shell supplies navigation, no per-app menu.\n   breadcrumbs\n   list Collection as collection where can_read(actor,collection) empty=\"No collections available\"@{nl=\"Geen collecties beschikbaar\"}\n    pagination\n    title row.name\n    form approved arguments={collection=row}\n     gallery result image=image empty=\"No approved images yet\"@{nl=\"Nog geen goedgekeurde beelden\"}\n      pagination\n      title row.title\n      text row.author,row.rights,row.decided_at\n  page /gallery/submit title=\"My images and submissions\"@{nl=\"Mijn beelden en inzendingen\"} poll=1s\n   require members\n   breadcrumbs\n   gallery Output as output where output.parent.state==succeeded image=image empty=\"No successful images to submit\"@{nl=\"Geen geslaagde beelden om in te dienen\"}\n    pagination\n    form submit arguments={output=row}\n     select collection\n     input title\n     textarea statement\n     textarea rights\n   gallery Submission as submission where submission.author==actor image=image empty=\"No submissions yet\"@{nl=\"Nog geen inzendingen\"}\n    pagination\n    title row.title\n    badge row.state\n    text row.reason,row.withdraw_reason\n    button opens=withdraw_image\n    modal \"Withdraw image\"@{nl=\"Beeld intrekken\"} id=withdraw_image\n     slot content\n      form withdraw arguments={submission=row} display=inline\n       textarea reason\n  page /gallery/review title=\"Image review\"@{nl=\"Beeldbeoordeling\"} poll=1s\n   require reviewer\n   breadcrumbs\n   gallery Submission as submission where submission.state==pending and can_review(actor,submission.parent) image=image empty=\"No images awaiting review\"@{nl=\"Geen beelden ter beoordeling\"}\n    pagination\n    title row.title\n    content row.statement\n    text row.author,row.rights\n    button opens=review_image\n    modal \"Review image\"@{nl=\"Beeld beoordelen\"} id=review_image\n     slot content\n      form review arguments={submission=row} display=inline\n       checkbox approve\n       textarea reason\n  page /gallery/access title=\"Collection access\"@{nl=\"Collectietoegang\"}\n   require curator\n   breadcrumbs\n   form Collection.create\n    input name\n   list Collection as collection where collection.owner==actor empty=\"No collections yet\"@{nl=\"Nog geen collecties\"}\n    pagination\n    title row.name\n    edit fields=name,active\n    ## account:user stays generated: no user-picker vocabulary.\n    form Access.create arguments={parent=row}\n    table row.Access columns=account,active empty=\"No granted accounts\"@{nl=\"Geen accounts met toegang\"}\n     pagination\n     edit fields=active\n"}}
