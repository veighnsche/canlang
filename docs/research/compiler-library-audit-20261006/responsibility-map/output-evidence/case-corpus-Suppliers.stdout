{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"9f0a5eed78980135f32a9230c102b79baeba7ae89dc33c2d31ee09e0406e815f","before_projection_sha256":"9f0a5eed78980135f32a9230c102b79baeba7ae89dc33c2d31ee09e0406e815f","changed":false,"idempotent":true,"structure_equal":true,"text":"# Own the canonical supplier directory without duplicating it in facilities or purchasing. @{nl=\"Beheer de canonieke leverancierslijst zonder die in facilitair beheer of inkoop te dupliceren.\"}\npackage supplier label=\"Suppliers\"@{nl=\"Leveranciers\"}\n use rent_catalog {Location}\n use employee {can_work}\n Given\n  export role buyer label=\"Buyer\"@{nl=\"Inkoper\"}\n  export role budget_manager label=\"Budget manager\"@{nl=\"Budgetbeheerder\"}\n  export Supplier { name:text trim min=1, contact:email label=\"Supplier email\"@{nl=\"E-mail leverancier\"}, locations:Location[] label=\"Locations\"@{nl=\"Locaties\"}, active:bool=true } label=\"Supplier\"@{nl=\"Leverancier\"}\n  policy Supplier read=buyer or budget_manager where=any(row.locations as location,can_work(actor,location))\n  policy Supplier read=members where=row.active and any(row.locations as location,can_work(actor,location)) fields=name,locations,active\n When\n  crud Supplier by=buyer fields=name,contact,locations,active when=all(row.locations as location,can_work(actor,location)) delete=none\n Then\n"}}
