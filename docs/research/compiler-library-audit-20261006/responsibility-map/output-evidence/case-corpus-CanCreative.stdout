{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"a4e806fd8d8ed3d18a52288799048d9fb7476900e480d035f6b1bb58f1a7a7ff","before_projection_sha256":"a4e806fd8d8ed3d18a52288799048d9fb7476900e480d035f6b1bb58f1a7a7ff","changed":true,"idempotent":true,"structure_equal":true,"text":"# Turn private ideas into bounded image jobs using employee-published workflow revisions. @{nl=\"Zet privé-ideeën om in begrensde beeldtaken met door medewerkers gepubliceerde workflowversies.\"}\napp CanCreative uses=[chat,creative]\ncontext\n files types=\"application/pdf,image/png,image/jpeg,text/plain,application/json\"\n\npackage creative\n use chat {Conversation,Branch,Turn,can_use,conversation}\n use std {WorkflowInput,WorkflowDefinition,WorkflowInspection,WorkflowValidation,ImageRequest,ImageRun,GeneratedImage,DeliveryResult}\n use std {ImagesV1 as Images} from=deployment.images\n Given\n  role creative_manager label=\"Creative administrator\"@{nl=\"Creatief beheerder\"}\n  Template { name:text trim max=200, owner:user server=actor, graph:file, prompt_node:text=\"6\", prompt_key:text=\"text\", negative_node:text=\"7\", negative_key:text=\"text\", width_node:text=\"5\", width_key:text=\"width\", height_node:text=\"5\", height_key:text=\"height\", outputs:int=1 min=1 max=4, duration:duration=120s, active:bool=true, current:Revision?, inspection:delivery(Images.inspect)? } label=\"Image workflow\"@{nl=\"Beeldworkflow\"}\n  Revision in Template { number:int min=1, definition:WorkflowDefinition, outputs:int min=1 max=4, duration:duration, validation:delivery(Images.validate)?, published:bool=false, digest:text? } label=\"Immutable workflow revision\"@{nl=\"Onveranderlijke workflowversie\"}\n  Budget { account:user unique, cap:int min=1, parallel:int=2 min=1 max=10, spent:int=0 min=0, held:int=0 min=0, running:int=0 min=0 max=10, active:bool=true } label=\"Image-job allowance\"@{nl=\"Budget voor beeldtaken\"}\n  export Run { source:text unique, author:user server=actor, conversation:Conversation?, revision:Revision, budget:Budget, prompt:ImageRequest.prompt, negative:ImageRequest.negative, width:ImageRequest.width, height:ImageRequest.height, request:delivery(Images.submit)?, cancellation:delivery(Images.cancel)?, reconciliation:delivery(Images.reconcile)?, used:int? min=0 max=1, unfinished:bool=true, stop_requested:bool=false } label=\"Image generation\"@{nl=\"Beeldgeneratie\"}\n  export Output in Run { position:int min=0 max=3, image:file } label=\"Finalized image\"@{nl=\"Afgerond beeldbestand\"}\n  derive definition(template:Template):WorkflowDefinition = WorkflowDefinition {graph=template.graph,prompt=WorkflowInput {node=template.prompt_node,key=template.prompt_key},negative=WorkflowInput {node=template.negative_node,key=template.negative_key},width=WorkflowInput {node=template.width_node,key=template.width_key},height=WorkflowInput {node=template.height_node,key=template.height_key}}\n  export derive can_view(person:user?,run:Run):bool = person!=null and active_member(person,team) and run.author==person and (run.conversation==null or can_use(person,run.conversation))\n  derive Run.state:ImageRun.state? = row.request?.progress?.state\n  derive Run.detail:text? = row.request?.progress?.detail\n  derive Run.delivery_state:DeliveryResult.status? = row.request?.status label=\"Submission receipt\"@{nl=\"Indieningsbewijs\"}\n  derive Run.stop_delivery:DeliveryResult.status? = row.cancellation?.status label=\"Stop receipt\"@{nl=\"Stopbewijs\"}\n  derive Run.reconcile_delivery:DeliveryResult.status? = row.reconciliation?.status label=\"Recovery receipt\"@{nl=\"Herstelbewijs\"}\n  policy Template read=members fields=name,active,current\n  policy Template read=creative_manager and row.owner==actor\n  policy Revision read=members where=row.published and row.parent.active fields=parent,number,definition,published,digest,outputs,duration\n  policy Revision read=creative_manager and row.parent.owner==actor\n  policy Budget read=creative_manager or (members and row.account==actor)\n  policy Run read=can_view(actor,row) fields=source,author,conversation,revision,prompt,negative,width,height,state,used,unfinished,stop_requested,detail,request.id,request.status,request.error,request.progress.state,request.progress.detail,cancellation.id,cancellation.status,cancellation.error,reconciliation.id,reconciliation.status,reconciliation.error,delivery_state,stop_delivery,reconcile_delivery,created,updated\n  policy Run read=members and row.author==actor fields=source,author,conversation,state,used,unfinished,stop_requested,detail,request.id,request.status,request.error,request.progress.state,request.progress.detail,cancellation.id,cancellation.status,cancellation.error,reconciliation.id,reconciliation.status,reconciliation.error,delivery_state,stop_delivery,reconcile_delivery,created,updated\n  policy Output read=can_view(actor,row.parent)\n  invariant Template: row.duration>=1s and row.duration<=15m and (row.current==null or (row.current.parent==row and row.current.published))\n  invariant Revision: row.duration>=1s and row.duration<=15m and (not row.published or row.digest!=null)\n  invariant Budget: row.spent+row.held<=row.cap and row.running<=row.parallel\n  invariant Run: row.width%64==0 and row.height%64==0\n  unique Revision fields=number\n  unique Output fields=position\n  lock Template fields=owner\n  lock Revision fields=number,definition,outputs,duration,validation\n  lock Revision fields=published,digest when=row.published\n  lock Budget fields=account\n  lock Run fields=source,author,conversation,revision,budget,prompt,negative,width,height,request\n  lock Output fields=position,image\n  fixture manager=user {roles=[creative_manager]}\n  export fixture graph=file {type=\"application/json\"}\n  fixture workflow=Template {name=\"Launch visuals\",owner=manager,graph}\n  fixture checked=Images.validate {request={value=WorkflowDefinition {graph,prompt=WorkflowInput {node=\"6\",key=\"text\"},negative=WorkflowInput {node=\"7\",key=\"text\"},width=WorkflowInput {node=\"5\",key=\"width\"},height=WorkflowInput {node=\"5\",key=\"height\"}}},status=succeeded,result=WorkflowValidation {valid=true,digest=\"fixture-validated-graph\",detail=null}}\n  fixture revision=Revision {parent=workflow,number=1,definition=WorkflowDefinition {graph,prompt=WorkflowInput {node=\"6\",key=\"text\"},negative=WorkflowInput {node=\"7\",key=\"text\"},width=WorkflowInput {node=\"5\",key=\"width\"},height=WorkflowInput {node=\"5\",key=\"height\"}},outputs=1,duration=120s,validation=checked,published=true,digest=\"fixture-validated-graph\"}\n  fixture budget=Budget {account=self,cap=20}\n  export fixture image=file {type=\"image/png\"}\n  fixture completed_budget=Budget {account=self,cap=20,spent=1}\n  export fixture completed_request=Images.submit {request={value=ImageRequest {source=\"creative-completed\",revision=1,workflow=WorkflowDefinition {graph,prompt=WorkflowInput {node=\"6\",key=\"text\"},negative=WorkflowInput {node=\"7\",key=\"text\"},width=WorkflowInput {node=\"5\",key=\"width\"},height=WorkflowInput {node=\"5\",key=\"height\"}},validation=\"fixture-validated-graph\",prompt=\"A quiet garden\",negative=\"\",width=512,height=512,max_outputs=1,max_duration=120s}},status=succeeded,result=ImageRun {source=\"creative-completed\",revision=1,sequence=2,state=succeeded,outputs=[GeneratedImage {position=0,image}],charged_jobs=1,detail=null}}\n  export fixture completed=Run {source=\"creative-completed\",author=self,conversation=null,revision,budget=completed_budget,prompt=\"A quiet garden\",negative=\"\",width=512,height=512,request=completed_request,used=1,unfinished=false}\n  export fixture output=Output {parent=completed,position=0,image}\n  fixture held_budget=Budget {account=self,cap=20,held=1,running=1}\n  fixture observed_request=Images.submit {request={value=ImageRequest {source=\"creative-pending\",revision=1,workflow=WorkflowDefinition {graph,prompt=WorkflowInput {node=\"6\",key=\"text\"},negative=WorkflowInput {node=\"7\",key=\"text\"},width=WorkflowInput {node=\"5\",key=\"width\"},height=WorkflowInput {node=\"5\",key=\"height\"}},validation=\"fixture-validated-graph\",prompt=\"A quiet garden\",negative=\"\",width=512,height=512,max_outputs=1,max_duration=120s}},status=succeeded,result=ImageRun {source=\"creative-pending\",revision=1,sequence=1,state=queued,outputs=[],charged_jobs=null,detail=null}}\n  fixture pending_run=Run {source=\"creative-pending\",author=self,conversation=null,revision,budget=held_budget,prompt=\"A quiet garden\",negative=\"\",width=512,height=512,request=observed_request}\n  fixture prior_output=Output {parent=pending_run,position=0,image}\n When\n  crud Template by=creative_manager fields=name,graph,prompt_node,prompt_key,negative_node,negative_key,width_node,width_key,height_node,height_key,outputs,duration,active create_fields=name,graph,prompt_node,prompt_key,negative_node,negative_key,width_node,width_key,height_node,height_key,outputs,duration when=row.owner==actor delete=none\n  crud Budget by=creative_manager fields=cap,parallel,active create_fields=account,cap,parallel delete=none\n  scenario template_edited on=Template.update\n   do set event.after {inspection=null}\n  # Inspect allowed input destinations without starting a generation. @{nl=\"Inspecteer toegestane invoerbestemmingen zonder een generatie te starten.\"}\n  scenario inspect(template:Template) by=creative_manager label=\"Inspect workflow inputs\"@{nl=\"Workflowinvoer inspecteren\"}\n   require template.owner==actor and template.active\n   do\n    send Images.inspect {graph=template.graph} as inspection\n    set template {inspection}\n  # Freeze this draft graph and mapping into a new revision for safe provider validation. @{nl=\"Leg deze conceptgraaf en koppelingen vast in een nieuwe versie voor veilige validatie.\"}\n  scenario validate(template:Template) by=creative_manager -> Revision label=\"Validate new revision\"@{nl=\"Nieuwe versie valideren\"}\n   require template.owner==actor and template.active\n   do\n    let value=definition(template)\n    create Revision {parent=template,number=count(template.Revision)+1,definition=value,outputs=template.outputs,duration=template.duration} as revision\n    send Images.validate {value} as validation\n    set revision {validation}\n    return revision\n  # Publish only the exact successfully validated immutable snapshot; later draft edits cannot change it. @{nl=\"Publiceer alleen de exact gevalideerde onveranderlijke momentopname; latere conceptwijzigingen veranderen die niet.\"}\n  scenario publish(revision:Revision) by=creative_manager label=\"Publish workflow and graph to members\"@{nl=\"Workflow en graaf met leden delen\"}\n   require revision.parent.owner==actor and revision.parent.active and not revision.published\n   require revision.validation?.status==succeeded and revision.validation?.result?.valid==true and revision.validation?.result?.digest!=null\n   do\n    set revision {published=true,digest=revision.validation.result.digest}\n    set revision.parent {current=revision}\n   examples revision=revision\n    as,revision.published,checked.result -> revision.published,workflow.current\n    manager,false,WorkflowValidation {valid=true,digest=\"fixture-validated-graph\",detail=null} -> true,revision\n    manager,false,WorkflowValidation {valid=false,digest=null,detail=\"Mapping rejected\"} -> error(rule_failed)\n    manager,true,WorkflowValidation {valid=true,digest=\"fixture-validated-graph\",detail=null} -> error(rule_failed)\n    other,false,WorkflowValidation {valid=true,digest=\"fixture-validated-graph\",detail=null} -> error(forbidden)\n  # Submit one bounded image job with a frozen published workflow and explicit authorized chat context. @{nl=\"Dien één begrensde beeldtaak in met een vaste gepubliceerde workflow en expliciet toegestane gesprekscontext.\"}\n  export scenario generate(template:Template,prompt:ImageRequest.prompt,negative:ImageRequest.negative=\"\",width:ImageRequest.width=512,height:ImageRequest.height=512,conversation:Conversation?=null) by=members -> Run label=\"Generate images\"@{nl=\"Beelden genereren\"}\n   require template.active and template.current!=null and template.current.published and trim(prompt)!=\"\"\n   require width%64==0 and height%64==0 and (conversation==null or can_use(actor,conversation))\n   do\n    let budget=first(Budget as row where row.account==actor order=row.id)\n    require budget!=null and budget.active and budget.running<budget.parallel and budget.spent+budget.held+1<=budget.cap\n    let revision=template.current\n    require revision.digest!=null\n    create Run {source=operation.id,conversation,revision,budget,prompt,negative,width,height} as run\n    set budget {held=budget.held+1,running=budget.running+1}\n    send Images.submit {value=ImageRequest {source=run.source,revision=1,workflow=revision.definition,validation=revision.digest,prompt,negative,width,height,max_outputs=revision.outputs,max_duration=revision.duration}} when=active_member(run.author,team) and template.active and budget.active and not run.stop_requested and (run.conversation==null or can_use(run.author,run.conversation)) as request\n    set run {request}\n    return run\n   examples seed=[budget] template=workflow prompt=\"A quiet garden\" negative=\"\" width=512 height=512 conversation=null\n    as,workflow.current,budget.cap,budget.spent,width -> count(Run as run where run.source==operation.id),budget.held\n    self,revision,20,0,512 -> 1,1\n    self,revision,1,0,512 -> 1,1\n    self,revision,1,1,512 -> error(rule_failed)\n    self,null,20,0,512 -> error(rule_failed)\n    self,revision,20,0,513 -> error(rule_failed)\n   examples seed=[budget,conversation] template=workflow prompt=\"A private idea\" negative=\"\" width=512 height=512 conversation=conversation\n    as,workflow.current,conversation.active,conversation.account -> count(Run as run where run.source==operation.id)\n    self,revision,true,self -> 1\n    self,revision,false,self -> error(rule_failed)\n    self,revision,true,other -> error(rule_failed)\n  # Deliberately copy an owned chat turn into the normal image form's canonical generation operation. @{nl=\"Kopieer bewust een eigen gespreksbericht naar de canonieke beeldgeneratiebewerking.\"}\n  scenario from_turn(turn:Turn,template:Template,negative:ImageRequest.negative=\"\",width:ImageRequest.width=512,height:ImageRequest.height=512) by=members -> Run label=\"Create image from this message\"@{nl=\"Maak een beeld van dit bericht\"}\n   require can_use(actor,turn.parent.parent)\n   do\n    call generate {template,prompt=turn.content,negative,width,height,conversation=turn.parent.parent} as run\n    return run\n  # Request a targeted external stop and retain uncertainty until the provider confirms the outcome. @{nl=\"Vraag een gerichte externe stop en behoud onzekerheid totdat de aanbieder de uitkomst bevestigt.\"}\n  scenario stop(run:Run) by=members label=\"Stop image job\"@{nl=\"Beeldtaak stoppen\"}\n   require run.author==actor and run.unfinished and run.cancellation?.status!=pending\n   do\n    send Images.cancel {source=run.source,revision=1} as cancellation\n    set run {stop_requested=true,cancellation}\n  # Reconcile the existing image job without submitting a replacement or releasing unconfirmed usage. @{nl=\"Controleer de bestaande beeldtaak zonder een vervanging in te dienen of onbevestigd gebruik vrij te geven.\"}\n  scenario reconcile(run:Run) by=members label=\"Check image outcome\"@{nl=\"Beelduitkomst controleren\"}\n   require run.author==actor and (run.unfinished or run.used==null) and run.reconciliation?.status!=pending\n   do\n    send Images.reconcile {source=run.source,revision=1} as reconciliation\n    set run {reconciliation}\n  # Release the reservation only when the authoritative receipt proves the job was never dispatched. @{nl=\"Geef de reservering alleen vrij wanneer het gezaghebbende bewijs aantoont dat de taak nooit is verzonden.\"}\n  scenario release_skipped(run:Run) by=members label=\"Release unsent job\"@{nl=\"Niet-verzonden taak vrijgeven\"}\n   require run.author==actor and run.request?.status==skipped and run.request?.progress==null and run.used==null and run.unfinished\n   do\n    set run.budget {held=run.budget.held-1,running=run.budget.running-1}\n    set run {used=0,unfinished=false}\n  scenario conversation_revoked on=Conversation.updated\n   do\n    let conversation=first(Conversation as row where row.id==event.id order=row.id)\n    if conversation!=null and not conversation.active\n     for run in Run as row where row.conversation==conversation and row.unfinished limit=10\n      if run.cancellation?.status!=pending\n       send Images.cancel {source=run.source,revision=1} as cancellation\n       set run {stop_requested=true,cancellation}\n  scenario member_removed on=teams.member_removed\n   do\n    if not active_member(event.user,team)\n     for run in Run as row where row.author==event.user and row.unfinished limit=10\n      if run.cancellation?.status!=pending\n       send Images.cancel {source=run.source,revision=1} as cancellation\n       set run {stop_requested=true,cancellation}\n  scenario image_progressed on=Images.submit.progressed\n   do\n    for run in Run as row where row.request?.id==event.delivery_id limit=1\n     let value=run.request?.progress\n     if value!=null\n      require count(value.outputs)<=run.revision.outputs and (value.state!=succeeded or count(value.outputs)>0)\n      require run.used==null or run.used==value.charged_jobs\n      if run.used==null and value.charged_jobs!=null\n       set run.budget {held=run.budget.held-1,spent=run.budget.spent+value.charged_jobs}\n       set run {used=value.charged_jobs}\n      if run.unfinished and value.state in [succeeded,failed,cancelled]\n       set run.budget {running=run.budget.running-1}\n       set run {unfinished=false}\n      for output in value.outputs limit=4\n       if not any(run.Output as row,row.position==output.position)\n        create Output {parent=run,position=output.position,image=output.image} as saved\n   examples seed=[pending_run,image] event={delivery_id=observed_request.id}\n    observed_request.result -> pending_run.state,pending_run.used,held_budget.held,held_budget.spent,held_budget.running,count(pending_run.Output)\n    ImageRun {source=\"creative-pending\",revision=1,sequence=2,state=succeeded,outputs=[GeneratedImage {position=0,image}],charged_jobs=1,detail=null} -> succeeded,1,0,1,0,1\n    ImageRun {source=\"creative-pending\",revision=1,sequence=1,state=queued,outputs=[],charged_jobs=null,detail=null} -> queued,null,1,0,1,0\n    ImageRun {source=\"creative-pending\",revision=1,sequence=2,state=unknown,outputs=[],charged_jobs=null,detail=null} -> unknown,null,1,0,1,0\n    ImageRun {source=\"creative-pending\",revision=1,sequence=2,state=cancelled,outputs=[],charged_jobs=null,detail=null} -> cancelled,null,1,0,0,0\n    ImageRun {source=\"creative-pending\",revision=1,sequence=2,state=failed,outputs=[GeneratedImage {position=0,image}],charged_jobs=1,detail=null} -> failed,1,0,1,0,1\n   examples seed=[pending_run,prior_output] event={delivery_id=observed_request.id}\n    observed_request.result,pending_run.used,pending_run.unfinished,held_budget.held,held_budget.spent,held_budget.running -> held_budget.held,held_budget.spent,held_budget.running,count(pending_run.Output)\n    ImageRun {source=\"creative-pending\",revision=1,sequence=2,state=succeeded,outputs=[GeneratedImage {position=0,image}],charged_jobs=1,detail=null},1,false,0,1,0 -> 0,1,0,1\n   examples seed=[pending_run] event={delivery_id=observed_request.id}\n    observed_request.result,pending_run.unfinished,held_budget.running -> pending_run.used,held_budget.held,held_budget.spent,held_budget.running\n    ImageRun {source=\"creative-pending\",revision=1,sequence=3,state=cancelled,outputs=[],charged_jobs=1,detail=null},false,0 -> 1,0,1,0\n Then\n  page /creative title=\"Image studio\"@{nl=\"Beeldstudio\"} poll=1s\n   require members\n   breadcrumbs\n   form generate display=inline\n    fieldset \"Image prompt\"@{nl=\"Beeldprompt\"}\n     select template\n     textarea prompt\n     textarea negative\n    fieldset \"Size and context\"@{nl=\"Formaat en context\"}\n     input width\n     input height\n     select conversation\n   list Run as run where can_view(actor,run) order=-created empty=\"No image jobs yet\"@{nl=\"Nog geen beeldtaken\"}\n    pagination\n    title row.prompt\n    status row.delivery_state\n    status row.stop_delivery\n    status row.reconcile_delivery\n    badge row.state\n    text row.stop_requested,row.used,row.detail\n    loading row.unfinished\n    gallery row.Output image=image order=position empty=\"No images yet\"@{nl=\"Nog geen beelden\"}\n     pagination\n    actions stop,reconcile,release_skipped\n   table Budget columns=cap,spent,held,running,active empty=\"No image-job allowances\"@{nl=\"Geen budgetten voor beeldtaken\"}\n    pagination\n  page /creative/from-chat title=\"Chat to image\"@{nl=\"Van gesprek naar beeld\"} poll=1s\n   require members\n   breadcrumbs\n   list Conversation as conversation where conversation.active empty=\"No conversations\"@{nl=\"Geen gesprekken\"}\n    pagination\n    title row.title\n    list row.Branch empty=\"No branches\"@{nl=\"Geen vertakkingen\"}\n     pagination\n     title row.title\n     list row.Turn order=position empty=\"No messages\"@{nl=\"Geen berichten\"}\n      pagination\n      chat_bubble\n       slot header\n        text row.role\n       slot content\n        content row.content\n      form from_turn arguments={turn=row}\n       fieldset \"Image prompt\"@{nl=\"Beeldprompt\"}\n        select template\n        textarea negative\n       fieldset \"Size\"@{nl=\"Formaat\"}\n        input width\n        input height\n  page /creative/recovery title=\"Unresolved image jobs\"@{nl=\"Onopgeloste beeldtaken\"} poll=1s\n   require members\n   breadcrumbs\n   table Run as run where run.unfinished or run.used==null columns=state,delivery_state,stop_delivery,reconcile_delivery,used,detail empty=\"No unresolved image jobs\"@{nl=\"Geen onopgeloste beeldtaken\"}\n    pagination\n    status row.delivery_state\n    actions stop,reconcile,release_skipped\n  page /creative/workflows title=\"Workflow templates\"@{nl=\"Workflowsjablonen\"} poll=1s\n   require creative_manager\n   breadcrumbs\n   alert\n    text \"Upload an allowed API-format graph. Inspect its inputs, map the four fields, validate a snapshot, then publish it.\"@{nl=\"Upload een toegestane API-graaf. Inspecteer de invoer, koppel vier velden, valideer een momentopname en publiceer deze.\"}\n   form Template.create\n    fieldset \"Graph\"@{nl=\"Graaf\"}\n     input name\n     file_input graph\n    fieldset \"Input mapping\"@{nl=\"Invoerkoppeling\"}\n     input prompt_node\n     input prompt_key\n     input negative_node\n     input negative_key\n     input width_node\n     input width_key\n     input height_node\n     input height_key\n    fieldset \"Limits\"@{nl=\"Limieten\"}\n     range outputs\n     input duration\n   list Template as template where template.owner==actor empty=\"No workflow templates yet\"@{nl=\"Nog geen workflowsjablonen\"}\n    pagination\n    title row.name\n    edit\n    action inspect\n    text row.inspection\n    list (row.inspection?.result?.fields??[]) empty=\"No input fields found\"@{nl=\"Geen invoervelden gevonden\"}\n     pagination\n     text row.node,row.key,row.kind,row.label\n    action validate\n    list row.Revision order=-number empty=\"No revisions yet\"@{nl=\"Nog geen versies\"}\n     pagination\n     text row.number,row.published,row.validation,row.digest\n     action publish\n   form Budget.create\n    ## account keeps its generated entry: user references have no catalog picker.\n    input cap\n    range parallel\n   table Budget columns=account,cap,parallel,spent,held,running,active empty=\"No image-job allowances\"@{nl=\"Geen budgetten voor beeldtaken\"}\n    pagination\n    edit fields=cap,parallel,active\n     input cap\n     range parallel\n     checkbox active\n"}}
