{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"0e350815a8f677c9fd41f4b05bb4eada7c25c6d56d5d526bcb2f863f0e2b851c","before_projection_sha256":"0e350815a8f677c9fd41f4b05bb4eada7c25c6d56d5d526bcb2f863f0e2b851c","changed":false,"idempotent":true,"structure_equal":true,"text":"# Help prospective and existing workspace customers book site tours, sales consultations, and onboarding appointments. @{nl=\"Help toekomstige en bestaande werkplekklanten rondleidingen, verkoopgesprekken en onboardingafspraken boeken.\"}\napp CanBook uses=[appointments]\n\n# Coordinate customer appointments with host commitments and separately held rooms. @{nl=\"Coördineer klantafspraken met gastheerverplichtingen en afzonderlijk vastgehouden ruimtes.\"}\npackage appointments\n use customer {Customer,Contact,owns,has_role,test_company,test_contact}\n use rent_catalog {Location,is_open,test_site,open_site}\n use employee {Employee,can_work,test_worker}\n use std {DeliveryResult}\n use std {EmailV1 as Mail} from=deployment.mail\n use rent_reservations {RoomsV1 as Rooms} from=deployment.rooms\n use shift {ScheduleV1 as StaffSchedule} from=deployment.staff_schedule\n Given\n  role host_manager label=\"Host manager\"@{nl=\"Gastheerbeheerder\"}\n  export Calendar { location:Location, host:Employee label=label_Calendar_host, timezone:timezone, duration:duration=30m, hours:text label=\"Opening hours\"@{nl=\"Openingstijden\"}, instructions:text, cutoff:duration=1h label=\"Cancellation cutoff\"@{nl=\"Annuleringsgrens\"}, active:bool=true } label=\"Host calendar\"@{nl=\"Gastheerkalender\"}\n  export Window in Calendar { from:datetime label=label_Window_from, until:datetime label=label_Window_until, available:bool=true label=\"Available\"@{nl=\"Beschikbaar\"} } label=\"Availability window\"@{nl=\"Beschikbaarheidsvenster\"}\n  export Type in Calendar { name:text, duration:duration, room:text? label=\"Room\"@{nl=\"Ruimte\"} } label=\"Appointment type\"@{nl=\"Afspraaktype\"}\n  export Appointment in Type { customer:Customer label=\"Customer\"@{nl=\"Klant\"}, contact:Contact label=\"Contact\"@{nl=\"Contactpersoon\"}, from:datetime label=label_Window_from, until:datetime label=label_Window_until, duration:duration, source:text unique label=\"Source reference\"@{nl=\"Bronreferentie\"}, host:user label=label_Calendar_host, state:enum(pending,confirmed,cancelled,attended,no_show,unavailable)=pending label={text=\"Appointment state\"@{nl=\"Afspraakstatus\"},values={pending=\"Pending\"@{nl=\"In behandeling\"},confirmed=\"Confirmed\"@{nl=\"Bevestigd\"},cancelled=\"Cancelled\"@{nl=\"Geannuleerd\"},attended=label_Appointment_state_attended,no_show=\"No show\"@{nl=\"Niet verschenen\"},unavailable=\"Unavailable\"@{nl=\"Niet beschikbaar\"}}}, host_ok:bool=false label=\"Host confirmed\"@{nl=\"Gastheer bevestigd\"}, room_ok:bool=false label=\"Room confirmed\"@{nl=\"Ruimte bevestigd\"}, host_delivery:text? label=\"Host request reference\"@{nl=\"Referentie gastheerverzoek\"}, room_delivery:text? label=\"Room request reference\"@{nl=\"Referentie ruimteverzoek\"}, reservation_account:user server=actor label=\"Reservation principal\"@{nl=\"Reserveringsaccount\"}, active_source:text label=\"Active reservation source\"@{nl=\"Actieve reserveringsbron\"}, room_snapshot:text? label=\"Frozen venue reference\"@{nl=\"Vastgelegde ruimtereferentie\"}, reason:text? } label=\"Appointment\"@{nl=\"Afspraak\"}\n  WeeklyHours in Calendar { weekday:int min=1 max=7, opens:text=\"09:00\", closes:text=\"18:00\", fold:enum(earlier,later)=earlier } label=\"Weekly opening hours\"@{nl=\"Wekelijkse openingstijden\"}\n  ClosedDay in Calendar { day:date unique, reason:text } label=\"Holiday or closed day\"@{nl=\"Feestdag of sluitingsdag\"}\n  Attempt in Appointment { source:text unique, kind:enum(initial,movement) label={text=\"Request kind\"@{nl=\"Verzoeksoort\"},values={initial=\"Initial booking\"@{nl=\"Eerste boeking\"},movement=\"Reschedule\"@{nl=\"Verplaatsing\"}}}, from:datetime, until:datetime, previous_source:text?, previous_host_revision:int=1, previous_room_revision:int=1, requested_by:user server=actor, state:enum(pending,active,failed,cancelled,retired,released)=pending label={text=\"Reservation attempt\"@{nl=\"Reserveringspoging\"},values={pending=\"Pending\"@{nl=\"In behandeling\"},active=\"Active\"@{nl=\"Actief\"},failed=\"Failed\"@{nl=\"Mislukt\"},cancelled=\"Cancelled\"@{nl=\"Geannuleerd\"},retired=\"Previous slot awaiting release\"@{nl=\"Vorige afspraak wacht op vrijgave\"},released=\"Released\"@{nl=\"Vrijgegeven\"}}}, host_ok:bool=false, room_ok:bool=false, host_unknown:bool=false, room_unknown:bool=false, host_revision:int=1, room_revision:int=1, host_delivery:text?, room_delivery:text?, room_confirmation:text?, host_release:text?, room_release:text?, host_released:bool=false, room_released:bool=false } label=\"Reservation attempt\"@{nl=\"Reserveringspoging\"}\n  Notice in Appointment { kind:enum(confirmation,reminder) label={text=\"Notice kind\"@{nl=\"Berichtsoort\"},values={confirmation=\"Confirmation\"@{nl=\"Bevestiging\"},reminder=\"Reminder\"@{nl=\"Herinnering\"}}}, source:text, delivery:delivery(Mail.send) } label=\"Appointment notice delivery\"@{nl=\"Verzending afspraakbericht\"}\n  ## Notice state observes the Mail receipt; the existing Delivered caption renders succeeded.\n  derive Notice.state:DeliveryResult.status = row.delivery.status label={text=\"Delivery\"@{nl=\"Verzending\"},values={pending=\"Pending\"@{nl=\"In behandeling\"},succeeded=\"Delivered\"@{nl=\"Afgeleverd\"},failed=\"Failed\"@{nl=\"Mislukt\"},unknown=\"Unknown\"@{nl=\"Onbekend\"},skipped=\"Skipped\"@{nl=\"Overgeslagen\"}}}\n  derive available(calendar:Calendar,from:datetime,until:datetime):bool = is_open(calendar.location,from,until) and from<until and local_date(from,calendar.timezone)==local_date(until-1ms,calendar.timezone) and any(calendar.WeeklyHours as hours,hours.weekday==weekday(local_date(from,calendar.timezone)) and local_instant(local_date(from,calendar.timezone),hours.opens,calendar.timezone,fold=hours.fold)<=from and until<=local_instant(local_date(from,calendar.timezone),hours.closes,calendar.timezone,fold=hours.fold)) and not any(calendar.ClosedDay as closure,closure.day==local_date(from,calendar.timezone)) and any(calendar.Window as window,window.available and window.from<=from and until<=window.until) and not any(calendar.Window as window,not window.available and overlaps(from,until,window.from,window.until))\n  event Reminder { appointment:Appointment, revision:int }\n  event AttemptProgress { attempt:Attempt }\n  policy Calendar read=public fields=location,timezone,duration,hours,instructions,cutoff,active\n  policy Window read=public\n  policy WeeklyHours read=public\n  policy ClosedDay read=public\n  policy Attempt read=host_manager and can_work(actor,row.parent.parent.parent.location)\n  policy Attempt read=authenticated where=row.parent.contact.account==actor and row.parent.contact.verified\n  policy Notice read=host_manager and can_work(actor,row.parent.parent.parent.location) fields=parent,kind,source,delivery.id,delivery.status,state,created_by,created,updated_by,updated,archived_at\n  policy Notice read=authenticated where=row.parent.contact.account==actor and row.parent.contact.verified fields=parent,kind,source,delivery.id,delivery.status,state,created_by,created,updated_by,updated,archived_at\n  policy Type read=public\n  policy Appointment read=host_manager and can_work(actor,row.parent.parent.location)\n  policy Appointment read=authenticated where=row.contact.account==actor and row.contact.verified\n  invariant WeeklyHours: row.opens<row.closes and local_instant(date(\"2000-01-03\"),row.opens,row.parent.timezone,fold=row.fold)<local_instant(date(\"2000-01-03\"),row.closes,row.parent.timezone,fold=row.fold)\n  invariant Attempt: row.from<row.until and row.until-row.from==row.parent.duration\n  lock Attempt fields=source,kind,from,until,previous_source,previous_host_revision,previous_room_revision,requested_by\n  lock Notice fields=kind,source,delivery\n  invariant Type: row.duration>0m\n  invariant Window: row.from<row.until\n  invariant Appointment: row.from<row.until and row.until-row.from==row.duration and row.contact.parent==row.customer\n  lock Appointment fields=customer,contact,duration,source,host,room_snapshot,reservation_account\n  export fixture host_calendar=Calendar {location=test_site,host=test_worker,timezone=\"Europe/Brussels\",hours=\"09:00–18:00\",instructions=\"Reception\"}\n  export fixture tour=Type {parent=host_calendar,name=\"Tour\",duration=30m}\n  export fixture booked=Appointment {parent=tour,customer=test_company,contact=test_contact,from=datetime(\"2099-01-01T09:00:00Z\"),until=datetime(\"2099-01-01T09:30:00Z\"),duration=30m,source=\"tour\",active_source=\"tour\",host=self,state=confirmed,host_ok=true,room_ok=true}\n  fixture opening=WeeklyHours {parent=host_calendar,weekday=4}\n  fixture closure=ClosedDay {parent=host_calendar,day=date(\"2099-01-02\"),reason=\"Holiday\"}\n  fixture published=Window {parent=host_calendar,from=datetime(\"2099-01-01T09:00:00Z\"),until=datetime(\"2099-01-01T18:00:00Z\")}\n  fixture original=Attempt {parent=booked,source=\"tour\",kind=initial,from=datetime(\"2099-01-01T09:00:00Z\"),until=datetime(\"2099-01-01T09:30:00Z\"),state=active,host_ok=true,room_ok=true,room_released=true}\n  fixture candidate=Attempt {parent=booked,source=\"move\",kind=movement,from=datetime(\"2099-01-01T10:00:00Z\"),until=datetime(\"2099-01-01T10:30:00Z\"),previous_source=\"tour\",host_delivery=\"move-host\",room_ok=true,room_released=true}\n  preferences { location:Location?, appointment_state:Appointment.state? label=\"Initial appointment state filter\"@{nl=\"Eerste filter afspraakstatus\"} }\n  message label_Calendar_host = \"Host\"@{nl=\"Gastheer\"}\n  message label_Window_from = \"From\"@{nl=\"Vanaf\"}\n  message label_Window_until = \"Until\"@{nl=\"Tot\"}\n  message label_Appointment_state_attended = \"Attended\"@{nl=\"Aanwezig\"}\n When\n  crud Calendar by=host_manager fields=duration,hours,instructions,cutoff,active create_fields=location,host,timezone,duration,hours,instructions,cutoff when=can_work(actor,row.location) delete=none\n  crud Window by=host_manager fields=from,until,available when=can_work(actor,row.parent.location) delete=none\n  crud WeeklyHours by=host_manager fields=weekday,opens,closes,fold when=can_work(actor,row.parent.location) delete=remove\n  crud ClosedDay by=host_manager fields=day,reason when=can_work(actor,row.parent.location) delete=remove\n  crud Type by=host_manager fields=name,duration,room when=can_work(actor,row.parent.location) delete=none\n  # Freeze duration and venue, then acquire both resources before confirmation. @{nl=\"Leg duur en ruimte vast en verkrijg beide voorzieningen vóór bevestiging.\"}\n  export scenario book(type:Type,customer:Customer,contact:Contact,from:datetime label=label_Window_from) by=authenticated label=\"Book appointment\"@{nl=\"Afspraak boeken\"}\n   require type.parent.active and type.parent.host.active and from>=now and contact.parent==customer\n   require (contact.account==actor and contact.verified) or (host_manager and can_work(actor,type.parent.location))\n   require any(type.parent.Window as window,window.available and window.from<=from and from+type.duration<=window.until)\n   require available(type.parent,from,from+type.duration)\n   do\n    create Appointment {parent=type,customer,contact,from,until=from+type.duration,duration=type.duration,source=operation.id,active_source=operation.id,host=type.parent.host.user,room_snapshot=type.room} as visit\n    create Attempt {parent=visit,source=operation.id,kind=initial,from,until=visit.until,room_ok=type.room==null,room_released=type.room==null} as attempt\n    send StaffSchedule.reserve {value={source=attempt.source,employee=visit.host,location=type.parent.location.id,from,until=attempt.until,skill=\"host\",kind=appointment,revision=1}} as host_hold\n    set attempt {host_delivery=host_hold.id}\n    set visit {host_delivery=host_hold.id}\n    if visit.room_snapshot!=null\n     send Rooms.hold {value={source=attempt.source,resource=visit.room_snapshot,customer=customer.id,account=visit.reservation_account,from,until=attempt.until,quantity=1,revision=1}} as room_hold\n     set attempt {room_delivery=room_hold.id}\n     set visit {room_delivery=room_hold.id}\n    else\n     set visit {room_ok=true}\n   examples seed=[test_worker,open_site,opening,published,closure] type=tour customer=test_company contact=test_contact from=datetime(\"2099-01-01T09:00:00Z\")\n    as,closure.day -> count(Appointment as visit where visit.source==operation.id)\n    members,date(\"2099-01-02\") -> 1\n    members,date(\"2099-01-01\") -> error(rule_failed)\n    public,date(\"2099-01-02\") -> error(forbidden)\n  # Stage a replacement while the original host and venue remain allocated. @{nl=\"Bereid vervanging voor terwijl de oorspronkelijke gastheer en ruimte gereserveerd blijven.\"}\n  export scenario reschedule(visit:Appointment,from:datetime label=label_Window_from) by=authenticated or host_manager label=\"Reschedule appointment\"@{nl=\"Afspraak verplaatsen\"}\n   require visit.state in [confirmed,unavailable] and from>=now and from!=visit.from\n   require (visit.contact.account==actor and visit.contact.verified and (visit.state==unavailable or now<visit.from-visit.parent.parent.cutoff)) or (host_manager and can_work(actor,visit.parent.parent.location))\n   require visit.parent.parent.active and available(visit.parent.parent,from,from+visit.duration)\n   require not any(visit.Attempt as attempt,attempt.state in [pending,failed,cancelled,retired])\n   do\n    let previous=first(visit.Attempt as attempt where attempt.source==visit.active_source and attempt.state==active order=attempt.id)\n    require previous!=null\n    create Attempt {parent=visit,source=operation.id,kind=movement,from,until=from+visit.duration,previous_source=previous.source,previous_host_revision=previous.host_revision,previous_room_revision=previous.room_revision,room_ok=visit.room_snapshot==null,room_released=visit.room_snapshot==null} as attempt\n    send StaffSchedule.stage {value={source=attempt.source,employee=visit.host,location=visit.parent.parent.location.id,from,until=attempt.until,skill=\"host\",kind=appointment,revision=1},previous_source=previous.source,previous_revision=previous.host_revision} as host_hold\n    set attempt {host_delivery=host_hold.id}\n    if visit.room_snapshot!=null\n     send Rooms.stage {value={source=attempt.source,resource=visit.room_snapshot,customer=visit.customer.id,account=visit.reservation_account,from,until=attempt.until,quantity=1,revision=1},previous_source=previous.source,previous_revision=previous.room_revision} as room_hold\n     set attempt {room_delivery=room_hold.id}\n   examples seed=[test_worker,open_site,opening,published,original] visit=booked\n    as,from -> visit.from,count(visit.Attempt)\n    members,datetime(\"2099-01-01T10:00:00Z\") -> datetime(\"2099-01-01T09:00:00Z\"),2\n    members,datetime(\"2099-01-01T09:00:00Z\") -> error(rule_failed)\n    public,datetime(\"2099-01-01T10:00:00Z\") -> error(forbidden)\n   examples seed=[test_worker,open_site,opening,published,original] visit=booked from=datetime(\"2099-01-01T10:00:00Z\")\n    as,visit.state,host_calendar.cutoff -> visit.state,visit.active_source,count(visit.Attempt)\n    members,unavailable,36500d -> unavailable,\"tour\",2\n    members,confirmed,36500d -> error(rule_failed)\n  # Cancel the active reservation and all pending candidates with recoverable releases. @{nl=\"Annuleer de actieve reservering en alle wachtende kandidaten met herstelbare vrijgave.\"}\n  export scenario cancel(appointment:Appointment,reason:text) by=authenticated or host_manager\n   require appointment.state in [pending,confirmed,unavailable] and trim(reason)!=\"\"\n   require (appointment.contact.account==actor and appointment.contact.verified and (appointment.state==unavailable or now<appointment.from-appointment.parent.parent.cutoff)) or (host_manager and can_work(actor,appointment.parent.parent.location))\n   do\n    set appointment {state=cancelled,reason}\n    cancel appointment.id\n    for attempt in appointment.Attempt as item where item.state in [pending,active] limit=100\n     set attempt {state=cancelled}\n   examples seed=[test_worker,original] appointment=booked reason=\"Changed plans\"\n    as,appointment.state -> appointment.state\n    members,confirmed -> cancelled\n    members,cancelled -> error(rule_failed)\n    public,confirmed -> error(forbidden)\n   examples seed=[test_worker,original] appointment=booked reason=\"Host unavailable\"\n    as,appointment.state,host_calendar.cutoff -> appointment.state,original.state\n    members,unavailable,36500d -> cancelled,cancelled\n    members,confirmed,36500d -> error(rule_failed)\n  # Abandon a pending replacement while retaining the original appointment and its current availability. @{nl=\"Stop een wachtende vervanging en behoud de oorspronkelijke afspraak en haar huidige beschikbaarheid.\"}\n  scenario discard_reschedule(visit:Appointment) by=authenticated or host_manager label=\"Discard reschedule\"@{nl=\"Verplaatsing afbreken\"}\n   require visit.state in [confirmed,unavailable]\n   require (visit.contact.account==actor and visit.contact.verified) or (host_manager and can_work(actor,visit.parent.parent.location))\n   do\n    for attempt in visit.Attempt as item where item.kind==movement and item.state==pending limit=100\n     set attempt {state=cancelled}\n   examples seed=[test_worker,original,candidate] visit=booked\n    as -> candidate.state,visit.from,visit.state\n    members -> cancelled,datetime(\"2099-01-01T09:00:00Z\"),confirmed\n    public -> error(forbidden)\n   examples seed=[test_worker,original,candidate] visit=booked\n    as,visit.state -> candidate.state,visit.state,original.state\n    members,unavailable -> cancelled,unavailable,active\n  # Retry failed resource cleanup without reopening or changing the retained original slot. @{nl=\"Probeer mislukte vrijgave opnieuw zonder de behouden oorspronkelijke afspraak te wijzigen.\"}\n  scenario retry_cleanup(appointment:Appointment) by=authenticated or host_manager label=\"Retry reservation cleanup\"@{nl=\"Vrijgave opnieuw proberen\"}\n   require (appointment.contact.account==actor and appointment.contact.verified) or (host_manager and can_work(actor,appointment.parent.parent.location))\n   do\n    for attempt in appointment.Attempt as item where item.state in [failed,cancelled,retired] limit=100\n     if not attempt.host_released\n      set attempt {host_release=null}\n     if not attempt.room_released\n      set attempt {room_release=null}\n  # Record an attendance outcome without altering a paid workspace reservation. @{nl=\"Leg aanwezigheid vast zonder een betaalde werkplekreservering te wijzigen.\"}\n  export scenario attendance(appointment:Appointment,attend:bool label=label_Appointment_state_attended,reason:text) by=host_manager label=\"Record attendance\"@{nl=\"Aanwezigheid vastleggen\"}\n   require can_work(actor,appointment.parent.parent.location) and appointment.state==confirmed and now>=appointment.from and trim(reason)!=\"\"\n   do\n    if attend\n     set appointment {state=attended,reason}\n    else\n     set appointment {state=no_show,reason}\n   examples seed=[test_worker] appointment=booked attend=true reason=\"Attendance reviewed\"\n    as,appointment.state,appointment.from,appointment.until -> appointment.state\n    host_manager,confirmed,now-30m,now -> attended\n    host_manager,unavailable,now-30m,now -> error(rule_failed)\n  scenario host_result on=StaffSchedule.reserve.completed\n   do\n    for attempt in Attempt as item where item.host_delivery==event.delivery_id and item.state==pending limit=1\n     if event.status==succeeded and event.result!=null and event.result.source==attempt.source and event.result.revision==1 and event.result.state==confirmed\n      set attempt {host_ok=true,host_unknown=false,host_revision=event.result.revision}\n     else\n      if event.status==failed or (event.status==succeeded and event.result!=null and event.result.state in [unavailable,failed,released])\n       set attempt {state=failed,host_unknown=false}\n       if attempt.kind==initial and attempt.parent.state==pending\n        set attempt.parent {state=unavailable}\n      else\n       set attempt {host_unknown=true}\n  scenario host_staged on=StaffSchedule.stage.completed\n   do\n    for attempt in Attempt as item where item.host_delivery==event.delivery_id and item.state==pending limit=1\n     if event.status==succeeded and event.result!=null and event.result.source==attempt.source and event.result.revision==1 and event.result.state==confirmed\n      set attempt {host_ok=true,host_unknown=false,host_revision=event.result.revision}\n     else\n      if event.status==failed or (event.status==succeeded and event.result!=null and event.result.state in [unavailable,failed,released])\n       set attempt {state=failed,host_unknown=false}\n       if attempt.kind==initial and attempt.parent.state==pending\n        set attempt.parent {state=unavailable}\n      else\n       set attempt {host_unknown=true}\n   examples seed=[test_worker,original,candidate] event={delivery_id=\"move-host\",status=succeeded,result={source=\"move\",revision=1,state=unavailable,reference=null,detail=\"Host unavailable\"},error=null}\n    event.result.state,candidate.state -> candidate.state,booked.from,booked.state\n    unavailable,pending -> failed,datetime(\"2099-01-01T09:00:00Z\"),confirmed\n    confirmed,pending -> pending,datetime(\"2099-01-01T09:00:00Z\"),confirmed\n    confirmed,cancelled -> cancelled,datetime(\"2099-01-01T09:00:00Z\"),confirmed\n    confirmed,active -> active,datetime(\"2099-01-01T09:00:00Z\"),confirmed\n  scenario room_result on=Rooms.hold.completed\n   do\n    for attempt in Attempt as item where item.room_delivery==event.delivery_id and item.state==pending limit=1\n     if event.status==succeeded and event.result!=null and event.result.source==attempt.source and event.result.revision==1 and event.result.state in [pending,confirmed] and attempt.state==pending\n      if attempt.room_confirmation==null\n       require attempt.parent.room_snapshot!=null\n       send Rooms.confirm {source=attempt.source,resource=attempt.parent.room_snapshot} as confirmation\n       set attempt {room_confirmation=confirmation.id,room_revision=event.result.revision}\n     else\n      if event.status==failed or (event.status==succeeded and event.result!=null and event.result.state in [unavailable,failed,released])\n       set attempt {state=failed,room_unknown=false}\n       if attempt.kind==initial and attempt.parent.state==pending\n        set attempt.parent {state=unavailable}\n      else\n       set attempt {room_unknown=true}\n  scenario room_staged on=Rooms.stage.completed\n   do\n    for attempt in Attempt as item where item.room_delivery==event.delivery_id and item.state==pending limit=1\n     if event.status==succeeded and event.result!=null and event.result.source==attempt.source and event.result.revision==1 and event.result.state in [pending,confirmed] and attempt.state==pending\n      if attempt.room_confirmation==null\n       require attempt.parent.room_snapshot!=null\n       send Rooms.confirm {source=attempt.source,resource=attempt.parent.room_snapshot} as confirmation\n       set attempt {room_confirmation=confirmation.id,room_revision=event.result.revision}\n     else\n      if event.status==failed or (event.status==succeeded and event.result!=null and event.result.state in [unavailable,failed,released])\n       set attempt {state=failed,room_unknown=false}\n       if attempt.kind==initial and attempt.parent.state==pending\n        set attempt.parent {state=unavailable}\n      else\n       set attempt {room_unknown=true}\n  scenario room_confirmed on=Rooms.confirm.completed\n   do\n    for attempt in Attempt as item where item.room_confirmation==event.delivery_id and item.state==pending limit=1\n     if event.status==succeeded and event.result!=null and event.result.source==attempt.source and event.result.revision>=attempt.room_revision and event.result.state==confirmed\n      set attempt {room_ok=true,room_unknown=false,room_revision=event.result.revision}\n     else\n      if event.status==failed or (event.status==succeeded and event.result!=null and event.result.state in [unavailable,failed,released])\n       set attempt {state=failed,room_unknown=false}\n       if attempt.kind==initial and attempt.parent.state==pending\n        set attempt.parent {state=unavailable}\n      else\n       set attempt {room_unknown=true}\n  scenario host_changed on=StaffSchedule.changed\n   do\n    for attempt in Attempt as item where item.source==event.value.source and item.host_revision==event.value.revision and item.state in [pending,active] limit=1\n     if attempt.state==pending\n      if event.value.state==confirmed\n       set attempt {host_ok=true,host_unknown=false}\n      if event.value.state in [unavailable,failed,released]\n       set attempt {state=failed,host_ok=false,host_unknown=false}\n       if attempt.kind==initial and attempt.parent.state==pending\n        set attempt.parent {state=unavailable,host_ok=false}\n     else\n      ## Keep the active allocations for explicit cancellation or a freshly confirmed replacement.\n      if attempt.parent.active_source==attempt.source and attempt.parent.state==confirmed and event.value.state in [unavailable,failed,released]\n       set attempt {host_ok=false,host_unknown=false}\n       set attempt.parent {state=unavailable,host_ok=false,reason=format(\"Host commitment unavailable; cancel or request a new appointment time.\"@{nl=\"De gastheer is niet meer beschikbaar; annuleer of vraag een nieuw afspraaktijdstip aan.\"},locale=null)}\n       cancel attempt.parent.id\n   ## The provider's commercial revision identifies this commitment; it is not an event sequence.\n   ## A late confirmed observation cannot revive an invalidated active appointment.\n   examples seed=[test_worker,original] event={value={source=\"tour\",revision=1,state=unavailable,reference=\"host-commitment\",detail=null}}\n    original.state,booked.state,booked.active_source,event.value.source,event.value.revision,event.value.state -> booked.state,original.state,booked.host_ok,original.host_ok,booked.room_ok,original.host_release,original.room_release\n    active,confirmed,\"tour\",\"tour\",1,unavailable -> unavailable,active,false,false,true,null,null\n    active,confirmed,\"tour\",\"tour\",1,released -> unavailable,active,false,false,true,null,null\n    active,confirmed,\"tour\",\"other\",1,unavailable -> confirmed,active,true,true,true,null,null\n    active,confirmed,\"tour\",\"tour\",2,unavailable -> confirmed,active,true,true,true,null,null\n    active,confirmed,\"replacement\",\"tour\",1,unavailable -> confirmed,active,true,true,true,null,null\n    retired,confirmed,\"tour\",\"tour\",1,unavailable -> confirmed,retired,true,true,true,null,null\n    active,cancelled,\"tour\",\"tour\",1,unavailable -> cancelled,active,true,true,true,null,null\n    active,attended,\"tour\",\"tour\",1,unavailable -> attended,active,true,true,true,null,null\n    pending,pending,\"tour\",\"tour\",1,unavailable -> unavailable,failed,false,false,true,null,null\n   examples seed=[test_worker,original] event={value={source=\"tour\",revision=1,state=confirmed,reference=\"host-commitment\",detail=null}}\n    booked.state,booked.host_ok,original.host_ok -> booked.state,booked.host_ok,original.host_ok\n    unavailable,false,false -> unavailable,false,false\n  scenario venue_changed on=Rooms.changed\n   do\n    for attempt in Attempt as item where item.source==event.value.source and item.state==pending limit=1\n     if event.value.revision>=attempt.room_revision and event.value.state==pending and attempt.room_confirmation==null\n      require attempt.parent.room_snapshot!=null\n      send Rooms.confirm {source=attempt.source,resource=attempt.parent.room_snapshot} as confirmation\n      set attempt {room_confirmation=confirmation.id,room_unknown=false,room_revision=event.value.revision}\n     if event.value.revision>=attempt.room_revision and event.value.state==confirmed\n      set attempt {room_ok=true,room_unknown=false,room_revision=event.value.revision}\n     if event.value.state in [unavailable,failed,released]\n      set attempt {state=failed,room_unknown=false}\n      if attempt.kind==initial and attempt.parent.state==pending\n       set attempt.parent {state=unavailable}\n  ## Change events locate current state; no historical event snapshot or population scan.\n  scenario attempt_created on=Attempt.created\n   do\n    for changed in Attempt as row where row.id==event.id limit=1\n     emit AttemptProgress {attempt=changed}\n  scenario attempt_updated on=Attempt.updated\n   do\n    for changed in Attempt as row where row.id==event.id limit=1\n     emit AttemptProgress {attempt=changed}\n  ## Address old backlog explicitly without restarting an allocation or releasing the retained original.\n  scenario recover_attempt(attempt:Attempt) by=authenticated or host_manager label=\"Resume reservation follow-up\"@{nl=\"Reserveringsopvolging hervatten\"}\n   require (attempt.parent.contact.account==actor and attempt.parent.contact.verified) or (host_manager and can_work(actor,attempt.parent.parent.parent.location))\n   do emit AttemptProgress {attempt}\n   examples seed=[test_worker] attempt=candidate\n    as,request.attempt.version -> attempt.state\n    members,1 -> pending\n    members,0 -> error(conflict)\n    public,1 -> error(forbidden)\n  scenario ready on=AttemptProgress\n   do\n    let attempt=event.attempt\n    if attempt.state==pending and attempt.host_ok and attempt.room_ok and not attempt.host_unknown and not attempt.room_unknown\n     let appointment=attempt.parent\n     if (attempt.kind==initial and appointment.state==pending) or (attempt.kind==movement and appointment.state in [confirmed,unavailable] and appointment.active_source==attempt.previous_source)\n      if attempt.previous_source!=null\n       for previous in appointment.Attempt as item where item.source==attempt.previous_source and item.state==active limit=1\n        set previous {state=retired}\n      cancel appointment.id\n      set appointment {from=attempt.from,until=attempt.until,active_source=attempt.source,state=confirmed,host_ok=true,room_ok=true,host_delivery=attempt.host_delivery,room_delivery=attempt.room_delivery,reason=null}\n      set attempt {state=active}\n      send Mail.send {to=appointment.contact.email,subject=format(\"Appointment confirmed\"@{nl=\"Afspraak bevestigd\"},locale=null),body=appointment.parent.parent.instructions} when=appointment.state==confirmed and appointment.active_source==attempt.source as confirmed_notice\n      create Notice {parent=appointment,kind=confirmation,source=attempt.source,delivery=confirmed_notice} as notice\n      if appointment.from>now+1h\n       schedule appointment.id at=appointment.from-1h event=Reminder {appointment,revision=appointment.version+1}\n     else\n      set attempt {state=cancelled}\n   examples seed=[test_worker,original] event={attempt=candidate}\n    candidate.host_ok,candidate.room_ok,candidate.state,booked.active_source -> booked.from,booked.state,candidate.state,original.state\n    true,true,pending,\"tour\" -> datetime(\"2099-01-01T10:00:00Z\"),confirmed,active,retired\n    false,true,pending,\"tour\" -> datetime(\"2099-01-01T09:00:00Z\"),confirmed,pending,active\n    true,false,pending,\"tour\" -> datetime(\"2099-01-01T09:00:00Z\"),confirmed,pending,active\n    true,true,cancelled,\"tour\" -> datetime(\"2099-01-01T09:00:00Z\"),confirmed,cancelled,active\n    true,true,pending,\"newer\" -> datetime(\"2099-01-01T09:00:00Z\"),confirmed,cancelled,active\n   examples seed=[test_worker,original] event={attempt=candidate}\n    candidate.state,candidate.host_ok,booked.active_source,booked.from,booked.until,original.state -> candidate.state,original.state,booked.from,count(Notice)\n    active,true,\"move\",candidate.from,candidate.until,retired -> active,retired,datetime(\"2099-01-01T10:00:00Z\"),0\n   examples seed=[test_worker,original] event={attempt=candidate}\n    booked.state,booked.host_ok,booked.reason,candidate.host_ok,candidate.room_ok -> booked.state,booked.host_ok,booked.reason,candidate.state,original.state\n    unavailable,false,\"Host unavailable\",true,true -> confirmed,true,null,active,retired\n    unavailable,false,\"Host unavailable\",false,true -> unavailable,false,\"Host unavailable\",pending,active\n  scenario cleanup on=AttemptProgress\n   do\n    let attempt=event.attempt\n    if attempt.state in [failed,cancelled,retired]\n     if not attempt.host_released and attempt.host_release==null\n      send StaffSchedule.release {source=attempt.source,revision=attempt.host_revision} as release\n      set attempt {host_release=release.id}\n     if not attempt.room_released and attempt.room_release==null\n      require attempt.parent.room_snapshot!=null\n      send Rooms.release {source=attempt.source,resource=attempt.parent.room_snapshot,reason=\"Appointment resource cleanup\"} as release\n      set attempt {room_release=release.id}\n     if attempt.host_released and attempt.room_released\n      set attempt {state=released}\n   examples seed=[test_worker,original] event={attempt=candidate}\n    candidate.state,candidate.host_release,candidate.host_released -> candidate.state,candidate.host_release==null,original.state,booked.from\n    cancelled,null,false -> cancelled,false,active,datetime(\"2099-01-01T09:00:00Z\")\n    cancelled,\"release\",false -> cancelled,false,active,datetime(\"2099-01-01T09:00:00Z\")\n    failed,null,true -> released,true,active,datetime(\"2099-01-01T09:00:00Z\")\n    active,null,false -> active,true,active,datetime(\"2099-01-01T09:00:00Z\")\n   examples seed=[test_worker,original] event={attempt=candidate}\n    booked.room_snapshot,candidate.state,candidate.room_released,candidate.room_release -> candidate.host_release==null,candidate.room_release==null,original.state\n    \"office\",cancelled,false,null -> false,false,active\n    \"office\",cancelled,false,\"release\" -> false,false,active\n  scenario host_released on=StaffSchedule.release.completed\n   do\n    for attempt in Attempt as item where item.host_release==event.delivery_id limit=1\n     if event.status==succeeded and event.result!=null and event.result.source==attempt.source and event.result.state==released\n      set attempt {host_released=true}\n  scenario room_released on=Rooms.release.completed\n   do\n    for attempt in Attempt as item where item.room_release==event.delivery_id limit=1\n     if event.status==succeeded and event.result!=null and event.result.source==attempt.source and event.result.state==released\n      set attempt {room_released=true}\n  scenario remind on=Reminder\n   require event.appointment.state==confirmed and event.appointment.version==event.revision\n   do\n    send Mail.send {to=event.appointment.contact.email,subject=format(\"Appointment reminder\"@{nl=\"Afspraakherinnering\"},locale=null),body=event.appointment.parent.parent.instructions} when=event.appointment.state==confirmed and event.appointment.version==event.revision as delivery\n    create Notice {parent=event.appointment,kind=reminder,source=event.appointment.active_source,delivery} as notice\n   examples seed=[test_worker] event={appointment=booked,revision=1}\n    booked.state,event.revision -> count(Notice),first(booked.Notice)?.state\n    unavailable,1 -> error(rule_failed)\n    confirmed,0 -> error(rule_failed)\n    confirmed,1 -> 1,pending\n Then\n  # Choose a location, appointment type and published host window. @{nl=\"Kies een locatie, afspraaktype en gepubliceerd gastheervenster.\"}\n  page /appointments title=\"Appointments\"@{nl=\"Afspraken\"}\n   breadcrumbs\n   hero \"Published host windows\"@{nl=\"Gepubliceerde gastheervensters\"}\n    list Calendar columns=location,timezone,duration,active filter=location,active defaults={location=preferences.location} display=split\n     pagination\n     text row.timezone,row.hours\n     ## Readable pre-booking notice (alert: nonempty readable-content suite, no\n     ## invocation children). content preserves the instruction paragraphs.\n     alert\n      content row.instructions\n      text row.cutoff\n     table row.WeeklyHours columns=weekday,opens,closes\n      pagination\n     table row.ClosedDay columns=day,reason\n      pagination\n     table row.Window columns=from,until,available order=from\n      pagination\n     list row.Type\n      pagination\n      text row.name,row.duration\n      ## book takes type from the row; customer/contact/from keep generated\n      ## controls (from is a datetime: no date-only calendar control applies).\n      form book\n   card \"Own appointments\"@{nl=\"Eigen afspraken\"}\n    ## Unbound tabs require nonempty captioned suites (GRAMMAR tabs_group). Both\n    ## tabs together show every appointment; both keep the full action set so a\n    ## verified customer can still resolve an old failed/unavailable row (a\n    ## read-only Past would strand retry_cleanup: the agenda is host-only).\n    ## now-bounded view predicates use the ordinary query grammar.\n    tabs\n     tab \"Upcoming\"@{nl=\"Aankomend\"}\n      table Appointment as visit where visit.from>=now columns=from,until,duration,state,reason order=from filter=state defaults={state=preferences.appointment_state} display=split\n       pagination\n       badge row.state\n       status row.host_ok\n       status row.room_ok\n       actions cancel,reschedule,discard_reschedule,retry_cleanup\n       collapse \"Appointment coordination\"@{nl=\"Afspraakafstemming\"}\n        text row.host_ok,row.room_ok,row.host_delivery,row.room_delivery\n        list row.Attempt columns=kind,from,until,state,host_ok,room_ok,host_unknown,room_unknown,host_released,room_released\n         pagination\n         badge row.state\n         button action=recover_attempt arguments={attempt=row}\n        list row.Notice columns=kind,state\n         pagination\n         badge row.state\n     tab \"Past\"@{nl=\"Verleden\"}\n      table Appointment as visit where visit.from<now columns=from,until,duration,state,reason order=from filter=state defaults={state=preferences.appointment_state} display=split\n       pagination\n       badge row.state\n       status row.host_ok\n       status row.room_ok\n       actions cancel,reschedule,discard_reschedule,retry_cleanup\n       collapse \"Appointment coordination\"@{nl=\"Afspraakafstemming\"}\n        text row.host_ok,row.room_ok,row.host_delivery,row.room_delivery\n        list row.Attempt columns=kind,from,until,state,host_ok,room_ok,host_unknown,room_unknown,host_released,room_released\n         pagination\n         badge row.state\n         button action=recover_attempt arguments={attempt=row}\n        list row.Notice columns=kind,state\n         pagination\n         badge row.state\n  # Maintain availability and record attendance under host grants. @{nl=\"Beheer beschikbaarheid en leg aanwezigheid vast binnen gastheerbevoegdheden.\"}\n  page /appointments/hosts title=\"Host calendars\"@{nl=\"Gastheerkalenders\"}\n   breadcrumbs\n   require host_manager\n   card \"Calendar intake\"@{nl=\"Kalender aanmaken\"}\n    form Calendar.create\n     input hours\n     textarea instructions\n   list Calendar display=split\n    pagination\n    card \"Calendar configuration\"@{nl=\"Kalenderinstellingen\"}\n     text row.location,row.timezone,row.hours,row.instructions,row.cutoff\n     ## edit keeps its canonical update schema; the suite only places the active\n     ## control first (UI-COMPONENTS Forms-and-field-placement; GRAMMAR edit_group).\n     edit\n      checkbox active\n    tabs\n     tab \"Weekly hours and holidays\"@{nl=\"Wekelijkse uren en feestdagen\"}\n      form WeeklyHours.create\n       input opens\n       input closes\n       radio fold\n      list row.WeeklyHours columns=weekday,opens,closes\n       pagination\n       edit\n       delete\n      form ClosedDay.create\n       calendar day\n       input reason\n      list row.ClosedDay columns=day,reason\n       pagination\n       edit\n       delete\n     tab \"Dated availability\"@{nl=\"Gedateerde beschikbaarheid\"}\n      ## Window bounds are datetimes: no date-only calendar control applies.\n      form Window.create\n      list row.Window order=from\n       pagination\n       edit\n     tab \"Appointment types\"@{nl=\"Afspraaktypen\"}\n      form Type.create\n       input name\n       input room\n      list row.Type\n       pagination\n       edit\n   card \"Appointment agenda\"@{nl=\"Afsprakenagenda\"}\n    calendar Appointment start=from end=until filter=state defaults={state=preferences.appointment_state}\n     pagination\n     badge row.state\n     status row.host_ok\n     status row.room_ok\n     text row.duration,row.reason\n     ## attendance takes the row; placed controls move the generated fields.\n     form attendance arguments={appointment=row}\n      checkbox attend\n      textarea reason\n     actions cancel,reschedule,discard_reschedule,retry_cleanup\n     history\n"}}
