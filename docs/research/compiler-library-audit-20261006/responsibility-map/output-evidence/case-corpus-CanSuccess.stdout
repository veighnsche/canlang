{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"a78666e05874007907f057871c41c9c0a153dc2cdcf190f7f13261b427d68b1e","before_projection_sha256":"a78666e05874007907f057871c41c9c0a153dc2cdcf190f7f13261b427d68b1e","changed":false,"idempotent":true,"structure_equal":true,"text":"# Help workspace account managers retain business customers by coordinating move-in, usage reviews, issues, and membership or agreement renewals. @{nl=\"Help werkplekklantbeheerders zakelijke klanten te behouden door ingebruikname, gebruiksbesprekingen, problemen en lidmaatschaps- of contractverlengingen te coördineren.\"}\napp CanSuccess uses=[success]\n\n# Track account milestones and private follow-up without treating tasks as paid renewal. @{nl=\"Volg klantmijlpalen en privéopvolging zonder taken als betaalde verlenging te behandelen.\"}\npackage success\n use customer {Customer,test_company}\n use agreements {Term as AgreementTerm,renew}\n use member_terms {Membership,Term as MembershipTerm,term}\n use rent_catalog {Location,test_site}\n use employee {can_work,test_worker}\n use std {DeliveryResult}\n use std {EmailV1 as Mail} from=deployment.mail\n Given\n  export contract WorkItem { reference:text, revision:int, location:text?, title:text, detail:text?, due:datetime?, action:action(complete) } label=\"Authorized work item\"@{nl=\"Toegestaan werkitem\"}\n  export contract WorkBatch { items:WorkItem[]! max=500 } label=\"Authorized work batch\"@{nl=\"Toegestane werkverzameling\"}\n  preferences { location:Location?, risk_filter:Account.risk? label=\"Initial risk filter\"@{nl=\"Eerste risicofilter\"} }\n  message label_account_manager = \"Account manager\"@{nl=\"Klantbeheerder\"}\n  message label_Milestone_completed_by = \"Completed by\"@{nl=\"Afgerond door\"}\n  message label_Milestone_completed_at = \"Completed at\"@{nl=\"Afgerond op\"}\n  message label_FollowUp = \"Follow-up\"@{nl=\"Opvolgtaak\"}\n  role account_manager label=label_account_manager\n  Account in Customer { location:Location, manager:user label=label_account_manager, email:email, renewal:date? label=\"Renewal date\"@{nl=\"Verlengingsdatum\"}, risk:enum(low,medium,high)=low label={text=\"Assessed renewal risk\"@{nl=\"Beoordeeld verlengingsrisico\"},values={low=\"Low\"@{nl=\"Laag\"},medium=\"Medium\"@{nl=\"Gemiddeld\"},high=\"High\"@{nl=\"Hoog\"}}}, reviewed_at:datetime? label=\"Last review\"@{nl=\"Laatste beoordeling\"}, reviewed_by:user? label=\"Reviewed by\"@{nl=\"Beoordeeld door\"}, risk_reason:text? label=\"Risk assessment reason\"@{nl=\"Reden voor risicobeoordeling\"}, notes:text?, agreement:AgreementTerm? label=\"Agreement reference\"@{nl=\"Overeenkomstreferentie\"}, membership:Membership? label=\"Membership reference\"@{nl=\"Lidmaatschapsreferentie\"}, active:bool=true } label=\"Customer account\"@{nl=\"Klantdossier\"}\n  Milestone in Account { title:text trim min=1, due:date, done:bool=false, completed_by:user? label=label_Milestone_completed_by, completed_at:datetime? label=label_Milestone_completed_at } label=\"Account milestone\"@{nl=\"Klantmijlpaal\"}\n  export FollowUp in Account { title:text, due:datetime, assignee:user label=\"Assignee\"@{nl=\"Toegewezen aan\"}, email:email, done:bool=false, completed_by:user? label=label_Milestone_completed_by, completed_at:datetime? label=label_Milestone_completed_at } label=label_FollowUp\n  Notice in Account { followup:FollowUp?, revision:int, account_revision:int, recipient:email, subject:text, body:text, delivery:delivery(Mail.send) } label=\"Reminder outcome\"@{nl=\"Herinneringsresultaat\"}\n  ## Notice state observes the Mail receipt; the existing Delivered caption renders succeeded.\n  derive Notice.state:DeliveryResult.status = row.delivery.status label={text=\"Delivery state\"@{nl=\"Bezorgstatus\"},values={pending=\"Pending\"@{nl=\"In afwachting\"},succeeded=\"Delivered\"@{nl=\"Bezorgd\"},failed=\"Failed\"@{nl=\"Mislukt\"},unknown=\"Unknown\"@{nl=\"Onbekend\"},skipped=\"Skipped\"@{nl=\"Overgeslagen\"}}}\n  policy Notice read=account_manager and can_work(actor,row.parent.location) fields=parent,followup,revision,account_revision,recipient,subject,body,delivery.id,delivery.status,state,created_by,created,updated_by,updated,archived_at\n  lock Notice fields=followup,revision,account_revision,recipient,subject,body,delivery\n  lock Milestone fields=title,due,done,completed_by,completed_at when=row.done\n  lock FollowUp fields=title,due,assignee,email,done,completed_by,completed_at when=row.done\n  event RenewalDue { account:Account, revision:int }\n  event FollowUpDue { followup:FollowUp, revision:int, account_revision:int }\n  derive Account.progress:decimal = count(row.Milestone as item where item.done)*100/max([1,count(row.Milestone)]) label=\"Milestone completion percentage\"@{nl=\"Percentage afgeronde mijlpalen\"}\n  policy Account read=account_manager and can_work(actor,row.location)\n  policy Milestone read=account_manager and can_work(actor,row.parent.location)\n  policy FollowUp read=account_manager and can_work(actor,row.parent.location)\n  invariant Account: row.risk==low or (row.risk_reason!=null and trim(row.risk_reason)!=\"\")\n  invariant Account: (row.agreement==null or (row.agreement.parent.customer==row.parent and row.agreement.parent.location==row.location)) and (row.membership==null or row.membership.parent==row.parent)\n  derive Account.completed:int = count(row.Milestone as item where item.done) label=\"Completed milestones\"@{nl=\"Afgeronde mijlpalen\"}\n  derive Account.total:int = count(row.Milestone) label=\"Total milestones\"@{nl=\"Totaal mijlpalen\"}\n  fixture managed=Account {parent=test_company,location=test_site,manager=self,email=\"manager@example.test\"}\n  fixture followup=FollowUp {parent=managed,title=\"Renewal conversation\",due=datetime(\"2099-01-01T09:00:00Z\"),assignee=self,email=\"manager@example.test\"}\n When\n  crud Account by=account_manager fields=manager,email,renewal,risk,risk_reason,notes,agreement,membership,active create_fields=location,manager,email,renewal,risk,risk_reason,notes,agreement,membership when=can_work(actor,row.location) and account_manager(row.manager) and can_work(row.manager,row.location) delete=none\n  crud Milestone by=account_manager fields=title,due when=can_work(actor,row.parent.location) and row.parent.active and not row.done\n  crud FollowUp by=account_manager fields=title,due,assignee,email when=can_work(actor,row.parent.location) and row.parent.active and not row.done and account_manager(row.assignee) and can_work(row.assignee,row.parent.location) delete=none\n  # Complete a current account milestone with attribution. @{nl=\"Rond een huidige klantmijlpaal met toeschrijving af.\"}\n  scenario milestone(milestone:Milestone) by=account_manager label=\"Complete milestone\"@{nl=\"Mijlpaal afronden\"}\n   require can_work(actor,milestone.parent.location) and milestone.parent.active and not milestone.done\n   do set milestone {done=true,completed_by=actor,completed_at=now}\n  # Complete a follow-up without renewing the underlying paid term. @{nl=\"Rond een opvolgtaak af zonder de onderliggende betaalde periode te verlengen.\"}\n  export scenario complete(followup:FollowUp label=label_FollowUp) by=account_manager\n   require can_work(actor,followup.parent.location) and followup.parent.active and not followup.done\n   do\n    set followup {done=true,completed_by=actor,completed_at=now}\n    cancel followup.id\n   examples seed=[test_worker] followup=followup\n    as,followup.done -> followup.done\n    account_manager,false -> true\n    account_manager,true -> error(rule_failed)\n    members,false -> error(forbidden)\n  # Reassign open follow-ups to an active manager and its entered delivery destination. @{nl=\"Wijs open opvolgtaken opnieuw toe aan een actieve beheerder en diens ingevoerde verzendbestemming.\"}\n  scenario reassign(account:Account,manager:user label=label_account_manager,email:email) by=account_manager label=\"Reassign account\"@{nl=\"Klantdossier opnieuw toewijzen\"}\n   require can_work(actor,account.location) and account_manager(manager) and can_work(manager,account.location)\n   do\n    set account {manager,email}\n    cancel account.id\n    if account.active and account.renewal!=null\n     let due=local_instant(account.renewal,\"00:00\",account.location.timezone,fold=earlier)\n     if due>now\n      schedule account.id at=due event=RenewalDue {account,revision=account.version+1}\n    for followup in account.FollowUp as item where not item.done limit=100\n     set followup {assignee=manager,email}\n     cancel followup.id\n     if account.active and followup.due>now\n      schedule followup.id at=followup.due event=FollowUpDue {followup,revision=followup.version+1,account_revision=account.version+1}\n  scenario arm on=FollowUp.create\n   do\n    if event.after.parent.active and not event.after.done and event.after.due>now\n     schedule event.after.id at=event.after.due event=FollowUpDue {followup=event.after,revision=event.after.version,account_revision=event.after.parent.version}\n  scenario reschedule on=FollowUp.update\n   do\n    cancel event.after.id\n    if event.after.parent.active and not event.after.done and event.after.due>now\n     schedule event.after.id at=event.after.due event=FollowUpDue {followup=event.after,revision=event.after.version,account_revision=event.after.parent.version}\n  scenario account_created on=Account.create\n   do\n    if event.after.active and event.after.renewal!=null\n     let due=local_instant(event.after.renewal,\"00:00\",event.after.location.timezone,fold=earlier)\n     if due>now\n      schedule event.after.id at=due event=RenewalDue {account=event.after,revision=event.after.version}\n  scenario account_changed on=Account.update\n   do\n    cancel event.after.id\n    if event.after.active and event.after.renewal!=null\n     let due=local_instant(event.after.renewal,\"00:00\",event.after.location.timezone,fold=earlier)\n     if due>now\n      schedule event.after.id at=due event=RenewalDue {account=event.after,revision=event.after.version}\n    for followup in event.after.FollowUp as item where not item.done limit=100\n     cancel followup.id\n     if event.after.active and followup.due>now\n      schedule followup.id at=followup.due event=FollowUpDue {followup,revision=followup.version,account_revision=event.after.version}\n  scenario remind on=FollowUpDue\n   require event.followup.version==event.revision and event.followup.parent.version==event.account_revision and not event.followup.done and event.followup.parent.active\n   do\n    if account_manager(event.followup.assignee) and can_work(event.followup.assignee,event.followup.parent.location) and event.followup.due<=now\n     let subject=format(\"Account follow-up\"@{nl=\"Klantopvolging\"},locale=null)\n     send Mail.send {to=event.followup.email,subject,body=event.followup.title} when=event.followup.version==event.revision and event.followup.parent.version==event.account_revision and not event.followup.done and event.followup.parent.active and account_manager(event.followup.assignee) and can_work(event.followup.assignee,event.followup.parent.location) as notice\n     create Notice {parent=event.followup.parent,followup=event.followup,revision=event.revision,account_revision=event.account_revision,recipient=event.followup.email,subject,body=event.followup.title,delivery=notice} as outcome\n  # Remind the current manager at the location's renewal-date boundary without renewing paid terms. @{nl=\"Herinner de huidige beheerder op de lokale verlengingsdatum zonder betaalde voorwaarden te verlengen.\"}\n  scenario renewal_due on=RenewalDue\n   require event.account.version==event.revision and event.account.active and event.account.renewal!=null\n   do\n    if account_manager(event.account.manager) and can_work(event.account.manager,event.account.location) and local_instant(event.account.renewal,\"00:00\",event.account.location.timezone,fold=earlier)<=now\n     let subject=format(\"Account renewal due\"@{nl=\"Klantverlenging nodig\"},locale=null)\n     let body=format(\"Review the recorded renewal date; renewal remains a separate agreement action.\"@{nl=\"Controleer de vastgelegde verlengingsdatum; verlenging blijft een afzonderlijke overeenkomstactie.\"},locale=null)\n     send Mail.send {to=event.account.email,subject,body} when=event.account.version==event.revision and event.account.active and account_manager(event.account.manager) and can_work(event.account.manager,event.account.location) as notice\n     create Notice {parent=event.account,revision=event.revision,account_revision=event.revision,recipient=event.account.email,subject,body,delivery=notice} as outcome\n  # Record when a manager last reviewed the account, without changing a source agreement or paid term. @{nl=\"Leg vast wanneer een beheerder het dossier laatst beoordeelde zonder een bronovereenkomst of betaalde termijn te wijzigen.\"}\n  scenario review(account:Account) by=account_manager label=\"Record account review\"@{nl=\"Dossierbeoordeling vastleggen\"}\n   require can_work(actor,account.location) and account.active\n   do\n    set account {reviewed_at=now,reviewed_by=actor}\n    cancel account.id\n    if account.renewal!=null\n     let due=local_instant(account.renewal,\"00:00\",account.location.timezone,fold=earlier)\n     if due>now\n      schedule account.id at=due event=RenewalDue {account,revision=account.version+1}\n    for followup in account.FollowUp as item where not item.done limit=100\n     cancel followup.id\n     if followup.due>now\n      schedule followup.id at=followup.due event=FollowUpDue {followup,revision=followup.version,account_revision=account.version+1}\n   examples seed=[test_worker] account=managed\n    as,account.active -> account.reviewed_by,account.reviewed_at\n    account_manager,true -> self,now\n    account_manager,false -> error(rule_failed)\n    members,true -> error(forbidden)\n  # Return only current eligible work under the canonical completion authority. @{nl=\"Geef alleen actueel uitvoerbaar werk terug binnen de canonieke afrondingsbevoegdheid.\"}\n  export scenario work(locations:text[]) read=true scope=authority -> WorkBatch by=account_manager\n   do return WorkBatch {items=FollowUp as item where (can_work(actor,item.parent.location) and item.parent.active and not item.done) and (count(locations)==0 or item.parent.location.id in locations) select WorkItem {reference=item.id,revision=item.version,location=item.parent.location.id,title=item.title,detail=null,due=item.due,action=action(complete,{followup=item})}}\n  # Revalidate the selected item before presenting its protected canonical action. @{nl=\"Controleer het gekozen item opnieuw voordat de beschermde canonieke actie wordt getoond.\"}\n  export scenario work_detail(record:FollowUp) read=true scope=authority -> WorkItem by=account_manager\n   require can_work(actor,record.parent.location) and record.parent.active and not record.done\n   do return WorkItem {reference=record.id,revision=record.version,location=record.parent.location.id,title=record.title,detail=null,due=record.due,action=action(complete,{followup=record})}\n Then\n  # Review renewal risk, dated milestones and source agreement references. @{nl=\"Beoordeel verlengingsrisico, gedateerde mijlpalen en bronreferenties naar overeenkomsten.\"}\n  page /customer-success title=\"Customer success\"@{nl=\"Klantopvolging\"}\n   require account_manager\n   breadcrumbs\n   card \"Customer selection\"@{nl=\"Klantselectie\"}\n    list Customer empty=\"No customers found\"@{nl=\"Geen klanten gevonden\"}\n     form Account.create\n      select location\n      input email\n      calendar renewal\n      radio risk\n      textarea risk_reason\n      textarea notes\n      ## parent binds the enclosing customer row.\n      ## manager, agreement and membership keep their generated authorized pickers.\n     pagination\n   card \"Overdue follow-ups\"@{nl=\"Achterstallige opvolgtaken\"}\n    table FollowUp as followup where not followup.done and followup.parent.active and followup.due<=now columns=parent,title,due,assignee order=due empty=\"No overdue follow-ups\"@{nl=\"Geen achterstallige opvolgtaken\"}\n     action complete\n     pagination\n   card \"Renewal portfolio\"@{nl=\"Verlengingsportefeuille\"}\n    list Account filter=location,manager,risk,active defaults={location=preferences.location,risk=preferences.risk_filter} order=renewal display=split empty=\"No accounts found\"@{nl=\"Geen dossiers gevonden\"}\n     badge row.risk\n     text row.renewal,row.active,row.risk_reason,row.agreement,row.membership\n     edit\n     radial_progress row.progress max=100\n     stat row.completed,row.total\n     text row.reviewed_at,row.reviewed_by\n     tooltip \"Record that you reviewed this account\"@{nl=\"Vastleggen dat je dit dossier hebt beoordeeld\"}\n      action review\n     button opens=reassign\n     modal \"Reassign account\"@{nl=\"Klantdossier opnieuw toewijzen\"} id=reassign\n      slot content\n       form reassign arguments={account=row} display=inline\n        input email\n        ## account binds the enclosing row; manager keeps its authorized picker.\n     alert\n      require row.risk==high\n      text row.risk_reason\n     collapse \"Risk assessment and source references\"@{nl=\"Risicobeoordeling en bronreferenties\"}\n      text row.notes\n     tabs\n      tab \"Source agreement\"@{nl=\"Bronovereenkomst\"}\n       require row.agreement!=null\n       text row.agreement\n       form renew(term=row.agreement)\n      tab \"Source membership\"@{nl=\"Bronlidmaatschap\"}\n       require row.membership!=null\n       text row.membership\n       form term(membership=row.membership)\n       table row.membership.Term columns=from,until,paid,collection,cancellation order=-from empty=\"No terms found\"@{nl=\"Geen voorwaarden gevonden\"}\n        pagination\n      tab \"Reminder delivery\"@{nl=\"Herinneringsbezorging\"}\n       table row.Notice columns=followup,recipient,state,created order=-created empty=\"No reminders sent\"@{nl=\"Geen herinneringen verzonden\"}\n        status row.state\n        pagination\n      tab \"Account milestones\"@{nl=\"Klantmijlpalen\"}\n       form Milestone.create\n        input title\n        calendar due\n        ## parent binds the enclosing account row.\n       table row.Milestone columns=title,due,done order=due filter=done empty=\"No milestones yet\"@{nl=\"Nog geen mijlpalen\"}\n        edit\n        action milestone\n        pagination\n      tab \"Dated follow-ups\"@{nl=\"Gedateerde opvolgtaken\"}\n       form FollowUp.create\n        input title\n        input email\n        input due\n        ## parent binds the enclosing row; assignee keeps its authorized picker.\n       table row.FollowUp columns=title,due,assignee,done order=due filter=done empty=\"No follow-ups yet\"@{nl=\"Nog geen opvolgtaken\"}\n        edit\n        action complete\n        pagination\n     history\n     pagination\n"}}
