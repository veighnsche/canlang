{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"2b8fe16a60a32300d149302c0e667bb203f98ae1fb6bfed7a17af981ae6bc4d2","before_projection_sha256":"2b8fe16a60a32300d149302c0e667bb203f98ae1fb6bfed7a17af981ae6bc4d2","changed":true,"idempotent":true,"structure_equal":true,"text":"# Be the workspace operator's authoritative booking app for coworking desks, day offices, meeting rooms, and rentable event spaces. @{nl=\"Wees de gezaghebbende reserveringsapp van de werkplekexploitant voor coworkingbureaus, dagkantoren, vergaderruimtes en verhuurbare evenementruimtes.\"}\napp CanRent uses=[rent_catalog,rent_catalog_ui,rent_reservations,rent_fulfillment,rent_reporting]\n\n# Reserve workspace and manage paid membership benefits with scoped operational reports. @{nl=\"Reserveer werkplekken en beheer betaalde lidmaatschapsvoordelen met afgebakende operationele rapporten.\"}\napp Workspace uses=[CanRent,CanMember,CanReport]\n\n# Maintain the published workspace catalog under the canonical catalog owner's grant. @{nl=\"Onderhoud de gepubliceerde werkplekcatalogus onder de bevoegdheid van de canonieke catalogusbeheerder.\"}\npackage rent_catalog_ui\n use rent_catalog {Location,WeeklyHours,ClosedDate,DateHours,catalog_owner}\n Given\n  preferences { arrival_open:bool=false label=\"Show arrival instructions\"@{nl=\"Aankomstinstructies tonen\"} }\n When\n Then\n  # Author location descriptions and arrival information. @{nl=\"Schrijf locatiebeschrijvingen en aankomstinformatie.\"}\n  page /workspace/catalog title=\"Workspace catalog\"@{nl=\"Werkplekcatalogus\"} order=6\n   require catalog_owner\n   breadcrumbs\n   ## Inline view of the owning bool preference; shared dialog stays canonical. UC prefs panel + toggle.\n   preferences\n    toggle arrival_open\n   card \"Location catalog\"@{nl=\"Locatiecatalogus\"}\n    form Location.create\n     fieldset\n      input name\n      textarea address\n      input timezone\n      input currency\n      input hours\n      textarea arrival\n    table Location columns=name,address,timezone,currency,hours empty=\"No locations yet\"@{nl=\"Nog geen locaties\"}\n     text row.active\n     edit\n      fieldset\n       checkbox active\n       textarea arrival\n     collapse \"Arrival information\"@{nl=\"Aankomstinformatie\"} open=preferences.arrival_open\n      text row.arrival\n     form WeeklyHours.create\n      fieldset\n       input weekday\n       input opens\n       input closes\n       input close_after\n       radio fold\n     table row.WeeklyHours columns=weekday,opens,closes,close_after empty=\"No weekly hours yet\"@{nl=\"Nog geen weekopeningstijden\"}\n      edit\n      pagination\n     form ClosedDate.create\n      fieldset\n       calendar day\n       textarea reason\n     table row.ClosedDate columns=day,reason empty=\"No closed dates yet\"@{nl=\"Nog geen sluitingsdagen\"}\n      edit\n      pagination\n     form DateHours.create\n      fieldset\n       calendar day\n       input opens\n       input closes\n       input close_after\n       checkbox closed\n       radio fold\n     table row.DateHours columns=day,opens,closes,close_after,closed empty=\"No date hours yet\"@{nl=\"Nog geen datumtijden\"}\n      edit\n      pagination\n     history\n     pagination\n\n# Coordinate capacity, buffers, holds and downtime at each resource's single owner. @{nl=\"Coördineer capaciteit, buffers, tijdelijke reserveringen en uitval bij de enige eigenaar van elke voorziening.\"}\npackage rent_reservations label=\"Workspace reservations\"@{nl=\"Werkplekreserveringen\"}\n use rent_catalog {Location,WeeklyHours,ClosedDate,DateHours,LocationPolicy,policy_open,is_open,catalog_owner,test_site,open_site,sunday_site,recorded_site}\n use employee {Employee,can_work,test_worker}\n use customer {Customer,BillingProfile,owns,has_location_role,test_company,test_admin,test_booker}\n use invoice {finance}\n use invoice {BillingV1 as Billing,DocumentLine,Settlement,Charge,SaleMilestone} from=deployment.billing\n use member_terms {MembershipV1 as Membership,Entitlement,BenefitInterval,AllowanceOutcome} from=deployment.membership\n use propose {QuoteOffer,AcceptedOffer,QuoteDocument,quote_intervals_valid}\n use sales_attribution {Capture,latest_capture}\n use report {ReportBatch,Checkpoint,Contribution}\n use std {OperationOutcome,DeliveryResult}\n use std {EmailV1 as Mail} from=deployment.mail\n Given\n  preferences { location:Location? }\n  message policy_title = \"Commercial policy and access\"@{nl=\"Commerciële voorwaarden en toegang\"}\n  message label_RoomRequest_source = \"Source reference\"@{nl=\"Bronreferentie\"}\n  message label_RoomRequest_account = \"User account\"@{nl=\"Gebruikersaccount\"}\n  message label_RoomRequest_from = \"From\"@{nl=\"Van\"}\n  message label_RoomRequest_until = \"Until\"@{nl=\"Tot\"}\n  message label_RoomRequest_terms = \"Commercial terms\"@{nl=\"Commerciële voorwaarden\"}\n  message label_Booking_status_pending = \"Pending\"@{nl=\"In afwachting\"}\n  message label_hold_use_allowance = \"Use membership allowance\"@{nl=\"Lidmaatschapstegoed gebruiken\"}\n  export contract RoomRequest { source:text label=label_RoomRequest_source, revision:int=1, resource:text label=\"Resource reference\"@{nl=\"Voorzieningsreferentie\"}, customer:text label=\"Customer reference\"@{nl=\"Klantreferentie\"}, account:user label=label_RoomRequest_account, from:datetime label=label_RoomRequest_from, until:datetime label=label_RoomRequest_until, quantity:int, price:money?, terms:text? label=label_RoomRequest_terms } label=\"Workspace request\"@{nl=\"Werkplekaanvraag\"}\n  export capability RoomsV1 version=1\n   hold(value:RoomRequest) -> OperationOutcome\n   stage(value:RoomRequest,previous_source:text,previous_revision:int) -> OperationOutcome\n   hold_offer(value:QuoteOffer) -> ReservationOfferOutcome\n   accept_offer(value:AcceptedOffer) -> ReservationOfferOutcome\n   release_offer(source:text,revision:int,resource:text,reason:text) -> ReservationOfferOutcome\n   confirm(source:text,resource:text) -> OperationOutcome\n   move(value:RoomRequest) -> OperationOutcome\n   release(source:text,resource:text,reason:text) -> OperationOutcome\n   affected(source:text,resource:text) -> AffectedBookings\n   downtime(source:text,resource:text,from:datetime,until:datetime?) -> OperationOutcome\n   restore(source:text,resource:text,evidence:text) -> OperationOutcome\n   event changed { value:OperationOutcome }\n   event offer_changed { value:ReservationOfferOutcome }\n  export contract AffectedBooking { reference:text, revision:int, from:datetime, until:datetime, quantity:int, status:Booking.status, conflict:text? } label=\"Affected reservation\"@{nl=\"Getroffen reservering\"}\n  export contract AffectedBookings { source:text, resource:text, revision:int, checked_at:datetime, items:AffectedBooking[] } label=\"Affected reservations snapshot\"@{nl=\"Momentopname getroffen reserveringen\"}\n  export event AffectedOutcome { value:AffectedBookings }\n  export contract ReservationOfferOutcome { source:text, revision:int, kind:enum(hold,booking,release) label={text=\"Kind\"@{nl=\"Soort\"},values={hold=\"Temporary hold\"@{nl=\"Tijdelijke reservering\"},booking=\"Booking\"@{nl=\"Boeking\"},release=\"Release\"@{nl=\"Vrijgave\"}}}, version:int, state:enum(pending,confirmed,unavailable,failed,unknown,released) label={text=\"State\"@{nl=\"Status\"},values={pending=\"Pending\"@{nl=\"In behandeling\"},confirmed=\"Confirmed\"@{nl=\"Bevestigd\"},unavailable=\"Unavailable\"@{nl=\"Niet beschikbaar\"},failed=\"Failed\"@{nl=\"Mislukt\"},unknown=\"Unknown\"@{nl=\"Onbekend\"},released=\"Released\"@{nl=\"Vrijgegeven\"}}}, reference:text?, detail:text?, invoice:text?, expires:datetime? } label=\"Quote reservation outcome\"@{nl=\"Offerte-reserveringsresultaat\"}\n  export capability RoomsIngressV1 version=1\n   event move { value:RoomRequest }\n   event affected { source:text, resource:text }\n   event downtime { source:text, resource:text, from:datetime, until:datetime? }\n   event restore { source:text, resource:text, evidence:text }\n   event hold { value:RoomRequest }\n   event stage { value:RoomRequest, previous_source:text, previous_revision:int }\n   event confirm { source:text, resource:text }\n   event release { source:text, resource:text, reason:text }\n   event hold_offer { value:QuoteOffer }\n   event accept_offer { value:AcceptedOffer }\n   event release_offer { source:text, revision:int, resource:text, reason:text }\n  export event VenueOutcome { value:OperationOutcome }\n  export event OfferOutcome { value:ReservationOfferOutcome }\n  VenueReservation in Resource { source:text unique, request_revision:int=1, customer:text, account:user, from:datetime, until:datetime, quantity:int min=1, expires:datetime, status:enum(held,staged,confirmed,released,expired)=held label={text=\"Status\"@{nl=\"Status\"},values={held=\"Held\"@{nl=\"Tijdelijk gereserveerd\"},staged=\"Staged\"@{nl=\"Voorbereid\"},confirmed=\"Confirmed\"@{nl=\"Bevestigd\"},released=\"Released\"@{nl=\"Vrijgegeven\"},expired=\"Expired\"@{nl=\"Verlopen\"}}}, previous:VenueReservation?, reason:text? } label=\"Appointment venue reservation\"@{nl=\"Afspraakruimtereservering\"}\n  ReservationFence in Resource { source:text, revision:int, reason:text, offer:AcceptedOffer? } label=\"Closed quote revision\"@{nl=\"Afgesloten offerteversie\"}\n  unique ReservationFence fields=source,revision\n  lock ReservationFence fields=source,revision,reason,offer\n  DowntimeFence in Resource { source:text unique, evidence:text }\n  VenueFence in Resource { source:text unique, reason:text } label=\"Cancelled venue request\"@{nl=\"Geannuleerde ruimteaanvraag\"}\n  QuoteHold in Resource { source:text unique, revision:int, offer:QuoteOffer, quantity:int min=1, from:datetime, until:datetime, intervals:BookingInterval[], expires:datetime, active:bool=true, booking:Booking? } label=\"Quoted capacity hold\"@{nl=\"Offertecapaciteitsreservering\"}\n  event VenueDue { venue:VenueReservation }\n  event QuoteDue { hold:QuoteHold }\n  export role reservation_manager label=\"Reservation manager\"@{nl=\"Reserveringsbeheerder\"}\n  export role reception label=\"Reception\"@{nl=\"Receptie\"}\n  role billing label=\"Billing\"@{nl=\"Facturatie\"}\n  contract LegacyBookingFacts { customer_source:text? label=\"Original customer system\"@{nl=\"Oorspronkelijk klantsysteem\"}, customer_external_id:text? label=\"Original customer key\"@{nl=\"Oorspronkelijke klantsleutel\"}, resource_source:text? label=\"Original resource system\"@{nl=\"Oorspronkelijk voorzieningensysteem\"}, resource_external_id:text? label=\"Original resource key\"@{nl=\"Oorspronkelijke voorzieningssleutel\"}, actor:text? label=\"Original booker\"@{nl=\"Oorspronkelijke boeker\"}, from_original:text? label=\"Original start timestamp\"@{nl=\"Oorspronkelijke begintijd\"}, until_original:text? label=\"Original end timestamp\"@{nl=\"Oorspronkelijke eindtijd\"}, from:datetime? label=\"Parsed start instant\"@{nl=\"Geparst begintijdstip\"}, until:datetime? label=\"Parsed end instant\"@{nl=\"Geparst eindtijdstip\"}, status:text? label=\"Original status\"@{nl=\"Oorspronkelijke status\"}, payment:text? label=\"Original payment status\"@{nl=\"Oorspronkelijke betaalstatus\"}, quantity:int? label=\"Original quantity\"@{nl=\"Oorspronkelijk aantal\"}, amount:money? label=\"Original amount\"@{nl=\"Oorspronkelijk bedrag\"} } label=\"Original booking facts\"@{nl=\"Oorspronkelijke reserveringsgegevens\"}\n  ## Original assertions are locked evidence; current mappings grant no live reservation.\n  export LegacyBooking { source:text trim min=1 label=\"Source system\"@{nl=\"Bronsysteem\"}, external_id:text min=1 label=\"Original record key\"@{nl=\"Oorspronkelijke recordsleutel\"}, location:Location label=\"Current location scope\"@{nl=\"Huidig locatiebereik\"}, facts:LegacyBookingFacts label=\"Original booking facts\"@{nl=\"Oorspronkelijke reserveringsgegevens\"}, source_evidence:file label=\"Original source artifact\"@{nl=\"Oorspronkelijk bronbestand\"}, attestation:text trim min=1 label=\"Intake attestation\"@{nl=\"Verklaring bij invoer\"}, customer:Customer? label=\"Current customer\"@{nl=\"Huidige klant\"}, resource:Resource? label=\"Current resource\"@{nl=\"Huidige voorziening\"}, account:user? label=\"Current account\"@{nl=\"Huidig account\"}, mapping_reason:text? label=\"Review reason\"@{nl=\"Reden voor beoordeling\"}, imported_by:user server=actor label=\"Imported by\"@{nl=\"Ingevoerd door\"}, imported_at:datetime server=now label=\"Imported at\"@{nl=\"Ingevoerd op\"} } label=\"Historical booking\"@{nl=\"Historische reservering\"}\n  unique LegacyBooking fields=source,external_id\n  lock LegacyBooking fields=source,external_id,location,facts,source_evidence,attestation,imported_by,imported_at\n  policy LegacyBooking read=(reservation_manager or finance) and can_work(actor,row.location)\n  policy LegacyBooking read=authenticated where=row.account==actor and row.customer!=null and (owns(actor,row.customer) or has_location_role(actor,row.customer,booker,row.location)) fields=source,external_id,location,facts,customer,resource\n  invariant LegacyBooking: (row.facts.customer_source==null)==(row.facts.customer_external_id==null) and (row.facts.resource_source==null)==(row.facts.resource_external_id==null)\n  export fixture history_user=user {roles=[reservation_manager,finance]}\n  export fixture history_worker=Employee {user=history_user,home=test_site,locations=[test_site],start=date(\"2026-10-01\"),role=\"Historical evidence steward\"}\n  export fixture legacy_source=file {owner=history_user}\n  export fixture legacy_booking=LegacyBooking {source=\"vendor-w\",external_id=\"B-17\",location=test_site,facts={customer_source=\"vendor-w\",customer_external_id=\"C-9\",resource_source=\"vendor-w\",resource_external_id=\"R-2\",actor=\"Former booker\",from_original=\"2021-05-12 09:00\",until_original=\"2021-05-12 10:00\",status=\"Completed\",payment=\"Paid\",amount=money(1000,\"EUR\")},source_evidence=legacy_source,attestation=\"Original export retained; local-time offset unknown\"}\n  contract WorkspaceAvailability { resource:Resource, from:datetime, until:datetime, quantity:int, attendees:int, available:bool label={text=\"Availability\"@{nl=\"Beschikbaarheid\"},values={true=\"Available\"@{nl=\"Beschikbaar\"},false=\"Unavailable\"@{nl=\"Niet beschikbaar\"}}}, total:money, terms:text, refund_before:datetime }\n  contract DayAvailability { resource:Resource, start:date, end:date, quantity:int, attendees:int, available:bool label={text=\"Availability\"@{nl=\"Beschikbaarheid\"},values={true=\"Available\"@{nl=\"Beschikbaar\"},false=\"Unavailable\"@{nl=\"Niet beschikbaar\"}}}, total:money, terms:text }\n  contract BookingInterval { from:datetime, until:datetime }\n  export Resource { location:Location, name:text trim min=1, pooled:bool=false label=\"Shared capacity\"@{nl=\"Gedeelde capaciteit\"}, capacity:int=1 min=1 label=\"Capacity\"@{nl=\"Capaciteit\"}, party_limit:int=1 min=1 label=\"Attendee limit\"@{nl=\"Deelnemerslimiet\"}, kind:enum(desk,office,meeting,event_space)=meeting label={text=\"Resource type\"@{nl=\"Voorzieningstype\"},values={desk=\"Desk\"@{nl=\"Bureau\"},office=\"Office\"@{nl=\"Kantoor\"},meeting=\"Meeting room\"@{nl=\"Vergaderruimte\"},event_space=\"Event space\"@{nl=\"Evenementruimte\"}}}, hold_for:duration=15m label=\"Hold duration\"@{nl=\"Duur tijdelijke reservering\"}, active:bool=true, timezone:timezone, currency:currency, tax_rate:decimal=0 min=0 max=1 label=\"Tax fraction\"@{nl=\"Belastingfractie\"}, discount_rate:decimal=0 min=0 max=1 label=\"Discount fraction\"@{nl=\"Kortingsfractie\"}, cancellation_fee:money? label=\"Cancellation fee\"@{nl=\"Annuleringskosten\"}, hourly:money label=\"Hourly rate\"@{nl=\"Uurtarief\"}, daily:money? label=\"Day rate\"@{nl=\"Dagtarief\"}, price_unit:enum(hour,day)=hour label={text=\"Price unit\"@{nl=\"Prijseenheid\"},values={hour=\"Hour\"@{nl=\"Uur\"},day=\"Day\"@{nl=\"Dag\"}}}, increment:duration=1h label=\"Booking increment\"@{nl=\"Reserveringsstap\"}, minimum:duration=1h label=\"Minimum duration\"@{nl=\"Minimumduur\"}, terms:text label=label_RoomRequest_terms, refund_notice:duration label=\"Refund notice period\"@{nl=\"Termijn voor terugbetaling\"}, buffer_before:duration=0m label=\"Buffer before\"@{nl=\"Buffer vooraf\"}, buffer_after:duration=0m label=\"Buffer after\"@{nl=\"Buffer achteraf\"}, amenities:text[] label=\"Amenities\"@{nl=\"Voorzieningen\"}, accessibility:text label=\"Accessibility\"@{nl=\"Toegankelijkheid\"} } label=\"Workspace resource\"@{nl=\"Werkplekvoorziening\"}\n  DayCalendar in Resource { day:date unique, opens:text=\"09:00\", closes:text=\"18:00\", closed:bool=false, fold:enum(earlier,later)=earlier label={text=\"Repeated local time\"@{nl=\"Herhaalde lokale tijd\"},values={earlier=\"Earlier occurrence\"@{nl=\"Eerdere tijd\"},later=\"Later occurrence\"@{nl=\"Latere tijd\"}}} } label=\"Published day access\"@{nl=\"Gepubliceerde dagtoegang\"}\n  Window in Resource { from:datetime label=label_RoomRequest_from, until:datetime label=label_RoomRequest_until, closed:bool=false label=\"Closed\"@{nl=\"Gesloten\"}, reason:text? } label=\"Availability window\"@{nl=\"Beschikbaarheidsvenster\"}\n  export Booking in Resource { billing_location:Location?, sale_product:text?, purchased_at:datetime?, attribution:text?, exclusive_program:text?, attributed_at:datetime?, attribution_window:duration?, customer:Customer label=\"Customer\"@{nl=\"Klant\"}, account:user label=label_RoomRequest_account, email:email, from:datetime label=label_RoomRequest_from, until:datetime label=label_RoomRequest_until, approval:BillingProfile? label=\"Invoice account approval\"@{nl=\"Goedkeuring factuuraccount\"}, approval_version:int? label=\"Approval revision\"@{nl=\"Goedkeuringsrevisie\"}, fulfillment_reason:text? label=\"Fulfillment reason\"@{nl=\"Uitvoeringsreden\"}, quote:AcceptedOffer? label=\"Accepted quote snapshot\"@{nl=\"Geaccepteerde offertesnapshot\"}, benefit_intervals:BenefitInterval[], benefit_rate:money?, benefit_unit:enum(hour,day)=hour label={text=\"Allowance unit\"@{nl=\"Tegoedeenheid\"},values={hour=\"Hour\"@{nl=\"Uur\"},day=\"Day\"@{nl=\"Dag\"}}}, benefit_duration:duration=1h, arrival_buffer:duration=0m, monetary_due:money? label=\"Original monetary obligation\"@{nl=\"Oorspronkelijke betalingsverplichting\"}, service_due:money? label=\"Current service balance\"@{nl=\"Huidig uitvoeringssaldo\"}, allowance_base:money?, allowance_discount:money?, allowance_tax:money?, allowance_units:decimal? label=\"Requested units\"@{nl=\"Aangevraagde eenheden\"}, included_units:decimal? label=\"Included units\"@{nl=\"Inbegrepen eenheden\"}, allowance_source:text?, allowance_revision:int=0, allowance_reconcile_delivery:text?, original_intervals:BookingInterval[], intervals:BookingInterval[] label=\"Frozen access intervals\"@{nl=\"Vastgelegde toegangstijdvakken\"}, quantity:int=1 min=1, attendees:int=1 min=1 label=\"Attendees\"@{nl=\"Deelnemers\"}, tax_fraction:decimal=0, discount_fraction:decimal=0, subtotal:money label=\"Subtotal\"@{nl=\"Subtotaal\"}, tax:money label=\"Frozen tax\"@{nl=\"Vastgelegde belasting\"}, discount:money label=\"Frozen discount\"@{nl=\"Vastgelegde korting\"}, refund_amount:money label=\"Refundable amount\"@{nl=\"Terugbetaalbaar bedrag\"}, refund_requested:money? label=\"Requested refund amount\"@{nl=\"Aangevraagd terugbetalingsbedrag\"}, rate:money label=\"Frozen rate\"@{nl=\"Vastgelegd tarief\"}, total:money, terms:text label=label_RoomRequest_terms, refund_before:datetime label=\"Refund deadline\"@{nl=\"Terugbetalingsdeadline\"}, reserved_from:datetime label=\"Capacity reserved from\"@{nl=\"Capaciteit gereserveerd vanaf\"}, reserved_until:datetime label=\"Capacity reserved until\"@{nl=\"Capaciteit gereserveerd tot\"}, expires:datetime label=\"Expires at\"@{nl=\"Verloopt op\"}, status:enum(held,pending,confirmed,occupied,completed,cancelled,expired,review,no_show)=held label={text=\"Status\"@{nl=\"Status\"},values={held=\"Held\"@{nl=\"Tijdelijk gereserveerd\"},pending=label_Booking_status_pending,confirmed=\"Confirmed\"@{nl=\"Bevestigd\"},occupied=\"Occupied\"@{nl=\"In gebruik\"},completed=\"Completed\"@{nl=\"Afgerond\"},cancelled=\"Cancelled\"@{nl=\"Geannuleerd\"},expired=\"Expired\"@{nl=\"Verlopen\"},review=\"Review required\"@{nl=\"Beoordeling nodig\"},no_show=\"No-show\"@{nl=\"Niet verschenen\"}}}, payment:enum(unpaid,pending,unknown,paid,refunded,free,on_account)=unpaid label={text=\"Payment outcome\"@{nl=\"Betaalresultaat\"},values={pending=label_Booking_status_pending,unpaid=\"Unpaid\"@{nl=\"Onbetaald\"},unknown=\"Unknown\"@{nl=\"Onbekend\"},paid=\"Paid\"@{nl=\"Betaald\"},refunded=\"Refunded\"@{nl=\"Terugbetaald\"},free=\"Included or free\"@{nl=\"Inbegrepen of gratis\"},on_account=\"On approved account\"@{nl=\"Op goedgekeurde rekening\"}}}, invoice:text? label=\"Invoice reference\"@{nl=\"Factuurreferentie\"}, allowance:enum(not_required,pending,reserved,consumed,released,failed)=not_required label={text=\"Membership allowance\"@{nl=\"Lidmaatschapstegoed\"},values={pending=label_Booking_status_pending,not_required=\"Not required\"@{nl=\"Niet vereist\"},reserved=\"Reserved\"@{nl=\"Gereserveerd\"},consumed=\"Consumed\"@{nl=\"Verbruikt\"},released=\"Released\"@{nl=\"Vrijgegeven\"},failed=\"Failed\"@{nl=\"Mislukt\"}}}, source:text unique label=label_RoomRequest_source, checked_in:datetime? label=\"Actual arrival\"@{nl=\"Werkelijke aankomst\"}, overdue:bool=false label=\"Overdue occupancy\"@{nl=\"Uitgelopen bezetting\"}, checked_out:datetime? label=\"Actual departure\"@{nl=\"Werkelijk vertrek\"}, cancellation_restore:bool=false label=\"Restore refundable allowance\"@{nl=\"Terugbetaalbaar tegoed herstellen\"}, cancellation_reason:text? label=\"Cancellation reason\"@{nl=\"Annuleringsreden\"}, billing_delivery:text? label=\"Billing delivery\"@{nl=\"Facturatieverzending\"}, allowance_delivery:text? label=\"Allowance reservation delivery\"@{nl=\"Verzending tegoedreservering\"}, consume_delivery:text? label=\"Allowance consumption delivery\"@{nl=\"Verzending tegoedverbruik\"}, release_delivery:text? label=\"Allowance release delivery\"@{nl=\"Verzending tegoedvrijgave\"}, refund_delivery:text? label=\"Refund request\"@{nl=\"Terugbetalingsaanvraag\"}, refund_state:enum(none,pending,unknown,refunded,review)=none label=\"Refund outcome\"@{nl=\"Terugbetalingsresultaat\"}, collected:money?, refunded:money?, collection_pending:bool=false, refund_pending:bool=false, reconcile_delivery:text?, cancel_delivery:text?, settlement_revision:int=0 label=\"Settlement revision\"@{nl=\"Afwikkelingsrevisie\"}, departure_buffer:duration=0m label=\"Departure buffer\"@{nl=\"Vertrekbuffer\"} } label=\"Booking\"@{nl=\"Reservering\"}\n  Downtime in Resource { source:text unique label=label_RoomRequest_source, from:datetime label=label_RoomRequest_from, until:datetime? label=label_RoomRequest_until, reason:text, active:bool=true, verified_by:user? label=\"Verified by\"@{nl=\"Geverifieerd door\"}, verification:text? label=\"Repair verification\"@{nl=\"Reparatieverificatie\"} } label=\"Repair block\"@{nl=\"Reparatieblokkade\"}\n  CapacityRevision in Resource { capacity:int min=1, effective:datetime server=now label=\"Effective at\"@{nl=\"Van kracht vanaf\"}, reason:text } label=\"Capacity revision\"@{nl=\"Capaciteitsrevisie\"}\n  Conflict in Resource { booking:Booking, downtime:Downtime?, reason:text, resolved:bool=false, resolution:text? } label=\"Reservation conflict\"@{nl=\"Reserveringsconflict\"}\n  Desk in Resource { name:text trim min=1 unique, active:bool=true } label=\"Pool desk\"@{nl=\"Poolbureau\"}\n  Assignment in Booking { desk:Desk, from:datetime, until:datetime } label=\"Dated desk assignment\"@{nl=\"Gedateerde bureautoewijzing\"}\n  Adjustment in Booking { source:text unique, amount:money, reason:text, delivery:text?, state:enum(pending,paid,expired,review,refunded)=pending label={text=\"State\"@{nl=\"Status\"},values={pending=\"Pending\"@{nl=\"In behandeling\"},paid=\"Paid\"@{nl=\"Betaald\"},expired=\"Expired\"@{nl=\"Verlopen\"},review=\"Review required\"@{nl=\"Beoordeling nodig\"},refunded=\"Refunded\"@{nl=\"Terugbetaald\"}}}, original_until:datetime?, original_reserved_until:datetime?, new_until:datetime?, expires:datetime?, refund_delivery:text?, invoice:text?, movement:Movement?, settlement_revision:int=0, collected:money?, refunded:money? } label=\"Separate booking adjustment\"@{nl=\"Afzonderlijke reserveringscorrectie\"}\n  export Notice in Booking { kind:enum(confirmation,reminder,cancellation) label={text=\"Kind\"@{nl=\"Soort\"},values={confirmation=\"Confirmation\"@{nl=\"Bevestiging\"},reminder=\"Reminder\"@{nl=\"Herinnering\"},cancellation=\"Cancellation\"@{nl=\"Annulering\"}}}, revision:int, subject:text, body:text, delivery:delivery(Mail.send) } label=\"Booking correspondence\"@{nl=\"Reserveringscorrespondentie\"}\n  ## Notice state observes the Mail receipt instead of a stored transport copy.\n  derive Notice.state:DeliveryResult.status = row.delivery.status label={text=\"State\"@{nl=\"Status\"},values={pending=\"Pending\"@{nl=\"In behandeling\"},succeeded=\"Succeeded\"@{nl=\"Geslaagd\"},failed=\"Failed\"@{nl=\"Mislukt\"},unknown=\"Unknown\"@{nl=\"Onbekend\"},skipped=\"Skipped\"@{nl=\"Overgeslagen\"}}}\n  MovementCredit in Movement { charge_source:text, amount:money, baseline:money, delivery:text unique, state:enum(pending,paid,failed,unknown,review)=pending label={text=\"State\"@{nl=\"Status\"},values={pending=\"Pending\"@{nl=\"In behandeling\"},paid=\"Paid\"@{nl=\"Betaald\"},failed=\"Failed\"@{nl=\"Mislukt\"},unknown=\"Unknown\"@{nl=\"Onbekend\"},review=\"Review required\"@{nl=\"Beoordeling nodig\"}}}, reason:text } label=\"Movement credit\"@{nl=\"Verplaatsingstegoed\"}\n  export Movement in Booking { source:text unique, intervals:BenefitInterval[]!, expires:datetime, state:enum(holding,waiting_money,committing,adopted,cancelling,cancelled,review)=holding label={text=\"State\"@{nl=\"Status\"},values={holding=\"Holding candidate\"@{nl=\"Kandidaat gereserveerd\"},waiting_money=\"Awaiting balance\"@{nl=\"Wacht op saldo\"},committing=\"Committing replacement\"@{nl=\"Vervanging vastleggen\"},adopted=\"Replacement adopted\"@{nl=\"Vervanging overgenomen\"},cancelling=\"Cleanup pending\"@{nl=\"Opruimen in behandeling\"},cancelled=\"Cancelled\"@{nl=\"Geannuleerd\"},review=\"Review required\"@{nl=\"Beoordeling nodig\"}}}, extra_due:money?, extra_paid:bool=false, extra_delivery:text?, extra_revision:int=0, credit_due:money?, release_restore:bool=false, reserve_delivery:text?, commit_delivery:text?, release_delivery:text?, reconcile_delivery:text?, outcome:AllowanceOutcome? } label=\"Replacement workspace hold\"@{nl=\"Vervangende werkplekreservering\"}\n  CommercialSale in Booking { phase:SaleMilestone.milestone?, revision:int=0 min=0 }\n  unique CommercialSale fields=parent\n  event CommercialCheck { booking:Booking }\n  event MovementDue { movement:Movement }\n  event MovementObserved { movement:Movement, value:AllowanceOutcome }\n  event MovementCleared { movement:Movement }\n  event AllowanceObserved { booking:Booking, value:AllowanceOutcome }\n  event OccupancyDue { booking:Booking }\n  event SettlementObserved { value:Settlement }\n  event AdjustmentDue { adjustment:Adjustment }\n  event Reminder { booking:Booking, revision:int }\n  event HoldDue { booking:Booking }\n  export event ReservationChanged { booking:Booking, revision:int }\n  export event CommercialSaleChanged { value:SaleMilestone }\n  derive commercial(booking:Booking,sale:CommercialSale,location:Location,product:text,amount:money,purchased:datetime,phase:SaleMilestone.milestone,at:datetime):SaleMilestone = SaleMilestone {source=booking.source,revision=sale.revision,customer=booking.customer.id,account=booking.account,location=location.id,product,amount,purchased_at=purchased,occurred=at,milestone=phase,attribution=booking.attribution,exclusive_program=booking.exclusive_program,attributed_at=booking.attributed_at,attribution_window=booking.attribution_window}\n  derive busy(b:Booking):bool = b.status in [confirmed,occupied] or (b.status in [held,pending] and now<b.expires) or (b.checked_in!=null and (b.checked_out==null or now<b.checked_out+b.departure_buffer))\n  derive covers(b:Booking,point:datetime):bool = (count(b.intervals)==0 and b.reserved_from<=point and point<b.reserved_until) or any(b.intervals as interval,interval.from<=point and point<interval.until) or (b.checked_in!=null and b.checked_out==null and b.checked_in<=point) or (b.checked_out!=null and b.checked_out<=point and point<b.checked_out+b.departure_buffer)\n  derive venue_busy(venue:VenueReservation):bool = venue.status in [held,staged,confirmed] and (venue.status==confirmed or now<venue.expires)\n  derive venue_covers(venue:VenueReservation,point:datetime):bool = venue.from<=point and point<venue.until and not (venue.previous!=null and venue_busy(venue.previous) and venue.previous.from<=point and point<venue.previous.until)\n  derive quote_covers(hold:QuoteHold,point:datetime):bool = (count(hold.intervals)==0 and hold.from<=point and point<hold.until) or any(hold.intervals as interval,interval.from<=point and point<interval.until)\n  derive quote_available(resource:Resource,value:QuoteDocument,quantity:int):bool = quote_intervals_valid(value.from,value.until,value.intervals) and (resource.price_unit!=day or count(value.intervals)>0) and ((count(value.intervals)==0 and free(resource,value.from-resource.buffer_before,value.until+resource.buffer_after,quantity,null)) or (count(value.intervals)>0 and all(value.intervals as interval,(resource.price_unit!=day or any(resource.DayCalendar as day,not day.closed and interval.from==local_instant(day.day,day.opens,resource.timezone,fold=day.fold) and interval.until==local_instant(day.day,day.closes,resource.timezone,fold=day.fold))) and free(resource,interval.from-resource.buffer_before,interval.until+resource.buffer_after,quantity,null))))\n  derive free_at(resource:Resource,point:datetime,quantity:int,skip:Booking?,skip_venue:VenueReservation?=null):bool = quantity+sum(resource.Booking as b where b!=skip and busy(b) and covers(b,point) select b.quantity)+sum(resource.VenueReservation as venue where venue!=skip_venue and venue_busy(venue) and venue_covers(venue,point) select venue.quantity)+sum(resource.QuoteHold as hold where hold.active and now<hold.expires and quote_covers(hold,point) select hold.quantity)+sum(Movement as movement where movement.parent.parent==resource and movement_busy(movement) and movement_covers(movement,point) select movement.parent.quantity)<=resource.capacity\n  derive free(resource:Resource,from:datetime,until:datetime,quantity:int,skip:Booking?,skip_venue:VenueReservation?=null):bool = resource.active and is_open(resource.location,from,until) and from<until and quantity<=resource.capacity and any(resource.Window as w,not w.closed and w.from<=from and until<=w.until) and not any(resource.Window as w,w.closed and overlaps(from,until,w.from,w.until)) and not any(resource.Downtime as d,d.active and d.from<until and (d.until==null or from<d.until)) and free_at(resource,from,quantity,skip,skip_venue) and all(resource.Booking as b,b==skip or not busy(b) or ((b.reserved_from<from or until<=b.reserved_from or free_at(resource,b.reserved_from,quantity,skip,skip_venue)) and all(b.intervals as interval,interval.from<from or until<=interval.from or free_at(resource,interval.from,quantity,skip,skip_venue)))) and all(resource.VenueReservation as venue,venue==skip_venue or not venue_busy(venue) or venue.from<from or until<=venue.from or free_at(resource,venue.from,quantity,skip,skip_venue)) and all(resource.QuoteHold as hold,not hold.active or hold.expires<=now or ((count(hold.intervals)==0 and (hold.from<from or until<=hold.from or free_at(resource,hold.from,quantity,skip,skip_venue))) or (count(hold.intervals)>0 and all(hold.intervals as interval,interval.from<from or until<=interval.from or free_at(resource,interval.from,quantity,skip,skip_venue))))) and all(Movement as movement,movement.parent.parent!=resource or not movement_busy(movement) or all(movement.intervals as interval,interval.from-movement.parent.arrival_buffer<from or until<=interval.from-movement.parent.arrival_buffer or free_at(resource,interval.from-movement.parent.arrival_buffer,quantity,skip,skip_venue)))\n  derive may_reserve(account:user,customer:Customer,resource:Resource):bool = customer.active and resource.location in customer.locations and (owns(account,customer) or has_location_role(account,customer,booker,resource.location) or has_location_role(account,customer,administrator,resource.location))\n  derive may_move(booking:Booking):bool = may_reserve(booking.account,booking.customer,booking.parent) or (booking.customer.active and booking.parent.location in booking.customer.locations and reservation_manager and can_work(actor,booking.parent.location))\n  derive credit_allowed(customer:Customer,resource:Resource):bool = customer.active and any(customer.BillingProfile as profile,profile.on_account and resource.location in profile.approved_locations)\n  derive bookable(booking:Booking):bool = (count(booking.intervals)==0 and free(booking.parent,booking.reserved_from,booking.reserved_until,booking.quantity,booking)) or (count(booking.intervals)>0 and all(booking.intervals as interval,free(booking.parent,interval.from,interval.until,booking.quantity,booking)))\n  derive credit_baseline(charge_source:text,current:money):money = max([current]+(MovementCredit as credit where credit.charge_source==charge_source and credit.state!=failed select credit.baseline+credit.amount))\n  derive financial_cover(booking:Booking):bool = (booking.collected??money(0,booking.total.currency))-(booking.refunded??money(0,booking.total.currency))+sum(booking.Adjustment as adjustment where adjustment.movement!=null select (adjustment.collected??money(0,booking.total.currency))-(adjustment.refunded??money(0,booking.total.currency)),booking.total.currency)>=(booking.service_due??booking.monetary_due??booking.total)\n  derive benefit_request(booking:Booking):Entitlement = Entitlement {source=booking.source,customer=booking.customer.id,account=booking.account,location=booking.parent.location.id,product=\"workspace\",intervals=booking.benefit_intervals,quantity=booking.quantity,unit=booking.benefit_unit,duration=booking.benefit_duration,rate=booking.benefit_rate??booking.rate,previous_source=null,restore_consumed=false}\n  derive charge_request(booking:Booking,base:money,discount:money,tax:money):Charge = Charge {source=booking.source,customer=booking.customer.id,location=booking.parent.location.id,description=booking.parent.name,amount=base-discount+tax,due=local_date(booking.from,booking.parent.timezone),terms=booking.terms,items=[DocumentLine {title=booking.parent.name,quantity=1,price=base,tax,discount,unit=\"reservation\",from=booking.from,until=booking.until,location=booking.parent.location.name,reference=booking.source}]}\n  policy MovementCredit read=billing and can_work(actor,row.parent.parent.parent.location)\n  policy MovementCredit read=authenticated where=row.parent.parent.account==actor\n  policy Notice read=authenticated where=row.parent.account==actor fields=parent,kind,revision,subject,body,delivery.id,delivery.status,state,created_by,created,updated_by,updated,archived_at\n  policy Notice read=reception and can_work(actor,row.parent.parent.location) fields=parent,kind,revision,subject,body,delivery.id,delivery.status,state,created_by,created,updated_by,updated,archived_at\n  policy Movement read=authenticated where=row.parent.account==actor\n  policy Movement read=reservation_manager and can_work(actor,row.parent.parent.location)\n  policy Movement read=billing and can_work(actor,row.parent.parent.location)\n  invariant Movement: all(row.intervals as interval,interval.from<interval.until)\n  derive movement_busy(movement:Movement):bool = movement.state==committing or (movement.state in [holding,waiting_money] and now<movement.expires)\n  derive movement_covers(movement:Movement,point:datetime):bool = any(movement.intervals as interval,interval.from-movement.parent.arrival_buffer<=point and point<interval.until+movement.parent.departure_buffer) and not (busy(movement.parent) and covers(movement.parent,point))\n  derive movement_request(movement:Movement):Entitlement = Entitlement {source=movement.source,customer=movement.parent.customer.id,account=movement.parent.account,location=movement.parent.parent.location.id,product=\"workspace\",intervals=movement.intervals,quantity=movement.parent.quantity,unit=movement.parent.benefit_unit,duration=movement.parent.benefit_duration,rate=movement.parent.benefit_rate??movement.parent.rate,previous_source=movement.parent.allowance_source??movement.parent.source,restore_consumed=true}\n  derive next_boundary(points:datetime[],left:datetime,until:datetime):datetime = first(points as point where left<point order=point)??until\n  derive saved_rows(resource:Resource,points:datetime[],until:datetime):Contribution[] = flatten(points as left where left<until select flatten(resource.ResourcePolicy as policy where policy==first(resource.ResourcePolicy as candidate where candidate.effective<=left order=-candidate.sequence) select flatten(resource.location.LocationPolicy as opening where opening==first(resource.location.LocationPolicy as candidate where candidate.effective<=left order=-candidate.sequence) select [Contribution {source=resource.id,revision=policy.sequence,location=resource.location.id,from=left,until=next_boundary(points,left,until),metric=booked_minutes,quantity=((next_boundary(points,left,until)-left)/1m)*sum(saved_bookings(resource,policy.sequence) as booking where booking.status in [confirmed,occupied,completed] and saved_service(booking,left) select booking.quantity)+((next_boundary(points,left,until)-left)/1m)*sum(saved_venues(resource,policy.sequence) as venue where venue.status==confirmed and venue.from<=left and left<venue.until select venue.quantity),unit=first([\"seat-minute\"] as unit where policy.value.pooled)??\"room-minute\"},Contribution {source=resource.id,revision=policy.sequence,location=resource.location.id,from=left,until=next_boundary(points,left,until),metric=occupied_minutes,quantity=((next_boundary(points,left,until)-left)/1m)*sum(saved_bookings(resource,policy.sequence) as booking where booking.checked_in!=null and booking.checked_in<=left and left<(booking.checked_out??now) select booking.quantity),unit=first([\"seat-minute\"] as unit where policy.value.pooled)??\"room-minute\",provisional=any(saved_bookings(resource,policy.sequence) as booking,booking.checked_in!=null and booking.checked_out==null)},Contribution {source=resource.id,revision=policy.sequence,location=resource.location.id,from=left,until=next_boundary(points,left,until),metric=saleable_minutes,quantity=((next_boundary(points,left,until)-left)/1m)*sum([policy.value.capacity] as capacity where saved_saleable(policy,opening,left,next_boundary(points,left,until)) select capacity),unit=first([\"seat-minute\"] as unit where policy.value.pooled)??\"room-minute\"},Contribution {source=resource.id,revision=policy.sequence,location=resource.location.id,from=left,until=next_boundary(points,left,until),metric=excluded_minutes,quantity=((next_boundary(points,left,until)-left)/1m)*sum([policy.value.capacity] as capacity where not saved_saleable(policy,opening,left,next_boundary(points,left,until)) select capacity),unit=first([\"seat-minute\"] as unit where policy.value.pooled)??\"room-minute\"}])))\n  contract ReportWindow { from:datetime, until:datetime, closed:bool }\n  contract ReportDowntime { from:datetime, until:datetime?, active:bool }\n  contract ReportBooking { from:datetime, until:datetime, intervals:BookingInterval[], quantity:int, status:Booking.status, checked_in:datetime?, checked_out:datetime?, arrival_buffer:duration, departure_buffer:duration }\n  contract ReportVenue { from:datetime, until:datetime, quantity:int, status:VenueReservation.status }\n  contract ResourceEvidence { active:bool, capacity:int, pooled:bool, timezone:timezone }\n  ResourcePolicy in Resource { effective:datetime server=now, sequence:int, baseline:bool=false, value:ResourceEvidence }\n  unique ResourcePolicy fields=sequence\n  policy ResourcePolicy read=reservation_manager and can_work(actor,row.parent.location)\n  lock ResourcePolicy fields=effective,sequence,baseline,value\n  BookingEvidence in Resource { sequence:int, key:text, value:ReportBooking? }\n  VenueEvidence in Resource { sequence:int, key:text, value:ReportVenue? }\n  WindowEvidence in Resource { sequence:int, key:text, value:ReportWindow? }\n  DowntimeEvidence in Resource { sequence:int, key:text, value:ReportDowntime? }\n  unique BookingEvidence fields=sequence,key\n  unique VenueEvidence fields=sequence,key\n  unique WindowEvidence fields=sequence,key\n  unique DowntimeEvidence fields=sequence,key\n  lock BookingEvidence fields=sequence,key,value\n  lock VenueEvidence fields=sequence,key,value\n  lock WindowEvidence fields=sequence,key,value\n  lock DowntimeEvidence fields=sequence,key,value\n  policy BookingEvidence read=reservation_manager and can_work(actor,row.parent.location)\n  policy VenueEvidence read=reservation_manager and can_work(actor,row.parent.location)\n  policy WindowEvidence read=reservation_manager and can_work(actor,row.parent.location)\n  policy DowntimeEvidence read=reservation_manager and can_work(actor,row.parent.location)\n  invariant BookingEvidence: any(row.parent.ResourcePolicy as capture,capture.sequence==row.sequence)\n  invariant VenueEvidence: any(row.parent.ResourcePolicy as capture,capture.sequence==row.sequence)\n  invariant WindowEvidence: any(row.parent.ResourcePolicy as capture,capture.sequence==row.sequence)\n  invariant DowntimeEvidence: any(row.parent.ResourcePolicy as capture,capture.sequence==row.sequence)\n  derive resource_evidence(resource:Resource):ResourceEvidence = ResourceEvidence {active=resource.active,capacity=resource.capacity,pooled=resource.pooled,timezone=resource.timezone}\n  derive report_booking(booking:Booking):ReportBooking = ReportBooking {from=booking.from,until=booking.until,intervals=booking.intervals,quantity=booking.quantity,status=booking.status,checked_in=booking.checked_in,checked_out=booking.checked_out,arrival_buffer=booking.arrival_buffer,departure_buffer=booking.departure_buffer}\n  derive report_venue(venue:VenueReservation):ReportVenue = ReportVenue {from=venue.from,until=venue.until,quantity=venue.quantity,status=venue.status}\n  derive report_window(window:Window):ReportWindow = ReportWindow {from=window.from,until=window.until,closed=window.closed}\n  derive report_downtime(downtime:Downtime):ReportDowntime = ReportDowntime {from=downtime.from,until=downtime.until,active=downtime.active}\n  derive saved_bookings(resource:Resource,sequence:int):ReportBooking[] = flatten(group(resource.BookingEvidence as fact where fact.sequence<=sequence,fact.key) as item select (item.items as fact where fact==first(item.items as latest order=-latest.sequence) and fact.value!=null select fact.value))\n  derive saved_venues(resource:Resource,sequence:int):ReportVenue[] = flatten(group(resource.VenueEvidence as fact where fact.sequence<=sequence,fact.key) as item select (item.items as fact where fact==first(item.items as latest order=-latest.sequence) and fact.value!=null select fact.value))\n  derive saved_windows(resource:Resource,sequence:int):ReportWindow[] = flatten(group(resource.WindowEvidence as fact where fact.sequence<=sequence,fact.key) as item select (item.items as fact where fact==first(item.items as latest order=-latest.sequence) and fact.value!=null select fact.value))\n  derive saved_downtime(resource:Resource,sequence:int):ReportDowntime[] = flatten(group(resource.DowntimeEvidence as fact where fact.sequence<=sequence,fact.key) as item select (item.items as fact where fact==first(item.items as latest order=-latest.sequence) and fact.value!=null select fact.value))\n  derive saved_service(booking:ReportBooking,point:datetime):bool = (count(booking.intervals)==0 and booking.from<=point and point<booking.until) or any(booking.intervals as interval,interval.from+booking.arrival_buffer<=point and point<interval.until-booking.departure_buffer)\n  derive saved_saleable(policy:ResourcePolicy,opening:LocationPolicy,left:datetime,right:datetime):bool = policy.value.active and policy_open(opening,left,right) and any(saved_windows(policy.parent,policy.sequence) as window,not window.closed and window.from<=left and right<=window.until) and not any(saved_windows(policy.parent,policy.sequence) as window,window.closed and overlaps(left,right,window.from,window.until)) and not any(saved_downtime(policy.parent,policy.sequence) as downtime,downtime.active and downtime.from<right and (downtime.until==null or left<downtime.until))\n  policy Resource read=public fields=location,name,pooled,capacity,active,timezone,currency,hourly,increment,minimum,terms,refund_notice,amenities,accessibility,party_limit,kind,hold_for,daily,price_unit,tax_rate,discount_rate,cancellation_fee\n  policy Resource read=catalog_owner and can_work(actor,row.location)\n  policy Resource read=reservation_manager and can_work(actor,row.location)\n  policy DayCalendar read=public\n  policy Window read=public\n  export derive can_read_booking_details(booking:Booking):bool = (reservation_manager and can_work(actor,booking.parent.location)) or (authenticated and booking.account==actor) or (billing and can_work(actor,booking.parent.location))\n  policy Booking read=can_read_booking_details(row)\n  policy Booking read=reception and can_work(actor,row.parent.location) fields=customer,account,email,from,until,quantity,attendees,status,payment,allowance,checked_in,checked_out,overdue,source\n  policy Downtime read=reservation_manager and can_work(actor,row.parent.location)\n  policy DowntimeFence read=reservation_manager and can_work(actor,row.parent.location)\n  policy VenueFence read=reservation_manager and can_work(actor,row.parent.location)\n  policy VenueReservation read=reservation_manager and can_work(actor,row.parent.location)\n  policy VenueReservation read=reception and can_work(actor,row.parent.location)\n  policy VenueReservation read=authenticated where=row.account==actor\n  policy ReservationFence read=reservation_manager and can_work(actor,row.parent.location)\n  policy QuoteHold read=reservation_manager and can_work(actor,row.parent.location)\n  invariant VenueReservation: row.from<row.until and row.quantity>0 and (row.previous==null or (row.previous.parent==row.parent and row.quantity==row.previous.quantity))\n  invariant QuoteHold: row.from<row.until and row.quantity>0 and row.expires<=row.offer.snapshot.expires\n  policy CapacityRevision read=reservation_manager and can_work(actor,row.parent.location)\n  policy Conflict read=reservation_manager and can_work(actor,row.parent.location)\n  policy Desk read=public\n  policy Assignment read=reception and can_work(actor,row.parent.parent.location)\n  policy Assignment read=authenticated where=row.parent.account==actor\n  policy Adjustment read=billing and can_work(actor,row.parent.parent.location)\n  policy Adjustment read=authenticated where=row.parent.account==actor\n  invariant Assignment: row.from<row.until and row.parent.from<=row.from and row.until<=row.parent.until and row.desk.parent==row.parent.parent\n  invariant Adjustment: row.amount.currency==row.parent.total.currency and row.amount.minor>0\n  invariant Resource: row.currency==row.location.currency and row.timezone==row.location.timezone\n  invariant Resource: row.hourly.currency==row.currency and row.hourly.minor>=0 and row.increment>0m and row.minimum>0m and row.refund_notice>=0m and (row.cancellation_fee==null or (row.cancellation_fee.currency==row.currency and row.cancellation_fee.minor>=0)) and (row.daily==null or (row.daily.currency==row.currency and row.daily.minor>=0)) and (row.price_unit!=day or row.daily!=null) and row.hold_for>0m and row.buffer_before>=0m and row.buffer_after>=0m and (row.pooled or row.capacity==1)\n  invariant DayCalendar: local_instant(row.day,row.opens,row.parent.timezone,fold=row.fold)<local_instant(row.day,row.closes,row.parent.timezone,fold=row.fold)\n  invariant Window: row.from<row.until\n  invariant Booking: row.from<row.until and row.reserved_from<=row.from and row.until<=row.reserved_until and row.total.currency==row.parent.currency and row.total.minor>=0 and row.total==row.subtotal-row.discount+row.tax and row.tax.minor>=0 and row.discount.minor>=0 and row.discount<=row.subtotal+row.tax and row.refund_amount.currency==row.total.currency and row.refund_amount.minor>=0 and row.refund_amount<=row.total and all(row.intervals as interval,interval.from<interval.until and row.reserved_from<=interval.from and interval.until<=row.reserved_until)\n  lock Booking fields=billing_location,sale_product,purchased_at,attribution,exclusive_program,attributed_at,attribution_window,customer,account,rate,tax_fraction,discount_fraction,subtotal,tax,discount,total,refund_amount,terms,refund_before,source,departure_buffer,arrival_buffer,benefit_intervals,benefit_rate,benefit_unit,benefit_duration,original_intervals,quote\n  lock Booking fields=monetary_due when=row.monetary_due!=null\n  fixture recorded_resource=ResourcePolicy {parent=test_room,effective=now-2d,sequence=1,baseline=true,value=ResourceEvidence {active=true,capacity=1,pooled=false,timezone=\"Europe/Brussels\"}}\n  fixture recorded_window=WindowEvidence {parent=test_room,sequence=1,key=test_window.id,value=ReportWindow {from=now-2d,until=now+2d,closed=false}}\n  fixture recorded_followup=ResourcePolicy {parent=test_room,effective=now-1d,sequence=2,value=ResourceEvidence {active=true,capacity=1,pooled=false,timezone=\"Europe/Brussels\"}}\n  fixture recorded_booking_old=BookingEvidence {parent=test_room,sequence=1,key=\"seeded-booking\",value=ReportBooking {from=now-1d,until=now+1d,intervals=[],quantity=1,status=confirmed,checked_in=null,checked_out=null,arrival_buffer=0m,departure_buffer=0m}}\n  fixture recorded_booking_absent=BookingEvidence {parent=test_room,sequence=2,key=\"seeded-booking\",value=null}\n  fixture test_room=Resource {location=test_site,name=\"Room\",timezone=\"Europe/Brussels\",currency=\"EUR\",hourly=money(1000,\"EUR\"),terms=\"Full balance before admission\",refund_notice=1d,accessibility=\"Step-free\"}\n  fixture test_window=Window {parent=test_room,from=datetime(\"2026-10-01T00:00:00Z\"),until=datetime(\"2026-11-01T00:00:00Z\")}\n  fixture test_sale=CommercialSale {parent=test_hold}\n  export fixture test_hold=Booking {parent=test_room,customer=test_company,account=self,email=\"customer@example.test\",from=datetime(\"2026-10-04T09:00:00Z\"),until=datetime(\"2026-10-04T10:00:00Z\"),rate=money(1000,\"EUR\"),subtotal=money(1000,\"EUR\"),tax=money(0,\"EUR\"),discount=money(0,\"EUR\"),refund_amount=money(1000,\"EUR\"),total=money(1000,\"EUR\"),terms=\"Full balance before admission\",refund_before=datetime(\"2026-10-03T09:00:00Z\"),reserved_from=datetime(\"2026-10-04T09:00:00Z\"),reserved_until=datetime(\"2026-10-04T10:00:00Z\"),expires=datetime(\"2026-10-03T12:15:00Z\"),source=\"test-hold\"}\n  fixture quote_window=Window {parent=test_room,from=datetime(\"2099-01-01T08:00:00Z\"),until=datetime(\"2099-01-01T18:00:00Z\")}\n  fixture quote_day=DayCalendar {parent=test_room,day=date(\"2099-01-01\")}\n  fixture quoted_hold=QuoteHold {parent=test_room,source=\"quote-test\",revision=1,quantity=1,from=datetime(\"2099-01-01T09:00:00Z\"),until=datetime(\"2099-01-01T10:00:00Z\"),intervals=[],expires=datetime(\"2099-01-01T08:00:00Z\"),offer={source=\"quote-test\",revision=1,customer=test_company.id,location=test_site.id,resource=test_room.id,recipient=\"customer@example.test\",quantity=1,attendees=1,hold_until=datetime(\"2099-01-01T08:00:00Z\"),snapshot={issuer=\"Operator\",customer=\"Example company\",resource=test_room.id,quantity=1,attendees=1,recipient=\"customer@example.test\",title=\"Frozen room offer\",location=\"Main\",from=datetime(\"2099-01-01T09:00:00Z\"),until=datetime(\"2099-01-01T10:00:00Z\"),intervals=[],terms=\"Frozen terms\",refund_before=datetime(\"2099-01-01T09:00:00Z\"),expires=datetime(\"2099-01-01T08:00:00Z\"),lines=[{title=\"Room\",quantity=1,unit=\"hour\",price=money(1000,\"EUR\"),tax=money(0,\"EUR\"),discount=money(0,\"EUR\")}],total=money(1000,\"EUR\")}}}\n  fixture closed_quote=ReservationFence {parent=test_room,source=\"quote-test\",revision=1,reason=\"Quoted inventory unavailable\",offer={product=null,attribution=null,exclusive_program=null,attributed_at=null,attribution_window=null,source=\"quote-test\",revision=1,customer=test_company.id,location=test_site.id,resource=test_room.id,account=self,recipient=\"customer@example.test\",accepted_at=now,quantity=1,attendees=1,snapshot=quoted_hold.offer.snapshot}}\n When\n  # Retain historical booking assertions without capacity, billing or allowance effects. @{nl=\"Bewaar historische reserveringsclaims zonder capaciteit, facturatie of tegoeden te wijzigen.\"}\n  export scenario retain_legacy(source:text label=\"Source system\"@{nl=\"Bronsysteem\"},external_id:text label=\"Original record key\"@{nl=\"Oorspronkelijke recordsleutel\"},location:Location label=\"Current location scope\"@{nl=\"Huidig locatiebereik\"},facts:LegacyBookingFacts label=\"Original booking facts\"@{nl=\"Oorspronkelijke reserveringsgegevens\"},source_evidence:file label=\"Original source artifact\"@{nl=\"Oorspronkelijk bronbestand\"},attestation:text label=\"Intake attestation\"@{nl=\"Verklaring bij invoer\"}) by=reservation_manager -> LegacyBooking label=\"Retain historical booking\"@{nl=\"Historische reservering bewaren\"}\n   require can_work(actor,location) and trim(source)!=\"\" and trim(external_id)!=\"\" and trim(attestation)!=\"\"\n   require not any(LegacyBooking archived=include as entry,entry.source==trim(source) and entry.external_id==external_id)\n   do\n    create LegacyBooking {source=trim(source),external_id,location,facts,source_evidence,attestation=trim(attestation)} as entry\n    return entry\n   examples seed=[history_worker,legacy_booking] source=\"vendor-w\" external_id=\" B-18 \" location=test_site facts={customer_source=\"vendor-w\",customer_external_id=\"C-9\",from_original=\"2021-05-12 09:00\",status=\"Unknown\",amount=null} source_evidence=legacy_source attestation=\"Checked source export\"\n    as,external_id,history_worker.active -> result.external_id,result.facts.from,result.facts.amount,result.account,result.imported_by,count(Booking)\n    history_user,\" B-18 \",true -> \" B-18 \",null,null,null,history_user,0\n    history_user,\"B-17\",true -> error(rule_failed)\n    history_user,\"B-18\",false -> error(rule_failed)\n    members,\"B-18\",true -> error(forbidden)\n  # Find readable source identities; the preview cannot reserve an import key. @{nl=\"Zoek leesbare bronidentiteiten; het voorbeeld reserveert geen invoersleutel.\"}\n  scenario legacy_matches(source:text label=\"Source system\"@{nl=\"Bronsysteem\"},external_id:text label=\"Original record key\"@{nl=\"Oorspronkelijke recordsleutel\"},location:Location label=\"Current location scope\"@{nl=\"Huidig locatiebereik\"}) read=true -> LegacyBooking[] by=authenticated label=\"Find historical booking\"@{nl=\"Historische reservering zoeken\"}\n   do return LegacyBooking archived=include as entry where entry.source==trim(source) and entry.external_id==external_id and entry.location==location\n   examples seed=[history_worker,legacy_booking] source=\"vendor-w\" external_id=\"B-17\" location=test_site\n    as -> count(result)\n    history_user -> 1\n    members -> 0\n    public -> error(forbidden)\n  # Review current references and access independently of original source facts. @{nl=\"Beoordeel huidige verwijzingen en toegang los van de oorspronkelijke brongegevens.\"}\n  export scenario link_legacy(entry:LegacyBooking,customer:Customer? label=\"Current customer\"@{nl=\"Huidige klant\"},resource:Resource? label=\"Current resource\"@{nl=\"Huidige voorziening\"},account:user? label=\"Current account\"@{nl=\"Huidig account\"},reason:text label=\"Review reason\"@{nl=\"Reden voor beoordeling\"}) by=reservation_manager or finance label=\"Map historical booking\"@{nl=\"Historische reservering koppelen\"}\n   require can_work(actor,entry.location) and trim(reason)!=\"\"\n   require customer==null or (finance and trim(entry.facts.customer_source??\"\")!=\"\" and trim(entry.facts.customer_external_id??\"\")!=\"\" and entry.location in customer.locations)\n   require resource==null or (reservation_manager and trim(entry.facts.resource_source??\"\")!=\"\" and trim(entry.facts.resource_external_id??\"\")!=\"\" and resource.location==entry.location)\n   require account==null or (customer!=null and (owns(account,customer) or has_location_role(account,customer,booker,entry.location)))\n   do set entry {customer,resource,account,mapping_reason=trim(reason)}\n   examples seed=[history_worker,test_booker] entry=legacy_booking customer=test_company resource=test_room account=other reason=\"Reviewed original customer/resource keys against existing records\"\n    as,customer,resource,account,reason,request.entry.version -> entry.customer,entry.resource,entry.account,entry.facts.customer_external_id,entry.mapping_reason\n    history_user,test_company,test_room,other,\"Verified source keys\",1 -> test_company,test_room,other,\"C-9\",\"Verified source keys\"\n    history_user,null,null,null,\"Revoke mistaken mapping\",1 -> null,null,null,\"C-9\",\"Revoke mistaken mapping\"\n    history_user,test_company,test_room,self,\"Unverified account\",1 -> error(rule_failed)\n    history_user,test_company,test_room,other,\" \",1 -> error(rule_failed)\n    history_user,test_company,test_room,other,\"Verified source keys\",2 -> error(conflict)\n    members,test_company,test_room,other,\"Verified source keys\",1 -> error(forbidden)\n  crud Resource by=catalog_owner fields=name,active,hourly,daily,price_unit,tax_rate,discount_rate,cancellation_fee,increment,minimum,terms,refund_notice,buffer_before,buffer_after,amenities,accessibility,party_limit,kind,hold_for create_fields=location,name,pooled,capacity,timezone,currency,hourly,daily,price_unit,tax_rate,discount_rate,cancellation_fee,terms,refund_notice,accessibility,party_limit,kind,hold_for when=can_work(actor,row.location) delete=none\n  crud DayCalendar by=reservation_manager fields=day,opens,closes,closed,fold when=can_work(actor,row.parent.location) delete=none\n  crud Window by=reservation_manager fields=from,until,closed,reason when=can_work(actor,row.parent.location) delete=none\n  scenario snapshot_Resource_create on=Resource.create\n   do\n    let resource=event.after\n    create ResourcePolicy {parent=resource,sequence=count(resource.ResourcePolicy)+1,baseline=true,value=resource_evidence(resource)} as policy_snapshot_1\n  scenario snapshot_Resource_update on=Resource.update\n   do\n    let resource=event.after\n    create ResourcePolicy {parent=resource,sequence=count(resource.ResourcePolicy)+1,value=resource_evidence(resource)} as policy_snapshot_1\n  scenario snapshot_Window_create on=Window.create\n   do\n    let resource=event.after.parent\n    create ResourcePolicy {parent=resource,sequence=count(resource.ResourcePolicy)+1,value=resource_evidence(resource)} as policy_snapshot_1\n    create WindowEvidence {parent=event.after.parent,sequence=policy_snapshot_1.sequence,key=event.after.id,value=report_window(event.after)} as window_evidence_1\n  scenario snapshot_Window_update on=Window.update\n   do\n    let resource=event.after.parent\n    create ResourcePolicy {parent=resource,sequence=count(resource.ResourcePolicy)+1,value=resource_evidence(resource)} as policy_snapshot_1\n    create WindowEvidence {parent=event.after.parent,sequence=policy_snapshot_1.sequence,key=event.after.id,value=report_window(event.after)} as window_evidence_1\n  scenario snapshot_DayCalendar_create on=DayCalendar.create\n   do\n    let resource=event.after.parent\n    create ResourcePolicy {parent=resource,sequence=count(resource.ResourcePolicy)+1,value=resource_evidence(resource)} as policy_snapshot_1\n  scenario snapshot_DayCalendar_update on=DayCalendar.update\n   do\n    let resource=event.after.parent\n    create ResourcePolicy {parent=resource,sequence=count(resource.ResourcePolicy)+1,value=resource_evidence(resource)} as policy_snapshot_1\n  # Export saved calendar and resource evidence; dates before the first capture remain partial. @{nl=\"Exporteer vastgelegd kalender- en voorzieningsbewijs; datums vóór de eerste vastlegging blijven gedeeltelijk.\"}\n  export scenario resource_report(resource:Resource,from:datetime,until:datetime) read=true scope=authority -> ReportBatch by=reservation_manager label=\"Workspace source measures\"@{nl=\"Werkplekbronmaatstaven\"}\n   require can_work(actor,resource.location) and from<until\n   do\n    let days=dates(add_days(local_date(from,resource.timezone),-1),add_days(local_date(until,resource.timezone),1),1000)\n    let policies=resource.ResourcePolicy\n    let openings=resource.location.LocationPolicy\n    let weekly=flatten(flatten(openings as policy select flatten(days as day select (policy.weekly as hours where weekday(day)==hours.weekday select [local_instant(day,hours.opens,policy.timezone,fold=hours.fold),local_instant(add_days(day,hours.close_after),hours.closes,policy.timezone,fold=hours.fold)]))))\n    let dated=flatten(flatten(openings as policy select (policy.dated as hours where not hours.closed select [local_instant(hours.day,hours.opens,policy.timezone,fold=hours.fold),local_instant(add_days(hours.day,hours.close_after),hours.closes,policy.timezone,fold=hours.fold)])))\n    let midnight=days as day select local_instant(day,\"00:00\",resource.timezone,fold=earlier)\n    let windows=flatten(resource.WindowEvidence as fact where fact.value!=null select [fact.value.from,fact.value.until])\n    let downtime=flatten(resource.DowntimeEvidence as fact where fact.value!=null select [fact.value.from,fact.value.until??until])\n    let service=flatten(resource.BookingEvidence as fact where fact.value!=null select [fact.value.from,fact.value.until,fact.value.checked_in??from,fact.value.checked_out??now])\n    let access=flatten(resource.BookingEvidence as fact where fact.value!=null select flatten(fact.value.intervals as interval select [interval.from+fact.value.arrival_buffer,interval.until-fact.value.departure_buffer]))\n    let venues=flatten(resource.VenueEvidence as fact where fact.value!=null select [fact.value.from,fact.value.until])\n    let boundaries=[from,until]+weekly+dated+midnight+windows+downtime+service+access+venues+(policies as policy select policy.effective)+(openings as policy select policy.effective)\n    let points=group((boundaries as point where from<=point and point<=until) as point,point) as point order=point.key select point.key\n    let complete=any(policies as policy,policy.effective<=from and policy.baseline) and any(openings as policy,policy.effective<=from)\n    let stamp=join((policies as policy order=policy.sequence select format(\"{id}:{sequence}\",{id=policy.id,sequence=policy.sequence})),\",\")+\":\"+join((openings as policy order=policy.sequence select format(\"{id}:{sequence}\",{id=policy.id,sequence=policy.sequence})),\",\")+\":\"+join((resource.BookingEvidence as fact order=fact.sequence select format(\"{id}:{sequence}\",{id=fact.id,sequence=fact.sequence})),\",\")+\":\"+join((resource.VenueEvidence as fact order=fact.sequence select format(\"{id}:{sequence}\",{id=fact.id,sequence=fact.sequence})),\",\")+\":\"+join((resource.WindowEvidence as fact order=fact.sequence select format(\"{id}:{sequence}\",{id=fact.id,sequence=fact.sequence})),\",\")+\":\"+join((resource.DowntimeEvidence as fact order=fact.sequence select format(\"{id}:{sequence}\",{id=fact.id,sequence=fact.sequence})),\",\")\n    if complete\n     return ReportBatch {checkpoint=Checkpoint {source=resource.id,revision=stamp,generated=now,state=fresh,complete=true},rows=saved_rows(resource,points,until)}\n    return ReportBatch {checkpoint=Checkpoint {source=resource.id,revision=stamp,generated=now,state=partial,complete=false},rows=saved_rows(resource,points,until)}\n   examples seed=[recorded_resource,recorded_window,recorded_site,test_window] resource=test_room from=local_instant(local_date(now,\"Europe/Brussels\"),\"09:00\",\"Europe/Brussels\",fold=earlier) until=local_instant(local_date(now,\"Europe/Brussels\"),\"10:00\",\"Europe/Brussels\",fold=earlier)\n    test_room.active -> result.checkpoint.complete,sum(result.rows as item where item.metric==saleable_minutes select item.quantity)\n    true -> true,60\n    false -> true,60\n   examples seed=[recorded_resource,recorded_window,recorded_site,test_window] resource=test_room\n    from,until -> result.checkpoint.complete,count(result.rows)\n    now-10d,now-10d+1h -> false,0\n   ## A null latest fact removes its entity; an older value is never resurrected.\n   examples seed=[recorded_resource,recorded_followup,recorded_window,recorded_booking_old,recorded_booking_absent,recorded_site,test_window] resource=test_room from=local_instant(local_date(now,\"Europe/Brussels\"),\"09:00\",\"Europe/Brussels\",fold=earlier) until=local_instant(local_date(now,\"Europe/Brussels\"),\"10:00\",\"Europe/Brussels\",fold=earlier)\n    recorded_booking_absent.value -> result.checkpoint.complete,sum(result.rows as item where item.metric==booked_minutes select item.quantity)\n    null -> true,0\n    recorded_booking_old.value -> true,60\n   ## Saved evidence stays inside reservation-manager work scope.\n   examples seed=[recorded_resource,recorded_window,recorded_site,test_window,history_worker] resource=test_room from=local_instant(local_date(now,\"Europe/Brussels\"),\"09:00\",\"Europe/Brussels\",fold=earlier) until=local_instant(local_date(now,\"Europe/Brussels\"),\"10:00\",\"Europe/Brussels\",fold=earlier)\n    as,history_worker.active -> result.checkpoint.complete\n    history_user,true -> true\n    history_user,false -> error(rule_failed)\n    members,true -> error(forbidden)\n    public,true -> error(forbidden)\n  # Expose this resource's current eligibility and published full price without customer records. @{nl=\"Toon de huidige geschiktheid en gepubliceerde volledige prijs van deze voorziening zonder klantgegevens.\"}\n  scenario available(resource:Resource,from:datetime,until:datetime,quantity:int=1,attendees:int=1,amenities:text[]=[]) -> WorkspaceAvailability read=true scope=authority by=public label=\"Check workspace availability\"@{nl=\"Werkplekbeschikbaarheid controleren\"}\n   require resource.price_unit==hour and now<=from and from<until and quantity>0 and attendees>0\n   do\n    let subtotal=resource.hourly*((until-from)/1h)*quantity\n    let discounted=subtotal-subtotal*resource.discount_rate\n    return WorkspaceAvailability {resource,from,until,quantity,attendees,available=attendees<=resource.party_limit and (not resource.pooled or attendees<=quantity) and until-from>=resource.minimum and (until-from)%resource.increment==0m and all(amenities as amenity,amenity in resource.amenities) and free(resource,from-resource.buffer_before,until+resource.buffer_after,quantity,null),total=discounted+discounted*resource.tax_rate,terms=resource.terms,refund_before=from-resource.refund_notice}\n   examples seed=[test_hold,test_window,sunday_site] resource=test_room from=local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"10:00\",\"Europe/Brussels\",fold=earlier) until=local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"11:00\",\"Europe/Brussels\",fold=earlier)\n    test_hold.from,test_hold.until,test_hold.reserved_from,test_hold.reserved_until,test_hold.expires,test_window.from,test_window.until,sunday_site.weekday,test_hold.status,test_hold.checked_in -> result.available\n    local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"10:00\",\"Europe/Brussels\",fold=earlier),local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"11:00\",\"Europe/Brussels\",fold=earlier),local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"10:00\",\"Europe/Brussels\",fold=earlier),local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"11:00\",\"Europe/Brussels\",fold=earlier),now-1m,now-1d,now+3d,weekday(local_date(local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"10:00\",\"Europe/Brussels\",fold=earlier),\"Europe/Brussels\")),held,null -> true\n    local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"10:00\",\"Europe/Brussels\",fold=earlier),local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"11:00\",\"Europe/Brussels\",fold=earlier),local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"10:00\",\"Europe/Brussels\",fold=earlier),local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"11:00\",\"Europe/Brussels\",fold=earlier),now-1m,now-1d,now+3d,weekday(local_date(local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"10:00\",\"Europe/Brussels\",fold=earlier),\"Europe/Brussels\")),pending,null -> true\n    local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"10:00\",\"Europe/Brussels\",fold=earlier),local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"11:00\",\"Europe/Brussels\",fold=earlier),local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"10:00\",\"Europe/Brussels\",fold=earlier),local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"11:00\",\"Europe/Brussels\",fold=earlier),now-1m,now-1d,now+3d,weekday(local_date(local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"10:00\",\"Europe/Brussels\",fold=earlier),\"Europe/Brussels\")),confirmed,null -> false\n    local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"10:00\",\"Europe/Brussels\",fold=earlier),local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"11:00\",\"Europe/Brussels\",fold=earlier),local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"10:00\",\"Europe/Brussels\",fold=earlier),local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"11:00\",\"Europe/Brussels\",fold=earlier),now-1m,now-1d,now+3d,weekday(local_date(local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"10:00\",\"Europe/Brussels\",fold=earlier),\"Europe/Brussels\")),cancelled,now -> false\n  # Reveal day eligibility using only the selected resource's authoritative published dates. @{nl=\"Toon daggeschiktheid met uitsluitend de gezaghebbende gepubliceerde datums van de geselecteerde voorziening.\"}\n  scenario available_days(resource:Resource,start:date,end:date,quantity:int=1,attendees:int=1,amenities:text[]=[]) -> DayAvailability read=true scope=authority by=public label=\"Check workspace days\"@{nl=\"Werkplekdagen controleren\"}\n   require resource.price_unit==day and resource.daily!=null and start<end and quantity>0 and attendees>0\n   do\n    let access=resource.DayCalendar as day where start<=day.day and day.day<end and not day.closed order=day.day select BookingInterval {from=local_instant(day.day,day.opens,resource.timezone,fold=day.fold)-resource.buffer_before,until=local_instant(day.day,day.closes,resource.timezone,fold=day.fold)+resource.buffer_after}\n    let subtotal=resource.daily*count(dates(start,end,1000))*quantity\n    let discounted=subtotal-subtotal*resource.discount_rate\n    return DayAvailability {resource,start,end,quantity,attendees,available=attendees<=resource.party_limit and (not resource.pooled or attendees<=quantity) and all(amenities as amenity,amenity in resource.amenities) and count(access)==count(dates(start,end,1000)) and count(access)>0 and all(access as interval,now<=interval.from and free(resource,interval.from,interval.until,quantity,null)),total=discounted+discounted*resource.tax_rate,terms=resource.terms}\n  # Hold a published interval at its frozen price; confirmation remains pending billing and allowance. @{nl=\"Reserveer een gepubliceerd tijdvak tijdelijk tegen de vastgelegde prijs; bevestiging blijft afhankelijk van facturatie en tegoed.\"}\n  scenario hold(resource:Resource,customer:Customer,from:datetime label=label_RoomRequest_from,until:datetime label=label_RoomRequest_until,quantity:int,email:email,account:user?=null label=\"Booking account\"@{nl=\"Reserveringsaccount\"},attendees:int=1 label=\"Attendees\"@{nl=\"Deelnemers\"},capture:Capture?=null,use_allowance:bool=false label=label_hold_use_allowance) -> Booking by=authenticated or reception label=\"Hold workspace\"@{nl=\"Werkplek tijdelijk reserveren\"}\n   require capture==null or (actor.email_verified and capture.parent==customer and capture.account==(account??actor) and capture.account==actor and capture==latest_capture(customer,actor,resource.location,format(\"{kind}\",{kind=resource.kind})))\n   require actor.email_verified and customer.active and resource.location in customer.locations\n   require account==null or (reception and can_work(actor,resource.location) and ((customer.kind==individual and owns(account,customer)) or has_location_role(account,customer,booker,resource.location) or has_location_role(account,customer,administrator,resource.location)))\n   require (account!=null and reception and can_work(actor,resource.location)) or (reservation_manager and can_work(actor,resource.location)) or (customer.kind==individual and owns(actor,customer)) or has_location_role(actor,customer,booker,resource.location) or has_location_role(actor,customer,administrator,resource.location)\n   require resource.price_unit==hour and attendees>0 and attendees<=resource.party_limit and (not resource.pooled or attendees<=quantity) and from>=now and from<until and quantity>0 and until-from>=resource.minimum and (until-from)%resource.increment==0m\n   require free(resource,from-resource.buffer_before,until+resource.buffer_after,quantity,null)\n   do\n    let subtotal=resource.hourly*((until-from)/1h)*quantity\n    let discount=subtotal*resource.discount_rate\n    let tax=(subtotal-discount)*resource.tax_rate\n    let total=subtotal-discount+tax\n    create Booking {parent=resource,billing_location=resource.location,sale_product=format(\"{kind}\",{kind=resource.kind}),purchased_at=now,attribution=capture?.code,exclusive_program=capture?.program,attributed_at=capture?.captured,attribution_window=capture?.window,customer,account=account??actor,email,from,until,quantity,attendees,rate=resource.hourly,tax_fraction=resource.tax_rate,discount_fraction=resource.discount_rate,subtotal,discount,tax,total,refund_amount=max(money(0,resource.currency),total-(resource.cancellation_fee??money(0,resource.currency))),terms=resource.terms,refund_before=from-resource.refund_notice,reserved_from=from-resource.buffer_before,reserved_until=until+resource.buffer_after,expires=now+resource.hold_for,source=operation.id,departure_buffer=resource.buffer_after,arrival_buffer=resource.buffer_before,benefit_unit=resource.price_unit,benefit_duration=resource.increment,benefit_rate=resource.hourly*(resource.increment/1h),benefit_intervals=[BenefitInterval {from,until}]} as booking\n    create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_1\n    create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_1.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_1\n    if use_allowance\n     set booking {allowance=pending}\n    schedule booking.id at=booking.expires event=HoldDue {booking}\n    emit ReservationChanged {booking,revision=booking.version}\n    return booking\n   examples seed=[test_window,test_admin,sunday_site] resource=test_room customer=test_company from=datetime(\"2026-10-04T09:00:00Z\") until=datetime(\"2026-10-04T10:00:00Z\") email=\"customer@example.test\"\n    quantity -> result.status\n    2 -> error(rule_failed)\n    0 -> error(rule_failed)\n  # Reserve every published local day together at the frozen day price. @{nl=\"Reserveer elke gepubliceerde lokale dag samen tegen de vastgelegde dagprijs.\"}\n  scenario hold_days(resource:Resource,customer:Customer,start:date,end:date,quantity:int,email:email,account:user?=null label=\"Booking account\"@{nl=\"Reserveringsaccount\"},attendees:int=1,capture:Capture?=null,use_allowance:bool=false) -> Booking by=authenticated or reception label=\"Hold workspace days\"@{nl=\"Werkplekdagen tijdelijk reserveren\"}\n   require capture==null or (actor.email_verified and capture.parent==customer and capture.account==(account??actor) and capture.account==actor and capture==latest_capture(customer,actor,resource.location,format(\"{kind}\",{kind=resource.kind})))\n   require actor.email_verified and customer.active and resource.location in customer.locations\n   require account==null or (reception and can_work(actor,resource.location) and ((customer.kind==individual and owns(account,customer)) or has_location_role(account,customer,booker,resource.location) or has_location_role(account,customer,administrator,resource.location)))\n   require (account!=null and reception and can_work(actor,resource.location)) or (reservation_manager and can_work(actor,resource.location)) or (customer.kind==individual and owns(actor,customer)) or has_location_role(actor,customer,booker,resource.location) or has_location_role(actor,customer,administrator,resource.location)\n   require resource.price_unit==day and resource.daily!=null and start<end and quantity>0 and attendees>0 and attendees<=resource.party_limit and (not resource.pooled or attendees<=quantity)\n   do\n    let access=resource.DayCalendar as day where start<=day.day and day.day<end and not day.closed order=day.day select BookingInterval {from=local_instant(day.day,day.opens,resource.timezone,fold=day.fold)-resource.buffer_before,until=local_instant(day.day,day.closes,resource.timezone,fold=day.fold)+resource.buffer_after}\n    require count(access)==count(dates(start,end,1000)) and count(access)>0\n    require all(access as interval,now<=interval.from and free(resource,interval.from,interval.until,quantity,null))\n    let first_day=at(access,0)\n    let last_day=at(access,count(access)-1)\n    let subtotal=resource.daily*count(access)*quantity\n    let discount=subtotal*resource.discount_rate\n    let tax=(subtotal-discount)*resource.tax_rate\n    let total=subtotal-discount+tax\n    create Booking {parent=resource,billing_location=resource.location,sale_product=format(\"{kind}\",{kind=resource.kind}),purchased_at=now,attribution=capture?.code,exclusive_program=capture?.program,attributed_at=capture?.captured,attribution_window=capture?.window,customer,account=account??actor,email,from=first_day.from+resource.buffer_before,until=last_day.until-resource.buffer_after,intervals=access,original_intervals=access,benefit_unit=day,benefit_duration=1d,benefit_rate=resource.daily,benefit_intervals=access as interval select BenefitInterval {from=interval.from+resource.buffer_before,until=interval.until-resource.buffer_after},quantity,attendees,rate=resource.daily,tax_fraction=resource.tax_rate,discount_fraction=resource.discount_rate,subtotal,discount,tax,total,refund_amount=max(money(0,resource.currency),total-(resource.cancellation_fee??money(0,resource.currency))),terms=resource.terms,refund_before=first_day.from+resource.buffer_before-resource.refund_notice,reserved_from=first_day.from,reserved_until=last_day.until,expires=now+resource.hold_for,source=operation.id,departure_buffer=resource.buffer_after,arrival_buffer=resource.buffer_before} as booking\n    create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_1\n    create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_1.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_1\n    if use_allowance\n     set booking {allowance=pending}\n    schedule booking.id at=booking.expires event=HoldDue {booking}\n    emit ReservationChanged {booking,revision=booking.version}\n    return booking\n  # Move a still-held interval atomically while retaining the original on conflict. @{nl=\"Verplaats een nog tijdelijke reservering atomair en behoud bij een conflict het oorspronkelijke tijdvak.\"}\n  export scenario move(booking:Booking,from:datetime label=label_RoomRequest_from,until:datetime label=label_RoomRequest_until) by=authenticated label=\"Move held booking\"@{nl=\"Tijdelijke reservering verplaatsen\"}\n   require may_move(booking)\n   require booking.account==actor and booking.status in [held,confirmed] and booking.allowance==not_required and count(booking.intervals)==0 and booking.checked_in==null and from>=now and from<until and until-from==booking.until-booking.from\n   require free(booking.parent,from-booking.parent.buffer_before,until+booking.parent.buffer_after,booking.quantity,booking)\n   do\n    set booking {from,until,reserved_from=from-booking.parent.buffer_before,reserved_until=until+booking.departure_buffer}\n    create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_move\n    create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_move.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_move\n    emit ReservationChanged {booking,revision=booking.version+1}\n   examples seed=[test_admin,open_site,quote_window] booking=test_hold from=datetime(\"2099-01-01T11:00:00Z\") until=datetime(\"2099-01-01T12:00:00Z\")\n    as,test_admin.active,test_admin.locations,test_company.active -> booking.from\n    self,true,[test_site],true -> datetime(\"2099-01-01T11:00:00Z\")\n    self,false,[test_site],true -> error(rule_failed)\n    self,true,[],true -> error(rule_failed)\n    self,true,[test_site],false -> error(rule_failed)\n   examples seed=[history_worker,open_site,quote_window] booking=test_hold from=datetime(\"2099-01-01T11:00:00Z\") until=datetime(\"2099-01-01T12:00:00Z\")\n    as,booking.account,history_worker.active -> booking.from\n    history_user,history_user,true -> datetime(\"2099-01-01T11:00:00Z\")\n    history_user,history_user,false -> error(rule_failed)\n  # Move all local days in one transaction and retain the original on any conflict. @{nl=\"Verplaats alle lokale dagen in één transactie en behoud bij elk conflict het origineel.\"}\n  export scenario move_days(booking:Booking,start:date,end:date) by=authenticated label=\"Move workspace days\"@{nl=\"Werkplekdagen verplaatsen\"}\n   require may_move(booking)\n   require booking.account==actor and booking.status in [held,confirmed] and booking.allowance==not_required and booking.quote==null and booking.checked_in==null and count(booking.intervals)>0 and start<end\n   do\n    let access=booking.parent.DayCalendar as day where start<=day.day and day.day<end and not day.closed order=day.day select BookingInterval {from=local_instant(day.day,day.opens,booking.parent.timezone,fold=day.fold)-booking.parent.buffer_before,until=local_instant(day.day,day.closes,booking.parent.timezone,fold=day.fold)+booking.departure_buffer}\n    require count(access)==count(booking.intervals) and count(access)==count(dates(start,end,1000))\n    require all(access as interval,now<=interval.from and free(booking.parent,interval.from,interval.until,booking.quantity,booking))\n    let first_day=at(access,0)\n    let last_day=at(access,count(access)-1)\n    set booking {intervals=access,from=first_day.from+booking.parent.buffer_before,until=last_day.until-booking.departure_buffer,reserved_from=first_day.from,reserved_until=last_day.until}\n    create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_1\n    create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_1.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_1\n    emit ReservationChanged {booking,revision=booking.version+1}\n   examples seed=[test_admin,open_site,quote_window,quote_day] booking=test_hold start=date(\"2099-01-01\") end=date(\"2099-01-02\")\n    as,test_admin.active,test_admin.locations,booking.intervals -> booking.from\n    self,true,[test_site],[{from=booking.from,until=booking.until}] -> datetime(\"2099-01-01T08:00:00Z\")\n    self,false,[test_site],[{from=booking.from,until=booking.until}] -> error(rule_failed)\n    self,true,[],[{from=booking.from,until=booking.until}] -> error(rule_failed)\n  # Retain the current capacity and consumed benefit until the candidate commits. @{nl=\"Behoud de huidige capaciteit en het verbruikte voordeel totdat de kandidaat vastgelegd is.\"}\n  export scenario move_membership(booking:Booking,from:datetime,until:datetime) by=authenticated label=\"Move member workspace\"@{nl=\"Ledenwerkplek verplaatsen\"}\n   require may_move(booking)\n   require booking.account==actor and booking.status==confirmed and booking.allowance==consumed and booking.quote==null and booking.checked_in==null and now<booking.refund_before\n   require not any(booking.Movement as movement,movement.state in [holding,waiting_money,committing,cancelling,review])\n   require booking.benefit_unit==hour and from<until and until-from==booking.until-booking.from\n   do\n    let access=[BenefitInterval {from,until}]\n    require all(access as interval,now<=interval.from and free(booking.parent,interval.from-booking.arrival_buffer,interval.until+booking.departure_buffer,booking.quantity,booking))\n    create Movement {parent=booking,source=operation.id,intervals=access,expires=now+booking.parent.hold_for} as movement\n    send Membership.reserve {value=movement_request(movement)} as allocation\n    set movement {reserve_delivery=allocation.id}\n    schedule movement.id at=movement.expires event=MovementDue {movement}\n  export scenario move_membership_days(booking:Booking,start:date,end:date) by=authenticated label=\"Move member workspace days\"@{nl=\"Ledenwerkplekdagen verplaatsen\"}\n   require may_move(booking)\n   require booking.account==actor and booking.status==confirmed and booking.allowance==consumed and booking.quote==null and booking.checked_in==null and now<booking.refund_before\n   require not any(booking.Movement as movement,movement.state in [holding,waiting_money,committing,cancelling,review])\n   require booking.benefit_unit==day and start<end\n   do\n    let access=booking.parent.DayCalendar as day where start<=day.day and day.day<end and not day.closed order=day.day select BenefitInterval {from=local_instant(day.day,day.opens,booking.parent.timezone,fold=day.fold),until=local_instant(day.day,day.closes,booking.parent.timezone,fold=day.fold)}\n    require count(access)==count(booking.benefit_intervals) and count(access)==count(dates(start,end,1000))\n    require all(access as interval,now<=interval.from and free(booking.parent,interval.from-booking.arrival_buffer,interval.until+booking.departure_buffer,booking.quantity,booking))\n    create Movement {parent=booking,source=operation.id,intervals=access,expires=now+booking.parent.hold_for} as movement\n    send Membership.reserve {value=movement_request(movement)} as allocation\n    set movement {reserve_delivery=allocation.id}\n    schedule movement.id at=movement.expires event=MovementDue {movement}\n  scenario movement_reserved on=Membership.reserve.completed\n   do\n    for movement in Movement as row where row.reserve_delivery==event.delivery_id limit=1\n     if event.status==succeeded and event.result!=null and event.result.source==movement.source\n      emit MovementObserved {movement,value=event.result}\n     if event.status==failed and movement.state==holding\n      set movement {state=cancelling}\n      send Membership.release {source=movement.source,customer=movement.parent.customer.id} as release\n      set movement {release_delivery=release.id}\n      send Billing.cancel {source=movement.source,reason=\"Workspace move abandoned\"} as cancellation\n  scenario movement_committed on=Membership.commit.completed\n   do\n    for movement in Movement as row where row.commit_delivery==event.delivery_id limit=1\n     if event.status==succeeded and event.result!=null and event.result.source==movement.source\n      emit MovementObserved {movement,value=event.result}\n     if event.status==failed and movement.state==committing\n      set movement {state=cancelling}\n      send Membership.release {source=movement.source,customer=movement.parent.customer.id} as release\n      set movement {release_delivery=release.id}\n      send Billing.cancel {source=movement.source,reason=\"Workspace move abandoned\"} as cancellation\n  scenario movement_changed on=Membership.allowance_changed\n   do\n    for movement in Movement as row where row.source==event.value.source limit=1\n     emit MovementObserved {movement,value=event.value}\n  scenario movement_result on=MovementObserved\n   require event.value.source==event.movement.source\n   do\n    let movement=event.movement\n    let booking=movement.parent\n    if event.value.phase==staged and event.value.state==confirmed and movement.state in [holding,waiting_money]\n     require event.value.unit==booking.benefit_unit and event.value.duration==booking.benefit_duration and event.value.rate==(booking.benefit_rate??booking.rate)\n     let discount=event.value.overage*booking.discount_fraction\n     let tax=(event.value.overage-discount)*booking.tax_fraction\n     let balance=event.value.overage-discount+tax\n     let old_balance=booking.service_due??booking.monetary_due??booking.total\n     if now<booking.refund_before and now<movement.expires and booking.status==confirmed and booking.checked_in==null and all(movement.intervals as interval,free(booking.parent,interval.from-booking.arrival_buffer,interval.until+booking.departure_buffer,0,null))\n      if balance<=old_balance or movement.extra_paid\n       set movement {state=committing,outcome=event.value,credit_due=max(money(0,booking.total.currency),old_balance-balance)}\n       send Membership.commit {source=movement.source,customer=booking.customer.id} as commit\n       set movement {commit_delivery=commit.id}\n      else\n       if movement.extra_delivery==null\n        let extra=balance-old_balance\n        create Adjustment {parent=booking,source=movement.source,amount=extra,reason=\"Membership movement overage\",movement} as adjustment\n        send Billing.charge {value={source=movement.source,customer=booking.customer.id,location=booking.parent.location.id,description=\"Membership movement overage\",amount=extra,due=local_date(at(movement.intervals,0).from,booking.parent.timezone),terms=booking.terms,items=[DocumentLine {title=\"Workspace movement balance\",quantity=1,price=event.value.overage-(booking.allowance_base??booking.subtotal),discount=discount-(booking.allowance_discount??booking.discount),tax=tax-(booking.allowance_tax??booking.tax),unit=\"adjustment\",from=at(movement.intervals,0).from,until=at(movement.intervals,count(movement.intervals)-1).until,location=booking.parent.location.name,reference=movement.source}]}} as charge\n        set adjustment {delivery=charge.id}\n        set movement {state=waiting_money,outcome=event.value,extra_due=extra,extra_delivery=charge.id}\n     else\n      set movement {state=cancelling,outcome=event.value}\n      send Membership.release {source=movement.source,customer=booking.customer.id} as release\n      set movement {release_delivery=release.id}\n      send Billing.cancel {source=movement.source,reason=\"Workspace move unavailable\"} as cancellation\n    if event.value.phase==consumed and event.value.state==confirmed and movement.state==committing\n     if booking.status==confirmed and booking.checked_in==null and all(movement.intervals as interval,free(booking.parent,interval.from-booking.arrival_buffer,interval.until+booking.departure_buffer,0,null))\n      let first=at(movement.intervals,0)\n      let last=at(movement.intervals,count(movement.intervals)-1)\n      set booking {from=first.from,until=last.until,reserved_from=first.from-booking.arrival_buffer,reserved_until=last.until+booking.departure_buffer,service_due=event.value.overage-event.value.overage*booking.discount_fraction+(event.value.overage-event.value.overage*booking.discount_fraction)*booking.tax_fraction,allowance_base=event.value.overage,allowance_discount=event.value.overage*booking.discount_fraction,allowance_tax=(event.value.overage-event.value.overage*booking.discount_fraction)*booking.tax_fraction,allowance_source=movement.source,allowance_revision=event.value.revision,allowance_units=event.value.units,included_units=event.value.covered_units}\n      if booking.benefit_unit==day\n       set booking {intervals=movement.intervals as interval select BookingInterval {from=interval.from-booking.arrival_buffer,until=interval.until+booking.departure_buffer}}\n      else\n       set booking {intervals=[]}\n      create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_1\n      create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_1.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_1\n      set movement {state=adopted,outcome=event.value}\n      cancel movement.id\n      emit ReservationChanged {booking,revision=booking.version+1}\n     else\n      set movement {state=review,outcome=event.value}\n      set booking {status=review,refund_state=review}\n      create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_4\n      create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_4.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_4\n      emit CommercialCheck {booking}\n    if event.value.phase==released and movement.state in [holding,waiting_money,cancelling]\n     set movement {state=cancelled,outcome=event.value}\n     emit MovementCleared {movement}\n  scenario movement_money on=SettlementObserved\n   do\n    for movement in Movement as row where row.source==event.value.source limit=1\n     require movement.extra_due!=null and event.value.amount==movement.extra_due\n     if event.value.revision>movement.extra_revision\n      set movement {extra_revision=event.value.revision}\n      if event.value.collected-event.value.refunded>=movement.extra_due\n       set movement {extra_paid=true}\n       if movement.state==waiting_money and movement.outcome!=null\n        emit MovementObserved {movement,value=movement.outcome}\n       if movement.state in [cancelling,cancelled,review]\n        for adjustment in movement.parent.Adjustment as row where row.source==movement.source limit=1\n         set adjustment {state=review}\n  scenario refund_movement_credit(movement:Movement,charge_source:text,amount:money,reason:text) by=billing label=\"Refund movement credit\"@{nl=\"Verplaatsingstegoed terugbetalen\"}\n   require can_work(actor,movement.parent.parent.location) and movement.state==adopted and movement.credit_due!=null and amount.currency==movement.credit_due.currency and amount.minor>0 and trim(reason)!=\"\"\n   require amount<=movement.credit_due-sum(movement.MovementCredit as credit where credit.state!=failed select credit.amount,movement.credit_due.currency)\n   do\n    let booking=movement.parent\n    if charge_source==booking.source\n     require booking.collected!=null and booking.refunded!=null and amount<=booking.collected-booking.refunded\n     send Billing.refund {source=charge_source,amount,reason} as refund\n     create MovementCredit {parent=movement,charge_source,amount,baseline=credit_baseline(charge_source,booking.refunded),delivery=refund.id,reason} as credit\n    else\n     let adjustment=first(booking.Adjustment as row where row.source==charge_source and row.state==paid)\n     require adjustment!=null and adjustment.collected!=null and adjustment.refunded!=null and amount<=adjustment.collected-adjustment.refunded\n     send Billing.refund {source=charge_source,amount,reason} as refund\n     create MovementCredit {parent=movement,charge_source,amount,baseline=credit_baseline(charge_source,adjustment.refunded),delivery=refund.id,reason} as credit\n  scenario movement_credit_result on=Billing.refund.completed\n   do\n    for credit in MovementCredit as row where row.delivery==event.delivery_id limit=1\n     if event.status==failed\n      set credit {state=failed}\n     if event.status==unknown\n      set credit {state=unknown}\n     if event.status==succeeded and event.result!=null and event.result.state==unavailable\n      set credit {state=review}\n  scenario movement_credit_money on=SettlementObserved\n   do\n    for credit in MovementCredit as row where row.charge_source==event.value.source and row.state!=paid limit=1000\n     if event.value.refunded>=credit.baseline+credit.amount\n      set credit {state=paid}\n  export scenario abandon_movement(movement:Movement) by=authenticated label=\"Abandon workspace move\"@{nl=\"Werkplekverplaatsing afbreken\"}\n   require movement.parent.account==actor and movement.state in [holding,waiting_money]\n   do\n    set movement {state=cancelling}\n    send Membership.release {source=movement.source,customer=movement.parent.customer.id} as release\n    set movement {release_delivery=release.id}\n    send Billing.cancel {source=movement.source,reason=\"Workspace move abandoned\"} as cancellation\n    cancel movement.id\n  scenario movement_expire on=MovementDue\n   require event.movement.state in [holding,waiting_money] and event.movement.expires<=now\n   do\n    set event.movement {state=cancelling}\n    send Membership.release {source=event.movement.source,customer=event.movement.parent.customer.id} as release\n    set event.movement {release_delivery=release.id}\n    send Billing.cancel {source=event.movement.source,reason=\"Workspace move expired\"} as cancellation\n  scenario movement_released on=Membership.release.completed\n   do\n    for movement in Movement as row where row.release_delivery==event.delivery_id limit=1\n     if event.status==succeeded and event.result!=null and event.result.source==movement.source and event.result.state==released and movement.state==cancelling\n      set movement {state=cancelled}\n      emit MovementCleared {movement}\n  scenario movement_cancellation on=MovementCleared\n   do\n    let booking=event.movement.parent\n    if booking.status==cancelled and booking.allowance!=not_required and booking.release_delivery==null and not any(booking.Movement as movement,movement.state in [holding,waiting_money,committing,cancelling,review]) and (booking.allowance in [pending,reserved] or booking.cancellation_restore)\n     send Membership.release {source=booking.allowance_source??booking.source,customer=booking.customer.id,restore_consumed=booking.cancellation_restore} as release\n     set booking {release_delivery=release.id}\n  export scenario retry_movement_cleanup(movement:Movement) by=authenticated label=\"Retry workspace move cleanup\"@{nl=\"Opruimen werkplekverplaatsing opnieuw proberen\"}\n   require movement.parent.account==actor and movement.state==cancelling\n   do\n    send Membership.release {source=movement.source,customer=movement.parent.customer.id,restore_consumed=movement.release_restore} as release\n    set movement {release_delivery=release.id}\n  export scenario reconcile_movement(movement:Movement) by=authenticated label=\"Reconcile workspace move\"@{nl=\"Werkplekverplaatsing reconciliëren\"}\n   require movement.parent.account==actor and movement.state in [holding,waiting_money,committing,cancelling,review]\n   do\n    send Membership.reconcile {source=movement.source,customer=movement.parent.customer.id} as reconciliation\n    set movement {reconcile_delivery=reconciliation.id}\n  scenario movement_reconciled on=Membership.reconcile.completed\n   do\n    for movement in Movement as row where row.reconcile_delivery==event.delivery_id limit=1\n     if event.status==succeeded and event.result!=null and event.result.source==movement.source\n      emit MovementObserved {movement,value=event.result}\n  # Record a timed or indefinite repair block without erasing affected bookings. @{nl=\"Leg een tijdelijke of onbepaalde reparatieblokkade vast zonder getroffen reserveringen te wissen.\"}\n  scenario block(resource:Resource,from:datetime label=label_RoomRequest_from,until:datetime? label=label_RoomRequest_until,reason:text) by=reservation_manager label=\"Block for repair\"@{nl=\"Blokkeren voor reparatie\"}\n   require can_work(actor,resource.location) and trim(reason)!=\"\" and (until==null or from<until)\n   do\n    create Downtime {parent=resource,source=operation.id,from,until,reason} as downtime\n    create ResourcePolicy {parent=downtime.parent,sequence=count(downtime.parent.ResourcePolicy)+1,value=resource_evidence(downtime.parent)} as policy_snapshot_1\n    create DowntimeEvidence {parent=downtime.parent,sequence=policy_snapshot_1.sequence,key=downtime.id,value=report_downtime(downtime)} as downtime_evidence_1\n    for booking in resource.Booking as b where busy(b) and b.reserved_from<(until??b.reserved_until) and from<b.reserved_until limit=1000\n     create Conflict {parent=resource,booking,reason} as conflict\n  # Restore only the specified manager-verified repair block. @{nl=\"Herstel alleen de opgegeven reparatieblokkade die een beheerder heeft geverifieerd.\"}\n  scenario restore(downtime:Downtime,evidence:text) by=reservation_manager label=\"Restore availability\"@{nl=\"Beschikbaarheid herstellen\"}\n   require can_work(actor,downtime.parent.location) and downtime.active and trim(evidence)!=\"\"\n   do\n    set downtime {active=false,verified_by=actor,verification=evidence}\n    create ResourcePolicy {parent=downtime.parent,sequence=count(downtime.parent.ResourcePolicy)+1,value=resource_evidence(downtime.parent)} as policy_snapshot_1\n    create DowntimeEvidence {parent=downtime.parent,sequence=policy_snapshot_1.sequence,key=downtime.id,value=report_downtime(downtime)} as downtime_evidence_1\n  # Queue this booking's charge and optional allowance reservation once. @{nl=\"Zet de kosten en optionele tegoedreservering voor deze reservering eenmalig in de wachtrij.\"}\n  export scenario prepare(booking:Booking,use_allowance:bool=false label=label_hold_use_allowance) by=authenticated or reception label=\"Request booking fulfillment\"@{nl=\"Reserveringsuitvoering aanvragen\"}\n   require (booking.account==actor or (reception and can_work(actor,booking.parent.location))) and booking.status==held and booking.billing_delivery==null and now<booking.expires and booking.total.minor>0\n   do\n    if use_allowance or booking.allowance==pending\n     send Membership.reserve {value=benefit_request(booking)} as allocation\n     set booking {status=pending,allowance=pending,allowance_delivery=allocation.id}\n     create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_1\n     create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_1.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_1\n    else\n     send Billing.charge {value=charge_request(booking,booking.subtotal,booking.discount,booking.tax)} as charge\n     set booking {status=pending,payment=pending,billing_delivery=charge.id,monetary_due=booking.total}\n     create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_2\n     create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_2.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_2\n  # Admit a fulfilled booking and retain physical possession beyond its estimated end. @{nl=\"Laat een voldane reservering toe en behoud werkelijk gebruik na de geschatte eindtijd.\"}\n  export scenario arrive(booking:Booking) by=reception label=\"Record arrival\"@{nl=\"Aankomst vastleggen\"}\n   require can_work(actor,booking.parent.location) and booking.status==confirmed and booking.payment in [paid,free,on_account] and booking.allowance in [not_required,consumed]\n   require (count(booking.intervals)==0 and booking.from<=now and now<booking.until) or any(booking.intervals as interval,interval.from+booking.arrival_buffer<=now and now<interval.until-booking.departure_buffer)\n   require bookable(booking) and (booking.payment!=paid or financial_cover(booking)) and booking.customer.active and (booking.payment!=on_account or credit_allowed(booking.customer,booking.parent))\n   do\n    set booking {status=occupied,checked_in=now}\n    create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_1\n    create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_1.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_1\n    schedule booking.source+\":occupancy\" at=booking.until event=OccupancyDue {booking}\n    emit ReservationChanged {booking,revision=booking.version+1}\n  scenario overdue_occupancy on=OccupancyDue\n   require event.booking.checked_in!=null and event.booking.checked_out==null and event.booking.until<=now\n   do\n    set event.booking {overdue=true}\n    for booking in event.booking.parent.Booking as row where row!=event.booking and busy(row) limit=1000\n     if not bookable(booking)\n      create Conflict {parent=booking.parent,booking,reason=\"Overdue occupant retains capacity\"} as conflict\n  # Clear only this booking's current physical possession. @{nl=\"Beëindig alleen het huidige werkelijke gebruik van deze reservering.\"}\n  export scenario depart(booking:Booking) by=reception label=\"Record departure\"@{nl=\"Vertrek vastleggen\"}\n   require can_work(actor,booking.parent.location) and booking.checked_in!=null and booking.checked_out==null\n   do\n    cancel booking.source+\":occupancy\"\n    set booking {status=completed,overdue=false,checked_out=now,reserved_until=max(booking.reserved_until,now+booking.departure_buffer)}\n    create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_1\n    create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_1.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_1\n    emit ReservationChanged {booking,revision=booking.version+1}\n  # Disable future admission while retaining physical possession and refund evidence. @{nl=\"Blokkeer toekomstige toegang en behoud bewijs van werkelijk gebruik en terugbetaling.\"}\n  export scenario cancel_booking(booking:Booking,reason:text) by=authenticated or reception label=\"Cancel booking\"@{nl=\"Reservering annuleren\"}\n   require (booking.account==actor or (reception and can_work(actor,booking.parent.location))) and not (booking.status in [cancelled,completed]) and trim(reason)!=\"\"\n   do\n    let restore=booking.status in [held,pending] or now<booking.refund_before\n    set booking {status=cancelled,cancellation_reason=reason,cancellation_restore=restore}\n    create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_1\n    create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_1.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_1\n    cancel booking.id\n    for movement in booking.Movement as row where row.state in [holding,waiting_money,committing] limit=100\n     set movement {state=cancelling,release_restore=restore}\n     send Membership.release {source=movement.source,customer=booking.customer.id,restore_consumed=restore} as release\n     set movement {release_delivery=release.id}\n     send Billing.cancel {source=movement.source,reason} as cancellation\n     cancel movement.id\n    if booking.allowance!=not_required and booking.release_delivery==null and not any(booking.Movement as movement,movement.state in [cancelling,review]) and (booking.allowance in [pending,reserved] or restore)\n     send Membership.release {source=booking.allowance_source??booking.source,customer=booking.customer.id,restore_consumed=restore} as allowance_release\n     set booking {release_delivery=allowance_release.id}\n    send Billing.cancel {source=booking.source,reason} as invoice_cancel\n    set booking {cancel_delivery=invoice_cancel.id}\n    if booking.payment==paid and now<booking.refund_before and booking.refund_amount.minor>0\n     send Billing.refund {source=booking.source,amount=max(money(0,booking.total.currency),(booking.monetary_due??booking.total)-(booking.total-booking.refund_amount)),reason} as refund\n     set booking {refund_delivery=refund.id,refund_state=pending,refund_requested=max(money(0,booking.total.currency),(booking.monetary_due??booking.total)-(booking.total-booking.refund_amount))}\n    emit ReservationChanged {booking,revision=booking.version+1}\n   ## A committed cancellation captures one marker and one fact; rejections commit nothing.\n   examples seed=[test_hold] booking=test_hold reason=\"Customer request\"\n    booking.status,reason -> booking.status,count(test_room.ResourcePolicy),count(test_room.BookingEvidence)\n    held,\"Customer request\" -> cancelled,1,1\n    cancelled,\"Customer request\" -> error(rule_failed)\n    held,\" \" -> error(rule_failed)\n  scenario venue_move on=RoomsIngressV1.move\n   require event.value.price==null and event.value.terms==null and event.value.from>=now and event.value.from<event.value.until\n   do\n    for venue in VenueReservation as row where row.source==event.value.source and row.parent.id==event.value.resource limit=1\n     require venue.status in [held,confirmed] and venue.account==event.value.account and venue.customer==event.value.customer and venue.quantity==event.value.quantity and venue.version==event.value.revision\n     require free(venue.parent,event.value.from-venue.parent.buffer_before,event.value.until+venue.parent.buffer_after,venue.quantity,null,venue)\n     set venue {from=event.value.from-venue.parent.buffer_before,until=event.value.until+venue.parent.buffer_after}\n     create ResourcePolicy {parent=venue.parent,sequence=count(venue.parent.ResourcePolicy)+1,value=resource_evidence(venue.parent)} as policy_snapshot_1\n     create VenueEvidence {parent=venue.parent,sequence=policy_snapshot_1.sequence,key=venue.id,value=report_venue(venue)} as venue_evidence_1\n     emit VenueOutcome {value={source=venue.source,revision=venue.version+1,state=confirmed,reference=venue.id,detail=\"Venue interval moved\"}}\n  scenario requested_affected on=RoomsIngressV1.affected\n   do\n    for downtime in Downtime as row where row.source==event.source and row.parent.id==event.resource limit=1\n     emit AffectedOutcome {value=AffectedBookings {source=event.source,resource=event.resource,revision=downtime.version,checked_at=now,items=downtime.parent.Booking as booking where busy(booking) and overlaps(booking.reserved_from,booking.reserved_until,downtime.from,downtime.until??booking.reserved_until) select AffectedBooking {reference=booking.id,revision=booking.version,from=booking.from,until=booking.until,quantity=booking.quantity,status=booking.status,conflict=null}}}\n  scenario requested_downtime on=RoomsIngressV1.downtime\n   require event.until==null or event.from<event.until\n   do\n    for resource in Resource as row where row.id==event.resource limit=1\n     if any(resource.DowntimeFence as fence,fence.source==event.source)\n      emit VenueOutcome {value={source=event.source,revision=1,state=released,detail=\"Previously restored downtime\"}}\n     else\n      let existing=first(resource.Downtime as downtime where downtime.source==event.source)\n      if existing!=null\n       require existing.from==event.from and existing.until==event.until\n       if existing.active\n        emit VenueOutcome {value={source=event.source,revision=existing.version,state=confirmed,reference=existing.id}}\n       else\n        emit VenueOutcome {value={source=event.source,revision=existing.version,state=released,reference=existing.id}}\n      else\n       create Downtime {parent=resource,source=event.source,from=event.from,until=event.until,reason=\"Requested maintenance\"} as downtime\n       create ResourcePolicy {parent=downtime.parent,sequence=count(downtime.parent.ResourcePolicy)+1,value=resource_evidence(downtime.parent)} as policy_snapshot_1\n       create DowntimeEvidence {parent=downtime.parent,sequence=policy_snapshot_1.sequence,key=downtime.id,value=report_downtime(downtime)} as downtime_evidence_1\n       for booking in resource.Booking as b where busy(b) and b.reserved_from<(event.until??b.reserved_until) and event.from<b.reserved_until limit=1000\n        create Conflict {parent=resource,booking,downtime,reason=\"Requested maintenance\"} as conflict\n       emit VenueOutcome {value={source=event.source,revision=downtime.version,state=confirmed,reference=downtime.id}}\n  scenario requested_restore on=RoomsIngressV1.restore\n   require trim(event.evidence)!=\"\"\n   do\n    for resource in Resource as row where row.id==event.resource limit=1\n     let fence=first(resource.DowntimeFence as fence where fence.source==event.source)\n     require fence==null or fence.evidence==event.evidence\n     if fence==null\n      create DowntimeFence {parent=resource,source=event.source,evidence=event.evidence} as restored_fence\n     if not any(resource.Downtime as downtime,downtime.source==event.source)\n      emit VenueOutcome {value={source=event.source,revision=1,state=released,detail=event.evidence}}\n     for downtime in resource.Downtime as row where row.source==event.source limit=1\n      if downtime.active\n       set downtime {active=false,verification=event.evidence}\n       create ResourcePolicy {parent=downtime.parent,sequence=count(downtime.parent.ResourcePolicy)+1,value=resource_evidence(downtime.parent)} as policy_snapshot_1\n       create DowntimeEvidence {parent=downtime.parent,sequence=policy_snapshot_1.sequence,key=downtime.id,value=report_downtime(downtime)} as downtime_evidence_1\n       emit VenueOutcome {value={source=event.source,revision=downtime.version+1,state=released,reference=downtime.id,detail=event.evidence}}\n      else\n       emit VenueOutcome {value={source=event.source,revision=downtime.version,state=released,reference=downtime.id,detail=downtime.verification}}\n  scenario venue_hold on=RoomsIngressV1.hold\n   require event.value.price==null and event.value.terms==null and event.value.from>=now and event.value.from<event.value.until and event.value.quantity>0\n   do\n    for resource in Resource as row where row.id==event.value.resource limit=1\n     require not any(resource.VenueFence as fence,fence.source==event.value.source)\n     require not any(resource.VenueReservation as venue,venue.source==event.value.source)\n     require free(resource,event.value.from-resource.buffer_before,event.value.until+resource.buffer_after,event.value.quantity,null)\n     create VenueReservation {parent=resource,source=event.value.source,request_revision=event.value.revision,customer=event.value.customer,account=event.value.account,from=event.value.from-resource.buffer_before,until=event.value.until+resource.buffer_after,quantity=event.value.quantity,expires=now+resource.hold_for} as venue\n     create ResourcePolicy {parent=venue.parent,sequence=count(venue.parent.ResourcePolicy)+1,value=resource_evidence(venue.parent)} as policy_snapshot_1\n     create VenueEvidence {parent=venue.parent,sequence=policy_snapshot_1.sequence,key=venue.id,value=report_venue(venue)} as venue_evidence_1\n     schedule venue.id at=venue.expires event=VenueDue {venue}\n     emit VenueOutcome {value={source=venue.source,revision=venue.version,state=pending,reference=venue.id,detail=\"Provisional appointment venue\",}}\n  scenario venue_stage on=RoomsIngressV1.stage\n   require event.value.price==null and event.value.terms==null and event.value.from>=now and event.value.from<event.value.until\n   do\n    for previous in VenueReservation as row where row.source==event.previous_source and row.parent.id==event.value.resource limit=1\n     require previous.version==event.previous_revision and previous.status==confirmed and previous.parent.id==event.value.resource and previous.account==event.value.account and previous.customer==event.value.customer and previous.quantity==event.value.quantity\n     require not any(previous.parent.VenueFence as fence,fence.source==event.value.source)\n     require not any(previous.parent.VenueReservation as venue,venue.source==event.value.source or (venue.previous==previous and venue_busy(venue)))\n     require free(previous.parent,event.value.from-previous.parent.buffer_before,event.value.until+previous.parent.buffer_after,event.value.quantity,null,previous)\n     create VenueReservation {parent=previous.parent,source=event.value.source,request_revision=event.value.revision,customer=event.value.customer,account=event.value.account,from=event.value.from-previous.parent.buffer_before,until=event.value.until+previous.parent.buffer_after,quantity=event.value.quantity,expires=now+previous.parent.hold_for,status=staged,previous} as venue\n     create ResourcePolicy {parent=venue.parent,sequence=count(venue.parent.ResourcePolicy)+1,value=resource_evidence(venue.parent)} as policy_snapshot_1\n     create VenueEvidence {parent=venue.parent,sequence=policy_snapshot_1.sequence,key=venue.id,value=report_venue(venue)} as venue_evidence_1\n     schedule venue.id at=venue.expires event=VenueDue {venue}\n     emit VenueOutcome {value={source=venue.source,revision=venue.version,state=pending,reference=venue.id,detail=\"Candidate held; predecessor retained\"}}\n  scenario venue_confirm on=RoomsIngressV1.confirm\n   do\n    for venue in VenueReservation as row where row.source==event.source and row.parent.id==event.resource limit=1\n     require venue.status in [held,staged] and now<venue.expires\n     require free(venue.parent,venue.from,venue.until,0,null)\n     set venue {status=confirmed}\n     create ResourcePolicy {parent=venue.parent,sequence=count(venue.parent.ResourcePolicy)+1,value=resource_evidence(venue.parent)} as policy_snapshot_1\n     create VenueEvidence {parent=venue.parent,sequence=policy_snapshot_1.sequence,key=venue.id,value=report_venue(venue)} as venue_evidence_1\n     cancel venue.id\n     emit VenueOutcome {value={source=venue.source,revision=venue.version+1,state=confirmed,reference=venue.id,detail=\"Appointment venue confirmed\"}}\n  scenario venue_release on=RoomsIngressV1.release\n   do\n    for resource in Resource as row where row.id==event.resource limit=1\n     if not any(resource.VenueFence as fence,fence.source==event.source)\n      create VenueFence {parent=resource,source=event.source,reason=event.reason} as fence\n     if not any(resource.VenueReservation as venue,venue.source==event.source)\n      emit VenueOutcome {value={source=event.source,revision=1,state=released,detail=event.reason}}\n     for venue in resource.VenueReservation as row where row.source==event.source limit=1\n      if venue.status in [held,staged,confirmed]\n       set venue {status=released,reason=event.reason}\n       create ResourcePolicy {parent=venue.parent,sequence=count(venue.parent.ResourcePolicy)+1,value=resource_evidence(venue.parent)} as policy_snapshot_1\n       create VenueEvidence {parent=venue.parent,sequence=policy_snapshot_1.sequence,key=venue.id,value=report_venue(venue)} as venue_evidence_1\n       cancel venue.id\n       emit VenueOutcome {value={source=venue.source,revision=venue.version+1,state=released,reference=venue.id,detail=event.reason}}\n      else\n       emit VenueOutcome {value={source=venue.source,revision=venue.version,state=released,reference=venue.id,detail=event.reason}}\n   examples seed=[test_room] event={source=\"released-before-arrival\",resource=test_room.id,reason=\"Abandoned candidate\"}\n    event.source -> count(test_room.VenueFence)\n    \"released-before-arrival\" -> 1\n  scenario venue_expire on=VenueDue\n   require event.venue.status in [held,staged] and event.venue.expires<=now\n   do\n    set event.venue {status=expired}\n    create ResourcePolicy {parent=event.venue.parent,sequence=count(event.venue.parent.ResourcePolicy)+1,value=resource_evidence(event.venue.parent)} as policy_snapshot_1\n    create VenueEvidence {parent=event.venue.parent,sequence=policy_snapshot_1.sequence,key=event.venue.id,value=report_venue(event.venue)} as venue_evidence_1\n    emit VenueOutcome {value={source=event.venue.source,revision=event.venue.version+1,state=unavailable,reference=event.venue.id,detail=\"Venue hold expired\"}}\n  scenario quote_hold on=RoomsIngressV1.hold_offer\n   require event.value.hold_until>now and event.value.hold_until<=event.value.snapshot.expires and event.value.snapshot.resource==event.value.resource and event.value.snapshot.quantity==event.value.quantity and event.value.snapshot.attendees==event.value.attendees and event.value.snapshot.recipient==event.value.recipient and event.value.quantity>0 and event.value.attendees>0\n   do\n    for resource in Resource as row where row.id==event.value.resource limit=1\n     require resource.location.id==event.value.location and event.value.attendees<=resource.party_limit and (not resource.pooled or event.value.attendees<=event.value.quantity)\n     require event.value.snapshot.total.currency==resource.currency and event.value.snapshot.total.minor>=0 and event.value.snapshot.from>=now and event.value.snapshot.from<event.value.snapshot.until\n     require all(event.value.snapshot.lines as item,item.quantity>=0 and (item.quantity>0 or item.price*item.quantity+item.tax-item.discount==money(0,item.price.currency)) and item.price.currency==resource.currency and item.tax.currency==resource.currency and item.discount.currency==resource.currency and item.price.minor>=0 and item.tax.minor>=0 and item.discount.minor>=0 and item.discount<=item.price*item.quantity+item.tax)\n     require event.value.snapshot.total==sum(event.value.snapshot.lines as item select item.price*item.quantity+item.tax-item.discount,resource.currency)\n     require not any(resource.ReservationFence as fence,fence.source==event.value.source and fence.revision==event.value.revision)\n     require not any(resource.QuoteHold as hold,hold.source==event.value.source)\n     require quote_available(resource,event.value.snapshot,event.value.quantity)\n     create QuoteHold {parent=resource,source=event.value.source,revision=event.value.revision,offer=event.value,quantity=event.value.quantity,from=event.value.snapshot.from-resource.buffer_before,until=event.value.snapshot.until+resource.buffer_after,intervals=event.value.snapshot.intervals as interval select BookingInterval {from=interval.from-resource.buffer_before,until=interval.until+resource.buffer_after},expires=event.value.hold_until} as hold\n     schedule hold.id at=hold.expires event=QuoteDue {hold}\n     emit OfferOutcome {value={source=hold.source,revision=hold.revision,kind=ReservationOfferOutcome.kind.hold,version=hold.version,state=confirmed,reference=hold.id,expires=hold.expires}}\n  scenario quote_accept on=RoomsIngressV1.accept_offer\n   require event.value.accepted_at<=now and event.value.accepted_at<=event.value.snapshot.expires and event.value.snapshot.resource==event.value.resource and event.value.snapshot.quantity==event.value.quantity and event.value.snapshot.attendees==event.value.attendees and event.value.snapshot.recipient==event.value.recipient and event.value.quantity>0 and event.value.attendees>0\n   require (event.value.attribution==null and event.value.exclusive_program==null and event.value.attributed_at==null and event.value.attribution_window==null) or (event.value.attribution!=null and event.value.exclusive_program!=null and event.value.attributed_at!=null and event.value.attribution_window!=null and event.value.attribution_window>0m and event.value.attributed_at<=event.value.accepted_at and event.value.accepted_at<=event.value.attributed_at+event.value.attribution_window)\n   do\n    for resource in Resource as row where row.id==event.value.resource limit=1\n     require not any(resource.Booking as booking,booking.source==event.value.source)\n     let fence=first(resource.ReservationFence as row where row.source==event.value.source and row.revision==event.value.revision order=row.id)\n     if fence!=null\n      require fence.offer==null or fence.offer==event.value\n      emit OfferOutcome {value={source=fence.source,revision=fence.revision,kind=ReservationOfferOutcome.kind.booking,version=fence.version,state=unavailable,detail=fence.reason}}\n     else\n      require event.value.attribution==null or (event.value.product!=null and event.value.product==format(\"{kind}\",{kind=resource.kind}))\n      require resource.location.id==event.value.location and event.value.attendees<=resource.party_limit and (not resource.pooled or event.value.attendees<=event.value.quantity)\n      require event.value.snapshot.total.currency==resource.currency and event.value.snapshot.total.minor>=0 and event.value.snapshot.from>=now and event.value.snapshot.from<event.value.snapshot.until\n      require all(event.value.snapshot.lines as item,item.quantity>=0 and (item.quantity>0 or item.price*item.quantity+item.tax-item.discount==money(0,item.price.currency)) and item.price.currency==resource.currency and item.tax.currency==resource.currency and item.discount.currency==resource.currency and item.price.minor>=0 and item.tax.minor>=0 and item.discount.minor>=0 and item.discount<=item.price*item.quantity+item.tax)\n      require event.value.snapshot.total==sum(event.value.snapshot.lines as item select item.price*item.quantity+item.tax-item.discount,resource.currency)\n      for customer in Customer as row where row.id==event.value.customer limit=1\n       require may_reserve(event.value.account,customer,resource)\n       for hold in resource.QuoteHold as row where row.source==event.value.source limit=1\n        require hold.revision==event.value.revision and hold.offer.snapshot==event.value.snapshot and hold.offer.customer==event.value.customer and hold.offer.location==event.value.location and hold.quantity==event.value.quantity\n        set hold {active=false}\n        cancel hold.id\n       if not quote_available(resource,event.value.snapshot,event.value.quantity)\n        create ReservationFence {parent=resource,source=event.value.source,revision=event.value.revision,reason=format(\"Quoted inventory unavailable\"@{nl=\"Geoffreerde voorraad niet beschikbaar\"},locale=null),offer=event.value} as rejected\n        emit OfferOutcome {value={source=rejected.source,revision=rejected.revision,kind=ReservationOfferOutcome.kind.booking,version=rejected.version,state=unavailable,detail=rejected.reason}}\n       else\n        create Booking {parent=resource,billing_location=resource.location,sale_product=format(\"{kind}\",{kind=resource.kind}),purchased_at=event.value.accepted_at,attribution=event.value.attribution,exclusive_program=event.value.exclusive_program,attributed_at=event.value.attributed_at,attribution_window=event.value.attribution_window,customer,account=event.value.account,email=event.value.recipient,from=event.value.snapshot.from,until=event.value.snapshot.until,intervals=event.value.snapshot.intervals as interval select BookingInterval {from=interval.from-resource.buffer_before,until=interval.until+resource.buffer_after},original_intervals=event.value.snapshot.intervals as interval select BookingInterval {from=interval.from-resource.buffer_before,until=interval.until+resource.buffer_after},quantity=event.value.quantity,attendees=event.value.attendees,rate=event.value.snapshot.total,subtotal=sum(event.value.snapshot.lines as item select item.price*item.quantity,resource.currency),tax=sum(event.value.snapshot.lines as item select item.tax,resource.currency),discount=sum(event.value.snapshot.lines as item select item.discount,resource.currency),total=event.value.snapshot.total,refund_amount=event.value.snapshot.total,terms=event.value.snapshot.terms,refund_before=event.value.snapshot.refund_before,reserved_from=event.value.snapshot.from-resource.buffer_before,reserved_until=event.value.snapshot.until+resource.buffer_after,expires=now+resource.hold_for,source=event.value.source,quote=event.value,departure_buffer=resource.buffer_after,arrival_buffer=resource.buffer_before,benefit_unit=resource.price_unit,benefit_duration=resource.increment,benefit_rate=resource.hourly*(resource.increment/1h),benefit_intervals=[BenefitInterval {from=event.value.snapshot.from,until=event.value.snapshot.until}]} as booking\n        if booking.total.minor>0\n         send Billing.charge {value={source=booking.source,customer=booking.customer.id,location=resource.location.id,description=event.value.snapshot.title,amount=booking.total,due=local_date(booking.from,resource.timezone),issuer=event.value.snapshot.issuer,terms=event.value.snapshot.terms,items=event.value.snapshot.lines as item select DocumentLine {title=item.title,quantity=item.quantity,price=item.price,tax=item.tax,discount=item.discount,unit=item.unit,from=event.value.snapshot.from,until=event.value.snapshot.until,location=event.value.snapshot.location,reference=event.value.source}}} as charge\n         set booking {status=pending,payment=pending,billing_delivery=charge.id,monetary_due=booking.total}\n        create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_1\n        create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_1.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_1\n        schedule booking.id at=booking.expires event=HoldDue {booking}\n        emit OfferOutcome {value={source=booking.source,revision=event.value.revision,kind=ReservationOfferOutcome.kind.booking,version=booking.version,state=pending,reference=booking.id,expires=booking.expires}}\n   ## Current authority precedes releasing a hold or creating a monetary obligation.\n   examples seed=[test_admin,open_site,quote_window,quoted_hold] event={value={product=null,attribution=null,exclusive_program=null,attributed_at=null,attribution_window=null,source=\"quote-test\",revision=1,customer=test_company.id,location=test_site.id,resource=test_room.id,account=self,recipient=\"customer@example.test\",accepted_at=now,quantity=1,attendees=1,snapshot=quoted_hold.offer.snapshot}}\n    test_admin.active,test_admin.locations,test_company.active,test_room.active -> count(test_room.Booking),count(test_room.ReservationFence),quoted_hold.active\n    true,[test_site],true,true -> 1,0,false\n    false,[test_site],true,true -> error(rule_failed)\n    true,[],true,true -> error(rule_failed)\n    true,[test_site],false,true -> error(rule_failed)\n    true,[test_site],true,false -> 0,1,false\n   ## A closed revision remains closed after availability returns; changed accepted facts cannot reuse it.\n   examples seed=[test_admin,closed_quote] event={value={product=null,attribution=null,exclusive_program=null,attributed_at=null,attribution_window=null,source=\"quote-test\",revision=1,customer=test_company.id,location=test_site.id,resource=test_room.id,account=self,recipient=\"customer@example.test\",accepted_at=now,quantity=1,attendees=1,snapshot=quoted_hold.offer.snapshot}}\n    closed_quote.offer,quoted_hold.active,event.value.snapshot.terms -> count(test_room.Booking),closed_quote.version,quoted_hold.active\n    closed_quote.offer,false,\"Frozen terms\" -> 0,1,false\n    closed_quote.offer,false,\"Changed terms\" -> error(rule_failed)\n    null,false,\"Frozen terms\" -> 0,1,false\n   ## A release fence may coexist with an existing booking; it cannot masquerade as a resource-free refusal.\n   examples seed=[test_admin,closed_quote,test_hold] event={value={product=null,attribution=null,exclusive_program=null,attributed_at=null,attribution_window=null,source=\"quote-test\",revision=1,customer=test_company.id,location=test_site.id,resource=test_room.id,account=self,recipient=\"customer@example.test\",accepted_at=now,quantity=1,attendees=1,snapshot=quoted_hold.offer.snapshot}}\n    test_hold.source,test_hold.status -> count(test_room.Booking)\n    \"quote-test\",confirmed -> error(rule_failed)\n  scenario quote_release on=RoomsIngressV1.release_offer\n   do\n    for resource in Resource as row where row.id==event.resource limit=1\n     if not any(resource.ReservationFence as fence,fence.source==event.source and fence.revision==event.revision)\n      create ReservationFence {parent=resource,source=event.source,revision=event.revision,reason=event.reason} as fence\n     for hold in resource.QuoteHold as row where row.source==event.source limit=1\n      require hold.revision==event.revision\n      set hold {active=false}\n      cancel hold.id\n     emit OfferOutcome {value={source=event.source,revision=event.revision,kind=ReservationOfferOutcome.kind.release,version=1,state=released}}\n   ## Releasing quote inventory cannot cancel or rewrite an existing booking with that source.\n   examples seed=[test_hold] event={source=test_hold.source,revision=1,resource=test_room.id,reason=\"Close quoted inventory\"}\n    test_hold.status,test_hold.payment -> test_hold.status,test_hold.payment,count(test_room.Booking),count(test_room.ReservationFence)\n    confirmed,paid -> confirmed,paid,1,1\n    cancelled,refunded -> cancelled,refunded,1,1\n  scenario quote_changed on=ReservationChanged\n   require event.booking.quote!=null and event.booking.version==event.revision\n   do\n    if event.booking.status in [confirmed,occupied,completed]\n     emit OfferOutcome {value={source=event.booking.source,revision=event.booking.quote.revision,kind=ReservationOfferOutcome.kind.booking,version=event.booking.version,state=confirmed,reference=event.booking.id,invoice=event.booking.invoice,expires=event.booking.expires}}\n    else\n     if event.booking.status in [cancelled,expired,review,no_show]\n      emit OfferOutcome {value={source=event.booking.source,revision=event.booking.quote.revision,kind=ReservationOfferOutcome.kind.booking,version=event.booking.version,state=unavailable,reference=event.booking.id,invoice=event.booking.invoice,expires=event.booking.expires}}\n    if event.booking.status in [held,pending]\n     if event.booking.payment==unknown\n      emit OfferOutcome {value={source=event.booking.source,revision=event.booking.quote.revision,kind=ReservationOfferOutcome.kind.booking,version=event.booking.version,state=unknown,reference=event.booking.id,invoice=event.booking.invoice,expires=event.booking.expires}}\n     else\n      emit OfferOutcome {value={source=event.booking.source,revision=event.booking.quote.revision,kind=ReservationOfferOutcome.kind.booking,version=event.booking.version,state=pending,reference=event.booking.id,invoice=event.booking.invoice,expires=event.booking.expires}}\n  scenario quote_expire on=QuoteDue\n   require event.hold.active and event.hold.expires<=now\n   do\n    set event.hold {active=false}\n    emit OfferOutcome {value={source=event.hold.source,revision=event.hold.revision,kind=ReservationOfferOutcome.kind.hold,version=event.hold.version+1,state=unavailable,reference=event.hold.id,detail=\"Quote capacity hold expired\"}}\n  # Change pooled capacity while preserving reservations and exposing every affected booking. @{nl=\"Wijzig poolcapaciteit, behoud reserveringen en toon elke getroffen reservering.\"}\n  scenario revise_capacity(resource:Resource,capacity:int,reason:text) by=reservation_manager label=\"Revise pooled capacity\"@{nl=\"Poolcapaciteit herzien\"}\n   require can_work(actor,resource.location) and resource.pooled and capacity>0 and trim(reason)!=\"\"\n   do\n    create CapacityRevision {parent=resource,capacity,reason} as revision\n    set resource {capacity}\n    create ResourcePolicy {parent=resource,sequence=count(resource.ResourcePolicy)+1,value=resource_evidence(resource)} as policy_snapshot_1\n    for booking in resource.Booking as b where busy(b) limit=1000\n     if not free(resource,booking.reserved_from,booking.reserved_until,booking.quantity,booking)\n      create Conflict {parent=resource,booking,reason} as conflict\n  # Allocate a named desk inside this booking's existing pool quantity. @{nl=\"Wijs een genoemd bureau toe binnen de bestaande poolhoeveelheid van deze reservering.\"}\n  export scenario assign_desk(booking:Booking,desk:Desk,from:datetime,until:datetime) by=reception label=\"Assign pool desk\"@{nl=\"Poolbureau toewijzen\"}\n   require can_work(actor,booking.parent.location) and booking.parent.pooled and desk.parent==booking.parent and desk.active\n   require booking.status in [confirmed,occupied] and booking.from<=from and from<until and until<=booking.until\n   require not any(Assignment as a,a.desk==desk and busy(a.parent) and overlaps(from,until,a.from,a.until))\n   require count(booking.Assignment as a where overlaps(from,until,a.from,a.until))<booking.quantity\n   do create Assignment {parent=booking,desk,from,until} as assignment\n  # Fulfill a zero-price hold explicitly without inventing paid provider evidence. @{nl=\"Voldoe expliciet een gratis tijdelijke reservering zonder betaald providerbewijs te verzinnen.\"}\n  export scenario fulfill_free(booking:Booking,reason:text) by=authenticated or reception label=\"Confirm free booking\"@{nl=\"Gratis reservering bevestigen\"}\n   require (booking.account==actor or (reception and can_work(actor,booking.parent.location))) and booking.status==held and now<booking.expires\n   require booking.total.minor==0 and booking.allowance==not_required and trim(reason)!=\"\"\n   require bookable(booking)\n   do\n    set booking {status=confirmed,payment=free,fulfillment_reason=reason}\n    create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_1\n    create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_1.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_1\n    cancel booking.id\n    emit ReservationChanged {booking,revision=booking.version+1}\n  # Confirm only finance-approved invoicing, retaining a real unpaid invoice obligation. @{nl=\"Bevestig alleen financieel goedgekeurde facturatie en behoud een echte onbetaalde factuurverplichting.\"}\n  export scenario confirm_account(booking:Booking,reason:text) by=reception or billing label=\"Confirm on account\"@{nl=\"Op rekening bevestigen\"}\n   require can_work(actor,booking.parent.location) and booking.status in [held,pending] and now<booking.expires and trim(reason)!=\"\"\n   require credit_allowed(booking.customer,booking.parent) and bookable(booking)\n   do\n    for approval in booking.customer.BillingProfile as profile where profile.on_account and booking.parent.location in profile.approved_locations limit=1\n     set booking {approval,approval_version=approval.version,payment=on_account,fulfillment_reason=reason}\n    if booking.billing_delivery==null and booking.allowance==not_required and booking.total.minor>0\n     send Billing.charge {value=charge_request(booking,booking.subtotal,booking.discount,booking.tax)} as charge\n     set booking {billing_delivery=charge.id,monetary_due=booking.total}\n    if booking.allowance==not_required\n     set booking {status=confirmed}\n     create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_1\n     create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_1.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_1\n     cancel booking.id\n     emit ReservationChanged {booking,revision=booking.version+1}\n    else\n     if booking.allowance==pending and booking.allowance_delivery==null\n      send Membership.reserve {value=benefit_request(booking)} as allocation\n      set booking {status=pending,allowance_delivery=allocation.id}\n      create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_2\n      create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_2.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_2\n     if booking.allowance==reserved and booking.consume_delivery==null\n      send Membership.consume {source=booking.allowance_source??booking.source,customer=booking.customer.id} as consume\n      set booking {status=pending,consume_delivery=consume.id}\n      create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_3\n      create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_3.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_3\n  scenario charge_result on=Billing.charge.completed\n   do\n    for booking in Booking as row where row.billing_delivery==event.delivery_id limit=1\n     if event.status==succeeded and event.result!=null and event.result.source==booking.source\n      if event.result.reference!=null\n       set booking {invoice=event.result.reference}\n       emit ReservationChanged {booking,revision=booking.version+1}\n     if event.status==unknown and booking.payment==pending\n      set booking {payment=unknown}\n      emit ReservationChanged {booking,revision=booking.version+1}\n     if event.status==failed and booking.status in [held,pending]\n      set booking {status=review}\n      create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_1\n      create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_1.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_1\n      emit CommercialCheck {booking}\n  # Record missed arrival under the frozen terms without asserting physical departure. @{nl=\"Leg gemiste aankomst vast onder de vastgelegde voorwaarden zonder werkelijk vertrek te veronderstellen.\"}\n  export scenario no_show(booking:Booking,reason:text) by=reception label=\"Record no-show\"@{nl=\"Niet verschijnen vastleggen\"}\n   require can_work(actor,booking.parent.location) and booking.status==confirmed and booking.checked_in==null and booking.until<=now and trim(reason)!=\"\"\n   do\n    set booking {status=no_show,cancellation_reason=reason}\n    create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_1\n    create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_1.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_1\n    emit ReservationChanged {booking,revision=booking.version+1}\n  # Keep overtime or damage charges separate from the original frozen booking price. @{nl=\"Houd overuren- of schadebedragen gescheiden van de oorspronkelijke vastgelegde reserveringsprijs.\"}\n  scenario adjust(booking:Booking,amount:money,reason:text) by=billing label=\"Charge booking adjustment\"@{nl=\"Reserveringscorrectie factureren\"}\n   require can_work(actor,booking.parent.location) and booking.status in [occupied,completed,no_show] and amount.currency==booking.total.currency and amount.minor>0 and trim(reason)!=\"\"\n   do\n    create Adjustment {parent=booking,source=operation.id,amount,reason} as adjustment\n    send Billing.charge {value={source=adjustment.source,customer=booking.customer.id,location=booking.parent.location.id,description=reason,amount,due=local_date(now,booking.parent.timezone)}} as charge\n    set adjustment {delivery=charge.id}\n  # Hold an extension while retaining the original access until its separate price is fulfilled. @{nl=\"Houd een verlenging vast en behoud de oorspronkelijke toegang totdat de afzonderlijke prijs voldaan is.\"}\n  export scenario extend(booking:Booking,until:datetime,reason:text,amount:money?=null) by=authenticated or reception or billing label=\"Extend booking\"@{nl=\"Reservering verlengen\"}\n   require (booking.account==actor or ((reception or billing) and can_work(actor,booking.parent.location))) and booking.status in [confirmed,occupied] and booking.allowance==not_required and count(booking.intervals)==0 and booking.until<until and (until-booking.until)%booking.parent.increment==0m and trim(reason)!=\"\"\n   require (booking.quote==null and amount==null) or (booking.quote!=null and billing and can_work(actor,booking.parent.location) and amount!=null and amount.currency==booking.total.currency and amount.minor>0)\n   require not any(booking.Adjustment as adjustment,adjustment.new_until!=null and adjustment.state==pending)\n   require free(booking.parent,booking.reserved_from,until+booking.departure_buffer,booking.quantity,booking)\n   do\n    let extra=amount??(booking.rate*((until-booking.until)/1h)*booking.quantity*(1-booking.discount_fraction)*(1+booking.tax_fraction))\n    require extra.minor>0\n    create Adjustment {parent=booking,source=operation.id,amount=extra,reason,original_until=booking.until,original_reserved_until=booking.reserved_until,new_until=until,expires=now+booking.parent.hold_for} as adjustment\n    set booking {reserved_until=until+booking.departure_buffer}\n    send Billing.charge {value={source=adjustment.source,customer=booking.customer.id,location=booking.parent.location.id,description=reason,amount=extra,due=local_date(now,booking.parent.timezone)}} as charge\n    set adjustment {delivery=charge.id}\n    schedule adjustment.id at=adjustment.expires event=AdjustmentDue {adjustment}\n  scenario adjustment_money on=SettlementObserved\n   do\n    for adjustment in Adjustment as row where row.source==event.value.source limit=1\n     require event.value.amount==adjustment.amount\n     let fresh=event.value.revision>adjustment.settlement_revision\n     if fresh\n      set adjustment {settlement_revision=event.value.revision,collected=event.value.collected,refunded=event.value.refunded,invoice=event.value.invoice}\n     if fresh and event.value.collected-event.value.refunded>=adjustment.amount and adjustment.state in [pending,expired]\n      set adjustment {invoice=event.value.invoice}\n      if adjustment.movement!=null and adjustment.movement.state in [cancelled,cancelling,review]\n       set adjustment {state=review}\n      else\n       if adjustment.new_until==null\n        set adjustment {state=paid}\n       else\n        if adjustment.parent.status in [confirmed,occupied] and adjustment.parent.until==adjustment.original_until and free(adjustment.parent.parent,adjustment.parent.reserved_from,adjustment.new_until+adjustment.parent.departure_buffer,adjustment.parent.quantity,adjustment.parent)\n         set adjustment.parent {until=adjustment.new_until,reserved_until=adjustment.new_until+adjustment.parent.departure_buffer}\n         create ResourcePolicy {parent=adjustment.parent.parent,sequence=count(adjustment.parent.parent.ResourcePolicy)+1,value=resource_evidence(adjustment.parent.parent)} as policy_snapshot_1\n         create BookingEvidence {parent=adjustment.parent.parent,sequence=policy_snapshot_1.sequence,key=adjustment.parent.id,value=report_booking(adjustment.parent)} as booking_evidence_1\n         set adjustment {state=paid}\n         cancel adjustment.id\n         emit ReservationChanged {booking=adjustment.parent,revision=adjustment.parent.version+1}\n        else\n         set adjustment {state=review}\n         if adjustment.parent.until==adjustment.original_until and adjustment.parent.reserved_until==adjustment.new_until+adjustment.parent.departure_buffer\n          set adjustment.parent {reserved_until=adjustment.original_reserved_until}\n     if fresh and adjustment.refund_delivery!=null and event.value.refunded>=adjustment.amount\n      set adjustment {state=refunded}\n  scenario extension_expire on=AdjustmentDue\n   require event.adjustment.state==pending and event.adjustment.expires!=null and event.adjustment.expires<=now\n   do\n    set event.adjustment {state=expired}\n    if event.adjustment.parent.until==event.adjustment.original_until and event.adjustment.parent.reserved_until==event.adjustment.new_until+event.adjustment.parent.departure_buffer\n     set event.adjustment.parent {reserved_until=event.adjustment.original_reserved_until}\n    send Billing.cancel {source=event.adjustment.source,reason=\"Extension hold expired\"} as cancellation\n  scenario refund_adjustment(adjustment:Adjustment,reason:text) by=billing label=\"Refund adjustment exception\"@{nl=\"Correctie-uitzondering terugbetalen\"}\n   require can_work(actor,adjustment.parent.parent.location) and adjustment.state==review and adjustment.refund_delivery==null and trim(reason)!=\"\"\n   do\n    send Billing.refund {source=adjustment.source,amount=adjustment.amount,reason} as refund\n    set adjustment {refund_delivery=refund.id}\n  # Resolve received funds with an explicit finance refund request and retained evidence. @{nl=\"Los ontvangen geld op met een expliciete financiële terugbetalingsaanvraag en behouden bewijs.\"}\n  scenario refund_review(booking:Booking,reason:text) by=billing label=\"Refund booking exception\"@{nl=\"Reserveringsuitzondering terugbetalen\"}\n   require can_work(actor,booking.parent.location) and booking.payment==paid and booking.status in [review,expired,cancelled] and booking.refund_delivery==null and trim(reason)!=\"\"\n   do\n    let restore=booking.status==expired or now<booking.refund_before\n    set booking {status=cancelled,cancellation_reason=reason}\n    create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_1\n    create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_1.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_1\n    if booking.allowance!=not_required and booking.release_delivery==null\n     send Membership.release {source=booking.allowance_source??booking.source,customer=booking.customer.id,restore_consumed=restore} as release\n     set booking {release_delivery=release.id}\n    send Billing.refund {source=booking.source,amount=booking.monetary_due??booking.total,reason} as refund\n    set booking {refund_delivery=refund.id,refund_state=pending,refund_requested=booking.monetary_due??booking.total}\n    emit ReservationChanged {booking,revision=booking.version+1}\n  # Mark a capacity conflict resolved only after the owner can honor or clear its booking. @{nl=\"Markeer een capaciteitsconflict pas opgelost nadat de eigenaar de reservering kan nakomen of vrijgeven.\"}\n  scenario resolve_conflict(conflict:Conflict,evidence:text) by=reservation_manager label=\"Resolve reservation conflict\"@{nl=\"Reserveringsconflict oplossen\"}\n   require can_work(actor,conflict.parent.location) and not conflict.resolved and trim(evidence)!=\"\"\n   require not busy(conflict.booking) or free(conflict.parent,conflict.booking.reserved_from,conflict.booking.reserved_until,conflict.booking.quantity,conflict.booking)\n   do set conflict {resolved=true,resolution=evidence}\n  crud Desk by=reservation_manager fields=name,active when=can_work(actor,row.parent.location) delete=none\n  ## Source lifecycle evidence uses the frozen original charge; Invoice independently proves money and customer history.\n  scenario commercial_changed on=ReservationChanged\n   do emit CommercialCheck {booking=event.booking}\n  scenario commercial_check on=CommercialCheck\n   do\n    let booking=event.booking\n    if booking.billing_location!=null and booking.sale_product!=null and booking.purchased_at!=null and booking.monetary_due!=null and booking.monetary_due.minor>0 and booking.billing_delivery!=null\n     if not any(booking.CommercialSale as sale,true)\n      create CommercialSale {parent=booking} as created\n     let sale=first(booking.CommercialSale as sale order=sale.id)\n     require sale!=null\n     if sale.phase!=reversed\n      if booking.status in [cancelled,no_show] or booking.cancel_delivery!=null or booking.cancellation_reason!=null or booking.refund_delivery!=null or booking.refund_requested!=null or (booking.refunded!=null and booking.refunded.minor>0) or (sale.phase!=null and (booking.status in [review,expired] or booking.payment!=paid or not (booking.allowance in [not_required,consumed])))\n       set sale {phase=reversed,revision=sale.revision+1}\n       emit CommercialSaleChanged {value=commercial(booking,sale,booking.billing_location,booking.sale_product,booking.monetary_due,booking.purchased_at,reversed,now)}\n      else\n       if booking.payment==paid and booking.status in [confirmed,occupied,completed] and booking.allowance in [not_required,consumed] and booking.cancel_delivery==null and not booking.collection_pending and not booking.refund_pending and booking.refund_state==none and booking.collected!=null and booking.collected>=booking.monetary_due and booking.refunded!=null and booking.refunded.minor==0\n        if booking.status==completed and booking.checked_out!=null\n         if sale.phase!=completed\n          set sale {phase=completed,revision=sale.revision+1}\n          emit CommercialSaleChanged {value=commercial(booking,sale,booking.billing_location,booking.sale_product,booking.monetary_due,booking.purchased_at,completed,booking.checked_out)}\n        else\n         if sale.phase==null\n          set sale {phase=paid,revision=sale.revision+1}\n          emit CommercialSaleChanged {value=commercial(booking,sale,booking.billing_location,booking.sale_product,booking.monetary_due,booking.purchased_at,paid,now)}\n   examples seed=[test_sale] event={booking=test_hold}\n    test_hold.billing_location,test_hold.sale_product,test_hold.purchased_at,test_hold.monetary_due,test_hold.billing_delivery,test_hold.collected,test_hold.refunded,test_hold.status,test_hold.payment,test_hold.checked_out,test_sale.phase -> test_sale.phase,test_sale.revision\n    test_site,\"meeting\",now-1h,money(500,\"EUR\"),\"original-charge\",money(500,\"EUR\"),money(0,\"EUR\"),confirmed,paid,null,null -> paid,1\n    test_site,\"meeting\",now-1h,money(500,\"EUR\"),\"original-charge\",money(500,\"EUR\"),money(0,\"EUR\"),completed,paid,now,null -> completed,1\n    test_site,\"meeting\",now-1h,money(500,\"EUR\"),\"original-charge\",money(500,\"EUR\"),money(0,\"EUR\"),cancelled,paid,null,paid -> reversed,1\n    test_site,\"meeting\",now-1h,money(500,\"EUR\"),\"original-charge\",money(500,\"EUR\"),money(0,\"EUR\"),expired,paid,null,null -> null,0\n    test_site,\"meeting\",now-1h,money(500,\"EUR\"),\"original-charge\",money(500,\"EUR\"),money(0,\"EUR\"),confirmed,paid,null,reversed -> reversed,0\n    test_site,\"meeting\",now-1h,money(0,\"EUR\"),\"original-charge\",money(0,\"EUR\"),money(0,\"EUR\"),confirmed,free,null,null -> null,0\n  scenario correspondence on=ReservationChanged\n   require event.booking.version==event.revision\n   do\n    cancel event.booking.source\n    if event.booking.status==confirmed\n     let subject=format(\"Workspace confirmed\"@{nl=\"Werkplek bevestigd\"},locale=null)\n     let body=format(\"{location}; {resource}; {from,date} {from,time} – {until,date} {until,time}; {arrival}; {terms}; /workspace/my-bookings\"@{nl=\"{location}; {resource}; {from,date} {from,time} – {until,date} {until,time}; {arrival}; {terms}; /workspace/my-bookings\"}(location=event.booking.parent.location.name,resource=event.booking.parent.name,from=event.booking.from,until=event.booking.until,arrival=event.booking.parent.location.arrival,terms=event.booking.terms),locale=null)\n     send Mail.send {to=event.booking.email,subject,body} when=event.booking.status==confirmed and event.booking.version==event.revision as delivery\n     create Notice {parent=event.booking,kind=confirmation,revision=event.revision,subject,body,delivery} as notice\n     if event.booking.from>now+1h\n      schedule event.booking.source at=event.booking.from-1h event=Reminder {booking=event.booking,revision=event.revision}\n    if event.booking.status in [cancelled,expired,no_show]\n     let subject=format(\"Workspace booking changed\"@{nl=\"Werkplekreservering gewijzigd\"},locale=null)\n     let body=event.booking.terms\n     send Mail.send {to=event.booking.email,subject,body} when=event.booking.version==event.revision as delivery\n     create Notice {parent=event.booking,kind=cancellation,revision=event.revision,subject,body,delivery} as notice\n  scenario remind on=Reminder\n   require event.booking.status==confirmed and event.booking.version==event.revision\n   do\n    let subject=format(\"Workspace arrival reminder\"@{nl=\"Herinnering werkplekaankomst\"},locale=null)\n    let body=event.booking.parent.location.arrival\n    send Mail.send {to=event.booking.email,subject,body} when=event.booking.status==confirmed and event.booking.version==event.revision as delivery\n    create Notice {parent=event.booking,kind=reminder,revision=event.revision,subject,body,delivery} as notice\n  export scenario resend_notice(notice:Notice) by=authenticated or reception label=\"Retry booking notice\"@{nl=\"Reserveringsbericht opnieuw proberen\"}\n   require notice.parent.account==actor or (reception and can_work(actor,notice.parent.parent.location))\n   require notice.state in [failed,unknown] and notice.parent.version==notice.revision\n   do\n    send Mail.send {to=notice.parent.email,subject=notice.subject,body=notice.body} as delivery\n    set notice {delivery}\n  scenario allowance_result on=Membership.reserve.completed\n   do\n    for booking in Booking as b where b.allowance_delivery==event.delivery_id limit=1\n     if event.status==succeeded and event.result!=null and event.result.source==(booking.allowance_source??booking.source)\n      emit AllowanceObserved {booking,value=event.result}\n     if event.status==failed and booking.allowance==pending and booking.status in [held,pending,review]\n      set booking {allowance=failed,status=review}\n      create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_1\n      create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_1.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_1\n      send Membership.release {source=booking.allowance_source??booking.source,customer=booking.customer.id,restore_consumed=false} as release\n      set booking {release_delivery=release.id}\n      send Billing.cancel {source=booking.source,reason=\"Allowance unavailable\"} as cancellation\n      set booking {cancel_delivery=cancellation.id}\n      emit CommercialCheck {booking}\n  export scenario reconcile_allowance(booking:Booking) by=authenticated or reception label=\"Reconcile membership allowance\"@{nl=\"Lidmaatschapstegoed reconciliëren\"}\n   require booking.account==actor or (reception and can_work(actor,booking.parent.location))\n   require booking.allowance!=not_required\n   do\n    send Membership.reconcile {source=booking.allowance_source??booking.source,customer=booking.customer.id} as reconciliation\n    set booking {allowance_reconcile_delivery=reconciliation.id}\n  scenario allowance_reconciled on=Membership.reconcile.completed\n   do\n    for booking in Booking as row where row.allowance_reconcile_delivery==event.delivery_id limit=1\n     if event.status==succeeded and event.result!=null and event.result.source==(booking.allowance_source??booking.source)\n      emit AllowanceObserved {booking,value=event.result}\n  scenario allowance_changed on=Membership.allowance_changed\n   do\n    for booking in Booking as row where (row.allowance_source??row.source)==event.value.source limit=1\n     if event.value.phase!=released or not any(booking.Movement as movement,movement.state==committing)\n      emit AllowanceObserved {booking,value=event.value}\n  scenario allowance_snapshot on=AllowanceObserved\n   require event.value.source==(event.booking.allowance_source??event.booking.source) and event.value.revision>event.booking.allowance_revision\n   require event.value.state!=confirmed or event.value.phase==released or (event.value.unit==event.booking.benefit_unit and event.value.duration==event.booking.benefit_duration and event.value.rate==(event.booking.benefit_rate??event.booking.rate))\n   do\n    let booking=event.booking\n    if event.value.state==confirmed and event.value.phase==reserved\n     if booking.status in [cancelled,expired,completed,no_show] or booking.expires<=now or not bookable(booking)\n      if booking.status in [held,pending]\n       set booking {status=review}\n       create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_1\n       create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_1.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_1\n      if booking.release_delivery==null\n       send Membership.release {source=booking.allowance_source??booking.source,customer=booking.customer.id,restore_consumed=booking.status==expired or now<booking.refund_before} as release\n       set booking {release_delivery=release.id}\n     else\n      if booking.allowance==pending\n       require event.value.phase==reserved and event.value.unit==booking.benefit_unit and event.value.duration==benefit_request(booking).duration and event.value.rate==benefit_request(booking).rate\n       let discount=event.value.overage*booking.discount_fraction\n       let tax=(event.value.overage-discount)*booking.tax_fraction\n       let balance=event.value.overage-discount+tax\n       set booking {allowance_base=event.value.overage,allowance_discount=discount,allowance_tax=tax,service_due=balance,allowance=reserved,allowance_units=event.value.units,included_units=event.value.covered_units,allowance_revision=event.value.revision,monetary_due=balance}\n       if balance.minor==0\n        set booking {payment=free,fulfillment_reason=\"Included membership units\"}\n       else\n        if booking.billing_delivery==null\n         send Billing.charge {value=charge_request(booking,event.value.overage,discount,tax)} as charge\n         set booking {billing_delivery=charge.id}\n         if booking.payment!=on_account\n          set booking {payment=pending}\n       if booking.payment in [paid,free,on_account] and booking.status in [pending,review]\n        if bookable(booking) and booking.consume_delivery==null\n         send Membership.consume {source=booking.allowance_source??booking.source,customer=booking.customer.id} as consume\n         set booking {status=pending,consume_delivery=consume.id}\n         create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_2\n         create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_2.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_2\n        else\n         set booking {status=review,refund_state=review}\n         create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_3\n         create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_3.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_3\n    if event.value.phase==consumed and event.value.state==confirmed\n     set booking {allowance=consumed}\n     if booking.status in [pending,review] and booking.payment in [paid,free,on_account] and booking.release_delivery==null\n      if bookable(booking) and (booking.payment!=paid or financial_cover(booking))\n       set booking {status=confirmed}\n       create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_4\n       create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_4.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_4\n       cancel booking.id\n       emit CommercialCheck {booking}\n      else\n       set booking {status=review,refund_state=review}\n       create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_5\n       create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_5.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_5\n    if event.value.phase==released\n     set booking {allowance=released}\n     if booking.status in [held,pending,confirmed]\n      set booking {status=review}\n      create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_6\n      create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_6.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_6\n    set booking {allowance_revision=event.value.revision}\n    emit CommercialCheck {booking}\n  scenario settlement_received on=Billing.settled\n   do emit SettlementObserved {value=event.value}\n  export scenario reconcile_booking(booking:Booking) by=authenticated or reception or billing label=\"Reconcile booking payment\"@{nl=\"Reserveringsbetaling reconciliëren\"}\n   require booking.account==actor or ((reception or billing) and can_work(actor,booking.parent.location))\n   do\n    send Billing.reconcile {source=booking.source} as reconciliation\n    set booking {reconcile_delivery=reconciliation.id}\n  scenario reconciled on=Billing.reconcile.completed\n   do\n    for booking in Booking as row where row.reconcile_delivery==event.delivery_id limit=1\n     if event.status==succeeded and event.result!=null\n      require event.result.source==booking.source\n      emit SettlementObserved {value=event.result}\n     if event.status in [failed,unknown]\n      set booking {refund_state=unknown}\n  scenario money on=SettlementObserved\n   do\n    for booking in Booking as b where b.source==event.value.source limit=1\n     require event.value.amount==(booking.monetary_due??booking.total) and event.value.collected.currency==booking.total.currency and event.value.refunded.currency==booking.total.currency\n     if event.value.revision>booking.settlement_revision\n      set booking {settlement_revision=event.value.revision,invoice=event.value.invoice,collected=event.value.collected,refunded=event.value.refunded,collection_pending=event.value.collection_pending,refund_pending=event.value.refund_pending}\n      if event.value.collected-event.value.refunded>=(booking.monetary_due??booking.total) and event.value.amount.minor>0\n       set booking {payment=paid}\n       if booking.status in [cancelled,no_show,completed,occupied]\n        if booking.status in [cancelled,no_show]\n         set booking {refund_state=review}\n       else\n        if event.value.state==issued and not event.value.refund_pending and event.value.refunded.minor==0 and booking.cancel_delivery==null and booking.refund_delivery==null and booking.refund_requested==null and booking.release_delivery==null and now<booking.until and bookable(booking)\n         if booking.allowance in [not_required,consumed]\n          set booking {status=confirmed,refund_state=none}\n          create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_1\n          create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_1.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_1\n          cancel booking.id\n         else\n          if booking.allowance==reserved and booking.consume_delivery==null\n           send Membership.consume {source=booking.allowance_source??booking.source,customer=booking.customer.id} as consume\n           set booking {status=pending,expires=now+booking.parent.hold_for,consume_delivery=consume.id}\n           create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_2\n           create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_2.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_2\n           schedule booking.id at=booking.expires event=HoldDue {booking}\n          else\n           if booking.allowance==pending\n            set booking {status=pending,expires=now+booking.parent.hold_for}\n            create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_3\n            create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_3.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_3\n            schedule booking.id at=booking.expires event=HoldDue {booking}\n           else\n            set booking {status=review,refund_state=review}\n            create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_4\n            create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_4.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_4\n        else\n         set booking {status=review,refund_state=review}\n         create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_5\n         create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_5.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_5\n      if booking.refund_requested!=null and event.value.refunded>=booking.refund_requested\n       set booking {refund_state=refunded}\n       if event.value.refunded>=event.value.collected\n        set booking {payment=refunded}\n      if event.value.refund_pending and booking.refund_state!=refunded\n       set booking {refund_state=pending}\n      if event.value.state in [void_pending,void] and booking.status in [held,pending,confirmed]\n       set booking {status=review}\n       create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_6\n       create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_6.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_6\n      emit ReservationChanged {booking,revision=booking.version+1}\n   examples seed=[test_hold] event={value={source=\"test-hold\",invoice=\"invoice-test\",revision=1,amount=money(1000,\"EUR\"),collected=money(1000,\"EUR\"),refunded=money(0,\"EUR\"),collection_pending=false,refund_pending=false,state=issued,recorded_at=datetime(\"2026-10-04T10:00:00Z\")}}\n    test_hold.status -> test_hold.status,test_hold.payment\n    cancelled -> cancelled,paid\n    expired -> review,paid\n    completed -> completed,paid\n    no_show -> no_show,paid\n   examples seed=[test_hold,test_window,sunday_site] event={value={source=\"test-hold\",invoice=\"invoice-test\",revision=1,amount=money(1000,\"EUR\"),collected=money(1000,\"EUR\"),refunded=money(0,\"EUR\"),collection_pending=false,refund_pending=false,state=issued,recorded_at=now}}\n    test_hold.from,test_hold.until,test_hold.reserved_from,test_hold.reserved_until,test_hold.expires,test_window.from,test_window.until,sunday_site.weekday,test_hold.status,test_hold.cancel_delivery,event.value.state -> test_hold.status,test_hold.refund_state\n    local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"10:00\",\"Europe/Brussels\",fold=earlier),local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"11:00\",\"Europe/Brussels\",fold=earlier),local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"10:00\",\"Europe/Brussels\",fold=earlier),local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"11:00\",\"Europe/Brussels\",fold=earlier),now-1m,now-1d,now+3d,weekday(local_date(local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"10:00\",\"Europe/Brussels\",fold=earlier),\"Europe/Brussels\")),expired,null,issued -> confirmed,none\n    local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"10:00\",\"Europe/Brussels\",fold=earlier),local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"11:00\",\"Europe/Brussels\",fold=earlier),local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"10:00\",\"Europe/Brussels\",fold=earlier),local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"11:00\",\"Europe/Brussels\",fold=earlier),now-1m,now-1d,now+3d,weekday(local_date(local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"10:00\",\"Europe/Brussels\",fold=earlier),\"Europe/Brussels\")),expired,\"cancel-accepted\",issued -> review,review\n    local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"10:00\",\"Europe/Brussels\",fold=earlier),local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"11:00\",\"Europe/Brussels\",fold=earlier),local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"10:00\",\"Europe/Brussels\",fold=earlier),local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"11:00\",\"Europe/Brussels\",fold=earlier),now-1m,now-1d,now+3d,weekday(local_date(local_instant(add_days(local_date(now,\"Europe/Brussels\"),1),\"10:00\",\"Europe/Brussels\",fold=earlier),\"Europe/Brussels\")),expired,null,void_pending -> review,review\n   examples seed=[test_hold] event={value={source=\"test-hold\",invoice=\"invoice-test\",revision=1,amount=money(1000,\"EUR\"),collected=money(0,\"EUR\"),refunded=money(0,\"EUR\"),collection_pending=true,refund_pending=false,state=issued,recorded_at=datetime(\"2026-10-04T10:00:00Z\")}}\n    test_hold.settlement_revision,test_hold.payment -> test_hold.payment\n    2,paid -> paid\n  scenario consumption on=Membership.consume.completed\n   do\n    for booking in Booking as b where b.consume_delivery==event.delivery_id limit=1\n     if event.status==succeeded and event.result!=null and event.result.source==(booking.allowance_source??booking.source) and event.result.state==confirmed and event.result.phase==consumed\n      emit AllowanceObserved {booking,value=event.result}\n     if event.status in [failed,unknown] and booking.status in [pending,review]\n      set booking {status=review,refund_state=review}\n      create ResourcePolicy {parent=booking.parent,sequence=count(booking.parent.ResourcePolicy)+1,value=resource_evidence(booking.parent)} as policy_snapshot_1\n      create BookingEvidence {parent=booking.parent,sequence=policy_snapshot_1.sequence,key=booking.id,value=report_booking(booking)} as booking_evidence_1\n      emit CommercialCheck {booking}\n   examples seed=[test_hold] event={delivery_id=\"consume-test\",status=failed,result=null,error={code=\"rejected\",message=\"Owner rejected consumption\"}}\n    test_hold.status,test_hold.consume_delivery -> test_hold.status\n    cancelled,\"consume-test\" -> cancelled\n    completed,\"consume-test\" -> completed\n    pending,\"consume-test\" -> review\n  scenario released on=Membership.release.completed\n   do\n    for booking in Booking as b where b.release_delivery==event.delivery_id limit=1\n     if event.status==succeeded and event.result!=null and event.result.source==(booking.allowance_source??booking.source) and event.result.state==released\n      set booking {allowance=released}\n      emit CommercialCheck {booking}\n     else\n      if event.status in [failed,unknown]\n       set booking {refund_state=review}\n  scenario refund_result on=Billing.refund.completed\n   do\n    for booking in Booking as b where b.refund_delivery==event.delivery_id limit=1\n     if event.status in [failed,unknown]\n      set booking {refund_state=unknown}\n  scenario expire on=HoldDue\n   require event.booking.expires<=now and event.booking.status in [held,pending]\n   do\n    set event.booking {status=expired}\n    create ResourcePolicy {parent=event.booking.parent,sequence=count(event.booking.parent.ResourcePolicy)+1,value=resource_evidence(event.booking.parent)} as policy_snapshot_1\n    create BookingEvidence {parent=event.booking.parent,sequence=policy_snapshot_1.sequence,key=event.booking.id,value=report_booking(event.booking)} as booking_evidence_1\n    if event.booking.allowance!=not_required and event.booking.release_delivery==null\n     send Membership.release {source=event.booking.source,customer=event.booking.customer.id,restore_consumed=true} as release\n     set event.booking {release_delivery=release.id}\n    if event.booking.payment==paid\n     set event.booking {refund_state=review}\n    else\n     if event.booking.payment in [pending,unknown] or event.booking.collection_pending\n      send Billing.reconcile {source=event.booking.source} as reconciliation\n      set event.booking {reconcile_delivery=reconciliation.id}\n     else\n      send Billing.cancel {source=event.booking.source,reason=\"Hold expired\"} as cancellation\n      set event.booking {cancel_delivery=cancellation.id}\n    emit ReservationChanged {booking=event.booking,revision=event.booking.version+1}\n Then\n  # Read retained booking evidence under current staff or explicitly mapped account access. @{nl=\"Lees bewaard reserveringsbewijs met huidige medewerkersrechten of toegang voor een uitdrukkelijk gekoppeld account.\"}\n  page /workspace/history title=\"Historical booking evidence\"@{nl=\"Historisch reserveringsbewijs\"}\n   require authenticated\n   breadcrumbs\n   card \"Retain source bookings\"@{nl=\"Bronreserveringen bewaren\"}\n    require reservation_manager\n    form retain_legacy import=csv review=legacy_matches\n     fieldset\n      input source\n      input external_id\n      select location\n      file_input source_evidence\n      textarea attestation\n   form legacy_matches\n    list result columns=source,external_id,location empty=\"No matching retained bookings\"@{nl=\"Geen overeenkomende bewaarde reserveringen\"}\n     copy row.source\n     copy row.external_id\n     pagination\n   table LegacyBooking archived=include as entry columns=source,external_id,location display=split empty=\"No retained bookings\"@{nl=\"Geen bewaarde reserveringen\"}\n    copy entry.source\n    copy entry.external_id\n    text entry.facts.customer_source,entry.facts.customer_external_id,entry.facts.resource_source,entry.facts.resource_external_id,entry.facts.actor,entry.facts.from_original,entry.facts.until_original,entry.facts.from,entry.facts.until,entry.facts.status,entry.facts.payment,entry.facts.quantity,entry.facts.amount,entry.customer,entry.resource\n    card \"Current mapping and source evidence\"@{nl=\"Huidige koppeling en bronbewijs\"}\n     require reservation_manager or finance\n     button opens=link_legacy_booking\n     link target=entry.source_evidence caption=\"Original source artifact\"@{nl=\"Oorspronkelijk bronbestand\"}\n     text entry.account,entry.mapping_reason,entry.attestation,entry.imported_by,entry.imported_at\n     modal \"Map historical booking\"@{nl=\"Historische reservering koppelen\"} id=link_legacy_booking\n      slot content\n       form link_legacy arguments={entry=row} display=inline\n        fieldset\n         select customer\n         select resource\n         textarea reason\n         ## account:user? keeps its generated picker (no authorized user-directory lookup proven).\n     history\n    pagination\n  page /workspace/refund-review title=\"Booking finance exceptions\"@{nl=\"Financiële reserveringsuitzonderingen\"} order=8\n   require billing\n   breadcrumbs\n   alert \"Refunds need finance review\"@{nl=\"Terugbetalingen vereisen beoordeling\"}\n   list Booking as booking where booking.refund_state in [review,unknown,pending] display=split empty=\"No finance exceptions\"@{nl=\"Geen financiële uitzonderingen\"}\n    badge row.status\n    badge row.payment\n    badge row.allowance\n    badge row.refund_state\n    text row.customer,row.from,row.until,row.total\n    copy row.source\n    actions reconcile_booking\n    button opens=booking_refund\n    modal \"Refund booking exception\"@{nl=\"Reserveringsuitzondering terugbetalen\"} id=booking_refund\n     slot content\n      form refund_review arguments={booking=row} display=inline\n       fieldset\n        textarea reason\n    history\n    pagination\n   list Booking as booking where booking.status in [confirmed,occupied,completed,no_show] display=split empty=\"No confirmed bookings\"@{nl=\"Geen bevestigde reserveringen\"}\n    badge row.status\n    copy row.source\n    button opens=booking_adjust\n    modal \"Charge booking adjustment\"@{nl=\"Reserveringscorrectie factureren\"} id=booking_adjust\n     slot content\n      form adjust arguments={booking=row} display=inline\n       fieldset\n        ## proposed: money as input's \"appropriate scalar\"; checker confirms.\n        input amount\n        textarea reason\n    list row.Movement as movement where movement.credit_due!=null and movement.credit_due.minor>0 empty=\"No movement credits\"@{nl=\"Geen verplaatsingstegoeden\"}\n     badge row.state\n     text row.credit_due\n     button opens=movement_credit_refund\n     modal \"Refund movement credit\"@{nl=\"Verplaatsingstegoed terugbetalen\"} id=movement_credit_refund\n      slot content\n       form refund_movement_credit arguments={movement=row} display=inline\n        fieldset\n         input charge_source\n         ## proposed: money as input's \"appropriate scalar\"; checker confirms.\n         input amount\n         textarea reason\n     table row.MovementCredit columns=charge_source,amount,state,reason empty=\"No movement credit refunds\"@{nl=\"Geen terugbetalingen van verplaatsingstegoed\"}\n      pagination\n     pagination\n    list row.Adjustment empty=\"No adjustments\"@{nl=\"Geen correcties\"}\n     badge row.state\n     text row.amount,row.reason,row.new_until\n     button opens=adjustment_refund\n     modal \"Refund adjustment exception\"@{nl=\"Correctie-uitzondering terugbetalen\"} id=adjustment_refund\n      slot content\n       form refund_adjustment arguments={adjustment=row} display=inline\n        fieldset\n         textarea reason\n     pagination\n    history\n    pagination\n  # Author published resource rates and commercial policy under catalog authority. @{nl=\"Stel gepubliceerde tarieven en commerciële voorwaarden op onder catalogusbevoegdheid.\"}\n  page /workspace/resources title=\"Resource catalog\"@{nl=\"Voorzieningencatalogus\"} order=7\n   require catalog_owner\n   breadcrumbs\n   card \"Resource catalog and rates\"@{nl=\"Voorzieningencatalogus en tarieven\"}\n    form Resource.create\n     fieldset\n      select location\n      input name\n      checkbox pooled\n      input capacity\n      input party_limit\n      radio kind\n      input hold_for\n      input timezone\n      input currency\n      input tax_rate\n      input discount_rate\n      input cancellation_fee\n      input hourly\n      input daily\n      radio price_unit\n      textarea terms\n      input refund_notice\n      textarea accessibility\n    table Resource columns=location,name,capacity,hourly,increment,minimum,terms,refund_notice,active filter=location defaults={location=preferences.location} display=split empty=\"No resources match these filters\"@{nl=\"Geen voorzieningen voldoen aan deze filters\"}\n     edit\n      fieldset\n       checkbox active\n       textarea terms\n     collapse policy_title\n      text row.amenities,row.accessibility,row.buffer_before,row.buffer_after\n     history\n     pagination\n  # Discover space and enter local-time intervals before creating a hold. @{nl=\"Vind ruimte en voer tijdvakken in lokale tijd in voordat je tijdelijk reserveert.\"}\n  page /workspace title=\"Available workspace\"@{nl=\"Beschikbare werkplekken\"} order=1\n   breadcrumbs\n   card \"Discover workspace\"@{nl=\"Werkplekken ontdekken\"}\n    accordion\n     collapse \"Holds and confirmation\"@{nl=\"Reserveren en bevestigen\"}\n      text \"A hold expires at its shown expiry.\"@{nl=\"Een tijdelijke reservering verloopt op het getoonde tijdstip.\"}\n      text \"Confirmation needs payment and any allowance.\"@{nl=\"Bevestiging vereist betaling en een eventueel tegoed.\"}\n     collapse \"Cancellation and refunds\"@{nl=\"Annuleren en terugbetalen\"}\n      text \"Cancellation stops future access.\"@{nl=\"Annuleren stopt toekomstige toegang.\"}\n      text \"Refunds follow the frozen terms.\"@{nl=\"Terugbetalingen volgen de vastgelegde voorwaarden.\"}\n    divider\n    table Resource as resource where resource.active columns=location,name,kind,pooled,capacity,party_limit,hourly,daily,price_unit,amenities,accessibility filter=location,kind,pooled defaults={location=preferences.location} search=name display=split empty=\"No resources match these filters\"@{nl=\"Geen voorzieningen voldoen aan deze filters\"}\n     collapse policy_title\n      text row.timezone,row.currency,row.increment,row.minimum,row.terms,row.refund_notice\n     card \"Check an hourly interval\"@{nl=\"Een tijdvak per uur controleren\"}\n      require row.price_unit==hour\n      form available\n       text result.available\n       ## total:money caption from DS-9.1 shared vocabulary.\n       stat result.total\n       content result.terms\n       text result.refund_before\n       card \"Hold this interval\"@{nl=\"Dit tijdvak tijdelijk reserveren\"}\n        require result.available\n        form hold arguments={resource=result.resource,from=result.from,until=result.until,quantity=result.quantity,attendees=result.attendees}\n         fieldset\n          select customer\n          ## proposed: email as input's \"appropriate scalar\"; checker confirms.\n          input email\n          checkbox use_allowance\n          validator email\n     card \"Check local workspace days\"@{nl=\"Lokale werkplekdagen controleren\"}\n      require row.price_unit==day\n      form available_days\n       text result.available\n       stat result.total\n       content result.terms\n       card \"Hold these days\"@{nl=\"Deze dagen tijdelijk reserveren\"}\n        require result.available\n        form hold_days arguments={resource=result.resource,start=result.start,end=result.end,quantity=result.quantity,attendees=result.attendees}\n         fieldset\n          select customer\n          input email\n          checkbox use_allowance\n     pagination\n  # Manage availability, current holds and affected downtime. @{nl=\"Beheer beschikbaarheid, huidige tijdelijke reserveringen en getroffen uitval.\"}\n  page /workspace/reservations title=\"Reservations\"@{nl=\"Reserveringen\"} order=5\n   require reservation_manager\n   breadcrumbs\n   card \"Availability and booking evidence\"@{nl=\"Beschikbaarheids- en reserveringsbewijs\"}\n    list Resource filter=location,active defaults={location=preferences.location} display=split empty=\"No resources match these filters\"@{nl=\"Geen voorzieningen voldoen aan deze filters\"}\n     edit\n     tabs\n      tab \"Resource windows\"@{nl=\"Beschikbaarheidsvensters\"}\n       form DayCalendar.create\n        fieldset\n         calendar day\n         input opens\n         input closes\n         checkbox closed\n         radio fold\n       table row.DayCalendar columns=day,opens,closes,closed empty=\"No day calendars yet\"@{nl=\"Nog geen dagkalenders\"}\n        edit\n        pagination\n       form Window.create\n        fieldset\n         input from\n         input until\n         checkbox closed\n         textarea reason\n       table row.Window columns=from,until,closed,reason empty=\"No availability windows\"@{nl=\"Geen beschikbaarheidsvensters\"}\n        edit\n        pagination\n      tab \"Booking outcomes\"@{nl=\"Reserveringsresultaten\"}\n       ## GR board: by= one enum field; status visible via grouping.\n       board row.Booking by=status columns=customer,from,until,quantity,payment,allowance empty=\"No bookings yet\"@{nl=\"Nog geen reserveringen\"}\n        history\n        pagination\n      tab \"Capacity and desks\"@{nl=\"Capaciteit en bureaus\"}\n       form revise_capacity\n        fieldset\n         ## proposed: int as input's \"appropriate scalar\"; checker confirms.\n         input capacity\n         textarea reason\n       table row.CapacityRevision columns=capacity,effective,reason empty=\"No capacity revisions yet\"@{nl=\"Nog geen capaciteitsrevisies\"}\n        pagination\n       form Desk.create\n        fieldset\n         input name\n         checkbox active\n       table row.Desk columns=name,active empty=\"No desks yet\"@{nl=\"Nog geen bureaus\"}\n        edit\n        pagination\n       list row.VenueReservation empty=\"No venue reservations\"@{nl=\"Geen ruimtereserveringen\"}\n        badge row.status\n        text row.source,row.from,row.until,row.quantity\n        copy row.source\n        pagination\n       list row.QuoteHold empty=\"No quote holds\"@{nl=\"Geen offertereserveringen\"}\n        text row.active\n        text row.source,row.from,row.until,row.quantity,row.expires\n        copy row.source\n        pagination\n       alert \"Conflicts need manager review\"@{nl=\"Conflicten vereisen beoordeling\"}\n       list row.Conflict where not row.resolved empty=\"No unresolved conflicts\"@{nl=\"Geen onopgeloste conflicten\"}\n        text row.booking,row.reason\n        button opens=conflict_resolve\n        modal \"Resolve reservation conflict\"@{nl=\"Reserveringsconflict oplossen\"} id=conflict_resolve\n         slot content\n          form resolve_conflict arguments={conflict=row} display=inline\n           fieldset\n            textarea evidence\n        pagination\n      tab \"Repair blocks and restoration\"@{nl=\"Reparatieblokkades en herstel\"}\n       button opens=repair_block\n       modal \"Block for repair\"@{nl=\"Blokkeren voor reparatie\"} id=repair_block\n        slot content\n         form block arguments={resource=row} display=inline\n          fieldset\n           input from\n           input until\n           textarea reason\n       list row.Downtime empty=\"No repair blocks\"@{nl=\"Geen reparatieblokkades\"}\n        text row.active\n        text row.from,row.until,row.reason,row.verified_by,row.verification\n        copy row.source\n        button opens=downtime_restore\n        modal \"Restore availability\"@{nl=\"Beschikbaarheid herstellen\"} id=downtime_restore\n         slot content\n          form restore arguments={downtime=row} display=inline\n           fieldset\n            textarea evidence\n        pagination\n     pagination\n\n# Fulfill received payments and allowances without treating provider requests as success. @{nl=\"Verwerk ontvangen betalingen en tegoeden zonder provideraanvragen als succes te behandelen.\"}\npackage rent_fulfillment label=\"Workspace fulfillment\"@{nl=\"Werkplekuitvoering\"}\n use rent_reservations {Booking,ReservationChanged,prepare,arrive,depart,cancel_booking,move,reception,assign_desk,fulfill_free,no_show,confirm_account,extend,reconcile_booking,reconcile_allowance,move_days,move_membership,move_membership_days,abandon_movement,reconcile_movement,retry_movement_cleanup,resend_notice}\n use employee {can_work}\n Given\n When\n  # Ask the billing and allowance owners to reconcile the held booking. @{nl=\"Vraag de facturatie- en tegoedeigenaren de tijdelijke reservering te reconciliëren.\"}\n  scenario request(booking:Booking,use_allowance:bool=false label=\"Use membership allowance\"@{nl=\"Lidmaatschapstegoed gebruiken\"}) by=authenticated or reception label=\"Request payment and allowance\"@{nl=\"Betaling en tegoed aanvragen\"}\n   require (booking.account==actor or (reception and can_work(actor,booking.parent.location))) and booking.status==held\n   do\n    call prepare {booking,use_allowance}\n  # Check in only a currently fulfilled booking; physical occupancy lasts until checkout. @{nl=\"Check alleen een momenteel voldane reservering in; werkelijk gebruik duurt tot het uitchecken.\"}\n  scenario check_in(booking:Booking) by=reception label=\"Check in\"@{nl=\"Inchecken\"}\n   require can_work(actor,booking.parent.location) and booking.status==confirmed and booking.payment in [paid,free,on_account] and booking.allowance in [not_required,consumed]\n   do call arrive {booking}\n  # Record actual checkout rather than freeing an overrun by the clock. @{nl=\"Leg werkelijk uitchecken vast in plaats van uitgelopen gebruik op basis van de klok vrij te geven.\"}\n  scenario check_out(booking:Booking) by=reception label=\"Check out\"@{nl=\"Uitchecken\"}\n   require can_work(actor,booking.parent.location) and booking.checked_in!=null and booking.checked_out==null\n   do call depart {booking}\n  # Cancel future access and request the frozen-policy refund outcome separately. @{nl=\"Annuleer toekomstige toegang en vraag afzonderlijk terugbetaling volgens de vastgelegde voorwaarden aan.\"}\n  scenario cancel(booking:Booking,reason:text) by=authenticated or reception\n   require (booking.account==actor or (reception and can_work(actor,booking.parent.location))) and trim(reason)!=\"\"\n   do call cancel_booking {booking,reason}\n Then\n  # Show fulfillment, money and actual occupancy as separate recorded outcomes. @{nl=\"Toon uitvoering, betalingen en werkelijk gebruik als afzonderlijk vastgelegde resultaten.\"}\n  page /workspace/my-bookings title=\"My bookings\"@{nl=\"Mijn reserveringen\"} order=2\n   require authenticated\n   breadcrumbs\n   card \"Your booking outcomes\"@{nl=\"Jouw reserveringsresultaten\"}\n    ## Static process guide; steps never define or execute a workflow. UC steps/item schema.\n    steps\n     slot item\n      text \"Hold\"@{nl=\"Reserveren\"}\n     slot item\n      text \"Request\"@{nl=\"Aanvragen\"}\n     slot item\n      text \"Confirm\"@{nl=\"Bevestigen\"}\n     slot item\n      text \"Arrive\"@{nl=\"Aankomen\"}\n     slot item\n      text \"Depart\"@{nl=\"Vertrekken\"}\n    divider\n    list Booking as booking where booking.account==actor order=booking.from display=split empty=\"No bookings yet\"@{nl=\"Nog geen reserveringen\"}\n     badge row.status\n     badge row.payment\n     badge row.allowance\n     badge row.refund_state\n     stat row.total\n     text row.from,row.until,row.monetary_due,row.service_due,row.allowance_units,row.included_units\n     copy row.source\n     actions reconcile_booking,reconcile_allowance\n     join\n      button opens=request_payment\n     join\n      button opens=move_hold\n      button opens=move_days_hold\n      button opens=move_member\n      button opens=move_member_days\n     join\n      button opens=booking_extend\n      button opens=booking_cancel\n      button opens=free_confirm\n     modal \"Request payment and allowance\"@{nl=\"Betaling en tegoed aanvragen\"} id=request_payment\n      slot content\n       form request arguments={booking=row} display=inline\n        fieldset\n         checkbox use_allowance\n     modal \"Move held booking\"@{nl=\"Tijdelijke reservering verplaatsen\"} id=move_hold\n      slot content\n       form move arguments={booking=row} display=inline\n        fieldset\n         input from\n         input until\n     modal \"Move workspace days\"@{nl=\"Werkplekdagen verplaatsen\"} id=move_days_hold\n      slot content\n       form move_days arguments={booking=row} display=inline\n        fieldset\n         calendar start\n         calendar end\n     modal \"Move member workspace\"@{nl=\"Ledenwerkplek verplaatsen\"} id=move_member\n      slot content\n       form move_membership arguments={booking=row} display=inline\n        fieldset\n         input from\n         input until\n     modal \"Move member workspace days\"@{nl=\"Ledenwerkplekdagen verplaatsen\"} id=move_member_days\n      slot content\n       form move_membership_days arguments={booking=row} display=inline\n        fieldset\n         calendar start\n         calendar end\n     modal \"Extend booking\"@{nl=\"Reservering verlengen\"} id=booking_extend\n      slot content\n       form extend arguments={booking=row} display=inline\n        fieldset\n         input until\n         textarea reason\n         ## proposed: money as input's \"appropriate scalar\"; checker confirms.\n         input amount\n     modal \"Cancel booking\"@{nl=\"Reservering annuleren\"} id=booking_cancel\n      slot content\n       form cancel arguments={booking=row} display=inline\n        fieldset\n         textarea reason\n     modal \"Confirm free booking\"@{nl=\"Gratis reservering bevestigen\"} id=free_confirm\n      slot content\n       form fulfill_free arguments={booking=row} display=inline\n        fieldset\n         textarea reason\n     collapse \"Frozen commercial terms\"@{nl=\"Vastgelegde commerciële voorwaarden\"}\n      text row.terms,row.refund_before,row.expires,row.checked_in,row.checked_out,row.cancellation_reason\n     list row.Movement empty=\"No workspace moves\"@{nl=\"Geen werkplekverplaatsingen\"}\n      badge row.state\n      text row.intervals,row.outcome\n      actions abandon_movement,reconcile_movement,retry_movement_cleanup\n      pagination\n     list row.Notice empty=\"No correspondence yet\"@{nl=\"Nog geen correspondentie\"}\n      status row.state\n      text row.kind,row.subject\n      tooltip \"Retry delivery\"@{nl=\"Opnieuw verzenden\"}\n       action resend_notice\n      pagination\n     history\n     pagination\n  # Resolve physical arrivals, departures and late-payment exceptions. @{nl=\"Los werkelijke aankomsten, vertrekken en uitzonderingen bij late betaling op.\"}\n  page /workspace/arrivals title=\"Workspace arrivals\"@{nl=\"Werkplekaankomsten\"} order=3\n   require reception\n   breadcrumbs\n   card \"Physical arrivals and departures\"@{nl=\"Werkelijke aankomsten en vertrekken\"}\n    table Booking columns=customer,from,until,status,checked_in,checked_out,overdue filter=status display=split empty=\"No bookings to handle\"@{nl=\"Geen reserveringen om af te handelen\"}\n     actions check_in,check_out\n     join\n      button opens=request_payment_arrival\n      button opens=free_confirm_arrival\n      button opens=account_confirm\n     modal \"Request payment and allowance\"@{nl=\"Betaling en tegoed aanvragen\"} id=request_payment_arrival\n      slot content\n       form request arguments={booking=row} display=inline\n        fieldset\n         checkbox use_allowance\n     modal \"Confirm free booking\"@{nl=\"Gratis reservering bevestigen\"} id=free_confirm_arrival\n      slot content\n       form fulfill_free arguments={booking=row} display=inline\n        fieldset\n         textarea reason\n     modal \"Confirm on account\"@{nl=\"Op rekening bevestigen\"} id=account_confirm\n      slot content\n       form confirm_account arguments={booking=row} display=inline\n        fieldset\n         textarea reason\n     dropdown\n      slot trigger\n       text \"More actions\"@{nl=\"Meer acties\"}\n      slot content\n       button opens=booking_no_show\n       button opens=booking_cancel_arrival\n       button opens=desk_assign\n     modal \"Record no-show\"@{nl=\"Niet verschijnen vastleggen\"} id=booking_no_show\n      slot content\n       form no_show arguments={booking=row} display=inline\n        fieldset\n         textarea reason\n     modal \"Cancel booking\"@{nl=\"Reservering annuleren\"} id=booking_cancel_arrival\n      slot content\n       form cancel arguments={booking=row} display=inline\n        fieldset\n         textarea reason\n     modal \"Assign pool desk\"@{nl=\"Poolbureau toewijzen\"} id=desk_assign\n      slot content\n       form assign_desk arguments={booking=row} display=inline\n        fieldset\n         select desk\n         input from\n         input until\n     history\n     pagination\n\n# Read the resource owner's local booking and occupancy records under existing grants. @{nl=\"Lees lokale reserverings- en bezettingsgegevens van de voorzieningseigenaar met de bestaande bevoegdheden.\"}\npackage rent_reporting label=\"Workspace occupancy\"@{nl=\"Werkplekbezetting\"}\n use rent_reservations {Resource,Booking,resource_report,reservation_manager}\n use rent_catalog {Location}\n Given\n  preferences { location:Location? }\n When\n Then\n  # Keep booked intervals and actual occupancy visible as distinct evidence. @{nl=\"Houd gereserveerde tijdvakken en werkelijke bezetting zichtbaar als afzonderlijk bewijs.\"}\n  page /workspace/occupancy title=\"Local occupancy\"@{nl=\"Lokale bezetting\"} order=4\n   require authenticated\n   breadcrumbs\n   card \"Booked agenda and physical occupancy\"@{nl=\"Reserveringsagenda en werkelijke bezetting\"}\n    calendar Booking as booking where preferences.location==null or booking.parent.location==preferences.location start=from end=until empty=\"No bookings in this view\"@{nl=\"Geen reserveringen in deze weergave\"}\n     badge row.status\n     text row.quantity,row.checked_in,row.checked_out\n     pagination\n   card \"Resource capacity\"@{nl=\"Voorzieningscapaciteit\"}\n    table Resource columns=location,name,capacity filter=location defaults={location=preferences.location} empty=\"No resources match these filters\"@{nl=\"Geen voorzieningen voldoen aan deze filters\"}\n     card \"Current source checkpoint\"@{nl=\"Huidig broncontrolepunt\"}\n      require reservation_manager\n      form resource_report\n       text result.checkpoint\n       table result.rows columns=from,until,metric,quantity,unit,provisional empty=\"No measures in this window\"@{nl=\"Geen maatstaven in dit venster\"}\n        pagination\n     pagination\n"}}
