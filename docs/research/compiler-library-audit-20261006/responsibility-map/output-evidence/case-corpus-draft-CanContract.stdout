{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"2b76ae93e292f9342f11701ca073c540030d9e5617168014cf253533d39d0824","before_projection_sha256":"2b76ae93e292f9342f11701ca073c540030d9e5617168014cf253533d39d0824","changed":false,"idempotent":true,"structure_equal":true,"text":"# Help workspace managers track customer occupancy agreements, property agreements, and supplier contracts with their obligations and notice dates. @{nl=\"Help werkplekbeheerders klantgebruiksovereenkomsten, vastgoedovereenkomsten en leverancierscontracten met verplichtingen en opzegdata volgen.\"}\napp CanContract uses=[agreements]\n\n# Retain executed agreement terms, renewals and obligation evidence without changing inventory. @{nl=\"Bewaar ondertekende overeenkomstvoorwaarden, verlengingen en verplichtingsbewijs zonder voorraad te wijzigen.\"}\npackage agreements\n use customer {Customer}\n use supplier {Supplier}\n use rent_catalog {Location,test_site}\n use employee {Employee,can_work,test_worker}\n use std {EmailV1 as Mail} from=deployment.mail\n Given\n  role legal label=\"Legal reviewer\"@{nl=\"Juridisch beoordelaar\"}\n  role property_manager label=\"Property manager\"@{nl=\"Vastgoedbeheerder\"}\n  role sales label=\"Sales\"@{nl=\"Verkoop\"}\n  role finance label=\"Finance\"@{nl=\"Financiën\"}\n  export Agreement { title:text, category:enum(customer,landlord,supplier) label={text=\"Category\"@{nl=\"Categorie\"},values={customer=label_Agreement_category_customer,landlord=\"Landlord\"@{nl=\"Verhuurder\"},supplier=label_Agreement_category_supplier}}, location:Location, customer:Customer? label=label_Agreement_category_customer, supplier:Supplier? label=label_Agreement_category_supplier, counterparty:text label=\"Counterparty\"@{nl=\"Wederpartij\"}, owner:Employee label=\"Responsible person\"@{nl=\"Verantwoordelijke\"}, email:email, resource:text? label=\"Resource reference\"@{nl=\"Middelreferentie\"}, active:bool=true } label=\"Agreement\"@{nl=\"Overeenkomst\"}\n  contract ExecutedParties { title:text, counterparty:text, owner:user, location:text, address:text }\n  export Term in Agreement { snapshot:ExecutedParties?, timezone:timezone?, executed_by:user?, executed_at:datetime?, expired:bool=false label=\"Expired\"@{nl=\"Verlopen\"}, notice_suppressed:bool=false, file:file, from:date label=label_Term_from, until:date label=label_Term_until, notice_days:int=30 min=0 label=label_Term_notice_days, pricing:text label=label_Term_pricing, currency:currency, previous:Term? label=\"Previous term\"@{nl=\"Vorige termijn\"}, executed:bool=false label=\"Executed\"@{nl=\"Ondertekend\"}, terminated:bool=false label=\"Terminated\"@{nl=\"Beëindigd\"}, reason:text? } label=\"Agreement term\"@{nl=\"Overeenkomsttermijn\"}\n  Obligation in Term { title:text, due:date, done:bool=false, completed_by:user? label=\"Completed by\"@{nl=\"Afgerond door\"}, completed_at:datetime? label=\"Completion time\"@{nl=\"Afgerond op\"} } label=\"Obligation\"@{nl=\"Verplichting\"}\n  Amendment in Term { text:text label=\"Text\"@{nl=\"Tekst\"}, file:file?, author:user server=actor label=\"Author\"@{nl=\"Auteur\"} } label=\"Agreement amendment\"@{nl=\"Overeenkomstaanvulling\"}\n  NoticeDelivery in Term { obligation:Obligation?, revision:int, delivery:delivery(Mail.send) } label=\"Reminder outcome\"@{nl=\"Herinneringsresultaat\"}\n  derive NoticeDelivery.state:DeliveryResult.status = row.delivery.status label=\"Reminder delivery\"@{nl=\"Herinneringsbezorging\"}\n  event Notice { term:Term, revision:int }\n  event Expire { term:Term, at:datetime }\n  event ObligationDue { obligation:Obligation, revision:int }\n  derive allowed(person:user,agreement:Agreement):bool = can_work(person,agreement.location) and (legal(person) or (sales(person) and agreement.category==customer) or (property_manager(person) and agreement.category==landlord) or (finance(person) and agreement.category==supplier))\n  derive Term.notice_date:date = add_days(row.until,-row.notice_days) label=\"Notice deadline\"@{nl=\"Opzegdeadline\"}\n  policy Agreement read=legal or (sales and row.category==customer) or (property_manager and row.category==landlord) or (finance and row.category==supplier) where=allowed(actor,row)\n  policy Term read=legal or (sales and row.parent.category==customer) or (property_manager and row.parent.category==landlord) or (finance and row.parent.category==supplier) where=allowed(actor,row.parent)\n  policy Obligation read=legal or sales or property_manager or finance where=allowed(actor,row.parent.parent)\n  policy Amendment read=legal or sales or property_manager or finance where=allowed(actor,row.parent.parent)\n  policy NoticeDelivery read=legal or sales or property_manager or finance where=allowed(actor,row.parent.parent) fields=parent,obligation,revision,delivery.id,delivery.status,state,created_by,created,updated_by,updated,archived_at\n  invariant Agreement: ((row.category==customer and row.customer!=null and row.supplier==null) or (row.category==supplier and row.supplier!=null and row.customer==null) or (row.category==landlord and row.customer==null))\n  invariant Term: row.from<=row.until and (row.previous==null or row.previous.parent==row.parent) and (not row.executed or (row.snapshot!=null and row.timezone!=null and row.executed_by!=null and row.executed_at!=null))\n  lock Term fields=snapshot,timezone,executed_by,executed_at,file,from,until,notice_days,pricing,currency,previous when=row.executed\n  lock Amendment fields=text,file,author\n  lock NoticeDelivery fields=obligation,revision,delivery\n  fixture signed_file=file {}\n  fixture renewal_file=file {}\n  fixture property_agreement=Agreement {title=\"Workspace lease\",category=landlord,location=test_site,counterparty=\"Property owner\",owner=test_worker,email=\"owner@example.test\"}\n  fixture current_term=Term {snapshot={title=\"Workspace lease\",counterparty=\"Property owner\",owner=self,location=test_site.id,address=test_site.address},timezone=test_site.timezone,executed_by=self,executed_at=datetime(\"2026-01-01T00:00:00Z\"),parent=property_agreement,file=signed_file,from=date(\"2026-01-01\"),until=date(\"2098-12-31\"),pricing=\"EUR 1000 monthly\",currency=\"EUR\"}\n  fixture due_obligation=Obligation {parent=current_term,title=\"Insurance evidence\",due=date(\"2098-10-01\")}\n  fixture reminder=Mail.send {request={to=\"owner@example.test\",subject=\"Agreement obligation due\",body=\"Insurance evidence\"}}\n  fixture recorded_notice=NoticeDelivery {parent=current_term,obligation=due_obligation,revision=1,delivery=reminder}\n  preferences { location:Location? }\n  invariant preferences: row.location==null or can_work(actor,row.location)\n  message label_Agreement_category_customer = \"Customer\"@{nl=\"Klant\"}\n  message label_Agreement_category_supplier = \"Supplier\"@{nl=\"Leverancier\"}\n  message label_Term_from = \"From\"@{nl=\"Vanaf\"}\n  message label_Term_until = \"Until\"@{nl=\"Tot\"}\n  message label_Term_notice_days = \"Notice period in days\"@{nl=\"Opzegtermijn in dagen\"}\n  message label_Term_pricing = \"Pricing terms\"@{nl=\"Prijsafspraken\"}\n When\n  crud Agreement by=legal or sales or property_manager or finance fields=title,owner,email,active create_fields=title,category,location,customer,supplier,counterparty,owner,email,resource when=allowed(actor,row) and row.owner.active and can_work(row.owner.user,row.location) delete=none\n  crud Term by=legal or sales or property_manager or finance fields=file,from,until,notice_days,pricing,currency create_fields=file,from,until,notice_days,pricing,currency,previous when=allowed(actor,row.parent) and not row.executed delete=none\n  crud Obligation by=legal or sales or property_manager or finance fields=title,due when=allowed(actor,row.parent.parent) and not row.parent.terminated and not row.done delete=none\n  crud Amendment by=legal fields=text,file update=none delete=none when=allowed(actor,row.parent.parent)\n  # Freeze the executed file and calendar dates and arm one notice reminder. @{nl=\"Leg het ondertekende bestand en de kalenderdatums vast en activeer één opzegherinnering.\"}\n  scenario execute(term:Term) by=legal label=\"Execute agreement\"@{nl=\"Overeenkomst ondertekenen\"}\n   require allowed(actor,term.parent) and not term.executed and term.parent.active\n   do\n    let timezone=term.parent.location.timezone\n    set term {executed=true,timezone,executed_by=actor,executed_at=now,snapshot={title=term.parent.title,counterparty=term.parent.counterparty,owner=term.parent.owner.user,location=term.parent.location.id,address=term.parent.location.address}}\n    let expiry=local_instant(add_days(term.until,1),\"00:00\",timezone,fold=earlier)\n    if expiry<=now\n     set term {expired=true}\n    else\n     schedule format(\"term-expiry-{id}\",{id=term.id}) at=expiry event=Expire {term,at=expiry}\n    let notice=local_instant(add_days(term.until,-term.notice_days),\"00:00\",timezone,fold=earlier)\n    if notice>now\n     schedule term.id at=notice event=Notice {term,revision=term.version+1}\n   examples term=current_term\n    as,term.executed -> term.executed,term.file,term.from,term.until\n    legal,false -> true,signed_file,date(\"2026-01-01\"),date(\"2098-12-31\")\n    legal,true -> error(rule_failed)\n    property_manager,false -> error(forbidden)\n  # Record a new term linked to the previous executed agreement without extending a booking. @{nl=\"Leg een nieuwe termijn vast die naar de vorige ondertekende overeenkomst verwijst zonder een boeking te verlengen.\"}\n  export scenario renew(term:Term,file:file,from:date label=label_Term_from,until:date label=label_Term_until,notice_days:int label=label_Term_notice_days,pricing:text label=label_Term_pricing,currency:currency) by=legal label=\"Record renewal\"@{nl=\"Verlenging vastleggen\"}\n   require allowed(actor,term.parent) and term.executed and from<=until and notice_days>=0\n   do\n    create Term {parent=term.parent,file,from,until,notice_days,pricing,currency,previous=term} as renewal\n    set term {notice_suppressed=true}\n    cancel term.id\n   examples term=current_term file=renewal_file from=date(\"2099-01-01\") notice_days=30 pricing=\"EUR 1100 monthly\" currency=\"EUR\"\n    as,term.executed,until -> term.file,term.from,term.until,term.pricing,term.executed,count(term.parent.Term),any(term.parent.Term as renewal,renewal.id!=term.id and renewal.previous==term and renewal.file==renewal_file and renewal.file!=term.file and renewal.from==date(\"2099-01-01\") and renewal.until==date(\"2099-12-31\") and renewal.notice_days==30 and renewal.pricing==\"EUR 1100 monthly\" and renewal.currency==\"EUR\" and not renewal.executed)\n    legal,true,date(\"2099-12-31\") -> signed_file,date(\"2026-01-01\"),date(\"2098-12-31\"),\"EUR 1000 monthly\",true,2,true\n    legal,false,date(\"2099-12-31\") -> error(rule_failed)\n    legal,true,date(\"2098-12-31\") -> error(rule_failed)\n    property_manager,true,date(\"2099-12-31\") -> error(forbidden)\n  # Record termination while preserving executed terms and prior obligations. @{nl=\"Leg beëindiging vast met behoud van ondertekende voorwaarden en eerdere verplichtingen.\"}\n  scenario terminate(term:Term,reason:text) by=legal label=\"Terminate term\"@{nl=\"Termijn beëindigen\"}\n   require allowed(actor,term.parent) and term.executed and not term.terminated and trim(reason)!=\"\"\n   do\n    set term {terminated=true,reason}\n    cancel term.id\n  # Complete an obligation with an attributable actor and time. @{nl=\"Rond een verplichting af met een herleidbare uitvoerder en tijd.\"}\n  scenario complete(obligation:Obligation) by=legal or sales or property_manager or finance\n   require allowed(actor,obligation.parent.parent) and not obligation.done and not obligation.parent.terminated\n   do\n    set obligation {done=true,completed_by=actor,completed_at=now}\n    cancel obligation.id\n   examples seed=[recorded_notice] obligation=due_obligation\n    as,reminder.status,reminder.result,reminder.error -> obligation.done,obligation.completed_by,recorded_notice.state\n    legal,pending,null,null -> true,self,pending\n    legal,succeeded,{reference=\"accepted-mail\"},null -> true,self,succeeded\n    legal,failed,null,{code=\"provider\",message=\"Rejected\"} -> true,self,failed\n    legal,unknown,null,null -> true,self,unknown\n    legal,skipped,null,null -> true,self,skipped\n  scenario arm on=Obligation.create\n   do\n    let due=local_instant(event.after.due,\"00:00\",event.after.parent.timezone??event.after.parent.parent.location.timezone,fold=earlier)\n    schedule event.after.id at=max([now+1ms,due]) event=ObligationDue {obligation=event.after,revision=event.after.version}\n  scenario rearm on=Obligation.update\n   do\n    cancel event.after.id\n    if not event.after.done and not event.after.parent.terminated\n     let due=local_instant(event.after.due,\"00:00\",event.after.parent.timezone??event.after.parent.parent.location.timezone,fold=earlier)\n     schedule event.after.id at=max([now+1ms,due]) event=ObligationDue {obligation=event.after,revision=event.after.version}\n  scenario expire on=Expire\n   do\n    if event.term.executed and not event.term.terminated and not event.term.expired and event.term.timezone!=null and event.at==local_instant(add_days(event.term.until,1),\"00:00\",event.term.timezone,fold=earlier) and event.at<=now\n     set event.term {expired=true}\n   examples event={term=current_term,at=local_instant(add_days(current_term.until,1),\"00:00\",test_site.timezone,fold=earlier)}\n    event.term.executed,event.term.terminated -> event.term.expired\n    false,false -> false\n    true,true -> false\n  scenario notice on=Notice\n   do\n    if event.term.version==event.revision and event.term.executed and event.term.snapshot!=null and not event.term.terminated and not event.term.expired and not event.term.notice_suppressed and event.term.parent.active\n     send Mail.send {to=event.term.parent.email,subject=format(\"Agreement notice deadline\"@{nl=\"Opzegdeadline overeenkomst\"},locale=null),body=event.term.snapshot.title} when=event.term.version==event.revision and not event.term.terminated and not event.term.expired and not event.term.notice_suppressed and event.term.parent.active as delivery\n     create NoticeDelivery {parent=event.term,revision=event.revision,delivery} as notice\n   examples event={term=current_term,revision=current_term.version}\n    event.term.executed,event.term.terminated,event.term.expired,event.term.notice_suppressed,event.term.parent.active,event.revision -> count(current_term.NoticeDelivery),first(current_term.NoticeDelivery)?.state\n    true,false,false,false,true,1 -> 1,pending\n    false,false,false,false,true,1 -> 0,null\n    true,true,false,false,true,1 -> 0,null\n    true,false,true,false,true,1 -> 0,null\n    true,false,false,true,true,1 -> 0,null\n    true,false,false,false,false,1 -> 0,null\n    true,false,false,false,true,2 -> 0,null\n  scenario due on=ObligationDue\n   do\n    if event.obligation.version==event.revision and not event.obligation.done and not event.obligation.parent.terminated and event.obligation.parent.parent.active\n     send Mail.send {to=event.obligation.parent.parent.email,subject=format(\"Agreement obligation due\"@{nl=\"Deadline overeenkomstverplichting\"},locale=null),body=event.obligation.title} when=event.obligation.version==event.revision and not event.obligation.done and not event.obligation.parent.terminated and event.obligation.parent.parent.active as delivery\n     create NoticeDelivery {parent=event.obligation.parent,obligation=event.obligation,revision=event.revision,delivery} as notice\n   examples event={obligation=due_obligation,revision=due_obligation.version}\n    event.obligation.done,event.obligation.parent.terminated,event.obligation.parent.parent.active,event.revision -> count(current_term.NoticeDelivery),first(current_term.NoticeDelivery)?.obligation,first(current_term.NoticeDelivery)?.state\n    false,false,true,1 -> 1,due_obligation,pending\n    true,false,true,1 -> 0,null,null\n    false,true,true,1 -> 0,null,null\n    false,false,false,1 -> 0,null,null\n    false,false,true,2 -> 0,null,null\n Then\n  # Retrieve executed terms, amendments and current obligation queues. @{nl=\"Haal ondertekende voorwaarden, aanvullingen en huidige verplichtingswachtrijen op.\"}\n  page /agreements title=\"Agreements\"@{nl=\"Overeenkomsten\"}\n   require legal or sales or property_manager or finance\n   breadcrumbs\n   ## Time-critical queues precede the registry so reviewers act before deadlines.\n   card \"Upcoming notice deadlines\"@{nl=\"Aankomende opzegdeadlines\"}\n    table Term as term where term.executed and not term.terminated and not term.expired and not term.notice_suppressed columns=parent,notice_date,until order=notice_date empty=\"No upcoming notice deadlines\"@{nl=\"Geen aankomende opzegdeadlines\"}\n     badge term.parent.category\n     pagination\n   card \"Open obligations\"@{nl=\"Open verplichtingen\"}\n    table Obligation as obligation where not obligation.done and not obligation.parent.terminated columns=parent,title,due order=due empty=\"No open obligations\"@{nl=\"Geen open verplichtingen\"}\n     tooltip \"Complete this obligation with attribution\"@{nl=\"Rond deze verplichting toe met herleiding\"}\n      button action=complete\n     pagination\n   divider \"Agreement registry\"@{nl=\"Overeenkomstregister\"}\n   card \"Agreement intake\"@{nl=\"Overeenkomst aanmaken\"}\n    form Agreement.create\n     ## Every create field is placed; active is update-only and stays out of intake.\n     fieldset \"Identity and category\"@{nl=\"Identiteit en categorie\"}\n      label title\n      input title\n      select category\n      select location\n     fieldset \"Parties\"@{nl=\"Partijen\"}\n      select customer\n      select supplier\n      input counterparty\n      input resource\n     fieldset \"Responsibility\"@{nl=\"Verantwoordelijkheid\"}\n      select owner\n      label email\n      input email\n      validator email\n     button submit=true\n   list Agreement columns=title,category,location,owner,counterparty,active filter=category,location,owner defaults={location=preferences.location} search=title display=split empty=\"No agreements match these filters\"@{nl=\"Geen overeenkomsten voor deze filters\"}\n    card \"Agreement parties\"@{nl=\"Overeenkomstpartijen\"}\n     status row.active\n     text row.counterparty,row.owner,row.customer,row.supplier,row.resource\n     edit\n      fieldset \"Agreement maintenance\"@{nl=\"Overeenkomstbeheer\"}\n       input title\n       select owner\n       input email\n       toggle active\n      button submit=true\n     button opens=new_term\n     modal \"Record term\"@{nl=\"Termijn vastleggen\"} id=new_term\n      slot content\n       form Term.create arguments={parent=row}\n        fieldset \"Document and dates\"@{nl=\"Document en data\"}\n         file_input file\n         calendar from\n         calendar until\n        fieldset \"Commercial terms\"@{nl=\"Commerciële voorwaarden\"}\n         input notice_days\n         textarea pricing\n         input currency\n         select previous\n        button submit=true\n    list row.Term order=until empty=\"No terms recorded\"@{nl=\"Geen termijnen vastgelegd\"}\n     card \"Recorded term\"@{nl=\"Vastgelegde termijn\"}\n      ## Lifecycle strip: each stage shows its live flag beside the frozen record.\n      steps\n       slot item\n        status row.executed\n       slot item\n        status row.expired\n       slot item\n        status row.terminated\n      text row.file,row.from,row.until,row.pricing,row.currency,row.notice_days,row.notice_date,row.timezone,row.snapshot\n      text row.reason\n      button target=row.file caption=\"Download executed file\"@{nl=\"Ondertekend bestand downloaden\"}\n      edit\n       fieldset \"Term dates and pricing\"@{nl=\"Termijndata en prijzen\"}\n        file_input file\n        calendar from\n        calendar until\n        input notice_days\n        textarea pricing\n        input currency\n       button submit=true\n      button opens=execute_term\n      modal \"Execute agreement\"@{nl=\"Overeenkomst ondertekenen\"} id=execute_term\n       slot content\n        alert \"Execution freezes the file, dates and party snapshot.\"@{nl=\"Ondertekening legt het bestand, de data en de partijsnapshot vast.\"}\n        form execute arguments={term=row}\n      tooltip \"Record a renewal linked to this term\"@{nl=\"Leg een verlenging vast die naar deze termijn verwijst\"}\n       button opens=renew_term\n      modal \"Record renewal\"@{nl=\"Verlenging vastleggen\"} id=renew_term\n       slot content\n        form renew arguments={term=row}\n         fieldset \"Renewal document and dates\"@{nl=\"Verlengingsdocument en data\"}\n          file_input file\n          calendar from\n          calendar until\n         fieldset \"Renewal commercial terms\"@{nl=\"Commerciële verlengingsvoorwaarden\"}\n          label notice_days\n          input notice_days\n          validator notice_days\n          textarea pricing\n          input currency\n         button submit=true\n      button opens=terminate_term\n      modal \"Terminate term\"@{nl=\"Termijn beëindigen\"} id=terminate_term\n       slot content\n        alert \"Termination preserves history and cancels pending reminders.\"@{nl=\"Beëindiging behoudt de historie en annuleert openstaande herinneringen.\"}\n        form terminate arguments={term=row}\n         textarea reason\n         button submit=true\n     tabs\n      tab \"Obligations\"@{nl=\"Verplichtingen\"}\n       form Obligation.create arguments={parent=row}\n        fieldset \"Obligation\"@{nl=\"Verplichting\"}\n         input title\n         calendar due\n        button submit=true\n       table row.Obligation columns=title,due order=due filter=done empty=\"No obligations match this filter\"@{nl=\"Geen verplichtingen voor dit filter\"}\n        status row.done\n        edit\n        tooltip \"Complete this obligation with attribution\"@{nl=\"Rond deze verplichting toe met herleiding\"}\n         button action=complete\n        details \"Obligation completion\"@{nl=\"Afronding verplichting\"}\n         text row.completed_by,row.completed_at\n        pagination\n      tab \"Reminder outcomes\"@{nl=\"Herinneringsresultaten\"}\n       alert \"Failed or unavailable deliveries need legal review; skipped reminders are obsolete, not failed.\"@{nl=\"Mislukte of onbeschikbare bezorgingen vereisen juridische beoordeling; overgeslagen herinneringen zijn achterhaald, niet mislukt.\"}\n       table row.NoticeDelivery columns=obligation,revision order=-created empty=\"No reminders recorded\"@{nl=\"Geen herinneringen vastgelegd\"}\n        badge row.state\n        pagination\n      tab \"Amendments\"@{nl=\"Aanvullingen\"}\n       form Amendment.create arguments={parent=row}\n        fieldset \"Amendment\"@{nl=\"Aanvulling\"}\n         textarea text\n         file_input file\n        button submit=true\n       list row.Amendment empty=\"No amendments recorded\"@{nl=\"Geen aanvullingen vastgelegd\"}\n        text row.text,row.file,row.author\n        pagination\n     details \"Term history\"@{nl=\"Termijnhistorie\"}\n      text row.previous\n      diff\n       slot before\n        text row.previous?.file,row.previous?.from,row.previous?.until,row.previous?.pricing,row.previous?.currency\n       slot after\n        text row.file,row.from,row.until,row.pricing,row.currency\n      history\n     pagination\n"}}
