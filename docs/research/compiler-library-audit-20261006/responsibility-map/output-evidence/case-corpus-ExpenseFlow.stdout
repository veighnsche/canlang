{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"9e90685daa899946fb2fde36f1a3973b878ef9ddfeb9e52fcd51b29b5755273e","before_projection_sha256":"9e90685daa899946fb2fde36f1a3973b878ef9ddfeb9e52fcd51b29b5755273e","changed":true,"idempotent":true,"structure_equal":true,"text":"# Submit team expenses and let a reviewer approve or reject them. @{nl=\"Dien teamonkosten in en laat een beoordelaar ze goedkeuren of afwijzen.\"}\napp ExpenseFlow uses=[expenses,reporting]\npackage expenses\n Given\n  preferences { status:Expense.status? }\n  message label_Expense_decision_note = \"Decision note\"@{nl=\"Toelichting op het besluit\"}\n  role reviewer label=\"Reviewer\"@{nl=\"Beoordelaar\"}\n  export Expense {\n   purpose:text trim max=300 label=\"Expense purpose\"@{nl=\"Doel van de onkost\"},\n   amount:money,\n   submitted_by:user server=actor label=\"Submitted by\"@{nl=\"Ingediend door\"},\n   status:enum(draft,submitted,approved,rejected)=draft label={text=\"Status\"@{nl=\"Status\"},values={draft=\"Draft\"@{nl=\"Concept\"},submitted=\"Submitted\"@{nl=\"Ingediend\"},approved=\"Approved\"@{nl=\"Goedgekeurd\"},rejected=\"Rejected\"@{nl=\"Afgewezen\"}}},\n   decision_note:text? label=label_Expense_decision_note,\n   decided_by:user? label=\"Decided by\"@{nl=\"Besloten door\"},\n   decided_at:datetime?\n   label=\"Decided at\"@{nl=\"Besloten op\"} } label=\"Expense\"@{nl=\"Onkost\"}\n  policy Expense read=members where=row.submitted_by==actor\n  policy Expense read=reviewer\n  invariant Expense: row.amount.minor>0\n  lock Expense fields=purpose,amount,submitted_by when=row.status!=draft\n  lock Expense fields=status,decision_note,decided_by,decided_at when=row.status in [approved,rejected]\n  fixture reviewer_one=user {roles=[reviewer]}\n  fixture reviewer_two=user {roles=[reviewer]}\n  fixture pending=Expense {purpose=\"Travel\",amount=money(25,\"EUR\"),submitted_by=other,status=submitted}\n When\n  crud Expense by=members fields=purpose,amount when=row.submitted_by==actor and row.status==draft delete=none\n  # Submit your own draft expense for review. @{nl=\"Dien je eigen conceptonkost ter beoordeling in.\"}\n  scenario submit(expense:Expense) by=members\n   require expense.submitted_by==actor and expense.status==draft\n   do set expense {status=submitted}\n   ## Grants belong to two noncalling same-team accounts; claimant is other.\n   ## This checks one submission, not a shared-state multi-operation journey.\n   examples expense=pending seed=[reviewer_one,reviewer_two]\n    as,expense.status -> expense.status,reviewer(reviewer_one),reviewer(reviewer_two),reviewer_one!=reviewer_two,expense.submitted_by!=reviewer_one,expense.submitted_by!=reviewer_two\n    other,draft -> submitted,true,true,true,true,true\n  # Approve a submitted expense from another teammate, optionally recording a note. @{nl=\"Keur een ingediende onkost van een andere teamgenoot goed en leg desgewenst een toelichting vast.\"}\n  scenario approve(expense:Expense,note:text? label=label_Expense_decision_note) by=reviewer label=\"Approve expense\"@{nl=\"Onkost goedkeuren\"}\n   require expense.status==submitted and expense.submitted_by!=actor\n   do set expense {status=approved,decision_note=note,decided_by=actor,decided_at=now}\n   examples expense=pending\n    as,expense.status,expense.submitted_by -> expense.status,expense.decided_by\n    reviewer,submitted,other -> approved,self\n    reviewer,draft,other -> error(rule_failed)\n    members,submitted,other -> error(forbidden)\n    reviewer,submitted,self -> error(rule_failed)\n   ## Either distinct provisioned reviewer can act; the other keeps its grant.\n   examples expense=pending seed=[reviewer_one,reviewer_two]\n    as -> expense.status,expense.decided_by,reviewer(reviewer_one),reviewer(reviewer_two)\n    reviewer_one -> approved,reviewer_one,true,true\n    reviewer_two -> approved,reviewer_two,true,true\n   ## Proposed shared-state syntax; the initial parser/runner does not implement it.\n   ## Each call uses real authorization and a separate committed transaction.\n   examples seed=[reviewer_one,reviewer_two]\n    do\n     call Expense.create {purpose=\"Travel\",amount=money(25,\"EUR\")} by=other\n     let draft_claim=first(Expense as claim where claim.submitted_by==other)\n     draft_claim!=null -> true\n     let original_version=draft_claim.version\n     call submit {expense=draft_claim} by=other\n     let submitted_claim=first(Expense as claim where claim.id==draft_claim.id)\n     submitted_claim!=null -> true\n     submitted_claim.status -> submitted\n     call approve {expense=submitted_claim} by=other -> error(forbidden)\n     submitted_claim.status -> submitted\n     call approve {expense=submitted_claim} by=reviewer_one request={expense={version=original_version}} -> error(conflict)\n     call approve {expense=submitted_claim} by=reviewer_one\n     let approved_claim=first(Expense as claim where claim.id==draft_claim.id)\n     approved_claim!=null -> true\n     approved_claim.status,approved_claim.decided_by -> approved,reviewer_one\n     call approve {expense=approved_claim} by=reviewer_two -> error(rule_failed)\n     approved_claim.status,approved_claim.decided_by -> approved,reviewer_one\n  # Reject a submitted expense from another teammate and explain the decision. @{nl=\"Wijs een ingediende onkost van een andere teamgenoot af en leg de beslissing uit.\"}\n  scenario reject(expense:Expense,note:text label=label_Expense_decision_note) by=reviewer label=\"Reject expense\"@{nl=\"Onkost afwijzen\"}\n   require expense.status==submitted and expense.submitted_by!=actor and trim(note)!=\"\"\n   do set expense {status=rejected,decision_note=note,decided_by=actor,decided_at=now}\n Then\n  # Prepare expenses and follow their review status. @{nl=\"Bereid onkosten voor en volg hun beoordelingsstatus.\"}\n  page / title=\"Expenses\"@{nl=\"Onkosten\"}\n   breadcrumbs\n   card \"Prepare an expense\"@{nl=\"Een onkost voorbereiden\"}\n    form Expense.create\n     input purpose\n     input amount\n     ## submitted_by is server-owned and never editable.\n   card \"Review status and decisions\"@{nl=\"Beoordelingsstatus en besluiten\"}\n    list Expense order=-created filter=status defaults={status=preferences.status} display=split empty=\"No expenses yet\"@{nl=\"Nog geen onkosten\"}\n     badge row.status\n     text row.purpose,row.amount,row.submitted_by\n     edit\n     action submit\n     alert\n      require row.status==rejected\n      text row.decision_note\n     divider \"Review decision\"@{nl=\"Beoordelingsbesluit\"}\n     text row.decision_note,row.decided_by,row.decided_at\n     join\n      button opens=approve_expense\n      button opens=reject_expense\n     modal \"Approve expense\"@{nl=\"Onkost goedkeuren\"} id=approve_expense\n      slot content\n       form approve arguments={expense=row} display=inline\n        textarea note\n     modal \"Reject expense\"@{nl=\"Onkost afwijzen\"} id=reject_expense\n      slot content\n       form reject arguments={expense=row} display=inline\n        textarea note\n     history\n     pagination\npackage reporting label=\"Expense reports\"@{nl=\"Onkostenrapporten\"}\n use expenses {Expense}\n Given\n  preferences { status:Expense.status=submitted }\n  contract Summary { count:int, total:money } label=\"Expense totals\"@{nl=\"Onkostentotalen\"}\n  fixture mine=Expense {purpose=\"Travel\",amount=money(25,\"EUR\"),submitted_by=self,status=submitted}\n When\n  # Summarize expenses you can read, in one currency and status. @{nl=\"Vat leesbare onkosten samen in één valuta en status.\"}\n  scenario summarize(currency:currency,status:Expense.status) read=true -> Summary by=members label=\"Summarize expenses\"@{nl=\"Onkosten samenvatten\"}\n   do\n    let selected=Expense as expense where expense.amount.currency==currency and expense.status==status\n    return Summary {count=count(selected),total=sum(selected as expense select expense.amount,currency)}\n   examples seed=[mine] currency=\"EUR\"\n    status -> result.count,result.total\n    submitted -> 1,money(25,\"EUR\")\n    approved -> 0,money(0,\"EUR\")\n Then\n  # Choose a currency and status to total the expenses visible to you. @{nl=\"Kies een valuta en status om de voor jou zichtbare onkosten op te tellen.\"}\n  page /reports title=\"Expense summary\"@{nl=\"Onkostenoverzicht\"}\n   breadcrumbs\n   card \"Visible expenses by currency and status\"@{nl=\"Zichtbare onkosten per valuta en status\"}\n    tabs preferences.status\n    form summarize arguments={status=preferences.status} display=inline\n     input currency\n     ## status binds the selected tab.\n     stat result.count,result.total\n"}}
