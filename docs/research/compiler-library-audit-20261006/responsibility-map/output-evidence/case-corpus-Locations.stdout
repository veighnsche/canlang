{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"069ef53dca3fab946156188f7c0adf6f66e59bc019f024ee779011c21fce4da8","before_projection_sha256":"069ef53dca3fab946156188f7c0adf6f66e59bc019f024ee779011c21fce4da8","changed":true,"idempotent":true,"structure_equal":true,"text":"# Own published workspace locations and their structured opening calendar. @{nl=\"Beheer gepubliceerde werkpleklocaties en hun gestructureerde openingskalender.\"}\npackage rent_catalog label=\"Workspace locations\"@{nl=\"Werkpleklocaties\"}\n use employee {can_work}\n Given\n  export role catalog_owner label=\"Catalog owner\"@{nl=\"Catalogusbeheerder\"}\n  export Location { name:text trim min=1, address:text, timezone:timezone, currency:currency, hours:text label=\"Opening hours summary\"@{nl=\"Samenvatting openingsuren\"}, arrival:text label=\"Arrival instructions\"@{nl=\"Aankomstinstructies\"}, active:bool=true } label=\"Location\"@{nl=\"Locatie\"}\n  export WeeklyHours in Location { weekday:int min=1 max=7, opens:text=\"09:00\", closes:text=\"18:00\", close_after:int=0 min=0 max=1 label=\"Closing day offset\"@{nl=\"Dagverschuiving sluiting\"}, fold:enum(earlier,later)=earlier label={text=\"Repeated local time\"@{nl=\"Herhaalde lokale tijd\"},values={earlier=\"Earlier occurrence\"@{nl=\"Eerdere tijd\"},later=\"Later occurrence\"@{nl=\"Latere tijd\"}}} } label=\"Weekly opening interval\"@{nl=\"Wekelijks openingstijdvak\"}\n  export ClosedDate in Location { day:date unique, reason:text } label=\"Closed date\"@{nl=\"Gesloten datum\"}\n  export DateHours in Location { day:date unique, opens:text=\"09:00\", closes:text=\"18:00\", close_after:int=0 min=0 max=1, closed:bool=false, fold:enum(earlier,later)=earlier label={text=\"Repeated local time\"@{nl=\"Herhaalde lokale tijd\"},values={earlier=\"Earlier occurrence\"@{nl=\"Eerdere tijd\"},later=\"Later occurrence\"@{nl=\"Latere tijd\"}}} } label=\"Dated opening exception\"@{nl=\"Gedateerde openingsuitzondering\"}\n  export contract OpeningWeek { weekday:int, opens:text, closes:text, close_after:int, fold:WeeklyHours.fold }\n  export contract OpeningDate { day:date, opens:text, closes:text, close_after:int, closed:bool, fold:DateHours.fold }\n  export LocationPolicy in Location { effective:datetime server=now, sequence:int, active:bool, timezone:timezone, weekly:OpeningWeek[], closed:date[], dated:OpeningDate[] }\n  policy LocationPolicy read=public\n  lock LocationPolicy fields=effective,sequence,active,timezone,weekly,closed,dated\n  export derive policy_open(policy:LocationPolicy,from:datetime,until:datetime):bool = policy.active and from<until and all(dates(local_date(from,policy.timezone),add_days(local_date(until-1ms,policy.timezone),1),1000) as day,not (day in policy.closed) and not any(policy.dated as hours,hours.day==day and hours.closed)) and any(dates(add_days(local_date(from,policy.timezone),-1),add_days(local_date(until,policy.timezone),1),1000) as day,any(policy.dated as hours,hours.day==day and not hours.closed and local_instant(day,hours.opens,policy.timezone,fold=hours.fold)<=from and until<=local_instant(add_days(day,hours.close_after),hours.closes,policy.timezone,fold=hours.fold)) or (not any(policy.dated as hours,hours.day==day) and any(policy.weekly as hours,hours.weekday==weekday(day) and local_instant(day,hours.opens,policy.timezone,fold=hours.fold)<=from and until<=local_instant(add_days(day,hours.close_after),hours.closes,policy.timezone,fold=hours.fold))))\n  policy Location read=public fields=name,address,timezone,currency,hours,arrival,active\n  policy WeeklyHours read=public\n  policy ClosedDate read=public\n  policy DateHours read=public\n  invariant WeeklyHours: local_instant(date(\"2000-01-01\"),row.opens,row.parent.timezone,fold=row.fold)<local_instant(add_days(date(\"2000-01-01\"),row.close_after),row.closes,row.parent.timezone,fold=row.fold)\n  invariant DateHours: row.closed or local_instant(row.day,row.opens,row.parent.timezone,fold=row.fold)<local_instant(add_days(row.day,row.close_after),row.closes,row.parent.timezone,fold=row.fold)\n  derive dated_open(location:Location,day:date,from:datetime,until:datetime):bool = any(location.DateHours as hours,hours.day==day and not hours.closed and local_instant(day,hours.opens,location.timezone,fold=hours.fold)<=from and until<=local_instant(add_days(day,hours.close_after),hours.closes,location.timezone,fold=hours.fold)) or (not any(location.DateHours as hours,hours.day==day) and any(location.WeeklyHours as hours,hours.weekday==weekday(day) and local_instant(day,hours.opens,location.timezone,fold=hours.fold)<=from and until<=local_instant(add_days(day,hours.close_after),hours.closes,location.timezone,fold=hours.fold)))\n  export derive is_open(location:Location,from:datetime,until:datetime):bool = location.active and from<until and all(dates(local_date(from,location.timezone),add_days(local_date(until-1ms,location.timezone),1),1000) as day,not any(location.ClosedDate as holiday,holiday.day==day) and not any(location.DateHours as hours,hours.day==day and hours.closed)) and any(dates(add_days(local_date(from,location.timezone),-1),add_days(local_date(until,location.timezone),1),1000) as day,dated_open(location,day,from,until))\n  export fixture recorded_site=LocationPolicy {parent=test_site,effective=now-2d,sequence=1,active=true,timezone=\"Europe/Brussels\",weekly=[OpeningWeek {weekday=weekday(local_date(now,\"Europe/Brussels\")),opens=\"09:00\",closes=\"18:00\",close_after=0,fold=earlier}],closed=[],dated=[]}\n  export fixture test_site=Location {name=\"Main\",address=\"1 Example Road\",timezone=\"Europe/Brussels\",currency=\"EUR\",hours=\"09:00–18:00\",arrival=\"Report to reception\"}\n  export fixture open_site=WeeklyHours {parent=test_site,weekday=4,opens=\"09:00\",closes=\"18:00\"}\n  export fixture sunday_site=WeeklyHours {parent=test_site,weekday=7,opens=\"09:00\",closes=\"18:00\"}\n When\n  crud Location by=catalog_owner fields=name,address,hours,arrival,active create_fields=name,address,timezone,currency,hours,arrival when=can_work(actor,row) delete=none\n  crud WeeklyHours by=catalog_owner fields=weekday,opens,closes,close_after,fold when=can_work(actor,row.parent) delete=none\n  crud ClosedDate by=catalog_owner fields=day,reason when=can_work(actor,row.parent) delete=none\n  crud DateHours by=catalog_owner fields=day,opens,closes,close_after,closed,fold when=can_work(actor,row.parent) delete=none\n  scenario snapshot_Location_create on=Location.create\n   do\n    let location=event.after\n    create LocationPolicy {parent=location,sequence=count(location.LocationPolicy)+1,active=location.active,timezone=location.timezone,weekly=location.WeeklyHours as hours select OpeningWeek {weekday=hours.weekday,opens=hours.opens,closes=hours.closes,close_after=hours.close_after,fold=hours.fold},closed=location.ClosedDate as day select day.day,dated=location.DateHours as hours select OpeningDate {day=hours.day,opens=hours.opens,closes=hours.closes,close_after=hours.close_after,closed=hours.closed,fold=hours.fold}} as snapshot\n  scenario snapshot_Location_update on=Location.update\n   do\n    let location=event.after\n    create LocationPolicy {parent=location,sequence=count(location.LocationPolicy)+1,active=location.active,timezone=location.timezone,weekly=location.WeeklyHours as hours select OpeningWeek {weekday=hours.weekday,opens=hours.opens,closes=hours.closes,close_after=hours.close_after,fold=hours.fold},closed=location.ClosedDate as day select day.day,dated=location.DateHours as hours select OpeningDate {day=hours.day,opens=hours.opens,closes=hours.closes,close_after=hours.close_after,closed=hours.closed,fold=hours.fold}} as snapshot\n  scenario snapshot_WeeklyHours_create on=WeeklyHours.create\n   do\n    let location=event.after.parent\n    create LocationPolicy {parent=location,sequence=count(location.LocationPolicy)+1,active=location.active,timezone=location.timezone,weekly=location.WeeklyHours as hours select OpeningWeek {weekday=hours.weekday,opens=hours.opens,closes=hours.closes,close_after=hours.close_after,fold=hours.fold},closed=location.ClosedDate as day select day.day,dated=location.DateHours as hours select OpeningDate {day=hours.day,opens=hours.opens,closes=hours.closes,close_after=hours.close_after,closed=hours.closed,fold=hours.fold}} as snapshot\n  scenario snapshot_WeeklyHours_update on=WeeklyHours.update\n   do\n    let location=event.after.parent\n    create LocationPolicy {parent=location,sequence=count(location.LocationPolicy)+1,active=location.active,timezone=location.timezone,weekly=location.WeeklyHours as hours select OpeningWeek {weekday=hours.weekday,opens=hours.opens,closes=hours.closes,close_after=hours.close_after,fold=hours.fold},closed=location.ClosedDate as day select day.day,dated=location.DateHours as hours select OpeningDate {day=hours.day,opens=hours.opens,closes=hours.closes,close_after=hours.close_after,closed=hours.closed,fold=hours.fold}} as snapshot\n  scenario snapshot_ClosedDate_create on=ClosedDate.create\n   do\n    let location=event.after.parent\n    create LocationPolicy {parent=location,sequence=count(location.LocationPolicy)+1,active=location.active,timezone=location.timezone,weekly=location.WeeklyHours as hours select OpeningWeek {weekday=hours.weekday,opens=hours.opens,closes=hours.closes,close_after=hours.close_after,fold=hours.fold},closed=location.ClosedDate as day select day.day,dated=location.DateHours as hours select OpeningDate {day=hours.day,opens=hours.opens,closes=hours.closes,close_after=hours.close_after,closed=hours.closed,fold=hours.fold}} as snapshot\n  scenario snapshot_ClosedDate_update on=ClosedDate.update\n   do\n    let location=event.after.parent\n    create LocationPolicy {parent=location,sequence=count(location.LocationPolicy)+1,active=location.active,timezone=location.timezone,weekly=location.WeeklyHours as hours select OpeningWeek {weekday=hours.weekday,opens=hours.opens,closes=hours.closes,close_after=hours.close_after,fold=hours.fold},closed=location.ClosedDate as day select day.day,dated=location.DateHours as hours select OpeningDate {day=hours.day,opens=hours.opens,closes=hours.closes,close_after=hours.close_after,closed=hours.closed,fold=hours.fold}} as snapshot\n  scenario snapshot_DateHours_create on=DateHours.create\n   do\n    let location=event.after.parent\n    create LocationPolicy {parent=location,sequence=count(location.LocationPolicy)+1,active=location.active,timezone=location.timezone,weekly=location.WeeklyHours as hours select OpeningWeek {weekday=hours.weekday,opens=hours.opens,closes=hours.closes,close_after=hours.close_after,fold=hours.fold},closed=location.ClosedDate as day select day.day,dated=location.DateHours as hours select OpeningDate {day=hours.day,opens=hours.opens,closes=hours.closes,close_after=hours.close_after,closed=hours.closed,fold=hours.fold}} as snapshot\n  scenario snapshot_DateHours_update on=DateHours.update\n   do\n    let location=event.after.parent\n    create LocationPolicy {parent=location,sequence=count(location.LocationPolicy)+1,active=location.active,timezone=location.timezone,weekly=location.WeeklyHours as hours select OpeningWeek {weekday=hours.weekday,opens=hours.opens,closes=hours.closes,close_after=hours.close_after,fold=hours.fold},closed=location.ClosedDate as day select day.day,dated=location.DateHours as hours select OpeningDate {day=hours.day,opens=hours.opens,closes=hours.closes,close_after=hours.close_after,closed=hours.closed,fold=hours.fold}} as snapshot\n Then\n"}}
