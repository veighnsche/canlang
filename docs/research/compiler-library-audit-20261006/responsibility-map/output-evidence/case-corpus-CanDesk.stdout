{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"926de34932dd94d97b623f1a02b2a44c89b13f1f688da2fc4eed960ba1b01dfa","before_projection_sha256":"926de34932dd94d97b623f1a02b2a44c89b13f1f688da2fc4eed960ba1b01dfa","changed":false,"idempotent":true,"structure_equal":true,"text":"# Help reception and support teams handle booking changes, billing questions, Wi-Fi problems, and member service requests across workspace locations. @{nl=\"Help receptie- en supportteams boekingswijzigingen, factuurvragen, wifi-problemen en ledenserviceverzoeken op werkpleklocaties behandelen.\"}\napp CanDesk uses=[desk]\n\n# Keep customer-visible support messages separate from private staff notes and unrelated business actions. @{nl=\"Houd klantzichtbare supportberichten gescheiden van privénotities en andere bedrijfsacties.\"}\npackage desk\n use customer {Customer,owns,has_role}\n use rent_catalog {Location,test_site}\n use employee {can_work,staff,test_worker}\n use rent_reservations {Booking}\n use member_terms {Membership}\n use invoice {Invoice}\n use maintain {Asset,Repair,report as report_fault}\n use std {DeliveryResult}\n use std {EmailV1 as Mail} from=deployment.mail\n use desk {InboxV1 as Inbox} from=deployment.support_inbox\n Given\n  export contract IncomingMail { id:text min=1 max=1000, sender:email label=label_IncomingMail_sender, recipient:email label=label_IncomingMail_recipient, thread:text? max=300 label=label_IncomingMail_thread, subject:text max=300, body:text max=30000, attachments:file[] label=label_IncomingMail_attachments } label=\"Incoming support mail\"@{nl=\"Inkomende supportmail\"}\n  export capability InboxV1 version=1\n   event received { value:IncomingMail }\n  role support label=\"Support staff\"@{nl=\"Supportmedewerker\"}\n  export Ticket { location:Location, customer:Customer? label=\"Customer\"@{nl=\"Klant\"}, subject:IncomingMail.subject trim min=1, email:email, thread:text unique label=label_IncomingMail_thread, category:text label=label_Ticket_category, priority:enum(low,normal,urgent)=normal label={text=\"Priority\"@{nl=\"Prioriteit\"},values={low=\"Low\"@{nl=\"Laag\"},normal=\"Normal\"@{nl=\"Normaal\"},urgent=\"Urgent\"@{nl=\"Urgent\"}}}, assignee:user? label=\"Assignee\"@{nl=\"Toegewezen aan\"}, queue:text label=label_Ticket_queue, state:enum(open,waiting_on_customer,resolved)=open label={text=label_Ticket_state,values={open=\"Open\"@{nl=\"Open\"},waiting_on_customer=\"Waiting on customer\"@{nl=\"Wacht op klant\"},resolved=\"Resolved\"@{nl=\"Opgelost\"}}}, due:datetime? label=\"Response deadline\"@{nl=\"Antwoorddeadline\"}, escalation:text? label=\"Escalation\"@{nl=\"Escalatie\"}, escalated_by:user? label=\"Escalated by\"@{nl=\"Geëscaleerd door\"}, escalated_at:datetime? label=\"Escalated at\"@{nl=\"Geëscaleerd op\"}, booking:Booking? label=\"Booking\"@{nl=\"Boeking\"}, membership:Membership? label=\"Membership\"@{nl=\"Lidmaatschap\"}, invoice:Invoice? label=\"Invoice\"@{nl=\"Factuur\"}, repair:Repair? label=\"Repair\"@{nl=\"Reparatie\"} } label=\"Support request\"@{nl=\"Supportverzoek\"}\n  derive Ticket.overdue:bool = row.state!=resolved and row.due!=null and row.due<now label=\"Overdue\"@{nl=\"Te laat\"}\n  derive Ticket.unassigned:bool = row.assignee==null label=\"Unassigned\"@{nl=\"Niet toegewezen\"}\n  Message in Ticket { external_id:IncomingMail.id unique label=label_Message_external_id, kind:enum(customer,reply,note) label={text=\"Kind\"@{nl=\"Soort\"},values={customer=\"Customer message\"@{nl=\"Klantbericht\"},reply=\"Customer reply\"@{nl=\"Antwoord aan klant\"},note=\"Private staff note\"@{nl=\"Privénotitie\"}}}, body:text max=30000, sender:email label=label_IncomingMail_sender, recipient:email? label=label_IncomingMail_recipient, author:user? label=\"Author\"@{nl=\"Auteur\"}, attachments:file[] label=label_IncomingMail_attachments, delivery:delivery(Mail.send)? label=\"Delivery reference\"@{nl=\"Afleverreferentie\"} } label=\"Support message\"@{nl=\"Supportbericht\"}\n  derive Message.state:DeliveryResult.status? = row.delivery?.status label={text=label_Ticket_state,values={pending=\"Queued\"@{nl=\"In wachtrij\"},succeeded=\"Sent\"@{nl=\"Verzonden\"},failed=\"Failed\"@{nl=\"Mislukt\"},unknown=\"Unknown\"@{nl=\"Onbekend\"},skipped=\"Skipped\"@{nl=\"Overgeslagen\"}}}\n  Unmatched { external_id:IncomingMail.id unique label=label_Message_external_id, sender:email label=label_IncomingMail_sender, recipient:email label=label_IncomingMail_recipient, subject:IncomingMail.subject, body:IncomingMail.body, thread:IncomingMail.thread label=label_IncomingMail_thread, attachments:file[] label=label_IncomingMail_attachments, state:enum(pending,resolved)=pending label={text=label_Ticket_state,values={pending=\"Needs triage\"@{nl=\"Beoordeling nodig\"},resolved=\"Triaged\"@{nl=\"Beoordeeld\"}}}, ticket:Ticket? label=\"Support request\"@{nl=\"Supportverzoek\"}, resolved_by:user? label=\"Triaged by\"@{nl=\"Beoordeeld door\"}, resolved_at:datetime? label=\"Triaged at\"@{nl=\"Beoordeeld op\"}, received:datetime server=now label=\"Received at\"@{nl=\"Ontvangen op\"} } label=\"Unmatched support mail\"@{nl=\"Ongekoppelde supportmail\"}\n  policy Ticket read=support and can_work(actor,row.location)\n  policy Ticket read=authenticated where=actor.email_verified and row.email==actor.email fields=subject,category,priority,state,email\n  policy Message read=support and can_work(actor,row.parent.location)\n  policy Message read=authenticated where=actor.email_verified and row.parent.email==actor.email and row.kind!=note fields=kind,body,sender,recipient,attachments,state,delivery.status,created\n  policy Unmatched read=support\n  invariant Unmatched: row.state!=resolved or (row.ticket!=null and row.resolved_by!=null and row.resolved_at!=null)\n  lock Unmatched fields=external_id,sender,recipient,subject,body,thread,attachments\n  lock Unmatched fields=state,ticket,resolved_by,resolved_at when=row.state==resolved\n  lock Ticket fields=email,thread\n  lock Ticket fields=repair when=row.repair!=null\n  lock Message fields=external_id,kind,body,sender,recipient,author,attachments\n  fixture conversation=Ticket {location=test_site,subject=\"Wi-Fi\",email=\"customer@example.test\",thread=\"thread\",category=\"Connectivity\",queue=\"Reception\"}\n  fixture document=file {}\n  fixture foreign_document=file {owner=other}\n  fixture received_message=Message {parent=conversation,external_id=\"known-email\",kind=customer,body=\"Still offline\",sender=\"customer@example.test\",recipient=\"support@example.test\",attachments=[document]}\n  fixture unmatched=Unmatched {external_id=\"new-email\",sender=\"new@example.test\",recipient=\"support@example.test\",subject=\"Wi-Fi\",body=\"Cannot connect\",thread=\"unknown\",attachments=[document]}\n  fixture attempt=Mail.send {request={to=\"customer@example.test\",subject=\"Wi-Fi\",body=\"We are checking\",attachments=[document]}}\n  fixture outbound=Message {parent=conversation,external_id=\"staff-reply\",kind=reply,body=\"We are checking\",sender=\"staff@example.test\",recipient=\"customer@example.test\",author=self,attachments=[document],delivery=attempt}\n  fixture desk_asset=Asset {location=test_site,identifier=\"WIFI-1\",name=\"Router\",category=\"Connectivity\"}\n  preferences { state:Ticket.state?, priority:Ticket.priority? }\n  message label_IncomingMail_sender = \"Sender\"@{nl=\"Afzender\"}\n  message label_IncomingMail_recipient = \"Recipient\"@{nl=\"Ontvanger\"}\n  message label_IncomingMail_thread = \"Conversation token\"@{nl=\"Gesprekstoken\"}\n  message label_IncomingMail_attachments = \"Attachments\"@{nl=\"Bijlagen\"}\n  message label_Ticket_category = \"Category\"@{nl=\"Categorie\"}\n  message label_Ticket_queue = \"Queue\"@{nl=\"Wachtrij\"}\n  message label_Ticket_state = \"State\"@{nl=\"Status\"}\n  message label_Message_external_id = \"External identity\"@{nl=\"Externe identiteit\"}\n When\n  crud Ticket by=support fields=subject,category,priority,assignee,queue,state,due,customer,booking,membership,invoice create_fields=location,customer,subject,email,thread,category,priority,assignee,queue,due,booking,membership,invoice when=can_work(actor,row.location) and (row.assignee==null or (staff(row.assignee) and can_work(row.assignee,row.location))) delete=none\n   examples update seed=[test_worker] record=conversation\n    as,changes.due,record.state -> record.overdue\n    support,now-1h,open -> true\n    support,now-1h,waiting_on_customer -> true\n    support,now-1h,resolved -> false\n    support,now,open -> false\n    members,now-1h,open -> error(forbidden)\n  # Open a private support conversation under the verified customer's own address; this performs no booking or billing action. @{nl=\"Open een privéondersteuningsgesprek onder het eigen geverifieerde klantadres; dit voert geen boekings- of facturatieactie uit.\"}\n  export scenario open_request(location:Location,subject:Ticket.subject,body:Message.body,category:text,priority:Ticket.priority=normal,attachments:file[]=[],client:Customer?=null label=\"Customer\"@{nl=\"Klant\"}) -> Ticket by=authenticated label=\"Open support request\"@{nl=\"Supportverzoek openen\"}\n   require actor.email_verified and location.active and trim(body)!=\"\" and trim(category)!=\"\"\n   require client==null or (client.active and location in client.locations and (owns(actor,client) or has_role(actor,client,administrator) or has_role(actor,client,booker)))\n   require count(Ticket archived=include as ticket where ticket.email==actor.email and ticket.created>now-1d)<20\n   do\n    create Ticket {location,customer=client,subject,email=actor.email,thread=operation.id,category,priority,queue=\"Reception\"} as ticket\n    create Message {parent=ticket,external_id=format(\"web-{id}\",{id=operation.id}),kind=customer,body,sender=actor.email,recipient=null,author=actor,attachments} as message\n    return ticket\n   examples seed=[test_worker] location=test_site subject=\"Wi-Fi\" category=\"Connectivity\" attachments=[]\n    as,body -> result.email,count(result.Message),result.queue\n    members,\"Cannot connect\" -> actor.email,1,\"Reception\"\n    members,\"\" -> error(rule_failed)\n    public,\"Cannot connect\" -> error(forbidden)\n  # Append only to your verified private conversation and reopen it without altering staff routing or notes. @{nl=\"Voeg uitsluitend toe aan je geverifieerde privégesprek en heropen het zonder personeelsroutering of notities te wijzigen.\"}\n  scenario respond(ticket:Ticket,body:Message.body,attachments:file[]=[]) by=authenticated label=\"Reply to support\"@{nl=\"Support beantwoorden\"}\n   require actor.email_verified and ticket.email==actor.email and trim(body)!=\"\"\n   require count(ticket.Message as message where message.author==actor and message.created>now-1h)<20\n   do\n    create Message {parent=ticket,external_id=format(\"web-{id}\",{id=operation.id}),kind=customer,body,sender=actor.email,recipient=null,author=actor,attachments} as message\n    set ticket {state=open}\n   examples ticket=conversation body=\"Still offline\"\n    as,ticket.state,ticket.email -> ticket.state,count(ticket.Message)\n    members,resolved,actor.email -> open,1\n    members,open,\"another@example.test\" -> error(rule_failed)\n    public,open,\"another@example.test\" -> error(forbidden)\n  # Append a staff reply to the frozen conversation destination before queueing delivery. @{nl=\"Voeg een personeelsantwoord toe aan de vastgelegde gespreksbestemming voordat levering in de wachtrij komt.\"}\n  scenario reply(ticket:Ticket,body:text,attachments:Message.attachments=[]) by=support label=\"Reply to customer\"@{nl=\"Klant beantwoorden\"}\n   require can_work(actor,ticket.location) and trim(body)!=\"\"\n   do\n    let recipient=ticket.email\n    create Message {parent=ticket,external_id=operation.id,kind=reply,body,sender=actor.email,recipient,author=actor,attachments} as message\n    send Mail.send {to=recipient,subject=ticket.subject,body=message.body,attachments=message.attachments} as delivery\n    set message {delivery}\n    set ticket {state=waiting_on_customer}\n   examples seed=[test_worker] ticket=conversation body=\"A technician is checking\"\n    as,attachments -> ticket.state,count(ticket.Message),first(ticket.Message as message order=message.id)?.attachments??[],first(ticket.Message as message order=message.id)?.state\n    support,[document] -> waiting_on_customer,1,[document],pending\n    support,[foreign_document] -> error(forbidden)\n    members,[] -> error(forbidden)\n   examples seed=[test_worker,outbound,attempt] ticket=conversation body=\"A technician is checking\"\n    as,outbound.delivery,attempt.status,attempt.result,attempt.error -> ticket.state,outbound.state,count(ticket.Message)\n    support,attempt,pending,null,null -> waiting_on_customer,pending,2\n    support,attempt,succeeded,{reference=\"accepted-mail\"},null -> waiting_on_customer,succeeded,2\n    support,attempt,failed,null,{code=\"rejected\",message=\"Recipient rejected\"} -> waiting_on_customer,failed,2\n    support,attempt,unknown,null,null -> waiting_on_customer,unknown,2\n    support,attempt,skipped,null,null -> waiting_on_customer,skipped,2\n    support,null,pending,null,null -> waiting_on_customer,null,2\n  # Record a staff-only note that is never emailed to the customer. @{nl=\"Leg een personeelsnotitie vast die nooit naar de klant wordt gemaild.\"}\n  scenario note(ticket:Ticket,body:text,attachments:Message.attachments=[]) by=support label=\"Add private staff note\"@{nl=\"Privénotitie toevoegen\"}\n   require can_work(actor,ticket.location) and trim(body)!=\"\"\n   do create Message {parent=ticket,external_id=operation.id,kind=note,body,sender=actor.email,recipient=actor.email,author=actor,attachments} as note\n   examples seed=[test_worker] ticket=conversation attachments=[]\n    as,body -> count(conversation.Message),conversation.state\n    support,\"Restarted the router\" -> 1,open\n    support,\"\" -> error(rule_failed)\n    members,\"Restarted the router\" -> error(forbidden)\n  # Accept each external mail identity once; transport replay succeeds without another message or ticket transition. @{nl=\"Accepteer elke externe mailidentiteit één keer; transportherhaling slaagt zonder nieuw bericht of nieuwe statusovergang.\"}\n  scenario incoming on=Inbox.received\n   do\n    if not any(Message archived=include as message,message.external_id==event.value.id) and not any(Unmatched archived=include as message,message.external_id==event.value.id)\n     let ticket=first(Ticket as ticket where event.value.thread!=null and ticket.thread==event.value.thread and ticket.email==event.value.sender order=ticket.id)\n     if ticket!=null\n      create Message {parent=ticket,external_id=event.value.id,kind=customer,body=event.value.body,sender=event.value.sender,recipient=event.value.recipient,attachments=event.value.attachments} as message\n      set ticket {state=open}\n     else\n      create Unmatched {external_id=event.value.id,sender=event.value.sender,recipient=event.value.recipient,subject=event.value.subject,body=event.value.body,thread=event.value.thread,attachments=event.value.attachments} as unmatched\n   examples seed=[conversation] event={value={id=\"fresh-email\",sender=\"customer@example.test\",recipient=\"support@example.test\",thread=\"thread\",subject=\"Wi-Fi\",body=\"Still offline\",attachments=[document]}}\n    event.value.sender,conversation.state -> count(conversation.Message),count(Unmatched),conversation.state\n    \"customer@example.test\",resolved -> 1,0,open\n    \"stranger@example.test\",resolved -> 0,1,resolved\n   examples seed=[received_message] event={value={id=\"known-email\",sender=\"customer@example.test\",recipient=\"support@example.test\",thread=\"thread\",subject=\"Wi-Fi\",body=\"Still offline\",attachments=[document]}}\n    conversation.state -> count(conversation.Message),conversation.state\n    resolved -> 1,resolved\n   examples seed=[unmatched] event={value={id=\"new-email\",sender=\"new@example.test\",recipient=\"support@example.test\",thread=\"unknown\",subject=\"Wi-Fi\",body=\"Cannot connect\",attachments=[document]}}\n    event.value.id -> count(Unmatched)\n    \"new-email\" -> 1\n  # Resolve unknown mail once into a new scoped ticket, retaining its addresses, files and triage audit; never trust a supplied ticket ID. @{nl=\"Koppel onbekende mail één keer aan een nieuw locatiegebonden verzoek met behoud van adressen, bestanden en beoordelingshistorie; vertrouw nooit een aangeleverd verzoek-ID.\"}\n  scenario triage(incoming:Unmatched label=\"Unmatched incoming mail\"@{nl=\"Ongekoppelde inkomende mail\"},location:Location,category:text label=label_Ticket_category,queue:text label=label_Ticket_queue,subject:Ticket.subject=incoming.subject) -> Ticket by=support label=\"Triage unmatched mail\"@{nl=\"Ongekoppelde mail beoordelen\"}\n   require can_work(actor,location) and incoming.state==pending and trim(category)!=\"\" and trim(queue)!=\"\" and not any(Message archived=include as message,message.external_id==incoming.external_id)\n   do\n    create Ticket {location,subject,email=incoming.sender,thread=operation.id,category,queue} as ticket\n    create Message {parent=ticket,external_id=incoming.external_id,kind=customer,body=incoming.body,sender=incoming.sender,recipient=incoming.recipient,attachments=incoming.attachments} as message\n    set incoming {state=resolved,ticket,resolved_by=actor,resolved_at=now}\n    return ticket\n   examples seed=[test_worker] incoming=unmatched location=test_site category=\"Connectivity\" queue=\"Reception\"\n    as,category -> incoming.state,incoming.ticket==result,first(result.Message as message order=message.id)?.attachments??[]\n    support,\"Connectivity\" -> resolved,true,[document]\n    support,\"\" -> error(rule_failed)\n    members,\"Connectivity\" -> error(forbidden)\n   examples seed=[test_worker,received_message] incoming=unmatched location=test_site category=\"Connectivity\" queue=\"Reception\"\n    as,incoming.external_id -> incoming.state\n    support,\"known-email\" -> error(rule_failed)\n   examples seed=[test_worker] incoming=unmatched location=test_site category=\"Connectivity\" queue=\"Reception\"\n    as,incoming.state,incoming.ticket,incoming.resolved_by,incoming.resolved_at -> incoming.state\n    support,resolved,conversation,self,now -> error(rule_failed)\n  # Escalate an unresolved request with a responsible queue and attributable reason while preserving its deadline. @{nl=\"Escaleer een onopgelost verzoek met een verantwoordelijke wachtrij en herleidbare reden met behoud van de deadline.\"}\n  scenario escalate(ticket:Ticket,queue:text label=label_Ticket_queue,reason:text,assignee:user?=null label=\"Assignee\"@{nl=\"Toegewezen aan\"}) by=support label=\"Escalate request\"@{nl=\"Verzoek escaleren\"}\n   require can_work(actor,ticket.location) and ticket.state!=resolved and trim(queue)!=\"\" and trim(reason)!=\"\"\n   require assignee==null or (staff(assignee) and can_work(assignee,ticket.location))\n   do set ticket {queue,assignee,priority=urgent,escalation=reason,escalated_by=actor,escalated_at=now}\n   examples seed=[test_worker] ticket=conversation queue=\"Facilities\" reason=\"Service interrupted\"\n    as,ticket.state -> ticket.queue,ticket.priority,ticket.escalation,ticket.escalated_by\n    support,open -> \"Facilities\",urgent,\"Service interrupted\",self\n    support,resolved -> error(rule_failed)\n    members,open -> error(forbidden)\n  # Open a canonical own-reporter fault for this ticket's location and retain its repair; private notes are never forwarded automatically. @{nl=\"Open een canonieke storing met de huidige melder voor de locatie van dit verzoek en bewaar de reparatie; privénotities worden nooit automatisch doorgestuurd.\"}\n  scenario handoff(ticket:Ticket,asset:Asset,description:text,photo:file?=null) -> Repair by=support label=\"Hand off to maintenance\"@{nl=\"Overdragen aan onderhoud\"}\n   require can_work(actor,ticket.location) and ticket.state!=resolved and ticket.repair==null and asset.location==ticket.location\n   do\n    call report_fault {asset,title=ticket.subject,description,photo} as repair\n    set ticket {repair}\n    return repair\n   examples seed=[test_worker] ticket=conversation asset=desk_asset photo=null\n    as,description -> ticket.repair==result,result.title,result.reporter,ticket.state\n    support,\"Router is not responding\" -> true,\"Wi-Fi\",self,open\n    support,\"\" -> error(rule_failed)\n    members,\"Router is not responding\" -> error(forbidden)\n Then\n  # Triage location queues and distinguish internal notes from customer replies. @{nl=\"Beoordeel locatiewachtrijen en onderscheid interne notities van klantantwoorden.\"}\n  page /support title=\"Support\"@{nl=\"Support\"}\n   breadcrumbs\n   require support\n   card \"Ticket intake\"@{nl=\"Supportverzoek aanmaken\"}\n    ## due is a nullable datetime: no date-only calendar control applies.\n    form Ticket.create\n     input subject\n     input email\n     input category\n     radio priority\n     input queue\n   collapse \"Unmatched mail triage\"@{nl=\"Ongekoppelde mail beoordelen\"}\n    table Unmatched as mail where mail.state==pending columns=sender,subject,received order=-received\n     pagination\n     text row.recipient,row.body,row.attachments,row.thread\n     form triage\n      input category\n      input queue\n      input subject\n   list Ticket columns=subject,customer,queue,priority,state,assignee,due,overdue filter=location,state,priority,assignee,unassigned,overdue,category,queue defaults={state=preferences.state,priority=preferences.priority} search=subject display=split\n    pagination\n    ## Uncaptioned dividers structure the dense card (divider may omit its\n    ## caption); the escalation alert renders only when recorded (gated suite).\n    card \"Request and responsible queue\"@{nl=\"Verzoek en verantwoordelijke wachtrij\"}\n     badge row.state\n     badge row.priority\n     status row.overdue\n     status row.unassigned\n     text row.location,row.customer,row.email,row.category,row.queue,row.assignee,row.due\n     divider\n     alert\n      require row.escalation!=null\n      text row.escalation,row.escalated_by,row.escalated_at\n     divider\n     text row.booking,row.membership,row.invoice,row.repair\n     edit\n      input subject\n      input category\n      radio priority\n      radio state\n      input queue\n     form escalate\n      input queue\n      textarea reason\n     form handoff\n      textarea description\n      file_input photo\n    tabs\n     tab \"Customer conversation\"@{nl=\"Klantgesprek\"}\n      form reply\n       textarea body\n      ## chat_bubble slots preserve the enclosing row chain; every column of the\n      ## former message table stays visible (kind badge, sender/recipient/time,\n      ## paragraph body, attachment links, delivery badge, author).\n      list row.Message as message where message.kind!=note order=created\n       pagination\n       chat_bubble\n        slot header\n         badge row.kind\n         text row.sender,row.recipient,row.created\n        slot content\n         content row.body\n         text row.attachments\n        slot footer\n         badge row.state\n         text row.author\n     tab \"Private staff notes\"@{nl=\"Privénotities\"}\n      form note\n       textarea body\n      list row.Message as message where message.kind==note order=created\n       pagination\n       chat_bubble\n        slot header\n         badge row.kind\n         text row.sender,row.recipient,row.created\n        slot content\n         content row.body\n         text row.attachments\n        slot footer\n         badge row.state\n         text row.author\n    history\n  # Read only your authenticated customer conversation. @{nl=\"Lees uitsluitend je geauthenticeerde klantgesprek.\"}\n  page /support/mine title=\"My support requests\"@{nl=\"Mijn supportverzoeken\"}\n   breadcrumbs\n   require authenticated and actor.email_verified\n   card \"Private support intake\"@{nl=\"Privésupportverzoek\"}\n    form open_request\n     input subject\n     textarea body\n     input category\n     radio priority\n   list Ticket as ticket where ticket.email==actor.email filter=state,priority defaults={state=preferences.state,priority=preferences.priority} display=split\n    pagination\n    badge row.state\n    badge row.priority\n    text row.subject,row.category\n    form respond\n     textarea body\n    ## No kind predicate here: the customer Message policy already excludes notes.\n    list row.Message order=created\n     pagination\n     chat_bubble\n      slot header\n       badge row.kind\n       text row.sender,row.recipient,row.created\n      slot content\n       content row.body\n       text row.attachments\n      slot footer\n       badge row.state\n"}}
