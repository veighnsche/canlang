{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"60ba205dc323b8c0b6e52bd7f6fa35b8cbc420e91425eec18ac9ead1b96d750c","before_projection_sha256":"60ba205dc323b8c0b6e52bd7f6fa35b8cbc420e91425eec18ac9ead1b96d750c","changed":false,"idempotent":true,"structure_equal":true,"text":"# Help workspace managers review fit-out plans, signage, supplier documents, and operating procedures before they are used at a location. @{nl=\"Help werkplekbeheerders verbouwingsplannen, bewegwijzering, leveranciersdocumenten en werkprocedures beoordelen voordat ze op een locatie worden gebruikt.\"}\napp CanApprove uses=[approve]\n\n# Review immutable submitted document versions with current reviewer and no self-approval. @{nl=\"Beoordeel onveranderlijke ingediende documentversies met de huidige beoordelaar en zonder zelfgoedkeuring.\"}\npackage approve label=\"Document review\"@{nl=\"Documentbeoordeling\"}\n use rent_catalog {Location,test_site}\n use employee {Employee,can_work,test_worker,hr,deactivate}\n use std {EmailV1 as Mail,DeliveryResult} from=deployment.mail\n Given\n  role coordinator label=\"Coordinator\"@{nl=\"Coördinator\"}\n  role reviewer label=label_reviewer\n  export Document { location:Location?, title:text, category:text label=\"Category\"@{nl=\"Categorie\"}, subject:text?, submitter:user server=actor label=\"Submitter\"@{nl=\"Indiener\"}, email:email, current:int=0 label=\"Current revision\"@{nl=\"Huidige revisie\"} } label=\"Document\"@{nl=\"Document\"}\n  export Submission in Document { assignment:int=1 label=\"Assignment revision\"@{nl=\"Toewijzingsrevisie\"}, revision:int, file:file, note:text label=label_Submission_note, reviewer:user label=label_reviewer, reviewer_email:email label=label_Submission_reviewer_email, due:datetime, state:enum(pending,approved,rejected,withdrawn)=pending label={text=\"State\"@{nl=\"Status\"},values={pending=\"Pending\"@{nl=\"In behandeling\"},approved=\"Approved\"@{nl=\"Goedgekeurd\"},rejected=\"Rejected\"@{nl=\"Afgewezen\"},withdrawn=\"Withdrawn\"@{nl=\"Ingetrokken\"}}}, reason:text?, decided_by:user? label=\"Decision maker\"@{nl=\"Beslist door\"}, decided_at:datetime? label=\"Decision time\"@{nl=\"Beslist op\"} } label=\"Submitted version\"@{nl=\"Ingediende versie\"}\n  Notice in Submission { kind:enum(request,decision,reminder) label={text=\"Notice kind\"@{nl=\"Soort bericht\"},values={request=\"Review request\"@{nl=\"Beoordelingsverzoek\"},decision=\"Decision\"@{nl=\"Besluit\"},reminder=\"Reminder\"@{nl=\"Herinnering\"}}}, assignment:Submission.assignment, recipient:email label=\"Recipient\"@{nl=\"Ontvanger\"}, subject:text, body:text, delivery:delivery(Mail.send)? label=\"Delivery reference\"@{nl=\"Verzendingsreferentie\"} } label=\"Review notice\"@{nl=\"Beoordelingsbericht\"}\n  derive Notice.state:DeliveryResult.status? = row.delivery?.status label=\"Delivery state\"@{nl=\"Verzendstatus\"}\n  derive Submission.overdue:bool = row.state==pending and row.due<now label=\"Overdue\"@{nl=\"Te laat\"}\n  event Due { submission:Submission, assignment:int }\n  policy Notice read=(members and row.parent.parent.submitter==actor) or (coordinator and (row.parent.parent.location==null or can_work(actor,row.parent.parent.location))) or (reviewer and row.parent.reviewer==actor and row.parent.state!=withdrawn and (row.parent.parent.location==null or can_work(actor,row.parent.parent.location))) fields=parent,kind,assignment,recipient,subject,body,state,delivery.id,delivery.status,created_by,created,updated_by,updated,archived_at\n  lock Notice fields=kind,assignment,recipient,subject,body\n  lock Notice fields=delivery when=row.delivery!=null\n  policy Document read=members where=row.submitter==actor\n  policy Document read=coordinator where=row.location==null or can_work(actor,row.location)\n  policy Document read=reviewer where=(row.location==null or can_work(actor,row.location)) and any(row.Submission as submission,submission.reviewer==actor and submission.state!=withdrawn)\n  policy Submission read=members where=row.parent.submitter==actor\n  policy Submission read=coordinator where=row.parent.location==null or can_work(actor,row.parent.location)\n  policy Submission read=reviewer where=row.reviewer==actor and row.state!=withdrawn and (row.parent.location==null or can_work(actor,row.parent.location))\n  unique Submission fields=revision\n  lock Submission fields=revision,file,note,due\n  lock Submission fields=state,reason,decided_by,decided_at when=row.state in [approved,rejected,withdrawn]\n  lock Submission fields=reviewer,reviewer_email,assignment when=row.state!=pending\n  fixture reviewer_user=user {roles=[reviewer]}\n  fixture replacement_user=user {roles=[reviewer]}\n  fixture coordinator_user=user {roles=[coordinator]}\n  fixture ordinary_user=user {}\n  fixture hr_user=user {roles=[hr]}\n  fixture reviewer_worker=Employee {user=reviewer_user,name=\"Alex\",home=test_site,locations=[test_site],start=date(\"2026-10-01\"),role=\"Reviewer\"}\n  fixture replacement_worker=Employee {user=replacement_user,name=\"Alex\",home=test_site,locations=[test_site],start=date(\"2026-10-01\"),role=\"Replacement reviewer\"}\n  fixture coordinator_worker=Employee {user=coordinator_user,home=test_site,locations=[test_site],start=date(\"2026-10-01\"),role=\"Coordinator\"}\n  fixture ordinary_worker=Employee {user=ordinary_user,home=test_site,locations=[test_site],start=date(\"2026-10-01\"),role=\"Reviewer\"}\n  fixture document=Document {location=test_site,title=\"Plan\",category=\"Signage\",current=1,submitter=self,email=\"submitter@example.test\"}\n  fixture original=file {}\n  fixture replacement=file {}\n  fixture pending_version=Submission {parent=document,revision=1,file=original,note=\"Signage\",reviewer=reviewer_user,reviewer_email=\"reviewer@example.test\",due=now+1d}\n  fixture attempt=Mail.send {request={to=\"reviewer@example.test\",subject=\"Review\",body=\"Plan\"}}\n  ## This independent failed identity is deliberately unrelated to the selected review attempt.\n  fixture detached_delivery=Mail.send {request={to=\"reviewer@example.test\",subject=\"Review\",body=\"Plan\"},status=failed,error={code=\"provider\",message=\"Delivery rejected\"}}\n  fixture decision_attempt=Mail.send {request={to=\"submitter@example.test\",subject=\"Review\",body=\"Approved with conditions\"}}\n  fixture pending_notice=Notice {parent=pending_version,kind=request,assignment=1,recipient=\"reviewer@example.test\",subject=\"Review\",body=\"Plan\",delivery=attempt}\n  fixture accepted=Submission {parent=document,revision=1,file=original,note=\"Original\",reviewer=reviewer_user,reviewer_email=\"reviewer@example.test\",due=now+1d,state=approved,decided_by=reviewer_user,decided_at=now}\n  preferences { review_state:Submission.state? label=\"Initial review state filter\"@{nl=\"Eerste filter beoordelingsstatus\"}, versions_open:bool=false label=\"Expand submitted version history\"@{nl=\"Ingediende versiehistorie uitklappen\"} }\n  message label_reviewer = \"Reviewer\"@{nl=\"Beoordelaar\"}\n  message label_Submission_note = \"Note\"@{nl=\"Notitie\"}\n  message label_Submission_reviewer_email = \"Reviewer email\"@{nl=\"E-mail beoordelaar\"}\n When\n  # Read eligible reviewers through current work-field grants. @{nl=\"Lees geschikte beoordelaars via actuele werkveldtoegang.\"}\n  scenario reviewer_choices(document:Document) read=true -> Employee[] by=members label=\"Choose reviewer\"@{nl=\"Beoordelaar kiezen\"}\n   require (document.submitter==actor or coordinator) and (document.location==null or can_work(actor,document.location))\n   do return Employee as candidate where candidate.active and candidate.user!=actor and candidate.user!=document.submitter and reviewer(candidate.user) and (document.location==null or can_work(candidate.user,document.location))\n   examples seed=[test_worker,reviewer_worker,replacement_worker,ordinary_worker,coordinator_worker] document=document\n    as,document.submitter,document.location,reviewer_worker.active,reviewer_worker.name,test_worker.active -> count(result),count(result as candidate where candidate.name==\"Alex\"),any(result as candidate,candidate.user==ordinary_user)\n    self,self,test_site,true,\"Alex\",true -> 2,2,false\n    self,self,test_site,false,\"Alex\",true -> 1,1,false\n    self,self,null,false,\"Alex\",true -> 1,1,false\n    self,self,test_site,true,null,true -> 2,1,false\n    coordinator_user,self,test_site,true,\"Alex\",true -> 2,2,false\n    reviewer_user,reviewer_user,test_site,true,\"Alex\",true -> 1,1,false\n    reviewer_user,self,test_site,true,\"Alex\",true -> error(rule_failed)\n    self,self,test_site,true,\"Alex\",false -> error(rule_failed)\n    self,self,null,true,\"Alex\",false -> 0,0,false\n    outsider,self,test_site,true,\"Alex\",true -> error(forbidden)\n    public,self,test_site,true,\"Alex\",true -> error(forbidden)\n   ## Receipt snapshots are canonical bound recipes. An unrelated failed receipt cannot alter this Notice's selected pending receipt.\n   examples seed=[pending_notice,test_worker,detached_delivery] document=document\n    pending_notice.delivery,attempt.status,attempt.result,attempt.error -> pending_notice.state,pending_version.state\n    attempt,succeeded,{reference=\"accepted-mail\"},null -> succeeded,pending\n    attempt,unknown,null,null -> unknown,pending\n    attempt,skipped,null,null -> skipped,pending\n    attempt,failed,null,{code=\"provider\",message=\"Delivery rejected\"} -> failed,pending\n    attempt,pending,null,null -> pending,pending\n    null,pending,null,null -> null,pending\n   ## Delivery progress preserves the exact approved file, reason and actor/time. Null means no request is yet associated.\n   examples seed=[pending_notice,test_worker,decision_attempt] document=document\n    pending_notice.kind,pending_notice.recipient,pending_notice.body,pending_version.state,pending_version.reason,pending_version.decided_by,pending_version.decided_at,pending_notice.delivery,decision_attempt.status,decision_attempt.result,decision_attempt.error -> pending_notice.state,pending_version.state,pending_version.file,pending_version.reason,pending_version.decided_by,pending_version.decided_at\n    decision,\"submitter@example.test\",\"Approved with conditions\",approved,\"Approved with conditions\",reviewer_user,now,decision_attempt,failed,null,{code=\"provider\",message=\"Delivery rejected\"} -> failed,approved,original,\"Approved with conditions\",reviewer_user,now\n    decision,\"submitter@example.test\",\"Approved with conditions\",approved,\"Approved with conditions\",reviewer_user,now,null,pending,null,null -> null,approved,original,\"Approved with conditions\",reviewer_user,now\n  crud Document by=members fields=title,category,subject create_fields=location,title,category,subject,email when=row.submitter==actor and (row.location==null or can_work(actor,row.location)) delete=none\n   examples update seed=[test_worker] record=document\n    as,changes.title -> document.title\n    members,\"New title\" -> \"New title\"\n    outsider,\"New title\" -> error(not_found)\n  # Submit a fresh immutable file revision, withdrawing pending reviews and retaining earlier decisions. @{nl=\"Dien een nieuwe onveranderlijke bestandsrevisie in, trek wachtende beoordelingen in en behoud eerdere besluiten.\"}\n  scenario submit(document:Document,file:file,note:text label=label_Submission_note,assignee:user label=label_reviewer,reviewer_email:email label=label_Submission_reviewer_email,due:datetime) by=members\n   require document.submitter==actor and (document.location==null or can_work(actor,document.location)) and assignee!=actor and reviewer(assignee) and (document.location==null or can_work(assignee,document.location)) and due>now\n   do\n    let revision=document.current+1\n    for old in document.Submission as submission where submission.state==pending limit=100\n     set old {state=withdrawn}\n     cancel old.id\n    create Submission {parent=document,revision,file,note,reviewer=assignee,reviewer_email,due} as submission\n    set document {current=revision}\n    create Notice {parent=submission,kind=request,assignment=submission.assignment,recipient=reviewer_email,subject=format(\"Document review requested\"@{nl=\"Documentbeoordeling aangevraagd\"},locale=null),body=document.title} as notice\n    schedule submission.id at=due event=Due {submission,assignment=submission.assignment}\n   examples seed=[pending_version,reviewer_worker,ordinary_worker,test_worker] document=document file=replacement note=\"Updated\" assignee=reviewer_user reviewer_email=\"reviewer@example.test\" due=now+1d\n    as,document.location,document.current,assignee,reviewer_worker.active,test_worker.active,due,request.document.version -> document.current,pending_version.state,pending_version.file,count(document.Submission)\n    self,null,1,reviewer_user,true,true,now+1d,1 -> 2,withdrawn,original,2\n    public,null,1,reviewer_user,true,true,now+1d,1 -> error(forbidden)\n    self,null,1,ordinary_user,true,true,now+1d,1 -> error(rule_failed)\n    self,null,1,self,true,true,now+1d,1 -> error(rule_failed)\n    self,test_site,1,reviewer_user,false,true,now+1d,1 -> error(rule_failed)\n    self,null,1,reviewer_user,true,true,now-1m,1 -> error(rule_failed)\n    self,null,1,reviewer_user,true,true,now+1d,2 -> error(conflict)\n    self,test_site,1,reviewer_user,true,true,now+1d,1 -> 2,withdrawn,original,2\n    self,test_site,1,reviewer_user,true,false,now+1d,1 -> error(rule_failed)\n   examples seed=[accepted] document=document file=replacement note=\"Updated\" assignee=reviewer_user reviewer_email=\"reviewer@example.test\" due=now+1d\n    as,document.location,document.current -> accepted.state,accepted.file,count(document.Submission)\n    self,null,1 -> approved,original,2\n   ## Shared-state journeys use the proposed sequence grammar; the unchanged syntax parser does not accept do examples.\n   examples seed=[test_worker,reviewer_worker,coordinator_worker,replacement_worker,original,replacement]\n    do\n     call Document.create {location=test_site,title=\"Signage plan\",category=\"Signage\",subject=null,email=actor.email} by=self\n     let document_record=first(Document as row where row.submitter==self order=row.id)\n     document_record!=null -> true\n     call submit {document=document_record,file=original,note=\"Submitted plan\",assignee=reviewer_user,reviewer_email=\"reviewer@example.test\",due=now+1d} by=self\n     let first_pending=first(document_record.Submission as row where row.revision==1 order=row.id)\n     first_pending!=null -> true\n     call decide {submission=first_pending,approve=false,reason=\"Replace page two\"} by=reviewer_user\n     let first_rejected=first(document_record.Submission as row where row.revision==1 order=row.id)\n     first_rejected!=null -> true\n     call assign {submission=first_rejected,assignee=replacement_user,email=\"new-reviewer@example.test\"} by=coordinator_user -> error(rule_failed)\n     let replacement_document=first(Document as row where row.submitter==self order=row.id)\n     replacement_document!=null -> true\n     call submit {document=replacement_document,file=replacement,note=\"Corrected page two\",assignee=reviewer_user,reviewer_email=\"reviewer@example.test\",due=now+1d} by=self\n     let second_pending=first(document_record.Submission as row where row.revision==2 order=row.id)\n     second_pending!=null -> true\n     call decide {submission=second_pending,approve=true,reason=\"Approved with conditions\"} by=reviewer_user\n     let second_approved=first(document_record.Submission as row where row.revision==2 order=row.id)\n     second_approved!=null -> true\n     let retained_rejection=first(document_record.Submission as row where row.revision==1 order=row.id)\n     retained_rejection!=null -> true\n     retained_rejection.file,retained_rejection.state,retained_rejection.reason,retained_rejection.decided_by,second_approved.file,second_approved.state,second_approved.reason,second_approved.decided_by,any(retained_rejection.Notice as notice,notice.kind==decision and notice.body==\"Replace page two\" and notice.assignment==1),any(second_approved.Notice as notice,notice.kind==decision and notice.body==\"Approved with conditions\" and notice.assignment==1) -> original,rejected,\"Replace page two\",reviewer_user,replacement,approved,\"Approved with conditions\",reviewer_user,true,true\n   examples seed=[test_worker,reviewer_worker,coordinator_worker,replacement_worker,ordinary_user,original,replacement]\n    do\n     call Document.create {location=test_site,title=\"Signage plan\",category=\"Signage\",subject=null,email=actor.email} by=self\n     let document_record=first(Document as row where row.submitter==self order=row.id)\n     document_record!=null -> true\n     call submit {document=document_record,file=original,note=\"Submitted plan\",assignee=reviewer_user,reviewer_email=\"reviewer@example.test\",due=now+1d} by=self\n     let old_pending=first(document_record.Submission as row where row.revision==1 order=row.id)\n     old_pending!=null -> true\n     let current_document=first(Document as row where row.submitter==self order=row.id)\n     current_document!=null -> true\n     call submit {document=current_document,file=replacement,note=\"Invalid due attempt\",assignee=reviewer_user,reviewer_email=\"reviewer@example.test\",due=now} by=self -> error(rule_failed)\n     let preserved_pending=first(document_record.Submission as row where row.revision==1 order=row.id)\n     preserved_pending!=null -> true\n     preserved_pending.file,preserved_pending.state,count(document_record.Submission) -> original,pending,1\n     call submit {document=current_document,file=replacement,note=\"Submitted plan\",assignee=reviewer_user,reviewer_email=\"reviewer@example.test\",due=now+1d} by=self\n     call decide {submission=old_pending,approve=true,reason=\"Stale open review\"} by=reviewer_user -> error(conflict)\n     let new_pending=first(document_record.Submission as row where row.revision==2 order=row.id)\n     new_pending!=null -> true\n     count(document_record.Submission) -> 1\n     call assign {submission=new_pending,assignee=replacement_user,email=\"new-reviewer@example.test\"} by=ordinary_user -> error(forbidden)\n     count(Document),count(Submission) -> 0,0\n     call assign {submission=new_pending,assignee=replacement_user,email=\"new-reviewer@example.test\"} by=coordinator_user\n     let reassigned=first(document_record.Submission as row where row.revision==2 order=row.id)\n     reassigned!=null -> true\n     call decide {submission=new_pending,approve=true,reason=\"Stale assignment\"} by=reviewer_user -> error(conflict)\n     call decide {submission=reassigned,approve=true,reason=\"Former assignee\"} by=reviewer_user -> error(rule_failed)\n     call decide {submission=reassigned,approve=true,reason=\"Replacement reviewer checked\"} by=replacement_user\n     let approved_reassignment=first(document_record.Submission as row where row.revision==2 order=row.id)\n     approved_reassignment!=null -> true\n     approved_reassignment.file,approved_reassignment.reviewer,approved_reassignment.assignment,approved_reassignment.state,approved_reassignment.decided_by,any(approved_reassignment.Notice as notice,notice.kind==request and notice.assignment==1 and notice.recipient==\"reviewer@example.test\"),any(approved_reassignment.Notice as notice,notice.kind==request and notice.assignment==2 and notice.recipient==\"new-reviewer@example.test\" and notice.created_by==coordinator_user) -> replacement,replacement_user,2,approved,replacement_user,true,true\n   examples seed=[test_worker,reviewer_worker,replacement_worker,coordinator_worker,hr_user,original]\n    do\n     call Document.create {location=test_site,title=\"Signage plan\",category=\"Signage\",subject=null,email=actor.email} by=self\n     let document_record=first(Document as row where row.submitter==self order=row.id)\n     document_record!=null -> true\n     call submit {document=document_record,file=original,note=\"Submitted plan\",assignee=reviewer_user,reviewer_email=\"reviewer@example.test\",due=now+1d} by=self\n     let pending_review=first(document_record.Submission as row where row.revision==1 order=row.id)\n     pending_review!=null -> true\n     let review_version=pending_review.version\n     let review_document=first(Document as row where row.submitter==self order=row.id)\n     review_document!=null -> true\n     call reviewer_choices {document=review_document} by=self as before_reviewers\n     any(before_reviewers as candidate,candidate.user==reviewer_user) -> true\n     call deactivate {employee=reviewer_worker,ended=date(\"2026-10-02\")} by=hr_user\n     call reviewer_choices {document=review_document} by=self as after_reviewers\n     any(after_reviewers as candidate,candidate.user==reviewer_user),any(after_reviewers as candidate,candidate.user==replacement_user) -> false,true\n     reviewer_worker.active,reviewer(reviewer_user),can_work(reviewer_user,test_site) -> false,true,false\n     call decide {submission=pending_review,approve=true,reason=\"Unavailable reviewer\"} by=reviewer_user -> error(rule_failed)\n     call assign {submission=pending_review,assignee=replacement_user,email=\"new-reviewer@example.test\"} by=coordinator_user\n     let recovered_review=first(document_record.Submission as row where row.revision==1 order=row.id)\n     recovered_review!=null -> true\n     call assign {submission=recovered_review,assignee=replacement_user,email=\"new-reviewer@example.test\"} by=coordinator_user request={submission={version=review_version}} -> error(conflict)\n     call decide {submission=recovered_review,approve=true,reason=\"Recovery checked\"} by=replacement_user\n     let recovered_approval=first(document_record.Submission as row where row.revision==1 order=row.id)\n     recovered_approval!=null -> true\n     recovered_approval.revision,recovered_approval.file,recovered_approval.note,recovered_approval.due,recovered_approval.reviewer,recovered_approval.assignment,recovered_approval.state,recovered_approval.decided_by,count(recovered_approval.Notice) -> 1,original,\"Submitted plan\",now+1d,replacement_user,2,approved,replacement_user,3\n  # Reassign the current pending review, retaining assignment history. @{nl=\"Wijs de huidige wachtende beoordeling opnieuw toe en behoud de toewijzingshistorie.\"}\n  scenario assign(submission:Submission,assignee:user label=label_reviewer,email:email) by=coordinator\n   require (submission.parent.location==null or can_work(actor,submission.parent.location)) and submission.state==pending and submission.revision==submission.parent.current and assignee!=submission.parent.submitter and reviewer(assignee) and (submission.parent.location==null or can_work(assignee,submission.parent.location))\n   do\n    set submission {reviewer=assignee,reviewer_email=email,assignment=submission.assignment+1}\n    create Notice {parent=submission,kind=request,assignment=submission.assignment,recipient=email,subject=format(\"Document review requested\"@{nl=\"Documentbeoordeling aangevraagd\"},locale=null),body=submission.parent.title} as notice\n    schedule submission.id at=max([now,submission.due]) event=Due {submission,assignment=submission.assignment}\n   examples seed=[reviewer_worker,replacement_worker,coordinator_worker,ordinary_worker] submission=pending_version assignee=replacement_user email=\"new-reviewer@example.test\"\n    as,submission.parent.location,submission.parent.current,submission.state,assignee,replacement_worker.active,coordinator_worker.active,request.submission.version -> submission.assignment,submission.reviewer,submission.reviewer_email,count(submission.Notice),submission.file\n    coordinator_user,null,1,pending,replacement_user,true,true,1 -> 2,replacement_user,\"new-reviewer@example.test\",1,original\n    members,null,1,pending,replacement_user,true,true,1 -> error(forbidden)\n    coordinator_user,null,2,pending,replacement_user,true,true,1 -> error(rule_failed)\n    coordinator_user,null,1,pending,ordinary_user,true,true,1 -> error(rule_failed)\n    coordinator_user,null,1,pending,self,true,true,1 -> error(rule_failed)\n    coordinator_user,test_site,1,pending,replacement_user,false,true,1 -> error(rule_failed)\n    coordinator_user,test_site,1,pending,replacement_user,true,false,1 -> error(rule_failed)\n    coordinator_user,null,1,approved,replacement_user,true,true,1 -> error(rule_failed)\n    coordinator_user,null,1,pending,replacement_user,true,true,2 -> error(conflict)\n   examples seed=[replacement_worker,coordinator_worker] submission=pending_version assignee=replacement_user email=\"new-reviewer@example.test\"\n    as,submission.due -> submission.assignment,submission.due,submission.overdue\n    coordinator_user,now-1m -> 2,now-1m,true\n  # Decide exactly the current pending file version with rejection reason or approval conditions. @{nl=\"Beslis over precies de huidige ingediende bestandsversie met afwijzingsreden of goedkeuringsvoorwaarden.\"}\n  scenario decide(submission:Submission,approve:bool label=\"Approve\"@{nl=\"Goedkeuren\"},reason:text) by=reviewer label=\"Record decision\"@{nl=\"Besluit vastleggen\"}\n   require submission.reviewer==actor and submission.parent.submitter!=actor and submission.state==pending and submission.revision==submission.parent.current and (submission.parent.location==null or can_work(actor,submission.parent.location)) and (approve or trim(reason)!=\"\")\n   do\n    if approve\n     set submission {state=approved,reason,decided_by=actor,decided_at=now}\n    else\n     set submission {state=rejected,reason,decided_by=actor,decided_at=now}\n    cancel submission.id\n    create Notice {parent=submission,kind=decision,assignment=submission.assignment,recipient=submission.parent.email,subject=format(\"Document review decision\"@{nl=\"Besluit documentbeoordeling\"},locale=null),body=reason} as notice\n   examples seed=[reviewer_worker] submission=pending_version reason=\"Approved with conditions\"\n    as,submission.parent.location,submission.parent.current,submission.reviewer,submission.parent.submitter,approve,reviewer_worker.active,request.submission.version -> submission.state,submission.decided_by,submission.file,count(submission.Notice)\n    reviewer_user,null,1,reviewer_user,self,true,true,1 -> approved,reviewer_user,original,1\n    reviewer,null,1,self,other,true,true,1 -> approved,self,original,1\n    reviewer,null,2,self,other,true,true,1 -> error(rule_failed)\n    reviewer,null,1,self,self,true,true,1 -> error(rule_failed)\n    ordinary_user,null,1,reviewer_user,self,true,true,1 -> error(forbidden)\n    reviewer_user,test_site,1,reviewer_user,self,true,false,1 -> error(rule_failed)\n    reviewer_user,null,1,reviewer_user,self,true,true,2 -> error(conflict)\n   examples submission=pending_version approve=false\n    as,submission.parent.location,submission.parent.current,submission.reviewer,submission.parent.submitter,reason -> submission.state,submission.reason\n    reviewer,null,1,self,other,\"Replace page two\" -> rejected,\"Replace page two\"\n    reviewer,null,1,self,other,\"\" -> error(rule_failed)\n  # Withdraw your pending version without erasing prior decisions. @{nl=\"Trek je wachtende versie in zonder eerdere besluiten te wissen.\"}\n  scenario withdraw(submission:Submission) by=members label=\"Withdraw\"@{nl=\"Intrekken\"}\n   require submission.parent.submitter==actor and submission.state==pending\n   do\n    set submission {state=withdrawn}\n    cancel submission.id\n   examples submission=pending_version\n    as,submission.state -> submission.state,submission.file\n    self,pending -> withdrawn,original\n    ordinary_user,pending -> error(rule_failed)\n    self,approved -> error(rule_failed)\n  scenario remind on=Due\n   require event.submission.state==pending and event.submission.assignment==event.assignment and event.submission.revision==event.submission.parent.current and now>=event.submission.due and reviewer(event.submission.reviewer) and (event.submission.parent.location==null or can_work(event.submission.reviewer,event.submission.parent.location))\n   do create Notice {parent=event.submission,kind=reminder,assignment=event.assignment,recipient=event.submission.reviewer_email,subject=format(\"Document review due\"@{nl=\"Deadline documentbeoordeling\"},locale=null),body=event.submission.parent.title} as notice\n   examples seed=[reviewer_worker,ordinary_worker] event={submission=pending_version,assignment=1}\n    pending_version.parent.current,pending_version.due,pending_version.assignment,pending_version.state,pending_version.reviewer,pending_version.parent.location,reviewer_worker.active -> count(pending_version.Notice)\n    1,now-1m,1,pending,reviewer_user,null,true -> 1\n    1,now-1m,2,pending,reviewer_user,null,true -> error(rule_failed)\n    1,now-1m,1,withdrawn,reviewer_user,null,true -> error(rule_failed)\n    1,now+1m,1,pending,reviewer_user,null,true -> error(rule_failed)\n    1,now-1m,1,pending,ordinary_user,null,true -> error(rule_failed)\n    1,now-1m,1,pending,reviewer_user,test_site,false -> error(rule_failed)\n  ## Record effects publish Notice.created after commit; Notice has no public create operation.\n  scenario notify on=Notice.created\n   do\n    let notice=first(Notice as row where row.id==event.id order=row.id)\n    if notice!=null and notice.delivery==null\n     send Mail.send {to=notice.recipient,subject=notice.subject,body=notice.body} when=notice.kind==decision or (notice.parent.state==pending and notice.parent.revision==notice.parent.parent.current and notice.parent.assignment==notice.assignment and notice.parent.reviewer_email==notice.recipient and reviewer(notice.parent.reviewer) and (notice.parent.parent.location==null or can_work(notice.parent.reviewer,notice.parent.parent.location))) as attempt\n     set notice {delivery=attempt}\n\n Then\n  # Submit and follow your own exact document versions. @{nl=\"Dien je eigen exacte documentversies in en volg ze.\"}\n  page /documents title=\"My submissions\"@{nl=\"Mijn inzendingen\"}\n   require members\n   ## Breadcrumbs show current declared ancestry; the shared right-sidebar shell supplies navigation, no per-app menu.\n   breadcrumbs\n   card \"Document intake\"@{nl=\"Document aanmaken\"}\n    form Document.create\n     input title\n     input category\n     input subject\n     input email\n   list Document as document where document.submitter==actor columns=title,location,category,current filter=location,category search=title display=split\n    pagination\n    card \"Current document\"@{nl=\"Huidig document\"}\n     edit\n     form submit\n      file_input file\n      textarea note\n      input reviewer_email\n      ## due stays generated: it is a zone-aware datetime, not a date control.\n     ## Candidate-bound submit keeps the generated remainder: same operation and guards as the form above.\n     form reviewer_choices arguments={document}\n      list result as candidate columns=name,user,role,home\n       pagination\n       form submit arguments={document,assignee=candidate.user}\n    ## Collapse shares the details disclosure contract; open= applies only to Collapse.\n    collapse \"Submitted version history\"@{nl=\"Ingediende versiehistorie\"} open=preferences.versions_open\n     table row.Submission columns=revision,file,note,reviewer,due,overdue,state,reason order=-revision filter=state,reviewer,overdue\n      pagination\n      badge row.state\n      status row.overdue\n      button action=withdraw arguments={submission=row}\n      collapse \"Version decision history\"@{nl=\"Besluithistorie versies\"}\n       text row.decided_by,row.decided_at\n       history\n      table row.Notice columns=assignment,kind,recipient,state,created_by,created order=created\n       pagination\n  # Review assigned submissions or coordinate permitted assignments. @{nl=\"Beoordeel toegewezen inzendingen of coördineer toegestane toewijzingen.\"}\n  page /documents/review title=\"Review queue\"@{nl=\"Beoordelingswachtrij\"}\n   require reviewer or coordinator\n   breadcrumbs\n   table Submission as submission columns=parent,revision,file,note,reviewer,due,overdue,state order=due filter=state,reviewer,parent.location,parent.category,overdue defaults={state=preferences.review_state} display=split\n    pagination\n    card \"Exact submitted version\"@{nl=\"Exact ingediende versie\"}\n     badge row.state\n     status row.overdue\n     text row.revision,row.file,row.note,row.due,row.reason\n     ## One binding per button; each modal id is unique in this page scope; the external opener suppresses the implicit opener.\n     join\n      button opens=decide_dialog\n      button opens=assign_dialog\n     modal \"Record decision\"@{nl=\"Besluit vastleggen\"} id=decide_dialog\n      slot content\n       form decide arguments={submission=row} display=inline\n        checkbox approve\n        textarea reason\n     modal \"Assign\"@{nl=\"Toewijzen\"} id=assign_dialog\n      slot content\n       form assign arguments={submission=row} display=inline\n        input email\n     form reviewer_choices arguments={document=submission.parent}\n      list result as candidate columns=name,user,role,home\n       pagination\n       form assign arguments={submission,assignee=candidate.user}\n    collapse \"Review history\"@{nl=\"Beoordelingshistorie\"}\n     text row.decided_by,row.decided_at\n     history\n    table row.Notice columns=assignment,kind,recipient,state,created_by,created order=created\n     pagination\n"}}
