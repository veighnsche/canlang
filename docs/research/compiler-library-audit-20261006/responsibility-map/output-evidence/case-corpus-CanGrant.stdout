{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"6d73dcc837141a755d6421ce6647ec48934fbb30a93aa81a650e8b17f356b9b3","before_projection_sha256":"6d73dcc837141a755d6421ce6647ec48934fbb30a93aa81a650e8b17f356b9b3","changed":false,"idempotent":true,"structure_equal":true,"text":"# Optionally help a workspace operator run a funded startup or community program that awards monetary support to selected applicants. @{nl=\"Help een werkplekbeheerder desgewenst een gefinancierd startup- of gemeenschapsprogramma te organiseren dat geselecteerde aanvragers financiële steun toekent.\"}\napp CanGrant uses=[grant]\n\n# Keep applicant records private and reserve only affordable monetary award commitments. @{nl=\"Houd aanvragen privé en leg alleen betaalbare financiële toezeggingen vast.\"}\npackage grant\n use rent_catalog {Location,test_site}\n use employee {Employee,can_work,test_worker,hr,deactivate}\n use std {DeliveryResult}\n use std {EmailV1 as Mail} from=deployment.mail\n Given\n  message heading_program_budget = \"Program budget\"@{nl=\"Programmabudget\"}\n  message label_reviewer = \"Reviewer\"@{nl=\"Beoordelaar\"}\n  message label_Application_received = \"Received at\"@{nl=\"Ontvangen op\"}\n  message label_Application_override_reason = \"Deadline override reason\"@{nl=\"Reden deadline-uitzondering\"}\n  preferences { location:Location?, application_state:Application.state? label=\"Application state\"@{nl=\"Aanvraagstatus\"} }\n  role coordinator label=\"Program coordinator\"@{nl=\"Programmacoördinator\"}\n  role reviewer label=label_reviewer\n  contract Question { key:text trim min=1, prompt:text trim min=1 } label=\"Eligibility question\"@{nl=\"Toelatingsvraag\"}\n  contract Answer { question:text trim min=1, value:text trim min=1 } label=\"Recorded answer\"@{nl=\"Vastgelegd antwoord\"}\n  contract AwardItem { application:text, title:text, amount:money, decided_at:datetime }\n  contract AwardBatch { items:AwardItem[]! }\n  derive complete_answers(questions:Question[],answers:Answer[]):bool = count(questions)==count(answers) and all(questions as question,count(answers as answer where answer.question==question.key)==1)\n  Grant { location:Location, name:text, terms:text label=\"Terms\"@{nl=\"Voorwaarden\"}, questions:Question[]! label=\"Questions\"@{nl=\"Vragen\"}, criteria:text label=\"Selection criteria\"@{nl=\"Selectiecriteria\"}, budget:money label=\"Budget\"@{nl=\"Budget\"}, closes:datetime label=\"Closing deadline\"@{nl=\"Sluitingsdatum\"}, timezone:timezone, published:bool=false label=\"Published\"@{nl=\"Gepubliceerd\"} } label=\"Funded program\"@{nl=\"Financieringsprogramma\"}\n  Application in Grant { account:user label=\"Account\"@{nl=\"Account\"}, email:email, title:text trim min=1, description:text trim min=1, terms:text label=\"Frozen terms\"@{nl=\"Vastgelegde voorwaarden\"}, criteria:text label=\"Frozen criteria\"@{nl=\"Vastgelegde criteria\"}, questions:Question[]! label=\"Frozen questions\"@{nl=\"Vastgelegde vragen\"}, correction:Application? label=\"Corrects application\"@{nl=\"Corrigeert aanvraag\"}, answers:Answer[] label=\"Answers\"@{nl=\"Antwoorden\"}, amount:money, reviewer:user label=label_reviewer, received:datetime? label=label_Application_received, receipt_evidence:text? label=\"Receipt evidence\"@{nl=\"Ontvangstbewijs\"}, override_reason:text? label=label_Application_override_reason, state:enum(draft,submitted,approved,rejected,withdrawn,superseded)=draft label={text=\"State\"@{nl=\"Status\"},values={draft=\"Draft\"@{nl=\"Concept\"},submitted=\"Submitted\"@{nl=\"Ingediend\"},approved=\"Approved\"@{nl=\"Goedgekeurd\"},rejected=\"Rejected\"@{nl=\"Afgewezen\"},withdrawn=\"Withdrawn\"@{nl=\"Ingetrokken\"},superseded=\"Superseded\"@{nl=\"Vervangen\"}}}, decision:text? label=\"Decision\"@{nl=\"Besluit\"}, decided_by:user? label=\"Decided by\"@{nl=\"Besloten door\"}, decided_at:datetime? label=\"Decided at\"@{nl=\"Besloten op\"}, notice:delivery(Mail.send)? } label=\"Application\"@{nl=\"Aanvraag\"}\n  Comment in Application { body:text trim min=1, author:user server=actor, recorded:datetime server=now } label=\"Private reviewer comment\"@{nl=\"Privéopmerking beoordelaar\"}\n  Withdrawal in Application { reason:text trim min=1, author:user server=actor, recorded:datetime server=now } label=\"Award withdrawal\"@{nl=\"Intrekking toezegging\"}\n  Recovery in Application { previous:user label=\"Previous reviewer\"@{nl=\"Vorige beoordelaar\"}, reviewer:user label=label_reviewer, reason:text trim min=1, author:user server=actor, recorded:datetime server=now } label=\"Reviewer recovery\"@{nl=\"Herstel beoordelaar\"}\n  derive Application.notice_state:DeliveryResult.status? = row.notice?.status label=\"Decision notice delivery\"@{nl=\"Bezorging besluitbericht\"}\n  derive Grant.requested:money = sum(row.Application as application where application.state in [submitted,approved,rejected,withdrawn] select application.amount,row.budget.currency) label=\"Requested amount\"@{nl=\"Aangevraagd bedrag\"}\n  derive Grant.withdrawn:money = sum(row.Application as application where application.state==withdrawn select application.amount,row.budget.currency) label=\"Withdrawn amount\"@{nl=\"Ingetrokken bedrag\"}\n  derive Grant.committed:money = sum(row.Application as application where application.state==approved select application.amount,row.budget.currency) label=\"Committed amount\"@{nl=\"Vastgelegd bedrag\"}\n  derive Grant.remaining:money = row.budget-row.committed label=\"Remaining\"@{nl=\"Resterend\"}\n  policy Grant read=public where=row.published fields=location,name,terms,questions,criteria,closes,timezone,published\n  policy Grant read=coordinator and can_work(actor,row.location)\n  policy Grant read=reviewer where=can_work(actor,row.location) and any(row.Application as application,application.reviewer==actor and application.state==submitted) fields=location,name,terms,questions,criteria,closes,timezone,published\n  policy Application read=authenticated where=row.account==actor\n  policy Application read=reviewer where=row.reviewer==actor and row.state==submitted and can_work(actor,row.parent.location)\n  policy Application read=coordinator and can_work(actor,row.parent.location)\n  policy Comment read=reviewer where=row.parent.reviewer==actor and row.parent.state==submitted and row.parent.account!=actor and can_work(actor,row.parent.parent.location)\n  policy Comment read=coordinator and can_work(actor,row.parent.parent.location)\n  policy Withdrawal read=authenticated where=row.parent.account==actor or (coordinator and can_work(actor,row.parent.parent.location))\n  policy Recovery read=reviewer where=row.parent.reviewer==actor and row.parent.state==submitted and can_work(actor,row.parent.parent.location)\n  policy Recovery read=authenticated where=row.parent.account==actor or (coordinator and can_work(actor,row.parent.parent.location))\n  unique Application fields=correction where=row.state==draft\n  invariant Grant: count(row.questions)>0 and count(group(row.questions as question,question.key))==count(row.questions) and row.budget.minor>=0 and row.remaining.minor>=0\n  invariant Application: row.amount.currency==row.parent.budget.currency and row.amount.minor>0 and (row.correction==null or (row.correction.parent==row.parent and row.correction.account==row.account))\n  lock Application fields=account,terms,criteria,questions,correction\n  lock Application fields=decision,decided_by,decided_at when=row.decided_at!=null\n  lock Application fields=notice when=row.notice!=null\n  lock Comment fields=body,author,recorded\n  lock Withdrawal fields=reason,author,recorded\n  lock Recovery fields=previous,reviewer,reason,author,recorded\n  lock Application fields=email,title,description,answers,amount,received,receipt_evidence,override_reason when=row.state!=draft\n  lock Application fields=reviewer when=row.state!=draft and (row.state!=submitted or (reviewer(row.reviewer) and can_work(row.reviewer,row.parent.location)))\n  ## Typed isolated receipt snapshots include a valid frozen request; no provider send is performed.\n  fixture attempt=Mail.send {request={to=\"recipient@example.test\",subject=\"Notice\",body=\"Recorded decision\"}}\n  ## Independent detached failure must not change the selected attempt.\n  fixture detached_notice=Mail.send {request={to=\"recipient@example.test\",subject=\"Notice\",body=\"Recorded decision\"},status=failed,error={code=\"provider\",message=\"Delivery rejected\"}}\n  fixture detached_success=Mail.send {request={to=\"recipient@example.test\",subject=\"Notice\",body=\"Recorded decision\"},status=succeeded,result={reference=\"accepted-mail\"}}\n  fixture reviewer_user=user {roles=[reviewer]}\n  fixture replacement_user=user {roles=[reviewer]}\n  fixture coordinator_user=user {roles=[coordinator]}\n  fixture ordinary_user=user {}\n  fixture hr_user=user {roles=[hr]}\n  fixture replacement_worker=Employee {user=replacement_user,home=test_site,locations=[test_site],start=date(\"2026-10-01\"),role=\"Replacement reviewer\"}\n  fixture coordinator_worker=Employee {user=coordinator_user,home=test_site,locations=[test_site],start=date(\"2026-10-01\"),role=\"Coordinator\"}\n  fixture ordinary_worker=Employee {user=ordinary_user,home=test_site,locations=[test_site],start=date(\"2026-10-01\"),role=\"Reviewer\"}\n  fixture colleague=Employee {user=reviewer_user,home=test_site,locations=[test_site],start=date(\"2026-10-01\"),role=\"Reviewer\"}\n  fixture program=Grant {location=test_site,name=\"Startup fund\",terms=\"Cash award\",questions=[Question {key=\"purpose\",prompt=\"Purpose\"}],criteria=\"Impact\",budget=money(100,\"EUR\"),closes=datetime(\"2099-01-01T09:00:00Z\"),timezone=\"Europe/Brussels\",published=true}\n  fixture corrected=Application {parent=program,account=other,correction=submitted_app,email=\"applicant@example.test\",title=\"Corrected project\",description=\"Clarified business\",terms=submitted_app.terms,criteria=submitted_app.criteria,questions=submitted_app.questions,answers=submitted_app.answers,amount=money(60,\"EUR\"),reviewer=reviewer_user}\n  fixture submitted_app=Application {parent=program,account=other,email=\"applicant@example.test\",title=\"Project\",description=\"New business\",terms=program.terms,criteria=program.criteria,questions=program.questions,answers=[Answer {question=\"purpose\",value=\"Launch\"}],amount=money(60,\"EUR\"),reviewer=reviewer_user,received=datetime(\"2026-10-01T09:00:00Z\"),state=submitted}\n When\n  crud Grant by=coordinator fields=name,terms,questions,criteria,budget,closes,published create_fields=location,name,terms,questions,criteria,budget,closes,timezone when=can_work(actor,row.location) delete=none\n  crud Comment by=reviewer fields=body update=none delete=none when=row.parent.reviewer==actor and row.parent.state==submitted and row.parent.account!=actor and can_work(actor,row.parent.parent.location)\n  crud Application by=authenticated fields=email,title,description,answers,amount,reviewer create=none when=row.account==actor and row.state==draft and row.parent.published and now<=row.parent.closes delete=none\n   examples update record=submitted_app changes={answers=[]}\n    as,record.account,record.state,changes.answers -> count(record.answers)\n    members,self,draft,[] -> 0\n    members,self,draft,[Answer {question=\"purpose\",value=\"\"}] -> error(validation)\n    members,other,draft,[] -> error(rule_failed)\n  # Start your private draft with the program's frozen question definitions. @{nl=\"Begin je privéconcept met de vastgelegde vraagdefinities van het programma.\"}\n  scenario apply(grant:Grant,email:email,title:Application.title,description:Application.description,amount:money,assignee:user label=label_reviewer) by=authenticated label=\"Start application\"@{nl=\"Aanvraag beginnen\"}\n   require grant.published and now<=grant.closes and assignee!=actor and reviewer(assignee) and can_work(assignee,grant.location)\n   do create Application {parent=grant,account=actor,email,title,description,terms=grant.terms,criteria=grant.criteria,questions=grant.questions,amount,reviewer=assignee} as application\n   examples seed=[colleague,ordinary_worker] grant=program email=\"applicant@example.test\" title=\"Project\" description=\"New business\" amount=money(60,\"EUR\") assignee=reviewer_user\n    as,assignee,grant.closes,amount -> count(grant.Application)\n    self,reviewer_user,datetime(\"2099-01-01T09:00:00Z\"),money(60,\"EUR\") -> 1\n    self,self,datetime(\"2099-01-01T09:00:00Z\"),money(60,\"EUR\") -> error(rule_failed)\n    self,reviewer_user,datetime(\"2000-01-01T09:00:00Z\"),money(60,\"EUR\") -> error(rule_failed)\n    self,ordinary_user,datetime(\"2099-01-01T09:00:00Z\"),money(60,\"EUR\") -> error(rule_failed)\n    self,reviewer_user,datetime(\"2099-01-01T09:00:00Z\"),money(60,\"USD\") -> error(rule_failed)\n    self,reviewer_user,datetime(\"2099-01-01T09:00:00Z\"),money(0,\"EUR\") -> error(rule_failed)\n   ## Shared-state sequences are proposed; the initial parser does not support their do grammar. Static user grants are not a live role-revocation event.\n   examples seed=[program,colleague,coordinator_worker,ordinary_user]\n    do\n     call apply {grant=program,email=\"applicant@example.test\",title=\"Journey project\",description=\"New business\",amount=money(60,\"EUR\"),assignee=reviewer_user} by=self\n     let draft=first(program.Application as row where row.account==self and row.correction==null order=row.id)\n     draft!=null -> true\n     call submit {application=draft} by=self -> error(rule_failed)\n     call Application.update {record=draft,changes={answers=[Answer {question=\"purpose\",value=\"Launch\"}]}} by=self\n     let ready=first(program.Application as row where row.account==self and row.correction==null order=row.id)\n     ready!=null -> true\n     call submit {application=ready} by=self\n     let pending=first(program.Application as row where row.account==self and row.correction==null order=row.id)\n     pending!=null -> true\n     call decide {application=pending,approve=true,reason=\"Meets criteria\"} by=ordinary_user -> error(forbidden)\n     count(program.Application) -> 0\n     call decide {application=pending,approve=true,reason=\"Meets criteria\"} by=reviewer_user\n     call award_export {grant=program} by=coordinator_user as first_awards\n     count(first_awards.items),program.committed,program.remaining -> 1,money(60,\"EUR\"),money(40,\"EUR\")\n     call apply {grant=program,email=\"applicant@example.test\",title=\"Competing project\",description=\"New business\",amount=money(60,\"EUR\"),assignee=reviewer_user} by=other\n     let competing_draft=first(program.Application as row where row.account==other and row.correction==null order=row.id)\n     competing_draft!=null -> true\n     call Application.update {record=competing_draft,changes={answers=[Answer {question=\"purpose\",value=\"Launch\"}]}} by=other\n     let competing_ready=first(program.Application as row where row.account==other and row.correction==null order=row.id)\n     competing_ready!=null -> true\n     call submit {application=competing_ready} by=other\n     let competing_pending=first(program.Application as row where row.account==other and row.correction==null order=row.id)\n     competing_pending!=null -> true\n     call decide {application=competing_pending,approve=true,reason=\"Impact also verified\"} by=reviewer_user -> error(rule_failed)\n     program.Application as row where row.state==submitted select row.amount -> [money(60,\"EUR\")]\n     call decide {application=competing_pending,approve=false,reason=\"Funds already committed\"} by=reviewer_user\n     call award_export {grant=program} by=coordinator_user as retained_awards\n     let approved=first(program.Application as row where row.account==self and row.correction==null order=row.id)\n     approved!=null -> true\n     call withdraw {application=approved,reason=\"Funding cancelled\"} by=coordinator_user\n     let withdrawn=first(program.Application as row where row.account==self and row.correction==null order=row.id)\n     withdrawn!=null -> true\n     call withdraw {application=withdrawn,reason=\"Repeated withdrawal\"} by=coordinator_user -> error(rule_failed)\n     call award_export {grant=program} by=coordinator_user as empty_awards\n     withdrawn.state,withdrawn.decision,withdrawn.decided_by,withdrawn.amount,count(withdrawn.Withdrawal),count(empty_awards.items),program.requested,program.committed,program.withdrawn,program.remaining -> withdrawn,\"Meets criteria\",reviewer_user,money(60,\"EUR\"),1,0,money(120,\"EUR\"),money(0,\"EUR\"),money(60,\"EUR\"),money(100,\"EUR\")\n   examples seed=[program,colleague,coordinator_worker]\n    do\n     call apply {grant=program,email=\"applicant@example.test\",title=\"Journey project\",description=\"New business\",amount=money(60,\"EUR\"),assignee=reviewer_user} by=self\n     let draft=first(program.Application as row where row.account==self and row.correction==null order=row.id)\n     draft!=null -> true\n     call Application.update {record=draft,changes={answers=[Answer {question=\"purpose\",value=\"Launch\"}]}} by=self\n     let ready=first(program.Application as row where row.account==self and row.correction==null order=row.id)\n     ready!=null -> true\n     call submit {application=ready} by=self\n     let pending=first(program.Application as row where row.account==self and row.correction==null order=row.id)\n     pending!=null -> true\n     call Comment.create {parent=pending,body=\"Private assessment\"} by=reviewer_user\n     call decide {application=pending,approve=false,reason=\"Clarify the plan\"} by=reviewer_user\n     call award_export {grant=program} by=coordinator_user as rejected_awards\n     let rejected=first(program.Application as row where row.account==self and row.correction==null order=row.id)\n     rejected!=null -> true\n     call Application.update {record=rejected,changes={answers=[]}} by=self -> error(rule_failed)\n     count(rejected.Comment) -> 0\n     call Grant.update {record=program,changes={terms=\"New terms\",criteria=\"New criteria\"}} by=coordinator_user\n     call correct {application=rejected} by=self\n     call correct {application=rejected} by=self -> error(rule_failed)\n     let correction=first(program.Application as row where row.account==self and row.correction==rejected order=row.id)\n     correction!=null -> true\n     correction.terms,correction.criteria,correction.state,rejected.state,rejected.decision -> \"Cash award\",\"Impact\",draft,rejected,\"Clarify the plan\"\n     call Application.update {record=correction,changes={answers=[Answer {question=\"purpose\",value=\"Launch\"}],amount=money(40,\"EUR\")}} by=self\n     let corrected_ready=first(program.Application as row where row.account==self and row.correction==rejected order=row.id)\n     corrected_ready!=null -> true\n     call submit {application=corrected_ready} by=self\n     let corrected_pending=first(program.Application as row where row.account==self and row.correction==rejected order=row.id)\n     corrected_pending!=null -> true\n     call decide {application=corrected_pending,approve=true,reason=\"Corrected plan checked\"} by=reviewer_user\n     call award_export {grant=program} by=coordinator_user as corrected_awards\n     let corrected_approved=first(program.Application as row where row.account==self and row.correction==rejected order=row.id)\n     corrected_approved!=null -> true\n     let retained_rejection=first(program.Application as row where row.account==self and row.correction==null order=row.id)\n     retained_rejection!=null -> true\n     retained_rejection.state,retained_rejection.decision,corrected_approved.state,corrected_approved.amount,corrected_approved.terms,corrected_approved.criteria,corrected_approved.correction==rejected,count(corrected_awards.items),program.committed,program.remaining -> rejected,\"Clarify the plan\",approved,money(40,\"EUR\"),\"Cash award\",\"Impact\",true,1,money(40,\"EUR\"),money(60,\"EUR\")\n   examples seed=[program,colleague,replacement_worker,coordinator_worker,ordinary_worker,hr_user]\n    do\n     call apply {grant=program,email=\"applicant@example.test\",title=\"Journey project\",description=\"New business\",amount=money(60,\"EUR\"),assignee=reviewer_user} by=self\n     let draft=first(program.Application as row where row.account==self and row.correction==null order=row.id)\n     draft!=null -> true\n     call Application.update {record=draft,changes={answers=[Answer {question=\"purpose\",value=\"Launch\"}]}} by=self\n     let ready=first(program.Application as row where row.account==self and row.correction==null order=row.id)\n     ready!=null -> true\n     call submit {application=ready} by=self\n     let pending=first(program.Application as row where row.account==self and row.correction==null order=row.id)\n     pending!=null -> true\n     let submitted_version=pending.version\n     let original_received=pending.received\n     call Grant.update {record=program,changes={closes=now-1m,terms=\"New terms\",criteria=\"New criteria\",questions=[Question {key=\"new\",prompt=\"New question\"}]}} by=coordinator_user\n     call deactivate {employee=colleague,ended=date(\"2026-10-02\")} by=hr_user\n     colleague.active,reviewer(reviewer_user),can_work(reviewer_user,test_site) -> false,true,false\n     call decide {application=pending,approve=true,reason=\"Meets criteria\"} by=reviewer_user -> error(rule_failed)\n     call correct {application=pending} by=self -> error(rule_failed)\n     call recover {application=pending,assignee=replacement_user,reason=\"Reviewer unavailable\"} by=ordinary_user -> error(forbidden)\n     call recover {application=pending,assignee=ordinary_user,reason=\"Reviewer unavailable\"} by=coordinator_user -> error(rule_failed)\n     call recover {application=pending,assignee=replacement_user,reason=\" Reviewer unavailable \"} by=coordinator_user\n     let recovered=first(program.Application as row where row.account==self and row.correction==null order=row.id)\n     recovered!=null -> true\n     call recover {application=recovered,assignee=reviewer_user,reason=\"Repeat\"} by=coordinator_user request={application={version=submitted_version}} -> error(conflict)\n     call recover {application=recovered,assignee=replacement_user,reason=\"Repeat\"} by=coordinator_user -> error(rule_failed)\n     recovered.state,recovered.reviewer,recovered.received,recovered.amount,recovered.terms,recovered.criteria,recovered.questions==[Question {key=\"purpose\",prompt=\"Purpose\"}],count(recovered.Recovery),any(recovered.Recovery as evidence,evidence.previous==reviewer_user and evidence.reviewer==replacement_user and evidence.reason==\"Reviewer unavailable\" and evidence.author==coordinator_user),program.committed -> submitted,replacement_user,original_received,money(60,\"EUR\"),\"Cash award\",\"Impact\",true,1,true,money(0,\"EUR\")\n     call decide {application=recovered,approve=true,reason=\"Meets criteria\"} by=reviewer_user -> error(rule_failed)\n     call decide {application=recovered,approve=true,reason=\"Recovery reviewed\"} by=replacement_user\n     call award_export {grant=program} by=coordinator_user as recovered_awards\n     let recovered_approved=first(program.Application as row where row.account==self and row.correction==null order=row.id)\n     recovered_approved!=null -> true\n     call recover {application=recovered_approved,assignee=reviewer_user,reason=\"After decision\"} by=coordinator_user -> error(rule_failed)\n     recovered_approved.state,recovered_approved.reviewer,recovered_approved.decided_by,recovered_approved.decision,recovered_approved.received,recovered_approved.notice_state,count(recovered_awards.items),program.committed,program.remaining -> approved,replacement_user,replacement_user,\"Recovery reviewed\",original_received,pending,1,money(60,\"EUR\"),money(40,\"EUR\")\n  # Make a private correction without reopening or deleting the previous intake. @{nl=\"Maak een privécorrectie zonder de eerdere aanvraag te heropenen of te verwijderen.\"}\n  scenario correct(application:Application) by=authenticated label=\"Create correction draft\"@{nl=\"Correctieconcept maken\"}\n   require application.account==actor and application.state in [submitted,rejected] and application.parent.published and now<=application.parent.closes\n   require not any(application.parent.Application as replacement,replacement.correction==application and replacement.state in [draft,submitted,approved])\n   do create Application {parent=application.parent,account=actor,correction=application,email=application.email,title=application.title,description=application.description,terms=application.terms,criteria=application.criteria,questions=application.questions,answers=application.answers,amount=application.amount,reviewer=application.reviewer} as replacement\n   examples application=submitted_app\n    as,application.account,application.state -> application.state,count(application.parent.Application)\n    self,self,submitted -> submitted,2\n    self,self,rejected -> rejected,2\n    self,other,submitted -> error(rule_failed)\n    self,self,approved -> error(rule_failed)\n  # Submit your application at authoritative receipt time with the required recorded answers. @{nl=\"Dien je aanvraag in met het gezaghebbende ontvangsttijdstip en de vereiste vastgelegde antwoorden.\"}\n  scenario submit(application:Application) by=authenticated\n   require application.account==actor and application.state==draft and now<=application.parent.closes and application.parent.published and application.reviewer!=actor and reviewer(application.reviewer) and can_work(application.reviewer,application.parent.location) and complete_answers(application.questions,application.answers)\n   do\n    if application.correction!=null\n     require application.correction.state in [submitted,rejected]\n     if application.correction.state==submitted\n      set application.correction {state=superseded}\n    set application {state=submitted,received=now}\n   examples seed=[colleague,ordinary_worker] application=submitted_app\n    as,application.account,application.reviewer,application.state,application.answers,application.parent.closes,request.application.version -> application.state,application.received\n    self,self,reviewer_user,draft,[Answer {question=\"purpose\",value=\"Launch\"}],datetime(\"2099-01-01T09:00:00Z\"),1 -> submitted,now\n    self,self,self,draft,[Answer {question=\"purpose\",value=\"Launch\"}],datetime(\"2099-01-01T09:00:00Z\"),1 -> error(rule_failed)\n    self,self,reviewer_user,draft,[],datetime(\"2099-01-01T09:00:00Z\"),1 -> error(rule_failed)\n    self,self,reviewer_user,draft,[Answer {question=\"wrong\",value=\"Launch\"}],datetime(\"2099-01-01T09:00:00Z\"),1 -> error(rule_failed)\n    self,self,reviewer_user,draft,[Answer {question=\"purpose\",value=\"Launch\"},Answer {question=\"purpose\",value=\"Again\"}],datetime(\"2099-01-01T09:00:00Z\"),1 -> error(rule_failed)\n    self,self,reviewer_user,draft,[Answer {question=\"purpose\",value=\"Launch\"}],datetime(\"2000-01-01T09:00:00Z\"),1 -> error(rule_failed)\n    self,self,ordinary_user,draft,[Answer {question=\"purpose\",value=\"Launch\"}],datetime(\"2099-01-01T09:00:00Z\"),1 -> error(rule_failed)\n    self,self,reviewer_user,draft,[Answer {question=\"purpose\",value=\"Launch\"}],datetime(\"2099-01-01T09:00:00Z\"),2 -> error(conflict)\n   examples seed=[colleague] application=corrected\n    as,application.account,submitted_app.account,application.reviewer,submitted_app.state -> application.state,submitted_app.state,submitted_app.received,application.received\n    self,self,self,reviewer_user,submitted -> submitted,superseded,datetime(\"2026-10-01T09:00:00Z\"),now\n    self,self,self,reviewer_user,rejected -> submitted,rejected,datetime(\"2026-10-01T09:00:00Z\"),now\n    self,self,self,reviewer_user,approved -> error(rule_failed)\n  # Enter an externally received application for its actual applicant before recording receipt evidence. @{nl=\"Voer een extern ontvangen aanvraag in voor de echte aanvrager en leg het ontvangstbewijs vast.\"}\n  scenario intake(grant:Grant,applicant:user,email:email,title:Application.title,description:Application.description,answers:Answer[],amount:money,assignee:user label=label_reviewer,received:datetime label=label_Application_received,evidence:text,override_reason:text? label=label_Application_override_reason) by=coordinator label=\"External applicant intake\"@{nl=\"Externe aanvraag invoeren\"}\n   require can_work(actor,grant.location)\n   do\n    create Application {parent=grant,account=applicant,email,title,description,terms=grant.terms,criteria=grant.criteria,questions=grant.questions,answers,amount,reviewer=assignee} as application\n    call external {application,received,evidence,override_reason}\n   ## The external-intake sequence uses normal calls; failed receipt admission rolls back its create.\n   examples seed=[program,colleague,coordinator_worker,ordinary_user]\n    do\n     call Grant.update {record=program,changes={closes=now-1m}} by=coordinator_user\n     call intake {grant=program,applicant=other,email=\"external@example.test\",title=\"External project\",description=\"Recorded application\",answers=[Answer {question=\"purpose\",value=\"Launch\"}],amount=money(60,\"EUR\"),assignee=reviewer_user,received=now,evidence=\"Signed receipt\",override_reason=null} by=coordinator_user -> error(rule_failed)\n     count(program.Application) -> 0\n     call intake {grant=program,applicant=other,email=\"external@example.test\",title=\"External project\",description=\"Recorded application\",answers=[Answer {question=\"purpose\",value=\"Launch\"}],amount=money(60,\"EUR\"),assignee=reviewer_user,received=now+1m,evidence=\"Signed receipt\",override_reason=\"Documented exception\"} by=coordinator_user -> error(rule_failed)\n     call intake {grant=program,applicant=other,email=\"external@example.test\",title=\"External project\",description=\"Recorded application\",answers=[Answer {question=\"purpose\",value=\"Launch\"}],amount=money(60,\"EUR\"),assignee=reviewer_user,received=now,evidence=\"Signed receipt\",override_reason=\"Documented exception\"} by=ordinary_user -> error(forbidden)\n     call intake {grant=program,applicant=other,email=\"external@example.test\",title=\"External project\",description=\"Recorded application\",answers=[Answer {question=\"purpose\",value=\"Launch\"}],amount=money(60,\"EUR\"),assignee=reviewer_user,received=now,evidence=\"Signed receipt\",override_reason=\"Documented exception\"} by=coordinator_user\n     let external_application=first(program.Application as row where row.account==other and row.correction==null order=row.id)\n     external_application!=null -> true\n     external_application.account,external_application.state,external_application.received,external_application.receipt_evidence,external_application.override_reason,external_application.terms,external_application.criteria -> other,submitted,now,\"Signed receipt\",\"Documented exception\",\"Cash award\",\"Impact\"\n     call decide {application=external_application,approve=true,reason=\"External evidence checked\"} by=reviewer_user\n     call award_export {grant=program} by=coordinator_user as external_awards\n     count(external_awards.items),program.committed,program.remaining -> 1,money(60,\"EUR\"),money(40,\"EUR\")\n  # Record an evidenced external receipt with an explicit late override where needed. @{nl=\"Registreer een bewezen externe ontvangst, indien nodig met een expliciete uitzondering op de deadline.\"}\n  scenario external(application:Application,received:datetime label=label_Application_received,evidence:text,override_reason:text? label=label_Application_override_reason) by=coordinator label=\"Record external receipt\"@{nl=\"Externe ontvangst registreren\"}\n   require can_work(actor,application.parent.location) and application.state==draft and trim(evidence)!=\"\" and received<=now and (received<=application.parent.closes or (override_reason!=null and trim(override_reason)!=\"\"))\n   require application.reviewer!=application.account and reviewer(application.reviewer) and can_work(application.reviewer,application.parent.location) and complete_answers(application.questions,application.answers)\n   do\n    if application.correction!=null\n     require application.correction.state in [submitted,rejected]\n     if application.correction.state==submitted\n      set application.correction {state=superseded}\n    set application {state=submitted,received,receipt_evidence=evidence,override_reason}\n   examples seed=[test_worker,colleague] application=submitted_app received=datetime(\"2026-10-01T09:00:00Z\") evidence=\"Signed receipt\"\n    as,application.state,application.answers,application.parent.closes,override_reason -> application.state,application.received,application.override_reason\n    coordinator,draft,[Answer {question=\"purpose\",value=\"Launch\"}],datetime(\"2099-01-01T09:00:00Z\"),null -> submitted,datetime(\"2026-10-01T09:00:00Z\"),null\n    coordinator,draft,[Answer {question=\"purpose\",value=\"Launch\"}],datetime(\"2000-01-01T09:00:00Z\"),null -> error(rule_failed)\n    coordinator,draft,[Answer {question=\"purpose\",value=\"Launch\"}],datetime(\"2000-01-01T09:00:00Z\"),\"Documented exception\" -> submitted,datetime(\"2026-10-01T09:00:00Z\"),\"Documented exception\"\n    coordinator,draft,[],datetime(\"2099-01-01T09:00:00Z\"),null -> error(rule_failed)\n  # Decide exactly a submitted application without self-review or overspending. @{nl=\"Beoordeel uitsluitend een ingediende aanvraag, zonder zelfbeoordeling of budgetoverschrijding.\"}\n  scenario decide(application:Application,approve:bool label=\"Approve\"@{nl=\"Goedkeuren\"},reason:text) by=reviewer label=\"Record decision\"@{nl=\"Besluit vastleggen\"}\n   require application.reviewer==actor and application.account!=actor and application.state==submitted and can_work(actor,application.parent.location) and trim(reason)!=\"\"\n   do\n    if approve\n     require application.amount<=application.parent.remaining\n     set application {state=approved,decision=reason,decided_by=actor,decided_at=now}\n    else\n     set application {state=rejected,decision=reason,decided_by=actor,decided_at=now}\n    send Mail.send {to=application.email,subject=format(\"Award decision\"@{nl=\"Besluit over aanvraag\"},locale=null),body=reason} as notice\n    set application {notice}\n   examples seed=[test_worker,colleague] application=submitted_app approve=true reason=\"Meets criteria\"\n    as,application.reviewer,application.account,application.amount,request.application.version -> application.state,program.remaining,application.notice_state\n    reviewer,self,other,money(60,\"EUR\"),1 -> approved,money(40,\"EUR\"),pending\n    reviewer,self,self,money(60,\"EUR\"),1 -> error(rule_failed)\n    reviewer,self,other,money(101,\"EUR\"),1 -> error(rule_failed)\n    members,self,other,money(60,\"EUR\"),1 -> error(forbidden)\n    reviewer,self,other,money(60,\"EUR\"),2 -> error(conflict)\n  ## Recovery keeps the original submitted intake and receipt. Only an unavailable reviewer can be replaced; the pre-state lock remains absolute after any decision.\n  scenario recover(application:Application,assignee:user label=label_reviewer,reason:text) by=coordinator label=\"Restore review\"@{nl=\"Beoordeling herstellen\"}\n   require can_work(actor,application.parent.location) and application.state==submitted and trim(reason)!=\"\"\n   require not reviewer(application.reviewer) or not can_work(application.reviewer,application.parent.location)\n   require assignee!=application.account and reviewer(assignee) and can_work(assignee,application.parent.location)\n   do\n    create Recovery {parent=application,previous=application.reviewer,reviewer=assignee,reason} as recovery\n    set application {reviewer=assignee}\n   examples seed=[colleague,ordinary_worker,replacement_worker,coordinator_worker] application=submitted_app assignee=replacement_user reason=\"Review unavailable\"\n    as,application.state,application.reviewer,colleague.active,assignee,reason,request.application.version -> application.reviewer,application.state,application.received,application.amount,application.terms,application.criteria,count(application.Recovery),any(application.Recovery as recovery,recovery.previous==reviewer_user and recovery.reviewer==replacement_user and recovery.reason==\"Review unavailable\" and recovery.author==coordinator_user)\n    coordinator_user,submitted,reviewer_user,false,replacement_user,\" Review unavailable \",1 -> replacement_user,submitted,datetime(\"2026-10-01T09:00:00Z\"),money(60,\"EUR\"),\"Cash award\",\"Impact\",1,true\n    coordinator_user,submitted,ordinary_user,true,replacement_user,\" Review unavailable \",1 -> replacement_user,submitted,datetime(\"2026-10-01T09:00:00Z\"),money(60,\"EUR\"),\"Cash award\",\"Impact\",1,false\n    coordinator_user,submitted,reviewer_user,true,replacement_user,\"Review unavailable\",1 -> error(rule_failed)\n    coordinator_user,submitted,reviewer_user,false,ordinary_user,\"Review unavailable\",1 -> error(rule_failed)\n    coordinator_user,submitted,reviewer_user,false,other,\"Review unavailable\",1 -> error(rule_failed)\n    coordinator_user,approved,reviewer_user,false,replacement_user,\"Review unavailable\",1 -> error(rule_failed)\n    ordinary_user,submitted,reviewer_user,false,replacement_user,\"Review unavailable\",1 -> error(forbidden)\n    coordinator_user,submitted,reviewer_user,false,replacement_user,\" \",1 -> error(rule_failed)\n    coordinator_user,submitted,reviewer_user,false,replacement_user,\"Review unavailable\",2 -> error(conflict)\n  # Withdraw an approved commitment by a reasoned coordinator decision; this is not a disbursement. @{nl=\"Trek een goedgekeurde toezegging in met een gemotiveerd coördinatorbesluit; dit is geen uitbetaling.\"}\n  scenario withdraw(application:Application,reason:text) by=coordinator label=\"Withdraw\"@{nl=\"Intrekken\"}\n   require can_work(actor,application.parent.location) and application.state==approved and trim(reason)!=\"\"\n   do\n    create Withdrawal {parent=application,reason} as withdrawal\n    set application {state=withdrawn}\n   examples seed=[test_worker] application=submitted_app reason=\"Funding cancelled\"\n    as,application.state,application.decision,application.decided_by,application.decided_at -> application.state,application.decision,count(application.Withdrawal),program.remaining,application.decided_by,application.decided_at\n    coordinator,approved,\"Meets criteria\",reviewer_user,datetime(\"2026-10-01T09:00:00Z\") -> withdrawn,\"Meets criteria\",1,money(100,\"EUR\"),reviewer_user,datetime(\"2026-10-01T09:00:00Z\")\n    coordinator,withdrawn,\"Meets criteria\",reviewer_user,datetime(\"2026-10-01T09:00:00Z\") -> error(rule_failed)\n  # Export authorized approved commitments with exact currency and decision time. @{nl=\"Exporteer toegestane goedgekeurde toezeggingen met exacte valuta en besluittijd.\"}\n  scenario award_export(grant:Grant) read=true -> AwardBatch by=coordinator label=\"Export awards\"@{nl=\"Toezeggingen exporteren\"}\n   require can_work(actor,grant.location)\n   do return AwardBatch {items=grant.Application as application where application.state==approved and application.decided_at!=null select AwardItem {application=application.id,title=application.title,amount=application.amount,decided_at=application.decided_at}}\n   examples seed=[coordinator_worker] grant=program\n    as -> count(result.items)\n    coordinator_user -> 0\n    ordinary_user -> error(forbidden)\n   ## Status-only receipt snapshots do not alter committed awards. A detached failed attempt cannot replace the current pending association.\n   examples seed=[coordinator_worker,submitted_app,detached_notice,detached_success,attempt] grant=program\n    as,submitted_app.state,submitted_app.decision,submitted_app.decided_by,submitted_app.decided_at,submitted_app.notice,attempt.status,attempt.result,attempt.error -> submitted_app.notice_state,submitted_app.state,submitted_app.decision,submitted_app.decided_by,submitted_app.decided_at,submitted_app.amount,count(result.items),program.remaining\n    coordinator_user,approved,\"Meets criteria\",reviewer_user,datetime(\"2026-10-01T09:00:00Z\"),attempt,succeeded,{reference=\"accepted-mail\"},null -> succeeded,approved,\"Meets criteria\",reviewer_user,datetime(\"2026-10-01T09:00:00Z\"),money(60,\"EUR\"),1,money(40,\"EUR\")\n    coordinator_user,approved,\"Meets criteria\",reviewer_user,datetime(\"2026-10-01T09:00:00Z\"),attempt,unknown,null,null -> unknown,approved,\"Meets criteria\",reviewer_user,datetime(\"2026-10-01T09:00:00Z\"),money(60,\"EUR\"),1,money(40,\"EUR\")\n    coordinator_user,approved,\"Meets criteria\",reviewer_user,datetime(\"2026-10-01T09:00:00Z\"),attempt,skipped,null,null -> skipped,approved,\"Meets criteria\",reviewer_user,datetime(\"2026-10-01T09:00:00Z\"),money(60,\"EUR\"),1,money(40,\"EUR\")\n    coordinator_user,approved,\"Meets criteria\",reviewer_user,datetime(\"2026-10-01T09:00:00Z\"),attempt,failed,null,{code=\"provider\",message=\"Delivery rejected\"} -> failed,approved,\"Meets criteria\",reviewer_user,datetime(\"2026-10-01T09:00:00Z\"),money(60,\"EUR\"),1,money(40,\"EUR\")\n    coordinator_user,approved,\"Meets criteria\",reviewer_user,datetime(\"2026-10-01T09:00:00Z\"),attempt,pending,null,null -> pending,approved,\"Meets criteria\",reviewer_user,datetime(\"2026-10-01T09:00:00Z\"),money(60,\"EUR\"),1,money(40,\"EUR\")\n    coordinator_user,approved,\"Meets criteria\",reviewer_user,datetime(\"2026-10-01T09:00:00Z\"),null,pending,null,null -> null,approved,\"Meets criteria\",reviewer_user,datetime(\"2026-10-01T09:00:00Z\"),money(60,\"EUR\"),1,money(40,\"EUR\")\n    coordinator_user,submitted,null,null,null,attempt,succeeded,{reference=\"accepted-mail\"},null -> succeeded,submitted,null,null,null,money(60,\"EUR\"),0,money(100,\"EUR\")\n    coordinator_user,submitted,null,null,null,attempt,unknown,null,null -> unknown,submitted,null,null,null,money(60,\"EUR\"),0,money(100,\"EUR\")\n    coordinator_user,submitted,null,null,null,attempt,skipped,null,null -> skipped,submitted,null,null,null,money(60,\"EUR\"),0,money(100,\"EUR\")\n    coordinator_user,submitted,null,null,null,attempt,pending,null,null -> pending,submitted,null,null,null,money(60,\"EUR\"),0,money(100,\"EUR\")\n Then\n  # Discover the published cash-award terms and use private applicant intake. @{nl=\"Bekijk de gepubliceerde subsidievoorwaarden en gebruik de private aanvraagprocedure.\"}\n  page /awards title=\"Funded programs\"@{nl=\"Financieringsprogramma's\"}\n   breadcrumbs\n   ## In-context saved default for the application-state filter below.\n   filter preferences.application_state\n   card \"Published programs and terms\"@{nl=\"Gepubliceerde programma's en voorwaarden\"}\n    list Grant as program where program.published order=closes filter=location,closes defaults={location=preferences.location} empty=\"No published programs.\"@{nl=\"Geen gepubliceerde programma's.\"}\n     pagination\n     text row.name,row.location,row.terms,row.questions,row.criteria,row.closes,row.timezone\n     form apply arguments={grant=row} display=inline\n      fieldset \"Your application\"@{nl=\"Je aanvraag\"}\n       input email\n       input title\n       textarea description\n   card \"Own application intake and status\"@{nl=\"Eigen aanvraag en status\"}\n    require authenticated\n    table Application as application where application.account==actor columns=title,amount,state,decision,notice_state,received,correction filter=state defaults={state=preferences.application_state} empty=\"No applications yet.\"@{nl=\"Nog geen aanvragen.\"}\n     pagination\n     badge row.state\n     status row.notice_state\n     edit\n     text row.terms,row.criteria,row.questions,row.answers\n     actions submit,correct\n     table row.Recovery columns=previous,reviewer,reason,author,recorded empty=\"No reviewer changes.\"@{nl=\"Geen beoordelaarswijzigingen.\"}\n      pagination\n     table row.Withdrawal columns=reason,author,recorded empty=\"No withdrawals.\"@{nl=\"Geen intrekkingen.\"}\n      pagination\n     history\n\n  # Review assigned applications and visible monetary commitments. @{nl=\"Beoordeel toegewezen aanvragen en zichtbare financiële toezeggingen.\"}\n  page /awards/review title=\"Award review\"@{nl=\"Aanvragen beoordelen\"}\n   breadcrumbs\n   require reviewer or coordinator\n   ## In-context saved default for the application-state filter below.\n   filter preferences.application_state\n   card heading_program_budget\n    require coordinator\n    form Grant.create display=inline\n     fieldset \"Program details\"@{nl=\"Programmagegevens\"}\n      input name\n      textarea terms\n      textarea criteria\n    form intake\n   card \"Assigned applications and decisions\"@{nl=\"Toegewezen aanvragen en besluiten\"}\n    list Grant order=closes filter=location,closes defaults={location=preferences.location} display=split empty=\"No programs in scope.\"@{nl=\"Geen programma's binnen scope.\"}\n     pagination\n     card heading_program_budget\n      require coordinator and can_work(actor,row.location)\n      edit\n      metrics row.budget,row.requested,row.committed,row.withdrawn,row.remaining\n      ## Committed and budget share the program currency by invariant; in-range by the remaining>=0 invariant.\n      progress row.committed max=row.budget\n      form award_export arguments={grant=row}\n       table result.items columns=application,title,amount,decided_at empty=\"No approved awards.\"@{nl=\"Geen goedgekeurde toezeggingen.\"}\n        pagination\n     table row.Application columns=title,description,terms,criteria,questions,answers,amount,received,receipt_evidence,override_reason,state,decision,notice_state,decided_by,decided_at order=received filter=state,reviewer defaults={state=preferences.application_state} search=title empty=\"No applications to review.\"@{nl=\"Geen aanvragen te beoordelen.\"}\n      pagination\n      badge row.state\n      status row.notice_state\n      button opens=decide_application\n      modal \"Record decision\"@{nl=\"Besluit vastleggen\"} id=decide_application\n       slot content\n        form decide arguments={application=row} display=inline\n         fieldset \"Decision\"@{nl=\"Besluit\"}\n          checkbox approve\n          textarea reason\n      button opens=record_receipt\n      modal \"Record external receipt\"@{nl=\"Externe ontvangst registreren\"} id=record_receipt\n       slot content\n        form external arguments={application=row} display=inline\n         textarea evidence\n         input override_reason\n      button opens=restore_review\n      modal \"Restore review\"@{nl=\"Beoordeling herstellen\"} id=restore_review\n       slot content\n        form recover arguments={application=row} display=inline\n         textarea reason\n      button opens=withdraw_award\n      modal \"Withdraw\"@{nl=\"Intrekken\"} id=withdraw_award\n       slot content\n        form withdraw arguments={application=row} display=inline\n         textarea reason\n      button opens=add_comment\n      modal \"Private reviewer comment\"@{nl=\"Privéopmerking beoordelaar\"} id=add_comment\n       slot content\n        form Comment.create display=inline\n         textarea body\n      list row.Comment empty=\"No reviewer comments.\"@{nl=\"Geen beoordelaarsopmerkingen.\"}\n       pagination\n       chat_bubble\n        slot header\n         text row.author\n        slot content\n         text row.body\n        slot footer\n         text row.recorded\n      accordion\n       collapse \"Reviewer recovery\"@{nl=\"Herstel beoordelaar\"}\n        table row.Recovery columns=previous,reviewer,reason,author,recorded empty=\"No reviewer changes.\"@{nl=\"Geen beoordelaarswijzigingen.\"}\n         pagination\n       collapse \"Award withdrawals\"@{nl=\"Intrekking toezeggingen\"}\n        table row.Withdrawal columns=reason,author,recorded empty=\"No withdrawals.\"@{nl=\"Geen intrekkingen.\"}\n         pagination\n      history\n"}}
