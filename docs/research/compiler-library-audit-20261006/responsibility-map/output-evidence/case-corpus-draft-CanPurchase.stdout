{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"eb8bd24722bbf0ce5c37302c3bcb9d66f6242d58f635700d4b5b1c7fcde89cc1","before_projection_sha256":"eb8bd24722bbf0ce5c37302c3bcb9d66f6242d58f635700d4b5b1c7fcde89cc1","changed":true,"idempotent":true,"structure_equal":true,"text":"# Help workspace managers authorize furniture, supplies, repairs, and other spending against location or project budgets. @{nl=\"Help werkplekmanagers meubels, benodigdheden, reparaties en andere uitgaven binnen locatie- of projectbudgetten te autoriseren.\"}\napp CanPurchase uses=[supplier,purchase]\n\n# Own supplier identities, affordable purchase commitments, partial receipts and spending evidence. @{nl=\"Beheer leveranciersidentiteiten, betaalbare inkooptoezeggingen, gedeeltelijke ontvangsten en uitgavenbewijs.\"}\npackage purchase label=page_purchasing_title\n use rent_catalog {Location,test_site}\n use employee {can_work,test_worker}\n use supplier {Supplier,buyer,budget_manager}\n use stock {StockV1 as Stock,StockReceipt} from=deployment.stock\n use purchase {PayableEvidenceV1 as Accounting} from=deployment.accounting\n use std {OperationOutcome}\n Given\n  message page_purchasing_title = \"Purchasing\"@{nl=\"Inkoop\"}\n  message label_Request_state = \"State\"@{nl=\"Status\"}\n  message label_Request_state_approved = \"Approved\"@{nl=\"Goedgekeurd\"}\n  message label_Request_state_cancelled = \"Cancelled\"@{nl=\"Geannuleerd\"}\n  message label_Request_state_closed = \"Closed\"@{nl=\"Afgesloten\"}\n  message label_Request_actual = \"Actual spend\"@{nl=\"Werkelijke uitgaven\"}\n  message label_Receipt_source = \"Source reference\"@{nl=\"Bronreferentie\"}\n  message label_Receipt_accepted = \"Accepted quantity\"@{nl=\"Geaccepteerd aantal\"}\n  message label_Receipt_rejected = \"Rejected quantity\"@{nl=\"Afgekeurd aantal\"}\n  message label_Receipt_received = \"Received at\"@{nl=\"Ontvangen op\"}\n  preferences { location:Location?, supplier:Supplier?, state:Request.state? }\n  invariant preferences: row.location==null or can_work(actor,row.location)\n  export contract PayableEvidence { source:text, order:text, supplier:text, supplier_name:text, supplier_contact:email, location:text, invoice:text, amount:money, issued:date, evidence:text, revision:int }\n  ## PayableEvidenceV1.record must retain source/digest identity, acknowledge identical replay and reject conflicting evidence. This draft requires a configured real accounting binding; it never requests vendor payment.\n  export capability PayableEvidenceV1 version=1\n   record(value:PayableEvidence) -> OperationOutcome\n  role approver label=\"Purchase approver\"@{nl=\"Inkoopbeoordelaar\"}\n  Budget { name:text, locations:Location[] label=\"Locations\"@{nl=\"Locaties\"}, total:money, active:bool=true } label=\"Budget\"@{nl=\"Budget\"}\n  Request in Budget { location:Location, supplier:Supplier, requester:user server=actor label=\"Requester\"@{nl=\"Aanvrager\"}, reviewer:user label=\"Reviewer\"@{nl=\"Beoordelaar\"}, purpose:text label=\"Purpose\"@{nl=\"Doel\"}, category:text label=\"Category\"@{nl=\"Categorie\"}, required_by:date label=\"Required by\"@{nl=\"Nodig op\"}, amount:money, state:enum(draft,submitted,approved,rejected,cancelled,closed)=draft label={text=label_Request_state,values={draft=\"Draft\"@{nl=\"Concept\"},submitted=\"Submitted\"@{nl=\"Ingediend\"},approved=label_Request_state_approved,rejected=\"Rejected\"@{nl=\"Afgewezen\"},cancelled=label_Request_state_cancelled,closed=label_Request_state_closed}}, decision:text? label=\"Decision\"@{nl=\"Besluit\"}, actual:money? label=label_Request_actual, evidence:text? } label=\"Purchase request\"@{nl=\"Inkoopaanvraag\"}\n  Order in Request { reference:text unique, supplier_name:text label=\"Frozen supplier name\"@{nl=\"Vastgelegde leveranciersnaam\"}, supplier_contact:email label=\"Supplier email\"@{nl=\"E-mailadres leverancier\"}, location:Location, state:enum(ordered,part_received,received,cancelled,closed)=ordered label={text=label_Request_state,values={cancelled=label_Request_state_cancelled,closed=label_Request_state_closed,ordered=\"Ordered\"@{nl=\"Besteld\"},part_received=\"Part received\"@{nl=\"Gedeeltelijk ontvangen\"},received=\"Received\"@{nl=\"Ontvangen\"}}} } label=\"Supplier order\"@{nl=\"Leveranciersbestelling\"}\n  Line in Order { sku:text label=\"SKU\"@{nl=\"SKU\"}, unit:text label=\"Unit\"@{nl=\"Eenheid\"}, quantity:int min=1, unit_price:money label=\"Unit price\"@{nl=\"Eenheidsprijs\"} } label=\"Line item\"@{nl=\"Regel\"}\n  export Receipt in Line { source:text unique label=label_Receipt_source, accepted:int min=0 label=label_Receipt_accepted, rejected:int=0 min=0 label=label_Receipt_rejected, received:date label=label_Receipt_received, evidence:text, posting:enum(pending,confirmed,failed,unknown)=pending label={text=\"Stock posting outcome\"@{nl=\"Resultaat voorraadboeking\"},values={pending=\"Pending\"@{nl=\"In afwachting\"},confirmed=\"Confirmed\"@{nl=\"Bevestigd\"},failed=\"Failed\"@{nl=\"Mislukt\"},unknown=\"Unknown\"@{nl=\"Onbekend\"}}}, delivery:text? label=\"Delivery reference\"@{nl=\"Verzendingsreferentie\"}, revision:int=1, attempts:int=0 min=0 max=3 } label=\"Delivery receipt\"@{nl=\"Ontvangstregistratie\"}\n  Increase in Request { amount:money, reason:text, source:text unique } label=\"Authorization increase\"@{nl=\"Autorisatieverhoging\"}\n  Amendment in Line { quantity:int, reason:text, source:text unique } label=\"Order amendment\"@{nl=\"Bestelwijziging\"}\n  export Return in Receipt { source:text unique, quantity:int min=1, returned:date, evidence:text, revision:int=1, posting:Receipt.posting=pending, delivery:text?, attempts:int=0 min=0 max=3 } label=\"Supplier return\"@{nl=\"Leveranciersretour\"}\n  Payable in Order { source:text unique, invoice:text, amount:money, issued:date, evidence:text, revision:int=1, posting:Receipt.posting=pending, delivery:text?, attempts:int=0 min=0, reference:text? } label=\"Supplier invoice evidence\"@{nl=\"Leveranciersfactuurbewijs\"}\n  InvoiceDocument in Order { document:file label=\"Invoice document\"@{nl=\"Factuurdocument\"}, source:text unique label=label_Receipt_source, status:enum(draft,transcribed,accepted,rejected)=draft label={text=\"Extraction review\"@{nl=\"Extractiebeoordeling\"},values={draft=\"Draft\"@{nl=\"Concept\"},transcribed=\"Transcribed\"@{nl=\"Overgenomen\"},accepted=\"Accepted\"@{nl=\"Geaccepteerd\"},rejected=\"Rejected\"@{nl=\"Afgewezen\"}}}, invoice:text? label=\"Claimed invoice number\"@{nl=\"Geclaimd factuurnummer\"}, amount:money? label=\"Claimed amount\"@{nl=\"Geclaimd bedrag\"}, issued:date? label=\"Claimed issue date\"@{nl=\"Geclaimde uitgiftedatum\"}, decision:text? label=\"Decision\"@{nl=\"Besluit\"}, payable:Payable? label=\"Accepted payable\"@{nl=\"Geaccepteerde schuld\"} } label=\"Supplier invoice document\"@{nl=\"Leveranciersfactuurdocument\"}\n  Adjustment in Budget { request:Request, amount:money, reason:text, source:text unique label=label_Receipt_source } label=\"Spending adjustment\"@{nl=\"Uitgavenaanpassing\"}\n  derive Budget.committed:money = sum(row.Request as request where request.state==approved select request.authorized,row.total.currency) label=\"Committed amount\"@{nl=\"Vastgelegd bedrag\"}\n  derive Budget.spent:money = sum(row.Request as request where request.state==closed select (request.actual??money(0,row.total.currency)),row.total.currency)+sum(row.Adjustment as adjustment select adjustment.amount,row.total.currency) label=label_Request_actual\n  derive Budget.remaining:money = row.total-row.committed-row.spent label=\"Remaining\"@{nl=\"Resterend\"}\n  derive Request.authorized:money = row.amount+sum(row.Increase as increase select increase.amount,row.amount.currency) label=\"Authorized amount\"@{nl=\"Geautoriseerd bedrag\"}\n  derive Line.ordered:int = row.quantity+sum(row.Amendment as amendment select amendment.quantity) label=\"Ordered quantity\"@{nl=\"Besteld aantal\"}\n  derive Receipt.returned:int = sum(row.Return as returned select returned.quantity) label=\"Returned quantity\"@{nl=\"Geretourneerd aantal\"}\n  derive Line.accepted:int = sum(row.Receipt as receipt select receipt.accepted) label=label_Receipt_accepted\n  policy Budget read=budget_manager or approver where=any(row.locations as location,can_work(actor,location))\n  policy Budget read=members where=row.active and any(row.locations as location,can_work(actor,location)) fields=name,active\n  policy Request read=members where=row.requester==actor\n  policy Request read=approver where=row.reviewer==actor and can_work(actor,row.location) and row.state!=draft\n  policy Request read=buyer or budget_manager where=can_work(actor,row.location)\n  policy Order read=buyer or budget_manager where=can_work(actor,row.location)\n  policy Line read=buyer or budget_manager where=can_work(actor,row.parent.location)\n  policy Receipt read=buyer or budget_manager where=can_work(actor,row.parent.parent.location)\n  policy Increase read=buyer or budget_manager where=can_work(actor,row.parent.location)\n  policy Amendment read=buyer or budget_manager where=can_work(actor,row.parent.parent.location)\n  policy Return read=buyer or budget_manager where=can_work(actor,row.parent.parent.parent.location)\n  policy Payable read=buyer or budget_manager where=can_work(actor,row.parent.location)\n  policy InvoiceDocument read=buyer or budget_manager where=can_work(actor,row.parent.location)\n  policy Adjustment read=budget_manager where=any(row.parent.locations as location,can_work(actor,location))\n  invariant Budget: row.total.minor>=0 and row.remaining.minor>=0\n  invariant Request: row.amount.minor>0 and row.amount.currency==row.parent.total.currency and row.location in row.parent.locations and row.location in row.supplier.locations\n  invariant Order: sum(row.Line as line select line.unit_price*line.ordered,row.parent.amount.currency)<=row.parent.authorized\n  invariant Adjustment: row.request.parent==row.parent and row.request.state==closed and (row.request.actual??money(0,row.amount.currency))+sum(row.parent.Adjustment as adjustment where adjustment.request==row.request select adjustment.amount,row.amount.currency)>=money(0,row.amount.currency)\n  invariant Line: row.unit_price.currency==row.parent.parent.amount.currency and row.unit_price.minor>=0 and row.accepted<=row.ordered\n  invariant Receipt: row.accepted+row.rejected>0 and trim(row.evidence)!=\"\" and row.returned<=row.accepted\n  invariant Receipt: not any(Receipt as other,other!=row and other.source==row.source) and not any(Return as returned,returned.source==row.source)\n  invariant Return: not any(Return as other,other!=row and other.source==row.source) and not any(Receipt as receipt,receipt.source==row.source) and trim(row.evidence)!=\"\"\n  invariant Increase: row.amount.currency==row.parent.amount.currency and row.amount.minor>0 and trim(row.reason)!=\"\"\n  invariant Amendment: row.quantity>0 and trim(row.reason)!=\"\"\n  invariant Payable: row.amount.currency==row.parent.parent.amount.currency and row.amount.minor>=0 and trim(row.invoice)!=\"\" and trim(row.evidence)!=\"\"\n  invariant Payable: not any(Payable as other,other!=row and other.source==row.source)\n  unique Payable fields=invoice\n  invariant InvoiceDocument: row.status==draft or (row.invoice!=null and row.amount!=null and row.issued!=null)\n  invariant InvoiceDocument: (row.amount??row.parent.parent.amount).currency==row.parent.parent.amount.currency\n  invariant InvoiceDocument: row.status!=accepted or (row.payable!=null and row.payable.parent==row.parent and row.payable.source==row.source)\n  invariant InvoiceDocument: not any(InvoiceDocument as other,other!=row and other.source==row.source)\n  lock Request fields=location,supplier,requester,reviewer,purpose,category,required_by,amount when=row.state!=draft\n  lock Request fields=state,actual,evidence,decision when=row.state==closed\n  lock Order fields=reference,supplier_name,supplier_contact,location\n  lock Line fields=sku,unit,quantity,unit_price when=count(row.Receipt)>0\n  lock Receipt fields=source,accepted,rejected,received,evidence,revision\n  lock Increase fields=amount,reason,source\n  lock Amendment fields=quantity,reason,source\n  lock Return fields=source,quantity,returned,evidence,revision\n  lock Payable fields=source,invoice,amount,issued,evidence,revision\n  lock InvoiceDocument fields=document,source\n  lock InvoiceDocument fields=status,invoice,amount,issued,decision,payable when=row.status==accepted or row.status==rejected\n  lock Adjustment fields=request,amount,reason,source\n  fixture vendor=Supplier {name=\"Supplies\",contact=\"vendor@example.test\",locations=[test_site]}\n  fixture budget=Budget {name=\"Furniture\",locations=[test_site],total=money(100,\"EUR\")}\n  fixture submission=Request {parent=budget,location=test_site,supplier=vendor,requester=other,reviewer=self,purpose=\"Chairs\",category=\"Equipment\",required_by=date(\"2099-01-01\"),amount=money(60,\"EUR\"),state=submitted}\n  fixture purchase_order=Order {parent=submission,reference=\"PO-1\",supplier_name=\"Supplies\",supplier_contact=\"vendor@example.test\",location=test_site}\n  fixture purchase_line=Line {parent=purchase_order,sku=\"boxes\",unit=\"box\",quantity=6,unit_price=money(10,\"EUR\")}\n  fixture goods_receipt=Receipt {parent=purchase_line,source=\"delivery-A\",accepted=2,received=date(\"2099-01-02\"),evidence=\"Delivery A\",posting=confirmed}\n  fixture invoice_pdf=file {}\n  fixture invoice_doc=InvoiceDocument {parent=purchase_order,document=invoice_pdf,source=\"invoice-doc-1\",status=transcribed,invoice=\"SUP-001\",amount=money(20,\"EUR\"),issued=date(\"2099-01-03\")}\n  fixture filed_payable=Payable {parent=purchase_order,source=\"invoice-doc-8\",invoice=\"SUP-008\",amount=money(10,\"EUR\"),issued=date(\"2099-01-03\"),evidence=\"Filed supplier invoice\"}\n  fixture accepted_doc=InvoiceDocument {parent=purchase_order,document=invoice_pdf,source=\"invoice-doc-8\",status=accepted,invoice=\"SUP-008\",amount=money(10,\"EUR\"),issued=date(\"2099-01-03\"),payable=filed_payable}\n  fixture extra_authorization=Increase {parent=submission,amount=money(20,\"EUR\"),reason=\"More chairs\",source=\"authorization-2\"}\n When\n  crud Budget by=budget_manager fields=name,total,active create_fields=name,locations,total when=all(row.locations as location,can_work(actor,location)) delete=none\n  crud Request by=members fields=location,supplier,reviewer,purpose,category,required_by,amount when=row.requester==actor and row.state==draft and can_work(actor,row.location) delete=none\n  crud Line by=buyer fields=sku,unit,quantity,unit_price when=can_work(actor,row.parent.location) and row.parent.state==ordered and row.parent.parent.state==approved and count(row.Receipt)==0 delete=none\n  # Submit frozen purchasing terms for one eligible reviewer. @{nl=\"Dien vastgelegde inkoopvoorwaarden in voor één bevoegde beoordelaar.\"}\n  scenario submit(request:Request) by=members\n   require request.requester==actor and request.state==draft and request.supplier.active and request.location in request.supplier.locations and can_work(actor,request.location) and request.reviewer!=actor and can_work(request.reviewer,request.location)\n   do set request {state=submitted}\n  # Reserve the approved amount atomically without self-review or budget overspend. @{nl=\"Reserveer het goedgekeurde bedrag atomair, zonder zelfbeoordeling of budgetoverschrijding.\"}\n  scenario decide(request:Request,approve:bool label=label_Request_state_approved,reason:text) by=approver label=\"Record decision\"@{nl=\"Besluit vastleggen\"}\n   require request.reviewer==actor and request.requester!=actor and request.state==submitted and can_work(actor,request.location) and trim(reason)!=\"\"\n   do\n    if approve\n     require request.parent.active and request.amount<=request.parent.remaining\n     set request {state=approved,decision=reason}\n    else\n     set request {state=rejected,decision=reason}\n   examples seed=[test_worker] request=submission approve=true reason=\"Within budget\"\n    as,request.amount,request.requester -> request.state,budget.remaining\n    approver,money(60,\"EUR\"),other -> approved,money(40,\"EUR\")\n    approver,money(101,\"EUR\"),other -> error(rule_failed)\n    approver,money(60,\"EUR\"),self -> error(rule_failed)\n    members,money(60,\"EUR\"),other -> error(forbidden)\n  # Issue one supplier order against an existing committed authorization. @{nl=\"Plaats één leveranciersbestelling tegen een bestaande vastgelegde autorisatie.\"}\n  scenario order(request:Request,reference:text) by=buyer label=\"Place supplier order\"@{nl=\"Leveranciersbestelling plaatsen\"}\n   require can_work(actor,request.location) and request.state==approved and request.supplier.active and count(request.Order)==0\n   do create Order {parent=request,reference,supplier_name=request.supplier.name,supplier_contact=request.supplier.contact,location=request.location} as order\n  # Authorize an affordable increase while preserving the original approval. @{nl=\"Autoriseer een betaalbare verhoging en behoud de oorspronkelijke goedkeuring.\"}\n  scenario increase(request:Request,amount:money,reason:text) by=budget_manager\n   require request.state==approved and request.requester!=actor and can_work(actor,request.location) and request.parent.active and amount.currency==request.amount.currency and amount.minor>0 and amount<=request.parent.remaining and trim(reason)!=\"\"\n   do create Increase {parent=request,amount,reason,source=operation.id} as increase\n   examples seed=[test_worker] request=submission reason=\"Extra chairs\"\n    as,request.state,amount -> request.amount,request.authorized,budget.remaining\n    budget_manager,approved,money(20,\"EUR\") -> money(60,\"EUR\"),money(80,\"EUR\"),money(20,\"EUR\")\n    budget_manager,approved,money(41,\"EUR\") -> error(rule_failed)\n    budget_manager,approved,money(20,\"USD\") -> error(rule_failed)\n    members,approved,money(20,\"EUR\") -> error(forbidden)\n  # Append additional ordered units within the committed authorization. @{nl=\"Voeg bestelde eenheden toe binnen de vastgelegde autorisatie.\"}\n  scenario amend(line:Line,quantity:int,reason:text) by=buyer\n   require can_work(actor,line.parent.location) and line.parent.parent.state==approved and line.parent.state in [ordered,part_received,received] and quantity>0 and trim(reason)!=\"\"\n   do\n    create Amendment {parent=line,quantity,reason,source=operation.id} as amendment\n    set line.parent {state=part_received}\n   examples seed=[test_worker,goods_receipt,extra_authorization] line=purchase_line reason=\"More boxes\"\n    as,line.parent.parent.state,quantity -> line.quantity,line.ordered,line.accepted\n    buyer,approved,2 -> 6,8,2\n    buyer,approved,3 -> error(rule_failed)\n    buyer,closed,1 -> error(rule_failed)\n    members,approved,1 -> error(forbidden)\n  # Accept a physical delivery once and replay its saved evidence without receiving it again. @{nl=\"Accepteer een fysieke levering één keer en herhaal het opgeslagen bewijs zonder opnieuw te ontvangen.\"}\n  scenario receive(line:Line,source:text label=label_Receipt_source,accepted:int label=label_Receipt_accepted,rejected:int label=label_Receipt_rejected,received:date label=label_Receipt_received,evidence:text) -> Receipt by=buyer label=\"Record receipt\"@{nl=\"Ontvangst registreren\"}\n   require can_work(actor,line.parent.location) and trim(source)!=\"\" and accepted>=0 and rejected>=0 and accepted+rejected>0 and trim(evidence)!=\"\"\n   do\n    let previous=first(Receipt as receipt where receipt.source==source order=receipt.id)\n    if previous!=null\n     require previous.parent==line and previous.accepted==accepted and previous.rejected==rejected and previous.received==received and previous.evidence==evidence\n     return previous\n    require line.parent.parent.state==approved and line.parent.state in [ordered,part_received] and accepted<=line.ordered-line.accepted\n    create Receipt {parent=line,source,accepted,rejected,received,evidence} as receipt\n    if accepted>0\n     send Stock.post {value={source,order=line.parent.reference,sku=line.sku,unit=line.unit,location=line.parent.location.id,quantity=accepted,revision=receipt.revision,reversal=null}} as delivery\n     set receipt {delivery=delivery.id,attempts=1}\n    else\n     set receipt {posting=confirmed}\n    set line.parent {state=part_received}\n    if all(line.parent.Line as item,item.accepted==item.ordered)\n     set line.parent {state=received}\n    return receipt\n   examples seed=[test_worker,goods_receipt] line=purchase_line rejected=0 received=date(\"2099-01-02\")\n    as,line.parent.parent.state,line.parent.state,source,accepted,evidence -> count(Receipt),line.accepted,line.parent.state,result.posting\n    buyer,approved,part_received,\"delivery-B\",4,\"Delivery B\" -> 2,6,received,pending\n    buyer,closed,cancelled,\"delivery-A\",2,\"Delivery A\" -> 1,2,cancelled,confirmed\n    buyer,approved,part_received,\"delivery-A\",2,\"Changed proof\" -> error(rule_failed)\n    buyer,approved,part_received,\"delivery-B\",5,\"Delivery B\" -> error(rule_failed)\n    members,approved,part_received,\"delivery-B\",1,\"Delivery B\" -> error(forbidden)\n  # Record a linked supplier return and wait for its usable-stock reversal. @{nl=\"Registreer een gekoppelde leveranciersretour en wacht op de terugboeking van bruikbare voorraad.\"}\n  scenario return_goods(receipt:Receipt,source:text,quantity:int,returned:date,evidence:text) -> Return by=buyer label=\"Return goods\"@{nl=\"Goederen retourneren\"}\n   require can_work(actor,receipt.parent.parent.location) and quantity>0 and trim(source)!=\"\" and trim(evidence)!=\"\"\n   do\n    let previous=first(Return as item where item.source==source order=item.id)\n    if previous!=null\n     require previous.parent==receipt and previous.quantity==quantity and previous.returned==returned and previous.evidence==evidence\n     return previous\n    require receipt.posting==confirmed and quantity<=receipt.accepted-receipt.returned\n    create Return {parent=receipt,source,quantity,returned,evidence} as returned_goods\n    send Stock.post {value={source,order=receipt.parent.parent.reference,sku=receipt.parent.sku,unit=receipt.parent.unit,location=receipt.parent.parent.location.id,quantity=-quantity,revision=returned_goods.revision,reversal=receipt.source}} as delivery\n    set returned_goods {delivery=delivery.id,attempts=1}\n    return returned_goods\n   examples seed=[test_worker,goods_receipt] receipt=goods_receipt source=\"return-A\" returned=date(\"2099-01-03\") evidence=\"Supplier return\"\n    as,receipt.posting,quantity -> count(Return),receipt.accepted,receipt.returned,result.posting\n    buyer,confirmed,1 -> 1,2,1,pending\n    buyer,confirmed,3 -> error(rule_failed)\n    buyer,pending,1 -> error(rule_failed)\n    members,confirmed,1 -> error(forbidden)\n  # Close evidenced actual spend; unused commitment returns once. @{nl=\"Sluit bewezen werkelijke uitgaven af; ongebruikte toezegging keert één keer terug.\"}\n  scenario close(request:Request,actual:money label=label_Request_actual,evidence:text) by=budget_manager label=\"Close spending\"@{nl=\"Uitgaven afsluiten\"}\n   require request.state==approved and can_work(actor,request.location) and actual.currency==request.amount.currency and actual.minor>=0 and actual<=request.authorized and trim(evidence)!=\"\"\n   do\n    set request {state=closed,actual,evidence}\n    for order in request.Order limit=100\n     set order {state=closed}\n  # Cancel the outstanding order while retaining received goods and evidenced spending. @{nl=\"Annuleer het openstaande deel en behoud ontvangen goederen en bewezen uitgaven.\"}\n  scenario cancel(request:Request,actual:money,evidence:text,reason:text) by=budget_manager\n   require request.state==approved and can_work(actor,request.location) and actual.currency==request.amount.currency and actual.minor>=0 and actual<=request.authorized and trim(evidence)!=\"\" and trim(reason)!=\"\"\n   do\n    set request {state=closed,actual,evidence,decision=reason}\n    for order in request.Order limit=100\n     set order {state=cancelled}\n   examples seed=[test_worker,goods_receipt] request=submission evidence=\"Accepted goods cost\" reason=\"Cancel outstanding boxes\"\n    as,request.state,actual -> request.amount,request.actual,budget.committed,budget.spent,budget.remaining,purchase_order.state,goods_receipt.accepted\n    budget_manager,approved,money(20,\"EUR\") -> money(60,\"EUR\"),money(20,\"EUR\"),money(0,\"EUR\"),money(20,\"EUR\"),money(80,\"EUR\"),cancelled,2\n    budget_manager,approved,money(61,\"EUR\") -> error(rule_failed)\n    budget_manager,approved,money(20,\"USD\") -> error(rule_failed)\n    budget_manager,closed,money(20,\"EUR\") -> error(rule_failed)\n    members,approved,money(20,\"EUR\") -> error(forbidden)\n  # Freeze supplier invoice evidence separately from customer invoices and payments. @{nl=\"Leg leveranciersfactuurbewijs vast, gescheiden van klantfacturen en betalingen.\"}\n  scenario record_payable(order:Order,source:text,invoice:text,amount:money,issued:date,evidence:text) -> Payable by=budget_manager\n   require can_work(actor,order.location) and order.parent.state==closed and amount.currency==order.parent.amount.currency and amount.minor>=0 and trim(source)!=\"\" and trim(invoice)!=\"\" and trim(evidence)!=\"\"\n   do\n    let previous=first(order.Payable as payable where payable.invoice==invoice order=payable.id)\n    if previous!=null\n     require previous.source==source and previous.amount==amount and previous.issued==issued and previous.evidence==evidence\n     return previous\n    require sum(order.Payable as payable select payable.amount,amount.currency)+amount<=(order.parent.actual??money(0,amount.currency))+sum(order.parent.parent.Adjustment as adjustment where adjustment.request==order.parent select adjustment.amount,amount.currency)\n    create Payable {parent=order,source,invoice,amount,issued,evidence} as payable\n    return payable\n   examples seed=[test_worker,goods_receipt] order=purchase_order source=\"payable-1\" invoice=\"SUP-001\" issued=date(\"2099-01-03\") evidence=\"Supplier invoice\"\n    as,order.parent.state,order.parent.actual,amount -> count(Payable),result.invoice,result.amount\n    budget_manager,closed,money(20,\"EUR\"),money(20,\"EUR\") -> 1,\"SUP-001\",money(20,\"EUR\")\n    budget_manager,closed,money(20,\"EUR\"),money(21,\"EUR\") -> error(rule_failed)\n    budget_manager,closed,money(20,\"EUR\"),money(20,\"USD\") -> error(rule_failed)\n    budget_manager,approved,money(20,\"EUR\"),money(20,\"EUR\") -> error(rule_failed)\n  # Intake one supplier invoice document under its order; a duplicate source fails instead of silently overwriting. @{nl=\"Neem één leveranciersfactuurdocument in onder de bestelling; een dubbele bron faalt in plaats van stil te overschrijven.\"}\n  scenario intake_invoice(order:Order,document:file,source:text label=label_Receipt_source) -> InvoiceDocument by=buyer label=\"Intake invoice document\"@{nl=\"Factuurdocument innemen\"}\n   require can_work(actor,order.location) and order.parent.state in [approved,closed] and trim(source)!=\"\"\n   do\n    require not any(InvoiceDocument as item,item.source==trim(source))\n    create InvoiceDocument {parent=order,document,source=trim(source)} as invoice_document\n    return invoice_document\n   examples seed=[test_worker,invoice_pdf] order=purchase_order document=invoice_pdf\n    as,order.parent.state,source -> count(InvoiceDocument),result.status,result.source\n    buyer,approved,\"invoice-doc-2\" -> 1,draft,\"invoice-doc-2\"\n    buyer,closed,\"invoice-doc-2\" -> 1,draft,\"invoice-doc-2\"\n    buyer,submitted,\"invoice-doc-2\" -> error(rule_failed)\n    buyer,approved,\" \" -> error(rule_failed)\n    members,approved,\"invoice-doc-2\" -> error(forbidden)\n   examples seed=[test_worker,invoice_pdf,invoice_doc] order=purchase_order document=invoice_pdf source=\"invoice-doc-1\"\n    as -> count(InvoiceDocument)\n    buyer -> error(rule_failed)\n  # Transcribe or correct the claimed invoice totals from the frozen document pages. @{nl=\"Neem de geclaimde factuurtotalen over van de vastgelegde documentpagina's of corrigeer ze.\"}\n  scenario transcribe_claims(invoice_document:InvoiceDocument,invoice:text,amount:money,issued:date) by=buyer label=\"Transcribe invoice claims\"@{nl=\"Factuurgegevens overnemen\"}\n   require can_work(actor,invoice_document.parent.location) and invoice_document.status in [draft,transcribed] and trim(invoice)!=\"\" and amount.currency==invoice_document.parent.parent.amount.currency and amount.minor>=0\n   do set invoice_document {invoice=trim(invoice),amount,issued,status=transcribed}\n   examples seed=[test_worker,invoice_doc] invoice_document=invoice_doc issued=date(\"2099-01-03\")\n    as,invoice_document.status,invoice,amount -> invoice_document.status,invoice_document.invoice,invoice_document.amount,count(InvoiceDocument)\n    buyer,draft,\"SUP-002\",money(20,\"EUR\") -> transcribed,\"SUP-002\",money(20,\"EUR\"),1\n    buyer,transcribed,\"SUP-002\",money(18,\"EUR\") -> transcribed,\"SUP-002\",money(18,\"EUR\"),1\n    buyer,draft,\"SUP-002\",money(20,\"USD\") -> error(rule_failed)\n    buyer,draft,\" \",money(20,\"EUR\") -> error(rule_failed)\n    buyer,rejected,\"SUP-002\",money(20,\"EUR\") -> error(rule_failed)\n    members,draft,\"SUP-002\",money(20,\"EUR\") -> error(forbidden)\n   examples seed=[test_worker,accepted_doc] invoice_document=accepted_doc invoice=\"SUP-008\" amount=money(10,\"EUR\") issued=date(\"2099-01-03\")\n    as -> invoice_document.status\n    buyer -> error(rule_failed)\n  # Accept the reviewed claims as payable evidence against closed spending. @{nl=\"Accepteer de beoordeelde claims als schuldbewijs tegen afgesloten uitgaven.\"}\n  scenario accept_invoice(invoice_document:InvoiceDocument,invoice:text,amount:money,issued:date,evidence:text) -> Payable by=budget_manager label=\"Accept invoice document\"@{nl=\"Factuurdocument accepteren\"}\n   require can_work(actor,invoice_document.parent.location) and invoice_document.status==transcribed and invoice_document.parent.parent.state==closed and trim(invoice)!=\"\" and trim(evidence)!=\"\"\n   do\n    require invoice_document.invoice!=null and invoice_document.invoice==invoice and invoice_document.amount!=null and invoice_document.amount==amount and invoice_document.issued!=null and invoice_document.issued==issued\n    require sum(invoice_document.parent.Payable as payable select payable.amount,amount.currency)+amount<=(invoice_document.parent.parent.actual??money(0,amount.currency))+sum(invoice_document.parent.parent.parent.Adjustment as adjustment where adjustment.request==invoice_document.parent.parent select adjustment.amount,amount.currency)\n    create Payable {parent=invoice_document.parent,source=invoice_document.source,invoice,amount,issued,evidence} as payable\n    set invoice_document {status=accepted,payable}\n    return payable\n   examples seed=[test_worker,invoice_doc] invoice_document=invoice_doc evidence=\"Filed supplier invoice\"\n    as,invoice_document.status,invoice_document.parent.parent.state,invoice_document.parent.parent.actual,invoice,amount,issued,request.invoice_document.version -> count(Payable),result.invoice,invoice_document.status,invoice_document.payable==result\n    budget_manager,transcribed,closed,money(20,\"EUR\"),\"SUP-001\",money(20,\"EUR\"),date(\"2099-01-03\"),1 -> 1,\"SUP-001\",accepted,true\n    budget_manager,transcribed,approved,money(20,\"EUR\"),\"SUP-001\",money(20,\"EUR\"),date(\"2099-01-03\"),1 -> error(rule_failed)\n    budget_manager,transcribed,closed,money(20,\"EUR\"),\"SUP-001\",money(19,\"EUR\"),date(\"2099-01-03\"),1 -> error(rule_failed)\n    budget_manager,transcribed,closed,money(20,\"EUR\"),\"SUP-001\",money(20,\"EUR\"),date(\"2099-01-04\"),1 -> error(rule_failed)\n    budget_manager,transcribed,closed,money(20,\"EUR\"),\"SUP-001\",money(21,\"EUR\"),date(\"2099-01-03\"),1 -> error(rule_failed)\n    budget_manager,transcribed,closed,money(20,\"EUR\"),\"SUP-001\",money(20,\"USD\"),date(\"2099-01-03\"),1 -> error(rule_failed)\n    budget_manager,draft,closed,money(20,\"EUR\"),\"SUP-001\",money(20,\"EUR\"),date(\"2099-01-03\"),1 -> error(rule_failed)\n    budget_manager,transcribed,closed,money(20,\"EUR\"),\"SUP-001\",money(20,\"EUR\"),date(\"2099-01-03\"),2 -> error(conflict)\n    members,transcribed,closed,money(20,\"EUR\"),\"SUP-001\",money(20,\"EUR\"),date(\"2099-01-03\"),1 -> error(forbidden)\n   examples seed=[test_worker,accepted_doc] invoice_document=accepted_doc invoice=\"SUP-008\" amount=money(10,\"EUR\") issued=date(\"2099-01-03\") evidence=\"Filed supplier invoice\"\n    as -> count(Payable)\n    budget_manager -> error(rule_failed)\n  # Reject transcribed claims with a reason while retaining the frozen document. @{nl=\"Wijs overgenomen claims af met een reden en behoud het vastgelegde document.\"}\n  scenario reject_invoice(invoice_document:InvoiceDocument,reason:text) by=budget_manager label=\"Reject invoice document\"@{nl=\"Factuurdocument afwijzen\"}\n   require can_work(actor,invoice_document.parent.location) and invoice_document.status==transcribed and trim(reason)!=\"\"\n   do set invoice_document {status=rejected,decision=trim(reason)}\n   examples seed=[test_worker,invoice_doc] invoice_document=invoice_doc\n    as,invoice_document.status,reason -> invoice_document.status,invoice_document.decision,count(Payable)\n    budget_manager,transcribed,\"Totals do not match the order\" -> rejected,\"Totals do not match the order\",0\n    budget_manager,transcribed,\" \" -> error(rule_failed)\n    budget_manager,draft,\"Totals do not match the order\" -> error(rule_failed)\n    members,transcribed,\"Totals do not match the order\" -> error(forbidden)\n   examples seed=[test_worker,accepted_doc] invoice_document=accepted_doc reason=\"Late objection\"\n    as -> invoice_document.status\n    budget_manager -> error(rule_failed)\n  # Export the frozen payable evidence to configured accounting without initiating payment. @{nl=\"Exporteer het vastgelegde factuurbewijs naar ingestelde boekhouding zonder betaling te starten.\"}\n  scenario export_payable(payable:Payable) by=budget_manager\n   require can_work(actor,payable.parent.location) and payable.posting!=confirmed\n   do\n    send Accounting.record {value={source=payable.source,order=payable.parent.reference,supplier=payable.parent.parent.supplier.id,supplier_name=payable.parent.supplier_name,supplier_contact=payable.parent.supplier_contact,location=payable.parent.location.id,invoice=payable.invoice,amount=payable.amount,issued=payable.issued,evidence=payable.evidence,revision=payable.revision}} as delivery\n    set payable {delivery=delivery.id,posting=pending,attempts=payable.attempts+1}\n  # Record an attributed spend adjustment with the same affordability constraint. @{nl=\"Registreer een herleidbare uitgavenaanpassing met dezelfde betaalbaarheidsvoorwaarde.\"}\n  scenario adjust(request:Request,amount:money,reason:text) by=budget_manager label=\"Adjust spending\"@{nl=\"Uitgaven aanpassen\"}\n   require request.state==closed and can_work(actor,request.location) and amount.currency==request.parent.total.currency and trim(reason)!=\"\"\n   do create Adjustment {parent=request.parent,request,amount,reason,source=operation.id} as adjustment\n  # Requeue the original receipt after resolving an exhausted stock delivery. @{nl=\"Zet de oorspronkelijke ontvangst opnieuw klaar na herstel van een uitgeputte voorraadlevering.\"}\n  scenario retry_stock(receipt:Receipt) by=buyer\n   require can_work(actor,receipt.parent.parent.location) and receipt.accepted>0 and receipt.posting!=confirmed and receipt.attempts==3\n   do set receipt {attempts=0,posting=pending}\n  # Requeue a linked return without changing its source, quantity or evidence. @{nl=\"Zet een gekoppelde retour opnieuw klaar zonder bron, aantal of bewijs te wijzigen.\"}\n  scenario retry_return(returned:Return) by=buyer\n   require can_work(actor,returned.parent.parent.parent.location) and returned.posting!=confirmed and returned.attempts==3\n   do set returned {attempts=0,posting=pending}\n  # Retry one receipt and one return at a time with stable facts and bounded attempts. @{nl=\"Herhaal telkens één ontvangst en één retour met vaste gegevens en begrensde pogingen.\"}\n  scenario reconcile_stock on=every(5m)\n   do\n    let receipt=first(Receipt as item where item.accepted>0 and item.posting!=confirmed and item.attempts<3 order=item.created)\n    if receipt!=null\n     send Stock.post {value={source=receipt.source,order=receipt.parent.parent.reference,sku=receipt.parent.sku,unit=receipt.parent.unit,location=receipt.parent.parent.location.id,quantity=receipt.accepted,revision=receipt.revision,reversal=null}} as delivery\n     set receipt {delivery=delivery.id,posting=pending,attempts=receipt.attempts+1}\n    let returned=first(Return as item where item.posting!=confirmed and item.attempts<3 order=item.created)\n    if returned!=null\n     send Stock.post {value={source=returned.source,order=returned.parent.parent.parent.reference,sku=returned.parent.parent.sku,unit=returned.parent.parent.unit,location=returned.parent.parent.parent.location.id,quantity=-returned.quantity,revision=returned.revision,reversal=returned.parent.source}} as delivery\n     set returned {delivery=delivery.id,posting=pending,attempts=returned.attempts+1}\n  scenario stock_result on=Stock.post.completed\n   do\n    for receipt in Receipt as item where item.delivery==event.delivery_id and item.posting!=confirmed limit=1\n     if event.status==succeeded and event.result!=null and event.result.source==receipt.source and event.result.revision==receipt.revision and event.result.state==confirmed and event.result.reference!=null\n      set receipt {posting=confirmed}\n     else\n      if event.status==succeeded and event.result!=null and event.result.source==receipt.source and event.result.revision==receipt.revision and event.result.state==pending\n       set receipt {posting=pending}\n      else\n       if event.status==failed\n        set receipt {posting=failed}\n       else\n        set receipt {posting=unknown}\n    for returned in Return as item where item.delivery==event.delivery_id and item.posting!=confirmed limit=1\n     if event.status==succeeded and event.result!=null and event.result.source==returned.source and event.result.revision==returned.revision and event.result.state==confirmed and event.result.reference!=null\n      set returned {posting=confirmed}\n     else\n      if event.status==succeeded and event.result!=null and event.result.source==returned.source and event.result.revision==returned.revision and event.result.state==pending\n       set returned {posting=pending}\n      else\n       if event.status==failed\n        set returned {posting=failed}\n       else\n        set returned {posting=unknown}\n  scenario stock_changed on=Stock.changed\n   do\n    for receipt in Receipt as item where item.source==event.value.source and item.revision==event.value.revision and item.posting!=confirmed limit=1\n     if event.value.state==confirmed and event.value.reference!=null\n      set receipt {posting=confirmed}\n     else\n      if event.value.state==failed\n       set receipt {posting=failed}\n    for returned in Return as item where item.source==event.value.source and item.revision==event.value.revision and item.posting!=confirmed limit=1\n     if event.value.state==confirmed and event.value.reference!=null\n      set returned {posting=confirmed}\n     else\n      if event.value.state==failed\n       set returned {posting=failed}\n  scenario payable_result on=Accounting.record.completed\n   do\n    for payable in Payable as item where item.delivery==event.delivery_id and item.posting!=confirmed limit=1\n     if event.status==succeeded and event.result!=null and event.result.source==payable.source and event.result.revision==payable.revision and event.result.state==confirmed and event.result.reference!=null\n      set payable {posting=confirmed,reference=event.result.reference}\n     else\n      if event.status==failed\n       set payable {posting=failed}\n      else\n       set payable {posting=unknown}\n Then\n  # Submit and follow your own purchase authorization. @{nl=\"Dien je eigen inkoopautorisatie in en volg deze.\"}\n  page /purchasing/mine title=\"My requests\"@{nl=\"Mijn aanvragen\"}\n   require members\n   breadcrumbs\n   card \"Own requests\"@{nl=\"Eigen aanvragen\"}\n    form Request.create\n     fieldset \"Purchase request\"@{nl=\"Inkoopaanvraag\"}\n      textarea purpose\n      input category\n      input amount\n      calendar required_by\n    list Request as request where request.requester==actor order=request.required_by filter=state,location,supplier defaults={state=preferences.state,location=preferences.location,supplier=preferences.supplier} display=split empty=\"No requests yet.\"@{nl=\"Nog geen aanvragen.\"}\n     pagination\n     badge row.state\n     edit\n     action submit\n     text row.purpose,row.amount,row.required_by,row.state,row.decision,row.actual,row.evidence\n\n  # Maintain supplier records and view affordable commitments and actual spending. @{nl=\"Beheer leveranciers en bekijk betaalbare toezeggingen en werkelijke uitgaven.\"}\n  page /purchasing title=page_purchasing_title\n   require buyer or budget_manager or approver\n   breadcrumbs\n   card \"Supplier directory\"@{nl=\"Leveranciersregister\"}\n    form Supplier.create\n    table Supplier columns=name,contact,locations,active empty=\"No suppliers recorded.\"@{nl=\"Geen leveranciers vastgelegd.\"}\n     pagination\n     edit\n   card \"Review and order queue\"@{nl=\"Beoordelings- en bestelwachtrij\"}\n    list Request filter=state,location,supplier defaults={state=preferences.state,location=preferences.location,supplier=preferences.supplier} display=split empty=\"No requests match these filters.\"@{nl=\"Geen aanvragen voor deze filters.\"}\n     pagination\n     text row.purpose,row.amount,row.authorized,row.required_by,row.state,row.decision\n     badge row.state\n     button opens=auth_detail\n     drawer \"Purchase authorization\"@{nl=\"Inkoopautorisatie\"} id=auth_detail\n      slot content\n       edit\n       action submit\n       button opens=decide_detail\n       modal \"Record decision\"@{nl=\"Besluit vastleggen\"} id=decide_detail\n        slot content\n         form decide arguments={request=row} display=inline\n          checkbox approve\n          textarea reason\n       button opens=order_detail\n       modal \"Place supplier order\"@{nl=\"Leveranciersbestelling plaatsen\"} id=order_detail\n        slot content\n         form order arguments={request=row} display=inline\n          input reference\n       button opens=increase_detail\n       modal \"Authorize increase\"@{nl=\"Verhoging autoriseren\"} id=increase_detail\n        slot content\n         form increase arguments={request=row} display=inline\n          input amount\n          textarea reason\n       button opens=close_detail\n       modal \"Close spending\"@{nl=\"Uitgaven afsluiten\"} id=close_detail\n        slot content\n         form close arguments={request=row} display=inline\n          input actual\n          textarea evidence\n       button opens=cancel_detail\n       modal \"Cancel request\"@{nl=\"Aanvraag annuleren\"} id=cancel_detail\n        slot content\n         form cancel arguments={request=row} display=inline\n          input actual\n          textarea evidence\n          textarea reason\n       button opens=adjust_detail\n       modal \"Adjust spending\"@{nl=\"Uitgaven aanpassen\"} id=adjust_detail\n        slot content\n         form adjust arguments={request=row} display=inline\n          input amount\n          textarea reason\n       list row.Order empty=\"No orders placed.\"@{nl=\"Geen bestellingen geplaatst.\"}\n        pagination\n        badge row.state\n        form Line.create\n        button opens=payable_detail\n        modal \"Record payable\"@{nl=\"Te betalen bedrag registreren\"} id=payable_detail\n         slot content\n          form record_payable arguments={order=row} display=inline\n           fieldset \"Payable evidence\"@{nl=\"Bewijs te betalen bedrag\"}\n            input source\n            input invoice\n            input amount\n            calendar issued\n            textarea evidence\n        table row.Payable columns=invoice,amount,issued,evidence,posting,reference empty=\"No invoice evidence recorded.\"@{nl=\"Geen factuurbewijs vastgelegd.\"}\n         pagination\n         badge row.posting\n         action export_payable\n        form intake_invoice\n         fieldset \"Invoice document\"@{nl=\"Factuurdocument\"}\n          file_input document\n          input source\n        table row.InvoiceDocument columns=document,source,status,invoice,amount,issued,decision order=created empty=\"No invoice documents recorded.\"@{nl=\"Geen factuurdocumenten vastgelegd.\"}\n         pagination\n         badge row.status\n         button opens=transcribe_detail\n         modal \"Transcribe invoice claims\"@{nl=\"Factuurgegevens overnemen\"} id=transcribe_detail\n          slot content\n           form transcribe_claims arguments={invoice_document=row} display=inline\n            input invoice\n            input amount\n            calendar issued\n         button opens=accept_detail\n         modal \"Accept invoice document\"@{nl=\"Factuurdocument accepteren\"} id=accept_detail\n          slot content\n           form accept_invoice arguments={invoice_document=row} display=inline\n            input invoice\n            input amount\n            calendar issued\n            textarea evidence\n         button opens=reject_detail\n         modal \"Reject invoice document\"@{nl=\"Factuurdocument afwijzen\"} id=reject_detail\n          slot content\n           form reject_invoice arguments={invoice_document=row} display=inline\n            textarea reason\n        table row.Line columns=sku,unit,quantity,ordered,accepted,unit_price empty=\"No line items recorded.\"@{nl=\"Geen regels vastgelegd.\"}\n         pagination\n         progress row.accepted max=row.ordered\n         edit\n         button opens=amend_detail\n         modal \"Amend line\"@{nl=\"Regel wijzigen\"} id=amend_detail\n          slot content\n           form amend arguments={line=row} display=inline\n            input quantity\n            textarea reason\n         form receive\n          fieldset \"Delivery receipt\"@{nl=\"Ontvangstregistratie\"}\n           input source\n           input accepted\n           input rejected\n           calendar received\n           textarea evidence\n         table row.Receipt columns=source,accepted,rejected,returned,received,posting,evidence order=-received empty=\"No delivery receipts recorded.\"@{nl=\"Geen ontvangstregistraties vastgelegd.\"}\n          pagination\n          badge row.posting\n          action retry_stock\n          button opens=return_detail\n          modal \"Return goods\"@{nl=\"Goederen retourneren\"} id=return_detail\n           slot content\n            form return_goods arguments={receipt=row} display=inline\n             fieldset \"Supplier return\"@{nl=\"Leveranciersretour\"}\n              input source\n              input quantity\n              calendar returned\n              textarea evidence\n          table row.Return columns=source,quantity,returned,evidence,posting empty=\"No supplier returns recorded.\"@{nl=\"Geen leveranciersretouren vastgelegd.\"}\n           pagination\n           badge row.posting\n           action retry_return\n          history\n       history\n   card \"Budget commitments\"@{nl=\"Budgettoezeggingen\"}\n    form Budget.create\n    list Budget display=split empty=\"No budgets recorded.\"@{nl=\"Geen budgetten vastgelegd.\"}\n     pagination\n     stat row.total,row.committed,row.spent,row.remaining\n     edit\n     form Request.create\n"}}
