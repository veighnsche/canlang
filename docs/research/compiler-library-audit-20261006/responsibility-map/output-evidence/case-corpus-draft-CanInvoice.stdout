{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"fcc3c0c6f59c87f922bd05dfee49ebb3884120816d247a2bb0a4cedeb1e28590","before_projection_sha256":"fcc3c0c6f59c87f922bd05dfee49ebb3884120816d247a2bb0a4cedeb1e28590","changed":true,"idempotent":true,"structure_equal":true,"text":"# Help the workspace operator issue readable invoices for day offices, desks, meeting rooms, memberships, and approved add-ons. @{nl=\"Help de werkplekbeheerder leesbare facturen uit te geven voor dagkantoren, bureaus, vergaderruimten, lidmaatschappen en goedgekeurde extra diensten.\"}\napp CanInvoice uses=[invoice]\n\n# Manage customer receivables, private employee claims and affordable supplier purchasing. @{nl=\"Beheer klantvorderingen, private personeelsdeclaraties en betaalbare leveranciersinkoop.\"}\napp Finance uses=[CanInvoice,CanExpense,CanPurchase,CanReport]\n\n# Own frozen customer invoices, full-balance collection and evidenced refunds. @{nl=\"Beheer vastgelegde klantfacturen, inning van het volledige saldo en bewezen terugbetalingen.\"}\npackage invoice label=\"Invoices\"@{nl=\"Facturen\"}\n use customer {Customer,BillingProfile,owns,has_role,test_company,test_contact,test_billing}\n use rent_catalog {Location,test_site}\n use rent_reservations {LegacyBooking,retain_legacy as retain_booking,history_user,history_worker,legacy_source,legacy_booking}\n use employee {can_work,test_worker}\n use std {PaymentState,OperationOutcome,DeliveryResult}\n use std {EmailV1 as Mail} from=deployment.mail\n use std {PaymentsV1 as Payments} from=deployment.payments\n use invoice {BillingIngressV1 as BillingRequests} from=deployment.billing_ingress\n use invoice {DocumentsV1 as Documents} from=deployment.documents\n use invoice {SalesIngressV1 as SalesRequests} from=deployment.sales_ingress\n Given\n  message notice_invoice_issued = \"Invoice issued\"@{nl=\"Factuur uitgegeven\"}\n  message page_finance_invoice_Invoice_id_title = \"Invoice\"@{nl=\"Factuur\"}\n  message label_Charge_source = \"Source reference\"@{nl=\"Bronreferentie\"}\n  message label_Charge_customer = \"Customer\"@{nl=\"Klant\"}\n  message label_Charge_consent = \"Recurrence consent\"@{nl=\"Toestemming voor herhaling\"}\n  message label_Settlement_received = \"Received at\"@{nl=\"Ontvangen op\"}\n  message label_Settlement_state = \"State\"@{nl=\"Status\"}\n  message label_Settlement_state_paid = \"Paid\"@{nl=\"Betaald\"}\n  message label_Settlement_state_void = \"Void\"@{nl=\"Ongeldig\"}\n  message label_Settlement_state_unknown = \"Unknown\"@{nl=\"Onbekend\"}\n  message label_DocumentLine_tax = \"Tax\"@{nl=\"Belasting\"}\n  message label_DocumentLine_discount = \"Discount\"@{nl=\"Korting\"}\n  message label_InvoiceDocument_issuer = \"Issuer\"@{nl=\"Uitgever\"}\n  message label_InvoiceDocument_recipient = \"Recipient\"@{nl=\"Ontvanger\"}\n  message label_InvoiceDocument_tax_reference = \"Tax reference\"@{nl=\"Belastingreferentie\"}\n  message label_InvoiceDocument_number = \"Invoice number\"@{nl=\"Factuurnummer\"}\n  message label_InvoiceDocument_issued_at = \"Issued at\"@{nl=\"Uitgegeven op\"}\n  message label_InvoiceDocument_credits = \"Credits\"@{nl=\"Credits\"}\n  message label_PdfResult_document = \"Generate document\"@{nl=\"Document genereren\"}\n  message label_Attempt = \"Payment attempt\"@{nl=\"Betaalpoging\"}\n  message label_Attempt_delivery = \"Delivery reference\"@{nl=\"Verzendingsreferentie\"}\n  message label_Credit_author = \"Author\"@{nl=\"Auteur\"}\n  preferences { location:Location?, currency:currency? }\n  export contract Charge { source:text label=label_Charge_source, customer:text label=label_Charge_customer, location:text, description:text, amount:money, due:date, issuer:text?, terms:text?, items:DocumentLine[]?, consent:text? label=label_Charge_consent } label=\"Charge\"@{nl=\"Kostenpost\"}\n  export contract Settlement { source:text, invoice:text, revision:int, amount:money, collected:money, refunded:money, collection_pending:bool, refund_pending:bool, state:Invoice.state, recorded_at:datetime } label=\"Invoice settlement snapshot\"@{nl=\"Momentopname factuurafwikkeling\"}\n  export capability BillingV1 version=1\n   charge(value:Charge) -> OperationOutcome\n   cancel(source:text,reason:text) -> OperationOutcome\n   refund(source:text,amount:money,reason:text) -> OperationOutcome\n   reconcile(source:text) -> Settlement?\n   event settled { value:Settlement }\n  export contract SaleMilestone { source:text, revision:int min=1, customer:text, account:user, location:text, product:text, amount:money, purchased_at:datetime, occurred:datetime, milestone:enum(paid,completed,cancellation_passed,reversed), attribution:text?, exclusive_program:text?, attributed_at:datetime?, attribution_window:duration? }\n  export contract Qualification { source:text, revision:int min=1, customer:text, account:user, location:text, product:text, amount:money, purchased_at:datetime, occurred:datetime, milestone:SaleMilestone.milestone, attribution:text?, exclusive_program:text?, attributed_at:datetime?, attribution_window:duration?, first_customer:bool, history_known:bool }\n  export capability SalesV1 version=1\n   event qualification { value:Qualification }\n  export capability SalesIngressV1 version=1\n   event observed { value:SaleMilestone }\n  export event SaleQualification { value:Qualification }\n  CommercialHistory in Customer { complete:bool=false label=\"Complete commercial history reviewed\"@{nl=\"Volledige commerciële historiek beoordeeld\"}, first_invoice:Invoice? label=\"First paid invoice\"@{nl=\"Eerste betaalde factuur\"}, evidence:text } label=\"Customer commercial history\"@{nl=\"Commerciële klanthistoriek\"}\n  unique CommercialHistory fields=parent\n  CommercialSale in Customer { source:text unique, value:SaleMilestone, source_revision:int, revision:int=0, reversed:bool=false, effective:SaleMilestone.milestone=paid, last:Qualification? }\n  lock CommercialSale fields=source\n  event SaleCheck { sale:CommercialSale }\n  invariant CommercialSale: not any(CommercialSale as sale,sale.id!=row.id and sale.source==row.source)\n  policy CommercialHistory read=finance where=all(row.parent.locations as location,can_work(actor,location))\n  policy CommercialSale read=finance where=all(row.parent.locations as location,can_work(actor,location))\n  export contract DocumentLine { title:text, quantity:decimal, price:money, tax:money label=label_DocumentLine_tax, discount:money label=label_DocumentLine_discount, unit:text?, from:datetime?, until:datetime?, location:text?, reference:text? } label=\"Document line\"@{nl=\"Documentregel\"}\n  export contract DocumentCredit { amount:money, reason:text } label=\"Document credit\"@{nl=\"Documentcredit\"}\n  export contract DocumentPayment { reference:text, amount:money, kind:Attempt.kind, state:text label=label_Settlement_state, received:datetime? label=label_Settlement_received } label=\"Document payment\"@{nl=\"Documentbetaling\"}\n  export contract InvoiceDocument { issuer:text label=label_InvoiceDocument_issuer, recipient:text label=label_InvoiceDocument_recipient, address:text, tax_reference:text? label=label_InvoiceDocument_tax_reference, number:text label=label_InvoiceDocument_number, issued_at:datetime label=label_InvoiceDocument_issued_at, due:date, currency:currency, lines:DocumentLine[]! label=\"Lines\"@{nl=\"Regels\"}, credits:DocumentCredit[]! label=label_InvoiceDocument_credits, payments:DocumentPayment[]! label=\"Payments\"@{nl=\"Betalingen\"}, terms:text?, total:money } label=\"Issued invoice document\"@{nl=\"Uitgegeven factuurdocument\"}\n  export contract PdfResult { source:text label=label_Charge_source, document:file label=label_PdfResult_document, revision:int } label=\"PDF result\"@{nl=\"PDF-resultaat\"}\n  export capability DocumentsV1 version=1\n   invoice(source:text,snapshot:InvoiceDocument,revision:int) -> PdfResult\n   receipt(source:text,snapshot:InvoiceDocument,revision:int) -> PdfResult\n  export role finance label=\"Finance staff\"@{nl=\"Financieel medewerker\"}\n  contract LegacyInvoiceFacts { customer_source:text? label=\"Original customer system\"@{nl=\"Oorspronkelijk klantsysteem\"}, customer_external_id:text? label=\"Original customer key\"@{nl=\"Oorspronkelijke klantsleutel\"}, number:text? label=label_InvoiceDocument_number, issuer:text? label=label_InvoiceDocument_issuer, recipient:text? label=label_InvoiceDocument_recipient, issued_original:text? label=\"Original issue timestamp\"@{nl=\"Oorspronkelijke uitgiftetijd\"}, issued_at:datetime? label=\"Parsed issue instant\"@{nl=\"Geparst uitgiftetijdstip\"}, due_original:text? label=\"Original due date\"@{nl=\"Oorspronkelijke vervaldatum\"}, due:date? label=\"Parsed due date\"@{nl=\"Geparste vervaldatum\"}, status:text? label=\"Original status\"@{nl=\"Oorspronkelijke status\"}, payment:text? label=\"Original payment status\"@{nl=\"Oorspronkelijke betaalstatus\"}, amount:money? label=\"Original amount\"@{nl=\"Oorspronkelijk bedrag\"}, booking_count:int? min=0 label=\"Evidenced booking count\"@{nl=\"Bewezen aantal reserveringen\"} } label=\"Original invoice facts\"@{nl=\"Oorspronkelijke factuurgegevens\"}\n  ## Source invoices cannot establish live debt, paid settlement or complete commercial history.\n  LegacyInvoice { source:text trim min=1 label=\"Source system\"@{nl=\"Bronsysteem\"}, external_id:text min=1 label=\"Original record key\"@{nl=\"Oorspronkelijke recordsleutel\"}, location:Location label=\"Current location scope\"@{nl=\"Huidig locatiebereik\"}, facts:LegacyInvoiceFacts label=\"Original invoice facts\"@{nl=\"Oorspronkelijke factuurgegevens\"}, document:file? label=\"Original invoice document\"@{nl=\"Oorspronkelijk factuurdocument\"}, document_issue:text? label=\"Document availability issue\"@{nl=\"Probleem met documentbeschikbaarheid\"}, source_evidence:file label=\"Original source artifact\"@{nl=\"Oorspronkelijk bronbestand\"}, attestation:text trim min=1 label=\"Intake attestation\"@{nl=\"Verklaring bij invoer\"}, customer:Customer? label=\"Current customer\"@{nl=\"Huidige klant\"}, mapping_reason:text? label=\"Review reason\"@{nl=\"Reden voor beoordeling\"}, imported_by:user server=actor label=\"Imported by\"@{nl=\"Ingevoerd door\"}, imported_at:datetime server=now label=\"Imported at\"@{nl=\"Ingevoerd op\"} } label=\"Historical invoice\"@{nl=\"Historische factuur\"}\n  LegacyInvoiceBooking in LegacyInvoice { booking_source:text min=1 label=\"Booking source system\"@{nl=\"Bronsysteem van reservering\"}, booking_external_id:text min=1 label=\"Original booking key\"@{nl=\"Oorspronkelijke reserveringssleutel\"}, source_evidence:file label=\"Original source artifact\"@{nl=\"Oorspronkelijk bronbestand\"}, attestation:text trim min=1 label=\"Intake attestation\"@{nl=\"Verklaring bij invoer\"}, booking:LegacyBooking? label=\"Retained booking evidence\"@{nl=\"Bewaard reserveringsbewijs\"}, mapping_reason:text trim min=1 label=\"Review reason\"@{nl=\"Reden voor beoordeling\"}, imported_by:user server=actor label=\"Imported by\"@{nl=\"Ingevoerd door\"}, imported_at:datetime server=now label=\"Imported at\"@{nl=\"Ingevoerd op\"} } label=\"Historical invoice booking link\"@{nl=\"Historische factuur-reserveringskoppeling\"}\n  unique LegacyInvoice fields=source,external_id\n  unique LegacyInvoiceBooking fields=booking_source,booking_external_id\n  lock LegacyInvoice fields=source,external_id,location,facts,document,document_issue,source_evidence,attestation,imported_by,imported_at\n  lock LegacyInvoiceBooking fields=booking_source,booking_external_id,source_evidence,attestation,imported_by,imported_at\n  policy LegacyInvoice read=finance and can_work(actor,row.location)\n  policy LegacyInvoice read=authenticated where=row.customer!=null and (owns(actor,row.customer) or has_role(actor,row.customer,billing)) fields=source,external_id,location,facts,document,document_issue,customer\n  policy LegacyInvoiceBooking read=finance and can_work(actor,row.parent.location)\n  policy LegacyInvoiceBooking read=authenticated where=row.parent.customer!=null and (owns(actor,row.parent.customer) or has_role(actor,row.parent.customer,billing)) fields=parent,booking_source,booking_external_id,booking\n  invariant LegacyInvoice: (row.facts.customer_source==null)==(row.facts.customer_external_id==null) and ((row.document!=null and row.document_issue==null) or (row.document==null and trim(row.document_issue??\"\")!=\"\"))\n  fixture legacy_document=file {owner=history_user}\n  fixture legacy_invoice=LegacyInvoice {source=\"vendor-w\",external_id=\"I-8\",location=test_site,facts={customer_source=\"vendor-w\",customer_external_id=\"C-9\",number=\"2021-8\",issuer=\"Original operator\",recipient=\"Original billed party\",issued_original=\"2021-05-12T09:00:00Z\",issued_at=datetime(\"2021-05-12T09:00:00Z\"),status=\"Issued\",payment=\"Paid\",amount=money(1000,\"EUR\"),booking_count=1},document=legacy_document,source_evidence=legacy_source,attestation=\"Per-invoice document checked separately from source export\"}\n  fixture legacy_edge=LegacyInvoiceBooking {parent=legacy_invoice,booking_source=\"vendor-w\",booking_external_id=\"B-17\",source_evidence=legacy_source,attestation=\"Original booking relationship retained\",mapping_reason=\"Booking evidence not yet resolved\"}\n  Defaults { issuer:text label=label_InvoiceDocument_issuer, attempt_limit:int=3 min=1 max=10, retry_delay:duration=2d, retry_window:duration=14d } label=\"Invoice defaults\"@{nl=\"Factuurstandaarden\"}\n  export capability BillingIngressV1 version=1\n   event charge { value:Charge }\n   event cancel { source:text, reason:text }\n   event refund { source:text, amount:money, reason:text }\n   event reconcile { source:text }\n  export event ChargeOutcome { value:OperationOutcome }\n  export event CancelOutcome { value:OperationOutcome }\n  export event RefundOutcome { value:OperationOutcome }\n  export event ReconcileOutcome { source:text, value:Settlement? }\n  BillingCancellation { source:text unique, reason:text }\n  lock BillingCancellation fields=source,reason\n  export Invoice in Customer { first_paid_at:datetime?, attempt_limit:int=3 min=1 max=10, retry_delay:duration=2d, retry_until:datetime?, next_collection:datetime?, ledger_revision:int=0 min=0, location:Location, source:text unique label=label_Charge_source, issuer:text label=label_InvoiceDocument_issuer, recipient:text label=label_InvoiceDocument_recipient, recipient_email:email label=\"Recipient email\"@{nl=\"E-mailadres ontvanger\"}, address:text, tax_reference:text? label=label_InvoiceDocument_tax_reference, currency:currency, description:text, terms:text?, source_items:DocumentLine[]?, due:date, number:text? label=label_InvoiceDocument_number, state:enum(draft,issued,void_pending,void)=draft label={text=label_Settlement_state,values={void=label_Settlement_state_void,draft=\"Draft\"@{nl=\"Concept\"},issued=\"Issued\"@{nl=\"Uitgegeven\"},void_pending=\"Void pending\"@{nl=\"Ongeldigverklaring in afwachting\"}}}, total:money, issued_at:datetime? label=label_InvoiceDocument_issued_at, consent:text? label=label_Charge_consent, needs_review:bool=false label=\"Needs review\"@{nl=\"Beoordeling nodig\"} } label=page_finance_invoice_Invoice_id_title\n  Line in Invoice { description:text, position:int=0 min=0, quantity:decimal=1 min=0, unit:text?, service_from:datetime?, service_until:datetime?, service_location:text?, service_reference:text?, price:money, tax:money label=label_DocumentLine_tax, discount:money label=label_DocumentLine_discount } label=\"Line item\"@{nl=\"Regel\"}\n  Attempt in Invoice { mode:enum(interactive,automatic)=interactive, requested:datetime server=now, outcome_at:datetime?, provider_revision:int=0 min=0, failure:PaymentState.failure, disabled:bool=false, reference:text unique, amount:money, kind:enum(collection,refund) label={text=\"Payment kind\"@{nl=\"Betalingssoort\"},values={collection=\"Collection\"@{nl=\"Inning\"},refund=\"Refund\"@{nl=\"Terugbetaling\"}}}, payment:text? label=label_Attempt, status:PaymentState.status=pending label={text=\"Status\"@{nl=\"Status\"},values={unknown=label_Settlement_state_unknown,pending=\"Pending\"@{nl=\"In afwachting\"},succeeded=\"Succeeded\"@{nl=\"Geslaagd\"},failed=\"Failed\"@{nl=\"Mislukt\"}}}, provider_reference:text? label=\"Provider reference\"@{nl=\"Providerreferentie\"}, checkout:url? label=\"Payment link\"@{nl=\"Betaallink\"}, received:datetime? label=label_Settlement_received, delivery:text? label=label_Attempt_delivery, reason:text? } label=label_Attempt\n  PaymentRequest in Attempt { kind:enum(cancel,reconcile) label={text=\"Request kind\"@{nl=\"Aanvraagsoort\"},values={cancel=\"Cancellation\"@{nl=\"Annulering\"},reconcile=\"Reconciliation\"@{nl=\"Afstemming\"}}}, cancellation:delivery(Payments.cancel)? label=\"Cancellation observation\"@{nl=\"Annuleringswaarneming\"}, reconciliation:delivery(Payments.reconcile)? label=\"Reconciliation observation\"@{nl=\"Afstemmingswaarneming\"}, review_reason:text? label=\"Review reason\"@{nl=\"Beoordelingsreden\"}, reviewed_by:user? label=\"Reviewed by\"@{nl=\"Beoordeeld door\"}, reviewed_at:datetime? label=\"Reviewed at\"@{nl=\"Beoordeeld op\"} } label=\"Payment observation request\"@{nl=\"Aanvraag betalingswaarneming\"}\n  lock PaymentRequest fields=kind,cancellation,reconciliation,review_reason,reviewed_by,reviewed_at\n  invariant PaymentRequest: (row.kind==cancel and row.cancellation!=null and row.reconciliation==null) or (row.kind==reconcile and row.reconciliation!=null and row.cancellation==null)\n  invariant PaymentRequest: (row.review_reason==null and row.reviewed_by==null and row.reviewed_at==null) or (row.kind==reconcile and trim(row.review_reason??\"\")!=\"\" and row.reviewed_by!=null and row.reviewed_at!=null)\n  policy PaymentRequest read=finance and can_work(actor,row.parent.parent.location) fields=parent,kind,status,cancellation.id,cancellation.status,reconciliation.id,reconciliation.status,review_reason,reviewed_by,reviewed_at\n  Credit in Invoice { source:text unique label=label_Charge_source, amount:money, reason:text, author:user? label=label_Credit_author } label=\"Credit adjustment\"@{nl=\"Creditcorrectie\"}\n  ExternalPayment in Invoice { reference:text unique, amount:money, received:datetime label=label_Settlement_received, evidence:text, author:user server=actor label=label_Credit_author } label=\"External payment\"@{nl=\"Externe betaling\"}\n  Document in Invoice { revision:int, kind:enum(invoice,receipt)=invoice, file:file, generated:datetime server=now label=\"Generated at\"@{nl=\"Gegenereerd op\"} } label=\"Invoice document\"@{nl=\"Factuurdocument\"}\n  DocumentRequest in Invoice { status:enum(pending,succeeded,failed,unknown)=pending, error:text?, revision:int, kind:Document.kind=invoice, delivery:text unique label=label_Attempt_delivery } label=\"Document request\"@{nl=\"Documentaanvraag\"}\n  ExternalRefund in Invoice { payment:ExternalPayment, reference:text unique, amount:money, received:datetime, evidence:text, reason:text, author:user server=actor } label=\"External refund evidence\"@{nl=\"Bewijs externe terugbetaling\"}\n  event ProviderReceipt { value:PaymentState }\n  export event InvoiceSettlement { value:Settlement }\n  event Overdue { invoice:Invoice, revision:int }\n  event CollectionDue { invoice:Invoice }\n  event ReconcileDue { attempt:Attempt }\n  derive PaymentRequest.status:DeliveryResult.status? = row.cancellation?.status??row.reconciliation?.status label={text=\"Observation status\"@{nl=\"Waarnemingsstatus\"},values={pending=\"Pending\"@{nl=\"In afwachting\"},succeeded=\"Succeeded\"@{nl=\"Geslaagd\"},failed=\"Failed\"@{nl=\"Mislukt\"},unknown=label_Settlement_state_unknown,skipped=\"Skipped\"@{nl=\"Overgeslagen\"}}}\n  derive first_receipt(invoice:Invoice):datetime? = min((invoice.Attempt as attempt where attempt.kind==collection and attempt.status==succeeded and attempt.received!=null select attempt.received)+(invoice.ExternalPayment as payment select payment.received))\n  derive first_paid_invoice(customer:Customer):Invoice? = first(customer.Invoice as invoice where invoice.received.minor>0 and first_receipt(invoice)!=null order=first_receipt(invoice))\n  derive settlement(invoice:Invoice):Settlement = Settlement {source=invoice.source,invoice=invoice.id,revision=invoice.ledger_revision,amount=invoice.total,collected=invoice.received,refunded=invoice.refunded,collection_pending=any(invoice.Attempt as attempt,attempt.kind==collection and attempt.status in [pending,unknown]),refund_pending=any(invoice.Attempt as attempt,attempt.kind==refund and attempt.status in [pending,unknown]),state=invoice.state,recorded_at=now}\n  derive issued_snapshot(invoice:Invoice,number:text,issued_at:datetime):InvoiceDocument = InvoiceDocument {issuer=invoice.issuer,recipient=invoice.recipient,address=invoice.address,tax_reference=invoice.tax_reference,number,issued_at,due=invoice.due,currency=invoice.currency,lines=invoice.Line as line order=line.position select DocumentLine {title=line.description,quantity=line.quantity,price=line.price,tax=line.tax,discount=line.discount,unit=line.unit,from=line.service_from,until=line.service_until,location=line.service_location,reference=line.service_reference},credits=invoice.Credit as credit select DocumentCredit {amount=credit.amount,reason=credit.reason},payments=(invoice.Attempt as payment select DocumentPayment {reference=payment.reference,amount=payment.amount,kind=payment.kind,state=format(\"{status}\",{status=payment.status}),received=payment.received})+(invoice.ExternalPayment as payment select DocumentPayment {reference=payment.reference,amount=payment.amount,kind=collection,state=\"succeeded\",received=payment.received})+(invoice.ExternalRefund as evidence select DocumentPayment {reference=evidence.reference,amount=evidence.amount,kind=refund,state=\"succeeded\",received=evidence.received}),terms=invoice.terms,total=invoice.total}\n  derive Invoice.collection_pending:bool = any(row.Attempt as attempt,attempt.kind==collection and attempt.status in [pending,unknown])\n  derive Invoice.refund_pending:bool = any(row.Attempt as attempt,attempt.kind==refund and attempt.status in [pending,unknown])\n  derive Invoice.settled:bool = row.state==issued and row.balance.minor==0 and not row.collection_pending and not row.refund_pending and row.refund_due.minor==0 label=\"Settled\"@{nl=\"Afgewikkeld\"}\n  derive Invoice.credits:money = sum(row.Credit as credit select credit.amount,row.currency) label=label_InvoiceDocument_credits\n  derive Invoice.received:money = sum(row.Attempt as attempt where attempt.kind==collection and attempt.status==succeeded select attempt.amount,row.currency)+sum(row.ExternalPayment as payment select payment.amount,row.currency) label=\"Received payments\"@{nl=\"Ontvangen betalingen\"}\n  derive Invoice.refunded:money = sum(row.Attempt as attempt where attempt.kind==refund and attempt.status==succeeded select attempt.amount,row.currency)+sum(row.ExternalRefund as refund select refund.amount,row.currency) label=\"Refunded amount\"@{nl=\"Terugbetaald bedrag\"}\n  derive Invoice.balance:money = max([money(0,row.currency),row.total-row.credits-row.received]) label=\"Outstanding balance\"@{nl=\"Openstaand saldo\"}\n  derive Invoice.refund_due:money = max([money(0,row.currency),row.received-row.refunded-(row.total-row.credits)]) label=\"Refund due\"@{nl=\"Terug te betalen\"}\n  policy Invoice read=finance and can_work(actor,row.location)\n  policy Invoice read=authenticated where=row.state!=draft and (owns(actor,row.parent) or has_role(actor,row.parent,billing)) fields=location,source,issuer,recipient,recipient_email,address,tax_reference,currency,description,terms,due,number,state,total,issued_at,needs_review,credits,received,refunded,balance,refund_due,collection_pending,refund_pending,settled\n  policy Document read=finance and can_work(actor,row.parent.location)\n  policy Document read=authenticated where=row.parent.state!=draft and (owns(actor,row.parent.parent) or has_role(actor,row.parent.parent,billing))\n  policy DocumentRequest read=finance and can_work(actor,row.parent.location)\n  policy DocumentRequest read=authenticated where=row.parent.state!=draft and (owns(actor,row.parent.parent) or has_role(actor,row.parent.parent,billing)) fields=revision,kind,status,error\n  policy Line read=finance and can_work(actor,row.parent.location)\n  policy Line read=authenticated where=row.parent.state!=draft and (owns(actor,row.parent.parent) or has_role(actor,row.parent.parent,billing))\n  policy Attempt read=finance and can_work(actor,row.parent.location)\n  policy Attempt read=authenticated where=row.parent.state!=draft and (owns(actor,row.parent.parent) or has_role(actor,row.parent.parent,billing)) fields=reference,amount,kind,status,failure,checkout,received,reason\n  policy Credit read=finance and can_work(actor,row.parent.location)\n  policy Credit read=authenticated where=row.parent.state!=draft and (owns(actor,row.parent.parent) or has_role(actor,row.parent.parent,billing))\n  policy ExternalPayment read=finance and can_work(actor,row.parent.location)\n  policy ExternalPayment read=authenticated where=row.parent.state!=draft and (owns(actor,row.parent.parent) or has_role(actor,row.parent.parent,billing)) fields=reference,amount,received\n  invariant Invoice: not any(Invoice as other,other!=row and other.source==row.source)\n  invariant Invoice: row.number==null or not any(Invoice as other,other!=row and other.number==row.number)\n  invariant Invoice: row.state==draft or (row.number!=null and row.issued_at!=null)\n  invariant Invoice: row.total.currency==row.currency and row.total.minor>=0 and row.credits<=row.total\n  policy ExternalRefund read=finance and can_work(actor,row.parent.location)\n  policy ExternalRefund read=authenticated where=row.parent.state!=draft and (owns(actor,row.parent.parent) or has_role(actor,row.parent.parent,billing)) fields=reference,amount,received,reason\n  invariant ExternalRefund: row.payment.parent==row.parent and row.amount.currency==row.parent.currency and row.amount.minor>0 and trim(row.reference)!=\"\" and trim(row.evidence)!=\"\" and trim(row.reason)!=\"\"\n  invariant Line: row.quantity>=0 and (row.quantity>0 or row.price*row.quantity+row.tax-row.discount==money(0,row.parent.currency)) and ((row.service_from==null and row.service_until==null) or (row.service_from!=null and row.service_until!=null and row.service_from<row.service_until)) and row.price.currency==row.parent.currency and row.tax.currency==row.parent.currency and row.discount.currency==row.parent.currency and row.price.minor>=0 and row.tax.minor>=0 and row.discount.minor>=0 and row.price*row.quantity+row.tax>=row.discount\n  invariant Attempt: row.amount.currency==row.parent.currency and row.amount.minor>0\n  invariant Credit: row.amount.currency==row.parent.currency and row.amount.minor>0 and trim(row.reason)!=\"\"\n  invariant ExternalPayment: row.amount.currency==row.parent.currency and row.amount.minor>0 and trim(row.evidence)!=\"\"\n  lock Invoice fields=attempt_limit,retry_delay,retry_until,consent,location,source,issuer,recipient,recipient_email,address,tax_reference,currency,description,terms,source_items,due,number,total,issued_at when=row.state!=draft\n  lock Line fields=description,position,quantity,unit,service_from,service_until,service_location,service_reference,price,tax,discount when=row.parent.state!=draft\n  lock Document fields=revision,kind,file,generated\n  lock DocumentRequest fields=revision,kind,delivery\n  lock ExternalRefund fields=payment,reference,amount,received,evidence,reason,author\n  lock Credit fields=source,amount,reason,author\n  lock ExternalPayment fields=reference,amount,received,evidence,author\n  lock Attempt fields=mode,requested,reference,amount,kind,payment,reason\n  fixture test_invoice=Invoice {parent=test_company,location=test_site,source=\"invoice-test\",issuer=\"Operator\",recipient=\"Company\",recipient_email=\"customer@example.test\",address=\"1 Road\",currency=\"EUR\",description=\"Room\",due=date(\"2099-01-02\"),total=money(100,\"EUR\"),state=issued,number=\"INV-TEST\",issued_at=datetime(\"2099-01-01T00:00:00Z\")}\n  fixture test_payment=Attempt {parent=test_invoice,reference=\"provider-test\",amount=money(100,\"EUR\"),kind=collection}\n  fixture test_refund=Attempt {parent=test_invoice,reference=\"refund-test\",amount=money(20,\"EUR\"),kind=refund,payment=test_payment.reference,reason=\"Credit refund\"}\n  fixture reconciliation_attempt=Payments.reconcile {request={reference=test_payment.reference}}\n  fixture pending_reconciliation=PaymentRequest {parent=test_payment,kind=reconcile,reconciliation=reconciliation_attempt}\n  fixture outside_site=Location {name=\"Outside work scope\",address=\"2 Example Road\",timezone=\"Europe/Brussels\",currency=\"EUR\",hours=\"09:00–18:00\",arrival=\"Report to reception\"}\n  fixture test_credit=Credit {parent=test_invoice,source=\"credit-test\",amount=money(20,\"EUR\"),reason=\"Agreed correction\",author=self}\n  fixture test_defaults=Defaults {issuer=\"Operator\"}\n  fixture test_profile=BillingProfile {parent=test_company,contact=test_contact,address=\"1 Road\"}\n  fixture test_external=ExternalPayment {parent=test_invoice,reference=\"bank-test\",amount=money(100,\"EUR\"),received=datetime(\"2026-10-01T00:00:00Z\"),evidence=\"Bank statement\",author=self}\n  fixture customer_history=CommercialHistory {parent=test_company,complete=true,first_invoice=test_invoice,evidence=\"Reviewed complete ledger\"}\n  fixture commercial_sale=CommercialSale {parent=test_company,source=\"invoice-test\",source_revision=1,value={source=\"invoice-test\",revision=1,customer=test_company.id,account=self,location=test_site.id,product=\"meeting\",amount=money(100,\"EUR\"),purchased_at=datetime(\"2026-10-01T00:00:00Z\"),occurred=datetime(\"2026-10-02T00:00:00Z\"),milestone=completed,attribution=\"share\",exclusive_program=\"refer.Program:reviewed\",attributed_at=datetime(\"2026-10-01T00:00:00Z\"),attribution_window=30d}}\n When\n  # Retain historical invoice evidence without issuing, collecting or qualifying a sale. @{nl=\"Bewaar historisch factuurbewijs zonder een factuur uit te geven, betaling te innen of een verkoop te kwalificeren.\"}\n  scenario retain_legacy(source:text label=\"Source system\"@{nl=\"Bronsysteem\"},external_id:text label=\"Original record key\"@{nl=\"Oorspronkelijke recordsleutel\"},location:Location label=\"Current location scope\"@{nl=\"Huidig locatiebereik\"},facts:LegacyInvoiceFacts label=\"Original invoice facts\"@{nl=\"Oorspronkelijke factuurgegevens\"},document:file? label=\"Original invoice document\"@{nl=\"Oorspronkelijk factuurdocument\"},document_issue:text? label=\"Document availability issue\"@{nl=\"Probleem met documentbeschikbaarheid\"},source_evidence:file label=\"Original source artifact\"@{nl=\"Oorspronkelijk bronbestand\"},attestation:text label=\"Intake attestation\"@{nl=\"Verklaring bij invoer\"}) by=finance -> LegacyInvoice label=\"Retain historical invoice\"@{nl=\"Historische factuur bewaren\"}\n   require can_work(actor,location) and trim(source)!=\"\" and trim(external_id)!=\"\" and trim(attestation)!=\"\"\n   require not any(LegacyInvoice archived=include as entry,entry.source==trim(source) and entry.external_id==external_id)\n   do\n    create LegacyInvoice {source=trim(source),external_id,location,facts,document,document_issue,source_evidence,attestation=trim(attestation)} as entry\n    return entry\n   examples seed=[history_worker,legacy_invoice] source=\"vendor-w\" external_id=\" I-9 \" location=test_site facts={customer_source=\"vendor-w\",customer_external_id=\"C-9\",payment=\"Unknown\",amount=null,booking_count=null} document=legacy_document document_issue=null source_evidence=legacy_source attestation=\"Source export and individual invoice reviewed\"\n    as,external_id,document,document_issue -> result.external_id,result.facts.amount,result.facts.booking_count,result.customer,result.imported_by,count(Invoice),count(Attempt),count(CommercialHistory)\n    history_user,\" I-9 \",legacy_document,null -> \" I-9 \",null,null,null,history_user,0,0,0\n    history_user,\"I-9\",null,\"Original document unavailable\" -> \"I-9\",null,null,null,history_user,0,0,0\n    history_user,\"I-8\",legacy_document,null -> error(rule_failed)\n    history_user,\"I-9\",null,null -> error(rule_failed)\n    members,\"I-9\",legacy_document,null -> error(forbidden)\n   ## Canonical intake and mapping calls record current stewardship, never past issuing/payment.\n   examples seed=[history_worker,legacy_source,legacy_document,test_billing]\n    do\n     call retain_booking {source=\"vendor-w\",external_id=\"journey-booking\",location=test_site,facts={customer_source=\"vendor-w\",customer_external_id=\"C-9\",from_original=\"2021-05-12 09:00\",status=\"Completed\",payment=\"Paid\"},source_evidence=legacy_source,attestation=\"Original booking export checked\"} by=history_user as old_booking\n     call retain_legacy {source=\"vendor-w\",external_id=\"journey-invoice\",location=test_site,facts={customer_source=\"vendor-w\",customer_external_id=\"C-9\",number=\"2021-9\",payment=\"Paid\",booking_count=1},document=legacy_document,document_issue=null,source_evidence=legacy_source,attestation=\"Per-invoice document and source export checked\"} by=history_user as old_invoice\n     count(Invoice),count(Attempt),count(CommercialHistory),count(LegacyInvoice),old_booking.facts.from,old_invoice.facts.issued_at -> 0,0,0,1,null,null\n     call retain_legacy_booking {entry=old_invoice,booking_source=\"vendor-w\",booking_external_id=\"journey-booking\",source_evidence=legacy_source,attestation=\"Actual source relationship checked\",reason=\"Booking resolution pending\"} by=history_user as edge\n     call link_legacy_booking {edge,booking=old_booking,reason=\"Exact source namespace/key match\"} by=history_user\n     call legacy_matches {source=\"vendor-w\",external_id=\"journey-invoice\",location=test_site} by=self as hidden\n     count(hidden) -> 0\n     call link_legacy {entry=old_invoice,customer=test_company,reason=\"Source C-9 reviewed against existing customer\"} by=history_user\n     call legacy_matches {source=\"vendor-w\",external_id=\"journey-invoice\",location=test_site} by=self as visible\n     count(visible) -> 1\n     let readable=first(visible)\n     readable!=null -> true\n     readable.document,readable.facts.payment -> legacy_document,\"Paid\"\n     call link_legacy {entry=old_invoice,customer=null,reason=\"Stale mapping version\"} by=history_user -> error(conflict)\n     let mapped=first(LegacyInvoice as entry where entry.id==old_invoice.id)\n     mapped!=null -> true\n     call link_legacy {entry=mapped,customer=null,reason=\"Revoke mistaken current mapping\"} by=history_user\n     call legacy_matches {source=\"vendor-w\",external_id=\"journey-invoice\",location=test_site} by=self as revoked\n     count(revoked),count(Invoice),count(Attempt),count(CommercialHistory) -> 0,0,0,0\n     let retained_edge=first(LegacyInvoiceBooking as candidate where candidate.id==edge.id)\n     retained_edge!=null -> true\n     retained_edge.booking,retained_edge.booking_source,retained_edge.booking_external_id -> old_booking,\"vendor-w\",\"journey-booking\"\n  # Review readable original invoice identities without an upsert or hidden match. @{nl=\"Beoordeel leesbare oorspronkelijke factuuridentiteiten zonder automatisch bijwerken of verborgen overeenkomsten.\"}\n  scenario legacy_matches(source:text label=\"Source system\"@{nl=\"Bronsysteem\"},external_id:text label=\"Original record key\"@{nl=\"Oorspronkelijke recordsleutel\"},location:Location label=\"Current location scope\"@{nl=\"Huidig locatiebereik\"}) read=true -> LegacyInvoice[] by=authenticated label=\"Find historical invoice\"@{nl=\"Historische factuur zoeken\"}\n   do return LegacyInvoice archived=include as entry where entry.source==trim(source) and entry.external_id==external_id and entry.location==location\n   examples seed=[history_worker,legacy_invoice,test_billing] source=\"vendor-w\" external_id=\"I-8\" location=test_site\n    as,legacy_invoice.customer -> count(result)\n    history_user,null -> 1\n    self,null -> 0\n    self,test_company -> 1\n    other,test_company -> 0\n    public,null -> error(forbidden)\n  # Grant or revoke current billing disclosure after a reviewed exact customer-key match. @{nl=\"Verleen of trek huidige factuurinzage in na beoordeling van een exacte overeenkomst met de klantsleutel.\"}\n  scenario link_legacy(entry:LegacyInvoice,customer:Customer? label=\"Current customer\"@{nl=\"Huidige klant\"},reason:text label=\"Review reason\"@{nl=\"Reden voor beoordeling\"}) by=finance label=\"Map historical invoice customer\"@{nl=\"Historische factuur aan klant koppelen\"}\n   require can_work(actor,entry.location) and trim(reason)!=\"\"\n   require customer==null or (trim(entry.facts.customer_source??\"\")!=\"\" and trim(entry.facts.customer_external_id??\"\")!=\"\" and entry.location in customer.locations)\n   do set entry {customer,mapping_reason=trim(reason)}\n   examples seed=[history_worker] entry=legacy_invoice customer=test_company reason=\"Verified original customer key against existing customer\"\n    as,customer,reason,request.entry.version -> entry.customer,entry.facts.customer_external_id,entry.facts.payment,entry.mapping_reason\n    history_user,test_company,\"Verified source key\",1 -> test_company,\"C-9\",\"Paid\",\"Verified source key\"\n    history_user,null,\"Revoke mistaken customer mapping\",1 -> null,\"C-9\",\"Paid\",\"Revoke mistaken customer mapping\"\n    history_user,test_company,\" \",1 -> error(rule_failed)\n    history_user,test_company,\"Verified source key\",2 -> error(conflict)\n    members,test_company,\"Verified source key\",1 -> error(forbidden)\n  # Retain each evidenced source booking edge; absent booking evidence stays unresolved. @{nl=\"Bewaar elke bewezen koppeling met een bronreservering; ontbrekend reserveringsbewijs blijft onopgelost.\"}\n  scenario retain_legacy_booking(entry:LegacyInvoice,booking_source:text label=\"Booking source system\"@{nl=\"Bronsysteem van reservering\"},booking_external_id:text label=\"Original booking key\"@{nl=\"Oorspronkelijke reserveringssleutel\"},source_evidence:file label=\"Original source artifact\"@{nl=\"Oorspronkelijk bronbestand\"},attestation:text label=\"Intake attestation\"@{nl=\"Verklaring bij invoer\"},reason:text label=\"Review reason\"@{nl=\"Reden voor beoordeling\"}) by=finance -> LegacyInvoiceBooking label=\"Retain invoice booking link\"@{nl=\"Factuur-reserveringskoppeling bewaren\"}\n   require can_work(actor,entry.location) and trim(booking_source)!=\"\" and trim(booking_external_id)!=\"\" and trim(attestation)!=\"\" and trim(reason)!=\"\"\n   require not any(LegacyInvoiceBooking archived=include as edge,edge.parent==entry and edge.booking_source==booking_source and edge.booking_external_id==booking_external_id)\n   require entry.facts.booking_count==null or count(entry.LegacyInvoiceBooking archived=include)<entry.facts.booking_count\n   do\n    create LegacyInvoiceBooking {parent=entry,booking_source,booking_external_id,source_evidence,attestation=trim(attestation),mapping_reason=trim(reason)} as edge\n    return edge\n   examples seed=[history_worker,legacy_edge] entry=legacy_invoice booking_source=\"vendor-w\" booking_external_id=\"B-18\" source_evidence=legacy_source attestation=\"Actual edge from source export\" reason=\"Booking source record not yet transferred\"\n    as,entry.facts.booking_count,booking_external_id -> result.booking_external_id,result.booking,result.mapping_reason,count(Invoice)\n    history_user,null,\"B-18\" -> \"B-18\",null,\"Booking source record not yet transferred\",0\n    history_user,null,\"B-17\" -> error(rule_failed)\n    history_user,1,\"B-18\" -> error(rule_failed)\n    members,null,\"B-18\" -> error(forbidden)\n   examples seed=[history_worker] entry=legacy_invoice booking_source=\"vendor-w\" booking_external_id=\"B-17\" source_evidence=legacy_source attestation=\"Actual edge from source export\" reason=\"Booking evidence not yet resolved\"\n    as,entry.facts.booking_count -> result.booking_external_id,result.booking,count(entry.LegacyInvoiceBooking)\n    history_user,0 -> error(rule_failed)\n    history_user,1 -> \"B-17\",null,1\n    history_user,null -> \"B-17\",null,1\n  # Resolve or revoke one source-identified edge without changing its original evidence. @{nl=\"Koppel of ontkoppel één bronrelatie zonder het oorspronkelijke bewijs te wijzigen.\"}\n  scenario link_legacy_booking(edge:LegacyInvoiceBooking,booking:LegacyBooking? label=\"Retained booking evidence\"@{nl=\"Bewaard reserveringsbewijs\"},reason:text label=\"Review reason\"@{nl=\"Reden voor beoordeling\"}) by=finance label=\"Resolve invoice booking link\"@{nl=\"Factuur-reserveringskoppeling oplossen\"}\n   require can_work(actor,edge.parent.location) and trim(reason)!=\"\"\n   require booking==null or (can_work(actor,booking.location) and booking.source==edge.booking_source and booking.external_id==edge.booking_external_id)\n   do set edge {booking,mapping_reason=trim(reason)}\n   examples seed=[history_worker,legacy_booking] edge=legacy_edge booking=legacy_booking reason=\"Verified retained source identity\"\n    as,booking,edge.booking_source,edge.booking_external_id,reason,request.edge.version -> edge.booking,edge.booking_source,edge.booking_external_id,edge.mapping_reason\n    history_user,legacy_booking,\"vendor-w\",\"B-17\",\"Verified source identity\",1 -> legacy_booking,\"vendor-w\",\"B-17\",\"Verified source identity\"\n    history_user,null,\"vendor-w\",\"B-17\",\"Revoke incorrect resolution\",1 -> null,\"vendor-w\",\"B-17\",\"Revoke incorrect resolution\"\n    history_user,legacy_booking,\"another-tenant\",\"B-17\",\"Wrong namespace\",1 -> error(rule_failed)\n    history_user,legacy_booking,\"vendor-w\",\"B-18\",\"Wrong key\",1 -> error(rule_failed)\n    history_user,legacy_booking,\"vendor-w\",\"B-17\",\"Verified source identity\",2 -> error(conflict)\n    members,legacy_booking,\"vendor-w\",\"B-17\",\"Verified source identity\",1 -> error(forbidden)\n  crud Invoice by=finance fields=location,issuer,recipient,recipient_email,address,tax_reference,description,due create_fields=location,source,issuer,recipient,recipient_email,address,tax_reference,currency,description,due,total when=can_work(actor,row.location) and row.state==draft delete=none\n   examples update seed=[history_worker] record=test_invoice changes={recipient_email=\"corrected@example.test\"}\n    as,test_invoice.state -> test_invoice.recipient_email\n    history_user,draft -> \"corrected@example.test\"\n    history_user,issued -> error(rule_failed)\n    members,draft -> error(forbidden)\n  crud Line by=finance fields=description,position,quantity,unit,service_from,service_until,service_location,service_reference,price,tax,discount when=can_work(actor,row.parent.location) and row.parent.state==draft delete=remove\n   examples create seed=[test_worker] parent=test_invoice description=\"Item\" position=1 quantity=1 price=money(100,\"EUR\") tax=money(0,\"EUR\") discount=money(0,\"EUR\")\n    as,test_invoice.state,request.quantity,request.tax -> count(test_invoice.Line)\n    finance,draft,1,money(0,\"EUR\") -> 1\n    finance,draft,0,money(0,\"EUR\") -> 1\n    finance,draft,0,money(10,\"EUR\") -> error(rule_failed)\n    finance,issued,1,money(0,\"EUR\") -> error(rule_failed)\n  # Issue the exact line, recipient and pricing snapshot under a unique invoice number. @{nl=\"Geef de exacte regel-, ontvanger- en prijsmomentopname uit onder een uniek factuurnummer.\"}\n  scenario issue(invoice:Invoice,number:text label=label_InvoiceDocument_number) by=finance label=\"Issue invoice\"@{nl=\"Factuur uitgeven\"}\n   require can_work(actor,invoice.location) and invoice.state==draft and count(invoice.Line)>0 and trim(number)!=\"\"\n   require not any(Invoice as other,other.number==number)\n   do\n    let defaults=first(Defaults as setting order=setting.id)\n    require defaults!=null and defaults.retry_delay>0m and defaults.retry_window>0m\n    let total=sum(invoice.Line as line select line.price*line.quantity+line.tax-line.discount,invoice.currency)\n    set invoice {state=issued,total,number,issued_at=now,attempt_limit=defaults.attempt_limit,retry_delay=defaults.retry_delay,retry_until=now+defaults.retry_window,ledger_revision=invoice.ledger_revision+1}\n    emit InvoiceSettlement {value=settlement(invoice)}\n    send Mail.send {to=invoice.recipient_email,subject=format(notice_invoice_issued,locale=null),body=invoice.description+\" \"+app_url(format(\"/finance/invoice/{invoice}\",{invoice=invoice.id}))} when=invoice.state==issued as notice\n    schedule invoice.id at=local_instant(add_days(invoice.due,1),\"00:00\",invoice.location.timezone,fold=earlier) event=Overdue {invoice,revision=invoice.version+1}\n  # Render the issued invoice and its current credit and collection evidence to an immutable document version. @{nl=\"Genereer een onveranderlijke documentversie van de uitgegeven factuur en haar huidige credit- en betalingsbewijzen.\"}\n  scenario document(invoice:Invoice) by=finance or authenticated label=label_PdfResult_document\n   require invoice.state!=draft and invoice.number!=null and invoice.issued_at!=null and (owns(actor,invoice.parent) or has_role(actor,invoice.parent,billing) or (finance and can_work(actor,invoice.location)))\n   do\n    send Documents.invoice {source=invoice.id,revision=invoice.version,snapshot=issued_snapshot(invoice,invoice.number,invoice.issued_at)} as delivery\n    create DocumentRequest {parent=invoice,revision=invoice.version,delivery=delivery.id} as request\n   examples seed=[test_contact,test_billing,test_profile] invoice=test_invoice\n    as,test_profile.address -> test_invoice.address,test_invoice.total,count(test_invoice.DocumentRequest)\n    members,\"Later billing address\" -> \"1 Road\",money(100,\"EUR\"),1\n    public,\"Later billing address\" -> error(forbidden)\n  scenario document_result on=Documents.invoice.completed\n   do\n    for request in DocumentRequest as row where row.delivery==event.delivery_id and row.kind==invoice limit=1\n     if event.status==succeeded and event.result?.source==request.parent.id and event.result.revision==request.revision\n      if not any(request.parent.Document as document,document.revision==request.revision and document.kind==request.kind)\n       create Document {parent=request.parent,revision=request.revision,kind=request.kind,file=event.result.document} as document\n      set request {status=succeeded,error=null}\n     else\n      if event.status==succeeded\n       set request {status=failed,error=null}\n      if event.status in [failed,unknown]\n       if event.status==failed\n        set request {status=failed,error=event.error?.message}\n       else\n        set request {status=unknown,error=event.error?.message}\n  # Generate a separate receipt only for evidenced full settlement. @{nl=\"Genereer een afzonderlijk betalingsbewijs alleen na bewezen volledige betaling.\"}\n  scenario receipt(invoice:Invoice) by=finance or authenticated label=\"Generate receipt\"@{nl=\"Betalingsbewijs genereren\"}\n   require invoice.settled and invoice.number!=null and invoice.issued_at!=null and invoice.received.minor>0\n   require owns(actor,invoice.parent) or has_role(actor,invoice.parent,billing) or (finance and can_work(actor,invoice.location))\n   do\n    send Documents.receipt {source=invoice.id,revision=invoice.version,snapshot=issued_snapshot(invoice,invoice.number,invoice.issued_at)} as delivery\n    create DocumentRequest {parent=invoice,revision=invoice.version,kind=receipt,delivery=delivery.id} as request\n   examples seed=[test_contact,test_billing,test_payment] invoice=test_invoice\n    as,test_payment.status -> count(test_invoice.DocumentRequest)\n    members,succeeded -> 1\n    members,unknown -> error(rule_failed)\n    members,failed -> error(rule_failed)\n   examples seed=[test_contact,test_billing,test_payment,test_credit,test_refund] invoice=test_invoice\n    as,test_payment.status,test_refund.status -> test_invoice.settled,count(test_invoice.DocumentRequest)\n    members,succeeded,pending -> error(rule_failed)\n    members,succeeded,unknown -> error(rule_failed)\n    members,succeeded,failed -> error(rule_failed)\n    members,succeeded,succeeded -> true,1\n   examples seed=[test_payment,test_credit] invoice=test_invoice\n    as,test_payment.status -> count(test_invoice.DocumentRequest)\n    finance,succeeded -> error(rule_failed)\n  scenario receipt_result on=Documents.receipt.completed\n   do\n    for request in DocumentRequest as row where row.delivery==event.delivery_id and row.kind==receipt limit=1\n     if event.status==succeeded and event.result?.source==request.parent.id and event.result.revision==request.revision\n      if not any(request.parent.Document as document,document.revision==request.revision and document.kind==receipt)\n       create Document {parent=request.parent,revision=request.revision,kind=receipt,file=event.result.document} as document\n      set request {status=succeeded,error=null}\n     else\n      if event.status==succeeded\n       set request {status=failed,error=null}\n      if event.status in [failed,unknown]\n       if event.status==failed\n        set request {status=failed,error=event.error?.message}\n       else\n        set request {status=unknown,error=event.error?.message}\n  # Collect only the current full remaining balance, with no second uncertain checkout. @{nl=\"In alleen het huidige volledige resterende saldo, zonder tweede onzekere betaalpoging.\"}\n  scenario collect(invoice:Invoice) by=authenticated or finance label=\"Collect payment\"@{nl=\"Betaling innen\"}\n   require invoice.state==issued and invoice.balance.minor>0 and (has_role(actor,invoice.parent,billing) or owns(actor,invoice.parent) or (finance and can_work(actor,invoice.location)))\n   require not any(invoice.Attempt as attempt,attempt.kind==collection and (attempt.status in [pending,unknown] or (attempt.status==failed and attempt.failure==permanent)))\n   do\n    cancel format(\"{invoice}:collection\",{invoice=invoice.id})\n    set invoice {next_collection=null}\n    create Attempt {parent=invoice,reference=operation.id,amount=invoice.balance,kind=collection} as attempt\n    send Payments.collect {customer=invoice.parent.id,amount=attempt.amount,reference=attempt.reference,consent=null} when=invoice.state==issued and invoice.balance==attempt.amount and not attempt.disabled as delivery\n    set attempt {delivery=delivery.id}\n    set invoice {ledger_revision=invoice.ledger_revision+1}\n    emit InvoiceSettlement {value=settlement(invoice)}\n   examples seed=[test_contact,test_billing] invoice=test_invoice\n    as,invoice.state -> count(test_invoice.Attempt)\n    members,issued -> 1\n    members,void -> error(rule_failed)\n    public,issued -> error(forbidden)\n   examples seed=[test_contact,test_billing,test_payment] invoice=test_invoice\n    as,test_payment.status,test_payment.failure -> count(test_invoice.Attempt)\n    members,pending,null -> error(rule_failed)\n    members,unknown,null -> error(rule_failed)\n    members,failed,action_required -> 2\n    members,failed,transient -> 2\n    members,failed,permanent -> error(rule_failed)\n  # Record full external collection only after all uncertain attempts have been resolved. @{nl=\"Registreer volledige externe betaling pas nadat alle onzekere pogingen zijn opgelost.\"}\n  scenario record_payment(invoice:Invoice,amount:money,reference:text,received:datetime label=label_Settlement_received,evidence:text) by=finance label=\"Record external payment\"@{nl=\"Externe betaling registreren\"}\n   require can_work(actor,invoice.location) and invoice.state==issued and amount==invoice.balance and amount.minor>0 and trim(reference)!=\"\" and trim(evidence)!=\"\" and received<=now\n   require not any(invoice.Attempt as attempt,attempt.status in [pending,unknown]) and not any(ExternalPayment as payment,payment.reference==reference)\n   do\n    create ExternalPayment {parent=invoice,amount,reference,received,evidence} as payment\n    set invoice {ledger_revision=invoice.ledger_revision+1}\n    emit InvoiceSettlement {value=settlement(invoice)}\n   examples seed=[test_worker,test_payment] invoice=test_invoice amount=money(100,\"EUR\") reference=\"new-bank-reference\" received=datetime(\"2026-10-01T00:00:00Z\") evidence=\"Bank statement\"\n    as,test_payment.status,amount,evidence -> test_invoice.received,test_invoice.balance\n    finance,failed,money(100,\"EUR\"),\"Bank statement\" -> money(100,\"EUR\"),money(0,\"EUR\")\n    finance,unknown,money(100,\"EUR\"),\"Bank statement\" -> error(rule_failed)\n    finance,failed,money(90,\"EUR\"),\"Bank statement\" -> error(rule_failed)\n    finance,failed,money(100,\"EUR\"),\"\" -> error(rule_failed)\n  # Credit an issued balance without rewriting lines or pretending a refund completed. @{nl=\"Crediteer een uitgegeven saldo zonder regels te herschrijven of te doen alsof een terugbetaling is voltooid.\"}\n  scenario credit(invoice:Invoice,amount:money,reason:text) by=finance label=\"Credit invoice\"@{nl=\"Factuur crediteren\"}\n   require can_work(actor,invoice.location) and invoice.state==issued and amount.minor>0 and amount.currency==invoice.currency and amount<=invoice.total-invoice.credits and trim(reason)!=\"\"\n   do\n    create Credit {parent=invoice,source=operation.id,amount,reason,author=actor} as credit\n    for attempt in invoice.Attempt as pending where pending.kind==collection and pending.status in [pending,unknown] limit=100\n     set attempt {disabled=true,checkout=null}\n     send Payments.cancel {reference=attempt.reference} as delivery\n     create PaymentRequest {parent=attempt,kind=cancel,cancellation=delivery} as request\n    if invoice.refund_due.minor>0\n     set invoice {needs_review=true}\n    set invoice {ledger_revision=invoice.ledger_revision+1}\n    emit InvoiceSettlement {value=settlement(invoice)}\n   examples seed=[test_worker,test_payment] invoice=test_invoice amount=money(20,\"EUR\") reason=\"Agreed correction\"\n    as,test_payment.status -> test_invoice.total,test_invoice.balance,test_invoice.refund_due,test_payment.disabled\n    finance,unknown -> money(100,\"EUR\"),money(80,\"EUR\"),money(0,\"EUR\"),true\n    finance,succeeded -> money(100,\"EUR\"),money(0,\"EUR\"),money(20,\"EUR\"),false\n    public,unknown -> error(forbidden)\n  # Request the evidenced overpayment refund separately from the credit decision. @{nl=\"Vraag de bewezen terugbetaling van een overbetaling afzonderlijk van het creditbesluit aan.\"}\n  scenario refund(invoice:Invoice,payment:Attempt label=label_Attempt,amount:money,reason:text) by=finance label=\"Refund payment\"@{nl=\"Betaling terugbetalen\"}\n   require can_work(actor,invoice.location) and payment.parent==invoice and payment.kind==collection and payment.status==succeeded and amount<=invoice.refund_due and amount.minor>0 and trim(reason)!=\"\"\n   require amount<=payment.amount-sum(invoice.Attempt as old where old.kind==refund and old.payment==payment.reference and old.status==succeeded select old.amount,invoice.currency)\n   require not any(invoice.Attempt as attempt,attempt.status in [pending,unknown])\n   do\n    create Attempt {parent=invoice,reference=operation.id,amount,kind=refund,payment=payment.reference,reason} as refund\n    send Payments.refund {payment=payment.reference,amount,reference=refund.reference} as delivery\n    set refund {delivery=delivery.id}\n    set invoice {ledger_revision=invoice.ledger_revision+1}\n    emit InvoiceSettlement {value=settlement(invoice)}\n   examples seed=[test_worker,test_payment,test_credit] invoice=test_invoice payment=test_payment amount=money(20,\"EUR\") reason=\"Credit refund\"\n    as,test_payment.status -> count(test_invoice.Attempt),test_invoice.refunded,test_invoice.refund_due\n    finance,succeeded -> 2,money(0,\"EUR\"),money(20,\"EUR\")\n    finance,unknown -> error(rule_failed)\n    public,succeeded -> error(forbidden)\n  # Record an external refund only with a unique bank reference and its original payment evidence. @{nl=\"Leg een externe terugbetaling alleen vast met een unieke bankreferentie en het oorspronkelijke betalingsbewijs.\"}\n  scenario record_refund(invoice:Invoice,payment:ExternalPayment,amount:money,reference:text,received:datetime,evidence:text,reason:text) by=finance label=\"Record external refund\"@{nl=\"Externe terugbetaling registreren\"}\n   require can_work(actor,invoice.location) and payment.parent==invoice and invoice.state==issued and amount<=invoice.refund_due and amount.minor>0\n   require trim(reference)!=\"\" and received<=now and trim(evidence)!=\"\" and trim(reason)!=\"\"\n   require amount<=payment.amount-sum(invoice.ExternalRefund as old where old.payment==payment select old.amount,invoice.currency)\n   require not any(invoice.Attempt as attempt,attempt.status in [pending,unknown]) and not any(ExternalRefund as old,old.reference==reference)\n   do\n    create ExternalRefund {parent=invoice,payment,amount,reference,received,evidence,reason} as refund\n    set invoice {ledger_revision=invoice.ledger_revision+1}\n    emit InvoiceSettlement {value=settlement(invoice)}\n   examples seed=[test_worker,test_external,test_credit] invoice=test_invoice payment=test_external amount=money(20,\"EUR\") reference=\"refund-bank-reference\" received=datetime(\"2026-10-02T00:00:00Z\") evidence=\"Refund bank statement\" reason=\"Credit refunded\"\n    as,amount,evidence -> test_invoice.refunded,test_invoice.refund_due\n    finance,money(20,\"EUR\"),\"Refund bank statement\" -> money(20,\"EUR\"),money(0,\"EUR\")\n    finance,money(10,\"EUR\"),\"Refund bank statement\" -> money(10,\"EUR\"),money(10,\"EUR\")\n    finance,money(20,\"EUR\"),\"\" -> error(rule_failed)\n  # Stop new collection immediately and reconcile an accepted payment before final void. @{nl=\"Stop nieuwe inning onmiddellijk en stem een geaccepteerde betaling af vóór de definitieve ongeldigverklaring.\"}\n  scenario void(invoice:Invoice,reason:text) by=finance label=\"Void invoice\"@{nl=\"Factuur ongeldig maken\"}\n   require can_work(actor,invoice.location) and invoice.state==issued and invoice.received.minor==0 and trim(reason)!=\"\"\n   do\n    if not any(BillingCancellation as fence,fence.source==invoice.source)\n     create BillingCancellation {source=invoice.source,reason} as fence\n    if any(invoice.Attempt as attempt,attempt.kind==collection and attempt.status in [pending,unknown])\n     set invoice {state=void_pending}\n     for attempt in invoice.Attempt as pending where pending.kind==collection and pending.status in [pending,unknown] limit=100\n      set attempt {disabled=true,checkout=null}\n      send Payments.cancel {reference=attempt.reference} as delivery\n      create PaymentRequest {parent=attempt,kind=cancel,cancellation=delivery} as request\n    else\n     set invoice {state=void}\n    set invoice {next_collection=null,ledger_revision=invoice.ledger_revision+1}\n    emit InvoiceSettlement {value=settlement(invoice)}\n    cancel invoice.id\n    cancel format(\"{invoice}:collection\",{invoice=invoice.id})\n   examples seed=[test_worker,test_payment] invoice=test_invoice reason=\"Booking cancelled\"\n    as,test_payment.status -> test_invoice.state,test_payment.disabled\n    finance,unknown -> void_pending,true\n    finance,failed -> void,false\n    finance,succeeded -> error(rule_failed)\n  scenario result on=Payments.changed\n   do emit ProviderReceipt {value=event}\n  scenario apply_result on=ProviderReceipt\n   do\n    for attempt in Attempt as item where item.reference==event.value.reference limit=1\n     require attempt.amount==event.value.amount\n     if attempt.status!=succeeded and event.value.revision>attempt.provider_revision\n      if attempt.status==failed and event.value.status==succeeded\n       set attempt.parent {needs_review=true}\n      if attempt.status==failed and event.value.status in [pending,unknown]\n       schedule format(\"reconcile-{id}\",{id=attempt.id}) at=now+5m event=ReconcileDue {attempt}\n      set attempt {status=event.value.status,provider_revision=max([attempt.provider_revision,event.value.revision]),failure=event.value.failure,provider_reference=event.value.provider_reference,outcome_at=now}\n      if not attempt.disabled\n       set attempt {checkout=event.value.checkout_url}\n      if event.value.status==succeeded\n       set attempt {received=now,checkout=null}\n       if attempt.kind==collection\n        if attempt.parent.state in [void_pending,void]\n         set attempt.parent {state=issued,needs_review=true}\n        if attempt.parent.refund_due.minor>0\n         set attempt.parent {needs_review=true}\n        cancel attempt.parent.id\n        cancel format(\"{invoice}:collection\",{invoice=attempt.parent.id})\n        set attempt.parent {next_collection=null}\n      if attempt.parent.state==void_pending and not any(attempt.parent.Attempt as pending,pending.status in [pending,unknown]) and attempt.parent.received.minor==0\n       set attempt.parent {state=void}\n      if attempt.kind==collection and event.value.status==failed and attempt.parent.state==issued and attempt.parent.balance.minor>0\n       send Mail.send {to=attempt.parent.recipient_email,subject=format(\"Invoice payment needs attention\"@{nl=\"Factuurbetaling vereist aandacht\"},locale=null),body=app_url(format(\"/finance/invoice/{invoice}\",{invoice=attempt.parent.id}))} when=attempt.parent.state==issued and attempt.parent.balance.minor>0 and attempt.status==failed as notice\n       if attempt.mode==automatic and event.value.failure==transient and attempt.parent.consent!=null and attempt.parent.retry_until!=null and now+attempt.parent.retry_delay<=attempt.parent.retry_until and count(attempt.parent.Attempt as previous where previous.kind==collection and previous.mode==automatic)<attempt.parent.attempt_limit\n        set attempt.parent {next_collection=now+attempt.parent.retry_delay}\n        schedule format(\"{invoice}:collection\",{invoice=attempt.parent.id}) at=now+attempt.parent.retry_delay event=CollectionDue {invoice=attempt.parent}\n      set attempt.parent {ledger_revision=attempt.parent.ledger_revision+1}\n      emit InvoiceSettlement {value=settlement(attempt.parent)}\n   examples seed=[test_payment,test_credit] event={value=PaymentState {reference=\"provider-test\",revision=1,provider_reference=\"verified-charge\",amount=money(100,\"EUR\"),status=succeeded,checkout_url=null,failure=null}}\n    test_payment.status,event.value.amount -> test_invoice.received,test_invoice.refund_due,test_invoice.needs_review,test_invoice.ledger_revision\n    unknown,money(100,\"EUR\") -> money(100,\"EUR\"),money(20,\"EUR\"),true,1\n    failed,money(100,\"EUR\") -> money(100,\"EUR\"),money(20,\"EUR\"),true,1\n    succeeded,money(100,\"EUR\") -> money(100,\"EUR\"),money(20,\"EUR\"),false,0\n    unknown,money(90,\"EUR\") -> error(rule_failed)\n   ## Only a newer verified provider observation may change the reviewed failure classification.\n   examples seed=[test_payment] event={value=PaymentState {reference=\"provider-test\",revision=2,provider_reference=null,amount=money(100,\"EUR\"),status=failed,checkout_url=null,failure=transient}}\n    test_payment.status,test_payment.failure,test_payment.provider_revision,event.value.status,event.value.failure -> test_payment.status,test_payment.failure,test_payment.provider_revision,test_invoice.received,test_invoice.ledger_revision\n    failed,permanent,1,failed,transient -> failed,transient,2,money(0,\"EUR\"),1\n    failed,permanent,2,failed,permanent -> failed,permanent,2,money(0,\"EUR\"),0\n    failed,permanent,3,failed,transient -> failed,permanent,3,money(0,\"EUR\"),0\n    failed,permanent,1,unknown,null -> unknown,null,2,money(0,\"EUR\"),1\n    failed,permanent,1,pending,null -> pending,null,2,money(0,\"EUR\"),1\n  scenario collected on=Payments.collect.completed\n   do\n    for attempt in Attempt as row where row.delivery==event.delivery_id and row.kind==collection limit=1\n     if event.status==succeeded and event.result!=null\n      require event.result.reference==attempt.reference and event.result.amount==attempt.amount\n      emit ProviderReceipt {value=event.result}\n     else\n      if attempt.status in [pending,unknown] and event.status in [failed,unknown]\n       set attempt {status=unknown,outcome_at=now}\n       if attempt.parent.state==void_pending and not any(attempt.parent.Attempt as pending,pending.status in [pending,unknown]) and attempt.parent.received.minor==0\n        set attempt.parent {state=void}\n       set attempt.parent {ledger_revision=attempt.parent.ledger_revision+1}\n       emit InvoiceSettlement {value=settlement(attempt.parent)}\n     if attempt.status in [pending,unknown] and event.status==skipped\n      set attempt {status=failed,failure=cancelled,outcome_at=now,checkout=null,disabled=true}\n      if attempt.parent.state==void_pending and not any(attempt.parent.Attempt as pending,pending.status in [pending,unknown]) and attempt.parent.received.minor==0\n       set attempt.parent {state=void}\n      set attempt.parent {ledger_revision=attempt.parent.ledger_revision+1}\n      emit InvoiceSettlement {value=settlement(attempt.parent)}\n  scenario refunded on=Payments.refund.completed\n   do\n    for attempt in Attempt as row where row.delivery==event.delivery_id and row.kind==refund limit=1\n     if event.status==succeeded and event.result!=null\n      require event.result.reference==attempt.reference and event.result.amount==attempt.amount\n      emit ProviderReceipt {value=event.result}\n     else\n      if attempt.status in [pending,unknown] and event.status in [failed,unknown]\n       set attempt {status=unknown,outcome_at=now}\n       set attempt.parent {ledger_revision=attempt.parent.ledger_revision+1}\n       emit InvoiceSettlement {value=settlement(attempt.parent)}\n  scenario checkout_cancelled on=Payments.cancel.completed\n   do\n    for request in PaymentRequest as row where row.cancellation?.id==event.delivery_id and row.kind==cancel limit=1\n     let attempt=request.parent\n     if event.status==succeeded and event.result!=null\n      require event.result.reference==attempt.reference and event.result.amount==attempt.amount\n      emit ProviderReceipt {value=event.result}\n  scenario reconciled on=Payments.reconcile.completed\n   do\n    for request in PaymentRequest as row where row.reconciliation?.id==event.delivery_id and row.kind==reconcile limit=1\n     let attempt=request.parent\n     if event.status==succeeded and event.result!=null\n      require event.result.reference==attempt.reference and event.result.amount==attempt.amount\n      emit ProviderReceipt {value=event.result}\n   ## Correlated transport acceptance forwards evidence; it does not itself rewrite payment state.\n   examples seed=[pending_reconciliation] event={delivery_id=reconciliation_attempt.id,status=succeeded,result=PaymentState {reference=\"provider-test\",revision=1,provider_reference=null,amount=money(100,\"EUR\"),status=unknown,checkout_url=null,failure=null},error=null}\n    test_payment.status,test_payment.failure,event.result.reference,event.result.amount -> test_payment.status,test_payment.failure,test_invoice.received,test_invoice.ledger_revision\n    failed,permanent,\"provider-test\",money(100,\"EUR\") -> failed,permanent,money(0,\"EUR\"),0\n    failed,permanent,\"wrong-reference\",money(100,\"EUR\") -> error(rule_failed)\n    failed,permanent,\"provider-test\",money(90,\"EUR\") -> error(rule_failed)\n  # Review one definite failed collection or refund by reobserving its original provider reference. @{nl=\"Beoordeel één definitief mislukte inning of terugbetaling door de oorspronkelijke providerreferentie opnieuw waar te nemen.\"}\n  scenario review_attempt(attempt:Attempt label=label_Attempt,reason:text label=\"Review reason\"@{nl=\"Beoordelingsreden\"}) by=finance label=\"Review payment outcome\"@{nl=\"Betalingsresultaat beoordelen\"}\n   require can_work(actor,attempt.parent.location) and attempt.status==failed and trim(reason)!=\"\"\n   require not any(attempt.PaymentRequest as request,request.kind==reconcile and request.reconciliation?.status==pending)\n   do\n    send Payments.reconcile {reference=attempt.reference} as delivery\n    create PaymentRequest {parent=attempt,kind=reconcile,reconciliation=delivery,review_reason=reason,reviewed_by=actor,reviewed_at=now} as request\n   examples seed=[history_worker] attempt=test_payment reason=\"Check the provider's current failure evidence\"\n    as,test_payment.status,test_payment.failure,reason -> test_payment.status,test_payment.failure,count(test_payment.PaymentRequest),first(test_payment.PaymentRequest as request order=request.id)?.review_reason,first(test_payment.PaymentRequest as request order=request.id)?.reviewed_by,first(test_payment.PaymentRequest as request order=request.id)?.reviewed_at==now,first(test_payment.PaymentRequest as request order=request.id)?.reconciliation?.status\n    history_user,failed,permanent,\"Check the provider's current failure evidence\" -> failed,permanent,1,\"Check the provider's current failure evidence\",history_user,true,pending\n    history_user,failed,transient,\"Check the provider's current failure evidence\" -> failed,transient,1,\"Check the provider's current failure evidence\",history_user,true,pending\n    history_user,unknown,null,\"Check the provider's current failure evidence\" -> error(rule_failed)\n    history_user,pending,null,\"Check the provider's current failure evidence\" -> error(rule_failed)\n    history_user,succeeded,null,\"Check the provider's current failure evidence\" -> error(rule_failed)\n    history_user,failed,permanent,\" \" -> error(rule_failed)\n    members,failed,permanent,\"Check the provider's current failure evidence\" -> error(forbidden)\n    public,failed,permanent,\"Check the provider's current failure evidence\" -> error(forbidden)\n   examples seed=[history_worker] attempt=test_payment reason=\"Review failed collection\"\n    as,test_payment.status,test_payment.failure,test_invoice.location -> count(test_payment.PaymentRequest)\n    history_user,failed,permanent,outside_site -> error(rule_failed)\n   examples seed=[history_worker,test_credit] attempt=test_refund reason=\"Review failed refund\"\n    as,test_payment.status,test_refund.status,test_refund.failure -> test_refund.status,test_refund.failure,count(test_refund.PaymentRequest),first(test_refund.PaymentRequest as request order=request.id)?.review_reason\n    history_user,succeeded,failed,permanent -> failed,permanent,1,\"Review failed refund\"\n   ## A completed uncertain observation permits another observation of the same payment, never a fresh charge.\n   examples seed=[history_worker,pending_reconciliation] attempt=test_payment reason=\"Recheck completed provider observation\"\n    as,test_payment.status,test_payment.failure,reconciliation_attempt.status,reconciliation_attempt.result,reconciliation_attempt.error -> test_payment.status,test_payment.failure,count(test_payment.PaymentRequest),count(test_payment.PaymentRequest as request where request.review_reason==\"Recheck completed provider observation\" and request.reviewed_by==history_user and request.reviewed_at==now and request.reconciliation?.status==pending)\n    history_user,failed,permanent,pending,null,null -> error(rule_failed)\n    history_user,failed,permanent,unknown,null,null -> failed,permanent,2,1\n    history_user,failed,permanent,failed,null,{code=\"provider\",message=\"Observation unavailable\"} -> failed,permanent,2,1\n    history_user,failed,permanent,skipped,null,null -> failed,permanent,2,1\n    history_user,failed,permanent,succeeded,PaymentState {reference=\"provider-test\",revision=1,provider_reference=null,amount=money(100,\"EUR\"),status=failed,checkout_url=null,failure=permanent},null -> failed,permanent,2,1\n  scenario start_reconciliation on=Attempt.created\n   do\n    for attempt in Attempt as row where row.id==event.id and row.status in [pending,unknown] limit=1\n     schedule format(\"reconcile-{id}\",{id=attempt.id}) at=now+5m event=ReconcileDue {attempt}\n  scenario reconcile on=ReconcileDue\n   do\n    let attempt=event.attempt\n    if attempt.status in [pending,unknown]\n     send Payments.reconcile {reference=attempt.reference} as delivery\n     create PaymentRequest {parent=attempt,kind=reconcile,reconciliation=delivery} as request\n     schedule format(\"reconcile-{id}\",{id=attempt.id}) at=now+5m event=ReconcileDue {attempt}\n   examples event={attempt=test_payment}\n    test_payment.status -> count(test_payment.PaymentRequest)\n    pending -> 1\n    unknown -> 1\n    succeeded -> 0\n    failed -> 0\n  scenario automatic_collection on=CollectionDue\n   do\n    let invoice=event.invoice\n    if invoice.state==issued and invoice.balance.minor>0 and invoice.consent!=null and invoice.retry_until!=null and now<=invoice.retry_until and not any(BillingCancellation as fence,fence.source==invoice.source)\n     set invoice {next_collection=null}\n     if not any(invoice.Attempt as attempt,attempt.kind==collection and (attempt.status in [pending,unknown] or (attempt.status==failed and attempt.failure!=transient))) and count(invoice.Attempt as attempt where attempt.kind==collection and attempt.mode==automatic)<invoice.attempt_limit\n      create Attempt {parent=invoice,reference=operation.id,amount=invoice.balance,kind=collection,mode=automatic} as attempt\n      send Payments.collect {customer=invoice.parent.id,amount=attempt.amount,reference=attempt.reference,consent=invoice.consent} when=invoice.state==issued and invoice.balance==attempt.amount and invoice.consent!=null and not attempt.disabled and invoice.retry_until!=null and now<=invoice.retry_until as delivery\n      set attempt {delivery=delivery.id}\n      set invoice {ledger_revision=invoice.ledger_revision+1}\n      emit InvoiceSettlement {value=settlement(invoice)}\n   examples seed=[test_payment] event={invoice=test_invoice}\n    test_invoice.consent,test_invoice.retry_until,test_payment.mode,test_payment.status,test_payment.failure,test_invoice.attempt_limit -> count(test_invoice.Attempt)\n    \"mandate\",datetime(\"2099-01-20T00:00:00Z\"),automatic,failed,transient,3 -> 2\n    \"mandate\",datetime(\"2099-01-20T00:00:00Z\"),automatic,failed,transient,1 -> 1\n    \"mandate\",datetime(\"2099-01-20T00:00:00Z\"),automatic,unknown,null,3 -> 1\n    \"mandate\",datetime(\"2099-01-20T00:00:00Z\"),automatic,failed,action_required,3 -> 1\n    null,datetime(\"2099-01-20T00:00:00Z\"),automatic,failed,transient,3 -> 1\n    \"mandate\",datetime(\"2020-01-20T00:00:00Z\"),automatic,failed,transient,3 -> 1\n  scenario overdue on=Overdue\n   require event.invoice.state==issued and event.invoice.balance.minor>0\n   do send Mail.send {to=event.invoice.recipient_email,subject=format(\"Invoice overdue\"@{nl=\"Factuur achterstallig\"},locale=null),body=event.invoice.description+\" \"+app_url(format(\"/finance/invoice/{invoice}\",{invoice=event.invoice.id}))} when=event.invoice.state==issued and event.invoice.balance.minor>0 as notice\n   examples seed=[test_payment] event={invoice=test_invoice,revision=1}\n    test_payment.status -> test_invoice.balance\n    failed -> money(100,\"EUR\")\n    succeeded -> error(rule_failed)\n  # Review complete customer payment history before allowing a first-customer claim. @{nl=\"Beoordeel de volledige betaalhistoriek van de klant voordat een eersteklantaanspraak wordt toegestaan.\"}\n  scenario review_commercial_history(customer:Customer,complete:bool,first_invoice:Invoice?,evidence:text) by=finance label=\"Review customer commercial history\"@{nl=\"Commerciële klanthistoriek beoordelen\"}\n   require all(customer.locations as location,can_work(actor,location)) and trim(evidence)!=\"\"\n   require first_invoice==null or (first_invoice.parent==customer and first_invoice.received.minor>0)\n   require not complete or (all(customer.Invoice as invoice,invoice.received.minor==0 or first_receipt(invoice)!=null) and first_invoice==first_paid_invoice(customer))\n   do\n    let history=first(customer.CommercialHistory as history order=history.id)\n    if history==null\n     create CommercialHistory {parent=customer,complete,first_invoice,evidence} as history\n    else\n     set history {complete,first_invoice,evidence}\n    for sale in customer.CommercialSale as sale limit=500\n     emit SaleCheck {sale}\n   examples seed=[test_worker,test_external] customer=test_company complete=true first_invoice=test_invoice evidence=\"Reviewed complete ledger\"\n    as,complete -> count(customer.CommercialHistory)\n    finance,true -> 1\n    finance,false -> 1\n    members,true -> error(forbidden)\n  scenario observe_commercial_payment on=InvoiceSettlement\n   do\n    for invoice in Invoice as invoice where invoice.id==event.value.invoice limit=1\n     if invoice.received.minor>0\n      let history=first(invoice.parent.CommercialHistory as history order=history.id)\n      if history==null\n       create CommercialHistory {parent=invoice.parent,complete=false,first_invoice=first_paid_invoice(invoice.parent),evidence=\"Unreviewed customer payment history\"} as history\n      else\n       if history.first_invoice==null\n        set history {first_invoice=first_paid_invoice(invoice.parent)}\n      if invoice.first_paid_at==null\n       let received=first_receipt(invoice)\n       if received!=null\n        set invoice {first_paid_at=received}\n     for sale in invoice.parent.CommercialSale as sale limit=500\n      emit SaleCheck {sale}\n  scenario observe_commercial_sale on=SalesRequests.observed\n   require event.value.revision>0 and event.value.amount.minor>0 and event.value.purchased_at<=event.value.occurred and event.value.occurred<=now\n   require (event.value.attribution==null and event.value.exclusive_program==null and event.value.attributed_at==null and event.value.attribution_window==null) or (event.value.attribution!=null and event.value.exclusive_program!=null and event.value.attributed_at!=null and event.value.attribution_window!=null and event.value.attribution_window>0m and event.value.attributed_at<=event.value.purchased_at and event.value.purchased_at<=event.value.attributed_at+event.value.attribution_window)\n   do\n    let customer=first(Customer as customer where customer.id==event.value.customer order=customer.id)\n    require customer!=null\n    let prior=first(customer.CommercialSale as sale where sale.source==event.value.source order=sale.id)\n    if prior==null\n     create CommercialSale {parent=customer,source=event.value.source,value=event.value,source_revision=event.value.revision,reversed=event.value.milestone==reversed} as created_sale\n    else\n     require prior.value.customer==event.value.customer and prior.value.account==event.value.account and prior.value.location==event.value.location and prior.value.product==event.value.product and prior.value.amount==event.value.amount and prior.value.purchased_at==event.value.purchased_at and prior.value.attribution==event.value.attribution and prior.value.exclusive_program==event.value.exclusive_program and prior.value.attributed_at==event.value.attributed_at and prior.value.attribution_window==event.value.attribution_window\n     if event.value.revision==prior.source_revision\n      require prior.value==event.value\n     if event.value.revision>prior.source_revision\n      set prior {value=event.value,source_revision=event.value.revision,reversed=prior.reversed or event.value.milestone==reversed}\n    let sale=first(customer.CommercialSale as sale where sale.source==event.value.source order=sale.id)\n    require sale!=null\n    emit SaleCheck {sale}\n   examples seed=[commercial_sale] event={value=commercial_sale.value}\n    event.value.revision,event.value.product,event.value.milestone -> commercial_sale.source_revision,commercial_sale.reversed\n    1,\"meeting\",completed -> 1,false\n    2,\"meeting\",reversed -> 2,true\n    1,\"office\",completed -> error(rule_failed)\n  scenario publish_commercial_qualification on=SaleCheck\n   do\n    let sale=event.sale\n    let invoice=first(sale.parent.Invoice as invoice where invoice.source==sale.source order=invoice.id)\n    if invoice!=null\n     require invoice.parent.id==sale.value.customer and invoice.location.id==sale.value.location and invoice.currency==sale.value.amount.currency and invoice.total+sum(invoice.Credit as credit select credit.amount,invoice.currency)==sale.value.amount\n     let history=first(sale.parent.CommercialHistory as history order=history.id)\n     let known=history!=null and history.complete and history.first_invoice==first_paid_invoice(sale.parent) and all(sale.parent.Invoice as invoice,invoice.received.minor==0 or first_receipt(invoice)!=null)\n     let paid_at=first_receipt(invoice)\n     let first_customer=known and history.first_invoice==invoice and sale.value.attributed_at!=null and invoice.first_paid_at!=null and paid_at!=null and sale.value.attributed_at<=paid_at\n     if sale.reversed or invoice.refunded.minor>0 or invoice.state==void\n      set sale {reversed=true}\n     if sale.reversed or (invoice.state==issued and invoice.received>=sale.value.amount and invoice.refunded.minor==0 and not invoice.collection_pending and not invoice.refund_pending and not invoice.needs_review)\n      if sale.reversed\n       set sale {effective=reversed}\n      else\n       set sale {effective=sale.value.milestone}\n      let value=Qualification {source=sale.source,revision=sale.revision+1,customer=sale.value.customer,account=sale.value.account,location=sale.value.location,product=sale.value.product,amount=sale.value.amount,purchased_at=sale.value.purchased_at,occurred=sale.value.occurred,milestone=sale.effective,attribution=sale.value.attribution,exclusive_program=sale.value.exclusive_program,attributed_at=sale.value.attributed_at,attribution_window=sale.value.attribution_window,first_customer,history_known=known}\n      if sale.last==null or sale.last.milestone!=value.milestone or sale.last.first_customer!=value.first_customer or sale.last.history_known!=value.history_known\n       set sale {revision=value.revision,last=value}\n       emit SaleQualification {value}\n   examples seed=[test_external,customer_history] event={sale=commercial_sale}\n    customer_history.complete,test_invoice.first_paid_at,commercial_sale.reversed -> commercial_sale.last?.milestone,commercial_sale.last?.first_customer\n    true,datetime(\"2026-10-01T00:00:00Z\"),false -> completed,true\n    false,datetime(\"2026-10-01T00:00:00Z\"),false -> completed,false\n    true,null,false -> completed,false\n    true,datetime(\"2026-10-01T00:00:00Z\"),true -> reversed,true\n  scenario source_charge on=BillingRequests.charge\n   require event.value.amount.minor>=0 and not any(BillingCancellation as fence,fence.source==event.value.source)\n   do\n    let customer=first(Customer as customer where customer.id==event.value.customer order=customer.id)\n    let location=first(Location as location where location.id==event.value.location order=location.id)\n    let defaults=first(Defaults as setting order=setting.id)\n    require customer!=null and customer.active and location!=null and location in customer.locations and defaults!=null and defaults.retry_delay>0m and defaults.retry_window>0m and event.value.amount.currency==location.currency\n    let profile=first(customer.BillingProfile as profile order=profile.id)\n    require profile!=null\n    let previous=first(Invoice as invoice where invoice.source==event.value.source order=invoice.id)\n    if previous!=null\n     require previous.parent==customer and previous.location==location and previous.total==event.value.amount and previous.description==event.value.description and previous.due==event.value.due and previous.consent==event.value.consent and previous.terms==event.value.terms and previous.source_items==event.value.items and (event.value.issuer==null or previous.issuer==event.value.issuer)\n     emit ChargeOutcome {value={source=previous.source,revision=previous.ledger_revision,state=confirmed,reference=previous.id}}\n    else\n     create Invoice {parent=customer,location,source=event.value.source,issuer=event.value.issuer??defaults.issuer,recipient=customer.name,recipient_email=profile.contact.email,address=profile.address,tax_reference=profile.tax_reference,currency=location.currency,description=event.value.description,terms=event.value.terms,source_items=event.value.items,due=event.value.due,total=event.value.amount,consent=event.value.consent,number=format(\"INV-{source}\",{source=event.value.source}),attempt_limit=defaults.attempt_limit,retry_delay=defaults.retry_delay,retry_until=now+defaults.retry_window} as invoice\n     if event.value.items==null\n      create Line {parent=invoice,description=event.value.description,position=1,price=event.value.amount,tax=money(0,location.currency),discount=money(0,location.currency),service_location=location.id,service_reference=event.value.source} as line\n     else\n      require count(event.value.items)>0 and all(event.value.items as item,item.price.currency==location.currency and item.tax.currency==location.currency and item.discount.currency==location.currency)\n      require sum(event.value.items as item select item.price*item.quantity+item.tax-item.discount,location.currency)==event.value.amount\n      for item in event.value.items limit=100\n       create Line {parent=invoice,description=item.title,position=count(invoice.Line)+1,quantity=item.quantity,unit=item.unit,service_from=item.from,service_until=item.until,service_location=item.location,service_reference=item.reference,price=item.price,tax=item.tax,discount=item.discount} as line\n     set invoice {state=issued,issued_at=now,ledger_revision=1}\n     if invoice.consent!=null and invoice.balance.minor>0\n      set invoice {next_collection=now}\n      schedule format(\"{invoice}:collection\",{invoice=invoice.id}) at=now event=CollectionDue {invoice}\n     emit InvoiceSettlement {value=settlement(invoice)}\n     schedule invoice.id at=local_instant(add_days(invoice.due,1),\"00:00\",invoice.location.timezone,fold=earlier) event=Overdue {invoice,revision=1}\n     emit ChargeOutcome {value={source=invoice.source,revision=invoice.ledger_revision,state=confirmed,reference=invoice.id}}\n     send Mail.send {to=invoice.recipient_email,subject=format(notice_invoice_issued,locale=null),body=invoice.description+\" \"+app_url(format(\"/finance/invoice/{invoice}\",{invoice=invoice.id}))} when=invoice.state==issued as notice\n   examples seed=[test_defaults,test_profile,test_contact,test_invoice] event={value=Charge {source=\"invoice-test\",customer=test_company.id,location=test_site.id,description=\"Room\",amount=money(100,\"EUR\"),due=date(\"2099-01-02\"),issuer=\"Operator\",terms=null,items=null,consent=null}}\n    event.value.amount,event.value.description -> count(Invoice),test_invoice.total\n    money(100,\"EUR\"),\"Room\" -> 1,money(100,\"EUR\")\n    money(90,\"EUR\"),\"Room\" -> error(rule_failed)\n    money(100,\"EUR\"),\"Changed service\" -> error(rule_failed)\n  scenario source_cancel on=BillingRequests.cancel\n   require trim(event.reason)!=\"\"\n   do\n    if not any(BillingCancellation as fence,fence.source==event.source)\n     create BillingCancellation {source=event.source,reason=event.reason} as fence\n    let invoice=first(Invoice as row where row.source==event.source order=row.id)\n    if invoice==null\n     emit CancelOutcome {value={source=event.source,revision=1,state=released,reference=null,detail=null}}\n    else\n     for attempt in invoice.Attempt as pending where pending.kind==collection and pending.status in [pending,unknown] limit=100\n      set attempt {disabled=true,checkout=null}\n      send Payments.cancel {reference=attempt.reference} as delivery\n      create PaymentRequest {parent=attempt,kind=cancel,cancellation=delivery} as request\n     set invoice {next_collection=null}\n     cancel invoice.id\n     cancel format(\"{invoice}:collection\",{invoice=invoice.id})\n     if invoice.received.minor>0\n      set invoice {needs_review=true,ledger_revision=invoice.ledger_revision+1}\n      emit CancelOutcome {value={source=event.source,revision=invoice.ledger_revision,state=unavailable,reference=invoice.id,detail=\"Collected funds require an evidenced refund\"}}\n     else\n      if any(invoice.Attempt as attempt,attempt.status in [pending,unknown])\n       set invoice {state=void_pending,ledger_revision=invoice.ledger_revision+1}\n       emit CancelOutcome {value={source=event.source,revision=invoice.ledger_revision,state=pending,reference=invoice.id,detail=null}}\n      else\n       set invoice {state=void,ledger_revision=invoice.ledger_revision+1}\n       emit CancelOutcome {value={source=event.source,revision=invoice.ledger_revision,state=released,reference=invoice.id,detail=null}}\n     emit InvoiceSettlement {value=settlement(invoice)}\n   examples seed=[test_payment] event={source=\"invoice-test\",reason=\"Source cancelled\"}\n    test_payment.status -> test_invoice.state,test_payment.disabled\n    unknown -> void_pending,true\n    failed -> void,false\n    succeeded -> issued,false\n  scenario source_refund on=BillingRequests.refund\n   require trim(event.reason)!=\"\" and event.amount.minor>0\n   do\n    let invoice=first(Invoice as row where row.source==event.source order=row.id)\n    require invoice!=null and event.amount.currency==invoice.currency and event.amount<=invoice.received-invoice.refunded\n    require not any(invoice.Attempt as attempt,attempt.status in [pending,unknown])\n    let extra_credit=max([money(0,invoice.currency),event.amount-invoice.refund_due])\n    if extra_credit.minor>0\n     create Credit {parent=invoice,source=operation.id,amount=extra_credit,reason=event.reason,author=null} as credit\n    let payment=first(invoice.Attempt as candidate where candidate.kind==collection and candidate.status==succeeded and event.amount<=candidate.amount-sum(invoice.Attempt as old where old.kind==refund and old.payment==candidate.reference and old.status==succeeded select old.amount,invoice.currency) order=candidate.received)\n    if payment==null\n     set invoice {needs_review=true,ledger_revision=invoice.ledger_revision+1}\n     emit InvoiceSettlement {value=settlement(invoice)}\n     emit RefundOutcome {value={source=invoice.source,revision=invoice.ledger_revision,state=unavailable,reference=invoice.id,detail=\"Finance must evidence external or split refunds against original payments\"}}\n    else\n     create Attempt {parent=invoice,reference=operation.id,amount=event.amount,kind=refund,payment=payment.reference,reason=event.reason} as refund\n     send Payments.refund {payment=payment.reference,amount=event.amount,reference=refund.reference} as delivery\n     set refund {delivery=delivery.id}\n     set invoice {ledger_revision=invoice.ledger_revision+1}\n     emit InvoiceSettlement {value=settlement(invoice)}\n     emit RefundOutcome {value={source=invoice.source,revision=invoice.ledger_revision,state=pending,reference=refund.reference,detail=null}}\n  scenario source_reconcile on=BillingRequests.reconcile\n   do\n    let invoice=first(Invoice as row where row.source==event.source order=row.id)\n    if invoice==null\n     emit ReconcileOutcome {source=event.source,value=null}\n    else\n     require invoice.state!=draft\n     emit ReconcileOutcome {source=event.source,value=settlement(invoice)}\n Then\n  # Read retained invoices and reviewed booking relationships under current billing access. @{nl=\"Lees bewaarde facturen en beoordeelde reserveringsrelaties met huidige factuurtoegang.\"}\n  page /finance/invoice-history title=\"Historical invoice evidence\"@{nl=\"Historisch factuurbewijs\"}\n   require authenticated\n   breadcrumbs\n   card \"Retain source invoices\"@{nl=\"Bronfacturen bewaren\"}\n    require finance\n    form retain_legacy import=csv review=legacy_matches\n     fieldset\n      input source\n      input external_id\n      select location\n      file_input document\n      textarea document_issue\n      file_input source_evidence\n      textarea attestation\n   form legacy_matches\n    list result columns=source,external_id,location empty=\"No historical invoices match this lookup\"@{nl=\"Geen historische facturen voldoen aan deze zoekopdracht\"}\n     copy row.source\n     copy row.external_id\n     pagination\n   table LegacyInvoice archived=include as entry columns=source,external_id,location empty=\"No historical invoices retained yet\"@{nl=\"Nog geen historische facturen bewaard\"} display=split\n    copy entry.source\n    copy entry.external_id\n    text entry.facts.number,entry.facts.issuer,entry.facts.recipient,entry.facts.issued_original,entry.facts.issued_at,entry.facts.due_original,entry.facts.due,entry.facts.status,entry.facts.payment,entry.facts.amount,entry.facts.booking_count,entry.document_issue,entry.customer\n    card\n     require entry.document!=null\n     link target=entry.document caption=\"Original invoice document\"@{nl=\"Oorspronkelijk factuurdocument\"}\n    table entry.LegacyInvoiceBooking archived=include columns=booking_source,booking_external_id,booking empty=\"No booking links retained for this invoice\"@{nl=\"Geen reserveringskoppelingen bewaard voor deze factuur\"}\n     card \"Resolve retained booking evidence\"@{nl=\"Bewaard reserveringsbewijs koppelen\"}\n      require finance\n      button opens=legacy_booking_resolve\n      text row.mapping_reason,row.attestation,row.source_evidence\n      modal \"Resolve invoice booking link\"@{nl=\"Factuur-reserveringskoppeling oplossen\"} id=legacy_booking_resolve\n       slot content\n        form link_legacy_booking arguments={edge=row} display=inline\n         fieldset\n          textarea reason\n     pagination\n    card \"Current customer mapping and original export\"@{nl=\"Huidige klantkoppeling en oorspronkelijke export\"}\n     require finance\n     join\n      button opens=legacy_map\n      button opens=legacy_edge_retain\n     link target=entry.source_evidence caption=\"Original source artifact\"@{nl=\"Oorspronkelijk bronbestand\"}\n     text entry.mapping_reason,entry.attestation,entry.imported_by,entry.imported_at\n     modal \"Map historical invoice customer\"@{nl=\"Historische factuur aan klant koppelen\"} id=legacy_map\n      slot content\n       form link_legacy arguments={entry=row} display=inline\n        fieldset\n         select customer\n         textarea reason\n     modal \"Retain invoice booking link\"@{nl=\"Factuur-reserveringskoppeling bewaren\"} id=legacy_edge_retain\n      slot content\n       form retain_legacy_booking arguments={entry=row} display=inline\n        fieldset\n         input booking_source\n         input booking_external_id\n         file_input source_evidence\n         textarea attestation\n         textarea reason\n     history\n    pagination\n  # Keep own issued invoices and payment outcomes reachable after membership expiry. @{nl=\"Houd eigen uitgegeven facturen en betalingsresultaten bereikbaar na afloop van het lidmaatschap.\"}\n  page /finance/my-invoices title=\"My invoices\"@{nl=\"Mijn facturen\"}\n   require authenticated\n   breadcrumbs\n   card \"Issued invoices\"@{nl=\"Uitgegeven facturen\"}\n    list Invoice as invoice where invoice.state!=draft and (owns(actor,invoice.parent) or has_role(actor,invoice.parent,billing)) order=-issued_at filter=location,currency empty=\"No own invoices match these filters\"@{nl=\"Geen eigen facturen voldoen aan deze filters\"} defaults={location=preferences.location,currency=preferences.currency} display=split\n     badge row.state\n     text row.number,row.description,row.total,row.balance,row.settled,row.collection_pending,row.due,row.currency\n     copy row.number\n     actions collect,document,receipt\n     tabs\n      tab \"Documents and lines\"@{nl=\"Documenten en regels\"}\n       table row.Document columns=kind,revision,file,generated empty=\"No documents generated yet\"@{nl=\"Nog geen documenten gegenereerd\"}\n        pagination\n       table row.DocumentRequest columns=kind,revision,status,error empty=\"No document requests yet\"@{nl=\"Nog geen documentaanvragen\"}\n        pagination\n       table row.Line columns=description,quantity,unit,service_from,service_until,service_location,service_reference,price,tax,discount empty=\"No lines on this invoice\"@{nl=\"Geen regels op deze factuur\"}\n        pagination\n      tab \"Own payment outcomes\"@{nl=\"Eigen betalingsresultaten\"}\n       table row.Attempt columns=kind,amount,status,checkout,received empty=\"No payment attempts yet\"@{nl=\"Nog geen betaalpogingen\"}\n        card\n         require row.checkout!=null\n         link target=row.checkout caption=\"Payment link\"@{nl=\"Betaallink\"}\n        pagination\n     history\n     pagination\n  # Review receivables, failed collections, credits and separate refund outcomes. @{nl=\"Bekijk vorderingen, mislukte inningen, credits en afzonderlijke terugbetalingsresultaten.\"}\n  page /finance/invoices title=\"Customer invoices\"@{nl=\"Klantfacturen\"}\n   require finance\n   breadcrumbs\n   card \"Customer selection\"@{nl=\"Klantselectie\"}\n    list Customer empty=\"No customers available\"@{nl=\"Geen klanten beschikbaar\"}\n     form Invoice.create\n      fieldset\n       select location\n       input source\n       input issuer\n       input recipient\n       ## proposed: email as input's \"appropriate scalar\"; checker confirms.\n       input recipient_email\n       input tax_reference\n       textarea address\n       textarea description\n       calendar due\n     pagination\n   card \"Invoice drafts and lines\"@{nl=\"Conceptfacturen en regels\"}\n    table Invoice columns=number,location,recipient,total,balance,refund_due,state,settled,collection_pending,refund_pending,next_collection,due,needs_review filter=location,state,currency,due search=recipient empty=\"No invoices match these filters\"@{nl=\"Geen facturen voldoen aan deze filters\"} defaults={location=preferences.location,currency=preferences.currency} display=split\n     pagination\n     badge row.state\n     edit\n     tabs\n      tab \"Invoice lines\"@{nl=\"Factuurregels\"}\n       form Line.create\n        fieldset\n         textarea description\n         input unit\n       table row.Line columns=description,quantity,unit,service_from,service_until,service_location,service_reference,price,tax,discount empty=\"No lines on this invoice\"@{nl=\"Geen regels op deze factuur\"}\n        edit\n        delete\n        pagination\n      tab \"Collection queue\"@{nl=\"Inningswachtrij\"}\n       text row.due,row.balance,row.next_collection,row.collection_pending,row.refund_pending,row.needs_review\n       actions collect\n       table row.Attempt columns=mode,requested,outcome_at,amount,status,failure,checkout,received empty=\"No attempts recorded yet\"@{nl=\"Nog geen pogingen vastgelegd\"}\n        button opens=attempt_review\n        modal \"Review payment outcome\"@{nl=\"Betalingsresultaat beoordelen\"} id=attempt_review\n         slot content\n          form review_attempt arguments={attempt=row} display=inline\n           fieldset\n            textarea reason\n        table row.PaymentRequest columns=kind,status,review_reason,reviewed_by,reviewed_at empty=\"No observation requests yet\"@{nl=\"Nog geen waarnemingsaanvragen\"}\n         pagination\n        pagination\n      tab \"Collection and refund evidence\"@{nl=\"Innings- en terugbetalingsbewijs\"}\n       actions document,receipt,collect\n       button opens=issue_detail\n       modal \"Issue invoice\"@{nl=\"Factuur uitgeven\"} id=issue_detail\n        slot content\n         form issue arguments={invoice=row} display=inline\n          input number\n       dropdown\n        slot trigger\n         text \"More actions\"@{nl=\"Meer acties\"}\n        slot content\n         button opens=payment_detail\n         modal \"Record external payment\"@{nl=\"Externe betaling registreren\"} id=payment_detail\n          slot content\n           form record_payment arguments={invoice=row} display=inline\n            input amount\n            input reference\n            input received\n            textarea evidence\n         button opens=credit_detail\n         modal \"Credit invoice\"@{nl=\"Factuur crediteren\"} id=credit_detail\n          slot content\n           form credit arguments={invoice=row} display=inline\n            input amount\n            textarea reason\n         button opens=refund_detail\n         modal \"Refund payment\"@{nl=\"Betaling terugbetalen\"} id=refund_detail\n          slot content\n           form refund arguments={invoice=row} display=inline\n            select payment\n            input amount\n            textarea reason\n         button opens=record_refund_detail\n         modal \"Record external refund\"@{nl=\"Externe terugbetaling registreren\"} id=record_refund_detail\n          slot content\n           form record_refund arguments={invoice=row} display=inline\n            select payment\n            input amount\n            input reference\n            input received\n            textarea evidence\n            textarea reason\n         button opens=void_detail\n         modal \"Void invoice\"@{nl=\"Factuur ongeldig maken\"} id=void_detail\n          slot content\n           form void arguments={invoice=row} display=inline\n            textarea reason\n       table row.Attempt columns=mode,requested,outcome_at,kind,amount,status,failure,checkout,received empty=\"No attempts recorded yet\"@{nl=\"Nog geen pogingen vastgelegd\"}\n        table row.PaymentRequest columns=kind,status,review_reason,reviewed_by,reviewed_at empty=\"No observation requests yet\"@{nl=\"Nog geen waarnemingsaanvragen\"}\n         pagination\n        pagination\n       table row.ExternalPayment columns=reference,amount,received,evidence empty=\"No external payments recorded\"@{nl=\"Geen externe betalingen vastgelegd\"}\n        pagination\n       table row.ExternalRefund columns=reference,amount,received,evidence,reason empty=\"No external refunds recorded\"@{nl=\"Geen externe terugbetalingen vastgelegd\"}\n        pagination\n       history\n  # Print the exact issued invoice rather than current customer-directory data. @{nl=\"Druk de exacte uitgegeven factuur af in plaats van huidige gegevens uit het klantenregister.\"}\n  page /finance/invoice/{Invoice.id} title=page_finance_invoice_Invoice_id_title\n   require authenticated\n   breadcrumbs\n   badge row.state\n   card \"Frozen issuer and recipient\"@{nl=\"Vastgelegde uitgever en ontvanger\"}\n    text row.issuer,row.recipient,row.address,row.tax_reference,row.number,row.issued_at,row.due,row.currency\n    copy row.number\n    content row.terms\n   card \"Itemized charges\"@{nl=\"Gespecificeerde kosten\"}\n    table row.Line columns=description,quantity,unit,service_from,service_until,service_location,service_reference,price,tax,discount empty=\"No lines on this invoice\"@{nl=\"Geen regels op deze factuur\"}\n     pagination\n   card \"Balance and refund obligation\"@{nl=\"Saldo en terugbetalingsverplichting\"}\n    metrics row.total,row.credits,row.received,row.refunded,row.balance,row.refund_due\n    text row.settled,row.collection_pending,row.refund_pending\n   card \"Documents and adjustments\"@{nl=\"Documenten en correcties\"}\n    actions document,receipt,collect\n    table row.Document columns=kind,revision,file,generated empty=\"No documents generated yet\"@{nl=\"Nog geen documenten gegenereerd\"}\n     pagination\n    table row.DocumentRequest columns=kind,revision,status,error empty=\"No document requests yet\"@{nl=\"Nog geen documentaanvragen\"}\n     pagination\n    table row.Credit columns=amount,reason empty=\"No credits recorded\"@{nl=\"Geen credits vastgelegd\"}\n     pagination\n    table row.Attempt columns=kind,amount,status,checkout,received,reason empty=\"No attempts recorded yet\"@{nl=\"Nog geen pogingen vastgelegd\"}\n     pagination\n   card \"Customer commercial history\"@{nl=\"Commerciële klanthistoriek\"}\n    require finance\n    table row.parent.CommercialHistory columns=complete,first_invoice,evidence empty=\"No commercial history reviewed yet\"@{nl=\"Nog geen commerciële historiek beoordeeld\"}\n     pagination\n    form review_commercial_history arguments={customer=row.parent}\n     fieldset\n      checkbox complete\n      textarea evidence\n   history\n"}}
