{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"0cb003f9024d9f2ca7d5c1cc5c784bdc2096eb166c2a54e1f10327c2daf0c9de","before_projection_sha256":"0cb003f9024d9f2ca7d5c1cc5c784bdc2096eb166c2a54e1f10327c2daf0c9de","changed":false,"idempotent":true,"structure_equal":true,"text":"# Help workspace HR and location managers prepare new employees for reception, sales, community, and facilities duties. @{nl=\"Help HR en locatiemanagers nieuwe medewerkers voor receptie-, verkoop-, community- en facilitaire taken voor te bereiden.\"}\napp CanOnboard uses=[employee,onboard]\n\n# Own employee work identity and private, versioned onboarding checklists. @{nl=\"Beheer de werkidentiteit van medewerkers en private, geversioneerde inwerkchecklists.\"}\npackage onboard label=page_people_onboarding_title\n use rent_catalog {Location,test_site}\n use employee {Employee,hr,test_worker,deactivate,can_work,staff}\n Given\n  export contract WorkItem { reference:text, revision:int, location:text?, title:text, detail:text?, due:datetime?, action:action(complete) } label=\"Authorized work item\"@{nl=\"Toegestaan werkitem\"}\n  export contract WorkBatch { items:WorkItem[]! max=500 } label=\"Authorized work batch\"@{nl=\"Toegestane werkverzameling\"}\n  message page_people_onboarding_title = \"Onboarding\"@{nl=\"Inwerken\"}\n  preferences { home:Location? label=\"Home location\"@{nl=\"Standplaats\"}, view:enum(all,unfinished,overdue)=all label={text=\"Step view\"@{nl=\"Stappenweergave\"},values={all=\"All steps\"@{nl=\"Alle stappen\"},unfinished=\"Unfinished steps\"@{nl=\"Onafgeronde stappen\"},overdue=\"Overdue steps\"@{nl=\"Achterstallige stappen\"}}} }\n  export Template { name:text, role:text label=\"Role\"@{nl=\"Rol\"}, location:Location, active:bool=true label=\"Available template\"@{nl=\"Beschikbare template\"}, revision:int=1 } label=\"Checklist template\"@{nl=\"Checklisttemplate\"}\n  TemplateStep in Template { title:text trim min=1, offset_days:int=0 label=\"Offset in days\"@{nl=\"Verschuiving in dagen\"}, category:enum(equipment,induction,account,training)=induction label={text=\"Category\"@{nl=\"Categorie\"},values={equipment=\"Equipment\"@{nl=\"Uitrusting\"},induction=\"Induction\"@{nl=\"Introductie\"},account=\"Account\"@{nl=\"Account\"},training=\"Training\"@{nl=\"Opleiding\"}}} } label=\"Template step\"@{nl=\"Templatestap\"}\n  Checklist in Employee { template:Template, template_version:int label=\"Template version\"@{nl=\"Templateversie\"}, started:date label=\"Started on\"@{nl=\"Gestart op\"}, generation:text unique label=\"Generation reference\"@{nl=\"Generatiereferentie\"} } label=\"Onboarding checklist\"@{nl=\"Inwerkchecklist\"}\n  export Step in Checklist { title:text trim min=1, due:date, assignee:user=parent.parent.user label=\"Assignee\"@{nl=\"Toegewezen persoon\"}, category:TemplateStep.category, document:file? label=\"Document attachment\"@{nl=\"Documentbijlage\"}, blocked_reason:text? label=\"Blocking reason\"@{nl=\"Blokkeerreden\"}, done:bool=false, completed_by:user? label=\"Completed by\"@{nl=\"Afgerond door\"}, completed_at:datetime? label=\"Completed at\"@{nl=\"Afgerond op\"} } label=\"Onboarding step\"@{nl=\"Inwerkstap\"}\n  derive can_complete(step:Step):bool = step.parent.parent.active and (hr or (authenticated and step.assignee==actor and staff(actor))) and not step.done and step.blocked_reason==null\n  derive Checklist.completed_steps:int = count(row.Step as s where s.done) label=\"Completed steps\"@{nl=\"Afgeronde stappen\"}\n  derive Checklist.total_steps:int = count(row.Step) label=\"Active steps\"@{nl=\"Actieve stappen\"}\n  derive Checklist.progress:decimal = count(row.Step as s where s.done)*100/max([1,count(row.Step)]) label=\"Progress\"@{nl=\"Voortgang\"}\n  policy Template read=hr or (members and can_work(actor,row.location))\n  policy TemplateStep read=hr or (members and can_work(actor,row.parent.location))\n  policy Checklist read=hr or (authenticated and row.parent.user==actor)\n  policy Step read=hr or (authenticated and (row.assignee==actor or row.parent.parent.user==actor))\n  invariant Step: not row.done or (row.completed_at!=null and row.completed_by!=null)\n  lock Checklist fields=template,template_version,started,generation\n  export fixture test_template=Template {name=\"Opening\",role=\"operator\",location=test_site}\n  fixture test_checklist=Checklist {parent=test_worker,template=test_template,template_version=1,started=date(\"2026-10-01\"),generation=\"test-onboarding\"}\n  fixture hr_user=user {roles=[hr]}\n  fixture assigned_user=user {}\n  fixture assigned_worker=Employee {user=assigned_user,home=test_site,locations=[test_site],start=date(\"2026-10-01\"),role=\"operator\"}\n  fixture opening_step=TemplateStep {parent=test_template,title=\"Induction\",offset_days=2,category=induction}\n  fixture test_step=Step {parent=test_checklist,title=\"Induction\",due=date(\"2026-10-03\"),assignee=self,category=induction}\n When\n  crud Template by=hr fields=name,role,location,active create_fields=name,role,location\n  crud TemplateStep by=hr fields=title,offset_days,category delete=remove\n  crud Step by=hr fields=title,due,assignee,category,document,blocked_reason when=row.parent.parent.active and active_member(row.assignee,team)\n   examples create parent=test_checklist title=\"Manual induction\" due=date(\"2026-10-03\") category=induction\n    as -> count(test_checklist.Step),first(test_checklist.Step)?.assignee\n    hr -> 1,self\n   examples create seed=[assigned_worker] parent=test_checklist title=\"Assigned equipment\" due=date(\"2026-10-03\") category=equipment assignee=assigned_user\n    as -> count(test_checklist.Step),first(test_checklist.Step)?.assignee\n    hr -> 1,assigned_user\n  scenario template_changed on=Template.update\n   do set event.after {revision=event.before.revision+1}\n  scenario template_step_created on=TemplateStep.create\n   do set event.after.parent {revision=event.after.parent.revision+1}\n  scenario template_step_changed on=TemplateStep.update\n   do set event.after.parent {revision=event.after.parent.revision+1}\n  scenario template_step_removed on=TemplateStep.delete\n   do set event.before.parent {revision=event.before.parent.revision+1}\n  # Copy a current role/location template once without changing existing checklists. @{nl=\"Kopieer een huidige rol- en locatietemplate één keer zonder bestaande checklists te wijzigen.\"}\n  export scenario start(employee:Employee,template:Template) by=hr label=\"Start\"@{nl=\"Starten\"}\n   require employee.active and active_member(employee.user,team) and template.active and employee.role==template.role and employee.home==template.location\n   do\n    create Checklist {parent=employee,template,template_version=template.revision,started=employee.start,generation=operation.id} as checklist\n    for source in template.TemplateStep limit=100\n     create Step {parent=checklist,title=source.title,due=add_days(employee.start,source.offset_days),category=source.category} as step\n   examples seed=[test_worker] employee=test_worker template=test_template\n    as,employee.active,template.active -> count(employee.Checklist)\n    hr,true,true -> 1\n    hr,false,true -> error(rule_failed)\n    hr,true,false -> error(rule_failed)\n    members,true,true -> error(forbidden)\n   examples seed=[test_worker,test_template,opening_step,assigned_worker,hr_user]\n    do\n     call start {employee=test_worker,template=test_template} by=hr_user\n     let copied=first(test_worker.Checklist)\n     copied!=null -> true\n     let initial=first(copied.Step)\n     initial!=null -> true\n     initial.title,initial.due,initial.assignee,copied.total_steps,copied.completed_steps -> \"Induction\",date(\"2026-10-03\"),self,1,0\n     call TemplateStep.update {record=opening_step,changes={title=\"Revised induction\"}} by=hr_user\n     let independent=first(copied.Step)\n     independent!=null -> true\n     independent.title -> \"Induction\"\n     call Step.update {record=independent,changes={assignee=assigned_user,blocked_reason=\"Equipment pending\"}} by=hr_user\n     let blocked=first(copied.Step)\n     blocked!=null -> true\n     call complete {step=blocked} by=assigned_user -> error(rule_failed)\n     blocked.done,blocked.blocked_reason -> false,\"Equipment pending\"\n     call Step.update {record=blocked,changes={blocked_reason=null}} by=hr_user\n     let ready=first(copied.Step)\n     ready!=null -> true\n     call complete {step=ready} by=assigned_user\n     let completed=first(copied.Step)\n     completed!=null -> true\n     completed.done,completed.completed_by,completed.completed_at!=null,copied.completed_steps,copied.total_steps -> true,assigned_user,true,1,1\n     call reopen {step=completed,reason=\"Equipment correction\"} by=hr_user\n     let reopened=first(copied.Step)\n     reopened!=null -> true\n     reopened.done,reopened.completed_by,reopened.completed_at,reopened.blocked_reason,copied.completed_steps -> false,null,null,\"Equipment correction\",0\n     call Step.delete {record=reopened} by=hr_user\n     count(copied.Step),copied.total_steps,copied.completed_steps -> 0,0,0\n     call Step.create {parent=copied,title=\"Equipment\",due=date(\"2026-10-03\"),category=equipment} by=hr_user\n     let manual=first(copied.Step)\n     manual!=null -> true\n     manual.assignee,copied.total_steps -> self,1\n     call Step.update {record=manual,changes={assignee=assigned_user}} by=hr_user\n     let reassigned=first(copied.Step)\n     reassigned!=null -> true\n     call deactivate {employee=assigned_worker,ended=date(\"2026-10-03\")} by=hr_user\n     call complete {step=reassigned} by=assigned_user -> error(rule_failed)\n     call work {locations=[]} by=assigned_user as remaining\n     count(remaining.items),test_worker.active,assigned_worker.active -> 0,true,false\n     call work_detail {record=reassigned} by=assigned_user -> error(rule_failed)\n     call complete {step=reassigned} by=hr_user\n     let recovered=first(copied.Step)\n     recovered!=null -> true\n     recovered.done,recovered.completed_by -> true,hr_user\n     call deactivate {employee=test_worker,ended=date(\"2026-10-03\")} by=hr_user\n     call reopen {step=recovered,reason=\"After employment end\"} by=hr_user -> error(rule_failed)\n  # Record completion by the assigned employee or HR independently of document upload. @{nl=\"Registreer afronding door de toegewezen medewerker of HR onafhankelijk van documentupload.\"}\n  export scenario complete(step:Step) by=hr or authenticated\n   require can_complete(step)\n   do set step {done=true,completed_by=actor,completed_at=now}\n   examples seed=[test_worker] step=test_step\n    as,step.assignee,step.blocked_reason -> step.done\n    members,self,null -> true\n    members,other,null -> error(rule_failed)\n    members,self,\"Equipment missing\" -> error(rule_failed)\n  # Reopen a completed step with an attributed reason. @{nl=\"Heropen een afgeronde stap met een herleidbare reden.\"}\n  scenario reopen(step:Step,reason:text) by=hr\n   require step.parent.parent.active and step.done and trim(reason)!=\"\"\n   do set step {done=false,completed_by=null,completed_at=null,blocked_reason=reason}\n   examples step=test_step reason=\"Equipment correction\"\n    as,step.done,step.completed_by,step.completed_at -> step.done,step.blocked_reason\n    hr,true,self,datetime(\"2026-10-03T12:00:00Z\") -> false,\"Equipment correction\"\n    hr,false,null,null -> error(rule_failed)\n    members,false,null,null -> error(forbidden)\n  # Return only current eligible work under the canonical completion authority. @{nl=\"Geef alleen actueel uitvoerbaar werk terug binnen de canonieke afrondingsbevoegdheid.\"}\n  export scenario work(locations:text[]) read=true scope=authority -> WorkBatch by=hr or authenticated\n   do return WorkBatch {items=Step as item where can_complete(item) and (count(locations)==0 or item.parent.parent.home.id in locations) select WorkItem {reference=item.id,revision=item.version,location=item.parent.parent.home.id,title=item.title,detail=null,due=local_instant(item.due,\"00:00\",team.timezone,fold=earlier),action=action(complete,{step=item})}}\n  # Revalidate the selected item before presenting its protected canonical action. @{nl=\"Controleer het gekozen item opnieuw voordat de beschermde canonieke actie wordt getoond.\"}\n  export scenario work_detail(record:Step) read=true scope=authority -> WorkItem by=hr or authenticated\n   require can_complete(record)\n   do return WorkItem {reference=record.id,revision=record.version,location=record.parent.parent.home.id,title=record.title,detail=null,due=local_instant(record.due,\"00:00\",team.timezone,fold=earlier),action=action(complete,{step=record})}\n Then\n  # Follow your assigned readiness work and private attachments. @{nl=\"Volg je toegewezen inwerkstappen en private bijlagen.\"}\n  page /people/my-readiness title=\"My readiness\"@{nl=\"Mijn inwerkstappen\"}\n   require authenticated\n   breadcrumbs\n   card \"Assigned readiness steps\"@{nl=\"Toegewezen inwerkstappen\"}\n    tabs preferences.view\n    list Step as step where step.assignee==actor and (preferences.view==all or (preferences.view==unfinished and not step.done) or (preferences.view==overdue and not step.done and step.due<local_date(now,team.timezone))) order=step.due empty=\"No assigned steps\"@{nl=\"Geen toegewezen stappen\"}\n     badge row.category\n     text row.title,row.due,row.done\n     alert\n      require row.blocked_reason!=null\n      text row.blocked_reason\n     card \"Attachment\"@{nl=\"Bijlage\"}\n      require row.document!=null\n      link target=row.document caption=\"Open attachment\"@{nl=\"Bijlage openen\"}\n     text row.completed_by,row.completed_at\n     action complete\n     pagination\n\n  # Prepare work identities and role/location checklists under HR document grants. @{nl=\"Bereid werkidentiteiten en rol- en locatiechecklists voor binnen HR-documentrechten.\"}\n  page /people/onboarding title=page_people_onboarding_title\n   require hr\n   breadcrumbs\n   card \"Employee onboarding\"@{nl=\"Medewerkers inwerken\"}\n    form Employee.create\n     ## user stays generated: no user-picker vocabulary.\n     input name\n     select home\n     ## locations keep their generated control (array input has no catalog control).\n     calendar start\n     ## manager stays generated: no user-picker vocabulary.\n     input role\n     ## skills keep their generated control (array input has no catalog control).\n   card \"Dated checklist steps\"@{nl=\"Gedateerde checkliststappen\"}\n    tabs preferences.view\n    list Employee order=start filter=home,active,role search=role defaults={home=preferences.home} display=split empty=\"No employees found\"@{nl=\"Geen medewerkers gevonden\"}\n     edit\n     button opens=start_checklist\n     modal \"Start onboarding checklist\"@{nl=\"Inwerkchecklist starten\"} id=start_checklist\n      slot content\n       form start arguments={employee=row} display=inline\n        select template\n     button opens=end_employment\n     modal \"End active employment\"@{nl=\"Actief dienstverband beëindigen\"} id=end_employment\n      slot content\n       form deactivate arguments={employee=row} display=inline\n        calendar ended\n     list row.Checklist empty=\"No checklists yet\"@{nl=\"Nog geen checklists\"}\n      text row.template,row.template_version,row.started\n      stat row.completed_steps,row.total_steps\n      progress row.progress max=100\n      form Step.create\n       input title\n       calendar due\n       ## assignee:user stays generated: no user-picker vocabulary.\n       radio category\n       file_input document\n       textarea blocked_reason\n      timeline row.Step as step where step.done\n       slot item\n        text row.title,row.completed_by,row.completed_at\n      list row.Step as step where preferences.view==all or (preferences.view==unfinished and not step.done) or (preferences.view==overdue and not step.done and step.due<local_date(now,team.timezone)) order=due empty=\"No steps yet\"@{nl=\"Nog geen stappen\"}\n       badge row.category\n       text row.title,row.due,row.assignee,row.done\n       alert\n        require row.blocked_reason!=null\n        text row.blocked_reason\n       card \"Attachment\"@{nl=\"Bijlage\"}\n        require row.document!=null\n        link target=row.document caption=\"Open attachment\"@{nl=\"Bijlage openen\"}\n       text row.completed_by,row.completed_at\n       edit\n       action complete\n       button opens=reopen_step\n       modal \"Reopen step\"@{nl=\"Stap heropenen\"} id=reopen_step\n        slot content\n         form reopen arguments={step=row} display=inline\n          textarea reason\n       delete\n       history\n       pagination\n      pagination\n     pagination\n   card \"Reusable templates\"@{nl=\"Herbruikbare templates\"}\n    form Template.create\n     input name\n     input role\n     select location\n    list Template display=split empty=\"No templates yet\"@{nl=\"Nog geen templates\"}\n     text row.name,row.role,row.location,row.revision,row.active\n     edit\n     form TemplateStep.create\n      input title\n      input offset_days\n      radio category\n     list row.TemplateStep empty=\"No template steps yet\"@{nl=\"Nog geen templatestappen\"}\n      badge row.category\n      text row.title,row.offset_days\n      edit\n      delete\n      pagination\n     pagination\n"}}
