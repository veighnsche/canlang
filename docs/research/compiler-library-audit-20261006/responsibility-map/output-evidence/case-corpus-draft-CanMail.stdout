{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"d8e1eee5d4d8f10b56bac75f49fabd77b959018832b02bb153d6ba3cec265820","before_projection_sha256":"d8e1eee5d4d8f10b56bac75f49fabd77b959018832b02bb153d6ba3cec265820","changed":true,"idempotent":true,"structure_equal":true,"text":"# Optionally help a workspace operator receive and deliver customer mail/parcels for on-site or virtual-office customers. @{nl=\"Help een werkplekbeheerder desgewenst post en pakketten te ontvangen en af te leveren voor klanten op locatie of met een virtueel kantoor.\"}\napp CanMail uses=[mailroom]\n\n# Receive and resolve physical mail under explicit recipient and delegate authority. @{nl=\"Ontvang en handel fysieke post af met expliciete ontvanger- en gemachtigderechten.\"}\npackage mailroom label=\"Mailroom\"@{nl=\"Postkamer\"}\n use customer {Customer,Contact,owns,has_role,test_company,test_contact,test_admin,test_directory_manager,test_directory_employee}\n use member_terms {Term,eligible_term,paid_term,allocated}\n use invoice {BillingV1 as Billing,Charge} from=deployment.billing\n use rent_catalog {Location,test_site}\n use employee {Employee,can_work,test_worker}\n use std {DeliveryResult}\n use std {EmailV1 as Mail} from=deployment.mail\n Given\n  message label_Service_recipient = \"Recipient\"@{nl=\"Ontvanger\"}\n  message label_Service_source = \"Source reference\"@{nl=\"Bronreferentie\"}\n  message label_Delegate_account = \"Account\"@{nl=\"Account\"}\n  message label_Item_kind = \"Kind\"@{nl=\"Soort\"}\n  message label_Item_storage = \"Storage location\"@{nl=\"Opslaglocatie\"}\n  message label_Item_photo = \"Photo\"@{nl=\"Foto\"}\n  message label_Item_incident = \"Handling incident\"@{nl=\"Afhandelingsincident\"}\n  message label_Handling_carrier = \"Carrier\"@{nl=\"Vervoerder\"}\n  message label_Handling_fee = \"Fee\"@{nl=\"Kosten\"}\n  preferences { location:Location?, view:enum(all,collection,forwarding,history)=all label={text=\"Mail view\"@{nl=\"Postweergave\"},values={all=\"All mail\"@{nl=\"Alle post\"},collection=\"Collection queue\"@{nl=\"Afhaalwachtrij\"},forwarding=\"Forwarding queue\"@{nl=\"Doorzendwachtrij\"},history=\"Mail history\"@{nl=\"Postgeschiedenis\"}}} }\n  role mail_staff label=\"Mailroom staff\"@{nl=\"Postmedewerker\"}\n  Service in Customer { location:Location, recipient:Contact label=label_Service_recipient, from:datetime label=\"Start\"@{nl=\"Begin\"}, until:datetime label=\"End\"@{nl=\"Einde\"}, instructions:text, forwarding:text? label=\"Forwarding instructions\"@{nl=\"Doorzendinstructies\"}, revision:int=1, verified:bool=false label=\"Verified\"@{nl=\"Geverifieerd\"}, source:text unique label=label_Service_source, term:Term? label=\"Purchased paid term\"@{nl=\"Gekochte betaalde termijn\"}, paid_evidence:text? label=\"Paid-service evidence\"@{nl=\"Bewijs betaalde dienst\"}, currency:currency, billing:bool=false label=\"Invoice handling fees\"@{nl=\"Afhandelingskosten factureren\"}, active:bool=true } label=\"Mail service\"@{nl=\"Postdienst\"}\n  Delegate in Service { contact:Contact label=\"Nominated contact\"@{nl=\"Genomineerde contactpersoon\"}, account:user label=label_Delegate_account, active:bool=true } label=\"Collection delegate\"@{nl=\"Afhaalgemachtigde\"}\n  Item { location:Location, service:Service?, recipient:Contact? label=label_Service_recipient, source:text unique label=label_Service_source, kind:enum(letter,parcel) label={text=label_Item_kind,values={letter=\"Letter\"@{nl=\"Brief\"},parcel=\"Parcel\"@{nl=\"Pakket\"}}}, storage:text label=label_Item_storage, photo:file? label=label_Item_photo, state:enum(unmatched,received,notified,collection_ready,collected,forward_pending,forwarded,returned)=unmatched label={text=\"State\"@{nl=\"Status\"},values={unmatched=\"Unmatched\"@{nl=\"Niet gekoppeld\"},received=\"Received\"@{nl=\"Ontvangen\"},notified=\"Notified\"@{nl=\"Gemeld\"},collection_ready=\"Ready for collection\"@{nl=\"Klaar om af te halen\"},collected=\"Collected\"@{nl=\"Afgehaald\"},forward_pending=\"Forwarding pending\"@{nl=\"Doorzending in afwachting\"},forwarded=\"Forwarded\"@{nl=\"Doorgestuurd\"},returned=\"Returned\"@{nl=\"Geretourneerd\"}}}, notification:delivery(Mail.send)? label=\"Notification reference\"@{nl=\"Meldingsreferentie\"}, notice:Notice?, reminders:int=0, reminder_delay:duration=7d, reminder_limit:int=2 min=0 max=5, history_days:int=180 min=1, retention_until:datetime?, dispatch:Dispatch?, completed:datetime? label=\"Completed at\"@{nl=\"Afgerond op\"}, incident:text? label=label_Item_incident } label=\"Mail item\"@{nl=\"Poststuk\"}\n  Handling in Item { kind:enum(collection,forward,return,correction) label={text=label_Item_kind,values={collection=\"Collection\"@{nl=\"Afhalen\"},forward=\"Forwarding\"@{nl=\"Doorzending\"},return=\"Return\"@{nl=\"Retour\"},correction=\"Correction\"@{nl=\"Correctie\"}}}, account:user? label=label_Delegate_account, instruction:text label=\"Recorded instruction\"@{nl=\"Vastgelegde instructie\"}, destination:text? label=\"Destination\"@{nl=\"Bestemming\"}, evidence:text, carrier:text? label=label_Handling_carrier, fee:money? label=label_Handling_fee, source:text unique label=label_Service_source, revision:int, dispatch:Dispatch?, author:user server=actor label=\"Author\"@{nl=\"Auteur\"} } label=\"Handling record\"@{nl=\"Afhandelingsregistratie\"}\n  Dispatch in Item { source:text unique, instruction:text, instruction_revision:int label=\"Instruction version\"@{nl=\"Instructieversie\"}, destination:text label=\"Frozen postal destination\"@{nl=\"Vastgelegde postbestemming\"}, fee:money? label=label_Handling_fee, charge:Charge?, state:enum(pending,unknown,dispatched,cancelled)=pending label={text=\"Dispatch\"@{nl=\"Verzending\"},values={pending=\"Pending\"@{nl=\"In afwachting\"},unknown=\"Uncertain\"@{nl=\"Onzeker\"},dispatched=\"Evidenced dispatch\"@{nl=\"Verzending met bewijs\"},cancelled=\"No dispatch recorded\"@{nl=\"Geen verzending vastgelegd\"}}}, charge_state:enum(none,pending,confirmed,failed,unknown)=none label={text=\"Fee invoice\"@{nl=\"Kostenfactuur\"},values={none=\"No invoice requested\"@{nl=\"Geen factuur aangevraagd\"},pending=\"Invoice requested\"@{nl=\"Factuur aangevraagd\"},confirmed=\"Invoice created\"@{nl=\"Factuur aangemaakt\"},failed=\"Invoice failed\"@{nl=\"Factuur mislukt\"},unknown=\"Invoice uncertain\"@{nl=\"Factuur onzeker\"}}}, charge_delivery:text?, reconcile_delivery:text?, invoice:text?, revision:int=1 } label=\"Forwarding attempt\"@{nl=\"Doorzendpoging\"}\n  ## Immutable staff-only notice history; one row per admitted notice intent.\n  Notice in Item { account:user label=\"Frozen account\", address:text label=\"Frozen address\", subject:text, body:text, receipt:delivery(Mail.send)? label=\"Notice receipt\", kind:enum(initial,reminder,additional), number:int, predecessor:Notice?, reason:text?, acknowledged:bool=false label=\"Possible duplicate accepted\", author:user server=actor label=\"Author\" } label=\"Notice attempt\"\n  policy Notice read=mail_staff and can_work(actor,row.parent.location)\n  lock Notice fields=account,address,subject,body,receipt,kind,number,predecessor,reason,acknowledged,author\n  event Reminder { item:Item, number:int }\n  derive recipient(person:user,service:Service):bool = service.parent.active and service.parent.archived_at==null and service.recipient.archived_at==null and service.recipient.verified and service.recipient.account!=null and service.recipient.account==person\n  derive manage(person:user,service:Service):bool = recipient(person,service) or has_role(person,service.parent,administrator)\n  derive live(service:Service):bool = service.active and service.verified and service.parent.active and service.parent.archived_at==null and service.location.active and service.recipient.archived_at==null and service.recipient.verified and service.recipient.account!=null and service.from<=now and now<service.until and ((service.term!=null and service.term.parent.parent==service.parent and service.term.mail and service.location in service.term.locations and service.term.price.currency==service.currency and eligible_term(service.recipient.account,service.term,now)) or (service.term==null and service.paid_evidence!=null and trim(service.paid_evidence)!=\"\"))\n  derive fee_charge(item:Item,fee:money?):Charge? = first([Charge {source=format(\"mail-forward-{item}\",{item=item.id}),customer=item.service.parent.id,location=item.location.id,description=format(\"Forwarding fee\"@{nl=\"Doorzendkosten\"},locale=null),amount=fee??money(0,item.service.currency),due=local_date(now,item.location.timezone)}] as value where item.service.billing and fee!=null and fee.minor>0)\n  derive delegate_eligible(delegate:Delegate):bool = delegate.parent.parent.active and delegate.parent.parent.archived_at==null and delegate.contact.archived_at==null and delegate.contact.verified and delegate.contact.account==delegate.account\n  derive permitted_collector(person:user,service:Service):bool = recipient(person,service) or any(service.Delegate as delegate,delegate.account==person and delegate.active and delegate_eligible(delegate))\n  policy Service read=mail_staff and can_work(actor,row.location)\n  policy Service read=authenticated where=manage(actor,row)\n  policy Delegate read=authenticated where=row.account==actor or manage(actor,row.parent)\n  derive Item.notice_state:DeliveryResult.status? = row.notification?.status label={text=\"Notification\"@{nl=\"Melding\"},values={pending=\"Sending\"@{nl=\"Wordt verzonden\"},succeeded=\"Accepted\"@{nl=\"Geaccepteerd\"},failed=\"Failed\"@{nl=\"Mislukt\"},unknown=\"Uncertain\"@{nl=\"Onzeker\"},skipped=\"Skipped\"@{nl=\"Overgeslagen\"}}}\n  ## Item.notice:Notice? — staff-only current attempt; Item.notification keeps the existing status-only recipient projection.\n  policy Item read=mail_staff and can_work(actor,row.location)\n  policy Item read=authenticated where=row.service!=null and recipient(actor,row.service) fields=service,recipient,kind,state,notice_state,notification.status,completed,created\n  policy Handling read=mail_staff and can_work(actor,row.parent.location)\n  policy Handling read=authenticated where=row.parent.service!=null and recipient(actor,row.parent.service) fields=kind,account,instruction,revision,destination,evidence,carrier,fee,created\n  policy Dispatch read=mail_staff and can_work(actor,row.parent.location)\n  invariant Service: row.from<row.until and row.recipient.parent==row.parent and row.revision>0 and (row.term==null or (row.term.parent.parent==row.parent and row.location in row.term.locations and row.currency==row.term.price.currency))\n  ## Keep the nominated relationship valid as history; current verification belongs at admission/use.\n  invariant Delegate: row.contact.parent==row.parent.parent\n  lock Delegate fields=parent,contact,account\n  invariant Item: (row.service==null or (row.service.location==row.location and row.recipient==row.service.recipient)) and (row.dispatch==null or row.dispatch.parent==row)\n  invariant Dispatch: (row.fee==null or (row.fee.minor>=0 and row.parent.service!=null and row.fee.currency==row.parent.service.currency)) and (row.charge==null or row.charge.source==row.source)\n  retain Item until=row.retention_until\n  lock Service fields=parent,location,recipient,source,term,currency,billing\n  lock Dispatch fields=source,instruction,instruction_revision,destination,fee,charge\n  lock Handling fields=kind,account,instruction,revision,destination,evidence,carrier,fee,source,dispatch,author\n  unique Delegate fields=contact,account\n  ## Typed isolated receipt snapshots include a valid frozen request; no provider send is performed.\n  fixture attempt=Mail.send {request={to=\"recipient@example.test\",subject=\"Notice\",body=\"Recorded decision\"}}\n  ## A separately selected pending receipt exercises a superseded completion ID.\n  fixture pending_notice=Mail.send {request={to=\"recipient@example.test\",subject=\"Notice\",body=\"Recorded decision\"}}\n  fixture service=Service {parent=test_company,location=test_site,recipient=test_contact,from=datetime(\"2020-01-01T00:00:00Z\"),until=datetime(\"2099-01-01T00:00:00Z\"),instructions=\"Collection by verified recipient\",verified=true,source=\"mail-term\",currency=\"EUR\",term=paid_term}\n  fixture nominee=user {}\n  fixture unrelated=user {}\n  fixture mail_operator=user {roles=[mail_staff]}\n  fixture mail_employee=Employee {user=mail_operator,home=test_site,locations=[test_site],start=date(\"2026-10-01\"),role=\"mail operator\"}\n  fixture delegate_contact=Contact {parent=test_company,name=\"Collection delegate\",email=\"delegate@example.test\",account=nominee,verified=true}\n  fixture delegate=Delegate {parent=service,contact=delegate_contact,account=nominee}\n  fixture prepared=Dispatch {parent=parcel_item,source=\"mail-forward-parcel\",instruction=\"Collection by verified recipient\",instruction_revision=1,destination=\"Original address\",fee=money(5,\"EUR\"),charge={source=\"mail-forward-parcel\",customer=test_company.id,location=test_site.id,description=\"Forwarding fee\",amount=money(5,\"EUR\"),due=date(\"2090-01-01\")},state=pending}\n  fixture parcel_item=Item {location=test_site,service=service,recipient=test_contact,source=\"physical-parcel\",kind=parcel,storage=\"Shelf A\",state=collection_ready}\n When\n  # Record the owning paid-service reference, without inventing a membership notification feed. @{nl=\"Leg de verwijzing naar de betaalde dienst vast zonder een lidmaatschapsmeldingsfeed te verzinnen.\"}\n  scenario configure(customer:Customer,location:Location,recipient:Contact,from:datetime,until:datetime,source:text,term:Term?,paid_evidence:text?,currency:currency,billing:bool=false,instructions:text,forwarding:text?) by=mail_staff label=\"Configure mail service\"@{nl=\"Postdienst instellen\"}\n   require can_work(actor,location) and customer.active and customer.archived_at==null and recipient.parent==customer and recipient.verified and recipient.account!=null and from<until and trim(source)!=\"\" and trim(instructions)!=\"\" and (forwarding==null or trim(forwarding)!=\"\")\n   require (term!=null and term.parent.parent==customer and term.mail and location in term.locations and term.price.currency==currency) or (term==null and paid_evidence!=null and trim(paid_evidence)!=\"\")\n   do create Service {parent=customer,location,recipient,from,until,source,term,paid_evidence,currency,billing,instructions,forwarding,verified=true} as service\n  # Change future service availability without resolving or deleting held physical items. @{nl=\"Wijzig toekomstige dienstbeschikbaarheid zonder bewaarde fysieke items af te handelen of te verwijderen.\"}\n  scenario service_status(service:Service,active:bool,until:datetime,paid_evidence:text?) by=mail_staff label=\"Review service availability\"@{nl=\"Dienstbeschikbaarheid beoordelen\"}\n   require can_work(actor,service.location) and service.from<until and (service.term!=null or not active or (paid_evidence!=null and trim(paid_evidence)!=\"\"))\n   do set service {active,until,paid_evidence}\n  ## Creation nominates one current contact/account; revocation preserves that immutable identity.\n  crud Delegate by=authenticated fields=active create_fields=contact,account when=(owns(actor,row.parent.parent) or has_role(actor,row.parent.parent,administrator)) and (not row.active or delegate_eligible(row)) delete=none\n   examples create seed=[test_admin] parent=service contact=delegate_contact account=nominee\n    as,delegate_contact.verified,test_admin.active,test_company.active -> count(service.Delegate)\n    members,true,true,true -> 1\n    members,false,true,true -> error(rule_failed)\n    members,true,false,true -> error(rule_failed)\n    members,true,true,false -> error(rule_failed)\n    unrelated,true,true,true -> error(rule_failed)\n    public,true,true,true -> error(forbidden)\n   examples update seed=[test_admin] record=delegate\n    as,changes.active,delegate_contact.verified -> delegate.active,count(service.Delegate)\n    members,false,false -> false,1\n    members,true,false -> error(rule_failed)\n    unrelated,false,true -> error(rule_failed)\n  # Update authorized instructions without changing an existing forwarding snapshot. @{nl=\"Werk geautoriseerde instructies bij zonder een bestaande doorzendmomentopname te wijzigen.\"}\n  scenario instructions(service:Service,instructions:text,forwarding:text?,revision:int) by=authenticated label=\"Update handling instructions\"@{nl=\"Afhandelingsinstructies bijwerken\"}\n   require manage(actor,service) and revision==service.revision and trim(instructions)!=\"\" and (forwarding==null or trim(forwarding)!=\"\")\n   do set service {instructions,forwarding,revision=service.revision+1}\n   examples seed=[test_admin,allocated] service=service instructions=\"Collect at reception\" forwarding=\"New address\" revision=1\n    as,revision -> service.forwarding,service.revision\n    members,1 -> \"New address\",2\n    members,0 -> error(rule_failed)\n    unrelated,1 -> error(rule_failed)\n    public,1 -> error(forbidden)\n  # Receive one physical item; unmatched recipients remain a restricted review. @{nl=\"Ontvang één fysiek item; niet-gekoppelde ontvangers blijven in een afgeschermde beoordeling.\"}\n  scenario receive(location:Location,source:text label=label_Service_source,kind:Item.kind,storage:text label=label_Item_storage,service:Service?,photo:file? label=label_Item_photo) by=mail_staff label=\"Record receipt\"@{nl=\"Ontvangst registreren\"}\n   require can_work(actor,location) and trim(source)!=\"\" and trim(storage)!=\"\" and not any(Item as item,item.source==source)\n   require service==null or (service.location==location and live(service))\n   do\n    create Item {location,source,kind,storage,photo} as item\n    if service!=null\n     set item {service,recipient=service.recipient,state=received}\n     let subject=format(\"Mail received\"@{nl=\"Post ontvangen\"},locale=null)\n     let body=format(\"An item is available for authorized collection.\"@{nl=\"Er ligt een item klaar dat door een bevoegde persoon kan worden afgehaald.\"},locale=null)\n     send Mail.send {to=service.recipient.email,subject=subject,body=body} when=item.state in [received,notified,collection_ready] and recipient(service.recipient.account,service) as delivery\n     create Notice {parent=item,account=service.recipient.account,address=service.recipient.email,subject=subject,body=body,receipt=delivery,kind=initial,number=0} as frozen\n     set item {notification=delivery,notice=frozen}\n     schedule format(\"mail-reminder-{item}\",{item=item.id}) at=now+item.reminder_delay event=Reminder {item,number=1}\n   examples seed=[test_worker,test_admin,allocated] location=test_site source=\"new-receipt\" kind=parcel storage=\"Shelf A\" service=service photo=null\n    as,paid_term.mail,paid_term.paid,service.paid_evidence -> count(Item as item where item.source==\"new-receipt\")\n    mail_staff,true,true,null -> 1\n    mail_staff,false,true,null -> error(rule_failed)\n    mail_staff,true,false,\"Manual evidence cannot override linked term\" -> error(rule_failed)\n   ## Real commits revoke a nominee and preserve custody/history; no fixture patches or provider impersonation.\n   examples seed=[test_admin,mail_employee,test_directory_employee,delegate_contact]\n    do\n     call configure {customer=test_company,location=test_site,recipient=test_contact,from=datetime(\"2020-01-01T00:00:00Z\"),until=datetime(\"2099-01-01T00:00:00Z\"),source=\"mail-journey-service\",term=null,paid_evidence=\"Reviewed standalone mail purchase\",currency=\"EUR\",instructions=\"Collect at reception\",forwarding=null} by=mail_operator\n     let route=first(Service as row where row.source==\"mail-journey-service\" order=row.id)\n     route!=null -> true\n     call receive {location=test_site,source=\"mail-journey-receipt\",kind=parcel,storage=\"Shelf B\",service=route,photo=null} by=mail_operator\n     let arrived=first(Item as row where row.source==\"mail-journey-receipt\" order=row.id)\n     arrived!=null -> true\n     arrived.state,arrived.notice_state,count(arrived.Handling),arrived.retention_until -> received,pending,0,null\n     call Delegate.create {parent=route,contact=delegate_contact,account=nominee} by=self\n     let nomination=first(route.Delegate as row where row.contact==delegate_contact and row.account==nominee order=row.id)\n     nomination!=null -> true\n     nomination.active,delegate_eligible(nomination) -> true,true\n     call Contact.update {record=delegate_contact,changes={email=\"replacement@example.test\"}} by=test_directory_manager\n     delegate_contact.verified,delegate_contact.account -> false,null\n     call collect {item=arrived,collector=nominee,evidence=\"Former nominee identity\"} by=mail_operator -> error(rule_failed)\n     let held=first(Item as row where row.source==\"mail-journey-receipt\" order=row.id)\n     held!=null -> true\n     held.state,count(held.Handling),held.retention_until -> received,0,null\n     let current_nomination=first(route.Delegate as row where row.contact==delegate_contact and row.account==nominee order=row.id)\n     current_nomination!=null -> true\n     call Delegate.update {record=current_nomination,changes={active=false}} by=self\n     call Contact.delete {record=delegate_contact} by=test_directory_manager\n     let history=first(route.Delegate as row where row.account==nominee order=row.id)\n     history!=null -> true\n     history.active,history.contact,history.account,history.contact.archived_at!=null,delegate_eligible(history) -> false,delegate_contact,nominee,true,false\n     call service_status {service=route,active=false,until=datetime(\"2021-01-01T00:00:00Z\"),paid_evidence=\"Reviewed standalone mail purchase\"} by=mail_operator\n     let expired_route=first(Service as row where row.source==\"mail-journey-service\" order=row.id)\n     expired_route!=null -> true\n     expired_route.active,live(expired_route),recipient(self,expired_route) -> false,false,true\n     let retained=first(Item as row where row.source==\"mail-journey-receipt\" order=row.id)\n     retained!=null -> true\n     call collect {item=retained,collector=self,evidence=\"Verified original recipient collected held property\"} by=mail_operator\n     let collected_item=first(Item as row where row.source==\"mail-journey-receipt\" order=row.id)\n     collected_item!=null -> true\n     collected_item.state,count(collected_item.Handling),any(collected_item.Handling as handling,handling.kind==collection and handling.account==self and handling.author==mail_operator),collected_item.retention_until -> collected,1,true,now+collected_item.history_days*1d\n     call collect {item=collected_item,collector=self,evidence=\"Repeated collection\"} by=mail_operator -> error(rule_failed)\n     let final_item=first(Item as row where row.source==\"mail-journey-receipt\" order=row.id)\n     final_item!=null -> true\n     final_item.state,count(final_item.Handling),count(expired_route.Delegate),recipient(self,expired_route),recipient(nominee,expired_route) -> collected,1,1,true,false\n  # Match an unresolved receipt against the current paid service and notify separately. @{nl=\"Koppel een onopgeloste ontvangst aan de huidige betaalde dienst en meld afzonderlijk.\"}\n  scenario match(item:Item,service:Service) by=mail_staff label=\"Match recipient\"@{nl=\"Ontvanger koppelen\"}\n   require can_work(actor,item.location) and item.state==unmatched and service.location==item.location and live(service)\n   do\n    set item {service,recipient=service.recipient,state=received}\n    let subject=format(\"Mail received\"@{nl=\"Post ontvangen\"},locale=null)\n    let body=format(\"An item is available for authorized collection.\"@{nl=\"Er ligt een item klaar dat door een bevoegde persoon kan worden afgehaald.\"},locale=null)\n    send Mail.send {to=service.recipient.email,subject=subject,body=body} when=item.state in [received,notified,collection_ready] and recipient(service.recipient.account,service) as delivery\n    create Notice {parent=item,account=service.recipient.account,address=service.recipient.email,subject=subject,body=body,receipt=delivery,kind=initial,number=0} as frozen\n    set item {notification=delivery,notice=frozen}\n    schedule format(\"mail-reminder-{item}\",{item=item.id}) at=now+item.reminder_delay event=Reminder {item,number=1}\n  # Record one evidenced collection by the currently verified recipient or delegate, including after service expiry. @{nl=\"Registreer één bewezen afhaling door de huidige geverifieerde ontvanger of gemachtigde, ook na het verlopen van de dienst.\"}\n  scenario collect(item:Item,collector:user label=\"Collector\"@{nl=\"Afhaler\"},evidence:text) by=mail_staff label=\"Record collection\"@{nl=\"Afhaling registreren\"}\n   require can_work(actor,item.location) and item.state in [received,notified,collection_ready] and trim(evidence)!=\"\" and item.service!=null\n   require permitted_collector(collector,item.service)\n   do\n    create Handling {parent=item,kind=collection,account=collector,instruction=item.service.instructions,revision=item.service.revision,evidence,source=operation.id} as handling\n    set item {state=collected,completed=now,retention_until=now+item.history_days*1d}\n    cancel format(\"mail-reminder-{item}\",{item=item.id})\n   examples seed=[test_worker,delegate] item=parcel_item evidence=\"Identity verified\"\n    as,collector,item.state,service.until,delegate.active,delegate_contact.verified -> item.state,count(parcel_item.Handling)\n    mail_staff,self,collection_ready,datetime(\"2021-01-01T00:00:00Z\"),true,true -> collected,1\n    mail_staff,nominee,collection_ready,datetime(\"2099-01-01T00:00:00Z\"),true,true -> collected,1\n    mail_staff,nominee,collection_ready,datetime(\"2099-01-01T00:00:00Z\"),false,true -> error(rule_failed)\n    mail_staff,nominee,collection_ready,datetime(\"2099-01-01T00:00:00Z\"),true,false -> error(rule_failed)\n    mail_staff,self,collected,datetime(\"2099-01-01T00:00:00Z\"),true,true -> error(rule_failed)\n    unrelated,self,collection_ready,datetime(\"2099-01-01T00:00:00Z\"),true,true -> error(forbidden)\n   examples seed=[test_worker,delegate] item=parcel_item collector=nominee evidence=\"Identity verified\"\n    as,delegate_contact.account,test_company.active -> item.state\n    mail_staff,null,true -> error(rule_failed)\n    mail_staff,nominee,false -> error(rule_failed)\n  # Freeze a unique forwarding attempt and optional same-currency invoice charge. @{nl=\"Leg een unieke doorzendpoging en optionele factuurkosten in dezelfde valuta vast.\"}\n  scenario forward(item:Item,fee:money? label=label_Handling_fee,destination_verified:bool label=\"Postal destination verified\"@{nl=\"Postbestemming geverifieerd\"}) by=mail_staff label=\"Prepare forwarding\"@{nl=\"Doorzending voorbereiden\"}\n   require can_work(actor,item.location) and item.service!=null and item.state in [received,notified,collection_ready] and item.dispatch==null and live(item.service) and item.service.forwarding!=null and trim(item.service.forwarding)!=\"\"\n   require destination_verified and (fee==null or (fee.minor>=0 and fee.currency==item.service.currency))\n   do\n    let source=format(\"mail-forward-{item}\",{item=item.id})\n    create Dispatch {parent=item,source,instruction=item.service.instructions,instruction_revision=item.service.revision,destination=item.service.forwarding,fee,charge=fee_charge(item,fee)} as dispatch\n    set item {state=forward_pending,dispatch}\n    cancel format(\"mail-reminder-{item}\",{item=item.id})\n    if dispatch.charge!=null\n     send Billing.charge {value=dispatch.charge} as delivery\n     set dispatch {charge_delivery=delivery.id,charge_state=pending}\n   examples seed=[test_worker,test_admin,allocated] item=parcel_item fee=money(5,\"EUR\") destination_verified=true\n    as,paid_term.mail,paid_term.paid,service.forwarding,destination_verified -> item.state,count(item.Dispatch)\n    mail_staff,true,true,\"Original address\",true -> forward_pending,1\n    mail_staff,true,true,\"Original address\",false -> error(rule_failed)\n    mail_staff,false,true,\"Original address\",true -> error(rule_failed)\n    mail_staff,true,false,\"Original address\",true -> error(rule_failed)\n    mail_staff,true,true,null,true -> error(rule_failed)\n  # Confirm the exact current forwarding attempt with carrier evidence, independently of billing. @{nl=\"Bevestig de exacte huidige doorzendpoging met vervoerdersbewijs, onafhankelijk van facturatie.\"}\n  scenario dispatched(dispatch:Dispatch,revision:int,carrier:text label=label_Handling_carrier,evidence:text) by=mail_staff label=\"Record dispatch\"@{nl=\"Verzending registreren\"}\n   require can_work(actor,dispatch.parent.location) and dispatch.parent.state==forward_pending and dispatch.parent.dispatch==dispatch and dispatch.state in [pending,unknown] and revision==dispatch.revision and trim(carrier)!=\"\" and trim(evidence)!=\"\"\n   do\n    create Handling {parent=dispatch.parent,kind=forward,instruction=dispatch.instruction,revision=dispatch.instruction_revision,destination=dispatch.destination,carrier,evidence,fee=dispatch.fee,dispatch,source=dispatch.source} as handling\n    set dispatch {state=dispatched,revision=dispatch.revision+1}\n    set dispatch.parent {state=forwarded,completed=now,retention_until=now+dispatch.parent.history_days*1d}\n   examples seed=[test_worker] dispatch=prepared revision=1 carrier=\"Manual carrier\" evidence=\"Tracking reference\"\n    as,parcel_item.state,parcel_item.dispatch,service.forwarding,dispatch.charge_state,revision -> parcel_item.state,max(parcel_item.Handling as row select row.destination)\n    mail_staff,forward_pending,prepared,\"Changed address\",confirmed,1 -> forwarded,\"Original address\"\n    mail_staff,forward_pending,prepared,\"Original address\",pending,0 -> error(rule_failed)\n    mail_staff,forwarded,prepared,\"Original address\",confirmed,1 -> error(rule_failed)\n  # Keep uncertain forwarding pending and append the attempted-dispatch evidence. @{nl=\"Houd onzekere doorzending in behandeling en voeg bewijs van de verzendpoging toe.\"}\n  scenario uncertain(dispatch:Dispatch,revision:int,evidence:text) by=mail_staff label=\"Record uncertain dispatch\"@{nl=\"Onzekere verzending registreren\"}\n   require can_work(actor,dispatch.parent.location) and dispatch.parent.state==forward_pending and dispatch.parent.dispatch==dispatch and dispatch.state in [pending,unknown] and dispatch.revision==revision and trim(evidence)!=\"\"\n   do\n    create Handling {parent=dispatch.parent,kind=correction,instruction=dispatch.instruction,revision=dispatch.instruction_revision,destination=dispatch.destination,evidence,dispatch,source=operation.id} as handling\n    set dispatch {state=unknown,revision=dispatch.revision+1}\n    set dispatch.parent {incident=evidence}\n  # Return only by an evidenced staff decision; an unresolved dispatch needs an explicit no-dispatch confirmation. @{nl=\"Retourneer alleen op basis van een bewezen personeelsbesluit; een onopgeloste verzending vereist expliciete bevestiging dat niet is verzonden.\"}\n  scenario return_item(item:Item,evidence:text,no_dispatch:bool=false) by=mail_staff label=\"Record return\"@{nl=\"Retour registreren\"}\n   require can_work(actor,item.location) and item.state in [unmatched,received,notified,collection_ready,forward_pending] and trim(evidence)!=\"\"\n   require item.state!=forward_pending or no_dispatch\n   do\n    create Handling {parent=item,kind=return,instruction=\"Recorded return\",revision=item.service?.revision??0,evidence,dispatch=item.dispatch,source=operation.id} as handling\n    if item.dispatch!=null\n     set item.dispatch {state=cancelled,revision=item.dispatch.revision+1}\n    set item {state=returned,completed=now,retention_until=now+item.history_days*1d}\n    cancel format(\"mail-reminder-{item}\",{item=item.id})\n   examples seed=[test_worker] item=parcel_item evidence=\"Physical return recorded\" no_dispatch=false\n    as,item.state,no_dispatch -> item.state,item.retention_until\n    mail_staff,received,false -> returned,now+item.history_days*1d\n    mail_staff,forward_pending,false -> error(rule_failed)\n    mail_staff,forward_pending,true -> returned,now+item.history_days*1d\n  # Append corrections without rewriting receipt or handling evidence. @{nl=\"Voeg correcties toe zonder ontvangst- of afhandelingsbewijs te herschrijven.\"}\n  scenario incident(item:Item,reason:text) by=mail_staff label=label_Item_incident\n   require can_work(actor,item.location) and trim(reason)!=\"\"\n   do\n    create Handling {parent=item,kind=correction,instruction=\"Staff correction\",revision=item.service?.revision??0,evidence=reason,dispatch=item.dispatch,source=operation.id} as handling\n    set item {incident=reason}\n  # Re-submit only the frozen fee with its original billing source. @{nl=\"Dien uitsluitend de vastgelegde kosten opnieuw in met de oorspronkelijke facturatiebron.\"}\n  scenario retry_fee(dispatch:Dispatch) by=mail_staff label=\"Retry forwarding invoice\"@{nl=\"Doorzendfactuur opnieuw proberen\"}\n   require can_work(actor,dispatch.parent.location) and dispatch.charge!=null and dispatch.charge_state in [failed,unknown]\n   do\n    send Billing.reconcile {source=dispatch.source} as delivery\n    set dispatch {reconcile_delivery=delivery.id,charge_delivery=null,charge_state=pending}\n  scenario fee_result on=Billing.charge.completed\n   do\n    for dispatch in Dispatch as row where row.charge_delivery==event.delivery_id limit=1\n     if event.status==succeeded and event.result!=null\n      require event.result.source==dispatch.source\n      if event.result.state==confirmed\n       set dispatch {charge_state=confirmed,invoice=event.result.reference}\n      else\n       set dispatch {charge_state=failed}\n     else\n      if event.status==failed\n       set dispatch {charge_state=failed}\n      else\n       if event.status==unknown\n        set dispatch {charge_state=unknown}\n   examples event={delivery_id=\"forward-fee\",status=succeeded,result={source=\"mail-forward-parcel\",revision=1,state=confirmed,reference=\"invoice-1\",detail=null},error=null}\n    prepared.charge_delivery,parcel_item.state,prepared.state -> parcel_item.state,prepared.charge_state\n    \"forward-fee\",forward_pending,unknown -> forward_pending,confirmed\n    \"older-fee\",forward_pending,unknown -> forward_pending,none\n  scenario fee_reconciled on=Billing.reconcile.completed\n   do\n    for dispatch in Dispatch as row where row.reconcile_delivery==event.delivery_id limit=1\n     if event.status==succeeded\n      if event.result!=null\n       require event.result.source==dispatch.source and event.result.amount==dispatch.fee\n       set dispatch {charge_state=confirmed,invoice=event.result.invoice,reconcile_delivery=null}\n      else\n       send Billing.charge {value=dispatch.charge} as delivery\n       set dispatch {charge_delivery=delivery.id,charge_state=pending,reconcile_delivery=null}\n     else\n      if event.status in [failed,unknown]\n       set dispatch {charge_state=unknown,reconcile_delivery=null}\n  # Bound uncollected reminders without changing physical custody or service entitlement. @{nl=\"Begrens herinneringen voor niet-afgehaalde post zonder fysieke bewaring of dienstrechten te wijzigen.\"}\n  scenario remind on=Reminder\n   do\n    let item=event.item\n    if item.state in [received,notified,collection_ready] and item.service!=null and event.number==item.reminders+1 and event.number<=item.reminder_limit and recipient(item.service.recipient.account,item.service)\n     let subject=format(\"Mail awaiting collection\"@{nl=\"Post wacht op afhaling\"},locale=null)\n     let body=format(\"Please arrange authorized collection of your item.\"@{nl=\"Regel bevoegde afhaling van je poststuk.\"},locale=null)\n     send Mail.send {to=item.service.recipient.email,subject=subject,body=body} when=item.state in [received,notified,collection_ready] and recipient(item.service.recipient.account,item.service) as delivery\n     create Notice {parent=item,account=item.service.recipient.account,address=item.service.recipient.email,subject=subject,body=body,receipt=delivery,kind=reminder,number=event.number} as frozen\n     set item {notification=delivery,notice=frozen,reminders=event.number}\n     if item.reminders<item.reminder_limit\n      schedule format(\"mail-reminder-{item}\",{item=item.id}) at=now+item.reminder_delay event=Reminder {item,number=item.reminders+1}\n   examples event={item=parcel_item,number=1}\n    parcel_item.state,parcel_item.reminders -> parcel_item.state,parcel_item.reminders,parcel_item.retention_until\n    collection_ready,0 -> collection_ready,1,null\n    collected,0 -> collected,0,null\n    collection_ready,2 -> collection_ready,2,null\n  # Send one additional frozen notice after a failed, uncertain or skipped attempt, keeping the old outcome. @{nl=\"Verzend één extra bevroren melding na een mislukte, onzekere of overgeslagen poging, met behoud van de oude uitkomst.\"}\n  scenario send_another_notice(item:Item,reason:text,acknowledged:bool=false) by=mail_staff label=\"Send another notice\"@{nl=\"Nog een melding verzenden\"}\n   require can_work(actor,item.location) and item.service!=null and item.state in [received,notified,collection_ready] and item.notice!=null and trim(reason)!=\"\"\n   require item.notice.receipt!=null and item.notice.receipt.status in [failed,unknown,skipped]\n   require item.notice.receipt.status==skipped or acknowledged\n   require recipient(item.service.recipient.account,item.service)\n   ## Both frozen comparisons: account AND address must still match current verified contact.\n   require item.notice.account==item.service.recipient.account and item.notice.address==item.service.recipient.email\n   do\n    send Mail.send {to=item.notice.address,subject=item.notice.subject,body=item.notice.body} when=item.state in [received,notified,collection_ready] and recipient(item.service.recipient.account,item.service) as delivery\n    create Notice {parent=item,account=item.notice.account,address=item.notice.address,subject=item.notice.subject,body=item.notice.body,receipt=delivery,kind=additional,number=item.notice.number,predecessor=item.notice,reason,acknowledged} as next\n    set item {notification=delivery,notice=next}\n  # Reapply the current accepted notice outcome when its callback was missed. @{nl=\"Pas de huidige geaccepteerde meldingsuitkomst opnieuw toe als de callback is gemist.\"}\n  scenario apply_notice_success(item:Item) by=mail_staff label=\"Apply accepted notice\"@{nl=\"Geaccepteerde melding toepassen\"}\n   require can_work(actor,item.location) and item.state==received and item.notice!=null and item.notice.receipt!=null and item.notice.receipt.status==succeeded and item.notice.receipt.result!=null\n   do\n    set item {state=notified}\n  scenario notice_result on=Mail.send.completed\n   do\n    for item in Item as row where row.notification?.id==event.delivery_id limit=1\n     if event.status==succeeded and event.result!=null and item.state==received\n      set item {state=notified}\n   ## Provisioned receipts are snapshots; these handler calls test current-attempt correlation and custody preservation.\n   examples event={delivery_id=attempt.id,status=succeeded,result={reference=\"accepted-mail\"},error=null}\n    parcel_item.notification,parcel_item.state,event.delivery_id,event.status,event.result,event.error,attempt.status,attempt.result,attempt.error -> parcel_item.state,parcel_item.notice_state\n    attempt,received,attempt.id,succeeded,{reference=\"accepted-mail\"},null,succeeded,{reference=\"accepted-mail\"},null -> notified,succeeded\n    pending_notice,received,attempt.id,succeeded,{reference=\"accepted-mail\"},null,succeeded,{reference=\"accepted-mail\"},null -> received,pending\n    null,received,attempt.id,succeeded,{reference=\"accepted-mail\"},null,succeeded,{reference=\"accepted-mail\"},null -> received,null\n    attempt,received,attempt.id,unknown,null,null,unknown,null,null -> received,unknown\n    attempt,received,attempt.id,failed,null,{code=\"provider\",message=\"Delivery rejected\"},failed,null,{code=\"provider\",message=\"Delivery rejected\"} -> received,failed\n    attempt,received,attempt.id,skipped,null,null,skipped,null,null -> received,skipped\n    attempt,collected,attempt.id,succeeded,{reference=\"accepted-mail\"},null,succeeded,{reference=\"accepted-mail\"},null -> collected,succeeded\n Then\n  # Receive, locate and resolve mail while restricting physical storage information. @{nl=\"Ontvang, lokaliseer en handel post af terwijl fysieke opslaginformatie afgeschermd blijft.\"}\n  page /mailroom title=\"Mail and parcels\"@{nl=\"Post en pakketten\"} order=2\n   require mail_staff\n   ## Breadcrumbs show current declared ancestry; the shared right-sidebar shell supplies navigation, no per-app menu.\n   breadcrumbs\n   card \"Service entitlement\"@{nl=\"Dienstrecht\"}\n    form configure\n     fieldset \"Handling instructions\"@{nl=\"Afhandelingsinstructies\"}\n      textarea instructions\n      textarea forwarding\n    list Service display=split empty=\"No mail services\"@{nl=\"Geen postdiensten\"}\n     pagination\n     text row.location,row.recipient,row.from,row.until,row.active,row.source,row.term,row.paid_evidence\n     action service_status\n   card \"Mail receipt\"@{nl=\"Post ontvangen\"}\n    form receive\n     fieldset \"Receipt\"@{nl=\"Ontvangst\"}\n      radio kind\n      input source\n      input storage\n      file_input photo\n   card \"Located items\"@{nl=\"Gelokaliseerde post\"}\n    tabs preferences.view\n    table Item as item where preferences.view==all or (preferences.view==collection and item.state in [received,notified,collection_ready]) or (preferences.view==forwarding and item.state in [forward_pending,forwarded]) or (preferences.view==history and item.state in [collected,forwarded,returned]) columns=location,recipient,kind,storage,state,notice_state,incident filter=location,state defaults={location=preferences.location} display=split empty=\"No mail items match these filters\"@{nl=\"Geen poststukken voor deze filters\"}\n     pagination\n     badge row.state\n     status row.notice_state\n     collapse label_Item_incident\n      require row.incident!=null\n      alert row.incident\n     text row.service,row.photo,row.completed\n     actions match,forward,return_item,incident\n     button opens=collect_detail\n     modal \"Record collection\"@{nl=\"Afhaling registreren\"} id=collect_detail\n      slot content\n       form collect arguments={item=row} display=inline\n        textarea evidence\n     list row.Dispatch display=split empty=\"No forwarding attempts\"@{nl=\"Geen doorzendpogingen\"}\n      pagination\n      badge row.state\n      badge row.charge_state\n      text row.destination,row.instruction_revision,row.state,row.fee,row.charge_state,row.invoice\n      dropdown\n       slot trigger\n        text \"Forwarding follow-up\"@{nl=\"Doorzendopvolging\"}\n       slot content\n        form dispatched arguments={dispatch=row,revision=row.revision}\n        form uncertain arguments={dispatch=row,revision=row.revision}\n        action retry_fee\n     table row.Handling columns=kind,instruction,revision,destination,evidence,carrier,fee empty=\"No handling records\"@{nl=\"Geen afhandelingsregistraties\"}\n      pagination\n     history\n  # Follow only your own mail and authorized collection delegates. @{nl=\"Volg uitsluitend je eigen post en geautoriseerde afhaalgemachtigden.\"}\n  page /mailroom/mine title=\"My mail\"@{nl=\"Mijn post\"} order=1\n   require authenticated\n   breadcrumbs\n   card \"Own service\"@{nl=\"Eigen postdienst\"}\n    list Service display=split empty=\"No mail service yet\"@{nl=\"Nog geen postdienst\"}\n     pagination\n     text row.location,row.from,row.until,row.instructions,row.forwarding,row.revision\n     form instructions arguments={service=row,revision=row.revision}\n      textarea instructions\n      textarea forwarding\n     form Delegate.create\n     list row.Delegate empty=\"No collection delegates\"@{nl=\"Geen afhaalgemachtigden\"}\n      pagination\n      text row.contact,row.account,row.active\n      edit\n   card \"Own mail outcomes\"@{nl=\"Eigen postresultaten\"}\n    tabs preferences.view\n    table Item as item where preferences.view==all or (preferences.view==collection and item.state in [received,notified,collection_ready]) or (preferences.view==forwarding and item.state in [forward_pending,forwarded]) or (preferences.view==history and item.state in [collected,forwarded,returned]) columns=recipient,kind,state,notice_state,completed filter=state display=split empty=\"No own mail items\"@{nl=\"Geen eigen poststukken\"}\n     pagination\n     badge row.state\n     status row.notice_state\n     table row.Handling columns=kind,account,instruction,revision,destination,evidence,carrier,fee,created empty=\"No handling records\"@{nl=\"Geen afhandelingsregistraties\"}\n      pagination\n"}}
