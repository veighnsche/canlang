{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"38938ff15ed30a0c471fa41ae161af2a28a5d07fd5443c290c05db3eeaf46074","before_projection_sha256":"38938ff15ed30a0c471fa41ae161af2a28a5d07fd5443c290c05db3eeaf46074","changed":false,"idempotent":true,"structure_equal":true,"text":"# Optionally help reception or café staff seat guests at an on-site workspace café or restaurant. @{nl=\"Help desgewenst receptie- of cafémedewerkers gasten te plaatsen in het werkplekcafé of restaurant.\"}\napp CanTable uses=[cafe]\n\n# Keep café waiting, interval reservations and actual occupied tables distinct. @{nl=\"Houd wachtende cafégasten, tijdvakreserveringen en werkelijk bezette tafels gescheiden.\"}\npackage cafe\n use rent_catalog {Location,test_site}\n use employee {can_work,test_worker}\n Given\n  preferences { cafe:Cafe? label=label_Cafe, view:enum(all,waiting,reservations,occupancy)=all label={text=\"Initial view\"@{nl=\"Beginweergave\"},values={waiting=label_Booking_state_waiting,all=\"All\"@{nl=\"Alles\"},reservations=\"Reservations\"@{nl=\"Reserveringen\"},occupancy=\"Physical occupancy\"@{nl=\"Werkelijke bezetting\"}}} }\n  message label_Cafe = \"Café\"@{nl=\"Café\"}\n  message label_Table = \"Dining table\"@{nl=\"Cafétafel\"}\n  message label_Booking_state_waiting = \"Waiting\"@{nl=\"Wachtend\"}\n  message label_Booking_state_no_show = \"No-show\"@{nl=\"Niet verschenen\"}\n  role host label=\"Café host\"@{nl=\"Cafémedewerker\"}\n  Cafe { location:Location, name:text } label=label_Cafe\n  Table in Cafe { name:text, zone:text label=\"Table zone\"@{nl=\"Tafelzone\"}, seats:int min=1 label=\"Seats\"@{nl=\"Zitplaatsen\"}, active:bool=true } label=label_Table\n  Booking in Cafe { name:text, contact:text? label=\"Guest contact\"@{nl=\"Contactgegevens gast\"}, party:int min=1 label=\"Party size\"@{nl=\"Aantal gasten\"}, notes:text?, arrived:datetime server=now label=\"Arrival time\"@{nl=\"Aankomsttijd\"}, priority:int=0 label=\"Queue priority\"@{nl=\"Wachtrijprioriteit\"}, table:Table? label=label_Table, from:datetime? label=\"Reserved from\"@{nl=\"Gereserveerd vanaf\"}, until:datetime? label=\"Reserved until\"@{nl=\"Gereserveerd tot\"}, estimated_until:datetime? label=\"Estimated seating end\"@{nl=\"Geschat einde van het tafelgebruik\"}, seated:datetime? label=\"Actual seating time\"@{nl=\"Werkelijk zitmoment\"}, cleared:datetime? label=\"Actual clearance time\"@{nl=\"Werkelijk vrijgavemoment\"}, state:enum(waiting,reserved,seated,cleared,cancelled,no_show)=waiting label={text=\"State\"@{nl=\"Status\"},values={waiting=label_Booking_state_waiting,reserved=\"Reserved\"@{nl=\"Gereserveerd\"},seated=\"Seated\"@{nl=\"Zittend\"},cleared=\"Cleared\"@{nl=\"Vrijgegeven\"},cancelled=\"Cancelled\"@{nl=\"Geannuleerd\"},no_show=label_Booking_state_no_show}}, reason:text? } label=\"Booking\"@{nl=\"Reservering\"}\n  policy Cafe read=host and can_work(actor,row.location)\n  policy Table read=host and can_work(actor,row.parent.location)\n  policy Booking read=host and can_work(actor,row.parent.location)\n  invariant Table: not any(row.parent.Booking as booking,booking.table==row and (booking.state==reserved or (booking.seated!=null and booking.cleared==null)) and (not row.active or booking.party>row.seats))\n  invariant Booking: row.table==null or row.table.parent==row.parent\n  invariant Booking: (row.from==null and row.until==null) or (row.from!=null and row.until!=null and row.from<row.until)\n  invariant Booking: row.state!=reserved or (row.table!=null and row.from!=null and row.until!=null and row.party<=row.table.seats and available(row.table,row.from,row.until,row))\n  invariant Booking: row.seated==null or (row.table!=null and row.estimated_until!=null and row.seated<row.estimated_until and (row.cleared==null or row.seated<=row.cleared))\n  invariant Booking: row.state!=seated or (row.seated!=null and row.cleared==null and row.table!=null and row.table.active and row.party<=row.table.seats and not any(row.parent.Booking as booking,booking!=row and booking.table==row.table and booking.seated!=null and booking.cleared==null))\n  invariant Booking: row.state!=cleared or (row.seated!=null and row.cleared!=null)\n  invariant Booking: not (row.state in [cancelled,no_show]) or trim(row.reason??\"\")!=\"\"\n  derive available(table:Table,from:datetime,until:datetime,skip:Booking?):bool = table.active and not any(table.parent.Booking as booking,booking!=skip and booking.table==table and booking.state in [reserved,seated] and booking.from!=null and booking.until!=null and overlaps(from,until,booking.from,booking.until))\n  derive Booking.overdue:bool = row.seated!=null and row.cleared==null and row.estimated_until!=null and row.estimated_until<=now label=\"Seating estimate exceeded\"@{nl=\"Zitschatting overschreden\"}\n  derive Booking.conflict:bool = row.state==reserved and row.table!=null and row.from!=null and any(row.parent.Booking as booking,booking!=row and booking.table==row.table and booking.seated!=null and booking.cleared==null and (row.from<=now or booking.overdue or (booking.estimated_until!=null and booking.estimated_until>row.from))) label=\"Occupied table conflict\"@{nl=\"Conflict met bezette tafel\"}\n  fixture cafe=Cafe {location=test_site,name=\"Café\"}\n  fixture table=Table {parent=cafe,name=\"1\",zone=\"Main\",seats=4}\n  fixture spare=Table {parent=cafe,name=\"2\",zone=\"Main\",seats=4}\n  fixture walk_in=Booking {parent=cafe,name=\"Walk-in\",party=2}\n  fixture diners=Booking {parent=cafe,name=\"Guest\",party=2,table=table,seated=now-1h,estimated_until=now-1m,state=seated}\n  fixture upcoming=Booking {parent=cafe,name=\"Reservation\",party=2,table=table,from=now+30m,until=now+1h,state=reserved}\n When\n  crud Cafe by=host fields=name create_fields=location,name when=can_work(actor,row.location) delete=none\n  crud Table by=host fields=name,zone,seats,active when=can_work(actor,row.parent.location) delete=none\n   examples update seed=[test_worker,upcoming] record=table changes={seats=4}\n    as,changes.seats,changes.active -> record.seats,record.active,upcoming.state\n    host,3,true -> 3,true,reserved\n    host,1,true -> error(rule_failed)\n    host,4,false -> error(rule_failed)\n   examples update seed=[test_worker,diners] record=table changes={active=true}\n    as,changes.active,changes.seats -> record.active,record.seats,diners.cleared\n    host,false,4 -> error(rule_failed)\n    host,true,1 -> error(rule_failed)\n    host,true,3 -> true,3,null\n   examples update seed=[test_worker,diners] record=table changes={active=false,seats=1}\n    as,diners.state,diners.cleared -> record.active,record.seats,diners.state\n    host,cleared,now -> false,1,cleared\n   examples update seed=[test_worker] record=table changes={active=false,seats=1}\n    as -> record.active,record.seats\n    host -> false,1\n    members -> error(forbidden)\n  crud Booking by=host fields=name,contact,party,notes,priority when=can_work(actor,row.parent.location) and row.state in [waiting,reserved] delete=none\n   examples create seed=[test_worker] parent=cafe name=\"Walk-in\" party=2\n    as -> first(cafe.Booking).state,first(cafe.Booking).table,first(cafe.Booking).from,first(cafe.Booking).seated\n    host -> waiting,null,null,null\n    members -> error(forbidden)\n   examples update seed=[test_worker] record=upcoming changes={party=3,notes=\"Window requested\"}\n    as,changes.party -> record.party,record.notes,record.state\n    host,3 -> 3,\"Window requested\",reserved\n    host,5 -> error(rule_failed)\n    members,3 -> error(forbidden)\n  # Confirm or move a suitable reservation; changing a confirmed interval requires a recorded reason. @{nl=\"Bevestig of verplaats een geschikte reservering; wijziging van een bevestigd tijdvak vereist een vastgelegde reden.\"}\n  scenario reserve(booking:Booking,table:Table,from:datetime label=\"From\"@{nl=\"Van\"},until:datetime label=\"Until\"@{nl=\"Tot\"},reason:text?) by=host label=\"Reserve dining table\"@{nl=\"Cafétafel reserveren\"}\n   require can_work(actor,booking.parent.location) and booking.state in [waiting,reserved] and (booking.state==waiting or trim(reason??\"\")!=\"\") and table.parent==booking.parent and booking.party<=table.seats and from>=now and from<until and available(table,from,until,booking)\n   do set booking {table,from,until,state=reserved,reason}\n   examples seed=[test_worker] booking=walk_in table=table from=now+30m until=now+1h reason=null\n    as,table.seats,table.active,test_worker.active -> booking.state,booking.from,booking.seated\n    host,4,true,true -> reserved,now+30m,null\n    host,1,true,true -> error(rule_failed)\n    host,4,false,true -> error(rule_failed)\n    members,4,true,true -> error(forbidden)\n    host,4,true,false -> error(rule_failed)\n   examples seed=[test_worker] booking=upcoming table=spare from=now+1h until=now+2h reason=\"Move away from overrun\"\n    as,reason -> booking.table,booking.from,booking.reason\n    host,\"Move away from overrun\" -> spare,now+1h,\"Move away from overrun\"\n    host,\" \" -> error(rule_failed)\n   examples seed=[test_worker,upcoming,diners] booking=walk_in table=table from=now+1h until=now+2h reason=null\n    as,from -> booking.state,upcoming.conflict,diners.cleared,diners.overdue\n    host,now+1h -> reserved,true,null,true\n    host,now+45m -> error(rule_failed)\n  # Record actual seating only at a currently clear suitable table. @{nl=\"Leg werkelijk plaatsnemen alleen aan een momenteel vrije geschikte tafel vast.\"}\n  scenario seat(booking:Booking,table:Table,estimated_until:datetime label=\"Estimated seating end\"@{nl=\"Geschat einde van het tafelgebruik\"}) by=host label=\"Record seating\"@{nl=\"Plaatsnemen vastleggen\"}\n   require can_work(actor,booking.parent.location) and booking.state in [waiting,reserved] and (booking.state==waiting or booking.table==table) and table.parent==booking.parent and booking.party<=table.seats and estimated_until>now and available(table,now,estimated_until,booking) and not any(booking.parent.Booking as other,other.table==table and other.seated!=null and other.cleared==null)\n   do set booking {table,seated=now,estimated_until,state=seated}\n   examples seed=[test_worker] booking=walk_in table=table estimated_until=now+1h\n    as,estimated_until -> booking.state,booking.seated,booking.from,booking.until,booking.estimated_until\n    host,now+1h -> seated,now,null,null,now+1h\n    host,now -> error(rule_failed)\n    members,now+1h -> error(forbidden)\n   examples seed=[test_worker,diners,upcoming] booking=walk_in table=table estimated_until=now+10m\n    as -> diners.overdue,upcoming.conflict\n    host -> error(rule_failed)\n   examples seed=[test_worker] booking=upcoming table=table estimated_until=now+2h\n    as -> booking.table,booking.from,booking.until,booking.estimated_until\n    host -> table,now+30m,now+1h,now+2h\n  # Clear only this currently seated party; elapsed estimates cannot perform this action. @{nl=\"Geef alleen deze momenteel zittende groep vrij; verstreken schattingen kunnen deze handeling niet uitvoeren.\"}\n  scenario clear(booking:Booking,reason:text) by=host label=\"Clear dining table\"@{nl=\"Cafétafel vrijgeven\"}\n   require can_work(actor,booking.parent.location) and booking.state==seated and booking.cleared==null and trim(reason)!=\"\"\n   do set booking {state=cleared,cleared=now,reason}\n   examples seed=[test_worker,upcoming] booking=diners reason=\"Table cleared\"\n    as,reason -> booking.state,booking.cleared,booking.reason,upcoming.conflict\n    host,\"Table cleared\" -> cleared,now,\"Table cleared\",false\n    host,\" \" -> error(rule_failed)\n    members,\"Table cleared\" -> error(forbidden)\n   examples seed=[test_worker] booking=diners reason=\"Table cleared\"\n    as,request.booking.version -> booking.state\n    host,0 -> error(conflict)\n   examples seed=[test_worker] booking=walk_in reason=\"Wrong party\"\n    as -> booking.state\n    host -> error(rule_failed)\n  # Resolve a waiting or reserved cancellation or no-show with a reason. @{nl=\"Verwerk een annulering of niet-verschenen groep met een reden bij een wachtende of gereserveerde boeking.\"}\n  scenario cancel(booking:Booking,missed:bool label=label_Booking_state_no_show,reason:text) by=host\n   require can_work(actor,booking.parent.location) and booking.state in [waiting,reserved] and trim(reason)!=\"\"\n   do\n    if missed\n     set booking {state=no_show,reason}\n    else\n     set booking {state=cancelled,reason}\n   examples seed=[test_worker,diners] booking=upcoming missed=false reason=\"Occupied table; guest declined relocation\"\n    as,missed,reason -> booking.state,booking.reason,diners.cleared\n    host,false,\"Guest declined relocation\" -> cancelled,\"Guest declined relocation\",null\n    host,true,\"Guest did not arrive\" -> no_show,\"Guest did not arrive\",null\n    host,true,\" \" -> error(rule_failed)\n    members,false,\"Guest declined relocation\" -> error(forbidden)\n   examples seed=[test_worker] booking=diners missed=false reason=\"Still dining\"\n    as -> booking.state\n    host -> error(rule_failed)\n Then\n  # Run a host floor view with separate waiting, upcoming and actual occupancy evidence. @{nl=\"Bedien het café met afzonderlijk bewijs van wachten, toekomstige reserveringen en werkelijk gebruik.\"}\n  page /cafe title=\"Café host\"@{nl=\"Cafébediening\"}\n   require host\n   breadcrumbs\n   form Cafe.create\n    input name\n    select location\n   list Cafe as cafe where preferences.cafe==null or cafe==preferences.cafe empty=\"No cafés available.\"@{nl=\"Geen cafés beschikbaar.\"}\n    pagination\n    card \"Café and table definitions\"@{nl=\"Café- en tafeldefinities\"}\n     edit\n     text cafe.location\n     form Table.create\n      fieldset \"Dining table\"@{nl=\"Cafétafel\"}\n       input name\n       input zone\n       input seats\n       checkbox active\n     table row.Table columns=name,zone,seats,active empty=\"No tables defined yet.\"@{nl=\"Nog geen tafels gedefinieerd.\"}\n      pagination\n      edit\n      history\n    card \"Walk-in intake\"@{nl=\"Invoer van binnenlopende gasten\"}\n     form Booking.create display=inline\n      ## Seating interval and table come from the reserve/seat flows.\n      input name\n      input contact\n      input party\n      textarea notes\n      input priority\n    card \"Waiting, reservations and physical occupancy\"@{nl=\"Wachten, reserveringen en werkelijke bezetting\"}\n     tabs preferences.view\n     table row.Booking as booking where preferences.view==all or (preferences.view==waiting and booking.state==waiting) or (preferences.view==reservations and booking.state==reserved) or (preferences.view==occupancy and booking.seated!=null and booking.cleared==null) columns=name,party,priority,arrived,table,from,until,estimated_until,seated,cleared,state,overdue,conflict order=-priority,arrived filter=state display=split empty=\"No bookings match this view.\"@{nl=\"Geen boekingen voor deze weergave.\"}\n      pagination\n      badge row.state\n      ## Overdue estimates and table conflicts keep their own notices; elapsed estimates never release occupancy.\n      alert\n       require row.overdue\n       text \"Seating estimate exceeded; the table stays occupied until staff clear it.\"@{nl=\"Zitschatting overschreden; de tafel blijft bezet tot het personeel deze vrijgeeft.\"}\n      alert\n       require row.conflict\n       text \"This reservation conflicts with an uncleared party on the same table.\"@{nl=\"Deze reservering botst met een niet-vrijgegeven groep aan dezelfde tafel.\"}\n      edit\n      button opens=reserve_table\n      modal \"Reserve dining table\"@{nl=\"Cafétafel reserveren\"} id=reserve_table\n       slot content\n        form reserve arguments={booking=row} display=inline\n         fieldset \"Reservation interval\"@{nl=\"Reserveringstijdvak\"}\n          select table\n          input from\n          input until\n          textarea reason\n      button opens=record_seating\n      modal \"Record seating\"@{nl=\"Plaatsnemen vastleggen\"} id=record_seating\n       slot content\n        form seat arguments={booking=row} display=inline\n         fieldset \"Seating\"@{nl=\"Plaatsnemen\"}\n          select table\n          input estimated_until\n      button opens=clear_table\n      modal \"Clear dining table\"@{nl=\"Cafétafel vrijgeven\"} id=clear_table\n       slot content\n        form clear arguments={booking=row} display=inline\n         textarea reason\n      button opens=cancel_booking\n      modal \"Cancel booking\"@{nl=\"Boeking annuleren\"} id=cancel_booking\n       slot content\n        form cancel arguments={booking=row} display=inline\n         fieldset \"Cancellation\"@{nl=\"Annulering\"}\n          checkbox missed\n          textarea reason\n      collapse \"Guest and planned interval evidence\"@{nl=\"Gastgegevens en geplande tijdvakken\"}\n       text row.contact,row.notes,row.reason\n      collapse \"Uncleared diners affecting this reservation\"@{nl=\"Niet-vrijgegeven gasten die deze reservering raken\"}\n       require booking.conflict\n       table cafe.Booking as occupant where occupant.table==booking.table and occupant.seated!=null and occupant.cleared==null columns=name,party,table,seated,estimated_until,overdue empty=\"No uncleared diners.\"@{nl=\"Geen niet-vrijgegeven gasten.\"}\n        pagination\n        form clear arguments={booking=row}\n      collapse \"Upcoming reservations affected by this occupancy\"@{nl=\"Toekomstige reserveringen geraakt door deze bezetting\"}\n       require booking.seated!=null and booking.cleared==null\n       table cafe.Booking as upcoming where upcoming.state==reserved and upcoming.table==booking.table and upcoming.conflict columns=name,party,table,from,until,conflict order=from empty=\"No affected upcoming reservations.\"@{nl=\"Geen geraakte toekomstige reserveringen.\"}\n        pagination\n        form reserve arguments={booking=row}\n        form cancel arguments={booking=row}\n      history\n"}}
