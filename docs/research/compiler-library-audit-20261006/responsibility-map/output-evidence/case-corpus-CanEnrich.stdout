{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"84b33eff26686bb39f3de41517b2c80fc5ccf720395e2a112529a9899d735d9c","before_projection_sha256":"84b33eff26686bb39f3de41517b2c80fc5ccf720395e2a112529a9899d735d9c","changed":true,"idempotent":true,"structure_equal":true,"text":"# Enrich known companies with reviewed registry facts and retained source evidence. @{nl=\"Verrijk bekende bedrijven met beoordeelde registergegevens en bewaard bronbewijs.\"}\napp CanEnrich uses=[enrich]\n\npackage enrich label=\"Company enrichment\"@{nl=\"Bedrijfsverrijking\"}\n use customer {Customer,test_company}\n use enrich {SourcesV1 as Sources} from=deployment.company_sources\n Given\n  role researcher label=\"Company researcher\"@{nl=\"Bedrijfsonderzoeker\"}\n  role reviewer label=\"Fact reviewer\"@{nl=\"Gegevensbeoordelaar\"}\n  export contract Fact { value:text trim min=1 max=2000, source:url, observed:datetime?, detail:text? max=2000 }\n  contract Report { number:text min=8 max=8, provider:enum(registry,aggregator), complete:bool, legal_name:Fact?, registered_office:Fact?, registry_status:Fact?, detail:text? max=2000 }\n  export capability SourcesV1 version=1\n   lookup(number:Report.number,provider:Report.provider) -> Report\n  export Company { customer:Customer, number:Report.number, enabled:bool=true, current:Run? } label=\"Linked legal company\"@{nl=\"Gekoppelde rechtspersoon\"}\n  Lookup in Company { provider:Report.provider, request:delivery(Sources.lookup)? } label=\"Provider evidence\"@{nl=\"Extern bronbewijs\"}\n  Run in Company { requested_by:user server=actor, primary:Lookup?, fallback:Lookup?, allow_fallback:bool, stopped:bool=false } label=\"Enrichment review\"@{nl=\"Verrijkingsbeoordeling\"}\n  export AcceptedFact in Company { field:enum(legal_name,registered_office,registry_status), ordinal:int min=1, lookup:Lookup, value:Fact, prior:AcceptedFact?, reason:text trim min=1 max=2000, reviewer:user server=actor } label=\"Accepted company fact\"@{nl=\"Geaccepteerd bedrijfsgegeven\"}\n  event Assess { run:Run }\n  policy Company read=researcher or reviewer\n  policy Lookup read=researcher or reviewer\n  policy Run read=researcher or reviewer\n  policy AcceptedFact read=researcher or reviewer\n  invariant Company: row.current==null or row.current.parent==row\n  invariant Run: row.primary!=null and row.primary.parent==row.parent and (row.fallback==null or row.fallback.parent==row.parent)\n  invariant AcceptedFact: row.lookup.parent==row.parent and (row.prior==null or (row.prior.parent==row.parent and row.prior.field==row.field))\n  unique Company fields=customer,number\n  lock Company fields=customer,number\n  lock Lookup fields=provider,request\n  lock Run fields=requested_by,primary,allow_fallback\n  lock Run fields=fallback when=row.fallback!=null\n  unique AcceptedFact fields=field,ordinal\n  lock AcceptedFact fields=field,ordinal,lookup,value,prior,reason,reviewer\n  derive report(lookup:Lookup):Report? = lookup.request?.result\n  derive reusable(company:Company,provider:Report.provider):Lookup? = first(company.Lookup as lookup where lookup.provider==provider and lookup.created>=now-7d and lookup.request?.status==succeeded order=-lookup.created)\n  derive capacity(company:Company):bool = count(company.Lookup as lookup where local_date(lookup.created,\"UTC\")==local_date(now,\"UTC\"))<4\n  derive live(run:Run):bool = run.parent.enabled and run.parent.current==run and not run.stopped and researcher(run.requested_by) and run.parent.customer.active\n  derive incomplete(value:Report):bool = value.legal_name==null or value.registered_office==null or value.registry_status==null\n  derive selected(value:Report,field:AcceptedFact.field):Fact? = choose(field==legal_name,value.legal_name,choose(field==registered_office,value.registered_office,value.registry_status))\n  export derive current(company:Company,field:AcceptedFact.field):AcceptedFact? = first(company.AcceptedFact as fact where fact.field==field order=-fact.ordinal)\n  preferences { enabled:bool=true }\n  fixture analyst=user {roles=[researcher]}\n  fixture editor=user {roles=[reviewer]}\n  fixture linked_company=Company {customer=test_company,number=\"01234567\"}\n  fixture complete_receipt=Sources.lookup {request={number=\"01234567\",provider=registry},status=succeeded,result={number=\"01234567\",provider=registry,complete=true,legal_name={value=\"Example Limited\",source=\"https://example.test/registry/01234567\",observed=null,detail=null},registered_office=null,registry_status=null,detail=\"Address unavailable\"}}\n  fixture primary=Lookup {parent=linked_company,provider=registry,request=complete_receipt}\n  fixture secondary_receipt=Sources.lookup {request={number=\"01234567\",provider=aggregator},status=succeeded,result={number=\"01234567\",provider=aggregator,complete=true,legal_name={value=\"Example Ltd\",source=\"https://example.test/aggregator/01234567\",observed=null,detail=null},registered_office=null,registry_status=null,detail=null}}\n  fixture secondary=Lookup {parent=linked_company,provider=aggregator,request=secondary_receipt}\n  fixture review_run=Run {parent=linked_company,requested_by=analyst,primary=primary,fallback=secondary,allow_fallback=true}\n  fixture unknown_receipt=Sources.lookup {request={number=\"01234567\",provider=registry},status=unknown}\n  fixture unknown_lookup=Lookup {parent=linked_company,provider=registry,request=unknown_receipt}\n  fixture consented_run=Run {parent=linked_company,requested_by=analyst,primary=primary,allow_fallback=true}\n  fixture accepted=AcceptedFact {parent=linked_company,field=legal_name,ordinal=1,lookup=primary,value={value=\"Example Limited\",source=\"https://example.test/registry/01234567\",observed=null,detail=null},reason=\"Checked registry\",reviewer=editor}\n When\n  crud Company by=researcher fields=enabled create_fields=customer,number when=row.customer.active and row.customer.kind==company and (not row.enabled or not any(Company as link,link.id!=row.id and link.customer==row.customer and link.enabled)) delete=none\n  # Reuse a successful result or explicitly authorize a fresh paid lookup. @{nl=\"Hergebruik een geslaagd resultaat of machtig expliciet een nieuwe betaalde raadpleging.\"}\n  scenario start(company:Company,refresh:bool=false,fallback:bool=true) -> Run by=researcher label=\"Research company\"@{nl=\"Bedrijf onderzoeken\"}\n   require company.enabled and company.customer.active\n   do\n    create Run {parent=company,allow_fallback=fallback} as run\n    set company {current=run}\n    let cached=reusable(company,registry)\n    if not refresh and cached!=null\n     set run {primary=cached}\n     emit Assess {run}\n    else\n     require capacity(company)\n     create Lookup {parent=company,provider=registry} as lookup\n     send Sources.lookup {number=company.number,provider=registry} when=live(run) as request\n     set lookup {request}; set run {primary=lookup}\n    return run\n   examples company=linked_company seed=[primary] refresh=false fallback=true\n    as,company.enabled -> count(company.Lookup),company.current.primary==primary\n    analyst,true -> 1,true\n    analyst,false -> error(rule_failed)\n    members,true -> error(forbidden)\n   examples company=linked_company seed=[primary] refresh=true fallback=false\n    as -> count(company.Lookup),company.current.primary==primary\n    analyst -> 2,false\n   examples seed=[linked_company]\n    do\n     call start {company=linked_company,refresh=true,fallback=false} by=analyst\n     call start {company=linked_company,refresh=true,fallback=false} by=analyst\n     call start {company=linked_company,refresh=true,fallback=false} by=analyst\n     call start {company=linked_company,refresh=true,fallback=false} by=analyst\n     count(linked_company.Lookup) -> 4\n     call start {company=linked_company,refresh=true,fallback=false} by=analyst -> error(rule_failed)\n  # Only a selected live review may use the completion to continue its consented waterfall. @{nl=\"Alleen een geselecteerde actieve beoordeling mag na voltooiing verdergaan met de toegestane bronnenreeks.\"}\n  scenario looked_up on=Sources.lookup.completed\n   do\n    let lookup=first(Lookup as item where item.request?.id==event.delivery_id)\n    if lookup!=null and lookup.parent.current!=null and lookup.parent.current.primary==lookup\n     emit Assess {run=lookup.parent.current}\n  # Automatic secondary cost requires a definitive incomplete primary; uncertainty remains a human decision. @{nl=\"Automatische vervolgkosten vereisen een definitief onvolledig primair resultaat; onzekerheid blijft een menselijke beslissing.\"}\n  scenario assess on=Assess\n   do\n    let run=event.run\n    if live(run) and run.allow_fallback and run.fallback==null and run.primary!=null and run.primary.request?.status==succeeded\n     let value=report(run.primary)\n     if value!=null and value.complete and incomplete(value)\n      let cached=reusable(run.parent,aggregator)\n      if cached!=null\n       set run {fallback=cached}\n      else\n       if capacity(run.parent)\n        create Lookup {parent=run.parent,provider=aggregator} as lookup\n        send Sources.lookup {number=run.parent.number,provider=aggregator} when=live(run) as request\n        set lookup {request}; set run {fallback=lookup}\n   examples event={run=consented_run}\n    event.run.parent.current,event.run.primary,event.run.allow_fallback,event.run.stopped -> count(event.run.parent.Lookup),event.run.fallback!=null\n    consented_run,primary,true,false -> 2,true\n    consented_run,primary,false,false -> 1,false\n    consented_run,primary,true,true -> 1,false\n    consented_run,unknown_lookup,true,false -> 2,false\n   examples event={run=consented_run} seed=[secondary]\n    event.run.parent.current -> event.run.fallback==secondary,count(event.run.parent.Lookup)\n    consented_run -> true,2\n  # Explicitly consent to the secondary lookup after uncertainty or partial evidence. @{nl=\"Geef expliciet toestemming voor de tweede bron na onzeker of gedeeltelijk bewijs.\"}\n  scenario fallback(run:Run,refresh:bool=false) by=researcher label=\"Consult secondary source\"@{nl=\"Tweede bron raadplegen\"}\n   require live(run) and run.fallback==null and run.primary!=null and run.primary.request?.status in [succeeded,failed,unknown,skipped]\n   do\n    let cached=reusable(run.parent,aggregator)\n    if not refresh and cached!=null\n     set run {fallback=cached}\n    else\n     require capacity(run.parent)\n     create Lookup {parent=run.parent,provider=aggregator} as lookup\n     send Sources.lookup {number=run.parent.number,provider=aggregator} when=live(run) as request\n     set lookup {request}; set run {fallback=lookup}\n   examples run=consented_run refresh=false\n    as,run.parent.current,run.primary -> count(run.parent.Lookup),run.fallback!=null\n    analyst,consented_run,unknown_lookup -> 3,true\n    analyst,consented_run,primary -> 2,true\n    members,consented_run,primary -> error(forbidden)\n  # Accept one exact sourced fact against its previous decision; disagreeing providers never win silently. @{nl=\"Accepteer één exact brongegeven tegenover de vorige beslissing; tegenstrijdige bronnen winnen nooit stilzwijgend.\"}\n  scenario accept(run:Run,lookup:Lookup,field:AcceptedFact.field,prior:AcceptedFact?,reason:AcceptedFact.reason) by=reviewer label=\"Accept sourced fact\"@{nl=\"Brongegeven accepteren\"}\n   require live(run) and lookup in [run.primary,run.fallback] and lookup.request?.status==succeeded and current(run.parent,field)==prior\n   do\n    let value=report(lookup)\n    require value!=null and value.number==run.parent.number and value.provider==lookup.provider\n    let fact=selected(value,field)\n    require fact!=null and (prior==null or prior.value!=fact)\n    create AcceptedFact {parent=run.parent,field,ordinal=(prior?.ordinal??0)+1,lookup,value=fact,prior,reason} as accepted\n   examples run=review_run lookup=primary field=legal_name prior=null reason=\"Checked source\"\n    as,run.parent.current,run.stopped -> count(run.parent.AcceptedFact)\n    editor,review_run,false -> 1\n    editor,review_run,true -> error(rule_failed)\n    editor,null,false -> error(rule_failed)\n    members,review_run,false -> error(forbidden)\n   examples run=review_run lookup=secondary field=legal_name reason=\"Reviewed disagreement\" seed=[accepted]\n    as,run.parent.current,prior -> count(run.parent.AcceptedFact)\n    editor,review_run,accepted -> 2\n    editor,review_run,null -> error(rule_failed)\n   examples run=review_run lookup=primary field=registered_office prior=null reason=\"Missing is not a fact\"\n    as,run.parent.current -> count(run.parent.AcceptedFact)\n    editor,review_run -> error(rule_failed)\n  # Stop this review without pretending that a charged provider request was cancelled. @{nl=\"Stop deze beoordeling zonder te doen alsof een betaalde externe aanvraag is geannuleerd.\"}\n  scenario stop(run:Run) by=researcher label=\"Stop review\"@{nl=\"Beoordeling stoppen\"}\n   do set run {stopped=true}\n   examples seed=[primary]\n    do\n     call start {company=linked_company,refresh=false,fallback=false} by=analyst as started\n     call stop {run=started} by=analyst\n     let stopped=first(Run as run where run.id==started.id)\n     stopped!=null -> true\n     stopped.stopped,linked_company.current==stopped -> true,true\n     call accept {run=stopped,lookup=primary,field=legal_name,prior=null,reason=\"Late result\"} by=editor -> error(rule_failed)\n Then\n  # Compare evidence, usage and prior decisions before accepting individual facts. @{nl=\"Vergelijk bewijs, gebruik en eerdere beslissingen voordat u afzonderlijke gegevens accepteert.\"}\n  page /enrichment title=\"Company enrichment\"@{nl=\"Bedrijfsverrijking\"} poll=5s\n   require researcher or reviewer\n   breadcrumbs\n   ## Inline view of the same shared-dialog extension; the company filter reads it.\n   preferences\n    toggle enabled\n   form Company.create\n    select customer\n    input number\n   table Company as company where company.enabled==preferences.enabled columns=customer,number,enabled empty=\"No linked companies\"@{nl=\"Geen gekoppelde bedrijven\"}\n    pagination\n    edit fields=enabled\n     checkbox enabled\n    form start arguments={company}\n     checkbox refresh\n     checkbox fallback\n    details \"Research and accepted facts\"@{nl=\"Onderzoek en geaccepteerde gegevens\"} display=drawer\n     text count(company.Lookup as lookup where local_date(lookup.created,\"UTC\")==local_date(now,\"UTC\"))\n     table company.Run as run columns=created,requested_by,primary.request.status,fallback.request.status,allow_fallback,stopped empty=\"No enrichment reviews\"@{nl=\"Geen verrijkingsbeoordelingen\"}\n      pagination\n      action stop\n      button opens=fallback_dialog\n      modal \"Consult secondary source\"@{nl=\"Tweede bron raadplegen\"} id=fallback_dialog\n       slot content\n        form fallback arguments={run} display=inline\n         checkbox refresh\n      ## Primary and secondary reports side by side; selection stays human work.\n      diff\n       slot before\n        text run.primary?.request?.result\n       slot after\n        text run.fallback?.request?.result\n      form accept arguments={run}\n       ## lookup and prior keep their generated controls: only this run's lookups and the current prior are admissible.\n       radio field\n       textarea reason\n     table company.AcceptedFact columns=field,ordinal,value,lookup.provider,prior,reviewer,reason,created empty=\"No accepted facts\"@{nl=\"Geen geaccepteerde gegevens\"}\n      pagination\n     divider \"Provider receipts\"@{nl=\"Externe bronbewijzen\"}\n     table company.Lookup columns=provider,created,request.status,request.result,request.error empty=\"No provider evidence\"@{nl=\"Geen extern bronbewijs\"}\n      pagination\n     history\n"}}
