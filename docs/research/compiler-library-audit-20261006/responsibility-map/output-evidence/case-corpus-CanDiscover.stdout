{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"1327dfcfbf991ebaabaa07ceacc889f040577cf126f703be1f290b539321b99d","before_projection_sha256":"1327dfcfbf991ebaabaa07ceacc889f040577cf126f703be1f290b539321b99d","changed":true,"idempotent":true,"structure_equal":true,"text":"# Monitor two declared opportunity sources and promote only staff-reviewed evidence. @{nl=\"Volg twee vastgelegde kansenbronnen en promoveer alleen door medewerkers beoordeeld bewijs.\"}\napp CanDiscover uses=[discover]\n\n# Retain source coverage, uncertain claims and reviewed CRM handoffs. @{nl=\"Bewaar brondekking, onzekere claims en beoordeelde CRM-overdrachten.\"}\npackage discover label=\"Opportunity research\"@{nl=\"Kansenonderzoek\"}\n use employee {Employee,can_work,test_worker}\n use rent_catalog {Location,test_site}\n use customer {Customer,Contact,test_company,test_contact}\n use crm {Deal,ResearchLead,promote_research,salesperson}\n use discover {DiscoverySourceV1 as Sources} from=deployment.discovery_sources\n use discover {DiscoveryAnalysisV1 as Analysis} from=deployment.discovery_analysis\n Given\n  role researcher label=\"Researcher\"@{nl=\"Onderzoeker\"}\n  role reviewer label=\"Research reviewer\"@{nl=\"Onderzoeksbeoordelaar\"}\n  export contract Document { key:text min=1, revision:text min=1, url:url, title:text, body:text max=60000, deadline_original:text?, deadline_zone:timezone?, retrieved:datetime }\n  export contract SourcePage { documents:Document[] max=20, next_cursor:text?, terminal:bool, source_as_of:datetime?, traversal:enum(snapshot,live,uncertain), detail:text? }\n  export contract Query { source:enum(ted,grants_gov), take:int min=1 max=20 }\n  export contract AnalysisLimit { output_tokens:int min=1 max=4000 }\n  ## Bound adapters freeze source/query/publication [from,until) UTC dates; cursor cannot silently reset.\n  ## One page call permits one search page plus at most 20 detail fetches; take is a rejection bound, not truncation.\n  export capability DiscoverySourceV1 version=1\n   page(source:Query.source,query:text,from:date,until:date,cursor:text?,take:Query.take) -> SourcePage\n  export contract Citation { field:enum(title,summary,deadline,fit), quote:text min=1 }\n  export contract Claims { title:text min=1, summary:text, deadline:datetime?, deadline_original:text?, deadline_zone:timezone?, deadline_uncertain:bool, citations:Citation[] max=20, fit:decimal min=0 max=1, confidence:decimal min=0 max=1, rationale:text }\n  export capability DiscoveryAnalysisV1 version=1\n   extract(document:Document,criteria:text,output_tokens:AnalysisLimit.output_tokens) -> Claims\n  contract Settings { ted_query:text, grants_query:text, from:date, until:date, criteria:text, max_pages:int, max_documents:int, max_analysis:int, output_tokens:int }\n  Plan { name:text trim min=1, location:Location, owner:user server=actor, active:bool=true, revision:int=1, period:duration=7d, lookback_days:int=7, ted_query:text, grants_query:text, criteria:text, max_pages:int=3, max_documents:int=100, max_analysis:int=20, output_tokens:int=2000, current:Run? }\n  Run in Plan { settings:Settings, initiator:user, plan_revision:int, started:datetime server=now, stopped:bool=false, document_slots:int=0, analysis_slots:int=0 }\n  SourcePass in Run { source:Query.source, query:text, cursor:text?, requests:int=0, state:enum(ready,fetching,exhausted,capped,attention,cancelled)=ready, current:PageAttempt?, detail:text? }\n  PageAttempt in SourcePass { cursor:text?, take:int, request:delivery(Sources.page)?, applied:bool=false, late:bool=false, next_cursor:text?, terminal:bool=false, traversal:SourcePage.traversal?, observed:datetime?, source_as_of:datetime?, detail:text? }\n  Opportunity in Plan { source:SourcePass.source, key:text, canonical_url:url, identity_conflict:bool=false, duplicate_of:Opportunity?, identity_note:text?, deal:Deal? }\n  Evidence in Opportunity { ordinal:int min=1, document:Document, run:Run, page:PageAttempt, analysis:delivery(Analysis.extract)?, claims:Claims?, analysis_issue:text? }\n  Conflict in Opportunity { document:Document, run:Run, page:PageAttempt, observed:datetime server=now }\n  Review in Opportunity { evidence:Evidence, title:text trim min=1, summary:text, deadline:datetime?, deadline_zone:timezone?, deadline_note:text trim min=1, quotes:text[] min=1 max=20, reviewed_by:user server=actor, reviewed_at:datetime server=now }\n  event PlanDue { plan:Plan, revision:int }\n  event PageDue { pass:SourcePass }\n  policy Plan read=(researcher or reviewer) and can_work(actor,row.location)\n  policy Run read=(researcher or reviewer) and can_work(actor,row.parent.location)\n  policy SourcePass read=(researcher or reviewer) and can_work(actor,row.parent.parent.location)\n  policy PageAttempt read=(researcher or reviewer) and can_work(actor,row.parent.parent.parent.location)\n  policy Opportunity read=(researcher or reviewer) and can_work(actor,row.parent.location)\n  policy Evidence read=(researcher or reviewer) and can_work(actor,row.parent.parent.location)\n  policy Conflict read=(researcher or reviewer) and can_work(actor,row.parent.parent.location)\n  policy Review read=(researcher or reviewer) and can_work(actor,row.parent.parent.location)\n  unique SourcePass fields=source\n  unique Opportunity fields=source,key\n  unique Evidence fields=document.revision\n  unique Evidence fields=ordinal\n  lock Plan fields=location\n  lock Run fields=settings,initiator,plan_revision,started\n  lock SourcePass fields=source,query\n  lock PageAttempt fields=cursor,take\n  lock Evidence fields=ordinal,document,run,page\n  lock Evidence fields=claims when=row.claims!=null\n  lock Conflict fields=document,run,page,observed\n  lock Review fields=evidence,title,summary,deadline,deadline_zone,deadline_note,quotes,reviewed_by,reviewed_at\n  invariant Plan: row.period>=1d and row.lookback_days>=1 and row.lookback_days<=90 and row.max_pages>=1 and row.max_pages<=20 and row.max_documents>=1 and row.max_documents<=400 and row.max_analysis>=0 and row.max_analysis<=100 and row.output_tokens>=1 and row.output_tokens<=4000\n  invariant Review: row.evidence.parent==row.parent and all(row.quotes as quote,trim(quote)!=\"\" and contains(row.evidence.document.body,quote)) and (row.deadline==null or row.deadline_zone!=null)\n  derive Opportunity.needs_identity_review:bool = row.identity_conflict or (row.duplicate_of==null and any(row.parent.Opportunity as other,other!=row and other.canonical_url==row.canonical_url and other.duplicate_of!=row))\n  derive Opportunity.latest:Evidence? = first(row.Evidence as evidence order=-evidence.ordinal)\n  derive settings(plan:Plan):Settings = Settings {ted_query=plan.ted_query,grants_query=plan.grants_query,from=add_days(local_date(now,\"UTC\"),-plan.lookback_days),until=add_days(local_date(now,\"UTC\"),1),criteria=plan.criteria,max_pages=plan.max_pages,max_documents=plan.max_documents,max_analysis=plan.max_analysis,output_tokens=plan.output_tokens}\n  derive settled(run:Run):bool = count(run.SourcePass)==2 and all(run.SourcePass as pass,pass.state in [exhausted,capped,attention,cancelled])\n  derive eligible(run:Run):bool = run.parent.current==run and not run.stopped and run.parent.active and researcher(run.initiator) and can_work(run.initiator,run.parent.location)\n  derive Run.complete:bool = count(row.SourcePass)==2 and all(row.SourcePass as pass,pass.state==exhausted and any(pass.PageAttempt as attempt,attempt.applied) and all(pass.PageAttempt as attempt,not attempt.applied or (attempt.traversal==snapshot and attempt.source_as_of!=null and attempt.source_as_of==first(pass.PageAttempt as baseline where baseline.applied).source_as_of)))\n  derive Opportunity.expired:bool = any(row.Review as review,review.evidence==row.latest and review.deadline!=null and review.deadline<=now)\n  fixture analyst=user {roles=[researcher,reviewer,salesperson]}\n  fixture analyst_worker=Employee {user=analyst,home=test_site,locations=[test_site],start=date(\"2026-10-01\"),role=\"Research\"}\n  fixture plan=Plan {name=\"Public opportunities\",location=test_site,owner=self,ted_query=\"environment\",grants_query=\"environment\",criteria=\"Documented environmental services fit\"}\n  fixture run=Run {parent=plan,settings=settings(plan),initiator=analyst,plan_revision=1}\n  fixture pass=SourcePass {parent=run,source=ted,query=\"environment\"}\n  fixture page=PageAttempt {parent=pass,cursor=null,take=1}\n  fixture opportunity=Opportunity {parent=plan,source=ted,key=\"notice-1\",canonical_url=\"https://example.test/notice/1\"}\n  fixture collision=Opportunity {parent=plan,source=grants_gov,key=\"alternate-notice\",canonical_url=opportunity.canonical_url,identity_conflict=true}\n  fixture evidence=Evidence {parent=opportunity,ordinal=1,document={key=\"notice-1\",revision=\"v1\",url=\"https://example.test/notice/1\",title=\"Environmental work\",body=\"Environmental work. Deadline not specified.\",deadline_original=null,deadline_zone=null,retrieved=now},run=run,page=page}\n  fixture page_receipt=Sources.page {request={source=ted,query=\"environment\",from=run.settings.from,until=run.settings.until,cursor=null,take=1},status=succeeded,result={documents=[],next_cursor=\"next-1\",terminal=false,source_as_of=null,traversal=live,detail=null}}\n  fixture reviewed=Review {parent=opportunity,evidence=evidence,title=\"Environmental work\",summary=\"Manual review\",deadline=null,deadline_zone=null,deadline_note=\"Source does not specify a deadline; verified before sales intake\",quotes=[\"Environmental work.\"]}\n When\n  crud Plan by=researcher fields=name create_fields=name,location,ted_query,grants_query,criteria when=can_work(actor,row.location) delete=none\n  # Start a frozen research run and reserve one durable continuation for each source. @{nl=\"Start een vastgelegde onderzoeksronde met een duurzame voortzetting per bron.\"}\n  scenario start(plan:Plan) by=researcher -> Run label=\"Run now\"@{nl=\"Nu uitvoeren\"}\n   require can_work(actor,plan.location) and plan.active and (plan.current==null or plan.current.stopped or settled(plan.current))\n   do\n    create Run {parent=plan,settings=settings(plan),initiator=actor,plan_revision=plan.revision} as run\n    create SourcePass {parent=run,source=ted,query=run.settings.ted_query} as ted\n    create SourcePass {parent=run,source=grants_gov,query=run.settings.grants_query} as grants\n    set plan {current=run}\n    schedule ted.id at=now event=PageDue {pass=ted}\n    schedule grants.id at=now event=PageDue {pass=grants}\n    schedule plan.id at=now+plan.period event=PlanDue {plan,revision=plan.revision}\n    return run\n   examples seed=[test_worker] plan=plan\n    as,plan.active -> count(plan.Run),count(result.SourcePass)\n    researcher,true -> 1,2\n    researcher,false -> error(rule_failed)\n    members,true -> error(forbidden)\n   ## Shared-state operation sequence; queued effects stay isolated and never contact providers.\n   examples seed=[analyst_worker,plan]\n    do\n     call start {plan=plan} by=analyst as started\n     count(started.SourcePass),started.stopped -> 2,false\n     call pause {plan=plan} by=analyst\n     plan.active,plan.current.stopped,all(plan.current.SourcePass as pass,pass.state==cancelled) -> false,true,true\n     call start {plan=plan} by=analyst -> error(rule_failed)\n     call take_over {plan=plan} by=analyst\n     call resume {plan=plan} by=analyst\n     call start {plan=plan} by=analyst as replacement\n     count(plan.Run),replacement.stopped -> 2,false\n     call stop {run=replacement} by=other -> error(forbidden)\n  # Replace future settings; existing runs keep their original evidence and reservations. @{nl=\"Vervang toekomstige instellingen; bestaande rondes behouden hun bewijs en reserveringen.\"}\n  scenario configure(plan:Plan,ted_query:text,grants_query:text,criteria:text,period:duration,lookback_days:int,max_pages:int,max_documents:int,max_analysis:int,output_tokens:int) by=researcher\n   require can_work(actor,plan.location) and trim(ted_query)!=\"\" and trim(grants_query)!=\"\" and trim(criteria)!=\"\"\n   do\n    set plan {ted_query,grants_query,criteria,period,lookback_days,max_pages,max_documents,max_analysis,output_tokens,revision=plan.revision+1}\n    if plan.active\n     schedule plan.id at=now+plan.period event=PlanDue {plan,revision=plan.revision}\n  # Pause recurrence without pretending that an in-flight provider stopped or refunded work. @{nl=\"Pauzeer herhaling zonder te beweren dat lopend providerwerk is gestopt of terugbetaald.\"}\n  scenario pause(plan:Plan) by=researcher\n   require can_work(actor,plan.location)\n   do\n    set plan {active=false,revision=plan.revision+1}\n    cancel plan.id\n    if plan.current!=null and not plan.current.stopped\n     set plan.current {stopped=true}\n     for pass in plan.current.SourcePass limit=2\n      cancel pass.id\n      set pass {state=cancelled}\n  # Take responsibility for future recurring runs under your current work eligibility. @{nl=\"Neem verantwoordelijkheid voor toekomstige rondes binnen je actuele werkbevoegdheid.\"}\n  scenario take_over(plan:Plan) by=researcher\n   require can_work(actor,plan.location)\n   do\n    set plan {owner=actor,revision=plan.revision+1}\n    if plan.active\n     schedule plan.id at=now+plan.period event=PlanDue {plan,revision=plan.revision}\n  # Resume future runs after checking the current responsible researcher. @{nl=\"Hervat toekomstige rondes na controle van de verantwoordelijke onderzoeker.\"}\n  scenario resume(plan:Plan) by=researcher\n   require can_work(actor,plan.location) and researcher(plan.owner) and can_work(plan.owner,plan.location)\n   do\n    set plan {active=true,revision=plan.revision+1}\n    schedule plan.id at=now event=PlanDue {plan,revision=plan.revision}\n  scenario recurring on=PlanDue\n   do\n    let plan=event.plan\n    if plan.active and plan.revision==event.revision and researcher(plan.owner) and can_work(plan.owner,plan.location)\n     if plan.current==null or plan.current.stopped or settled(plan.current)\n      create Run {parent=plan,settings=settings(plan),initiator=plan.owner,plan_revision=plan.revision} as run\n      create SourcePass {parent=run,source=ted,query=run.settings.ted_query} as ted\n      create SourcePass {parent=run,source=grants_gov,query=run.settings.grants_query} as grants\n      set plan {current=run}\n      schedule ted.id at=now event=PageDue {pass=ted}\n      schedule grants.id at=now event=PageDue {pass=grants}\n     schedule plan.id at=now+plan.period event=PlanDue {plan,revision=plan.revision}\n  scenario fetch_page on=PageDue\n   do\n    let pass=event.pass\n    let run=pass.parent\n    if pass.state==ready and eligible(run)\n     if pass.requests<run.settings.max_pages and run.document_slots<run.settings.max_documents\n      let take=min([20,run.settings.max_documents-run.document_slots])\n      create PageAttempt {parent=pass,cursor=pass.cursor,take} as attempt\n      send Sources.page {source=pass.source,query=pass.query,from=run.settings.from,until=run.settings.until,cursor=pass.cursor,take} when=eligible(run) and pass.current==attempt as request\n      set attempt {request}\n      set pass {current=attempt,state=fetching,requests=pass.requests+1}\n      set run {document_slots=run.document_slots+take}\n     else\n      set pass {state=capped,detail=\"Page or document reservation cap reached; coverage is partial\"}\n  scenario page_result on=Sources.page.completed\n   do\n    let attempt=first(PageAttempt as row where row.request?.id==event.delivery_id)\n    if attempt!=null and not attempt.applied\n     let pass=attempt.parent\n     let run=pass.parent\n     if pass.current!=attempt or not eligible(run)\n      set attempt {late=true,detail=\"Retained request result is outside the current admitted continuation\"}\n     else\n      if event.status==succeeded and event.result!=null\n       let result=event.result\n       if count(result.documents)<=attempt.take and ((result.terminal and result.next_cursor==null) or (not result.terminal and result.next_cursor!=null and result.next_cursor!=attempt.cursor)) and count(group(result.documents as doc,doc.key))==count(result.documents)\n        for doc in result.documents limit=20\n         let old=first(run.parent.Opportunity as item where item.source==pass.source and item.key==doc.key)\n         if old==null\n          create Opportunity {parent=run.parent,source=pass.source,key=doc.key,canonical_url=doc.url,identity_conflict=any(run.parent.Opportunity as item,item.canonical_url==doc.url)} as found\n          create Evidence {parent=found,ordinal=1,document=doc,run,page=attempt} as evidence\n         else\n          let same_revision=first(old.Evidence as item where item.document.revision==doc.revision)\n          if same_revision==null\n           create Evidence {parent=old,ordinal=(old.latest?.ordinal??0)+1,document=doc,run,page=attempt} as evidence\n           set old {identity_conflict=old.identity_conflict or old.canonical_url!=doc.url}\n          else\n           if same_revision.document.key!=doc.key or same_revision.document.url!=doc.url or same_revision.document.title!=doc.title or same_revision.document.body!=doc.body or same_revision.document.deadline_original!=doc.deadline_original or same_revision.document.deadline_zone!=doc.deadline_zone\n            create Conflict {parent=old,document=doc,run,page=attempt} as conflict\n            set old {identity_conflict=true}\n        set attempt {applied=true,next_cursor=result.next_cursor,terminal=result.terminal,traversal=result.traversal,observed=now,source_as_of=result.source_as_of,detail=result.detail}\n        set pass {cursor=result.next_cursor,state=ready,detail=result.detail}\n        if result.terminal\n         set pass {state=exhausted}\n        else\n         schedule pass.id at=now event=PageDue {pass}\n       else\n        set pass {state=attention,detail=\"Invalid cursor, duplicate identity or oversized page\"}\n      else\n       set pass {state=attention,detail=\"Source request did not yield an accepted page; coverage remains partial\"}\n   ## These invoke the trusted completion with an isolated, consistently provisioned receipt; they are not live provider runs.\n   examples seed=[analyst_worker,page] event={delivery_id=page_receipt.id,status=succeeded,result={documents=[],next_cursor=\"next-1\",terminal=false,source_as_of=null,traversal=live,detail=null},error=null}\n    plan.current,page.request,pass.current,pass.state,run.stopped -> page.applied,page.late,pass.state,pass.cursor\n    run,page_receipt,page,fetching,false -> true,false,ready,\"next-1\"\n    run,page_receipt,page,fetching,true -> false,true,fetching,null\n    run,page_receipt,null,fetching,false -> false,true,fetching,null\n   examples seed=[analyst_worker,page] event={delivery_id=page_receipt.id,status=succeeded,result={documents=[],next_cursor=\"next-1\",terminal=false,source_as_of=null,traversal=live,detail=null},error=null}\n    plan.current,page.request,pass.current,pass.state,event.result,page_receipt.result -> page.applied,pass.state\n    run,page_receipt,page,fetching,{documents=[],next_cursor=null,terminal=false,source_as_of=null,traversal=uncertain,detail=null},{documents=[],next_cursor=null,terminal=false,source_as_of=null,traversal=uncertain,detail=null} -> false,attention\n   examples seed=[analyst_worker,page] event={delivery_id=page_receipt.id,status=unknown,result=null,error=null}\n    plan.current,page.request,pass.current,pass.state,page_receipt.status,page_receipt.result -> page.applied,pass.state\n    run,page_receipt,page,fetching,unknown,null -> false,attention\n   examples seed=[analyst_worker,page,evidence] event={delivery_id=page_receipt.id,status=succeeded,result={documents=[evidence.document],next_cursor=null,terminal=true,source_as_of=now,traversal=snapshot,detail=null},error=null}\n    plan.current,page.request,pass.current,pass.state,page_receipt.result -> count(opportunity.Evidence),count(opportunity.Conflict),page.applied,pass.state\n    run,page_receipt,page,fetching,{documents=[evidence.document],next_cursor=null,terminal=true,source_as_of=now,traversal=snapshot,detail=null} -> 1,0,true,exhausted\n   examples seed=[analyst_worker,page,evidence] event={delivery_id=page_receipt.id,status=succeeded,result={documents=[{key=\"notice-1\",revision=\"v1\",url=\"https://example.test/notice/1\",title=\"Environmental work\",body=\"Conflicting source bytes\",deadline_original=null,deadline_zone=null,retrieved=now}],next_cursor=null,terminal=true,source_as_of=now,traversal=snapshot,detail=null},error=null}\n    plan.current,page.request,pass.current,pass.state,page_receipt.result -> count(opportunity.Evidence),count(opportunity.Conflict),opportunity.identity_conflict\n    run,page_receipt,page,fetching,{documents=[{key=\"notice-1\",revision=\"v1\",url=\"https://example.test/notice/1\",title=\"Environmental work\",body=\"Conflicting source bytes\",deadline_original=null,deadline_zone=null,retrieved=now}],next_cursor=null,terminal=true,source_as_of=now,traversal=snapshot,detail=null} -> 1,1,true\n  # Explicitly reserve another read attempt; earlier unknown attempts retain their cost reservation. @{nl=\"Reserveer expliciet een nieuwe leespoging; eerdere onzekere pogingen behouden hun kostenreservering.\"}\n  scenario retry(pass:SourcePass) by=researcher\n   require can_work(actor,pass.parent.parent.location) and eligible(pass.parent) and pass.state==attention and pass.requests<pass.parent.settings.max_pages and pass.parent.document_slots<pass.parent.settings.max_documents\n   do\n    set pass {state=ready}\n    schedule pass.id at=now event=PageDue {pass}\n  # Stop additional work and quarantine later results without claiming provider cancellation. @{nl=\"Stop nieuw werk en sluit latere resultaten uit zonder providerannulering te claimen.\"}\n  scenario stop(run:Run) by=researcher\n   require can_work(actor,run.parent.location)\n   do\n    set run {stopped=true}\n    for pass in run.SourcePass limit=2\n     cancel pass.id\n     set pass {state=cancelled}\n   examples seed=[test_worker,pass] run=run\n    as -> run.stopped,pass.state\n    researcher -> true,cancelled\n    members -> error(forbidden)\n  # Extract only from retained evidence; a score is advice, never a review or promotion. @{nl=\"Extraheer alleen uit bewaard bewijs; een score is advies en nooit een beoordeling of promotie.\"}\n  scenario analyse(evidence:Evidence) by=researcher\n   require can_work(actor,evidence.parent.parent.location) and evidence.parent.latest==evidence and not evidence.parent.identity_conflict and eligible(evidence.run) and evidence.run.analysis_slots<evidence.run.settings.max_analysis\n   require evidence.analysis==null\n   do\n    send Analysis.extract {document=evidence.document,criteria=evidence.run.settings.criteria,output_tokens=evidence.run.settings.output_tokens} when=eligible(evidence.run) and evidence.parent.latest==evidence and not evidence.parent.identity_conflict as request\n    set evidence {analysis=request}\n    set evidence.run {analysis_slots=evidence.run.analysis_slots+1}\n  scenario analyse_new on=Evidence.create\n   do\n    let evidence=event.after\n    if eligible(evidence.run) and not evidence.parent.identity_conflict and evidence.run.analysis_slots<evidence.run.settings.max_analysis\n     send Analysis.extract {document=evidence.document,criteria=evidence.run.settings.criteria,output_tokens=evidence.run.settings.output_tokens} when=eligible(evidence.run) and evidence.parent.latest==evidence and not evidence.parent.identity_conflict as request\n     set evidence {analysis=request}\n     set evidence.run {analysis_slots=evidence.run.analysis_slots+1}\n  scenario analysis_result on=Analysis.extract.completed\n   do\n    let evidence=first(Evidence as row where row.analysis?.id==event.delivery_id)\n    if evidence!=null and evidence.claims==null\n     if event.status==succeeded and event.result!=null and eligible(evidence.run) and evidence.parent.latest==evidence\n      let claims=event.result\n      if count(claims.citations)>0 and all(claims.citations as citation,contains(evidence.document.body,citation.quote)) and (claims.deadline==null or (claims.deadline_zone!=null and not claims.deadline_uncertain and any(claims.citations as citation,citation.field==deadline)))\n       set evidence {claims}\n      else\n       set evidence {analysis_issue=\"Claims or deadline citations could not be validated; review the original manually\"}\n     else\n      set evidence {analysis_issue=\"No current accepted analysis; source evidence remains available for manual review\"}\n  # Freeze corrected claims and cited evidence before any business handoff. @{nl=\"Leg gecorrigeerde claims en geciteerd bewijs vast vóór een zakelijke overdracht.\"}\n  scenario review(evidence:Evidence,title:text,summary:text,deadline:datetime?,deadline_zone:timezone?,deadline_note:text,quotes:text[]) by=reviewer -> Review\n   require can_work(actor,evidence.parent.parent.location) and evidence.parent.latest==evidence and not evidence.parent.needs_identity_review and evidence.parent.duplicate_of==null\n   do\n    create Review {parent=evidence.parent,evidence,title,summary,deadline,deadline_zone,deadline_note,quotes} as review\n    return review\n   examples seed=[test_worker] evidence=evidence title=\"Environmental work\" summary=\"Reviewed original source\" deadline=null deadline_zone=null deadline_note=\"Deadline unknown; confirmed uncertainty\" quotes=[\"Environmental work.\"]\n    as,opportunity.identity_conflict,quotes -> result.evidence\n    reviewer,false,[\"Environmental work.\"] -> evidence\n    reviewer,false,[\"Invented quotation\"] -> error(rule_failed)\n    reviewer,true,[\"Environmental work.\"] -> error(rule_failed)\n   examples seed=[test_worker] evidence=evidence title=\"Environmental work\" summary=\"Reviewed original source\" deadline=null deadline_zone=null deadline_note=\"Unknown\" quotes=[\"Environmental work.\"]\n    as,test_worker.active,request.evidence.version -> result.evidence\n    reviewer,false,1 -> error(rule_failed)\n    reviewer,true,2 -> error(conflict)\n  # Keep both source identities when a reviewer resolves a duplicate conflict. @{nl=\"Bewaar beide bronidentiteiten wanneer een beoordelaar een dubbel conflict oplost.\"}\n  scenario duplicate(opportunity:Opportunity,canonical:Opportunity,reason:text) by=reviewer\n   require can_work(actor,opportunity.parent.location) and opportunity.parent==canonical.parent and opportunity!=canonical and opportunity.deal==null and canonical.duplicate_of==null and trim(reason)!=\"\"\n   do set opportunity {duplicate_of=canonical,identity_conflict=false,identity_note=reason}\n   examples seed=[analyst_worker,evidence,collision]\n    do\n     call review {evidence=evidence,title=\"Environmental work\",summary=\"Manual review\",deadline=null,deadline_zone=null,deadline_note=\"Deadline unknown; checked original\",quotes=[\"Environmental work.\"]} by=analyst -> error(rule_failed)\n     call duplicate {opportunity=collision,canonical=opportunity,reason=\"Both keys identify the same published opportunity\"} by=analyst\n     call review {evidence=evidence,title=\"Environmental work\",summary=\"Manual review\",deadline=null,deadline_zone=null,deadline_note=\"Deadline unknown; checked original\",quotes=[\"Environmental work.\"]} by=analyst as checked\n     opportunity.needs_identity_review,collision.duplicate_of==opportunity,checked.evidence==evidence -> false,true,true\n  # Keep the selected retained revision after a documented identity conflict review. @{nl=\"Behoud de gekozen bewaarde revisie na een gedocumenteerde identiteitscontrole.\"}\n  scenario accept_identity(opportunity:Opportunity,reason:text) by=reviewer\n   require can_work(actor,opportunity.parent.location) and opportunity.latest!=null and opportunity.deal==null and opportunity.duplicate_of==null and trim(reason)!=\"\"\n   require not any(opportunity.parent.Opportunity as other,other!=opportunity and other.canonical_url==opportunity.latest.document.url and other.duplicate_of!=opportunity)\n   do set opportunity {canonical_url=opportunity.latest.document.url,identity_conflict=false,identity_note=reason}\n  # Promote one reviewed revision through the canonical sales owner; research never overwrites a deal. @{nl=\"Promoveer één beoordeelde revisie via de canonieke verkoopeigenaar; onderzoek overschrijft nooit een verkoopkans.\"}\n  scenario promote(review:Review,customer:Customer,contact:Contact,value:money) by=reviewer -> Deal\n   require can_work(actor,review.parent.parent.location) and review.parent.latest==review.evidence and not review.parent.needs_identity_review and review.parent.duplicate_of==null and (review.deadline==null or now<review.deadline)\n   do\n    call promote_research {source=\"discover:\"+review.parent.id,input={customer,contact,location=review.parent.parent.location,title=review.title,value,notes=review.summary+\"\\nEvidence: \"+review.evidence.document.url+\"\\nRevision: \"+review.evidence.document.revision+\"\\nDeadline: \"+review.deadline_note}} as deal\n    set review.parent {deal}\n    return deal\n   examples seed=[analyst_worker] review=reviewed customer=test_company contact=test_contact value=money(100,\"EUR\")\n    as,opportunity.identity_conflict,review.deadline,review.deadline_zone -> result.source\n    analyst,false,null,null -> \"discover:\"+opportunity.id\n    analyst,true,null,null -> error(rule_failed)\n    analyst,false,now-1d,\"UTC\" -> error(rule_failed)\n   ## Source evidence is seeded; review and both CRM admissions below are genuine same-state calls.\n   examples seed=[analyst_worker,evidence,test_company,test_contact]\n    do\n     call review {evidence=evidence,title=\"Environmental work\",summary=\"Manual review\",deadline=null,deadline_zone=null,deadline_note=\"Deadline unknown; checked original\",quotes=[\"Environmental work.\"]} by=analyst as checked\n     call promote {review=checked,customer=test_company,contact=test_contact,value=money(100,\"EUR\")} by=analyst as first_deal\n     first_deal.source,opportunity.deal==first_deal -> \"discover:\"+opportunity.id,true\n     call promote {review=checked,customer=test_company,contact=test_contact,value=money(100,\"EUR\")} by=analyst as repeated\n     repeated==first_deal -> true\n     call promote {review=checked,customer=test_company,contact=test_contact,value=money(101,\"EUR\")} by=analyst -> error(rule_failed)\n     call promote {review=checked,customer=test_company,contact=test_contact,value=money(100,\"EUR\")} by=other -> error(forbidden)\n Then\n  # Research plans and source coverage with reviewable evidence. @{nl=\"Onderzoeksplannen en brondekking met beoordeelbaar bewijs.\"}\n  page /discover title=\"Opportunity research\"@{nl=\"Kansenonderzoek\"}\n   require researcher or reviewer\n   breadcrumbs\n   tabs\n    tab \"Plans\"@{nl=\"Plannen\"}\n     form Plan.create\n      input name\n      select location\n      textarea ted_query\n      textarea grants_query\n      textarea criteria\n     table Plan columns=name,location,active,revision empty=\"No research plans\"@{nl=\"Geen onderzoeksplannen\"}\n      pagination\n      actions start,pause,resume,take_over\n      form configure arguments={plan=row}\n       fieldset \"Sources\"@{nl=\"Bronnen\"}\n        textarea ted_query\n        textarea grants_query\n        textarea criteria\n       fieldset \"Limits\"@{nl=\"Limieten\"}\n        input period\n        input lookback_days\n        input max_pages\n        input max_documents\n        input max_analysis\n        input output_tokens\n      table row.Run columns=started,complete,stopped,document_slots,analysis_slots empty=\"No research runs\"@{nl=\"Geen onderzoeksrondes\"}\n       pagination\n       action stop\n       table row.SourcePass columns=source,state,requests,detail empty=\"No source passes\"@{nl=\"Geen bronrondes\"}\n        pagination\n        badge row.state\n        action retry\n        table row.PageAttempt columns=cursor,take,applied,late,traversal,detail,request empty=\"No page attempts\"@{nl=\"Geen paginapogingen\"}\n         pagination\n    tab \"Evidence and review\"@{nl=\"Bewijs en beoordeling\"}\n     ## Readable pipeline stages; gating stays in When guards.\n     steps\n      slot item\n       text \"Collect\"@{nl=\"Verzamelen\"}\n      slot item\n       text \"Analyse\"@{nl=\"Analyseren\"}\n      slot item\n       text \"Review\"@{nl=\"Beoordelen\"}\n      slot item\n       text \"Promote\"@{nl=\"Promoveren\"}\n     table Opportunity columns=source,key,canonical_url,needs_identity_review,expired,duplicate_of,deal empty=\"No opportunities\"@{nl=\"Geen kansen\"}\n      pagination\n      form duplicate arguments={opportunity=row}\n       select canonical\n       textarea reason\n      form accept_identity arguments={opportunity=row}\n       textarea reason\n      ## Ordinal evidence chain; newest admission invalidates older reviews.\n      timeline row.Evidence\n       slot item\n        text row.document,row.claims,row.analysis_issue\n        copy row.document.key\n        action analyse\n        form review arguments={evidence=row}\n         input title\n         textarea summary\n         input deadline\n         input deadline_zone\n         textarea deadline_note\n         ## quotes keeps its generated control: quote arrays have no catalog control.\n      table row.Conflict columns=document,observed empty=\"No conflicts\"@{nl=\"Geen conflicten\"}\n       pagination\n      table row.Review columns=title,deadline,deadline_note,reviewed_by,reviewed_at empty=\"No reviews\"@{nl=\"Geen beoordelingen\"}\n       pagination\n       form promote arguments={review=row}\n        select customer\n        select contact\n        input value\n      history\n"}}
