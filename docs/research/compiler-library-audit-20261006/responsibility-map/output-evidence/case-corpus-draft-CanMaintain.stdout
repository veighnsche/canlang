{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"619973f1dd4f29cc509566c0fd64ccc5371fce7545a3d00df2a9286b21c16286","before_projection_sha256":"619973f1dd4f29cc509566c0fd64ccc5371fce7545a3d00df2a9286b21c16286","changed":false,"idempotent":true,"structure_equal":true,"text":"# Help workspace managers move facility faults in offices, meeting rooms, common areas, and equipment through repair and return to service. @{nl=\"Help werkplekmanagers storingen in kantoren, vergaderruimten, gemeenschappelijke ruimten en apparatuur te herstellen en voorzieningen terug in gebruik te nemen.\"}\napp CanMaintain uses=[maintain]\n\n# Maintain equipment, verify repairs, dispatch technicians and track consumable stock. @{nl=\"Onderhoud apparatuur, verifieer reparaties, plan technici en volg de verbruiksvoorraad.\"}\napp Facilities uses=[CanMaintain,CanField,CanStock]\n\n# Own equipment, immutable inspection evidence and manager-verified repairs. @{nl=\"Beheer apparatuur, onveranderlijk inspectiebewijs en door managers geverifieerde reparaties.\"}\npackage maintain\n use rent_catalog {Location,test_site}\n use supplier {Supplier}\n use employee {Employee,can_work,test_worker}\n use field {dispatch as dispatch_visit,ReportSubmitted}\n use std {DeliveryResult}\n use std {EmailV1 as Mail} from=deployment.mail\n use rent_reservations {AffectedBookings,RoomsV1 as Rooms} from=deployment.rooms\n Given\n  export contract WorkItem { reference:text, revision:int, location:text?, title:text, detail:text?, due:datetime?, action:action(inspect) } label=\"Authorized inspection\"@{nl=\"Toegestane inspectie\"}\n  export contract WorkBatch { items:WorkItem[]! max=500 } label=\"Authorized inspections\"@{nl=\"Toegestane inspecties\"}\n  message label_Plan_checklist = \"Checklist\"@{nl=\"Checklist\"}\n  message label_Inspection_answers = \"Answers\"@{nl=\"Antwoorden\"}\n  message label_Inspection_result_pending = \"Pending\"@{nl=\"In afwachting\"}\n  message label_Inspection_result_failed = \"Failed\"@{nl=\"Mislukt\"}\n  message label_Repair_photo = \"Photo\"@{nl=\"Foto\"}\n  preferences { location:Location?, severity:Repair.severity? }\n  role maintenance_manager label=\"Maintenance manager\"@{nl=\"Onderhoudsbeheerder\"}\n  role technician label=\"Technician\"@{nl=\"Technicus\"}\n  export Asset { location:Location, identifier:text unique label=\"Identifier\"@{nl=\"Identificatie\"}, name:text, category:text label=\"Category\"@{nl=\"Categorie\"}, supplier:Supplier?, resource:text? label=\"Resource reference\"@{nl=\"Referentie voorziening\"}, serial:text? label=\"Serial number\"@{nl=\"Serienummer\"}, warranty:date? label=\"Warranty expiry\"@{nl=\"Garantie-einddatum\"}, manual:file? label=\"Manual\"@{nl=\"Handleiding\"}, inspection_epoch:int=0 min=0, retired:bool=false label=\"Retired\"@{nl=\"Buiten gebruik\"} } label=\"Asset\"@{nl=\"Bedrijfsmiddel\"}\n  Plan in Asset { name:text, assignee:user label=\"Assignee\"@{nl=\"Toegewezen persoon\"}, assignee_email:email label=\"Reminder destination\"@{nl=\"Bestemming herinnering\"}, cadence_days:int min=1 label=\"Interval in days\"@{nl=\"Interval in dagen\"}, next_due:date label=\"Next inspection date\"@{nl=\"Volgende inspectiedatum\"}, checklist:text[]! label=label_Plan_checklist, revision:int=1, asset_epoch:int=0 min=0, active:bool=true } label=\"Inspection plan\"@{nl=\"Inspectieplan\"}\n  export Inspection in Plan { cancelled:bool=false label=\"Cancelled\"@{nl=\"Geannuleerd\"}, cancellation:text? label=\"Cancellation reason\"@{nl=\"Reden annulering\"}, cancelled_by:user? label=\"Cancelled by\"@{nl=\"Geannuleerd door\"}, cancelled_at:datetime? label=\"Cancelled at\"@{nl=\"Geannuleerd op\"}, reminder_email:email label=\"Reminder destination\"@{nl=\"Bestemming herinnering\"}, reminded_at:datetime? label=\"Reminder queued at\"@{nl=\"Herinnering klaargezet op\"}, occurrence:text unique label=\"Occurrence reference\"@{nl=\"Referentie uitvoering\"}, due:date, checklist:text[]! label=label_Plan_checklist, asset_epoch:int=0 min=0, template_version:int label=\"Template version\"@{nl=\"Templateversie\"}, inspector:user label=\"Inspector\"@{nl=\"Inspecteur\"}, answers:text[] label=label_Inspection_answers, result:enum(pending,passed,failed,blocked)=pending label={text=\"Inspection result\"@{nl=\"Inspectieresultaat\"},values={pending=label_Inspection_result_pending,passed=\"Passed\"@{nl=\"Goedgekeurd\"},failed=label_Inspection_result_failed,blocked=\"Blocked\"@{nl=\"Geblokkeerd\"}}}, evidence:text?, inspected_at:datetime? label=\"Inspected at\"@{nl=\"Geïnspecteerd op\"}, repair:Repair? } label=\"Inspection\"@{nl=\"Inspectie\"}\n  export Repair in Asset { affected:AffectedBookings? label=\"Affected bookings\"@{nl=\"Getroffen boekingen\"}, affected_delivery:text? label=\"Affected-booking lookup delivery\"@{nl=\"Verzending opvraag getroffen boekingen\"}, affected_state:enum(none,pending,fresh,failed,unknown)=none label={text=\"Booking review read\"@{nl=\"Lezen boekingsbeoordeling\"},values={none=\"Not requested\"@{nl=\"Niet aangevraagd\"},pending=label_Inspection_result_pending,fresh=\"Fresh snapshot\"@{nl=\"Actuele momentopname\"},failed=label_Inspection_result_failed,unknown=\"Unknown\"@{nl=\"Onbekend\"}}}, assignment:Assignment? label=\"Current assignment\"@{nl=\"Huidige opdracht\"}, block_from:datetime? label=\"Downtime start\"@{nl=\"Begin uitval\"}, block_until:datetime? label=\"Downtime end\"@{nl=\"Einde uitval\"}, block_action:enum(downtime,restore)=downtime label={text=\"Availability action\"@{nl=\"Beschikbaarheidsactie\"},values={downtime=\"Downtime\"@{nl=\"Uitval\"},restore=\"Restore\"@{nl=\"Herstellen\"}}}, block_revision:int=0, restore_evidence:text? label=\"Release evidence\"@{nl=\"Vrijgavebewijs\"}, visit_review:bool=false label=\"Visit report needs review\"@{nl=\"Bezoekverslag vereist beoordeling\"}, title:text trim min=1, description:text, severity:enum(low,normal,urgent)=normal label={text=\"Severity\"@{nl=\"Ernst\"},values={low=\"Low\"@{nl=\"Laag\"},normal=\"Normal\"@{nl=\"Normaal\"},urgent=\"Urgent\"@{nl=\"Dringend\"}}}, reporter:user? label=\"Reporter\"@{nl=\"Melder\"}, reporter_email:email? label=\"Reporter email\"@{nl=\"E-mailadres melder\"}, photo:file? label=label_Repair_photo, contractor:Supplier? label=\"Contractor\"@{nl=\"Uitvoerder\"}, due:date?, cost:money? label=\"Cost\"@{nl=\"Kosten\"}, state:enum(open,assigned,in_progress,awaiting_verification,fixed)=open label={text=\"State\"@{nl=\"Status\"},values={open=\"Open\"@{nl=\"Open\"},assigned=\"Assigned\"@{nl=\"Toegewezen\"},in_progress=\"In progress\"@{nl=\"In uitvoering\"},awaiting_verification=\"Awaiting verification\"@{nl=\"Wacht op verificatie\"},fixed=\"Fixed\"@{nl=\"Hersteld\"}}}, completion:text? label=\"Completion evidence\"@{nl=\"Afrondingsbewijs\"}, verified_by:user? label=\"Verified by\"@{nl=\"Geverifieerd door\"}, block_resource:text? label=\"Blocked resource\"@{nl=\"Geblokkeerde voorziening\"}, block_source:text? label=\"Downtime reference\"@{nl=\"Uitvalreferentie\"}, block_state:enum(none,pending,confirmed,failed,unknown,released)=none label={text=\"Downtime outcome\"@{nl=\"Uitvalresultaat\"},values={pending=label_Inspection_result_pending,failed=label_Inspection_result_failed,none=\"None\"@{nl=\"Geen\"},confirmed=\"Confirmed\"@{nl=\"Bevestigd\"},unknown=\"Unknown\"@{nl=\"Onbekend\"},released=\"Released\"@{nl=\"Vrijgegeven\"}}}, delivery:text? label=\"Delivery reference\"@{nl=\"Verzendingsreferentie\"} } label=\"Repair\"@{nl=\"Reparatie\"}\n  Verification in Repair { completion:text, evidence:text, author:user server=actor, at:datetime server=now } label=\"Repair verification\"@{nl=\"Reparatieverificatie\"}\n  Assignment in Repair { body:text label=\"Frozen assignment details\"@{nl=\"Vastgelegde opdrachtdetails\"}, supplier:Supplier, contact:email label=\"Contact\"@{nl=\"Contact\"}, reason:text, author:user server=actor label=\"Author\"@{nl=\"Auteur\"} } label=\"Contractor assignment\"@{nl=\"Opdracht aan leverancier\"}\n  Notice in Assignment { delivery:delivery(Mail.send) } label=\"Assignment delivery\"@{nl=\"Opdrachtverzending\"}\n  ## Each notice keeps its Mail attempt; state observes the receipt status.\n  derive Notice.state:DeliveryResult.status = row.delivery.status label={text=\"Delivery outcome\"@{nl=\"Verzendingsresultaat\"},values={pending=label_Inspection_result_pending,succeeded=\"Delivered\"@{nl=\"Bezorgd\"},failed=label_Inspection_result_failed,unknown=\"Unknown\"@{nl=\"Onbekend\"},skipped=\"Superseded\"@{nl=\"Vervangen\"}}}\n  Cancellation in Asset { plan:Plan?, through:int min=0, cutoff:date, reason:enum(plan_revised,asset_retired), author:user server=actor, at:datetime server=now, after:text?, phase:enum(plans,inspections,complete)=inspections } label=\"Inspection cancellation\"@{nl=\"Inspectieannulering\"}\n  event CancellationStep { cancellation:Cancellation }\n  derive plan_eligible(plan:Plan):bool = plan.active and not plan.parent.retired and plan.asset_epoch==plan.parent.inspection_epoch and technician(plan.assignee) and can_work(plan.assignee,plan.parent.location)\n  derive matches_cancellation(change:Cancellation,inspection:Inspection):bool = change.parent==inspection.parent.parent and inspection.due>change.cutoff and ((change.reason==plan_revised and change.plan==inspection.parent and inspection.template_version<=change.through) or (change.reason==asset_retired and inspection.asset_epoch<=change.through))\n  derive inspection_superseded(inspection:Inspection):bool = any(inspection.parent.parent.Cancellation as change,matches_cancellation(change,inspection))\n  derive inspection_pending(inspection:Inspection):bool = inspection.result==pending and not inspection.cancelled and not inspection_superseded(inspection)\n  event Reminder { inspection:Inspection, revision:int }\n  event PlanDue { plan:Plan, revision:int, due:date }\n  policy Asset read=authenticated where=not row.retired fields=location,identifier,name\n  policy Asset read=maintenance_manager or technician where=can_work(actor,row.location)\n  policy Plan read=maintenance_manager where=can_work(actor,row.parent.location)\n  policy Plan read=technician where=can_work(actor,row.parent.location) fields=name\n  policy Inspection read=maintenance_manager where=can_work(actor,row.parent.parent.location)\n  policy Inspection read=technician where=row.inspector==actor and can_work(actor,row.parent.parent.location)\n  policy Repair read=maintenance_manager or technician where=can_work(actor,row.parent.location)\n  policy Repair read=authenticated where=row.reporter==actor fields=title,description,severity,state,due,completion,reporter\n  policy Verification read=maintenance_manager or technician where=can_work(actor,row.parent.parent.location)\n  policy Assignment read=maintenance_manager where=can_work(actor,row.parent.parent.location)\n  policy Notice read=maintenance_manager where=can_work(actor,row.parent.parent.parent.location)\n  policy Cancellation read=maintenance_manager where=can_work(actor,row.parent.location)\n  invariant Cancellation: (row.reason==plan_revised and row.plan!=null and row.plan.parent==row.parent) or (row.reason==asset_retired and row.plan==null)\n  invariant Plan: row.cadence_days>0 and count(row.checklist)>0\n  invariant Inspection: row.result==pending or (row.evidence!=null and row.inspected_at!=null and count(row.answers)==count(row.checklist))\n  invariant Repair: row.state!=fixed or (row.completion!=null and row.verified_by!=null)\n  lock Cancellation fields=plan,through,cutoff,reason,author,at\n  lock Inspection fields=occurrence,due,checklist,template_version,asset_epoch,inspector\n  lock Inspection fields=answers,result,evidence,inspected_at when=row.result!=pending\n  lock Inspection fields=cancelled,cancellation,cancelled_by,cancelled_at when=row.cancelled\n  lock Verification fields=completion,evidence,author,at\n  lock Assignment fields=supplier,contact,reason,author,body\n  fixture fault_reporter=user {}\n  fixture inspection_manager=user {roles=[maintenance_manager]}\n  fixture inspection_technician=user {roles=[technician]}\n  fixture manager_employee=Employee {user=inspection_manager,home=test_site,locations=[test_site],start=date(\"2020-01-01\"),role=\"maintenance manager\"}\n  fixture technician_employee=Employee {user=inspection_technician,home=test_site,locations=[test_site],start=date(\"2020-01-01\"),role=\"inspection technician\"}\n  fixture equipment=Asset {location=test_site,identifier=\"HVAC-1\",name=\"Air conditioner\",category=\"HVAC\"}\n  fixture recurring=Plan {parent=equipment,name=\"Cooling inspection\",assignee=inspection_technician,assignee_email=\"technician@example.test\",cadence_days=30,next_due=date(\"2099-12-01\"),checklist=[\"Cooling works\"],active=false}\n  fixture check=Inspection {parent=recurring,occurrence=\"check\",due=date(\"2099-12-01\"),checklist=[\"Cooling works\"],template_version=1,inspector=inspection_technician,reminder_email=\"technician@example.test\"}\n  fixture service_supplier=Supplier {name=\"Cooling service\",contact=\"service@example.test\",locations=[test_site]}\n  fixture awaiting=Repair {parent=equipment,title=\"Fault\",description=\"No cooling\",state=awaiting_verification,completion=\"Repaired\"}\n  fixture superseded=Cancellation {parent=equipment,plan=recurring,through=1,cutoff=date(\"2020-01-01\"),reason=plan_revised,author=inspection_manager,at=datetime(\"2020-01-01T12:00:00Z\")}\n  fixture retired_work=Cancellation {parent=equipment,plan=null,through=0,cutoff=date(\"2020-01-01\"),reason=asset_retired,phase=plans,author=inspection_manager,at=datetime(\"2020-01-01T12:00:00Z\")}\n When\n  crud Asset by=maintenance_manager fields=name,category,supplier,resource,serial,warranty,manual,retired create_fields=location,identifier,name,category,supplier,resource,serial,warranty,manual when=can_work(actor,row.location) delete=none\n  crud Plan by=maintenance_manager fields=name,assignee,assignee_email,cadence_days,next_due,checklist,active when=can_work(actor,row.parent.location) and (not row.active or (not row.parent.retired and technician(row.assignee) and can_work(row.assignee,row.parent.location))) delete=none\n   examples update seed=[test_worker,check] record=recurring\n    as,changes.name -> recurring.revision,check.cancelled,check.result,inspection_pending(check),count(equipment.Cancellation)\n    maintenance_manager,\"Revised cooling check\" -> 2,false,pending,false,1\n    technician,\"Revised cooling check\" -> error(forbidden)\n   examples update seed=[test_worker,technician_employee] record=recurring\n    as,changes.active,changes.assignee,equipment.retired -> recurring.revision,count(equipment.Cancellation)\n    maintenance_manager,true,inspection_technician,false -> 2,1\n    maintenance_manager,true,other,false -> error(rule_failed)\n    maintenance_manager,true,inspection_technician,true -> error(rule_failed)\n    maintenance_manager,false,other,true -> 2,1\n  crud Repair by=maintenance_manager fields=title,description,severity,due,photo,cost when=can_work(actor,row.parent.location) and row.state==open delete=none\n  scenario activate_plan on=Plan.create\n   do\n    set event.after {asset_epoch=event.after.parent.inspection_epoch}\n    if plan_eligible(event.after)\n     schedule event.after.id at=max([now,local_instant(event.after.next_due,\"00:00\",event.after.parent.location.timezone,fold=earlier)]) event=PlanDue {plan=event.after,revision=event.after.revision,due=event.after.next_due}\n  ## Retain the exact supersession boundary before later edits or cleanup can obscure it.\n  scenario revise_plan on=Plan.update\n   do\n    set event.after {revision=event.before.revision+1,asset_epoch=event.after.parent.inspection_epoch}\n    create Cancellation {parent=event.after.parent,plan=event.after,through=event.before.revision,cutoff=local_date(now,event.after.parent.location.timezone),reason=plan_revised} as change\n    emit CancellationStep {cancellation=change}\n    cancel event.after.id\n    if plan_eligible(event.after)\n     schedule event.after.id at=max([now,local_instant(event.after.next_due,\"00:00\",event.after.parent.location.timezone,fold=earlier)]) event=PlanDue {plan=event.after,revision=event.after.revision,due=event.after.next_due}\n  scenario retire_asset on=Asset.update\n   do\n    if event.after.retired and not event.before.retired\n     set event.after {inspection_epoch=event.before.inspection_epoch+1}\n     create Cancellation {parent=event.after,plan=null,through=event.before.inspection_epoch,cutoff=local_date(now,event.after.location.timezone),reason=asset_retired,phase=plans} as change\n     emit CancellationStep {cancellation=change}\n  ## Each committed continuation reads current state and advances at most one owner record.\n  scenario cancel_inspection_step on=CancellationStep\n   do\n    let change=event.cancellation\n    if change.phase==plans\n     let plan=first(change.parent.Plan as row where row.asset_epoch<=change.through and (change.after==null or row.id>change.after) order=row.id)\n     if plan!=null\n      set plan {active=false,revision=plan.revision+1}\n      cancel plan.id\n      set change {after=plan.id}\n      emit CancellationStep {cancellation=change}\n     else\n      set change {phase=inspections,after=null}\n      emit CancellationStep {cancellation=change}\n    else\n     if change.phase==inspections\n      let inspection=first(Inspection as row where row.result==pending and not row.cancelled and matches_cancellation(change,row) and (change.after==null or row.id>change.after) order=row.id)\n      if inspection!=null\n       set inspection {cancelled=true,cancellation=\"Plan revised\",cancelled_by=change.author,cancelled_at=change.at}\n       if change.reason==asset_retired\n        set inspection {cancellation=\"Asset retired\"}\n       cancel inspection.id\n       set change {after=inspection.id}\n       emit CancellationStep {cancellation=change}\n      else\n       set change {phase=complete}\n   examples seed=[check] event={cancellation=superseded}\n    check.due,check.result,check.answers,check.evidence,check.inspected_at,superseded.phase -> check.cancelled,check.result,superseded.phase,check.cancelled_by,check.cancelled_at\n    date(\"2099-12-01\"),pending,[],null,null,inspections -> true,pending,inspections,inspection_manager,superseded.at\n    date(\"2020-01-01\"),pending,[],null,null,inspections -> false,pending,complete,null,null\n    date(\"2019-12-31\"),pending,[],null,null,inspections -> false,pending,complete,null,null\n    date(\"2099-12-01\"),passed,[\"Cooling works\"],\"Measured cooling\",datetime(\"2019-12-31T12:00:00Z\"),inspections -> false,passed,complete,null,null\n    date(\"2099-12-01\"),pending,[],null,null,complete -> false,pending,complete,null,null\n   examples seed=[check] event={cancellation=retired_work}\n    equipment.inspection_epoch,recurring.asset_epoch,check.asset_epoch,recurring.active -> recurring.active,recurring.revision,retired_work.phase,check.cancelled\n    1,0,0,true -> false,2,plans,false\n    1,1,1,true -> true,1,inspections,false\n   examples seed=[check] event={cancellation=retired_work}\n    retired_work.phase,equipment.inspection_epoch,check.asset_epoch -> check.cancelled,retired_work.phase\n    inspections,1,0 -> true,inspections\n    inspections,1,1 -> false,complete\n  # Resume the retained cancellation without changing its original scope or attribution. @{nl=\"Hervat de vastgelegde annulering zonder haar oorspronkelijke bereik of toeschrijving te wijzigen.\"}\n  scenario resume_cancellation(cancellation:Cancellation) by=maintenance_manager label=\"Resume inspection cancellation\"@{nl=\"Inspectieannulering hervatten\"}\n   require can_work(actor,cancellation.parent.location) and cancellation.phase!=complete\n   do emit CancellationStep {cancellation}\n   examples seed=[manager_employee] cancellation=superseded\n    as,cancellation.phase,manager_employee.active -> cancellation.phase\n    inspection_manager,inspections,true -> inspections\n    inspection_manager,complete,true -> error(rule_failed)\n    inspection_manager,inspections,false -> error(rule_failed)\n    inspection_technician,inspections,true -> error(forbidden)\n    public,inspections,true -> error(forbidden)\n  # Report your own facility fault without browsing unrelated repairs. @{nl=\"Meld je eigen facilitaire storing zonder niet-gerelateerde reparaties te bekijken.\"}\n  export scenario report(asset:Asset,title:text,description:text,photo:file? label=label_Repair_photo) -> Repair by=authenticated label=\"Report fault\"@{nl=\"Storing melden\"}\n   require actor.email_verified and not asset.retired and trim(title)!=\"\" and trim(description)!=\"\"\n   do\n    create Repair {parent=asset,title,description,photo,reporter=actor,reporter_email=actor.email} as repair\n    return repair\n   examples asset=equipment photo=null\n    as,title,description -> result.title,result.reporter,result.state\n    members,\"Wi-Fi fault\",\"Router is not responding\" -> \"Wi-Fi fault\",self,open\n    members,\"Wi-Fi fault\",\"\" -> error(rule_failed)\n    public,\"Wi-Fi fault\",\"Router is not responding\" -> error(forbidden)\n  # Assign an active supplier and freeze the notification destination. @{nl=\"Wijs een actieve leverancier toe en leg de meldingsbestemming vast.\"}\n  scenario assign(repair:Repair,supplier:Supplier,reason:text) by=maintenance_manager\n   require can_work(actor,repair.parent.location) and supplier.active and repair.parent.location in supplier.locations and repair.state!=fixed and trim(reason)!=\"\"\n   do\n    create Assignment {parent=repair,supplier,contact=supplier.contact,reason,body=repair.description} as assignment\n    set repair {contractor=supplier,assignment,state=assigned}\n    send Mail.send {to=assignment.contact,subject=format(\"Repair assignment\"@{nl=\"Reparatieopdracht\"},locale=null),body=assignment.body} when=repair.assignment==assignment and supplier.active and repair.state in [assigned,in_progress] as notice\n    create Notice {parent=assignment,delivery=notice} as receipt\n  # Retry a definitely failed assignment notice only for its current active destination. @{nl=\"Probeer een definitief mislukte opdrachtmelding opnieuw voor de huidige actieve bestemming.\"}\n  scenario retry_notice(notice:Notice) by=maintenance_manager label=\"Retry assignment notice\"@{nl=\"Opdrachtmelding opnieuw sturen\"}\n   require can_work(actor,notice.parent.parent.parent.location) and notice.state==failed and not any(notice.parent.Notice as item,item.state in [pending,unknown,succeeded]) and notice.parent.parent.assignment==notice.parent and notice.parent.supplier.active and notice.parent.parent.state in [assigned,in_progress]\n   do\n    send Mail.send {to=notice.parent.contact,subject=format(\"Repair assignment\"@{nl=\"Reparatieopdracht\"},locale=null),body=notice.parent.body} when=notice.parent.parent.assignment==notice.parent and notice.parent.supplier.active and notice.parent.parent.state in [assigned,in_progress] as attempt\n    create Notice {parent=notice.parent,delivery=attempt} as receipt\n  # Start an assigned repair without claiming acceptance from assignment delivery. @{nl=\"Start een toegewezen reparatie zonder aanvaarding af te leiden uit de opdrachtverzending.\"}\n  scenario start(repair:Repair) by=technician label=\"Start repair\"@{nl=\"Reparatie starten\"}\n   require can_work(actor,repair.parent.location) and repair.state==assigned\n   do set repair {state=in_progress}\n   examples seed=[test_worker] repair=awaiting\n    as,repair.state -> repair.state\n    technician,assigned -> in_progress\n    technician,open -> error(rule_failed)\n    maintenance_manager,assigned -> error(forbidden)\n  # Request canonical room downtime while preserving affected customer bookings. @{nl=\"Vraag canonieke ruimte-uitval aan en behoud de getroffen klantboekingen.\"}\n  scenario block(repair:Repair,from:datetime label=\"Start\"@{nl=\"Begin\"},until:datetime? label=\"End\"@{nl=\"Einde\"}) by=maintenance_manager label=\"Record blocker\"@{nl=\"Blokkade registreren\"}\n   require can_work(actor,repair.parent.location) and repair.parent.resource!=null and repair.state!=fixed and repair.block_state in [none,released] and (until==null or from<until)\n   do\n    send Rooms.downtime {source=operation.id,resource=repair.parent.resource,from,until} as delivery\n    set repair {block_resource=repair.parent.resource,block_source=operation.id,block_from=from,block_until=until,block_action=downtime,block_revision=0,block_state=pending,delivery=delivery.id,affected=null,affected_state=none,affected_delivery=null}\n  # Capture technician evidence for manager verification rather than automatic resale. @{nl=\"Leg technicusbewijs vast voor managerverificatie in plaats van automatische herverkoop.\"}\n  scenario finish(repair:Repair,evidence:text) by=technician label=\"Submit repair evidence\"@{nl=\"Reparatiebewijs indienen\"}\n   require can_work(actor,repair.parent.location) and repair.state in [assigned,in_progress] and trim(evidence)!=\"\"\n   do set repair {state=awaiting_verification,completion=evidence}\n  # Verify a repair and request release of only its own downtime block. @{nl=\"Verifieer een reparatie en vraag vrijgave van uitsluitend haar eigen uitvalblokkade aan.\"}\n  scenario verify(repair:Repair,evidence:text) by=maintenance_manager label=\"Verify repair\"@{nl=\"Reparatie verifiëren\"}\n   require can_work(actor,repair.parent.location) and repair.state==awaiting_verification and repair.completion!=null and trim(evidence)!=\"\"\n   do\n    create Verification {parent=repair,completion=repair.completion,evidence} as verification\n    set repair {state=fixed,verified_by=actor,visit_review=false}\n    if repair.block_source!=null and repair.block_state!=released\n     require repair.block_resource!=null\n     send Rooms.restore {source=repair.block_source,resource=repair.block_resource,evidence} as delivery\n     set repair {block_action=restore,restore_evidence=evidence,block_state=pending,delivery=delivery.id}\n   examples seed=[test_worker] repair=awaiting\n    as,evidence -> repair.state,repair.verified_by,first(repair.Verification as row order=row.id)?.evidence\n    maintenance_manager,\"Checked cooling\" -> fixed,self,\"Checked cooling\"\n    maintenance_manager,\"\" -> error(rule_failed)\n    technician,\"Checked cooling\" -> error(forbidden)\n   examples seed=[manager_employee,technician_employee,service_supplier,fault_reporter]\n    do\n     call report {asset=equipment,title=\"Cooling fault\",description=\"No cooling\",photo=null} by=fault_reporter as initial_fault\n     call assign {repair=initial_fault,supplier=service_supplier,reason=\"Repair cooling\"} by=inspection_manager\n     let first_assignment=first(Repair as row where row.id==initial_fault.id order=row.id)\n     first_assignment!=null -> true\n     call start {repair=first_assignment} by=inspection_technician\n     let first_started=first(Repair as row where row.id==initial_fault.id order=row.id)\n     first_started!=null -> true\n     call finish {repair=first_started,evidence=\"Repaired\"} by=inspection_technician\n     let first_submitted=first(Repair as row where row.id==initial_fault.id order=row.id)\n     first_submitted!=null -> true\n     call verify {repair=first_submitted,evidence=\"Manager checked cooling\"} by=inspection_manager\n     let verified_repair=first(Repair as row where row.id==initial_fault.id order=row.id)\n     verified_repair!=null -> true\n     let initial=first(verified_repair.Verification as row order=row.id)\n     initial!=null -> true\n     verified_repair.state,verified_repair.block_state,initial.completion,initial.evidence,initial.author,initial.at -> fixed,none,\"Repaired\",\"Manager checked cooling\",inspection_manager,now\n     call reopen {repair=verified_repair,reason=\"Cooling failed again\"} by=inspection_manager\n     let reopened=first(Repair as row where row.id==initial_fault.id order=row.id)\n     reopened!=null -> true\n     call assign {repair=reopened,supplier=service_supplier,reason=\"Investigate recurrence\"} by=inspection_manager\n     let assigned=first(Repair as row where row.id==initial_fault.id order=row.id)\n     assigned!=null -> true\n     call start {repair=assigned} by=inspection_technician\n     let started=first(Repair as row where row.id==initial_fault.id order=row.id)\n     started!=null -> true\n     call finish {repair=started,evidence=\"Replaced compressor\"} by=inspection_technician\n     let submitted=first(Repair as row where row.id==initial_fault.id order=row.id)\n     submitted!=null -> true\n     call verify {repair=submitted,evidence=\"Load test passed\"} by=inspection_manager\n     let final=first(Repair as row where row.id==initial_fault.id order=row.id)\n     final!=null -> true\n     let latest=first(final.Verification as row where row.evidence==\"Load test passed\" order=row.id)\n     latest!=null -> true\n     let previous=first(final.Verification as row where row.id==initial.id order=row.id)\n     previous!=null -> true\n     final.state,final.completion,final.block_state,final.block_source,count(final.Verification),previous.completion,previous.evidence,latest.completion,latest.evidence,latest.author,latest.at -> fixed,\"Replaced compressor\",none,null,2,\"Repaired\",\"Manager checked cooling\",\"Replaced compressor\",\"Load test passed\",inspection_manager,now\n  # Reopen a recurrence without erasing previous inspection or completion evidence. @{nl=\"Heropen een terugkerende storing zonder eerder inspectie- of afrondingsbewijs te wissen.\"}\n  scenario reopen(repair:Repair,reason:text) by=maintenance_manager\n   require can_work(actor,repair.parent.location) and repair.state==fixed and repair.block_state in [none,released,confirmed] and (repair.block_action==downtime or repair.block_state in [none,released]) and trim(reason)!=\"\"\n   do set repair {state=open,description=reason,verified_by=null}\n   examples seed=[test_worker] repair=awaiting reason=\"Cooling failed again\"\n    as,repair.state,repair.verified_by,repair.block_state,repair.block_action -> repair.state,repair.completion\n    maintenance_manager,fixed,self,released,restore -> open,\"Repaired\"\n    maintenance_manager,fixed,self,unknown,restore -> error(rule_failed)\n  # Record one attributable checklist result; a failed or blocked result opens a corrective repair. @{nl=\"Registreer één herleidbaar checklistresultaat; een mislukt of geblokkeerd resultaat opent een corrigerende reparatie.\"}\n  export scenario inspect(inspection:Inspection,answers:text[] label=label_Inspection_answers,result:Inspection.result,evidence:text) by=technician label=\"Record inspection\"@{nl=\"Inspectie registreren\"}\n   require can_work(actor,inspection.parent.parent.location) and inspection.inspector==actor and inspection_pending(inspection) and result in [passed,failed,blocked] and count(answers)==count(inspection.checklist) and trim(evidence)!=\"\"\n   do\n    set inspection {answers,result,evidence,inspected_at=now}\n    cancel inspection.id\n    if result in [failed,blocked]\n     create Repair {parent=inspection.parent.parent,title=inspection.parent.name,description=evidence,reporter=actor} as repair\n     set inspection {repair}\n   examples seed=[technician_employee] inspection=check answers=[\"No cooling\"] evidence=\"Measured warm air\"\n    as,result,inspection.cancelled -> inspection.result,count(inspection.parent.parent.Repair)\n    inspection_technician,failed,false -> failed,1\n    inspection_technician,passed,false -> passed,0\n    inspection_technician,failed,true -> error(rule_failed)\n   examples seed=[manager_employee,technician_employee,check]\n    do\n     call Plan.update {record=recurring,changes={name=\"Revised cooling check\"}} by=inspection_manager\n     let future=first(Inspection as row where row.occurrence==\"check\" order=row.id)\n     future!=null -> true\n     future.result,future.cancelled,inspection_pending(future),count(equipment.Cancellation) -> pending,false,false,1\n     call inspect {inspection=future,answers=[\"Cooling works\"],result=passed,evidence=\"Superseded checklist\"} by=inspection_technician -> error(rule_failed)\n     let revised=first(Plan as row where row.id==recurring.id order=row.id)\n     revised!=null -> true\n     call Plan.update {record=revised,changes={checklist=[\"Replacement checklist\"]}} by=inspection_manager\n     call Asset.update {record=equipment,changes={retired=true}} by=inspection_manager\n     let retired=first(Asset as row where row.id==equipment.id order=row.id)\n     retired!=null -> true\n     retired.retired,retired.inspection_epoch -> true,1\n     call Asset.update {record=retired,changes={retired=false}} by=inspection_manager\n     let configured=first(Plan as row where row.id==recurring.id order=row.id)\n     configured!=null -> true\n     call Plan.update {record=configured,changes={active=true}} by=inspection_manager\n     let renewed=first(Plan as row where row.id==recurring.id order=row.id)\n     renewed!=null -> true\n     renewed.asset_epoch,plan_eligible(renewed),future.checklist,inspection_pending(future) -> 1,true,[\"Cooling works\"],false\n     call inspect {inspection=future,answers=[\"Cooling works\"],result=passed,evidence=\"Old work after reinstatement\"} by=inspection_technician -> error(rule_failed)\n     call Plan.update {record=renewed,changes={name=\"Stale change\"}} by=inspection_manager request={record={version=1}} -> error(conflict)\n     let cancellation=first(equipment.Cancellation as row where row.reason==asset_retired order=row.id)\n     cancellation!=null -> true\n     call resume_cancellation {cancellation} by=inspection_manager\n     let history=first(equipment.Cancellation as row where row.id==cancellation.id order=row.id)\n     history!=null -> true\n     history.phase,history.author,history.at,history.through,future.result,future.cancelled -> plans,inspection_manager,now,0,pending,false\n   examples seed=[manager_employee,technician_employee,check]\n    do\n     call inspect {inspection=check,answers=[\"Cooling works\"],result=passed,evidence=\"Measured cooling\"} by=inspection_technician\n     call Asset.update {record=equipment,changes={retired=true}} by=inspection_manager\n     let completed_check=first(Inspection as row where row.occurrence==\"check\" order=row.id)\n     completed_check!=null -> true\n     completed_check.result,completed_check.answers,completed_check.evidence,completed_check.inspector,completed_check.inspected_at,completed_check.cancelled -> passed,[\"Cooling works\"],\"Measured cooling\",inspection_technician,now,false\n     call inspect {inspection=completed_check,answers=[\"Replacement\"],result=failed,evidence=\"Overwrite result\"} by=inspection_technician -> error(rule_failed)\n   examples seed=[technician_employee] inspection=check answers=[\"Cooling works\"] result=passed evidence=\"Measured cooling\"\n    as,technician_employee.active -> inspection.result\n    inspection_technician,false -> error(rule_failed)\n  ## A visit report is evidence for the owning repair, never permission to restore room availability.\n  scenario visit_report on=ReportSubmitted\n   do\n    let job=event.report.parent\n    if job.repair!=null\n     require job.location==job.repair.parent.location and job.state==done\n     if job.repair.state in [assigned,in_progress,awaiting_verification]\n      set job.repair {state=awaiting_verification,completion=event.report.notes,visit_review=true}\n     else\n      set job.repair {visit_review=true}\n  scenario generate on=PlanDue\n   do\n    let plan=event.plan\n    if plan_eligible(plan) and plan.revision==event.revision and plan.next_due==event.due and plan.next_due<=local_date(now,plan.parent.location.timezone)\n     let occurrence=format(\"{plan}:{due}:{revision}\",{plan=plan.id,due=plan.next_due,revision=plan.revision})\n     if not any(plan.Inspection as inspection,not inspection.cancelled and not (inspection.result==pending and inspection_superseded(inspection)) and inspection.due==plan.next_due)\n      create Inspection {parent=plan,occurrence,due=plan.next_due,checklist=plan.checklist,template_version=plan.revision,asset_epoch=plan.asset_epoch,inspector=plan.assignee,reminder_email=plan.assignee_email} as inspection\n      schedule inspection.id at=max([now,local_instant(inspection.due,\"09:00\",plan.parent.location.timezone,fold=earlier)]) event=Reminder {inspection,revision=inspection.template_version}\n     set plan {next_due=add_days(plan.next_due,plan.cadence_days)}\n     schedule plan.id at=max([now,local_instant(plan.next_due,\"00:00\",plan.parent.location.timezone,fold=earlier)]) event=PlanDue {plan,revision=plan.revision,due=plan.next_due}\n   examples seed=[technician_employee,check,superseded] event={plan=recurring,revision=2,due=local_date(now,test_site.timezone)}\n    superseded.cutoff,recurring.revision,recurring.active,recurring.next_due,check.due,check.result,check.answers,check.evidence,check.inspected_at -> count(recurring.Inspection)\n    add_days(local_date(now,test_site.timezone),-1),2,true,local_date(now,test_site.timezone),local_date(now,test_site.timezone),pending,[],null,null -> 2\n    add_days(local_date(now,test_site.timezone),-1),2,true,local_date(now,test_site.timezone),local_date(now,test_site.timezone),passed,[\"Cooling works\"],\"Already checked\",now -> 1\n   examples seed=[technician_employee] event={plan=recurring,revision=1,due=local_date(now,test_site.timezone)}\n    recurring.active,recurring.next_due,technician_employee.active,equipment.inspection_epoch -> count(recurring.Inspection)\n    true,local_date(now,test_site.timezone),false,0 -> 0\n    true,local_date(now,test_site.timezone),true,1 -> 0\n  scenario remind on=Reminder\n   do\n    let inspection=event.inspection\n    if inspection_pending(inspection) and inspection.template_version==event.revision and inspection.parent.revision==event.revision and inspection.inspector==inspection.parent.assignee and local_instant(inspection.due,\"09:00\",inspection.parent.parent.location.timezone,fold=earlier)<=now and plan_eligible(inspection.parent) and inspection.asset_epoch==inspection.parent.asset_epoch\n     send Mail.send {to=inspection.reminder_email,subject=format(\"Inspection due\"@{nl=\"Inspectie gepland\"},locale=null),body=inspection.parent.name} when=inspection_pending(inspection) and inspection.template_version==event.revision and inspection.parent.revision==event.revision and inspection.inspector==inspection.parent.assignee and local_instant(inspection.due,\"09:00\",inspection.parent.parent.location.timezone,fold=earlier)<=now and plan_eligible(inspection.parent) and inspection.asset_epoch==inspection.parent.asset_epoch as notice\n     set inspection {reminded_at=now}\n  # Recover an uncertain availability request using its original frozen business identity. @{nl=\"Herstel een onzekere beschikbaarheidsaanvraag met haar oorspronkelijke vastgelegde bedrijfsidentiteit.\"}\n  scenario retry_availability(repair:Repair) by=maintenance_manager label=\"Retry availability request\"@{nl=\"Beschikbaarheidsaanvraag opnieuw proberen\"}\n   require can_work(actor,repair.parent.location) and repair.block_state in [failed,unknown] and repair.block_source!=null and repair.block_resource!=null\n   do\n    if repair.block_action==downtime\n     require repair.block_from!=null and repair.state!=fixed\n     send Rooms.downtime {source=repair.block_source,resource=repair.block_resource,from=repair.block_from,until=repair.block_until} as delivery\n     set repair {delivery=delivery.id,block_state=pending}\n    else\n     require repair.state==fixed and repair.restore_evidence!=null\n     send Rooms.restore {source=repair.block_source,resource=repair.block_resource,evidence=repair.restore_evidence} as delivery\n     set repair {delivery=delivery.id,block_state=pending}\n  scenario downtime_result on=Rooms.downtime.completed\n   do\n    for repair in Repair as r where r.delivery==event.delivery_id and r.block_action==downtime and r.block_state in [pending,unknown] limit=1\n     if event.status==succeeded and event.result!=null and event.result.source==repair.block_source and event.result.revision>=repair.block_revision\n      if event.result.state==confirmed\n       set repair {block_state=confirmed,block_revision=event.result.revision}\n      else\n       if event.result.state in [failed,unavailable]\n        set repair {block_state=failed,block_revision=event.result.revision}\n       else\n        set repair {block_state=unknown}\n     else\n      if event.status==failed\n       set repair {block_state=failed}\n      else\n       set repair {block_state=unknown}\n   examples seed=[awaiting] event={delivery_id=\"block-delivery\",status=succeeded,result={source=\"block-source\",revision=1,state=confirmed,reference=\"block\",detail=null},error=null}\n    awaiting.delivery,awaiting.block_source,awaiting.block_state,event.result.source -> awaiting.block_state\n    \"block-delivery\",\"block-source\",pending,\"block-source\" -> confirmed\n    \"old-delivery\",\"block-source\",pending,\"block-source\" -> pending\n    \"block-delivery\",\"block-source\",pending,\"other-source\" -> unknown\n  scenario restore_result on=Rooms.restore.completed\n   do\n    for repair in Repair as r where r.delivery==event.delivery_id and r.block_action==restore and r.block_state in [pending,unknown] limit=1\n     if event.status==succeeded and event.result!=null and event.result.source==repair.block_source and event.result.revision>=repair.block_revision and event.result.state==released\n      set repair {block_state=released,block_revision=event.result.revision}\n     else\n      if event.status==failed\n       set repair {block_state=failed}\n      else\n       set repair {block_state=unknown}\n  # Read the owning booking review references without copying customer contacts. @{nl=\"Lees de boekingsbeoordelingsreferenties van de eigenaar zonder klantcontacten te kopiëren.\"}\n  scenario affected_bookings(repair:Repair) by=maintenance_manager label=\"Refresh affected bookings\"@{nl=\"Getroffen boekingen vernieuwen\"}\n   require can_work(actor,repair.parent.location) and repair.block_source!=null and repair.block_resource!=null and repair.affected_state!=pending\n   do\n    send Rooms.affected {source=repair.block_source,resource=repair.block_resource} as delivery\n    set repair {affected_delivery=delivery.id,affected_state=pending}\n  scenario affected_result on=Rooms.affected.completed\n   do\n    for repair in Repair as r where r.affected_delivery==event.delivery_id limit=1\n     if event.status==succeeded and event.result!=null and event.result.source==repair.block_source and event.result.resource==repair.block_resource\n      set repair {affected=event.result,affected_state=fresh}\n     else\n      if event.status==failed\n       set repair {affected_state=failed}\n      else\n       set repair {affected_state=unknown}\n  ## Verified owning outcomes may reconcile lost transport responses; old block confirmation cannot undo a release request.\n  scenario availability_changed on=Rooms.changed\n   do\n    for repair in Repair as r where r.block_source==event.value.source and event.value.revision>r.block_revision limit=1\n     if repair.block_action==downtime and event.value.state==confirmed\n      set repair {block_state=confirmed,block_revision=event.value.revision}\n     if repair.block_action==restore and event.value.state==released\n      set repair {block_state=released,block_revision=event.value.revision}\n  # Expose only your pending inspection titles and authorized completion actions. @{nl=\"Toon alleen je openstaande inspectietitels en toegestane afrondingsacties.\"}\n  export scenario work(locations:text[]) read=true scope=authority -> WorkBatch by=technician\n   do return WorkBatch {items=Inspection as item where item.inspector==actor and inspection_pending(item) and can_work(actor,item.parent.parent.location) and (count(locations)==0 or item.parent.parent.location.id in locations) select WorkItem {reference=item.id,revision=item.version,location=item.parent.parent.location.id,title=item.parent.name,detail=item.parent.parent.name,due=local_instant(item.due,\"00:00\",item.parent.parent.location.timezone,fold=earlier),action=action(inspect,{inspection=item})}}\n  # Recheck the selected inspection before showing its source-owned checklist form. @{nl=\"Controleer de gekozen inspectie opnieuw voordat het bronformulier met checklist wordt getoond.\"}\n  export scenario work_detail(record:Inspection) read=true scope=authority -> WorkItem by=technician\n   require record.inspector==actor and inspection_pending(record) and can_work(actor,record.parent.parent.location)\n   do return WorkItem {reference=record.id,revision=record.version,location=record.parent.parent.location.id,title=record.parent.name,detail=record.parent.parent.name,due=local_instant(record.due,\"00:00\",record.parent.parent.location.timezone,fold=earlier),action=action(inspect,{inspection=record})}\n Then\n  # Keep assets, overdue inspections and repair verification connected. @{nl=\"Houd bedrijfsmiddelen, achterstallige inspecties en reparatieverificatie met elkaar verbonden.\"}\n  page /facilities title=\"Facilities\"@{nl=\"Faciliteiten\"}\n   require maintenance_manager or technician\n   ## Breadcrumbs show current declared ancestry; the shared right-sidebar shell supplies navigation, no per-app menu.\n   breadcrumbs\n   card \"Asset directory\"@{nl=\"Bedrijfsmiddelenregister\"}\n    form Asset.create\n    list Asset filter=location,category,retired search=name defaults={location=preferences.location} display=split empty=\"No assets match these filters\"@{nl=\"Geen bedrijfsmiddelen voor deze filters\"}\n     pagination\n     text row.retired\n     edit\n     collapse \"Manual\"@{nl=\"Handleiding\"}\n      require row.manual!=null\n      link target=row.manual caption=\"Manual\"@{nl=\"Handleiding\"}\n     tabs\n      tab \"Inspection plans and checklists\"@{nl=\"Inspectieplannen en checklists\"}\n       table row.Cancellation columns=reason,cutoff,author,at,phase empty=\"No cancellations recorded\"@{nl=\"Geen annuleringen vastgelegd\"}\n        pagination\n        action resume_cancellation\n       form Plan.create\n        fieldset \"Inspection plan\"@{nl=\"Inspectieplan\"}\n         input name\n         input cadence_days\n         calendar next_due\n         toggle active\n       list row.Plan empty=\"No inspection plans\"@{nl=\"Geen inspectieplannen\"}\n        pagination\n        edit\n        table row.Inspection columns=due,inspector,result,cancelled,evidence,repair,reminded_at empty=\"No inspections recorded\"@{nl=\"Geen inspecties vastgelegd\"}\n         pagination\n         badge row.result\n         text row.checklist\n         form inspect\n          fieldset \"Checklist result\"@{nl=\"Checklistresultaat\"}\n           radio result\n           textarea evidence\n         form dispatch_visit arguments={inspection=row,location=row.parent.parent.location}\n      tab \"Repairs and verification\"@{nl=\"Reparaties en verificatie\"}\n       form Repair.create\n       table row.Repair columns=title,severity,due,state,contractor,block_action,block_state,affected_state,visit_review filter=state,severity defaults={severity=preferences.severity} empty=\"No repairs match these filters\"@{nl=\"Geen reparaties voor deze filters\"}\n        pagination\n        badge row.state\n        badge row.severity\n        badge row.block_state\n        edit\n        actions assign,start,block,finish,verify,retry_availability,affected_bookings,reopen\n        form dispatch_visit arguments={repair=row,location=row.parent.location}\n        card \"Affected bookings\"@{nl=\"Getroffen boekingen\"}\n         require row.affected!=null\n         text row.affected_state,row.affected.checked_at\n         table row.affected.items columns=reference,from,until,quantity,status,conflict empty=\"No affected bookings\"@{nl=\"Geen getroffen boekingen\"}\n          pagination\n        table row.Verification columns=completion,evidence,author,at empty=\"No verifications recorded\"@{nl=\"Geen verificaties vastgelegd\"}\n         pagination\n        list row.Assignment empty=\"No assignments recorded\"@{nl=\"Geen opdrachten vastgelegd\"}\n         pagination\n         text row.reason,row.contact\n         table row.Notice columns=state,delivery empty=\"No delivery attempts\"@{nl=\"Geen verzendpogingen\"}\n          pagination\n          action retry_notice\n        history\n  # Submit and follow your own fault report. @{nl=\"Dien je eigen storingsmelding in en volg deze.\"}\n  page /facilities/my-reports title=\"My facility reports\"@{nl=\"Mijn storingsmeldingen\"}\n   require authenticated\n   breadcrumbs\n   card \"Own fault intake\"@{nl=\"Eigen storing melden\"}\n    form report\n     fieldset \"Fault details\"@{nl=\"Storingsdetails\"}\n      input title\n      textarea description\n      file_input photo\n   card \"Own report outcomes\"@{nl=\"Eigen meldingsresultaten\"}\n    table Repair as report where report.reporter==actor columns=title,description,state,due,completion filter=severity,state defaults={severity=preferences.severity} empty=\"No own reports match these filters\"@{nl=\"Geen eigen meldingen voor deze filters\"}\n     pagination\n     badge row.state\n"}}
