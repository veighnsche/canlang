{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"f66bf7d7623f9a82ec08fdb9240a24d6719c8ac00dca63cae0dd1a1ee0c5bae1","before_projection_sha256":"f66bf7d7623f9a82ec08fdb9240a24d6719c8ac00dca63cae0dd1a1ee0c5bae1","changed":false,"idempotent":true,"structure_equal":true,"text":"# Help workspace members suggest improvements to facilities, amenities, and booking services and see the operator's response. @{nl=\"Help werkplekleden verbeteringen voorstellen voor faciliteiten, voorzieningen en boekingsdiensten en het antwoord van de exploitant bekijken.\"}\napp CanFeedback uses=[feedback]\n\n# Collect owned suggestions and votes while reserving moderation and roadmap decisions for product owners. @{nl=\"Verzamel eigen suggesties en stemmen en reserveer moderatie en roadmapbesluiten voor productverantwoordelijken.\"}\npackage feedback\n use rent_catalog {Location}\n use employee {can_work}\n use desk {open_request}\n Given\n  role product_owner label=\"Product owner\"@{nl=\"Productverantwoordelijke\"}\n  Product { name:text, location:Location?, owner:user label=\"Responsible person\"@{nl=\"Verantwoordelijke\"}, published:bool=true label=\"Published\"@{nl=\"Gepubliceerd\"} } label=\"Product\"@{nl=\"Product\"}\n  Suggestion in Product { title:text trim min=1 max=300, description:text trim min=1 max=5000, category:text trim min=1 max=100 label=\"Category\"@{nl=\"Categorie\"}, author:user server=actor label=\"Author\"@{nl=\"Auteur\"}, status:enum(proposed,planned,shipped,declined)=proposed label={text=label_Suggestion_status,values={proposed=\"Proposed\"@{nl=\"Voorgesteld\"},planned=\"Planned\"@{nl=\"Gepland\"},shipped=\"Shipped\"@{nl=\"Opgeleverd\"},declined=\"Declined\"@{nl=\"Afgewezen\"}}}, hidden:bool=true label=label_Suggestion_hidden, moderation_reason:text? label=\"Moderation reason\"@{nl=\"Moderatiegrond\"}, response:text? label=label_Suggestion_response, duplicate:Suggestion? label=label_Suggestion_duplicate, current_decision:Decision? label=\"Current operator decision\"@{nl=\"Huidig exploitantbesluit\"} } label=label_Suggestion\n  Vote in Suggestion { account:user server=actor label=\"Account\"@{nl=\"Account\"}, active:bool=true, cast_at:datetime server=now label=\"Last vote time\"@{nl=\"Laatste stemtijd\"} } label=\"Own vote\"@{nl=\"Eigen stem\"}\n  Decision in Suggestion { status:Suggestion.status, response:text label=label_Suggestion_response, published_at:datetime? label=\"Released at\"@{nl=\"Vrijgegeven op\"}, withdrawn:bool=false label=\"Withdrawn\"@{nl=\"Ingetrokken\"}, withdrawal_reason:text? label=\"Withdrawal reason\"@{nl=\"Reden van intrekking\"} } label=\"Operator decision\"@{nl=\"Exploitantbesluit\"}\n  contract Card { suggestion:Suggestion label=label_Suggestion, title:text, category:Suggestion.category, status:Suggestion.status, response:text? label=label_Suggestion_response, duplicate:Suggestion? label=label_Suggestion_duplicate, votes:int label=\"Votes\"@{nl=\"Stemmen\"} } label=\"Published suggestion\"@{nl=\"Gepubliceerde suggestie\"}\n  contract Roadmap { items:Card[]! label=\"Items\"@{nl=\"Items\"} } label=\"Published roadmap\"@{nl=\"Gepubliceerde roadmap\"}\n  contract DecisionCard { status:Suggestion.status, response:text label=label_Suggestion_response, published_at:datetime label=\"Released at\"@{nl=\"Vrijgegeven op\"} }\n  contract DecisionHistory { items:DecisionCard[]! label=\"Released decisions\"@{nl=\"Vrijgegeven besluiten\"} }\n  contract ProductChoice { product:Product label=\"Product\"@{nl=\"Product\"}, name:text, location:Location? }\n  policy Product read=public where=row.published\n  policy Product read=product_owner where=row.owner==actor\n  policy Suggestion read=public where=row.parent.published and not row.hidden fields=title,description,category,status,response\n  policy Suggestion read=authenticated where=row.author==actor\n  policy Suggestion read=product_owner where=row.parent.owner==actor\n  policy Vote read=authenticated where=row.account==actor\n  policy Decision read=product_owner where=row.parent.parent.owner==actor\n  unique Vote fields=account\n  invariant Suggestion: row.duplicate==null or (row.duplicate!=row and row.duplicate.parent==row.parent and row.duplicate.duplicate==null)\n  invariant Suggestion: row.current_decision==null or (row.current_decision.parent==row and row.current_decision.status==row.status and row.current_decision.response==row.response and not row.current_decision.withdrawn)\n  lock Suggestion fields=author\n  lock Vote fields=account\n  lock Decision fields=status,response\n  lock Decision fields=published_at when=row.published_at!=null\n  lock Decision fields=withdrawn,withdrawal_reason when=row.withdrawn\n  derive product_choices():ProductChoice[] = Product as product select ProductChoice {product,name=product.name,location=product.location}\n  fixture product=Product {name=\"Facilities\",owner=other}\n  fixture suggestion=Suggestion {parent=product,title=\"Phone booths\",description=\"Add booths\",category=\"Amenity\",hidden=false}\n  fixture root=Suggestion {parent=product,title=\"Quiet calls\",description=\"Improve call spaces\",category=\"Amenity\",hidden=false}\n  fixture own_vote=Vote {parent=suggestion,cast_at=now-1m}\n  fixture foreign_vote=Vote {parent=suggestion,account=other,cast_at=now-1m}\n  fixture decision=Decision {parent=suggestion,status=planned,response=\"Two booths this quarter\"}\n  fixture recent=Suggestion {parent=product,title=\"Bike storage\",description=\"Add a rack\",category=\"Amenity\"}\n  fixture recent2=Suggestion {parent=product,title=\"Water\",description=\"Add a fountain\",category=\"Amenity\"}\n  fixture recent3=Suggestion {parent=product,title=\"Desks\",description=\"Add sit-stand desks\",category=\"Amenity\"}\n  fixture recent4=Suggestion {parent=product,title=\"Lighting\",description=\"Adjust desk lights\",category=\"Amenity\"}\n  fixture recent5=Suggestion {parent=product,title=\"Plants\",description=\"Add greenery\",category=\"Amenity\"}\n  fixture moderator=user {roles=[product_owner]}\n  fixture journey_product=Product {name=\"Facilities\",owner=moderator}\n  preferences { product:Product? label=\"Product\"@{nl=\"Product\"}, location:Location?, category:Suggestion.category?, status:Suggestion.status? }\n  message label_Suggestion = \"Suggestion\"@{nl=\"Suggestie\"}\n  message label_Suggestion_status = \"Status\"@{nl=\"Status\"}\n  message label_Suggestion_hidden = \"Hidden\"@{nl=\"Verborgen\"}\n  message label_Suggestion_response = \"Staff response\"@{nl=\"Antwoord medewerker\"}\n  message label_Suggestion_duplicate = \"Duplicate suggestion\"@{nl=\"Dubbele suggestie\"}\n When\n  crud Product by=product_owner fields=name,published create_fields=name,location,owner when=row.owner==actor and (row.location==null or can_work(actor,row.location)) delete=none\n  crud Suggestion by=authenticated fields=title,description,category when=row.author==actor and row.parent.published and (not row.hidden or row.moderation_reason==null)\n   examples create parent=product title=\"Air quality\" description=\"Improve ventilation\" category=\"Amenity\"\n    as,parent.published -> count(product.Suggestion),count(product.Suggestion as item where not item.hidden)\n    members,true -> 1,0\n    members,false -> error(rule_failed)\n    public,true -> error(forbidden)\n   examples create seed=[recent,recent2,recent3,recent4,recent5] parent=product title=\"Air quality\" description=\"Improve ventilation\" category=\"Amenity\"\n    as -> count(product.Suggestion)\n    members -> error(rule_failed)\n   examples update record=suggestion\n    as,changes.title,record.author -> suggestion.title,suggestion.hidden\n    members,\"More booths\",self -> \"More booths\",true\n    members,\"More booths\",other -> error(rule_failed)\n   examples delete record=suggestion\n    as -> suggestion.archived_at!=null\n    members -> true\n  crud Vote by=authenticated fields=active create=none update=none delete=none\n  crud Decision by=product_owner fields=status,response create=none update=none delete=none\n  ## Only this canonical creation path creates suggestions; archived submissions remain in the hourly allowance.\n  scenario contribution_limit on=Suggestion.create\n   do require count(Suggestion archived=include as item where item.author==event.after.author and item.created>now-1h)<=5\n  ## Contributor edits return previously public text to review; audit history retains the earlier moderation reason.\n  scenario review_edited on=Suggestion.update\n   do set event.after {hidden=true,moderation_reason=null}\n  # Cast or restore your own vote after the account-wide ten-second cooldown; identities stay private. @{nl=\"Breng je eigen stem uit of herstel die na de accountbrede wachttijd van tien seconden; identiteiten blijven privé.\"}\n  scenario vote(suggestion:Suggestion) -> Vote by=authenticated label=\"Vote\"@{nl=\"Stemmen\"}\n   require suggestion.parent.published and not suggestion.hidden\n   require not any(Vote archived=include as vote,vote.account==actor and vote.cast_at>now-10s)\n   do\n    let existing=first(suggestion.Vote as vote where vote.account==actor)\n    if existing!=null\n     set existing {active=true,cast_at=now}\n     return existing\n    create Vote {parent=suggestion} as vote\n    return vote\n   examples suggestion=suggestion\n    as,suggestion.hidden -> count(suggestion.Vote as item where item.active)\n    members,false -> 1\n    members,true -> error(rule_failed)\n    public,false -> error(forbidden)\n   examples seed=[own_vote,foreign_vote] suggestion=suggestion\n    as,own_vote.active,own_vote.cast_at -> count(suggestion.Vote),count(suggestion.Vote as item where item.active),result==own_vote,foreign_vote.account\n    members,true,now-1m -> 2,2,true,other\n    members,false,now-1m -> 2,2,true,other\n    members,false,now -> error(rule_failed)\n   examples seed=[journey_product]\n    do\n     call Suggestion.create {parent=journey_product,title=\"Phone booths\",description=\"Add private call spaces\",category=\"Amenity\"} by=self\n     let submitted=first(journey_product.Suggestion as item where item.author==self)\n     submitted!=null -> true\n     submitted.hidden,submitted.author,submitted.status -> true,self,proposed\n     call published {product=journey_product} by=public as pending_roadmap\n     count(pending_roadmap.items) -> 0\n     call moderate {suggestion=submitted,hidden=false,reason=\"Reviewed for public roadmap\"} by=moderator\n     let reviewed=first(journey_product.Suggestion as item where item.id==submitted.id)\n     reviewed!=null -> true\n     call roadmap {suggestion=reviewed,status=planned,response=\"Two booths this quarter\",duplicate=null} by=moderator\n     let visible=first(journey_product.Suggestion as item where item.id==submitted.id)\n     visible!=null -> true\n     call published {product=journey_product} by=public as visible_roadmap\n     count(visible_roadmap.items),first(visible_roadmap.items)?.category,first(visible_roadmap.items)?.status,first(visible_roadmap.items)?.response -> 1,\"Amenity\",planned,\"Two booths this quarter\"\n     call decision_history {suggestion=visible} by=public as first_history\n     count(first_history.items),first(first_history.items)?.response -> 1,\"Two booths this quarter\"\n     call vote {suggestion=visible} by=self as cast_vote\n     call unvote {vote=cast_vote} by=self\n     let withdrawn=first(visible.Vote as item where item.account==self)\n     withdrawn!=null -> true\n     withdrawn==cast_vote,withdrawn.active,count(visible.Vote),count(visible.Vote as item where item.active) -> true,false,1,0\n     call unvote {vote=withdrawn} by=self\n     call vote {suggestion=visible} by=self -> error(rule_failed)\n     count(visible.Vote),count(visible.Vote as item where item.active) -> 1,0\n     call Suggestion.update {record=visible,changes={title=\"More phone booths\"}} by=self\n     let edited=first(journey_product.Suggestion as item where item.id==submitted.id)\n     edited!=null -> true\n     edited.title,edited.hidden,edited.moderation_reason,edited.author -> \"More phone booths\",true,null,self\n     call published {product=journey_product} by=public as review_roadmap\n     count(review_roadmap.items) -> 0\n     call decision_history {suggestion=edited} by=public -> error(rule_failed)\n     call moderate {suggestion=edited,hidden=true,reason=\"Private contact details\"} by=moderator\n     let blocked=first(journey_product.Suggestion as item where item.id==submitted.id)\n     blocked!=null -> true\n     call Suggestion.update {record=blocked,changes={title=\"Try again\"}} by=self -> error(rule_failed)\n     blocked.title,blocked.author,blocked.moderation_reason -> \"More phone booths\",self,\"Private contact details\"\n     call moderate {suggestion=blocked,hidden=false,reason=\"Reviewed correction\"} by=moderator\n     let corrected=first(journey_product.Suggestion as item where item.id==submitted.id)\n     corrected!=null -> true\n     call roadmap {suggestion=corrected,status=shipped,response=\"Two booths installed\",duplicate=null} by=moderator\n     let approved=first(journey_product.Suggestion as item where item.id==submitted.id)\n     approved!=null -> true\n     call published {product=journey_product} by=public as shipped_roadmap\n     first(shipped_roadmap.items)?.status,first(shipped_roadmap.items)?.response,first(shipped_roadmap.items)?.votes -> shipped,\"Two booths installed\",0\n     call decision_history {suggestion=approved} by=public as shipped_history\n     count(shipped_history.items) -> 2\n     call Suggestion.delete {record=approved} by=self\n     let archived=first(Suggestion archived=include as item where item.id==submitted.id)\n     archived!=null -> true\n     archived.archived_at!=null,archived.author -> true,self\n     call published {product=journey_product} by=public as archived_roadmap\n     count(archived_roadmap.items) -> 0\n     call decision_history {suggestion=archived} by=public -> error(rule_failed)\n  # Withdraw only your own vote, retaining its identity and cooldown across retries. @{nl=\"Trek uitsluitend je eigen stem in en behoud de identiteit en wachttijd bij herhaling.\"}\n  scenario unvote(vote:Vote) by=authenticated label=\"Withdraw own vote\"@{nl=\"Eigen stem intrekken\"}\n   require vote.account==actor\n   do set vote {active=false}\n   examples seed=[foreign_vote] vote=own_vote\n    as,vote.active -> vote.active,count(suggestion.Vote as item where item.active),foreign_vote.active\n    members,true -> false,1,true\n    members,false -> false,1,true\n   examples vote=foreign_vote\n    as -> vote.active\n    members -> error(rule_failed)\n  # Record an operator roadmap decision without changing authorship or votes; visible decisions release to public history. @{nl=\"Leg een exploitantbesluit over de roadmap vast zonder auteurschap of stemmen te wijzigen; zichtbare besluiten worden vrijgegeven voor de openbare geschiedenis.\"}\n  scenario roadmap(suggestion:Suggestion,status:Suggestion.status label=label_Suggestion_status,response:text label=label_Suggestion_response,duplicate:Suggestion? label=label_Suggestion_duplicate) by=product_owner label=\"Record roadmap decision\"@{nl=\"Roadmapbesluit vastleggen\"}\n   require suggestion.parent.owner==actor and trim(response)!=\"\"\n   do\n    create Decision {parent=suggestion,status,response} as decision\n    if not suggestion.hidden\n     set decision {published_at=now}\n    set suggestion {status,response,duplicate,current_decision=decision}\n   examples seed=[own_vote,foreign_vote] suggestion=suggestion status=planned response=\"Two booths this quarter\" duplicate=root\n    as,suggestion.parent.owner,duplicate.duplicate -> suggestion.status,suggestion.duplicate,suggestion.author,count(suggestion.Vote as item where item.active)\n    product_owner,self,null -> planned,root,self,2\n    members,self,null -> error(forbidden)\n    product_owner,other,null -> error(rule_failed)\n    product_owner,self,suggestion -> error(rule_failed)\n  # Hide abusive content with a reason under product-owner moderation; approving releases the selected decision. @{nl=\"Verberg misbruik met een reden binnen moderatie door de productverantwoordelijke; bij goedkeuring wordt het geselecteerde besluit vrijgegeven.\"}\n  scenario moderate(suggestion:Suggestion,hidden:bool label=label_Suggestion_hidden,reason:text) by=product_owner label=\"Moderate suggestion\"@{nl=\"Suggestie modereren\"}\n   require suggestion.parent.owner==actor and trim(reason)!=\"\"\n   do\n    if not hidden and suggestion.current_decision!=null and suggestion.current_decision.published_at==null\n     set suggestion.current_decision {published_at=now}\n    set suggestion {hidden,moderation_reason=reason}\n   examples suggestion=suggestion hidden=true reason=\"Private contact details\"\n    as,suggestion.parent.owner -> suggestion.hidden,suggestion.moderation_reason,suggestion.author\n    product_owner,self -> true,\"Private contact details\",self\n    members,self -> error(forbidden)\n   examples suggestion=suggestion hidden=false reason=\"Reviewed for public roadmap\"\n    as,suggestion.parent.owner -> suggestion.hidden,suggestion.moderation_reason\n    product_owner,self -> false,\"Reviewed for public roadmap\"\n  # Withdraw released or private staff text while retaining owner evidence. @{nl=\"Trek vrijgegeven of private medewerkerstekst in en behoud het bewijs voor de verantwoordelijke.\"}\n  scenario withdraw_decision(decision:Decision,reason:text) by=product_owner label=\"Withdraw operator decision\"@{nl=\"Exploitantbesluit intrekken\"}\n   require decision.parent.parent.owner==actor and trim(reason)!=\"\" and not decision.withdrawn\n   do\n    if decision.parent.current_decision==decision\n     set decision.parent {hidden=true,moderation_reason=reason,status=proposed,response=null,duplicate=null,current_decision=null}\n    set decision {withdrawn=true,withdrawal_reason=reason}\n   examples decision=decision reason=\"Response needs correction\"\n    as,decision.parent.parent.owner,reason,decision.withdrawn -> decision.withdrawn\n    members,self,\"Response needs correction\",false -> error(forbidden)\n    product_owner,other,\"Response needs correction\",false -> error(rule_failed)\n    product_owner,self,\"\",false -> error(rule_failed)\n    product_owner,self,\"Response needs correction\",true -> error(rule_failed)\n  # Read released operator decisions without private revisions or account identities. @{nl=\"Lees vrijgegeven exploitantbesluiten zonder private revisies of accountidentiteiten.\"}\n  scenario decision_history(suggestion:Suggestion) read=true scope=authority -> DecisionHistory by=public label=\"Read operator decision history\"@{nl=\"Geschiedenis exploitantbesluiten lezen\"}\n   require suggestion.archived_at==null and suggestion.parent.archived_at==null and suggestion.parent.published and not suggestion.hidden\n   do return DecisionHistory {items=suggestion.Decision as decision where decision.published_at!=null and not decision.withdrawn order=decision.published_at select DecisionCard {status=decision.status,response=decision.response,published_at=decision.published_at}}\n   examples seed=[journey_product]\n    do\n     call Suggestion.create {parent=journey_product,title=\"Quiet spaces\",description=\"More booths\",category=\"Amenity\"} by=self\n     let submitted=first(journey_product.Suggestion as item where item.author==self)\n     submitted!=null -> true\n     call roadmap {suggestion=submitted,status=planned,response=\"Private draft containing a phone number\",duplicate=null} by=moderator\n     let drafted=first(journey_product.Suggestion as item where item.id==submitted.id)\n     drafted!=null -> true\n     call roadmap {suggestion=drafted,status=planned,response=\"Two booths this quarter\",duplicate=null} by=moderator\n     let ready=first(journey_product.Suggestion as item where item.id==submitted.id)\n     ready!=null -> true\n     call decision_history {suggestion=ready} by=public -> error(rule_failed)\n     call moderate {suggestion=ready,hidden=false,reason=\"Reviewed current text and response\"} by=moderator\n     let visible=first(journey_product.Suggestion as item where item.id==submitted.id)\n     visible!=null -> true\n     call decision_history {suggestion=visible} by=public as released\n     count(released.items),first(released.items)?.response -> 1,\"Two booths this quarter\"\n     call roadmap {suggestion=visible,status=shipped,response=\"Two booths installed\",duplicate=null} by=moderator\n     let shipped=first(journey_product.Suggestion as item where item.id==submitted.id)\n     shipped!=null -> true\n     call decision_history {suggestion=shipped} by=public as history_before\n     count(history_before.items),any(history_before.items as item,item.response==\"Private draft containing a phone number\") -> 2,false\n     shipped.current_decision!=null -> true\n     call withdraw_decision {decision=shipped.current_decision,reason=\"Response needs correction\"} by=moderator\n     let withdrawn=first(journey_product.Suggestion as item where item.id==submitted.id)\n     withdrawn!=null -> true\n     withdrawn.hidden,withdrawn.status,withdrawn.response,withdrawn.current_decision -> true,proposed,null,null\n     call decision_history {suggestion=withdrawn} by=public -> error(rule_failed)\n     call roadmap {suggestion=withdrawn,status=planned,response=\"Installation postponed\",duplicate=null} by=moderator\n     let corrected=first(journey_product.Suggestion as item where item.id==submitted.id)\n     corrected!=null -> true\n     call moderate {suggestion=corrected,hidden=false,reason=\"Reviewed replacement\"} by=moderator\n     let republished=first(journey_product.Suggestion as item where item.id==submitted.id)\n     republished!=null -> true\n     call decision_history {suggestion=republished} by=public as history_after\n     count(history_after.items),any(history_after.items as item,item.response==\"Two booths installed\"),any(history_after.items as item,item.response==\"Installation postponed\") -> 2,false,true\n  # Expose public aggregate counts, excluding voter identities and hidden content. @{nl=\"Toon openbare geaggregeerde aantallen zonder stemmeridentiteiten of verborgen inhoud.\"}\n  scenario published(product:Product) read=true scope=authority -> Roadmap by=public label=\"Read published roadmap\"@{nl=\"Gepubliceerde roadmap lezen\"}\n   require product.published\n   do return Roadmap {items=product.Suggestion as suggestion where not suggestion.hidden select Card {suggestion,title=suggestion.title,category=suggestion.category,status=suggestion.status,response=suggestion.response,duplicate=first(product.Suggestion as item where item==suggestion.duplicate and not item.hidden),votes=count(suggestion.Vote as vote where vote.active)}}\n   examples seed=[own_vote,foreign_vote] product=product\n    as,suggestion.hidden,own_vote.active -> count(result.items),sum(result.items as item select item.votes)\n    public,false,true -> 1,2\n    public,false,false -> 1,1\n    public,true,true -> 0,0\n   examples seed=[suggestion,root] product=product\n    as,suggestion.duplicate,root.hidden -> first(result.items)?.duplicate\n    public,root,true -> null\n Then\n  # Browse a public roadmap with counts that expose no voter records. @{nl=\"Bekijk een openbare roadmap met aantallen die geen stemmerrecords blootgeven.\"}\n  page /feedback title=\"Suggestions\"@{nl=\"Suggesties\"}\n   breadcrumbs\n   hero \"Improve your workspace\"@{nl=\"Verbeter je werkplek\"}\n    text \"Published ideas welcome your vote. New suggestions await owner review.\"@{nl=\"Gepubliceerde ideeën kun je steunen met je stem. Nieuwe suggesties wachten op beoordeling.\"}\n   ## In-context saved default for the category/status filters below.\n   filter preferences.status\n   list product_choices() as choice filter=product,location defaults={product=preferences.product,location=preferences.location} search=name empty=\"No products yet.\"@{nl=\"Nog geen producten.\"}\n    pagination\n    text row.name,row.location\n    card \"Urgent private issue\"@{nl=\"Dringend privéprobleem\"}\n     alert \"Use private support for incidents. Never put access instructions or anyone’s contact details in a suggestion. New suggestions await owner review.\"@{nl=\"Gebruik privésupport voor incidenten. Zet nooit toegangsinstructies of contactgegevens van anderen in een suggestie. Nieuwe suggesties wachten op beoordeling door de verantwoordelijke.\"}\n     form open_request arguments={priority=urgent}\n    card \"Contribution intake\"@{nl=\"Bijdrage aanmaken\"}\n     form Suggestion.create arguments={parent=choice.product} display=inline\n      fieldset \"Your suggestion\"@{nl=\"Je suggestie\"}\n       input title\n       textarea description\n       input category\n    card \"Published roadmap and aggregate votes\"@{nl=\"Gepubliceerde roadmap en stemtotalen\"}\n     form published arguments={product=choice.product}\n      table result.items columns=title,category,status,response,duplicate,votes filter=category,status defaults={category=preferences.category,status=preferences.status} order=-votes empty=\"No published ideas yet.\"@{nl=\"Nog geen gepubliceerde ideeën.\"}\n       pagination\n    collapse \"Your submissions and review state\"@{nl=\"Je bijdragen en beoordelingsstatus\"}\n     require authenticated\n     list choice.product.Suggestion as suggestion where suggestion.author==actor filter=category,status defaults={category=preferences.category,status=preferences.status} empty=\"You have no submissions yet.\"@{nl=\"Je hebt nog geen bijdragen.\"}\n      pagination\n      ## swap selects display only off the readable hidden flag; slots are\n      ## exclusive, so the status badge repeats in both without duplication.\n      swap row.hidden\n       slot off\n        title row.title\n        content row.description\n        badge row.status\n        text row.category,row.response,row.duplicate\n       slot on\n        badge row.status\n        text row.title,row.moderation_reason\n        alert \"Awaiting owner review.\"@{nl=\"Wacht op beoordeling.\"}\n      edit\n      delete\n      history\n    collapse \"Suggestions and your votes\"@{nl=\"Suggesties en je eigen stemmen\"}\n     list choice.product.Suggestion filter=category,status defaults={category=preferences.category,status=preferences.status} empty=\"No suggestions yet.\"@{nl=\"Nog geen suggesties.\"}\n      pagination\n      badge row.status\n      title row.title\n      content row.description\n      text row.category,row.response\n      edit\n      tooltip \"Vote for this idea. Votes are spaced ten seconds apart.\"@{nl=\"Stem op dit idee. Stemmen volgen elkaar op met tien seconden ertussen.\"}\n       action vote\n      collapse \"Operator decision history\"@{nl=\"Geschiedenis exploitantbesluiten\"}\n       form decision_history\n        table result.items columns=published_at,status,response\n         pagination\n      collapse \"Your votes\"@{nl=\"Je eigen stemmen\"}\n       require authenticated\n       list row.Vote empty=\"No vote yet.\"@{nl=\"Nog geen stem.\"}\n        pagination\n        text row.active\n        action unvote\n  # Moderate suggestions and record only authorized roadmap commitments. @{nl=\"Modereer suggesties en leg uitsluitend toegestane roadmaptoezeggingen vast.\"}\n  page /feedback/moderation title=\"Moderation and roadmap\"@{nl=\"Moderatie en roadmap\"}\n   breadcrumbs\n   require product_owner\n   ## In-context saved default for the moderation status filter below.\n   filter preferences.status\n   card \"Product intake\"@{nl=\"Product aanmaken\"}\n    form Product.create display=inline\n     input name\n   list product_choices() as choice where choice.product.owner==actor filter=product,location defaults={product=preferences.product,location=preferences.location} search=name empty=\"No owned products.\"@{nl=\"Geen eigen producten.\"}\n    pagination\n    text row.name,row.location\n    ## Explicit update form keeps its record binding (the row is a choice, not\n    ## a Product record, so bare edit cannot bind); the suite only places name.\n    form Product.update arguments={record=choice.product}\n     input name\n    list choice.product.Suggestion filter=hidden,status defaults={status=preferences.status} display=split search=title empty=\"No suggestions to review.\"@{nl=\"Geen suggesties te beoordelen.\"}\n     pagination\n     card \"Suggestion and roadmap outcome\"@{nl=\"Suggestie en roadmapuitkomst\"}\n      badge row.status\n      title row.title\n      content row.description\n      text row.category,row.author,row.response,row.hidden,row.moderation_reason,row.duplicate\n      divider \"Decisions\"@{nl=\"Besluiten\"}\n      button opens=roadmap_decision\n      modal \"Record roadmap decision\"@{nl=\"Roadmapbesluit vastleggen\"} id=roadmap_decision\n       slot content\n        form roadmap arguments={suggestion=row} display=inline\n         fieldset \"Roadmap outcome\"@{nl=\"Roadmapuitkomst\"}\n          radio status\n          textarea response\n          select duplicate\n      button opens=moderate_content\n      modal \"Moderate suggestion\"@{nl=\"Suggestie modereren\"} id=moderate_content\n       slot content\n        form moderate arguments={suggestion=row} display=inline\n         fieldset \"Moderation\"@{nl=\"Moderatie\"}\n          toggle hidden\n          textarea reason\n     history\n     collapse \"Operator decisions and withdrawals\"@{nl=\"Exploitantbesluiten en intrekkingen\"}\n      list row.Decision order=created\n       pagination\n       text row.status,row.response,row.published_at,row.withdrawn,row.withdrawal_reason\n       action withdraw_decision\n"}}
