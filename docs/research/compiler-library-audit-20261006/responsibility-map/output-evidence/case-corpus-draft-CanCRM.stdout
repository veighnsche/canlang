{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"aa7cfef2094e64115255ce01f3eb52248d51e2c219a9fa331a868c5ac14c8a8a","before_projection_sha256":"aa7cfef2094e64115255ce01f3eb52248d51e2c219a9fa331a868c5ac14c8a8a","changed":false,"idempotent":true,"structure_equal":true,"text":"# Help workspace sales teams turn inquiries into tours, quotes, and office or coworking sales. @{nl=\"Help werkplekverkoopteams aanvragen omzetten in rondleidingen, offertes en kantoor- of coworkingverkopen.\"}\napp CanCRM uses=[crm,customer,appointments,propose]\n\n# Manage scoped sales opportunities against the canonical customer directory. @{nl=\"Beheer toegestane verkoopkansen met de canonieke klantendirectory.\"}\npackage crm label=\"Sales\"@{nl=\"Verkoop\"}\n use customer {Customer,Contact,duplicate_customers,duplicate_contacts,Alias,CompanyRole,Invitation,alias as customer_alias,invite as invite_company,recover as recover_company,claim as claim_contact,accept as accept_invitation,remove as remove_company_role,test_company,test_contact}\n use appointments {Calendar,Window,Type,Appointment,book as book_tour,cancel as cancel_tour,attendance as tour_attendance,booked}\n use propose {Proposal,Revision,Item,revise as revise_quote,send_offer,document as quote_document,request_booking,current_offer}\n use employee {Employee,can_work,test_worker}\n use rent_catalog {Location,test_site}\n use rent_reservations {Booking}\n use member_terms {Membership,Term}\n use member_plans {Plan}\n Given\n  export role salesperson label=\"Salesperson\"@{nl=\"Verkoper\"}\n  contract Pipeline { count:int, total:money } label=\"Pipeline summary\"@{nl=\"Samenvatting verkoopkansen\"}\n  export Deal { customer:Customer, contact:Contact, title:text trim min=1, location:Location, owner:user server=actor label=\"Responsible person\"@{nl=\"Verantwoordelijke\"}, value:money label=\"Value\"@{nl=\"Waarde\"}, stage:enum(lead,qualified,proposal,won,lost)=lead label={text=label_Deal_stage,values={lead=\"Lead\"@{nl=\"Lead\"},qualified=\"Qualified\"@{nl=\"Gekwalificeerd\"},proposal=\"Proposal\"@{nl=\"Offertefase\"},won=\"Won\"@{nl=\"Gewonnen\"},lost=\"Lost\"@{nl=\"Verloren\"}}}, seats:int=1 min=1 label=\"Seats\"@{nl=\"Plaatsen\"}, desired_start:date? label=\"Desired start date\"@{nl=\"Gewenste startdatum\"}, duration:text? label=\"Desired duration\"@{nl=\"Gewenste duur\"}, workspace:text? label=\"Workspace needs\"@{nl=\"Werkplekbehoefte\"}, source:text? label=\"Source reference\"@{nl=\"Bronreferentie\"}, next_action:datetime? label=\"Next action time\"@{nl=\"Tijd volgende actie\"}, notes:text?, lost_reason:text? label=\"Loss reason\"@{nl=\"Reden verloren kans\"}, outcome_reference:text? label=label_Deal_outcome_reference } label=\"Sales opportunity\"@{nl=\"Verkoopkans\"}\n  export contract ResearchLead { customer:Customer, contact:Contact, location:Location, title:Deal.title, value:money, notes:text } label=\"Reviewed research lead\"@{nl=\"Beoordeelde onderzoekskans\"}\n  ResearchIntake { source:text unique, input:ResearchLead, deal:Deal } label=\"Research promotion evidence\"@{nl=\"Bewijs onderzoeksoverdracht\"}\n  policy ResearchIntake read=salesperson and can_work(actor,row.deal.location)\n  lock ResearchIntake fields=source,input,deal\n  Activity in Deal { kind:enum(call,email,note,tour,quote,sale) label={text=\"Kind\"@{nl=\"Soort\"},values={call=\"Call\"@{nl=\"Telefoongesprek\"},email=\"Email\"@{nl=\"E-mail\"},note=\"Note\"@{nl=\"Notitie\"},tour=\"Tour\"@{nl=\"Rondleiding\"},quote=\"Quote\"@{nl=\"Offerte\"},sale=\"Confirmed sale\"@{nl=\"Bevestigde verkoop\"}}}, body:text trim min=1, link:url? label=\"Reviewed source link\"@{nl=\"Beoordeelde bronlink\"}, appointment:Appointment? label=\"Tour appointment\"@{nl=\"Rondleidingafspraak\"}, revision:Revision? label=\"Quote revision\"@{nl=\"Offerteversie\"}, author:user server=actor label=\"Author\"@{nl=\"Auteur\"}, occurred:datetime server=now } label=\"Sales activity\"@{nl=\"Verkoopactiviteit\"}\n  Sale { deal:Deal, booking:Booking? unique, term:Term? unique, recorded_by:user server=actor label=\"Recorded by\"@{nl=\"Vastgelegd door\"}, recorded_at:datetime server=now label=\"Recorded at\"@{nl=\"Vastgelegd op\"} } label=\"Confirmed sale evidence\"@{nl=\"Bewijs bevestigde verkoop\"}\n  policy Sale read=salesperson and can_work(actor,row.deal.location)\n  invariant Sale: (row.booking!=null and row.term==null) or (row.booking==null and row.term!=null)\n  lock Sale fields=deal,booking,term,recorded_by,recorded_at\n  policy Deal read=salesperson and can_work(actor,row.location)\n  policy Activity read=salesperson and can_work(actor,row.parent.location)\n  invariant Deal: row.contact.parent==row.customer and row.value.minor>=0 and row.value.currency==row.location.currency\n  invariant Activity: (row.appointment==null or (row.kind==tour and row.revision==null and row.appointment.customer==row.parent.customer and row.appointment.contact==row.parent.contact and row.appointment.parent.parent.location==row.parent.location)) and (row.revision==null or (row.kind==quote and row.appointment==null and row.revision.parent.parent==row.parent.customer and row.revision.parent.recipient==row.parent.contact and row.revision.parent.location==row.parent.location))\n  lock Activity fields=kind,body,link,appointment,revision,author,occurred\n  fixture colleague=Employee {user=other,home=test_worker.home,locations=test_worker.locations,start=test_worker.start,role=test_worker.role}\n  fixture prospect=Deal {customer=test_company,contact=test_contact,title=\"Office\",location=test_site,owner=self,value=money(500,\"EUR\")}\n  fixture research_intake=ResearchIntake {source=\"discover:existing\",input={customer=test_company,contact=test_contact,location=test_site,title=\"Office\",value=money(500,\"EUR\"),notes=\"Reviewed evidence\"},deal=prospect}\n  fixture sale_plan=Plan {name=\"Coworking\",price=money(500,\"EUR\"),locations=[test_site],products=[\"coworking\"],access_hours=\"Business hours\",seats=6}\n  fixture sale_membership=Membership {parent=test_company,account=self,plan=sale_plan,anchor=date(\"2026-10-01\"),timezone=\"UTC\"}\n  fixture paid_term=Term {parent=sale_membership,source=\"crm-win-term\",from=datetime(\"2026-10-01T00:00:00Z\"),until=datetime(\"2026-11-01T00:00:00Z\"),price=money(500,\"EUR\"),locations=[test_site],products=[\"coworking\"],access_hours=\"Business hours\",mail=false,seats=6,paid=true,cycle=1}\n  fixture prior_sale=Sale {deal=prospect,term=paid_term}\n  fixture linked_tour=Activity {parent=prospect,kind=tour,body=\"Scheduled tour\",appointment=booked}\n  fixture linked_quote=Activity {parent=prospect,kind=quote,body=\"Issued quote\",revision=current_offer}\n  fixture reviewed_link=Activity {parent=prospect,kind=tour,body=\"Reviewed tour\",link=\"https://example.test/tours/1\"}\n  preferences { location:Location?, stage:Deal.stage?, followup:enum(overdue,upcoming)=overdue label={text=\"Next-action view\"@{nl=\"Weergave vervolgacties\"},values={overdue=\"Overdue next actions\"@{nl=\"Achterstallige vervolgacties\"},upcoming=\"Upcoming next actions\"@{nl=\"Komende vervolgacties\"}}} }\n  invariant preferences: row.location==null or can_work(actor,row.location)\n  message label_Deal_stage = \"Sales stage\"@{nl=\"Verkoopfase\"}\n  message label_Deal_outcome_reference = \"Confirmed outcome reference\"@{nl=\"Referentie bevestigde uitkomst\"}\n When\n  crud Deal by=salesperson fields=title,owner,value,seats,desired_start,duration,workspace,source,next_action,notes when=can_work(actor,row.location) and can_work(row.owner,row.location) and salesperson(row.owner) and row.customer.active and row.stage in [lead,qualified,proposal] create_fields=customer,contact,title,location,value,seats,desired_start,duration,workspace,source,next_action,notes delete=none\n   examples update seed=[test_worker,colleague] record=prospect\n    as,changes.owner -> record.owner\n    salesperson,self -> self\n    salesperson,other -> error(rule_failed)\n  crud Activity by=salesperson fields=kind,body update=none delete=none when=can_work(actor,row.parent.location) and row.kind in [call,email,note]\n  # Promote reviewed research once under current sales authority; reused identity must preserve the reviewed input. @{nl=\"Draag beoordeeld onderzoek eenmaal over met actuele verkooprechten; hergebruikte identiteit moet de beoordeelde invoer behouden.\"}\n  export scenario promote_research(source:text,input:ResearchLead) -> Deal by=salesperson label=\"Promote reviewed research\"@{nl=\"Beoordeeld onderzoek overdragen\"}\n   require starts_with(source,\"discover:\") and source!=\"discover:\" and can_work(actor,input.location) and input.customer.active and input.contact.parent==input.customer and input.value.minor>=0 and input.value.currency==input.location.currency\n   do\n    let existing=first(ResearchIntake as intake where intake.source==source)\n    if existing!=null\n     require existing.input==input and can_work(actor,existing.deal.location)\n     return existing.deal\n    create Deal {customer=input.customer,contact=input.contact,location=input.location,title=input.title,value=input.value,notes=input.notes,source} as deal\n    create ResearchIntake {source,input,deal} as intake\n    return deal\n   examples seed=[test_worker] source=\"discover:new\" input={customer=test_company,contact=test_contact,location=test_site,title=\"Office\",value=money(500,\"EUR\"),notes=\"Reviewed evidence\"}\n    as,input.customer.active,input.value -> count(ResearchIntake),result.source,result.stage\n    salesperson,true,money(500,\"EUR\") -> 1,\"discover:new\",lead\n    salesperson,false,money(500,\"EUR\") -> error(rule_failed)\n    salesperson,true,money(500,\"USD\") -> error(rule_failed)\n    members,true,money(500,\"EUR\") -> error(forbidden)\n   examples seed=[test_worker,research_intake] source=\"discover:existing\" input={customer=test_company,contact=test_contact,location=test_site,title=\"Office\",value=money(500,\"EUR\"),notes=\"Reviewed evidence\"}\n    as,input.title -> count(ResearchIntake),result==prospect\n    salesperson,\"Office\" -> 1,true\n    salesperson,\"Different approval\" -> error(rule_failed)\n  # Advance a live deal without claiming inventory or payment. @{nl=\"Zet een actieve verkoopkans vooruit zonder voorraad of betaling te claimen.\"}\n  scenario advance(deal:Deal,stage:Deal.stage label=label_Deal_stage) by=salesperson label=\"Advance stage\"@{nl=\"Fase vooruitzetten\"}\n   require can_work(actor,deal.location) and ((deal.stage==lead and stage==qualified) or (deal.stage==qualified and stage==proposal))\n   do set deal {stage}\n  # Retain a reviewed tour or quote link without scheduling or issuing it. @{nl=\"Bewaar een beoordeelde rondleiding- of offertelink zonder deze te plannen of uit te geven.\"}\n  scenario record_link(deal:Deal,kind:Activity.kind,link:url label=\"Reviewed source link\"@{nl=\"Beoordeelde bronlink\"},body:text) by=salesperson label=\"Record reviewed link\"@{nl=\"Beoordeelde link vastleggen\"}\n   require can_work(actor,deal.location) and kind in [tour,quote] and trim(body)!=\"\"\n   require not any(deal.Activity as activity,activity.kind==kind and activity.link==link)\n   do create Activity {parent=deal,kind,body,link} as activity\n   examples seed=[test_worker] deal=prospect link=\"https://example.test/tours/1\" body=\"Reviewed tour\"\n    as,kind -> count(deal.Activity)\n    salesperson,tour -> 1\n    salesperson,note -> error(rule_failed)\n    members,tour -> error(forbidden)\n   examples seed=[test_worker,reviewed_link] deal=prospect kind=tour link=\"https://example.test/tours/1\" body=\"Reviewed tour\"\n    as -> count(deal.Activity)\n    salesperson -> error(rule_failed)\n  # Link an actual appointment without treating pending coordination as confirmation. @{nl=\"Koppel een echte afspraak zonder wachtende afstemming als bevestiging te behandelen.\"}\n  scenario record_tour(deal:Deal,appointment:Appointment,body:text) by=salesperson label=\"Record tour appointment\"@{nl=\"Rondleidingafspraak vastleggen\"}\n   require can_work(actor,deal.location) and appointment.customer==deal.customer and appointment.contact==deal.contact and appointment.parent.parent.location==deal.location and trim(body)!=\"\"\n   require not any(deal.Activity as activity,activity.appointment==appointment)\n   do create Activity {parent=deal,kind=tour,body,appointment} as activity\n   examples seed=[test_worker] deal=prospect appointment=booked body=\"Scheduled tour\"\n    as,appointment.state -> count(deal.Activity)\n    salesperson,pending -> 1\n    salesperson,confirmed -> 1\n    members,confirmed -> error(forbidden)\n   examples seed=[test_worker,linked_tour] deal=prospect appointment=booked body=\"Scheduled tour\"\n    as -> count(deal.Activity)\n    salesperson -> error(rule_failed)\n  # Record the exact issued revision; draft prices are not issued offer evidence. @{nl=\"Leg de exact uitgegeven versie vast; conceptprijzen zijn geen bewijs van een uitgegeven offerte.\"}\n  scenario record_quote(deal:Deal,revision:Revision,body:text) by=salesperson label=\"Record issued quote\"@{nl=\"Uitgegeven offerte vastleggen\"}\n   require can_work(actor,deal.location) and revision.parent.parent==deal.customer and revision.parent.recipient==deal.contact and revision.parent.location==deal.location and revision.state in [sent,accepted,declined] and trim(body)!=\"\"\n   require not any(deal.Activity as activity,activity.revision==revision)\n   do create Activity {parent=deal,kind=quote,body,revision} as activity\n   examples seed=[test_worker] deal=prospect revision=current_offer body=\"Issued quote\"\n    as,revision.state -> count(deal.Activity)\n    salesperson,sent -> 1\n    salesperson,draft -> error(rule_failed)\n    members,sent -> error(forbidden)\n   examples seed=[test_worker,linked_quote] deal=prospect revision=current_offer body=\"Issued quote\"\n    as -> count(deal.Activity)\n    salesperson -> error(rule_failed)\n  # Record a won outcome linked to actual source evidence. @{nl=\"Leg een gewonnen uitkomst vast die naar werkelijk bronbewijs verwijst.\"}\n  scenario win(deal:Deal,booking:Booking?,term:Term?) by=salesperson label=\"Record won opportunity\"@{nl=\"Gewonnen kans vastleggen\"}\n   require can_work(actor,deal.location) and deal.stage in [lead,qualified,proposal]\n   require (booking!=null and term==null) or (booking==null and term!=null)\n   do\n    if booking!=null\n     require booking.customer==deal.customer and booking.parent.location==deal.location and booking.status in [confirmed,occupied,completed]\n     require not any(Sale as sale,sale.booking==booking)\n     create Sale {deal,booking} as evidence\n     create Activity {parent=deal,kind=sale,body=booking.id} as activity\n     set deal {stage=won,outcome_reference=booking.id,next_action=null}\n    else\n     require term!=null and term.parent.parent==deal.customer and deal.location in term.locations and term.paid\n     require not any(Sale as sale,sale.term==term)\n     create Sale {deal,term} as evidence\n     create Activity {parent=deal,kind=sale,body=term.id} as activity\n     set deal {stage=won,outcome_reference=term.id,next_action=null}\n   examples seed=[test_worker] deal=prospect\n    as -> deal.stage\n    salesperson -> error(rule_failed)\n    members -> error(forbidden)\n   examples seed=[test_worker] deal=prospect term=paid_term\n    as,term.paid,term.locations -> deal.stage,count(Sale as sale where sale.deal==deal),count(deal.Activity),deal.outcome_reference==paid_term.id\n    salesperson,true,[test_site] -> won,1,1,true\n    salesperson,false,[test_site] -> error(rule_failed)\n    salesperson,true,[] -> error(rule_failed)\n    members,true,[test_site] -> error(forbidden)\n   examples seed=[test_worker,prior_sale] deal=prospect term=paid_term\n    as -> deal.stage\n    salesperson -> error(rule_failed)\n  # Record why a live opportunity was lost. @{nl=\"Leg vast waarom een actieve verkoopkans verloren ging.\"}\n  scenario lose(deal:Deal,reason:text) by=salesperson label=\"Record lost opportunity\"@{nl=\"Verloren kans vastleggen\"}\n   require can_work(actor,deal.location) and deal.stage in [lead,qualified,proposal] and trim(reason)!=\"\"\n   do set deal {stage=lost,lost_reason=reason,next_action=null}\n   examples seed=[test_worker] deal=prospect\n    as,reason -> deal.stage,deal.lost_reason\n    salesperson,\"No longer needed\" -> lost,\"No longer needed\"\n    salesperson,\"\" -> error(rule_failed)\n    members,\"No longer needed\" -> error(forbidden)\n  # Reopen with an attributed activity preserving prior outcome evidence. @{nl=\"Heropen met een toegeschreven activiteit die eerder uitkomstbewijs behoudt.\"}\n  scenario reopen(deal:Deal,reason:text) by=salesperson\n   require can_work(actor,deal.location) and deal.stage in [won,lost] and trim(reason)!=\"\"\n   do\n    create Activity {parent=deal,kind=note,body=reason} as activity\n    set deal {stage=lead}\n  # Summarize only readable open opportunities in one selected currency. @{nl=\"Vat uitsluitend leesbare open verkoopkansen samen in één gekozen valuta.\"}\n  scenario pipeline(currency:currency) read=true -> Pipeline by=salesperson label=\"Read pipeline\"@{nl=\"Verkoopkansen lezen\"}\n   do return Pipeline {count=count(Deal as deal where deal.stage in [lead,qualified,proposal] and deal.value.currency==currency),total=sum(Deal as deal where deal.stage in [lead,qualified,proposal] and deal.value.currency==currency select deal.value,currency)}\n Then\n  # Review prospects, location needs and dated follow-up. @{nl=\"Bekijk prospects, locatiebehoeften en gedateerde vervolgacties.\"}\n  page /sales title=\"Sales pipeline\"@{nl=\"Verkoopkansen\"}\n   require salesperson\n   ## Breadcrumbs show current declared ancestry; the shared right-sidebar shell supplies navigation, no per-app menu.\n   breadcrumbs\n   card \"Customer opportunity intake\"@{nl=\"Klantverkoopkans aanmaken\"}\n    form Customer.create import=csv review=duplicate_customers\n    ## Customer/Contact schemas stay CanCustomer-owned; CSV review uses owner duplicate reads. No fields are copied.\n    list Customer as customer where customer.active columns=name,kind search=name\n     pagination\n     badge row.kind\n     status row.active\n     edit\n     delete\n     form Contact.create arguments={parent=customer} import=csv review=duplicate_contacts\n     collapse \"Likely company duplicates\"@{nl=\"Mogelijke dubbele bedrijven\"}\n      alert \"Reviewed aliases never rewrite history or transfer roles; candidates need staff confirmation.\"@{nl=\"Beoordeelde aliassen herschrijven geen geschiedenis en dragen geen rollen over; kandidaten vereisen personeelsbevestiging.\"}\n      tooltip \"Candidates match same kind and case-folded name under current directory grants; not identity proof.\"@{nl=\"Kandidaten komen overeen op soort en hoofdletteronverschillige naam onder huidige directoryrechten; geen identiteitsbewijs.\"}\n       list Customer archived=include as candidate where candidate.kind==customer.kind and lower(candidate.name)==lower(customer.name) and candidate!=customer columns=name,kind\n        form customer_alias arguments={source=candidate,target=customer}\n      ## Alias inputs stay owner-owned; the bare form keeps generated controls for the reviewed mapping.\n     form invite_company arguments={org=customer}\n     form recover_company arguments={org=customer}\n     list customer.CompanyRole columns=account,role,locations,active\n      badge row.role\n      status row.active\n      button action=remove_company_role\n     list customer.Invitation columns=email,role,locations,status,expires\n      badge row.role\n      badge row.status\n      badge row.expires\n      button action=accept_invitation\n     list Alias as mapping where mapping.from_customer==customer or mapping.to_customer==customer columns=from_customer,to_customer,reason,approved_by\n     list customer.Contact as contact columns=name,email\n      pagination\n      edit\n      delete\n      form Deal.create arguments={customer,contact}\n      ## Deal creation keeps generated controls here; the deal drawer shows an explicit subset for updates.\n      button action=claim_contact\n      collapse \"Likely contact duplicates\"@{nl=\"Mogelijke dubbele contactpersonen\"}\n       alert \"Exact-email candidates need staff review; never silently merge.\"@{nl=\"Kandidaten met exact e-mailadres vereisen personeelsbeoordeling; nooit stilzwijgend samenvoegen.\"}\n       list Contact archived=include as candidate where candidate.email==contact.email and candidate!=contact columns=name,email\n   board Deal as deal by=stage columns=title,customer,contact,value,seats,next_action filter=location,owner,stage defaults={location=preferences.location,stage=preferences.stage} search=title\n    badge row.stage\n    stat row.value\n    badge row.seats\n    badge row.next_action\n    copy row.outcome_reference\n    ## Stage/value/seats/next-action stay visible on cards; the outcome reference keeps its clipboard control.\n    details \"Deal needs and actions\"@{nl=\"Behoeften en acties verkoopkans\"} display=drawer\n     text row.desired_start,row.duration,row.workspace,row.notes,row.lost_reason\n     edit\n      fieldset \"Deal context\"@{nl=\"Verkoopkanscontext\"}\n       label title\n       input title\n       validator title\n       label desired_start\n       calendar desired_start\n       validator desired_start\n       label workspace\n       textarea workspace\n       validator workspace\n       label notes\n       textarea notes\n       validator notes\n       button submit=true\n     ## Placed update inputs render here; owner/value/seats/duration/source/next-action keep generated controls. No directory is inferred.\n     button opens=advance_stage\n     modal \"Advance stage\"@{nl=\"Fase vooruitzetten\"} id=advance_stage\n      slot content\n       form advance arguments={deal=row} display=inline\n        fieldset \"New stage\"@{nl=\"Nieuwe fase\"}\n         label stage\n         radio stage\n         validator stage\n         button submit=true\n      ## Only lead-to-qualified and qualified-to-proposal succeed; other choices fail correctably with the draft kept.\n     button opens=record_win\n     modal \"Record won opportunity\"@{nl=\"Gewonnen kans vastleggen\"} id=record_win\n      slot content\n       alert \"Winning records an existing booking or paid term; it reserves no space and confirms no payment.\"@{nl=\"Winnen legt een bestaande boeking of betaalde termijn vast; het reserveert geen ruimte en bevestigt geen betaling.\"}\n       form win arguments={deal=row} display=inline\n        fieldset \"Sale evidence\"@{nl=\"Verkoopbewijs\"}\n         label booking\n         select booking\n         validator booking\n         label term\n         select term\n         validator term\n         button submit=true\n      ## Exactly one of booking/term is required; duplicates are rejected and prior evidence survives reopening.\n     button opens=record_loss\n     modal \"Record lost opportunity\"@{nl=\"Verloren kans vastleggen\"} id=record_loss\n      slot content\n       form lose arguments={deal=row} display=inline\n        fieldset \"Loss reason\"@{nl=\"Reden verloren kans\"}\n         label reason\n         textarea reason\n         validator reason\n         button submit=true\n     button opens=deal_reopen\n     modal \"Reopen opportunity\"@{nl=\"Kans heropenen\"} id=deal_reopen\n      slot content\n       form reopen arguments={deal=row} display=inline\n        fieldset \"Reopen reason\"@{nl=\"Reden heropenen\"}\n         label reason\n         textarea reason\n         validator reason\n         button submit=true\n      ## Reopening creates an attributed note, preserves prior sale/loss evidence and returns the deal to lead.\n     button opens=reviewed_link\n     modal \"Record reviewed link\"@{nl=\"Beoordeelde link vastleggen\"} id=reviewed_link\n      slot content\n       form record_link arguments={deal=row} display=inline\n        fieldset \"Reviewed link\"@{nl=\"Beoordeelde link\"}\n         label kind\n         radio kind\n         validator kind\n         label link\n         input link\n         validator link\n         label body\n         textarea body\n         validator body\n         button submit=true\n      ## Links are staff evidence only, never scheduling or issuing; duplicate kind and link pairs are rejected.\n     form Activity.create arguments={parent=deal}\n      fieldset \"Sales activity\"@{nl=\"Verkoopactiviteit\"}\n       label kind\n       radio kind\n       validator kind\n       label body\n       textarea body\n       validator body\n       button submit=true\n     ## Calls, emails and notes only; tours/quotes/sales use their dedicated evidence operations below.\n     collapse \"Schedule a tour\"@{nl=\"Rondleiding plannen\"}\n      alert \"Pending host or room coordination is not a confirmed tour.\"@{nl=\"Wachtende gastheer- of ruimteafstemming is geen bevestigde rondleiding.\"}\n      steps\n       slot item\n        text \"Find published calendar\"@{nl=\"Gepubliceerde agenda zoeken\"}\n       slot item\n        text \"Book with deal customer and contact\"@{nl=\"Boeken met klant en contactpersoon\"}\n       slot item\n        text \"Record linked appointment\"@{nl=\"Gekoppelde afspraak vastleggen\"}\n      ## Tour stages are readable only; booking keeps its owning host grants and pending stays distinct from confirmed.\n      list Calendar as calendar where calendar.active and calendar.location==deal.location columns=location,timezone,hours,instructions,cutoff\n       table calendar.Window columns=from,until,available order=from\n        pagination\n        status row.available\n       list calendar.Type as type columns=name,duration,room\n        form book_tour arguments={type,customer=deal.customer,contact=deal.contact}\n      ## Booking inputs stay CanBook-owned; a salesperson alone schedules nothing without the host grant.\n      list Appointment as appointment where appointment.customer==deal.customer and appointment.contact==deal.contact and appointment.parent.parent.location==deal.location columns=from,until,state,reason,host_ok,room_ok order=from\n       pagination\n       badge row.state\n       status row.host_ok\n       status row.room_ok\n       button action=cancel_tour\n       button action=tour_attendance\n       form record_tour arguments={deal,appointment}\n        fieldset \"Tour evidence note\"@{nl=\"Notitie rondleidingbewijs\"}\n         label body\n         textarea body\n         validator body\n         button submit=true\n      ## Pending coordination stays retainable without claiming confirmation; duplicate appointments are rejected.\n     collapse \"Prepare and issue a quote\"@{nl=\"Offerte voorbereiden en uitgeven\"}\n      steps\n       slot item\n        text \"Draft proposal\"@{nl=\"Conceptvoorstel\"}\n       slot item\n        text \"Issue priced revision\"@{nl=\"Geprijsde versie uitgeven\"}\n       slot item\n        text \"Record issued evidence\"@{nl=\"Uitgegeven bewijs vastleggen\"}\n      ## Quote stages are readable only; issuing freezes pricing and acceptance still needs a separate handoff.\n      form Proposal.create arguments={parent=deal.customer,recipient=deal.contact,location=deal.location,currency=deal.value.currency}\n      ## Proposal inputs stay CanPropose-owned; customer, contact, location, currency and seats arrive bound.\n      list Proposal as proposal where proposal.parent==deal.customer and proposal.recipient==deal.contact and proposal.location==deal.location columns=title,current,currency\n       edit\n       form revise_quote arguments={proposal,seats=deal.seats}\n       list proposal.Revision as revision order=-number columns=number,state,total,expires,handoff,booking\n        pagination\n        badge revision.state\n        stat revision.total\n        text revision.from,revision.until,revision.seats,revision.terms,revision.pdf\n        button target=revision.pdf caption=\"Open quote PDF\"@{nl=\"Offerte-PDF openen\"}\n        diff\n         slot before\n          text deal.value\n         slot after\n          text revision.total\n        ## Side-by-side authorized values only; currencies already match and no conversion is inferred.\n        form Item.create arguments={parent=revision}\n        list revision.Item columns=title,quantity,unit,price,tax,discount\n         edit\n         delete\n        button action=send_offer\n        button action=quote_document\n        button action=request_booking\n        form record_quote arguments={deal,revision}\n         fieldset \"Quote evidence note\"@{nl=\"Notitie offertebewijs\"}\n          label body\n          textarea body\n          validator body\n          button submit=true\n        ## Sent, accepted or declined revisions only; drafts are rejected and the exact revision stays bound.\n     timeline row.Activity order=-occurred\n      slot item\n       chat_bubble\n        slot header\n         badge row.kind\n         text row.author,row.occurred\n        slot content\n         text row.body\n        slot footer\n         link target=row.link caption=\"Reviewed source\"@{nl=\"Beoordeelde bron\"}\n         text row.appointment,row.revision\n      ## Chronological attributed activity as messages; no avatar exists and links stay explicit staff evidence.\n     list Sale as sale where sale.deal==deal columns=booking,term,recorded_by,recorded_at\n     ## Few immutable evidence rows per deal; columns suffice and no pagination is warranted.\n     history\n   card \"Selected currency pipeline\"@{nl=\"Verkoopkansen in gekozen valuta\"}\n    form pipeline display=inline\n     fieldset \"Pipeline currency\"@{nl=\"Valuta verkoopkansen\"}\n      label currency\n      input currency\n      validator currency\n      button submit=true\n     stat result.count\n     stat result.total\n    ## Metrics share the stat contract; the selected currency keeps unlike amounts separate.\n    alert \"Pipeline groups by selected currency; unlike amounts never add.\"@{nl=\"Verkoopkansen groeperen op gekozen valuta; ongelijke bedragen worden nooit opgeteld.\"}\n   card \"Customer timeline\"@{nl=\"Klanttijdlijn\"}\n    list Customer archived=include as customer columns=name,kind,active,archived_at search=name\n     pagination\n     badge row.kind\n     status row.active\n     list Deal as deal where deal.customer==customer columns=title,contact,stage,next_action order=-updated\n      badge row.stage\n      list deal.Activity order=-occurred\n       badge row.kind\n       text row.body,row.link,row.appointment,row.revision,row.author,row.occurred\n      ## Concise cross-deal overview; the deal drawer timelines the full attributed history.\n      history\n   card \"Next actions\"@{nl=\"Vervolgacties\"}\n    tabs preferences.followup\n    table Deal as deal where deal.stage in [lead,qualified,proposal] and deal.next_action!=null and ((preferences.followup==overdue and deal.next_action<now) or (preferences.followup==upcoming and deal.next_action>=now)) columns=title,customer,contact,next_action,owner order=next_action filter=location,owner defaults={location=preferences.location} search=title\n     pagination\n     swap row.next_action>=now\n      slot off\n       alert \"Overdue follow-up needs action.\"@{nl=\"Achterstallige vervolgactie vereist actie.\"}\n      slot on\n       countdown row.next_action-now\n      ## Swap is display-only on a business bool; countdown is view-only remaining time and schedules nothing.\n   footer \"Tours, quotes and accounts use their owning operations; a sales role alone grants no host, proposal or customer-manager authority.\"@{nl=\"Rondleidingen, offertes en accounts gebruiken hun eigen bewerkingen; een verkooprol alleen geeft geen gastheer-, offerte- of klantbeheerrechten.\"}\n    text \"CSV import previews invalid and duplicate rows; winning records references without reserving space or confirming payment.\"@{nl=\"CSV-import toont ongeldige en dubbele rijen; winnen legt referenties vast zonder ruimte te reserveren of betaling te bevestigen.\"}\n  ## CSV export follows the shared authorized collection/read-result contract; no app formatter is authored.\n  ## Imported forms keep appointments, propose and customer permissions; a CRM salesperson role alone grants no host, proposal or customer-manager authority.\n"}}
