{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"ca2a0e5c8f07a6479c09f4c255506530ad09055ff3b21479600e17b28e1d1669","before_projection_sha256":"ca2a0e5c8f07a6479c09f4c255506530ad09055ff3b21479600e17b28e1d1669","changed":true,"idempotent":true,"structure_equal":true,"text":"# Help the workspace operator reward repeat paid workspace visits with points, tiers, and fulfillable perks. @{nl=\"Help de werkplekbeheerder herhaalde betaalde bezoeken te belonen met punten, niveaus en uitvoerbare voordelen.\"}\napp CanLoyalty uses=[loyalty]\n\n# Keep earned points, tier progress and fulfillable perk reservations separate from cash and member allowances. @{nl=\"Houd verdiende punten, niveauvoortgang en voordeelreserveringen gescheiden van geld en lidmaatschapstegoeden.\"}\npackage loyalty label=heading_rewards\n use customer {Customer,Contact,test_company,test_contact}\n use rent_catalog {Location,test_site}\n use employee {can_work,test_worker}\n use std {DeliveryResult}\n use std {EmailV1 as Mail} from=deployment.mail\n use invoice {SalesV1 as Sales,Qualification} from=deployment.qualified_sales\n Given\n  message page_loyalty_fulfillment_title = \"Reward fulfillment\"@{nl=\"Beloningen uitvoeren\"}\n  message page_loyalty_catalog_title = \"Reward program\"@{nl=\"Beloningsprogramma\"}\n  message heading_rewards = \"Rewards\"@{nl=\"Beloningen\"}\n  message label_Program_locations = \"Locations\"@{nl=\"Locaties\"}\n  message label_Reward_cost = \"Cost\"@{nl=\"Kosten\"}\n  message label_Earning_source = \"Source reference\"@{nl=\"Bronreferentie\"}\n  preferences { view:enum(rewards,history)=rewards label={text=\"Reward view\"@{nl=\"Beloningsweergave\"},values={rewards=heading_rewards,history=\"History\"@{nl=\"Geschiedenis\"}}}, location:Location? label=\"Reward location\"@{nl=\"Beloningslocatie\"}, redemption_state:Redemption.state? label=\"Reward state\"@{nl=\"Beloningsstatus\"} }\n  role program_owner label=\"Program owner\"@{nl=\"Programma-eigenaar\"}\n  role reward_staff label=\"Reward staff\"@{nl=\"Beloningsmedewerker\"}\n  Program { name:text, locations:Location[] label=label_Program_locations, terms:text label=\"Terms\"@{nl=\"Voorwaarden\"}, products:text[]! min=1 label=\"Qualifying products\"@{nl=\"Kwalificerende producten\"}, points_per_sale:int min=1 label=\"Points per sale\"@{nl=\"Punten per verkoop\"}, active:bool=true } label=page_loyalty_catalog_title\n  Tier in Program { name:text, threshold:int min=0 label=\"Points threshold\"@{nl=\"Puntendrempel\"} } label=\"Reward tier\"@{nl=\"Beloningsniveau\"}\n  Reward in Program { name:text, cost:int min=1 label=label_Reward_cost, instructions:text, locations:Location[] label=label_Program_locations, active:bool=true } label=\"Reward\"@{nl=\"Beloning\"}\n  Account in Program { customer:Customer, contact:Contact } label=\"Reward account\"@{nl=\"Beloningsaccount\"}\n  SourceEvidence in Account { source:text unique, value:Qualification, reversed:bool=false, decided:bool=false }\n  Earning in Account { tier:bool=false label=\"Counts toward tier\"@{nl=\"Telt mee voor niveau\"}, author:user?, qualification:SourceEvidence?, source:text unique label=label_Earning_source, points:int label=\"Points\"@{nl=\"Punten\"}, reason:text, reversal:Earning? label=\"Reversed entry\"@{nl=\"Tegenboeking\"} } label=\"Points entry\"@{nl=\"Puntenboeking\"}\n  Redemption in Account { reward:Reward, name:text, instructions:text, locations:Location[]!, location:Location, fulfilled_by:user?, cancelled_by:user?, notification_delivery:delivery(Mail.send)?, cost:int label=label_Reward_cost, state:enum(reserved,fulfilled,cancelled)=reserved label={text=\"State\"@{nl=\"Status\"},values={reserved=\"Reserved\"@{nl=\"Gereserveerd\"},fulfilled=\"Fulfilled\"@{nl=\"Uitgevoerd\"},cancelled=\"Cancelled\"@{nl=\"Geannuleerd\"}}}, evidence:text?, source:text unique label=label_Earning_source } label=\"Reward reservation\"@{nl=\"Beloningsreservering\"}\n  ## Notification outcome observes the Mail receipt; null means no notice was requested.\n  derive Redemption.notification:DeliveryResult.status? = row.notification_delivery?.status label=\"Notification outcome\"@{nl=\"Meldingsresultaat\"}\n  derive Account.earned:int = sum(row.Earning as earning where earning.tier select earning.points) label=\"Earned points\"@{nl=\"Verdiende punten\"}\n  derive Account.available:int = sum(row.Earning as earning select earning.points)-sum(row.Redemption as redemption where redemption.state in [reserved,fulfilled] select redemption.cost) label=\"Available points\"@{nl=\"Beschikbare punten\"}\n  derive Account.tier:Tier? = first(row.parent.Tier as tier where tier.threshold<=row.earned order=-tier.threshold) label=\"Current tier\"@{nl=\"Huidig niveau\"}\n  derive Account.next_tier:Tier? = first(row.parent.Tier as tier where tier.threshold>row.earned order=tier.threshold) label=\"Next tier\"@{nl=\"Volgend niveau\"}\n  derive Account.tier_span:int = max([0,(row.next_tier?.threshold??row.tier?.threshold??0)-(row.tier?.threshold??0)]) label=\"Points between tiers\"@{nl=\"Punten tussen niveaus\"}\n  derive Account.tier_progress:int = min([row.tier_span,max([0,row.earned-(row.tier?.threshold??0)])]) label=\"Points toward next tier\"@{nl=\"Punten richting volgend niveau\"}\n  policy Program read=public fields=name,locations,products,terms,points_per_sale,active\n  policy Program read=program_owner or reward_staff where=all(row.locations as location,can_work(actor,location))\n  policy Tier read=public\n  policy Reward read=public where=row.active\n  policy Reward read=program_owner where=all(row.parent.locations as location,can_work(actor,location))\n  policy Account read=authenticated where=(row.contact.account==actor and row.contact.verified)\n  policy Account read=reward_staff where=all(row.parent.locations as location,can_work(actor,location))\n  policy Earning read=authenticated where=(row.parent.contact.account==actor and row.parent.contact.verified)\n  policy Earning read=reward_staff where=all(row.parent.parent.locations as location,can_work(actor,location))\n  policy SourceEvidence read=authenticated where=row.parent.contact.account==actor and row.parent.contact.verified\n  policy SourceEvidence read=reward_staff where=all(row.parent.parent.locations as location,can_work(actor,location))\n  policy Redemption read=authenticated where=row.parent.contact.account==actor and row.parent.contact.verified\n  policy Redemption read=reward_staff where=can_work(actor,row.location)\n  unique Tier fields=threshold\n  unique Account fields=customer\n  unique Earning fields=reversal\n  invariant Program: count(row.locations)>0 and count(row.products)>0 and all(row.Reward as reward,all(reward.locations as location,location in row.locations))\n  invariant Reward: count(row.locations)>0 and all(row.locations as location,location in row.parent.locations)\n  invariant SourceEvidence: row.source==row.value.source\n  invariant Earning: row.points!=0 and trim(row.reason)!=\"\" and (row.qualification==null or row.qualification.parent==row.parent) and (row.reversal==null or (row.reversal.parent==row.parent and row.reversal.reversal==null and row.points==-row.reversal.points and row.tier==row.reversal.tier))\n  invariant Account: row.contact.parent==row.customer\n  invariant Redemption: row.cost>0 and row.reward.parent==row.parent.parent and count(row.locations)>0 and row.location in row.locations\n  lock SourceEvidence fields=source\n  lock Earning fields=source,points,reason,reversal,tier,author,qualification\n  lock Redemption fields=reward,name,instructions,locations,location,cost,source\n  fixture perks=Program {name=\"Perks\",locations=[test_site],terms=\"Enrolled customers earn points in each matching program, including cash-attributed sales\",products=[\"meeting\",\"membership\"],points_per_sale=10}\n  fixture wallet=Account {parent=perks,customer=test_company,contact=test_contact}\n  fixture balance=Earning {parent=wallet,source=\"sale:paid-booking\",points=100,reason=\"Qualified sale\",tier=true}\n  fixture welcome=Reward {parent=perks,name=\"Welcome pack\",cost=60,instructions=\"Collect at reception\",locations=[test_site]}\n  fixture remote=Location {name=\"Annex\",address=\"8 Other Street\",timezone=\"Europe/Brussels\",currency=\"EUR\",hours=\"10:00–16:00\",arrival=\"Annex reception\"}\n  fixture bronze=Tier {parent=perks,name=\"Bronze\",threshold=0}\n  fixture silver=Tier {parent=perks,name=\"Silver\",threshold=100}\n  fixture gold=Tier {parent=perks,name=\"Gold\",threshold=200}\n  fixture notice=Mail.send {request={to=\"customer@example.test\",subject=\"Reward reserved\",body=\"Collect at reception\"}}\n  fixture reservation=Redemption {parent=wallet,reward=welcome,name=\"Welcome pack\",instructions=\"Collect at reception\",locations=[test_site],location=test_site,cost=60,source=\"reserved\",notification_delivery=notice}\n  fixture observed=SourceEvidence {parent=wallet,source=\"sale\",value={source=\"sale\",revision=1,customer=test_company.id,account=self,location=test_site.id,product=\"meeting\",amount=money(100,\"EUR\"),purchased_at=datetime(\"2026-10-01T00:00:00Z\"),occurred=datetime(\"2026-10-02T00:00:00Z\"),milestone=completed,first_customer=false,history_known=false},decided=true}\n  fixture credited=Earning {parent=wallet,source=\"sale:sale\",points=10,reason=\"Qualified completed sale\",tier=true,qualification=observed}\n  fixture reversed=Earning {parent=wallet,source=\"reversal:credited\",points=-10,reason=\"Source reversal\",tier=true,qualification=observed,reversal=credited}\n When\n  crud Program by=program_owner fields=name,locations,products,terms,points_per_sale,active when=all(row.locations as location,can_work(actor,location)) delete=none\n  crud Tier by=program_owner fields=name,threshold when=all(row.parent.locations as location,can_work(actor,location)) delete=none\n  crud Reward by=program_owner fields=name,cost,instructions,locations,active when=all(row.parent.locations as location,can_work(actor,location)) delete=none\n  crud Account by=reward_staff fields=customer,contact when=all(row.parent.locations as location,can_work(actor,location)) update=none delete=none\n  # Reserve your own current reward cost only when the ledger is affordable. @{nl=\"Reserveer de huidige kosten van je eigen beloning uitsluitend wanneer het puntensaldo toereikend is.\"}\n  scenario redeem(account:Account,reward:Reward,location:Location) -> Redemption by=authenticated label=\"Reserve reward\"@{nl=\"Beloning reserveren\"}\n   require (account.contact.account==actor and account.contact.verified) and account.parent.active and reward.active and reward.parent==account.parent and account.available>=reward.cost and location in reward.locations and location in account.parent.locations\n   do\n    create Redemption {parent=account,reward,name=reward.name,instructions=reward.instructions,locations=reward.locations,location,cost=reward.cost,source=operation.id} as redemption\n    send Mail.send {to=account.contact.email,subject=format(\"Reward reserved\"@{nl=\"Beloning gereserveerd\"},locale=null),body=redemption.instructions} as notice\n    set redemption {notification_delivery=notice}\n    return redemption\n   examples seed=[balance,bronze,silver,gold] account=wallet reward=welcome location=test_site\n    as,reward.cost,wallet.contact.verified,balance.points -> wallet.available,wallet.earned,wallet.tier,wallet.tier_progress,wallet.tier_span,result.cost,result.instructions,result.location,result.notification\n    members,60,true,100 -> 40,100,silver,0,100,60,\"Collect at reception\",test_site,pending\n    members,60,true,150 -> 90,150,silver,50,100,60,\"Collect at reception\",test_site,pending\n    members,60,true,250 -> 190,250,gold,0,0,60,\"Collect at reception\",test_site,pending\n    members,40,true,50 -> 10,50,bronze,50,100,40,\"Collect at reception\",test_site,pending\n    members,101,true,100 -> error(rule_failed)\n    members,60,false,100 -> error(rule_failed)\n    members,60,true,-10 -> error(rule_failed)\n    public,60,true,100 -> error(forbidden)\n   examples seed=[balance] account=wallet reward=welcome location=test_site\n    location,reward.active,wallet.parent.active,wallet.contact.account,request.account.version -> wallet.available\n    remote,true,true,self,1 -> error(rule_failed)\n    test_site,false,true,self,1 -> error(rule_failed)\n    test_site,true,false,self,1 -> error(rule_failed)\n    test_site,true,true,other,1 -> error(rule_failed)\n    test_site,true,true,self,0 -> error(conflict)\n  # Record actual perk fulfillment; notification is not fulfillment. @{nl=\"Registreer de werkelijke uitvoering van het voordeel; een melding is geen uitvoering.\"}\n  scenario fulfill(redemption:Redemption,evidence:text) by=reward_staff label=\"Fulfill reward\"@{nl=\"Beloning uitvoeren\"}\n   require redemption.state==reserved and trim(evidence)!=\"\" and can_work(actor,redemption.location)\n   do set redemption {state=fulfilled,evidence,fulfilled_by=actor}\n   examples seed=[balance,test_worker] redemption=reservation evidence=\"Delivered at reception\"\n    as,redemption.state,welcome.cost,welcome.instructions -> reservation.cost,reservation.instructions,reservation.state,wallet.available,wallet.earned\n    reward_staff,reserved,99,\"New instructions\" -> 60,\"Collect at reception\",fulfilled,40,100\n    reward_staff,fulfilled,60,\"Collect at reception\" -> error(rule_failed)\n    members,reserved,60,\"Collect at reception\" -> error(forbidden)\n   examples seed=[test_worker] redemption=reservation evidence=\"Delivered at reception\"\n    as,test_worker.active -> reservation.state\n    reward_staff,false -> error(rule_failed)\n   examples seed=[test_worker,reservation,notice] redemption=reservation evidence=\"Delivered at reception\"\n    as,redemption.notification_delivery,notice.status,notice.result,notice.error -> reservation.notification,reservation.state\n    reward_staff,notice,pending,null,null -> pending,fulfilled\n    reward_staff,notice,succeeded,{reference=\"accepted-mail\"},null -> succeeded,fulfilled\n    reward_staff,notice,failed,null,{code=\"rejected\",message=\"Delivery rejected\"} -> failed,fulfilled\n    reward_staff,notice,unknown,null,null -> unknown,fulfilled\n    reward_staff,notice,skipped,null,null -> skipped,fulfilled\n    reward_staff,null,pending,null,null -> null,fulfilled\n  # Release the snapshotted reservation once without altering earned-tier progress. @{nl=\"Geef de vastgelegde reservering één keer vrij zonder de verdiende niveauvoortgang te veranderen.\"}\n  scenario cancel(redemption:Redemption,reason:text) by=reward_staff\n   require redemption.state==reserved and trim(reason)!=\"\" and can_work(actor,redemption.location)\n   do set redemption {state=cancelled,evidence=reason,cancelled_by=actor}\n   examples seed=[balance,test_worker] redemption=reservation reason=\"Perk unavailable\"\n    as,redemption.state,welcome.cost -> wallet.available,wallet.earned,reservation.cost,reservation.state\n    reward_staff,reserved,99 -> 100,100,60,cancelled\n    reward_staff,cancelled,60 -> error(rule_failed)\n  # Record an attributed nonzero correction; explicitly choose whether it corrects earned-tier points.\n  scenario adjust(account:Account,points:int,reason:text,tier:bool=false) by=reward_staff\n   require points!=0 and trim(reason)!=\"\" and all(account.parent.locations as location,can_work(actor,location))\n   do create Earning {parent=account,source=format(\"adjust:{id}\",{id=operation.id}),points,reason,tier,author=actor} as adjustment\n   examples seed=[balance,test_worker] account=wallet points=20 reason=\"Missed visit correction\"\n    as,points,tier,reason -> wallet.available,wallet.earned\n    reward_staff,20,false,\"Goodwill\" -> 120,100\n    reward_staff,20,true,\"Missed visit correction\" -> 120,120\n    reward_staff,0,false,\"Goodwill\" -> error(rule_failed)\n    reward_staff,20,false,\" \" -> error(rule_failed)\n    members,20,true,\"Missed visit correction\" -> error(forbidden)\n   examples seed=[test_worker] account=wallet points=20 reason=\"Goodwill\"\n    as,test_worker.active -> wallet.available\n    reward_staff,false -> error(rule_failed)\n  # Reverse one original ledger entry with a reason, preserving its immutable evidence.\n  scenario reverse(entry:Earning,reason:text) by=reward_staff\n   require entry.reversal==null and trim(reason)!=\"\" and all(entry.parent.parent.locations as location,can_work(actor,location)) and not any(entry.parent.Earning as item,item.reversal==entry)\n   do create Earning {parent=entry.parent,source=format(\"reversal:{id}\",{id=entry.id}),points=-entry.points,reason,tier=entry.tier,author=actor,qualification=entry.qualification,reversal=entry} as reversal\n   examples seed=[test_worker] entry=credited reason=\"Credit entered in error\"\n    as -> wallet.available,wallet.earned,count(wallet.Earning)\n    reward_staff -> 0,0,2\n    members -> error(forbidden)\n   examples seed=[test_worker,reversed] entry=credited reason=\"Duplicate correction\"\n    as -> wallet.available\n    reward_staff -> error(rule_failed)\n  # Retain Invoice-qualified source revisions and permanent reversal evidence for each intentional enrollment.\n  scenario earning on=Sales.qualification\n   do\n    for account in Account as row where row.customer.id==event.value.customer limit=100\n     let prior=first(account.SourceEvidence as item where item.source==event.value.source order=item.id)\n     if prior!=null\n      require prior.value.customer==event.value.customer and prior.value.account==event.value.account and prior.value.location==event.value.location and prior.value.product==event.value.product and prior.value.amount==event.value.amount and prior.value.purchased_at==event.value.purchased_at and prior.value.attribution==event.value.attribution and prior.value.exclusive_program==event.value.exclusive_program and prior.value.attributed_at==event.value.attributed_at and prior.value.attribution_window==event.value.attribution_window\n      if event.value.revision==prior.value.revision\n       require prior.value==event.value\n      if event.value.revision>prior.value.revision\n       set prior {value=event.value,reversed=prior.reversed or event.value.milestone==reversed}\n     else\n      create SourceEvidence {parent=account,source=event.value.source,value=event.value,reversed=event.value.milestone==reversed} as created\n     let evidence=first(account.SourceEvidence as item where item.source==event.value.source order=item.id)\n     require evidence!=null\n     if not evidence.decided and evidence.value.milestone==completed and not evidence.reversed\n      set evidence {decided=true}\n      if account.parent.active and evidence.value.product in account.parent.products and any(account.parent.locations as location,location.id==evidence.value.location)\n       create Earning {parent=account,source=format(\"sale:{source}\",{source=evidence.source}),points=account.parent.points_per_sale,reason=\"Qualified completed sale\",tier=true,qualification=evidence} as earning\n     if evidence.reversed\n      set evidence {decided=true}\n      let earning=first(account.Earning as item where item.qualification==evidence and item.reversal==null order=item.id)\n      if earning!=null and not any(account.Earning as item,item.reversal==earning)\n       create Earning {parent=account,source=format(\"reversal:{id}\",{id=earning.id}),points=-earning.points,reason=\"Source reversal\",tier=earning.tier,qualification=evidence,reversal=earning} as reversal\n   examples event={value={source=\"sale\",revision=1,customer=test_company.id,account=self,location=test_site.id,product=\"meeting\",amount=money(100,\"EUR\"),purchased_at=datetime(\"2026-10-01T00:00:00Z\"),occurred=datetime(\"2026-10-02T00:00:00Z\"),milestone=completed,first_customer=false,history_known=false}} seed=[wallet]\n    event.value.milestone,event.value.product,event.value.location,perks.active -> wallet.available,wallet.earned,count(wallet.SourceEvidence)\n    completed,\"meeting\",test_site.id,true -> 10,10,1\n    completed,\"membership\",test_site.id,true -> 10,10,1\n    paid,\"meeting\",test_site.id,true -> 0,0,1\n    completed,\"office\",test_site.id,true -> 0,0,1\n    completed,\"meeting\",\"other-location\",true -> 0,0,1\n    completed,\"meeting\",test_site.id,false -> 0,0,1\n    reversed,\"meeting\",test_site.id,true -> 0,0,1\n   examples seed=[wallet] event={value={source=\"sale\",revision=1,customer=test_company.id,account=self,location=test_site.id,product=\"meeting\",amount=money(100,\"EUR\"),purchased_at=datetime(\"2026-10-01T00:00:00Z\"),occurred=datetime(\"2026-10-02T00:00:00Z\"),milestone=completed,first_customer=false,history_known=false}}\n    event.value.exclusive_program,event.value.attribution,event.value.attributed_at,event.value.attribution_window -> wallet.available,wallet.earned\n    null,null,null,null -> 10,10\n    \"refer.Program:campaign\",\"share\",datetime(\"2026-09-30T00:00:00Z\"),30d -> 10,10\n    \"affiliate.Partner:partner\",\"broker\",datetime(\"2026-09-30T00:00:00Z\"),30d -> 10,10\n   examples seed=[observed] event={value=observed.value}\n    observed.value.revision,event.value.revision,observed.reversed,event.value.milestone -> wallet.available,count(wallet.Earning),observed.value.revision\n    2,1,false,completed -> 0,0,2\n    1,2,true,completed -> 0,0,2\n    1,1,false,completed -> 0,0,1\n   examples event={value={source=\"sale\",revision=1,customer=test_company.id,account=self,location=test_site.id,product=\"meeting\",amount=money(100,\"EUR\"),purchased_at=datetime(\"2026-10-01T00:00:00Z\"),occurred=datetime(\"2026-10-02T00:00:00Z\"),milestone=completed,first_customer=false,history_known=false}}\n    event.value.milestone -> count(Account),count(Earning)\n    completed -> 0,0\n   examples seed=[credited,reservation] event={value=observed.value}\n    event.value.revision,event.value.milestone,perks.active -> wallet.available,wallet.earned,count(wallet.Earning)\n    1,completed,true -> -50,10,1\n    2,reversed,false -> -60,0,2\n    1,reversed,true -> error(rule_failed)\n    0,completed,true -> error(validation)\n   examples seed=[reversed] event={value=observed.value}\n    observed.reversed,event.value.revision,event.value.milestone -> wallet.available,wallet.earned,count(wallet.Earning)\n    true,2,reversed -> 0,0,2\n    true,2,completed -> 0,0,2\n   examples seed=[credited] event={value=observed.value}\n    event.value.revision,event.value.product -> wallet.available\n    2,\"office\" -> error(rule_failed)\n Then\n  # View your point history and reserve an available manually fulfillable perk. @{nl=\"Bekijk je puntengeschiedenis en reserveer een beschikbaar handmatig uitvoerbaar voordeel.\"}\n  page /loyalty title=\"My rewards\"@{nl=\"Mijn beloningen\"}\n   require authenticated\n   ## Breadcrumbs show current declared ancestry; the shared right-sidebar shell supplies navigation, no per-app menu.\n   breadcrumbs\n   hero\n    list Account as account where account.contact.account==actor and account.contact.verified display=split empty=\"No reward account yet\"@{nl=\"Nog geen beloningsaccount\"}\n     pagination\n     stat account.available,account.earned\n     text account.tier,account.next_tier\n     text account.tier_progress,account.tier_span\n     ## Tier progress renders only when a next tier defines a positive span.\n     card \"Tier progress\"@{nl=\"Niveauvoortgang\"}\n      require account.tier_span>0\n      progress account.tier_progress max=account.tier_span\n     text \"A negative available balance means points are owed; new rewards must be affordable\"@{nl=\"Een negatief beschikbaar saldo betekent dat punten verschuldigd zijn; nieuwe beloningen moeten betaalbaar zijn\"}\n     tabs preferences.view\n      tab rewards\n       list account.parent.Reward as reward where reward.active columns=name,cost,locations empty=\"No active rewards\"@{nl=\"Geen actieve beloningen\"}\n        pagination\n        content reward.instructions\n        tooltip \"Reserve this reward\"@{nl=\"Reserveer deze beloning\"}\n         form redeem arguments={account,reward}\n       table account.Redemption columns=name,cost,location,instructions,state,evidence,notification filter=location,state defaults={location=preferences.location,state=preferences.redemption_state} display=split empty=\"No reservations yet\"@{nl=\"Nog geen reserveringen\"}\n        pagination\n        badge row.state\n        status row.notification\n        text \"A failed or uncertain notification does not cancel this reservation\"@{nl=\"Een mislukte of onzekere melding annuleert deze reservering niet\"}\n        history\n      tab history\n       timeline account.Earning\n        slot item\n         pagination\n         text row.points,row.tier\n         text row.reason,row.source\n         text row.reversal,row.author,row.qualification\n  # Fulfill or cancel reserved perks with evidence. @{nl=\"Voer gereserveerde voordelen uit of annuleer ze met bewijs.\"}\n  page /loyalty/fulfillment title=page_loyalty_fulfillment_title\n   require reward_staff\n   breadcrumbs\n   card page_loyalty_fulfillment_title\n    form Account.create\n   divider\n   card \"Evidence and history\"@{nl=\"Bewijs en geschiedenis\"}\n    table Redemption columns=parent,name,cost,location,instructions,state,evidence,fulfilled_by,cancelled_by,notification filter=location,state defaults={location=preferences.location,state=preferences.redemption_state} empty=\"No reservations match these filters\"@{nl=\"Geen reserveringen voor deze filters\"}\n     pagination\n     badge row.state\n     status row.notification\n     button opens=fulfill_detail\n     modal \"Fulfill reward\"@{nl=\"Beloning uitvoeren\"} id=fulfill_detail\n      slot content\n       form fulfill arguments={redemption=row} display=inline\n        fieldset \"Evidence\"@{nl=\"Bewijs\"}\n         label evidence\n         textarea evidence\n         validator evidence\n     button opens=cancel_detail\n     modal \"Cancel reservation\"@{nl=\"Reservering annuleren\"} id=cancel_detail\n      slot content\n       form cancel arguments={redemption=row} display=inline\n        textarea reason\n     history\n   card \"Earning review and corrections\"@{nl=\"Puntencontrole en correcties\"}\n    list Account as account display=split empty=\"No reward accounts\"@{nl=\"Geen beloningsaccounts\"}\n     pagination\n     stat account.available,account.earned\n     form adjust arguments={account}\n      fieldset \"Correction\"@{nl=\"Correctie\"}\n       input points\n       checkbox tier\n       textarea reason\n     table account.Earning columns=points,tier,reason,source,reversal,author,qualification empty=\"No points entries yet\"@{nl=\"Nog geen puntenboekingen\"}\n      pagination\n      button opens=reverse_entry\n      modal \"Reverse entry\"@{nl=\"Boeking terugdraaien\"} id=reverse_entry\n       slot content\n        form reverse arguments={entry=row} display=inline\n         textarea reason\n      history\n  # Set published program terms under the separate program-owner grant. @{nl=\"Stel gepubliceerde programmavoorwaarden vast onder het afzonderlijke programma-eigenaarsrecht.\"}\n  page /loyalty/catalog title=page_loyalty_catalog_title\n   require program_owner\n   breadcrumbs\n   card \"Program terms\"@{nl=\"Programmavoorwaarden\"}\n    form Program.create\n     fieldset \"Program terms\"@{nl=\"Programmavoorwaarden\"}\n      input name\n      textarea terms\n      input points_per_sale\n      toggle active\n    list Program display=split empty=\"No reward programs\"@{nl=\"Geen beloningsprogramma's\"}\n     pagination\n     edit\n     tabs\n      tab \"Tiers\"@{nl=\"Niveaus\"}\n       form Tier.create\n       list row.Tier empty=\"No tiers recorded\"@{nl=\"Geen niveaus vastgelegd\"}\n        pagination\n        text row.threshold\n        edit\n      tab heading_rewards\n       form Reward.create\n       list row.Reward empty=\"No rewards recorded\"@{nl=\"Geen beloningen vastgelegd\"}\n        pagination\n        text row.cost,row.active\n        edit\n"}}
