{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"29aea95be4a67623e8831784f5f3826e54b55b9610db5973af8afd88c621fe6a","before_projection_sha256":"29aea95be4a67623e8831784f5f3826e54b55b9610db5973af8afd88c621fe6a","changed":false,"idempotent":true,"structure_equal":true,"text":"# Help the workspace operator pay brokers, relocation agencies, and commercial partners for qualifying workspace sales. @{nl=\"Help de werkplekexploitant makelaars, relocatiebureaus en commerciële partners betalen voor kwalificerende werkplekverkopen.\"}\napp CanAffiliate uses=[affiliate]\n\n# Track qualified broker commissions through provider allocation and bank-payout outcomes. @{nl=\"Volg gekwalificeerde makelaarscommissies via providertoewijzing en bankuitbetaling.\"}\npackage affiliate\n use rent_catalog {Location,test_site}\n use employee {can_work,test_worker}\n use invoice {SalesV1 as Sales,Qualification} from=deployment.qualified_sales\n use affiliate {CommissionV1 as Commissions} from=deployment.commissions\n use sales_attribution {capture}\n Given\n  export contract CommissionResult { source:text label=label_CommissionResult_source, revision:int min=1, amount:money, account:text label=label_CommissionResult_account, allocation:enum(pending,unknown,allocated,failed,reversed) label={text=label_CommissionResult_allocation,values={pending=label_CommissionResult_allocation_pending,unknown=label_CommissionResult_allocation_unknown,allocated=label_CommissionResult_allocation_allocated,failed=label_CommissionResult_allocation_failed,reversed=label_CommissionResult_allocation_reversed}}, bank:enum(not_started,pending,in_transit,succeeded,failed,returned) label={text=label_CommissionResult_bank,values={pending=label_CommissionResult_allocation_pending,failed=label_CommissionResult_allocation_failed,not_started=label_CommissionResult_bank_not_started,in_transit=label_CommissionResult_bank_in_transit,succeeded=label_CommissionResult_bank_succeeded,returned=label_CommissionResult_bank_returned}}, transfer:text? label=label_CommissionResult_transfer, payout:text? label=label_CommissionResult_payout } label=\"Commission settlement outcome\"@{nl=\"Uitkomst commissieverrekening\"}\n  export contract AccountState { partner:text, account:text, revision:int min=1, state:enum(pending,action_required,ready,disabled), link:url?, expires:datetime? }\n  export capability CommissionV1 version=1\n   onboard(partner:text,account:text?,email:email) -> AccountState\n   account(partner:text,account:text) -> AccountState\n   event account_changed { value:AccountState }\n   settle(source:text,account:text,amount:money) -> CommissionResult\n   reconcile(source:text) -> CommissionResult\n   event changed { value:CommissionResult }\n  role partner_manager label=\"Partner manager\"@{nl=\"Partnerbeheerder\"}\n  role finance label=\"Finance\"@{nl=\"Financiën\"}\n  export Partner { window:duration=30d label=\"Attribution window\"@{nl=\"Toewijzingstermijn\"}, provider_revision:int=0, onboarding_delivery:text?, account_delivery:text?, onboarding_url:url?, onboarding_expires:datetime?, provider_state:AccountState.state=pending label={text=\"Provider eligibility\"@{nl=\"Providergeschiktheid\"},values={pending=\"Pending\"@{nl=\"In afwachting\"},action_required=\"Action required\"@{nl=\"Actie vereist\"},ready=\"Ready\"@{nl=\"Gereed\"},disabled=\"Disabled\"@{nl=\"Uitgeschakeld\"}}}, name:text, account:user label=label_CommissionResult_account, email:email, locations:Location[] label=\"Locations\"@{nl=\"Locaties\"}, products:text[]! label=\"Products\"@{nl=\"Producten\"}, rate:decimal min=0 max=1 label=label_Partner_rate, agreement:text label=label_Partner_agreement, milestone:enum(paid,completed,cancellation_passed) label={text=\"Qualification milestone\"@{nl=\"Kwalificatiemijlpaal\"},values={paid=\"Paid\"@{nl=\"Betaald\"},completed=\"Completed\"@{nl=\"Voltooid\"},cancellation_passed=\"Cancellation window passed\"@{nl=\"Annuleringsperiode verstreken\"}}}, provider_account:text? label=\"Provider account\"@{nl=\"Provideraccount\"}, onboarded:bool=false label=\"Provider onboarding complete\"@{nl=\"Providerregistratie voltooid\"}, active:bool=true } label=\"Partner\"@{nl=\"Partner\"}\n  SourceEvidence in Partner { source:text unique, value:Qualification, reversed:bool=false }\n  lock SourceEvidence fields=source\n  invariant SourceEvidence: not any(SourceEvidence as evidence,evidence.id!=row.id and evidence.source==row.source)\n  Sale in Partner { product:text, milestone:Partner.milestone, qualified_at:datetime, source:text unique label=label_CommissionResult_source, revision:int, customer:text label=\"Customer\"@{nl=\"Klant\"}, location:text, amount:money, rate:decimal label=label_Partner_rate, agreement:text label=label_Partner_agreement, commission:money label=\"Commission\"@{nl=\"Commissie\"}, reversed:bool=false label=label_CommissionResult_allocation_reversed } label=\"Qualified sale\"@{nl=\"Gekwalificeerde verkoop\"}\n  Adjustment in Partner { sale:Sale label=\"Sale\"@{nl=\"Verkoop\"}, amount:money, source:text unique label=label_CommissionResult_source, reason:text } label=\"Commission adjustment\"@{nl=\"Commissiecorrectie\"}\n  Settlement in Partner { last:CommissionResult?, account:text, result_revision:int=0, reconcile_delivery:text?, review:bool=false label=\"Needs finance review\"@{nl=\"Financiële beoordeling nodig\"}, source:text unique label=label_CommissionResult_source, amount:money, allocation:enum(pending,unknown,allocated,failed,reversed)=pending label={text=label_CommissionResult_allocation,values={pending=label_CommissionResult_allocation_pending,unknown=label_CommissionResult_allocation_unknown,allocated=label_CommissionResult_allocation_allocated,failed=label_CommissionResult_allocation_failed,reversed=label_CommissionResult_allocation_reversed}}, bank:enum(not_started,pending,in_transit,succeeded,failed,returned)=not_started label={text=label_CommissionResult_bank,values={pending=label_CommissionResult_allocation_pending,failed=label_CommissionResult_allocation_failed,not_started=label_CommissionResult_bank_not_started,in_transit=label_CommissionResult_bank_in_transit,succeeded=label_CommissionResult_bank_succeeded,returned=label_CommissionResult_bank_returned}}, transfer:text? label=label_CommissionResult_transfer, payout:text? label=label_CommissionResult_payout, delivery:text label=\"Delivery reference\"@{nl=\"Afleverreferentie\"} } label=\"Commission settlement\"@{nl=\"Commissieverrekening\"}\n  event AccountObserved { partner:Partner, value:AccountState }\n  event SettlementObserved { settlement:Settlement, value:CommissionResult }\n  event SettlementCheck { settlement:Settlement }\n  derive available(partner:Partner,currency:currency):money = sum(partner.Sale as sale where sale.commission.currency==currency select sale.commission,currency)+sum(partner.Adjustment as adjustment where adjustment.amount.currency==currency select adjustment.amount,currency)-sum(partner.Settlement as settlement where settlement.amount.currency==currency and settlement.allocation in [pending,unknown,allocated] select settlement.amount,currency)\n  policy Partner read=public fields=name,active\n  policy Partner read=partner_manager or finance where=all(row.locations as location,can_work(actor,location))\n  policy Partner read=authenticated where=actor.email_verified and row.account==actor fields=name,account,locations,products,rate,agreement,milestone,onboarded,active,provider_state,onboarding_url,onboarding_expires\n  policy Sale read=partner_manager or finance where=all(row.parent.locations as location,can_work(actor,location))\n  policy Sale read=authenticated where=actor.email_verified and row.parent.account==actor fields=source,location,product,milestone,qualified_at,amount,rate,agreement,commission,reversed\n  policy Adjustment read=partner_manager or finance where=all(row.parent.locations as location,can_work(actor,location))\n  policy Adjustment read=authenticated where=actor.email_verified and row.parent.account==actor\n  policy Settlement read=finance where=all(row.parent.locations as location,can_work(actor,location))\n  policy Settlement read=authenticated where=actor.email_verified and row.parent.account==actor\n  invariant Partner: row.window>0m and count(row.locations)>0 and count(row.products)>0 and trim(row.agreement)!=\"\"\n  lock Sale fields=source,customer,location,product,milestone,qualified_at,amount,rate,agreement,commission\n  lock Adjustment fields=sale,amount,source,reason\n  lock Settlement fields=source,account,amount,delivery\n  export fixture broker=Partner {name=\"Broker\",account=other,email=\"broker@example.test\",locations=[test_site],products=[\"office\"],rate=0.1,agreement=\"v1\",milestone=completed,provider_account=\"connected\",onboarded=true,provider_state=ready}\n  fixture sale=Sale {parent=broker,source=\"sale\",revision=1,customer=\"company\",location=test_site.id,product=\"office\",milestone=completed,qualified_at=datetime(\"2026-10-01T00:00:00Z\"),amount=money(1000,\"EUR\"),rate=0.1,agreement=\"v1\",commission=money(100,\"EUR\")}\n  fixture payout=Settlement {parent=broker,source=\"payout\",account=\"connected\",amount=money(100,\"EUR\"),delivery=\"transfer-delivery\"}\n  fixture attributed=SourceEvidence {parent=broker,source=\"qualified\",value={source=\"qualified\",revision=1,customer=\"company\",account=self,location=test_site.id,product=\"office\",amount=money(1000,\"EUR\"),purchased_at=datetime(\"2026-10-01T01:00:00Z\"),occurred=datetime(\"2026-10-02T00:00:00Z\"),milestone=completed,attribution=broker.id,exclusive_program=format(\"affiliate.Partner:{id}\",{id=broker.id}),attributed_at=datetime(\"2026-10-01T00:00:00Z\"),attribution_window=30d,first_customer=true,history_known=true}}\n  preferences { reversed:bool? label=label_CommissionResult_allocation_reversed }\n  message label_CommissionResult_source = \"Source reference\"@{nl=\"Bronreferentie\"}\n  message label_CommissionResult_account = \"Account\"@{nl=\"Account\"}\n  message label_CommissionResult_allocation = \"Allocation state\"@{nl=\"Toewijzingsstatus\"}\n  message label_CommissionResult_allocation_pending = \"Pending\"@{nl=\"In behandeling\"}\n  message label_CommissionResult_allocation_unknown = \"Unknown\"@{nl=\"Onbekend\"}\n  message label_CommissionResult_allocation_allocated = \"Allocated\"@{nl=\"Toegewezen\"}\n  message label_CommissionResult_allocation_failed = \"Failed\"@{nl=\"Mislukt\"}\n  message label_CommissionResult_allocation_reversed = \"Reversed\"@{nl=\"Teruggedraaid\"}\n  message label_CommissionResult_bank = \"Bank delivery\"@{nl=\"Bankuitbetaling\"}\n  message label_CommissionResult_bank_not_started = \"Not started\"@{nl=\"Niet gestart\"}\n  message label_CommissionResult_bank_in_transit = \"In transit\"@{nl=\"Onderweg\"}\n  message label_CommissionResult_bank_succeeded = \"Succeeded\"@{nl=\"Geslaagd\"}\n  message label_CommissionResult_bank_returned = \"Returned\"@{nl=\"Teruggestort\"}\n  message label_CommissionResult_transfer = \"Transfer reference\"@{nl=\"Overboekingsreferentie\"}\n  message label_CommissionResult_payout = \"Payout reference\"@{nl=\"Uitbetalingsreferentie\"}\n  message label_Partner_rate = \"Rate\"@{nl=\"Tarief\"}\n  message label_Partner_agreement = \"Agreement\"@{nl=\"Overeenkomst\"}\n When\n  crud Partner by=partner_manager fields=name,email,locations,products,rate,agreement,milestone,window,active create_fields=name,account,email,locations,products,rate,agreement,milestone,window when=all(row.locations as location,can_work(actor,location)) delete=none\n  # Reserve affordable commission while provider uncertainty remains reserved. @{nl=\"Reserveer betaalbare commissie en houd onzekere providerbedragen gereserveerd.\"}\n  scenario settle(partner:Partner,amount:money) by=finance label=\"Settle commission\"@{nl=\"Commissie verrekenen\"}\n   require all(partner.locations as location,can_work(actor,location)) and partner.active and partner.onboarded and partner.provider_state==ready and partner.provider_account!=null and amount.minor>0 and amount<=available(partner,amount.currency)\n   do\n    send Commissions.settle {source=operation.id,account=partner.provider_account,amount} as delivery\n    create Settlement {parent=partner,source=operation.id,account=partner.provider_account,amount,delivery=delivery.id} as settlement\n    schedule format(\"commission-{id}\",{id=settlement.id}) at=now+5m event=SettlementCheck {settlement}\n   examples seed=[test_worker,sale] partner=broker\n    as,amount -> available(broker,\"EUR\"),count(broker.Settlement)\n    finance,money(100,\"EUR\") -> money(0,\"EUR\"),1\n    finance,money(101,\"EUR\") -> error(rule_failed)\n    partner_manager,money(50,\"EUR\") -> error(forbidden)\n  scenario qualification on=Sales.qualification\n   do\n    for partner in Partner as row where row.id==event.value.attribution limit=1\n     require event.value.revision>0\n     require event.value.exclusive_program==format(\"affiliate.Partner:{id}\",{id=partner.id}) and event.value.account!=partner.account\n     let prior=first(partner.SourceEvidence as row where row.source==event.value.source order=row.id)\n     if prior==null\n      create SourceEvidence {parent=partner,source=event.value.source,value=event.value,reversed=event.value.milestone==reversed} as created_evidence\n     else\n      require prior.value.customer==event.value.customer and prior.value.account==event.value.account and prior.value.location==event.value.location and prior.value.product==event.value.product and prior.value.amount==event.value.amount and prior.value.purchased_at==event.value.purchased_at and prior.value.attribution==event.value.attribution and prior.value.exclusive_program==event.value.exclusive_program and prior.value.attributed_at==event.value.attributed_at and prior.value.attribution_window==event.value.attribution_window\n      if event.value.revision==prior.value.revision\n       require prior.value==event.value\n      if event.value.revision>prior.value.revision\n       set prior {value=event.value,reversed=prior.reversed or event.value.milestone==reversed}\n     let evidence=first(partner.SourceEvidence as evidence where evidence.source==event.value.source order=evidence.id)\n     require evidence!=null\n     let existing=first(partner.Sale as sale where sale.source==event.value.source order=sale.id)\n     if existing==null\n      if not evidence.reversed and event.value.revision==evidence.value.revision and event.value.milestone!=reversed\n       require partner.active and event.value.product in partner.products and any(partner.locations as location,location.id==event.value.location) and event.value.amount.minor>0 and event.value.occurred<=now and event.value.revision>0\n       if event.value.milestone==partner.milestone\n        create Sale {parent=partner,source=event.value.source,revision=event.value.revision,customer=event.value.customer,location=event.value.location,product=event.value.product,milestone=partner.milestone,qualified_at=event.value.occurred,amount=event.value.amount,rate=partner.rate,agreement=partner.agreement,commission=event.value.amount*partner.rate} as sale\n     else\n      require existing.customer==event.value.customer and existing.location==event.value.location and existing.product==event.value.product and existing.amount==event.value.amount\n      if event.value.revision>existing.revision\n       if event.value.milestone==reversed and not existing.reversed\n        create Adjustment {parent=partner,sale=existing,amount=-existing.commission,source=format(\"{source}:reversal\",{source=existing.source}),reason=\"Source disqualification\"} as adjustment\n        set existing {reversed=true}\n       set existing {revision=event.value.revision}\n   examples seed=[attributed] event={value=attributed.value}\n    attributed.reversed,event.value.revision,event.value.amount -> count(broker.Sale),available(broker,\"EUR\")\n    false,1,money(1000,\"EUR\") -> 1,money(100,\"EUR\")\n    true,2,money(1000,\"EUR\") -> 0,money(0,\"EUR\")\n    false,1,money(999,\"EUR\") -> error(rule_failed)\n   examples seed=[sale,attributed] event={value=attributed.value}\n    sale.source,event.value.revision,event.value.milestone,broker.active -> count(broker.Adjustment),available(broker,\"EUR\")\n    \"qualified\",2,reversed,false -> 1,money(0,\"EUR\")\n    \"qualified\",1,completed,true -> 0,money(100,\"EUR\")\n  # Open the verified partner's provider-hosted account flow without handling banking details. @{nl=\"Open de providerregistratie voor de geverifieerde partner zonder bankgegevens te verwerken.\"}\n  scenario onboard(partner:Partner) by=authenticated label=\"Complete provider onboarding\"@{nl=\"Providerregistratie voltooien\"}\n   require actor.email_verified and partner.account==actor and partner.active\n   do\n    send Commissions.onboard {partner=partner.id,account=partner.provider_account,email=partner.email} as delivery\n    set partner {onboarding_delivery=delivery.id,onboarding_url=null,onboarding_expires=null}\n   examples partner=broker\n    as,partner.account,partner.active -> partner.onboarding_url\n    members,self,true -> null\n    members,other,true -> error(rule_failed)\n    members,self,false -> error(rule_failed)\n  # Refresh the current provider eligibility without creating a replacement payout destination. @{nl=\"Ververs de providergeschiktheid zonder een nieuwe uitbetalingsbestemming te maken.\"}\n  scenario refresh_account(partner:Partner) by=authenticated or finance label=\"Refresh provider status\"@{nl=\"Providerstatus verversen\"}\n   require (actor.email_verified and partner.account==actor) or (finance and all(partner.locations as location,can_work(actor,location)))\n   require partner.provider_account!=null\n   do\n    send Commissions.account {partner=partner.id,account=partner.provider_account} as delivery\n    set partner {account_delivery=delivery.id}\n  scenario onboarded on=Commissions.onboard.completed\n   do\n    for partner in Partner as row where row.onboarding_delivery==event.delivery_id limit=1\n     if event.status==succeeded and event.result!=null\n      emit AccountObserved {partner,value=event.result}\n  scenario account_result on=Commissions.account.completed\n   do\n    for partner in Partner as row where row.account_delivery==event.delivery_id limit=1\n     if event.status==succeeded and event.result!=null\n      emit AccountObserved {partner,value=event.result}\n  scenario account_changed on=Commissions.account_changed\n   do\n    for partner in Partner as row where row.id==event.value.partner limit=1\n     emit AccountObserved {partner,value=event.value}\n  scenario account_observed on=AccountObserved\n   require event.value.partner==event.partner.id and (event.partner.provider_account==null or event.partner.provider_account==event.value.account)\n   require (event.value.link==null and event.value.expires==null) or (event.value.link!=null and event.value.expires!=null)\n   require event.value.revision>0\n   do\n    if event.value.revision==event.partner.provider_revision\n     require event.partner.provider_account==event.value.account and event.partner.provider_state==event.value.state and event.partner.onboarding_url==event.value.link and event.partner.onboarding_expires==event.value.expires\n    if event.value.revision>event.partner.provider_revision\n     set event.partner {provider_account=event.value.account,provider_revision=event.value.revision,provider_state=event.value.state,onboarded=event.value.state==ready,onboarding_url=event.value.link,onboarding_expires=event.value.expires}\n   examples event={partner=broker,value={partner=broker.id,account=\"connected\",revision=1,state=ready,link=null,expires=null}}\n    event.partner.provider_revision,event.value.account,event.value.revision,event.value.state -> broker.onboarded,broker.provider_revision\n    0,\"connected\",1,ready -> true,1\n    2,\"connected\",1,disabled -> true,2\n    0,\"wrong-account\",1,ready -> error(rule_failed)\n  scenario result on=Commissions.changed\n   do\n    for settlement in Settlement as row where row.source==event.value.source limit=1\n     emit SettlementObserved {settlement,value=event.value}\n  scenario settled on=Commissions.settle.completed\n   do\n    for settlement in Settlement as row where row.delivery==event.delivery_id limit=1\n     if event.status==succeeded and event.result!=null\n      emit SettlementObserved {settlement,value=event.result}\n     else\n      if settlement.result_revision==0\n       set settlement {allocation=unknown}\n  scenario reconciled on=Commissions.reconcile.completed\n   do\n    for settlement in Settlement as row where row.reconcile_delivery==event.delivery_id limit=1\n     if event.status==succeeded and event.result!=null\n      emit SettlementObserved {settlement,value=event.result}\n  scenario settlement_observed on=SettlementObserved\n   require event.value.source==event.settlement.source and event.value.amount==event.settlement.amount and event.value.account==event.settlement.account\n   require event.value.revision>0 and (event.value.allocation!=allocated or event.value.transfer!=null)\n   do\n    if event.value.revision==event.settlement.result_revision and event.settlement.last!=null\n     require event.settlement.last==event.value\n    if event.value.revision>event.settlement.result_revision\n     set event.settlement {last=event.value}\n     if event.value.allocation==failed and (event.settlement.allocation==allocated or event.settlement.transfer!=null)\n      set event.settlement {review=true,result_revision=event.value.revision,bank=event.value.bank,payout=event.value.payout}\n     else\n      set event.settlement {result_revision=event.value.revision,allocation=event.value.allocation,bank=event.value.bank,transfer=event.value.transfer,payout=event.value.payout}\n   examples seed=[sale] event={settlement=payout,value={source=\"payout\",revision=2,amount=money(100,\"EUR\"),account=\"connected\",allocation=allocated,bank=failed,transfer=\"transfer\",payout=null}}\n    event.settlement.allocation,event.settlement.transfer,event.value.allocation -> event.settlement.allocation,available(broker,\"EUR\"),event.settlement.review\n    allocated,\"transfer\",allocated -> allocated,money(0,\"EUR\"),false\n    pending,null,failed -> failed,money(100,\"EUR\"),false\n    allocated,\"transfer\",failed -> allocated,money(0,\"EUR\"),true\n  # Reconcile a settlement by its frozen identity, including later bank returns. @{nl=\"Controleer een verrekening via de vaste identiteit, ook bij latere bankretouren.\"}\n  scenario refresh_settlement(settlement:Settlement) by=authenticated or finance label=\"Refresh settlement\"@{nl=\"Verrekening verversen\"}\n   require (actor.email_verified and settlement.parent.account==actor) or (finance and all(settlement.parent.locations as location,can_work(actor,location)))\n   do\n    send Commissions.reconcile {source=settlement.source} as delivery\n    set settlement {reconcile_delivery=delivery.id}\n  scenario reconcile on=SettlementCheck\n   do\n    let settlement=event.settlement\n    if settlement.allocation in [pending,unknown] or settlement.bank in [pending,in_transit]\n     send Commissions.reconcile {source=settlement.source} as delivery\n     set settlement {reconcile_delivery=delivery.id}\n     schedule format(\"commission-{id}\",{id=settlement.id}) at=now+5m event=SettlementCheck {settlement}\n Then\n  # Maintain agreement rates and inspect source sales without repricing previous commission. @{nl=\"Beheer overeenkomsttarieven en bekijk bronverkopen zonder eerdere commissies te herberekenen.\"}\n  page /partners title=\"Partners\"@{nl=\"Partners\"}\n   require partner_manager or finance\n   ## Breadcrumbs show current declared ancestry; the shared right-sidebar shell supplies navigation, no per-app menu.\n   breadcrumbs\n   ## Explicit controls restyle declared create inputs only; unmentioned eligible inputs keep generated controls.\n   ## `active` is not in create_fields, so it has no control here.\n   card \"Partner intake\"@{nl=\"Partner aanmaken\"}\n    form Partner.create\n     textarea agreement\n     range rate\n     radio milestone\n   list Partner columns=name,agreement,rate,milestone,onboarded,active filter=active search=name display=split\n    pagination\n    ## Badge/status leaves each carry one plain readable selector with its owning caption.\n    ## The stat calls the owned available() derive (single-currency display, no cross-currency total).\n    card \"Partner terms\"@{nl=\"Partnervoorwaarden\"}\n     badge row.provider_state\n     status row.onboarded\n     edit\n      textarea agreement\n      range rate\n      radio milestone\n      checkbox active\n     text row.agreement,row.milestone\n     join\n      button action=refresh_account arguments={partner=row}\n      button opens=settle_dialog\n     modal \"Settle commission\"@{nl=\"Commissie verrekenen\"} id=settle_dialog\n      slot content\n       form settle arguments={partner=row} display=inline\n     stat\n      slot value\n       text available(row,\"EUR\")\n      slot title\n       text \"Available\"@{nl=\"Beschikbaar\"}\n    tabs\n     tab \"Sales and adjustments\"@{nl=\"Verkopen en correcties\"}\n      table row.Sale columns=source,location,amount,rate,commission,reversed filter=reversed,qualified_at,amount.currency defaults={reversed=preferences.reversed}\n       pagination\n       status row.reversed\n       collapse \"Frozen sale evidence\"@{nl=\"Vastgelegd verkoopbewijs\"}\n        text row.agreement,row.revision,row.customer\n      table row.Adjustment columns=sale,amount,reason\n       pagination\n     tab \"Allocation and bank delivery\"@{nl=\"Toewijzing en bankuitbetaling\"}\n      table row.Settlement columns=amount,allocation,bank,transfer,payout,review\n       pagination\n       badge row.allocation\n       badge row.bank\n       status row.review\n       ## Gated readable notice; alert suites take no invocation children.\n       alert\n        require row.review or row.allocation==unknown\n        text row.delivery\n       collapse \"Settlement identity\"@{nl=\"Identiteit verrekening\"}\n        text row.source,row.delivery\n        button action=refresh_settlement arguments={settlement=row}\n    history\n  # Trace only your broker terms and distinguish connected-account allocation from bank receipt. @{nl=\"Bekijk uitsluitend je makelaarsvoorwaarden en onderscheid toewijzing aan het gekoppelde account van bankontvangst.\"}\n  page /partners/mine title=\"My commissions\"@{nl=\"Mijn commissies\"}\n   require authenticated and actor.email_verified\n   breadcrumbs\n   list Partner as partner where partner.account==actor display=split\n    pagination\n    card \"Own agreement\"@{nl=\"Eigen overeenkomst\"}\n     badge row.provider_state\n     status row.onboarded\n     text row.name,row.rate,row.agreement,row.milestone\n     join\n      button action=onboard arguments={partner=row}\n      button action=refresh_account arguments={partner=row}\n     copy app_url(format(\"/partners/share/{id}\",{id=row.id}))\n     stat\n      slot value\n       text available(row,\"EUR\")\n      slot title\n       text \"Available\"@{nl=\"Beschikbaar\"}\n     ## Gate narrowed with the non-null link conjunct so `link` always receives a checked URL.\n     ## Link caption is required (no derivable destination caption).\n     card \"Provider onboarding\"@{nl=\"Providerregistratie\"}\n      require row.onboarding_expires!=null and row.onboarding_expires>now and row.onboarding_url!=null\n      text row.onboarding_url\n      link target=row.onboarding_url caption=\"Provider onboarding\"@{nl=\"Providerregistratie\"}\n    table row.Sale columns=source,location,amount,rate,agreement,commission,reversed filter=reversed,qualified_at,amount.currency defaults={reversed=preferences.reversed}\n     pagination\n     status row.reversed\n    table row.Adjustment columns=sale,amount,reason\n     pagination\n    table row.Settlement columns=amount,allocation,bank,transfer,payout,review\n     pagination\n     badge row.allocation\n     badge row.bank\n     status row.review\n     button action=refresh_settlement arguments={settlement=row}\n  # A partner link records a verified customer attribution without exposing broker terms or banking data. @{nl=\"Een partnerlink legt geverifieerde klanttoewijzing vast zonder makelaarsvoorwaarden of bankgegevens te tonen.\"}\n  page /partners/share/{Partner.id} title=\"Partner introduction\"@{nl=\"Partnerintroductie\"} nav=none\n   require row.active\n   breadcrumbs\n   ## Captionless hero avoids duplicating the page title (hero: optional caption).\n   hero\n    text row.name\n    form capture arguments={partner=row} fields=customer\n"}}
