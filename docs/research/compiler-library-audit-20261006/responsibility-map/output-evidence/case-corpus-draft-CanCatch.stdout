{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"334062d256e30a6f250c27db5f1445f46defef7ef2e734e6cafcbdab21faec37","before_projection_sha256":"334062d256e30a6f250c27db5f1445f46defef7ef2e734e6cafcbdab21faec37","changed":false,"idempotent":true,"structure_equal":true,"text":"# Help the workspace operator triage JavaScript errors in its booking, member, billing, and staff applications. @{nl=\"Help de werkplekexploitant JavaScript-fouten in boekings-, leden-, factuur- en personeelsapplicaties beoordelen.\"}\napp CanCatch uses=[catch]\ncontext\n queue ErrorJobs type=catch.ErrorWork\n\n# Queue minimized JavaScript error events and keep issue triage distinct from technical intake provisioning. @{nl=\"Zet geminimaliseerde JavaScript-foutgebeurtenissen in de wachtrij en scheid probleemtriage van technische innameconfiguratie.\"}\npackage catch\n use employee {staff,can_work,test_worker}\n use todo {Task}\n use std {DeliveryResult}\n use rent_catalog {test_site}\n use catch {AlertsV1 as Alerts} from=deployment.alerts\n use catch {IntakeV1 as ErrorIntake} from=deployment.error_intake\n Given\n  export contract Alert { source:text label=\"Source reference\"@{nl=\"Bronreferentie\"}, destination:url label=\"Destination\"@{nl=\"Bestemming\"}, message:text label=label_Alert_message } label=\"Human alert\"@{nl=\"Melding\"}\n  export contract AlertAccepted { reference:text } label=\"Alert acceptance\"@{nl=\"Melding geaccepteerd\"}\n  export capability AlertsV1 version=1\n   notify(value:Alert) -> AlertAccepted\n  role developer label=\"Developer\"@{nl=\"Ontwikkelaar\"}\n  Project { name:text, application:text label=\"Application\"@{nl=\"Applicatie\"}, viewers:user[] label=\"Authorized viewers\"@{nl=\"Bevoegde lezers\"}, active:bool=true, grouping_version:int=1 label=label_Project_grouping_version, quota:int=10000 min=1 label=\"Intake quota\"@{nl=\"Innamequotum\"}, raw_days:int=30 min=1 label=\"Raw retention days\"@{nl=\"Bewaartermijn ruwe gegevens in dagen\"}, issue_days:int=90 min=1 label=\"Issue retention days\"@{nl=\"Bewaartermijn problemen in dagen\"}, alert:url? label=\"Alert destination\"@{nl=\"Meldingsbestemming\"}, key:secret server=random_secret() } label=\"Configured project\"@{nl=\"Geconfigureerd project\"}\n  Issue in Project { task:Task? label=\"Repair task\"@{nl=\"Hersteltaak\"}, fingerprint:text label=label_Issue_fingerprint, fingerprint_version:int label=\"Fingerprint version\"@{nl=\"Versie foutvingerafdruk\"}, message:text label=label_Alert_message, environment:text? label=label_Issue_environment, owner:user? label=label_Issue_owner, state:enum(open,resolved)=open label={text=\"State\"@{nl=\"Status\"},values={open=\"Open\"@{nl=\"Open\"},resolved=\"Resolved\"@{nl=\"Opgelost\"}}}, resolved_at:datetime? label=\"Resolved at\"@{nl=\"Opgelost op\"}, last_activity:datetime label=\"Last activity\"@{nl=\"Laatste activiteit\"}, count:int=0 } label=\"Application issue\"@{nl=\"Applicatieprobleem\"}\n  Occurrence in Issue { environment:text? label=label_Issue_environment, release:text? label=label_Issue_release, event_id:text unique label=label_Occurrence_event_id, occurred:datetime, received:datetime server=now label=\"Received at\"@{nl=\"Ontvangen op\"}, message:text label=label_Alert_message, stack:text? label=label_Occurrence_stack } label=\"Error occurrence\"@{nl=\"Foutgebeurtenis\"}\n  RawPayload in Occurrence { payload:file label=label_RawPayload_payload } label=retained_raw_evidence_caption\n  Note in Issue { author:user server=actor label=\"Author\"@{nl=\"Auteur\"}, body:text trim min=1 } label=\"Triage note\"@{nl=\"Triagenotitie\"}\n  export contract ErrorWork { project:Project label=\"Project\"@{nl=\"Project\"}, event_id:text label=label_Occurrence_event_id, fingerprint:text label=label_Issue_fingerprint, grouping_version:int min=1 label=label_Project_grouping_version, occurred:datetime, message:text max=4096 label=label_Alert_message, stack:text? max=32000 label=label_Occurrence_stack, environment:text? label=label_Issue_environment, release:text? label=label_Issue_release, payload:file? label=label_RawPayload_payload } label=\"Queued error work\"@{nl=\"Foutverwerking in wachtrij\"}\n  export contract IntakeHealth { project:Project, revision:int min=1, observed:datetime, accepted:int min=0, rejected:int min=0, dropped:int min=0, processing_failed:int min=0 }\n  Health in Project { revision:int, observed:datetime, accepted:int, rejected:int, dropped:int, processing_failed:int } label=\"Capture health\"@{nl=\"Gezondheid foutregistratie\"}\n  Notice in Issue { kind:enum(new,regression) label={text=\"Alert kind\"@{nl=\"Meldingstype\"},values={new=\"New issue\"@{nl=\"Nieuw probleem\"},regression=\"Regression\"@{nl=\"Terugkeer\"}}}, destination:url, delivery:delivery(Alerts.notify)?, detail:text? label=\"Retained safe diagnostic\"@{nl=\"Bewaarde veilige diagnose\"}, occurred:datetime server=now }\n  derive Notice.outcome:DeliveryResult.status? = row.delivery?.status label=\"Alert outcome\"@{nl=\"Meldingsresultaat\"}\n  export capability IntakeV1 version=1\n   event accepted { value:ErrorWork }\n   event health { value:IntakeHealth }\n  derive Issue.release:text? = first(row.Occurrence as occurrence order=-occurrence.occurred)?.release label=label_Issue_release\n  policy Project read=developer and staff(actor) where=actor in row.viewers fields=name,application,active,grouping_version,quota,raw_days,issue_days\n  policy Issue read=developer and staff(actor) where=actor in row.parent.viewers\n  policy Occurrence read=developer and staff(actor) where=actor in row.parent.parent.viewers\n  policy RawPayload read=developer and staff(actor) where=actor in row.parent.parent.parent.viewers\n  policy Note read=developer and staff(actor) where=actor in row.parent.parent.viewers\n  policy Health read=developer and staff(actor) where=actor in row.parent.viewers\n  policy Notice read=developer and staff(actor) where=actor in row.parent.parent.viewers fields=kind,delivery.id,delivery.status,outcome,detail,occurred\n  unique Health fields=parent\n  unique Issue fields=fingerprint,fingerprint_version,environment\n  invariant Project: row.raw_days<=row.issue_days\n  retain Issue until=row.last_activity+row.parent.issue_days*1d\n  retain RawPayload until=row.parent.received+row.parent.parent.parent.raw_days*1d\n  lock Occurrence fields=event_id,occurred,received,message,stack,environment,release\n  lock RawPayload fields=payload\n  lock Note fields=author,body\n  lock Notice fields=kind,destination,occurred\n  fixture project=Project {name=\"CanDo\",application=\"Tasks\",viewers=[self]}\n  fixture open_issue=Issue {parent=project,fingerprint=\"stack\",fingerprint_version=1,message=\"Error\",last_activity=now,count=1}\n  fixture seen=Occurrence {parent=open_issue,event_id=\"seen\",occurred=now-1m,message=\"Error\"}\n  fixture raw=file {}\n  fixture health=Health {parent=project,revision=1,observed=now-2m,accepted=10,rejected=0,dropped=0,processing_failed=0}\n  fixture alert_notice=Notice {parent=open_issue,kind=new,destination=\"https://alerts.example.invalid/hook\"}\n  fixture alert_attempt=Alerts.notify {request={value={source=alert_notice.id,destination=\"https://alerts.example.invalid/hook\",message=\"New application error\"}}}\n  fixture other_attempt=Alerts.notify {request={value={source=alert_notice.id,destination=\"https://alerts.example.invalid/hook\",message=\"New application error\"}},status=failed,error={code=\"provider\",message=\"Delivery rejected\"}}\n  preferences { environment:text? label=label_Issue_environment, evidence_open:bool=false label=\"Expand retained occurrence evidence\"@{nl=\"Bewaarde foutgegevens uitklappen\"} }\n  message retained_raw_evidence_caption = \"Retained raw evidence\"@{nl=\"Bewaarde ruwe gegevens\"}\n  message label_Alert_message = \"Message\"@{nl=\"Bericht\"}\n  message label_Project_grouping_version = \"Grouping version\"@{nl=\"Groepeerversie\"}\n  message label_Issue_fingerprint = \"Error fingerprint\"@{nl=\"Foutvingerafdruk\"}\n  message label_Issue_environment = \"Environment\"@{nl=\"Omgeving\"}\n  message label_Issue_release = \"Release\"@{nl=\"Release\"}\n  message label_Issue_owner = \"Responsible person\"@{nl=\"Verantwoordelijke\"}\n  message label_Occurrence_event_id = \"External event identity\"@{nl=\"Externe gebeurtenisidentiteit\"}\n  message label_Occurrence_stack = \"Stack trace\"@{nl=\"Stacktrace\"}\n  message label_RawPayload_payload = \"Raw payload\"@{nl=\"Ruwe gegevens\"}\n When\n  # Resolve an observed issue without suppressing later genuine regressions. @{nl=\"Los een waargenomen probleem op zonder latere echte regressies te onderdrukken.\"}\n  scenario resolve(issue:Issue) by=developer label=\"Resolve issue\"@{nl=\"Probleem oplossen\"}\n   require staff(actor) and actor in issue.parent.viewers and issue.state==open\n   do set issue {state=resolved,resolved_at=now}\n   examples seed=[test_worker] issue=open_issue\n    as,issue.state -> issue.state\n    developer,open -> resolved\n    developer,resolved -> error(rule_failed)\n    members,open -> error(forbidden)\n  # Assign triage to an active work identity without changing event counts. @{nl=\"Wijs triage toe aan een actieve werkidentiteit zonder gebeurtenisaantallen te wijzigen.\"}\n  scenario assign(issue:Issue,owner:user? label=label_Issue_owner) by=developer\n   require staff(actor) and actor in issue.parent.viewers and (owner==null or (staff(owner) and developer(owner) and owner in issue.parent.viewers))\n   do set issue {owner}\n   examples seed=[test_worker] issue=open_issue\n    as,owner -> issue.owner\n    developer,self -> self\n    developer,null -> null\n    developer,other -> error(rule_failed)\n    members,self -> error(forbidden)\n  # Link an existing readable task without copying repair work into issue state. @{nl=\"Koppel een bestaande leesbare taak zonder herstelwerk in de probleemstatus te kopiëren.\"}\n  scenario link_task(issue:Issue,task:Task?) by=developer label=\"Link repair task\"@{nl=\"Hersteltaak koppelen\"}\n   require staff(actor) and actor in issue.parent.viewers and (task==null or task.location==null or can_work(actor,task.location))\n   do set issue {task}\n  crud Note by=developer fields=body update=none delete=none when=staff(actor) and actor in row.parent.parent.viewers\n  scenario accepted on=ErrorIntake.accepted\n   require event.value.project.active and event.value.grouping_version==event.value.project.grouping_version and event.value.occurred<=now+5m and event.value.occurred>=now-7d\n   do send ErrorJobs.publish {value=event.value} as queued\n  scenario process on=ErrorJobs\n   require event.project.active and event.occurred<=now+5m and event.occurred>=now-7d\n   do\n    if not any(Occurrence as occurrence,occurrence.event_id==event.event_id and occurrence.parent.parent==event.project)\n     let issue=first(event.project.Issue as issue where issue.fingerprint==event.fingerprint and issue.fingerprint_version==event.grouping_version and issue.environment==event.environment order=issue.id)\n     if issue==null\n      create Issue {parent=event.project,fingerprint=event.fingerprint,fingerprint_version=event.grouping_version,message=event.message,environment=event.environment,last_activity=now,count=1} as created_issue\n      create Occurrence {parent=created_issue,event_id=event.event_id,environment=event.environment,release=event.release,occurred=event.occurred,message=event.message,stack=event.stack} as occurrence\n      if event.payload!=null\n       create RawPayload {parent=occurrence,payload=event.payload} as raw\n      if event.project.alert!=null\n       create Notice {parent=created_issue,kind=new,destination=event.project.alert} as notice\n     else\n      create Occurrence {parent=issue,event_id=event.event_id,environment=event.environment,release=event.release,occurred=event.occurred,message=event.message,stack=event.stack} as occurrence\n      if event.payload!=null\n       create RawPayload {parent=occurrence,payload=event.payload} as raw\n      set issue {count=issue.count+1}\n      if now>issue.last_activity\n       set issue {last_activity=now}\n      if issue.state==resolved and issue.resolved_at!=null and event.occurred>issue.resolved_at\n       set issue {state=open}\n       if event.project.alert!=null\n        create Notice {parent=issue,kind=regression,destination=event.project.alert} as notice\n   examples seed=[seen] event={project=project,event_id=\"new-event\",fingerprint=\"stack\",grouping_version=1,occurred=now-1m,message=\"Error\",stack=null,environment=null,release=\"release-2\",payload=null}\n    open_issue.state,open_issue.resolved_at,event.occurred,event.event_id,event.payload -> open_issue.state,open_issue.count,count(open_issue.Occurrence),count(RawPayload)\n    open,null,now-1m,\"new-event\",raw -> open,2,2,1\n    resolved,now-2m,now-1m,\"new-event\",null -> open,2,2,0\n    resolved,now-1m,now-2m,\"new-event\",null -> resolved,2,2,0\n    open,null,now-1m,\"seen\",null -> open,1,1,0\n    open,null,now-8d,\"new-event\",null -> error(rule_failed)\n    open,null,now+6m,\"new-event\",null -> error(rule_failed)\n  scenario intake_health on=ErrorIntake.health\n   require event.value.project.active and event.value.observed<=now\n   do\n    let health=first(event.value.project.Health as health order=health.id)\n    if health==null\n     create Health {parent=event.value.project,revision=event.value.revision,observed=event.value.observed,accepted=event.value.accepted,rejected=event.value.rejected,dropped=event.value.dropped,processing_failed=event.value.processing_failed} as created\n    else\n     if event.value.revision>health.revision\n      require event.value.observed>=health.observed and event.value.accepted>=health.accepted and event.value.rejected>=health.rejected and event.value.dropped>=health.dropped and event.value.processing_failed>=health.processing_failed\n      set health {revision=event.value.revision,observed=event.value.observed,accepted=event.value.accepted,rejected=event.value.rejected,dropped=event.value.dropped,processing_failed=event.value.processing_failed}\n     else\n      if event.value.revision==health.revision\n       require event.value.observed==health.observed and event.value.accepted==health.accepted and event.value.rejected==health.rejected and event.value.dropped==health.dropped and event.value.processing_failed==health.processing_failed\n   examples seed=[health] event={value={project=project,revision=2,observed=now-1m,accepted=11,rejected=0,dropped=0,processing_failed=0}}\n    event.value.revision,event.value.observed,event.value.accepted -> health.revision,health.accepted\n    2,now-1m,11 -> 2,11\n    1,now-2m,10 -> 1,10\n    1,now-2m,11 -> error(rule_failed)\n    2,now+1m,11 -> error(rule_failed)\n  scenario notify on=Notice.created\n   do\n    for notice in Notice as row where row.id==event.id and row.delivery==null limit=1\n     if notice.kind==new\n      send Alerts.notify {value={source=notice.id,destination=notice.destination,message=format(\"New application error\"@{nl=\"Nieuwe applicatiefout\"},locale=null)}} when=notice.parent.parent.active as attempt\n      set notice {delivery=attempt}\n     else\n      send Alerts.notify {value={source=notice.id,destination=notice.destination,message=format(\"Application error regression\"@{nl=\"Applicatiefout teruggekeerd\"},locale=null)}} when=notice.parent.parent.active as attempt\n      set notice {delivery=attempt}\n  ## Status belongs to the receipt. The latest safe diagnostic retains its\n  ## independent Notice lifetime; completion without an error clears it.\n  scenario notification_result on=Alerts.notify.completed\n   do\n    let notice=first(Notice as notice where notice.delivery?.id==event.delivery_id order=notice.id)\n    if notice!=null\n     set notice {detail=event.error?.message}\n   examples seed=[alert_notice,alert_attempt] event={delivery_id=alert_attempt.id,status=unknown,result=null,error=null}\n    event.delivery_id,event.status,event.result,event.error,alert_notice.delivery,alert_notice.detail,alert_attempt.status,alert_attempt.result,alert_attempt.error -> alert_notice.outcome,alert_notice.detail,open_issue.state,open_issue.count\n    alert_attempt.id,succeeded,{reference=\"accepted\"},null,alert_attempt,null,succeeded,{reference=\"accepted\"},null -> succeeded,null,open,1\n    alert_attempt.id,failed,null,{code=\"unavailable\",message=\"Alert destination unavailable\"},alert_attempt,null,failed,null,{code=\"unavailable\",message=\"Alert destination unavailable\"} -> failed,\"Alert destination unavailable\",open,1\n    alert_attempt.id,unknown,null,null,alert_attempt,null,unknown,null,null -> unknown,null,open,1\n    alert_attempt.id,succeeded,{reference=\"accepted\"},null,alert_attempt,\"Alert destination unavailable\",succeeded,{reference=\"accepted\"},null -> succeeded,null,open,1\n    other_attempt.id,failed,null,{code=\"unavailable\",message=\"Alert destination unavailable\"},alert_attempt,\"Kept diagnostic\",pending,null,null -> pending,\"Kept diagnostic\",open,1\n Then\n  # Triage configured projects without SDK-key, quota or retention settings tools. @{nl=\"Beoordeel geconfigureerde projecten zonder instellingen voor SDK-sleutels, quota of bewaartermijnen.\"}\n  page /errors title=\"Application errors\"@{nl=\"Applicatiefouten\"}\n   require developer\n   ## Breadcrumbs show current declared ancestry; the shared right-sidebar shell supplies navigation, no per-app menu.\n   breadcrumbs\n   ## View-settings drawer: inline presentation of the same catch preferences available in the shared dialog.\n   drawer \"Triage view settings\"@{nl=\"Weergave-instellingen triage\"}\n    slot trigger\n     text \"View settings\"@{nl=\"Weergave-instellingen\"}\n    slot content\n     preferences\n      fieldset \"Triage filters\"@{nl=\"Triagefilters\"}\n       label environment\n       input environment\n       validator environment\n       label evidence_open\n       toggle evidence_open\n       validator evidence_open\n   list Project columns=name,application\n    text row.name,row.application\n    ## No open-count badge: no declared per-project open-issue count exists and badge payloads stay plain readable selectors.\n    card \"Capture health\"@{nl=\"Gezondheid foutregistratie\"}\n     table row.Health columns=observed,accepted,rejected,dropped,processing_failed\n      tooltip \"Daily accepted reports against configured quota; saturated quotas reject explicitly.\"@{nl=\"Dagelijks geaccepteerde rapporten ten opzichte van het geconfigureerde quotum; verzadigde quota worden expliciet afgewezen.\"}\n       progress row.accepted max=row.parent.quota\n      ## Quota progress is view-only; accepted/quota share int units and quota min=1 keeps max positive.\n      alert \"Rejected, dropped or failed intake needs developer review; counts are not zero errors.\"@{nl=\"Afgewezen, verwijderde of mislukte inname vereist ontwikkelaarsbeoordeling; aantallen zijn geen nul fouten.\"}\n       require row.rejected>0 or row.dropped>0 or row.processing_failed>0\n       text row.rejected,row.dropped,row.processing_failed\n     collapse \"Missing health evidence\"@{nl=\"Ontbrekend gezondheidsbewijs\"}\n      require count(row.Health)==0\n      text \"Capture health is unavailable; no events is not evidence of zero errors.\"@{nl=\"De gezondheid van foutregistratie is niet beschikbaar; geen gebeurtenissen bewijst niet dat er geen fouten zijn.\"}\n    divider \"Issues\"@{nl=\"Problemen\"}\n    table row.Issue columns=message,environment,release,count,last_activity,state,owner filter=state,environment,release defaults={environment=preferences.environment} search=message display=split\n     pagination\n     card \"Issue triage\"@{nl=\"Probleemtriage\"}\n      text row.message\n      badge row.state\n      badge row.environment\n      badge row.release\n      stat row.count\n      text row.last_activity\n      badge row.owner\n      copy row.fingerprint\n      badge row.fingerprint_version\n      countdown (row.last_activity+row.parent.issue_days*1d)-now\n      ## Retention countdown is view-only; it schedules nothing and should show explicit unavailable when out of range.\n      steps\n       slot item\n        text \"Reported\"@{nl=\"Gemeld\"}\n       slot item\n        text \"Assigned\"@{nl=\"Toegewezen\"}\n       slot item\n        text \"Resolved\"@{nl=\"Opgelost\"}\n      ## Steps are readable stages only; badges above carry the current state. No workflow is defined.\n      modal \"Resolve issue\"@{nl=\"Probleem oplossen\"}\n       slot trigger\n        text \"Resolve issue\"@{nl=\"Probleem oplossen\"}\n       slot content\n        text row.message,row.count,row.last_activity\n       slot actions\n        button action=resolve\n      ## Resolve confirmation keeps read-only context; the issue auto-binds from the row chain.\n      button opens=assign_owner\n      modal \"Assign triage owner\"@{nl=\"Triage toewijzen\"} id=assign_owner\n       slot content\n        form assign arguments={issue=row} display=inline\n         fieldset \"Triage owner\"@{nl=\"Verantwoordelijke triage\"}\n          label owner\n          select owner\n          validator owner\n          button submit=true\n      ## Owner picker uses authorized lookup only; staff/developer/viewer guards stay server-side.\n      button opens=link_repair\n      modal \"Link repair task\"@{nl=\"Hersteltaak koppelen\"} id=link_repair\n       slot content\n        form link_task arguments={issue=row} display=inline\n         fieldset \"Repair task link\"@{nl=\"Hersteltaakkoppeling\"}\n          label task\n          select task\n          validator task\n          button submit=true\n      card \"Repair task\"@{nl=\"Hersteltaak\"}\n       text row.task\n       form Task.create\n      ## Task inputs stay CanDo-owned; the bare form keeps generated controls with no copied schema.\n      form Note.create\n       fieldset \"Triage note\"@{nl=\"Triagenotitie\"}\n        label body\n        textarea body\n        validator body\n        button submit=true\n      ## Note parent auto-binds the selected issue; author/occurred stay server-owned.\n     tabs\n      tab \"Occurrence evidence\"@{nl=\"Bewijs foutgebeurtenissen\"}\n       table row.Occurrence columns=occurred,received,environment,release,message,stack order=-received filter=release\n        pagination\n        badge row.environment\n        badge row.release\n        mockup_code row.stack\n        copy row.event_id\n        collapse retained_raw_evidence_caption open=preferences.evidence_open\n         list row.RawPayload empty=\"Retained payload expired or unavailable; issue metadata remains.\"@{nl=\"Bewaarde gegevens verlopen of niet beschikbaar; probleemmetadata blijft bewaard.\"}\n          link target=row.payload caption=retained_raw_evidence_caption\n          countdown (row.parent.received+row.parent.parent.parent.raw_days*1d)-now\n         ## Raw file uses its authorized download; countdown is view-only retention remaining.\n      tab \"Alert delivery\"@{nl=\"Meldingsbezorging\"}\n       timeline row.Notice order=-occurred\n        slot item\n         badge row.kind\n         status row.outcome\n         text row.detail,row.occurred\n        ## Destination and result/error leaves stay withheld by Notice policy; kind/outcome/detail/time only.\n      tab \"Triage notes\"@{nl=\"Triagenotities\"}\n       list row.Note\n        pagination\n        chat_bubble\n         slot header\n          text row.author,row.occurred\n         slot content\n          text row.body\n        ## No avatar slot: no authorized images exist and no user directory is inferred.\n     history\n   footer \"Instrumentation, quotas, retention and alert destinations stay developer maintenance; triage changes no SDK wiring.\"@{nl=\"Instrumentatie, quota, bewaartermijnen en meldingsbestemmingen blijven ontwikkelaarsonderhoud; triage wijzigt geen SDK-koppeling.\"}\n    text \"Counts describe captured occurrences, not total transactions or guaranteed coverage.\"@{nl=\"Aantallen beschrijven vastgelegde gebeurtenissen, geen totale transacties of gegarandeerde dekking.\"}\n"}}
