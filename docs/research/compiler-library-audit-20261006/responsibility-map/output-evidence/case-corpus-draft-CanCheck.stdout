{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"dff3df6ca3948605c05bdda1c38e1c62cbe920fa67df275d44567fb94e63c105","before_projection_sha256":"dff3df6ca3948605c05bdda1c38e1c62cbe920fa67df275d44567fb94e63c105","changed":false,"idempotent":true,"structure_equal":true,"text":"# Help the workspace operator detect missed check-ins from scheduled booking reconciliation, invoice reminders, reporting imports, and maintenance jobs. @{nl=\"Help de werkplekexploitant ontbrekende signalen detecteren van geplande boekingsafstemming, factuurherinneringen, rapportimports en onderhoudstaken.\"}\napp CanCheck uses=[check]\n\n# Monitor durable heartbeat receipts without treating health as proof of successful business work. @{nl=\"Bewaak opgeslagen heartbeatontvangsten zonder gezondheid als bewijs van geslaagd bedrijfswerk te behandelen.\"}\npackage check\n use rent_catalog {Location,test_site}\n use employee {can_work,test_worker}\n use check {PingV1 as Pings} from=deployment.pings\n use catch {AlertsV1 as Alerts} from=deployment.alerts\n Given\n  export contract Heartbeat { check:text label=\"Check reference\"@{nl=\"Controlereferentie\"}, token:secret } label=\"Heartbeat receipt\"@{nl=\"Heartbeatontvangst\"}\n  export capability PingV1 version=1\n   event received { value:Heartbeat }\n  role operations label=\"Operations\"@{nl=\"Operations\"}\n  Check { name:text, application:text label=label_Check_application, purpose:text label=\"Purpose\"@{nl=\"Doel\"}, location:Location?, owner:user label=\"Responsible person\"@{nl=\"Verantwoordelijke\"}, period:duration label=\"Expected period\"@{nl=\"Verwachte periode\"}, grace:duration=0m label=\"Grace period\"@{nl=\"Respijtperiode\"}, history_days:int=90 min=1 label=\"History retention days\"@{nl=\"Bewaartermijn historie in dagen\"}, token:secret server=random_secret() unique, alert:url label=\"Alert destination\"@{nl=\"Meldingsbestemming\"}, enabled:bool=true, last_ping:datetime? label=\"Last durable heartbeat\"@{nl=\"Laatste opgeslagen heartbeat\"}, due:datetime? label=\"Next authoritative deadline\"@{nl=\"Volgende gezaghebbende deadline\"}, armed:datetime server=now label=\"Deadline anchor\"@{nl=\"Startpunt deadline\"}, revision:int=1, state:enum(new,up,late,down,paused)=new label={text=\"State\"@{nl=\"Status\"},values={new=\"Never pinged\"@{nl=\"Nog geen heartbeat\"},up=\"Up\"@{nl=\"Actief\"},late=\"Late\"@{nl=\"Te laat\"},down=\"Down\"@{nl=\"Uitgevallen\"},paused=\"Paused\"@{nl=\"Gepauzeerd\"}}} } label=\"Job check\"@{nl=\"Taakcontrole\"}\n  Transition in Check { from:Check.state label=\"From\"@{nl=\"Vanaf\"}, to:Check.state label=\"To\"@{nl=\"Naar\"}, occurred:datetime server=now } label=\"Health transition\"@{nl=\"Gezondheidsovergang\"}\n  Notice in Check { kind:enum(down,recovery,configuration), transition:Transition?, revision:int, delivery:delivery(Alerts.notify)?, detail:text? label=\"Retained safe diagnostic\"@{nl=\"Bewaarde veilige diagnose\"}, occurred:datetime server=now } label=\"Notification delivery\"@{nl=\"Meldingsbezorging\"}\n  derive Notice.outcome:DeliveryResult.status? = row.delivery?.status label=\"Notification outcome\"@{nl=\"Meldingsresultaat\"}\n  event Deadline { check:Check, revision:int }\n  policy Check read=operations where=row.location==null or can_work(actor,row.location) fields=name,application,purpose,location,owner,period,grace,enabled,last_ping,due,armed,revision,state\n  policy Transition read=operations where=row.parent.location==null or can_work(actor,row.parent.location)\n  policy Notice read=operations where=row.parent.location==null or can_work(actor,row.parent.location) fields=parent,kind,transition,revision,delivery.id,delivery.status,outcome,detail,occurred,created_by,created,updated_by,updated,archived_at\n  invariant Check: row.period>0m and row.grace>=0m and starts_with(row.alert,\"https://\")\n  lock Transition fields=from,to,occurred\n  retain Transition until=row.occurred+row.parent.history_days*1d\n  retain Notice until=row.occurred+row.parent.history_days*1d\n  lock Notice fields=kind,transition,revision,occurred\n  fixture heartbeat=Check {name=\"Reconcile\",application=\"Billing\",purpose=\"Job heartbeat\",owner=self,period=5m,alert=\"https://example.test/alert\"}\n  fixture foreign_check=Check {name=\"Import reporting\",application=\"Reporting\",purpose=\"Reporting imports\",owner=other,period=1h,alert=\"https://example.test/report-alert\"}\n  fixture notification=Notice {parent=heartbeat,kind=recovery,revision=1}\n  fixture attempt=Alerts.notify {request={value={source=notification.id,destination=heartbeat.alert,message=\"Job heartbeat recovered\"}}}\n  fixture other_attempt=Alerts.notify {request={value={source=notification.id,destination=heartbeat.alert,message=\"Job heartbeat recovered\"}},status=failed,error={code=\"provider\",message=\"Delivery rejected\"}}\n  preferences { application:text? label=label_Check_application, location:Location? }\n  invariant preferences: row.location==null or can_work(actor,row.location)\n  message label_Check_application = \"Application\"@{nl=\"Applicatie\"}\n When\n  # Pause deadlines and alerts while retaining the last durable receipt. @{nl=\"Pauzeer deadlines en meldingen met behoud van de laatst opgeslagen ontvangst.\"}\n  scenario pause(check:Check) by=operations\n   require (check.location==null or can_work(actor,check.location)) and check.enabled\n   do\n    create Transition {parent=check,from=check.state,to=paused} as transition\n    set check {enabled=false,state=paused,due=null,revision=check.revision+1}\n    cancel check.id\n   examples seed=[test_worker] check=heartbeat\n    as,check.location,check.enabled,check.state,test_worker.active -> check.enabled,check.state,check.due\n    operations,null,true,new,true -> false,paused,null\n    operations,test_site,true,new,true -> false,paused,null\n    operations,test_site,true,new,false -> error(rule_failed)\n    operations,null,false,paused,true -> error(rule_failed)\n    members,null,true,new,true -> error(forbidden)\n  # Resume with a fresh first-period deadline rather than an obsolete alarm. @{nl=\"Hervat met een nieuwe eerste-periodedeadline in plaats van een verouderd alarm.\"}\n  scenario resume(check:Check) by=operations\n   require (check.location==null or can_work(actor,check.location)) and not check.enabled\n   do\n    let revision=check.revision+1\n    let due=now+check.period+check.grace\n    create Transition {parent=check,from=check.state,to=new} as transition\n    set check {enabled=true,state=new,armed=now,due,revision}\n    schedule check.id at=due event=Deadline {check,revision}\n   examples check=heartbeat\n    as,check.enabled,check.state -> check.enabled,check.state,check.armed,check.due,check.revision\n    operations,false,paused -> true,new,now,now+5m,2\n    operations,true,up -> error(rule_failed)\n    members,false,paused -> error(forbidden)\n  scenario ping on=Pings.received\n   do\n    let check=first(Check as row where row.id==event.value.check)\n    require check!=null\n    require check.token==event.value.token\n    set check {last_ping=now}\n    if check.enabled\n     if check.state!=up\n      create Transition {parent=check,from=check.state,to=up} as transition\n      if check.state in [down,late]\n       create Notice {parent=check,kind=recovery,transition,revision=check.revision+1} as notice\n       send Alerts.notify {value={source=notice.id,destination=check.alert,message=format(\"Job heartbeat recovered\"@{nl=\"Heartbeat van taak hersteld\"},locale=null)}} when=check.enabled and check.state==up as attempt\n       set notice {delivery=attempt}\n     let revision=check.revision+1\n     let due=now+check.period\n     set check {armed=now,state=up,due,revision}\n     schedule check.id at=due event=Deadline {check,revision}\n   examples seed=[heartbeat] event={value={check=heartbeat.id,token=heartbeat.token}}\n    event.value.check,event.value.token,heartbeat.state,heartbeat.enabled -> heartbeat.state,heartbeat.last_ping,heartbeat.revision,heartbeat.due,count(heartbeat.Notice),first(heartbeat.Notice)?.outcome\n    heartbeat.id,heartbeat.token,new,true -> up,now,2,now+5m,0,null\n    heartbeat.id,heartbeat.token,down,true -> up,now,2,now+5m,1,pending\n    heartbeat.id,heartbeat.token,late,true -> up,now,2,now+5m,1,pending\n    heartbeat.id,heartbeat.token,paused,false -> paused,now,1,null,0,null\n    \"unknown\",heartbeat.token,new,true -> error(rule_failed)\n    heartbeat.id,foreign_check.token,new,true -> error(rule_failed)\n   examples seed=[notification,attempt] event={value={check=heartbeat.id,token=heartbeat.token}}\n    heartbeat.state,heartbeat.revision,notification.delivery -> heartbeat.state,heartbeat.revision,notification.outcome,count(heartbeat.Notice)\n    up,2,attempt -> up,3,pending,1\n    up,2,null -> up,3,null,1\n  ## Trusted developer maintenance admits canonical model create/update candidates\n  ## through these hooks and all owner rules; it is not enabled product CRUD.\n  scenario initial on=Check.create\n   do\n    if event.after.enabled\n     set event.after {armed=now,state=new,due=now+event.after.period+event.after.grace}\n     schedule event.after.id at=event.after.due event=Deadline {check=event.after,revision=event.after.revision}\n    else\n     set event.after {state=paused,due=null}\n  scenario configured on=Check.update\n   do\n    if event.before.name!=event.after.name or event.before.application!=event.after.application or event.before.purpose!=event.after.purpose or event.before.location!=event.after.location or event.before.owner!=event.after.owner or event.before.period!=event.after.period or event.before.grace!=event.after.grace or event.before.history_days!=event.after.history_days or event.before.token!=event.after.token or event.before.alert!=event.after.alert or event.before.enabled!=event.after.enabled\n     set event.after {revision=event.before.revision+1}\n     if event.before.period!=event.after.period or event.before.grace!=event.after.grace or event.before.enabled!=event.after.enabled\n      if event.after.enabled\n       set event.after {armed=now,state=new,due=now+event.after.period+event.after.grace}\n      else\n       set event.after {state=paused,due=null}\n      if event.before.state!=event.after.state\n       create Transition {parent=event.after,from=event.before.state,to=event.after.state} as transition\n     if event.after.enabled and event.after.due!=null\n      schedule event.after.id at=event.after.due event=Deadline {check=event.after,revision=event.after.revision}\n     else\n      cancel event.after.id\n     if event.after.enabled\n      create Notice {parent=event.after,kind=configuration,revision=event.after.revision} as notice\n      send Alerts.notify {value={source=notice.id,destination=event.after.alert,message=format(\"Job check configuration changed\"@{nl=\"Configuratie van taakcontrole gewijzigd\"},locale=null)}} when=event.after.enabled as attempt\n      set notice {delivery=attempt}\n  scenario deadline on=Deadline\n   require event.check.enabled and event.check.revision==event.revision and event.check.due!=null and now>=event.check.due\n   do\n    if now>=event.check.armed+event.check.period+event.check.grace\n     if event.check.state!=down\n      create Transition {parent=event.check,from=event.check.state,to=down} as transition\n      set event.check {state=down,due=null}\n      create Notice {parent=event.check,kind=down,transition,revision=event.check.revision} as notice\n      send Alerts.notify {value={source=notice.id,destination=event.check.alert,message=format(\"Job heartbeat missed\"@{nl=\"Heartbeat van taak ontbreekt\"},locale=null)}} when=event.check.enabled and event.check.state==down as attempt\n      set notice {delivery=attempt}\n    else\n     if event.check.state!=late\n      create Transition {parent=event.check,from=event.check.state,to=late} as transition\n     let due=event.check.armed+event.check.period+event.check.grace\n     set event.check {state=late,due}\n     schedule event.check.id at=due event=Deadline {check=event.check,revision=event.check.revision}\n   examples event={check=heartbeat,revision=1}\n    heartbeat.state,heartbeat.armed,heartbeat.grace,heartbeat.enabled,event.revision,heartbeat.due -> heartbeat.state,heartbeat.due,count(heartbeat.Notice),first(heartbeat.Notice)?.outcome\n    new,now-5m,0m,true,1,now -> down,null,1,pending\n    up,now-5m,1m,true,1,now -> late,now+1m,0,null\n    late,now-6m,1m,true,1,now -> down,null,1,pending\n    down,now-5m,0m,true,1,null -> error(rule_failed)\n    up,now,0m,true,1,now+5m -> error(rule_failed)\n    up,now-5m,0m,true,0,now -> error(rule_failed)\n    paused,now-5m,0m,false,1,null -> error(rule_failed)\n  ## Status belongs to the receipt. The latest safe diagnostic retains its\n  ## independent Notice lifetime; completion without an error clears it.\n  scenario delivered on=Alerts.notify.completed\n   do\n    let notice=first(Notice as row where row.delivery?.id==event.delivery_id)\n    require notice!=null\n    set notice {detail=event.error?.message}\n   examples seed=[notification,attempt] event={delivery_id=attempt.id,status=failed,result=null,error={code=\"provider\",message=\"Delivery rejected\"}}\n    event.delivery_id,event.status,event.result,event.error,notification.delivery,notification.detail,heartbeat.state,attempt.status,attempt.result,attempt.error -> notification.outcome,notification.detail,heartbeat.state\n    attempt.id,failed,null,{code=\"provider\",message=\"Delivery rejected\"},attempt,null,new,failed,null,{code=\"provider\",message=\"Delivery rejected\"} -> failed,\"Delivery rejected\",new\n    attempt.id,unknown,null,{code=\"provider\",message=\"Delivery rejected\"},attempt,null,new,unknown,null,{code=\"provider\",message=\"Delivery rejected\"} -> unknown,\"Delivery rejected\",new\n    attempt.id,succeeded,{reference=\"accepted-alert\"},null,attempt,\"Delivery rejected\",down,succeeded,{reference=\"accepted-alert\"},null -> succeeded,null,down\n    attempt.id,unknown,null,null,attempt,\"Delivery rejected\",late,unknown,null,null -> unknown,null,late\n    attempt.id,skipped,null,null,attempt,null,new,skipped,null,null -> skipped,null,new\n    attempt.id,failed,null,{code=\"provider\",message=\"Delivery rejected\"},attempt,\"Delivery rejected\",new,failed,null,{code=\"provider\",message=\"Delivery rejected\"} -> failed,\"Delivery rejected\",new\n    other_attempt.id,failed,null,{code=\"provider\",message=\"Delivery rejected\"},attempt,null,new,failed,null,{code=\"provider\",message=\"Delivery rejected\"} -> error(rule_failed)\n\n Then\n  # Read configured checks and perform only authorized pause and resume. @{nl=\"Lees geconfigureerde controles en voer uitsluitend toegestane pauze- en hervatacties uit.\"}\n  page /job-health title=\"Job health\"@{nl=\"Taakgezondheid\"}\n   require operations\n   breadcrumbs\n   table Check columns=name,application,location,owner,state,enabled,last_ping,due,period,grace order=name search=name filter=application,location,state defaults={application=preferences.application,location=preferences.location} display=split empty=\"No checks found\"@{nl=\"Geen controles gevonden\"}\n    card \"Current recorded health\"@{nl=\"Huidige vastgelegde gezondheid\"}\n     badge row.state\n     text row.purpose,row.application,row.location,row.owner\n     text row.enabled,row.armed,row.revision\n     text row.last_ping,row.due\n     stat row.period,row.grace\n     alert\n      require row.last_ping==null\n      text \"No heartbeat received yet. The first missed deadline marks this check down.\"@{nl=\"Nog geen heartbeat ontvangen. De eerste gemiste deadline markeert deze controle als uitgevallen.\"}\n     actions pause,resume\n    divider \"Recorded history\"@{nl=\"Vastgelegde historiek\"}\n    tabs\n     tab \"Transitions\"@{nl=\"Overgangen\"}\n      timeline row.Transition\n       slot item\n        text row.from,row.to,row.occurred\n     tab \"Notifications\"@{nl=\"Meldingen\"}\n      table row.Notice columns=kind,outcome,detail,occurred order=-occurred empty=\"No notifications yet\"@{nl=\"Nog geen meldingen\"}\n       status row.outcome\n       pagination\n    history\n    pagination\n"}}
