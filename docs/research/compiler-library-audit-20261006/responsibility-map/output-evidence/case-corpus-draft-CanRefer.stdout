{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"d610a7ba90b883cddbb3090ec3bc25dd2a4ad2328d27d73dde4dcda4a704cea5","before_projection_sha256":"d610a7ba90b883cddbb3090ec3bc25dd2a4ad2328d27d73dde4dcda4a704cea5","changed":false,"idempotent":true,"structure_equal":true,"text":"# Help workspace members and advocates earn fixed cash rewards for bringing in qualifying new workspace customers. @{nl=\"Help werkplekleden en ambassadeurs vaste geldbeloningen te verdienen voor het aanbrengen van nieuwe klanten die aan de voorwaarden voldoen.\"}\napp CanRefer uses=[refer]\n\n# Trace qualifying referral rewards and broker commissions through distinct settlement evidence. @{nl=\"Volg verwijzingsbeloningen en bemiddelingscommissies die aan de voorwaarden voldoen met afzonderlijk uitbetalingsbewijs.\"}\napp ReferralsPartners uses=[CanRefer,CanAffiliate]\n\n# Credit fixed cash referrals from trusted qualification and record evidenced manual settlement. @{nl=\"Ken vaste verwijzingsbeloningen toe op basis van vertrouwde kwalificatie en leg handmatige uitbetalingen met bewijs vast.\"}\npackage refer\n use rent_catalog {Location,test_site}\n use employee {can_work,test_worker}\n use std {EmailV1 as Mail} from=deployment.mail\n use invoice {SalesV1 as Sales,Qualification} from=deployment.qualified_sales\n use customer {test_company}\n use sales_attribution {Capture,capture}\n Given\n  preferences { program:Program? label=label_Program }\n  message balances_title = \"Earned and paid rewards\"@{nl=\"Verdiende en uitbetaalde beloningen\"}\n  message label_Program = \"Referral program\"@{nl=\"Verwijzingsprogramma\"}\n  message label_Credit = \"Reward credit\"@{nl=\"Beloningstegoed\"}\n  message label_Credit_source = \"Source reference\"@{nl=\"Bronreferentie\"}\n  message label_Settlement_paid = \"Payment date\"@{nl=\"Betaaldatum\"}\n  message label_Settlement_method = \"Payment method\"@{nl=\"Betaalmethode\"}\n  role program_manager label=\"Program manager\"@{nl=\"Programmabeheerder\"}\n  role finance label=\"Finance\"@{nl=\"Financiën\"}\n  export Program { name:text, locations:Location[] label=\"Locations\"@{nl=\"Locaties\"}, products:text[]! label=\"Products\"@{nl=\"Producten\"}, reward:money label=\"Cash reward\"@{nl=\"Geldbeloning\"}, destination:url label=\"Referral destination\"@{nl=\"Verwijzingsbestemming\"}, window:duration=30d label=\"Attribution window\"@{nl=\"Toewijzingstermijn\"}, active:bool=true } label=label_Program\n  export Advocate in Program { account:user server=actor label=\"User account\"@{nl=\"Gebruikersaccount\"}, email:email, code:text unique label=\"Referral code\"@{nl=\"Verwijzingscode\"} } label=\"Advocate\"@{nl=\"Ambassadeur\"}\n  SourceEvidence { advocate:Advocate, source:text unique label=label_Credit_source, value:Qualification, reversed:bool=false label=\"Source disqualified\"@{nl=\"Bron gediskwalificeerd\"}, reason:text? } label=\"Source qualification evidence\"@{nl=\"Bronkwalificatiebewijs\"}\n  lock Advocate fields=account,email,code\n  lock SourceEvidence fields=advocate,source\n  Credit in Advocate { source:text unique label=label_Credit_source, customer:text label=\"Customer reference\"@{nl=\"Klantreferentie\"}, amount:money, reversal:Credit? label=\"Reversal reference\"@{nl=\"Terugboekingsreferentie\"}, qualification:text label=\"Qualification evidence\"@{nl=\"Kwalificatiebewijs\"} } label=label_Credit\n  Settlement in Advocate { payment_source:text label=\"Payment source\"@{nl=\"Betaalbron\"}, source:text unique label=label_Credit_source, amount:money, reference:text, paid:date label=label_Settlement_paid, method:text label=label_Settlement_method, evidence:text, author:user server=actor label=\"Recorded by\"@{nl=\"Vastgelegd door\"} } label=\"Cash settlement\"@{nl=\"Uitbetaling\"}\n  Allocation in Settlement { credit:Credit label=label_Credit, amount:money } label=\"Payment allocation\"@{nl=\"Betalingstoewijzing\"}\n  derive Advocate.earned:money = sum(row.Credit as credit select credit.amount,row.parent.reward.currency) label=\"Earned rewards\"@{nl=\"Verdiende beloningen\"}\n  derive Advocate.paid:money = sum(row.Settlement as settlement select settlement.amount,row.parent.reward.currency) label=\"Paid rewards\"@{nl=\"Uitbetaalde beloningen\"}\n  derive Advocate.owed:money = max([money(0,row.parent.reward.currency),row.paid-row.earned]) label=\"Owed rewards\"@{nl=\"Verschuldigde beloningen\"}\n  derive Advocate.available:money = max([money(0,row.parent.reward.currency),row.earned-row.paid]) label=\"Available reward balance\"@{nl=\"Beschikbaar beloningssaldo\"}\n  policy Program read=public fields=name,reward,destination,active\n  policy Program read=program_manager or finance where=all(row.locations as location,can_work(actor,location))\n  policy Advocate read=public fields=code,parent\n  policy SourceEvidence read=program_manager or finance where=all(row.advocate.parent.locations as location,can_work(actor,location))\n  policy Advocate read=authenticated where=actor.email_verified and row.account==actor\n  policy Advocate read=program_manager or finance where=all(row.parent.locations as location,can_work(actor,location))\n  policy Credit read=authenticated where=actor.email_verified and row.parent.account==actor\n  policy Credit read=program_manager or finance where=all(row.parent.parent.locations as location,can_work(actor,location))\n  policy Settlement read=authenticated where=actor.email_verified and row.parent.account==actor\n  policy Settlement read=finance where=all(row.parent.parent.locations as location,can_work(actor,location))\n  policy Allocation read=authenticated where=actor.email_verified and row.parent.parent.account==actor\n  policy Allocation read=finance where=all(row.parent.parent.parent.locations as location,can_work(actor,location))\n  invariant Program: row.reward.minor>0 and starts_with(row.destination,\"https://\") and row.window>0m and count(row.locations)>0 and count(row.products)>0 and all(Credit as credit where credit.parent.parent==row,credit.amount.currency==row.reward.currency)\n  invariant Advocate: not any(Advocate as advocate,advocate.id!=row.id and advocate.code==row.code)\n  unique Settlement fields=payment_source,reference\n  invariant Allocation: row.amount.currency==row.credit.amount.currency and row.amount.minor>0 and row.credit.parent==row.parent.parent and sum(Allocation as allocation where allocation.credit==row.credit select allocation.amount,row.amount.currency)<=row.credit.amount\n  lock Credit fields=source,customer,amount,reversal,qualification\n  lock Settlement fields=payment_source,source,amount,reference,paid,method,evidence,author\n  lock Allocation fields=credit,amount\n  export fixture campaign=Program {name=\"Advocates\",locations=[test_site],products=[\"meeting\",\"membership\"],reward=money(100,\"EUR\"),destination=\"https://example.test/\"}\n  export fixture advocate=Advocate {parent=campaign,account=other,email=\"advocate@example.test\",code=\"share\"}\n  export fixture captured=Capture {parent=test_company,advocate,code=\"share\",program=format(\"refer.Program:{id}\",{id=campaign.id}),account=self,captured=datetime(\"2026-10-01T00:00:00Z\"),window=30d,source=\"capture\"}\n  fixture reward_paid=Settlement {parent=advocate,payment_source=\"operator-bank\",source=\"settled\",amount=money(100,\"EUR\"),reference=\"external-1\",paid=date(\"2026-10-03\"),method=\"Bank transfer\",evidence=\"Statement\"}\n  fixture earned=Credit {parent=advocate,source=\"sale\",customer=\"new-company\",amount=money(100,\"EUR\"),qualification=\"Completed paid booking\"}\n  fixture observed=SourceEvidence {advocate,source=\"sale\",value={source=\"sale\",revision=1,customer=test_company.id,account=self,location=test_site.id,product=\"meeting\",amount=money(1000,\"EUR\"),purchased_at=datetime(\"2026-10-01T01:00:00Z\"),occurred=datetime(\"2026-10-02T00:00:00Z\"),milestone=completed,attribution=\"share\",exclusive_program=format(\"refer.Program:{id}\",{id=campaign.id}),attributed_at=datetime(\"2026-10-01T00:00:00Z\"),attribution_window=30d,first_customer=true,history_known=true}}\n When\n  crud Program by=program_manager fields=name,locations,products,reward,destination,window,active when=all(row.locations as location,can_work(actor,location)) delete=none\n  # Create your verified own advocate identity and public referral code. @{nl=\"Maak je eigen geverifieerde ambassadeursidentiteit en openbare verwijzingscode aan.\"}\n  scenario join(program:Program) by=authenticated label=\"Join program\"@{nl=\"Deelnemen aan programma\"}\n   require actor.email_verified and program.active and not any(program.Advocate as advocate,advocate.account==actor)\n   do create Advocate {parent=program,email=actor.email,code=operation.id} as advocate\n  # Allocate affordable earned rewards to the same external payment evidence once. @{nl=\"Wijs betaalbare verdiende beloningen eenmalig toe aan hetzelfde externe betalingsbewijs.\"}\n  scenario settle(advocate:Advocate,amount:money,payment_source:text label=\"Payment source\"@{nl=\"Betaalbron\"},reference:text,paid:date label=label_Settlement_paid,method:text label=label_Settlement_method,evidence:text) by=finance -> Settlement label=\"Record cash settlement\"@{nl=\"Uitbetaling vastleggen\"}\n   require amount.currency==advocate.parent.reward.currency and amount.minor>0 and trim(payment_source)!=\"\" and trim(reference)!=\"\" and trim(method)!=\"\" and trim(evidence)!=\"\" and paid<=local_date(now,team.timezone) and all(advocate.parent.locations as location,can_work(actor,location))\n   do\n    let existing=first(Settlement as settlement where settlement.payment_source==payment_source and settlement.reference==reference order=settlement.id)\n    if existing!=null\n     require existing.parent==advocate and existing.amount==amount and existing.paid==paid and existing.method==method and existing.evidence==evidence\n     return existing\n    require amount<=advocate.available\n    create Settlement {parent=advocate,source=operation.id,amount,payment_source,reference,paid,method,evidence} as settlement\n    for credit in advocate.Credit as item where item.amount.minor>0 order=item.created limit=500\n     let remaining=amount-sum(settlement.Allocation as allocation select allocation.amount,amount.currency)\n     let unpaid=credit.amount-sum(Allocation as allocation where allocation.credit==credit select allocation.amount,amount.currency)\n     let part=min([remaining,unpaid])\n     if part.minor>0\n      create Allocation {parent=settlement,credit,amount=part} as allocation\n    require sum(settlement.Allocation as allocation select allocation.amount,amount.currency)==amount\n    return settlement\n   examples seed=[test_worker,earned] advocate=advocate payment_source=\"operator-bank\" reference=\"external-1\" paid=date(\"2026-10-03\") method=\"Bank transfer\" evidence=\"Statement\"\n    as,amount -> advocate.available,count(advocate.Settlement)\n    finance,money(100,\"EUR\") -> money(0,\"EUR\"),1\n    finance,money(101,\"EUR\") -> error(rule_failed)\n    program_manager,money(50,\"EUR\") -> error(forbidden)\n   examples seed=[test_worker,earned,reward_paid] advocate=advocate payment_source=\"operator-bank\" reference=\"external-1\" paid=date(\"2026-10-03\") method=\"Bank transfer\" evidence=\"Statement\"\n    as,amount -> count(advocate.Settlement)\n    finance,money(100,\"EUR\") -> 1\n    finance,money(50,\"EUR\") -> error(rule_failed)\n  scenario qualify on=Sales.qualification\n   do\n    let prior=first(SourceEvidence as candidate where candidate.source==event.value.source order=candidate.id)\n    if prior!=null\n     require prior.value.customer==event.value.customer and prior.value.account==event.value.account and prior.value.location==event.value.location and prior.value.product==event.value.product and prior.value.amount==event.value.amount and prior.value.purchased_at==event.value.purchased_at and prior.value.attribution==event.value.attribution and prior.value.exclusive_program==event.value.exclusive_program and prior.value.attributed_at==event.value.attributed_at and prior.value.attribution_window==event.value.attribution_window\n     if event.value.revision==prior.value.revision\n      require prior.value==event.value\n    for advocate in Advocate as advocate where advocate.code==event.value.attribution limit=1\n     require event.value.revision>0 and event.value.exclusive_program==format(\"refer.Program:{id}\",{id=advocate.parent.id}) and event.value.account!=advocate.account and event.value.amount.currency==advocate.parent.reward.currency\n     if prior==null\n      create SourceEvidence {advocate,source=event.value.source,value=event.value,reversed=event.value.milestone==reversed} as created_evidence\n     else\n      require prior.advocate==advocate\n      if event.value.revision>prior.value.revision\n       set prior {value=event.value,reversed=prior.reversed or event.value.milestone==reversed}\n     let evidence=first(SourceEvidence as evidence where evidence.source==event.value.source order=evidence.id)\n     require evidence!=null\n     if event.value.revision==evidence.value.revision\n      let credit=first(advocate.Credit as credit where credit.source==event.value.source and credit.reversal==null order=credit.id)\n      if credit!=null\n       require credit.customer==event.value.customer\n      if evidence.reversed or (credit!=null and (not event.value.first_customer or not event.value.history_known))\n       set evidence {reversed=true}\n       if credit!=null and not any(advocate.Credit as item,item.reversal==credit)\n        create Credit {parent=advocate,source=format(\"{source}:reversal\",{source=credit.source}),customer=credit.customer,amount=-credit.amount,reversal=credit,qualification=\"Source disqualification\"} as reversal\n      else\n       if event.value.milestone in [completed,cancellation_passed] and event.value.first_customer and event.value.history_known and credit==null\n        require advocate.parent.active and event.value.product in advocate.parent.products and any(advocate.parent.locations as location,location.id==event.value.location) and event.value.amount.minor>0 and event.value.occurred<=now\n        require any(Capture as capture,capture.parent.id==event.value.customer and capture.advocate==advocate and capture.code==event.value.attribution and capture.program==event.value.exclusive_program and capture.account==event.value.account and capture.captured==event.value.attributed_at and capture.window==event.value.attribution_window and capture.captured<=event.value.purchased_at and event.value.purchased_at<=capture.captured+capture.window and event.value.purchased_at<=event.value.occurred)\n        if not any(Credit as item,item.customer==event.value.customer and item.parent.parent==advocate.parent and item.reversal==null)\n         create Credit {parent=advocate,source=event.value.source,customer=event.value.customer,amount=advocate.parent.reward,qualification=\"Verified first paid customer and completed source\"} as credit\n         send Mail.send {to=advocate.email,subject=format(\"Referral qualified\"@{nl=\"Verwijzing gekwalificeerd\"},locale=null),body=advocate.parent.name} as notice\n   examples seed=[captured] event={value={source=\"sale\",revision=1,customer=test_company.id,account=self,location=test_site.id,product=\"meeting\",amount=money(1000,\"EUR\"),purchased_at=datetime(\"2026-10-01T01:00:00Z\"),occurred=datetime(\"2026-10-02T00:00:00Z\"),milestone=completed,attribution=\"share\",exclusive_program=format(\"refer.Program:{id}\",{id=campaign.id}),attributed_at=datetime(\"2026-10-01T00:00:00Z\"),attribution_window=30d,first_customer=true,history_known=true}}\n    event.value.first_customer,event.value.history_known,event.value.product,event.value.attributed_at -> count(advocate.Credit),advocate.available\n    true,true,\"meeting\",datetime(\"2026-10-01T00:00:00Z\") -> 1,money(100,\"EUR\")\n    false,true,\"meeting\",datetime(\"2026-10-01T00:00:00Z\") -> 0,money(0,\"EUR\")\n    true,false,\"meeting\",datetime(\"2026-10-01T00:00:00Z\") -> 0,money(0,\"EUR\")\n    true,true,\"office\",datetime(\"2026-10-01T00:00:00Z\") -> error(rule_failed)\n    true,true,\"meeting\",datetime(\"2026-09-01T00:00:00Z\") -> error(rule_failed)\n   examples seed=[earned,reward_paid] event={value={source=\"sale\",revision=2,customer=\"new-company\",account=self,location=test_site.id,product=\"meeting\",amount=money(1000,\"EUR\"),purchased_at=datetime(\"2026-10-01T01:00:00Z\"),occurred=datetime(\"2026-10-02T00:00:00Z\"),milestone=reversed,attribution=\"share\",exclusive_program=format(\"refer.Program:{id}\",{id=campaign.id}),attributed_at=datetime(\"2026-10-01T00:00:00Z\"),attribution_window=30d,first_customer=true,history_known=true}}\n    event.value.milestone -> count(advocate.Credit),advocate.available,advocate.owed,count(advocate.Settlement)\n    reversed -> 2,money(0,\"EUR\"),money(100,\"EUR\"),1\n   examples seed=[captured,observed] event={value=observed.value}\n    observed.reversed,event.value.revision,event.value.amount -> count(advocate.Credit),advocate.available\n    false,1,money(1000,\"EUR\") -> 1,money(100,\"EUR\")\n    true,2,money(1000,\"EUR\") -> 0,money(0,\"EUR\")\n    false,1,money(999,\"EUR\") -> error(rule_failed)\n   examples seed=[captured,observed,earned] event={value=observed.value}\n    earned.customer,event.value.customer -> count(advocate.Credit)\n    test_company.id,test_company.id -> 1\n    test_company.id,\"conflicting-customer\" -> error(rule_failed)\n  # Reject an attributed source with an accountable reason while preserving all payment evidence. @{nl=\"Wijs een toegewezen bron met een verantwoordbare reden af en behoud al het betalingsbewijs.\"}\n  scenario reject_source(evidence:SourceEvidence,reason:text) by=program_manager label=\"Reject source qualification\"@{nl=\"Bronkwalificatie afwijzen\"}\n   require all(evidence.advocate.parent.locations as location,can_work(actor,location)) and trim(reason)!=\"\"\n   do\n    set evidence {reversed=true,reason}\n    let credit=first(evidence.advocate.Credit as credit where credit.source==evidence.source and credit.reversal==null order=credit.id)\n    if credit!=null and not any(evidence.advocate.Credit as item,item.reversal==credit)\n     create Credit {parent=evidence.advocate,source=format(\"{source}:reversal\",{source=credit.source}),customer=credit.customer,amount=-credit.amount,reversal=credit,qualification=reason} as reversal\n   examples seed=[test_worker,observed,earned] evidence=observed reason=\"Duplicate attribution\"\n    as,reason -> evidence.reversed,count(advocate.Credit)\n    program_manager,\"Duplicate attribution\" -> true,2\n    program_manager,\"\" -> error(rule_failed)\n    finance,\"Duplicate attribution\" -> error(forbidden)\n Then\n  # Share your configured referral destination and trace earned, paid and owed balances. @{nl=\"Deel de ingestelde verwijzingsbestemming en volg verdiende, betaalde en verschuldigde saldi.\"}\n  page /referrals title=\"Referrals\"@{nl=\"Verwijzingen\"}\n   require authenticated and actor.email_verified\n   ## Breadcrumbs show current declared ancestry; the shared right-sidebar shell supplies navigation, no per-app menu.\n   breadcrumbs\n   card \"Programs and your referral code\"@{nl=\"Programma's en je verwijzingscode\"}\n    list Program\n     badge row.reward\n     ## join auto-binds the enclosing program; the canonical form opens only for missing inputs.\n     tooltip \"Join this program\"@{nl=\"Deelnemen aan dit programma\"}\n      button action=join\n    list Advocate as advocate where advocate.account==actor and (preferences.program==null or advocate.parent==preferences.program)\n     copy app_url(format(\"/referrals/share/{id}\",{id=row.id}))\n     text row.parent.destination\n     badge row.code\n     card balances_title\n      stat row.earned,row.paid,row.available,row.owed\n     ## A positive owed balance only appears after a reversal preserved a settled payment.\n     card \"Owed balance\"@{nl=\"Verschuldigd saldo\"}\n      require row.owed>money(0,row.parent.reward.currency)\n      alert\n       text row.owed\n     divider \"Evidence\"@{nl=\"Bewijs\"}\n     tabs\n      tab \"Qualification and reversal evidence\"@{nl=\"Kwalificatie- en terugboekingsbewijs\"}\n       table row.Credit columns=source,amount,reversal,qualification empty=\"No conversions yet\"@{nl=\"Nog geen conversies\"}\n        pagination\n      tab \"External payment evidence\"@{nl=\"Bewijs van externe betalingen\"}\n       table row.Settlement columns=amount,payment_source,reference,paid,method,evidence\n        pagination\n  # Review cash rewards and evidence actual external settlement. @{nl=\"Beoordeel geldbeloningen en leg bewijs van daadwerkelijke externe uitbetaling vast.\"}\n  page /referrals/work title=\"Referral rewards\"@{nl=\"Verwijzingsbeloningen\"}\n   require program_manager or finance\n   breadcrumbs\n   card \"Program maintenance\"@{nl=\"Programmabeheer\"}\n    form Program.create\n    list Program\n     badge row.reward\n     edit\n   card balances_title\n    list Advocate as advocate where preferences.program==null or advocate.parent==preferences.program\n     stat row.earned,row.paid,row.available,row.owed\n     table SourceEvidence as source where source.advocate==advocate columns=source,value.milestone,value.history_known,value.first_customer,reversed,reason\n      pagination\n      button opens=reject_dialog\n      ## The modal keeps the evidence row; reason is the only entered input.\n      modal \"Reject source qualification\"@{nl=\"Bronkwalificatie afwijzen\"} id=reject_dialog\n       slot content\n        form reject_source arguments={evidence=row} display=inline\n         textarea reason\n     card \"Record a cash settlement\"@{nl=\"Een uitbetaling vastleggen\"}\n      form settle\n       ## advocate auto-binds the enclosing advocate; amount keeps its generated money control.\n       fieldset \"Payment evidence\"@{nl=\"Betalingsbewijs\"}\n        input payment_source\n        input reference\n        input method\n        input evidence\n        calendar paid\n     ## History stays per-advocate-row as authored; the row chain already binds the advocate.\n     history\n  # A shared link discloses only its public code and configured destination; capture requires verified customer authority. @{nl=\"Een gedeelde link toont alleen de openbare code en ingestelde bestemming; vastlegging vereist geverifieerde klantbevoegdheid.\"}\n  page /referrals/share/{Advocate.id} title=\"Referral invitation\"@{nl=\"Verwijzingsuitnodiging\"} nav=none\n   require row.parent.active\n   breadcrumbs\n   hero\n    badge row.code\n    link target=row.parent.destination caption=row.parent.destination\n    form capture arguments={advocate=row} fields=customer\n     select customer\n\n# Capture one verified customer choice for either an advocate or a contracted partner. @{nl=\"Leg één geverifieerde klantkeuze vast voor een ambassadeur of een contractpartner.\"}\npackage sales_attribution\n use customer {Customer,owns,has_role,test_company,test_contact,test_admin}\n use rent_catalog {Location}\n use refer {Advocate,advocate as test_advocate}\n use affiliate {Partner,broker as test_broker}\n Given\n  export Capture in Customer { advocate:Advocate?, partner:Partner?, code:text label=\"Attribution code\"@{nl=\"Toewijzingscode\"}, program:text label=\"Exclusive program\"@{nl=\"Exclusief programma\"}, account:user server=actor, captured:datetime server=now label=\"Capture time\"@{nl=\"Vastleggingstijd\"}, window:duration label=\"Attribution window\"@{nl=\"Toewijzingstermijn\"}, source:text unique label=\"Capture reference\"@{nl=\"Vastleggingsreferentie\"} } label=\"Captured attribution\"@{nl=\"Vastgelegde toewijzing\"}\n  invariant Capture: (row.advocate!=null and row.partner==null) or (row.advocate==null and row.partner!=null)\n  lock Capture fields=advocate,partner,code,program,account,captured,window,source\n  policy Capture read=authenticated where=row.account==actor and (owns(actor,row.parent) or has_role(actor,row.parent,administrator) or has_role(actor,row.parent,booker))\n  export derive latest_capture(customer:Customer,person:user,location:Location,product:text):Capture? = first(customer.Capture as capture where capture.account==person and capture.captured+capture.window>=now and ((capture.advocate!=null and capture.advocate.parent.active and capture.advocate.account!=person and location in capture.advocate.parent.locations and product in capture.advocate.parent.products) or (capture.partner!=null and capture.partner.active and capture.partner.account!=person and location in capture.partner.locations and product in capture.partner.products)) order=-capture.captured)\n When\n  # Freeze the current origin policy only for your verified customer identity. @{nl=\"Leg het huidige bronbeleid alleen vast voor je geverifieerde klantidentiteit.\"}\n  export scenario capture(customer:Customer,advocate:Advocate?,partner:Partner?) by=authenticated -> Capture label=\"Use attribution code\"@{nl=\"Toewijzingscode gebruiken\"}\n   require actor.email_verified and customer.active\n   require owns(actor,customer) or has_role(actor,customer,administrator) or has_role(actor,customer,booker)\n   require (advocate!=null and partner==null) or (advocate==null and partner!=null)\n   do\n    if advocate!=null\n     require advocate.parent.active and advocate.account!=actor\n     create Capture {parent=customer,advocate,code=advocate.code,program=format(\"refer.Program:{id}\",{id=advocate.parent.id}),window=advocate.parent.window,source=operation.id} as captured\n     return captured\n    require partner.active and partner.account!=actor\n    create Capture {parent=customer,partner,code=partner.id,program=format(\"affiliate.Partner:{id}\",{id=partner.id}),window=partner.window,source=operation.id} as captured\n    return captured\n   examples seed=[test_contact,test_admin] advocate=test_advocate customer=test_company\n    as,advocate.account,advocate.parent.active -> count(customer.Capture)\n    members,other,true -> 1\n    members,self,true -> error(rule_failed)\n    members,other,false -> error(rule_failed)\n    public,other,true -> error(forbidden)\n   examples seed=[test_contact,test_admin] partner=test_broker customer=test_company\n    as,partner.account,partner.active -> count(customer.Capture)\n    members,other,true -> 1\n    members,self,true -> error(rule_failed)\n    members,other,false -> error(rule_failed)\n Then\n"}}
