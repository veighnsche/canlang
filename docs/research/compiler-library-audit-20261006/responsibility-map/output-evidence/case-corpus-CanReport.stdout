{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"326a9ab3b0e69b30b080169e10ba18299bb5d97e0d3c0dfa89e6aeb371694767","before_projection_sha256":"326a9ab3b0e69b30b080169e10ba18299bb5d97e0d3c0dfa89e6aeb371694767","changed":false,"idempotent":true,"structure_equal":true,"text":"# Provide a scoped operational reporting package for workspace managers and finance. @{nl=\"Bied afgebakende operationele rapportage voor werkplekbeheerders en financiële medewerkers.\"}\napp CanReport uses=[report]\n\n# Reproduce authorized operational measures from versioned sources with explicit completeness. @{nl=\"Reproduceer toegestane operationele maatstaven uit geversioneerde bronnen met expliciete volledigheid.\"}\npackage report\n use rent_catalog {Location,test_site}\n use employee {can_work,test_worker}\n use report {ReportsV1 as Reports} from=deployment.reports\n Given\n  preferences { definition:Definition? label=label_Definition }\n  message label_Checkpoint = \"Source checkpoint\"@{nl=\"Broncontrolepunt\"}\n  message label_Checkpoint_source = \"Source reference\"@{nl=\"Bronreferentie\"}\n  message label_Checkpoint_generated = \"Generated at\"@{nl=\"Gegenereerd op\"}\n  message label_Checkpoint_complete = \"Complete source coverage\"@{nl=\"Volledige brondekking\"}\n  message label_Run_pending = \"Processing pending\"@{nl=\"Verwerking in afwachting\"}\n  message label_Contribution_from = \"From\"@{nl=\"Van\"}\n  message label_Contribution_until = \"Until\"@{nl=\"Tot\"}\n  message label_Contribution_unit = \"Unit\"@{nl=\"Eenheid\"}\n  message label_ReportBatch_rows = \"Source rows\"@{nl=\"Bronregels\"}\n  message label_Definition = \"Report definition\"@{nl=\"Rapportdefinitie\"}\n  message label_Definition_inclusion = \"Inclusion rule\"@{nl=\"Meetelregel\"}\n  message label_Run_locations = \"Locations\"@{nl=\"Locaties\"}\n  export contract Checkpoint { source:text label=label_Checkpoint_source, revision:text label=\"Source revision\"@{nl=\"Bronrevisie\"}, generated:datetime label=label_Checkpoint_generated, state:enum(fresh,lagging,partial,unavailable) label={text=\"State\"@{nl=\"Status\"},values={fresh=\"Up to date\"@{nl=\"Actueel\"},lagging=\"Delayed\"@{nl=\"Vertraagd\"},partial=\"Incomplete\"@{nl=\"Onvolledig\"},unavailable=\"Unavailable\"@{nl=\"Niet beschikbaar\"}}}, complete:bool label=label_Checkpoint_complete } label=label_Checkpoint\n  export contract Contribution { source:text label=label_Checkpoint_source, revision:int, location:text, from:datetime label=label_Contribution_from, until:datetime label=label_Contribution_until, metric:enum(booked_minutes,saleable_minutes,excluded_minutes,occupied_minutes,cash,receivable,renewal,backlog) label={text=\"Metric\"@{nl=\"Maatstaf\"},values={booked_minutes=\"Booked minutes\"@{nl=\"Gereserveerde minuten\"},saleable_minutes=\"Saleable minutes\"@{nl=\"Verkoopbare minuten\"},excluded_minutes=\"Excluded minutes\"@{nl=\"Uitgesloten minuten\"},occupied_minutes=\"Occupied minutes\"@{nl=\"Werkelijk bezette minuten\"},cash=\"Cash receipts\"@{nl=\"Ontvangen betalingen\"},receivable=\"Receivables\"@{nl=\"Openstaande vorderingen\"},renewal=\"Renewals\"@{nl=\"Verlengingen\"},backlog=\"Service backlog\"@{nl=\"Werkachterstand\"}}}, quantity:decimal, unit:text label=label_Contribution_unit, amount:money?, provisional:bool=false label=\"Provisional\"@{nl=\"Voorlopig\"}, reversal:text? label=\"Reversal reference\"@{nl=\"Terugboekingsreferentie\"} } label=\"Source contribution\"@{nl=\"Bronbijdrage\"}\n  export contract ReportBatch { checkpoint:Checkpoint label=label_Checkpoint, rows:Contribution[]! label=label_ReportBatch_rows } label=\"Report batch\"@{nl=\"Rapportbatch\"}\n  export capability ReportsV1 version=1\n   reports(locations:text[],from:datetime,until:datetime) -> ReportBatch\n  role manager label=\"Reporting manager\"@{nl=\"Rapportagebeheerder\"}\n  role finance label=\"Finance\"@{nl=\"Financiën\"}\n  Definition { name:text, metric:Contribution.metric, unit:text label=label_Contribution_unit, finance_only:bool=false label=\"Finance access only\"@{nl=\"Alleen financiële toegang\"}, inclusion:text label=label_Definition_inclusion, display_timezone:timezone label=\"Reporting timezone\"@{nl=\"Rapportagetijdzone\"}, enabled:bool=true } label=label_Definition\n  Run in Definition { account:user label=\"User account\"@{nl=\"Gebruikersaccount\"}, locations:Location[]! label=label_Run_locations, from:datetime label=label_Contribution_from, until:datetime label=label_Contribution_until, currency:currency?, requested:datetime server=now label=\"Requested at\"@{nl=\"Aangevraagd op\"}, delivery:text unique label=\"Delivery reference\"@{nl=\"Verzendingsreferentie\"}, checkpoint:Checkpoint? label=label_Checkpoint, rows:Contribution[] label=label_ReportBatch_rows, state:Checkpoint.state=unavailable, pending:bool=true label=label_Run_pending } label=\"Report run\"@{nl=\"Rapportuitvoering\"}\n  contract Measure { quantity:decimal?, numerator:decimal? label=\"Numerator\"@{nl=\"Teller\"}, denominator:decimal? label=\"Denominator\"@{nl=\"Noemer\"}, value:decimal? label=\"Measure value\"@{nl=\"Meetwaarde\"}, amount:money?, state:Run.state, complete:bool=false label=label_Checkpoint_complete, pending:bool=false label=label_Run_pending, generated:datetime? label=label_Checkpoint_generated, inclusion:text label=label_Definition_inclusion, unit:text label=label_Contribution_unit } label=\"Report measure\"@{nl=\"Rapportmaatstaf\"}\n  policy Definition read=manager where=(not row.finance_only or finance) and (not (row.metric in [cash,receivable]) or finance)\n  policy Run read=manager where=row.account==actor and all(row.locations as location,can_work(actor,location)) and (not row.parent.finance_only or finance) and (not (row.parent.metric in [cash,receivable]) or finance)\n  invariant Run: row.from<row.until and count(row.locations)>0\n  lock Run fields=account,locations,from,until,currency,requested,delivery\n  fixture utilization=Definition {name=\"Utilization\",metric=booked_minutes,unit=\"room-minute\",inclusion=\"Confirmed resource minutes / saleable minutes\",display_timezone=\"Europe/Brussels\"}\n  fixture unavailable_run=Run {parent=utilization,account=self,locations=[test_site],from=datetime(\"2026-10-01T00:00:00Z\"),until=datetime(\"2026-10-02T00:00:00Z\"),delivery=\"report\",checkpoint={source=\"workspace\",revision=\"1\",generated=datetime(\"2026-10-02T01:00:00Z\"),state=fresh,complete=true},state=unavailable,pending=false}\n  fixture service_backlog=Definition {name=\"Service backlog\",metric=backlog,unit=\"job\",inclusion=\"Authoritative open service jobs\",display_timezone=\"Europe/Brussels\"}\n  fixture service_run=Run {parent=service_backlog,account=self,locations=[test_site],from=datetime(\"2026-10-01T00:00:00Z\"),until=datetime(\"2026-10-02T00:00:00Z\"),delivery=\"report\",checkpoint={source=\"workspace\",revision=\"1\",generated=datetime(\"2026-10-02T01:00:00Z\"),state=fresh,complete=true},state=unavailable,pending=false}\n When\n  # Refresh one permitted metric range without mutating the source business records. @{nl=\"Vernieuw één toegestaan meetbereik zonder de zakelijke brongegevens te wijzigen.\"}\n  scenario refresh(definition:Definition,locations:Location[] label=label_Run_locations,from:datetime label=label_Contribution_from,until:datetime label=label_Contribution_until,currency:currency?) by=manager\n   require definition.enabled and from<until and count(locations)>0 and all(locations as location,can_work(actor,location)) and (not definition.finance_only or finance) and (not (definition.metric in [cash,receivable]) or finance)\n   do\n    send Reports.reports {locations=locations as location select location.id,from,until} as delivery\n    create Run {parent=definition,account=actor,locations,from,until,currency,delivery=delivery.id} as run\n  scenario result on=Reports.reports.completed\n   do\n    for run in Run as item where item.delivery==event.delivery_id limit=1\n     if event.status==succeeded and event.result!=null\n      require all(event.result.rows as row,any(run.locations as location,location.id==row.location))\n      set run {rows=(event.result.rows as contribution where contribution.metric==run.parent.metric or (run.parent.metric==booked_minutes and contribution.metric in [saleable_minutes,excluded_minutes])),checkpoint=event.result.checkpoint,state=event.result.checkpoint.state,pending=false}\n      ## Preserve the source checkpoint; incomplete coverage cannot admit a fresh exact measure.\n      if event.result.checkpoint.state==fresh and not event.result.checkpoint.complete\n       set run {state=partial}\n     else\n      set run {state=unavailable,pending=false}\n   examples seed=[unavailable_run] event={delivery_id=\"report\",status=succeeded,result={checkpoint={source=\"workspace\",revision=\"1\",generated=datetime(\"2026-10-02T01:00:00Z\"),state=fresh,complete=true},rows=[]},error=null}\n    event.result.checkpoint.state,event.result.checkpoint.complete,unavailable_run.checkpoint,unavailable_run.pending -> unavailable_run.state,unavailable_run.checkpoint.complete,unavailable_run.pending,count(unavailable_run.rows)\n    fresh,true,null,true -> fresh,true,false,0\n    fresh,false,null,true -> partial,false,false,0\n    partial,false,null,true -> partial,false,false,0\n    lagging,true,null,true -> lagging,true,false,0\n    unavailable,false,null,true -> unavailable,false,false,0\n   examples seed=[unavailable_run] event={delivery_id=\"report\",status=failed,result=null,error={code=\"unavailable\",message=\"Report source unavailable\"}}\n    event.status,event.error,unavailable_run.checkpoint,unavailable_run.pending -> unavailable_run.state,unavailable_run.checkpoint,unavailable_run.pending\n    failed,{code=\"unavailable\",message=\"Report source unavailable\"},null,true -> unavailable,null,false\n    unknown,null,null,true -> unavailable,null,false\n  # Expose the chosen measure with denominator and missing-source state, never an invented zero. @{nl=\"Toon de gekozen maatstaf met noemer en ontbrekende-bronstatus, nooit een verzonnen nul.\"}\n  scenario measure(run:Run) read=true -> Measure by=manager label=\"Show report measure\"@{nl=\"Rapportmaatstaf tonen\"}\n   require run.account==actor and all(run.locations as location,can_work(actor,location)) and (not run.parent.finance_only or finance) and (not (run.parent.metric in [cash,receivable]) or finance)\n   do\n    if run.checkpoint==null\n     return Measure {state=unavailable,pending=run.pending,inclusion=run.parent.inclusion,unit=run.parent.unit}\n    if run.checkpoint.state==fresh and not run.checkpoint.complete\n     return Measure {state=partial,pending=run.pending,generated=run.checkpoint.generated,inclusion=run.parent.inclusion,unit=run.parent.unit}\n    if run.checkpoint.state!=fresh\n     return Measure {state=run.checkpoint.state,complete=run.checkpoint.complete,pending=run.pending,generated=run.checkpoint.generated,inclusion=run.parent.inclusion,unit=run.parent.unit}\n    if run.pending or run.state!=fresh\n     return Measure {state=run.state,complete=run.checkpoint.complete,pending=run.pending,generated=run.checkpoint.generated,inclusion=run.parent.inclusion,unit=run.parent.unit}\n    ## Empty numeric sums are exact only after fresh, complete coverage is established.\n    let selected=run.rows as row where row.metric==run.parent.metric and row.unit==run.parent.unit and row.reversal==null\n    let quantity=sum(selected as row select row.quantity)\n    if run.parent.metric==booked_minutes\n     let denominator=sum(run.rows as row where row.metric==saleable_minutes and row.unit==run.parent.unit select row.quantity)\n     if denominator==0\n      return Measure {quantity,numerator=quantity,denominator,value=null,state=run.state,complete=true,generated=run.checkpoint.generated,inclusion=run.parent.inclusion,unit=run.parent.unit}\n     return Measure {quantity,numerator=quantity,denominator,value=quantity/denominator,state=run.state,complete=true,generated=run.checkpoint.generated,inclusion=run.parent.inclusion,unit=run.parent.unit}\n    if run.currency!=null\n     return Measure {quantity,amount=sum(selected as row where row.amount!=null and row.amount.currency==run.currency select row.amount,run.currency),state=run.state,complete=true,generated=run.checkpoint.generated,inclusion=run.parent.inclusion,unit=run.parent.unit}\n    return Measure {quantity,state=run.state,complete=true,generated=run.checkpoint.generated,inclusion=run.parent.inclusion,unit=run.parent.unit}\n   examples seed=[test_worker] run=unavailable_run\n    as -> result.quantity,result.state\n    manager -> null,unavailable\n    members -> error(forbidden)\n   examples seed=[test_worker] run=unavailable_run\n    as,run.checkpoint.state,run.checkpoint.complete,run.state,run.pending -> result.quantity,result.numerator,result.denominator,result.value,result.state,result.complete,result.pending\n    manager,fresh,true,fresh,false -> 0,0,0,null,fresh,true,false\n    manager,fresh,false,fresh,false -> null,null,null,null,partial,false,false\n    manager,partial,false,partial,false -> null,null,null,null,partial,false,false\n    manager,lagging,true,lagging,false -> null,null,null,null,lagging,true,false\n    manager,unavailable,false,unavailable,false -> null,null,null,null,unavailable,false,false\n    manager,fresh,true,fresh,true -> null,null,null,null,fresh,true,true\n    manager,fresh,true,partial,false -> null,null,null,null,partial,true,false\n    members,fresh,true,fresh,false -> error(forbidden)\n   examples seed=[test_worker] run=unavailable_run\n    as,run.checkpoint,run.state -> result.quantity,result.state,result.complete,result.generated\n    manager,null,fresh -> null,unavailable,false,null\n   examples seed=[test_worker] run=service_run\n    as,run.state -> result.quantity,result.state,result.complete\n    manager,fresh -> 0,fresh,true\n   examples seed=[test_worker] run=service_run\n    as,run.state,run.checkpoint.complete,run.rows -> result.quantity,result.amount,result.state,result.complete\n    manager,fresh,false,[{source=\"job-1\",revision=1,location=test_site.id,from=unavailable_run.from,until=unavailable_run.until,metric=backlog,quantity=1,unit=\"job\"}] -> null,null,partial,false\n    manager,fresh,true,[{source=\"job-1\",revision=1,location=test_site.id,from=unavailable_run.from,until=unavailable_run.until,metric=backlog,quantity=1,unit=\"job\"}] -> 1,null,fresh,true\n Then\n  # Compare booked and recorded occupancy, cash receipts, balances and service backlog. @{nl=\"Vergelijk gereserveerde en vastgelegde bezetting, ontvangen betalingen, saldi en serviceachterstand.\"}\n  page /reports title=\"Operational reports\"@{nl=\"Operationele rapporten\"}\n   require manager\n   breadcrumbs\n   card \"Existing report definitions\"@{nl=\"Bestaande rapportdefinities\"}\n    list Definition as definition where preferences.definition==null or definition==preferences.definition empty=\"No report definitions available.\"@{nl=\"Geen rapportdefinities beschikbaar.\"}\n     pagination\n     ## Each definition keeps its prominent header with inclusion rule, unit and reporting timezone.\n     hero row.name\n      text row.inclusion,row.unit,row.display_timezone\n      form refresh\n      card \"Run checkpoints and completeness\"@{nl=\"Controlepunten en volledigheid van uitvoeringen\"}\n       list row.Run order=-requested display=split empty=\"No runs yet.\"@{nl=\"Nog geen uitvoeringen.\"}\n        pagination\n        badge row.state\n        text row.checkpoint,row.pending,row.from,row.until,row.currency\n        card \"Typed report measure\"@{nl=\"Getypeerde rapportmaatstaf\"}\n         form measure\n          metrics result.quantity,result.numerator,result.denominator,result.value,result.amount\n          ## Freshness and coverage keep explicit state presentation; quantities stay withheld, never zero-filled.\n          badge result.state\n          text result.complete,result.pending,result.generated,result.inclusion,result.unit\n          alert\n           require result.state!=fresh or not result.complete or result.pending\n           text \"Coverage is incomplete; shown quantities are withheld, never zero-filled.\"@{nl=\"De dekking is onvolledig; getoonde hoeveelheden blijven achtergehouden en worden nooit met nul gevuld.\"}\n        collapse \"Source contributions\"@{nl=\"Bronbijdragen\"}\n         table row.rows columns=source,revision,location,metric,quantity,unit,amount,provisional empty=\"No source contributions.\"@{nl=\"Geen bronbijdragen.\"}\n          pagination\n"}}
