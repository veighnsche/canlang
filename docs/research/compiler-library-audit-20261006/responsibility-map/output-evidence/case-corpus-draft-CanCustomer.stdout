{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"7ff30626eb5e0b601d3792128d8314003d1f650dbd470b7483811a407df43aa1","before_projection_sha256":"7ff30626eb5e0b601d3792128d8314003d1f650dbd470b7483811a407df43aa1","changed":false,"idempotent":true,"structure_equal":true,"text":"# Provide the workspace operator's customer identity and company-administration package. @{nl=\"Bied de klantidentiteit en het bedrijfsbeheerpakket van de werkplekexploitant.\"}\napp CanCustomer uses=[customer]\n\n# Manage customers, company roles, sales opportunities, appointments, offers and account follow-up. @{nl=\"Beheer klanten, bedrijfsrollen, verkoopkansen, afspraken, offertes en accountopvolging.\"}\napp CustomerSales uses=[CanCustomer,CanCRM,CanBook,CanPropose,CanSuccess]\n\n# Own customer identities, company roles, billing profiles and reviewed aliases. @{nl=\"Beheer klantidentiteiten, bedrijfsrollen, factuurprofielen en beoordeelde aliassen.\"}\npackage customer\n use rent_catalog {Location,test_site}\n use employee {Employee,can_work,test_worker}\n use invoice {finance}\n use std {EmailV1 as Mail} from=deployment.mail\n Given\n  role customer_manager label=\"Customer manager\"@{nl=\"Klantbeheerder\"}\n  role customer_reader label=\"Customer directory reader\"@{nl=\"Lezer klantendirectory\"}\n  role billing_reader label=\"Billing reader\"@{nl=\"Lezer factuurgegevens\"}\n  export Customer { name:text trim min=1, kind:enum(individual,company) label={text=\"Customer kind\"@{nl=\"Klantsoort\"},values={individual=\"Individual\"@{nl=\"Particulier\"},company=label_Customer_kind_company}}, locations:Location[] label=label_Customer_locations, active:bool=true } label=\"Customer\"@{nl=\"Klant\"}\n  export Contact in Customer { name:text trim min=1, email:email, account:user? label=label_Contact_account, verified:bool=false label=\"Verified\"@{nl=\"Geverifieerd\"}, phone:text?, external_id:text? label=\"External identity\"@{nl=\"Externe identiteit\"} } label=label_Contact\n  export BillingProfile in Customer { contact:Contact label=label_Contact, address:text, tax_reference:text? label=\"Tax reference\"@{nl=\"Belastingreferentie\"}, on_account:bool=false label=\"Approved on-account billing\"@{nl=\"Facturatie op rekening goedgekeurd\"}, approved_locations:Location[]=[] label=\"Approved locations\"@{nl=\"Goedgekeurde locaties\"}, approval_reason:text? label=\"Approval decision\"@{nl=\"Goedkeuringsbesluit\"}, approved_by:user? label=\"Finance decision by\"@{nl=\"Financieel besluit door\"}, approved_at:datetime? label=\"Finance decision at\"@{nl=\"Financieel besluit op\"} } label=\"Billing profile\"@{nl=\"Factuurprofiel\"}\n  export CompanyRole in Customer { account:user label=label_Contact_account, role:enum(administrator,booker,billing) label={text=label_CompanyRole_role,values={administrator=\"Administrator\"@{nl=\"Beheerder\"},booker=\"Booker\"@{nl=\"Boeker\"},billing=\"Billing\"@{nl=\"Facturatie\"}}}, locations:Location[] label=label_Customer_locations, active:bool=true } label=\"Company role\"@{nl=\"Bedrijfsrol\"}\n  export Invitation in Customer { invited_by:user server=actor label=\"Invited by\"@{nl=\"Uitgenodigd door\"}, email:email, role:CompanyRole.role, locations:Location[] label=label_Customer_locations, expires:datetime label=\"Expires at\"@{nl=\"Verloopt op\"}, status:enum(open,accepted,expired,revoked)=open label={text=\"Status\"@{nl=\"Status\"},values={open=\"Open\"@{nl=\"Open\"},accepted=\"Accepted\"@{nl=\"Geaccepteerd\"},expired=\"Expired\"@{nl=\"Verlopen\"},revoked=\"Revoked\"@{nl=\"Ingetrokken\"}}}, accepted_by:user? label=\"Accepted by\"@{nl=\"Geaccepteerd door\"} } label=notice_company_invitation\n  export Alias { from_customer:Customer label=\"Source customer\"@{nl=\"Bronklant\"}, to_customer:Customer label=label_Alias_to_customer, reason:text, approved_by:user server=actor label=\"Approved by\"@{nl=\"Goedgekeurd door\"} } label=\"Reviewed customer alias\"@{nl=\"Beoordeelde klantalias\"}\n  export event CompanyAccessChanged { customer:Customer, account:user?, revision:int }\n  event InvitationExpiry { invitation:Invitation }\n  export derive has_role(person:user,org:Customer,role:CompanyRole.role):bool = any(org.CompanyRole as grant,grant.account==person and grant.role==role and grant.active)\n  export derive has_location_role(person:user,org:Customer,role:CompanyRole.role,location:Location):bool = any(org.CompanyRole as grant,grant.account==person and grant.role==role and grant.active and location in grant.locations)\n  export derive owns(person:user,org:Customer):bool = org.kind==individual and any(org.Contact as contact,contact.account==person and contact.verified)\n  derive customer_staff(person:user,org:Customer):bool = any(org.locations as location,can_work(person,location))\n  policy Customer read=customer_reader or billing_reader where=customer_staff(actor,row) fields=name,kind,locations,active\n  policy Customer read=customer_manager and customer_staff(actor,row)\n  policy Customer read=authenticated where=owns(actor,row) or has_role(actor,row,administrator) or has_role(actor,row,booker) or has_role(actor,row,billing)\n  policy Contact read=authenticated where=actor.email_verified and row.email==actor.email fields=name,email,account,verified\n  policy Contact read=customer_reader or billing_reader where=customer_staff(actor,row.parent) fields=name,email,phone,verified\n  policy Contact read=customer_manager and customer_staff(actor,row.parent)\n  policy Contact read=authenticated where=row.account==actor or has_role(actor,row.parent,administrator)\n  policy CompanyRole read=authenticated where=row.account==actor or has_role(actor,row.parent,administrator)\n  policy CompanyRole read=customer_manager and customer_staff(actor,row.parent)\n  policy Invitation read=authenticated where=has_role(actor,row.parent,administrator) or (actor.email_verified and row.email==actor.email)\n  policy Invitation read=customer_manager and customer_staff(actor,row.parent)\n  policy Customer read=finance where=customer_staff(actor,row) fields=name,kind,locations,active\n  policy Contact read=finance where=customer_staff(actor,row.parent) fields=name,email,phone,verified\n  policy BillingProfile read=finance where=customer_staff(actor,row.parent)\n  policy BillingProfile read=billing_reader where=customer_staff(actor,row.parent)\n  policy BillingProfile read=authenticated where=owns(actor,row.parent) or has_role(actor,row.parent,billing)\n  policy BillingProfile read=customer_manager and customer_staff(actor,row.parent)\n  policy Alias read=customer_manager and customer_staff(actor,row.from_customer) and customer_staff(actor,row.to_customer)\n  invariant BillingProfile: row.contact.parent==row.parent and (not row.on_account or (count(row.approved_locations)>0 and row.approved_by!=null and row.approved_at!=null and row.approval_reason!=null))\n  invariant CompanyRole: row.parent.kind==company\n  invariant Alias: row.from_customer!=row.to_customer\n  unique CompanyRole fields=account,role\n  lock Invitation fields=invited_by,email,role,locations,expires\n  lock Alias fields=from_customer,to_customer,reason,approved_by\n  export fixture test_directory_manager=user {roles=[customer_manager]}\n  export fixture test_directory_employee=Employee {user=test_directory_manager,home=test_site,locations=[test_site],start=date(\"2026-10-01\"),role=\"directory operator\"}\n  export fixture test_company=Customer {name=\"Example company\",kind=company,locations=[test_site]}\n  export fixture test_contact=Contact {parent=test_company,name=\"Example contact\",email=\"customer@example.test\",account=self,verified=true}\n  export fixture test_admin=CompanyRole {parent=test_company,account=self,role=administrator,locations=[test_site]}\n  export fixture test_billing=CompanyRole {parent=test_company,account=self,role=billing,locations=[test_site]}\n  export fixture test_booker=CompanyRole {parent=test_company,account=other,role=booker,locations=[test_site]}\n  fixture billing_profile=BillingProfile {parent=test_company,contact=test_contact,address=\"Example address\"}\n  fixture company_invitation=Invitation {parent=test_company,email=actor.email,role=booker,locations=[test_site],expires=now+7d}\n  fixture duplicate_company=Customer {name=\"Example company\",kind=company,locations=[test_site]}\n  fixture reviewed_alias=Alias {from_customer=duplicate_company,to_customer=test_company,reason=\"Reviewed duplicate\"}\n  preferences { kind:Customer.kind?, active:bool? }\n  message notice_company_invitation = \"Company invitation\"@{nl=\"Bedrijfsuitnodiging\"}\n  message label_Customer_kind_company = \"Company\"@{nl=\"Bedrijf\"}\n  message label_Customer_locations = \"Locations\"@{nl=\"Locaties\"}\n  message label_Contact = \"Contact\"@{nl=\"Contactpersoon\"}\n  message label_Contact_account = \"Account\"@{nl=\"Account\"}\n  message label_CompanyRole_role = \"Role\"@{nl=\"Rol\"}\n  message label_Alias_to_customer = \"Target customer\"@{nl=\"Doelklant\"}\n When\n  crud Customer by=customer_manager fields=name,locations,active create_fields=name,kind,locations when=customer_staff(actor,row)\n  crud Contact by=customer_manager fields=name,email,phone,external_id when=customer_staff(actor,row.parent)\n  crud BillingProfile by=customer_manager fields=contact,address,tax_reference when=customer_staff(actor,row.parent)\n  ## An edited email is a new identity claim; the previous proof/account is historical, not proof for the replacement.\n  scenario contact_email_changed on=Contact.update\n   do\n    if event.before.email!=event.after.email\n     set event.after {account=null,verified=false}\n  # Find readable same-kind company candidates without merging identities. @{nl=\"Vind leesbare bedrijfskandidaten van dezelfde soort zonder identiteiten samen te voegen.\"}\n  export scenario duplicate_customers(name:Customer.name,kind:Customer.kind) read=true -> Customer[] by=customer_manager\n   do return Customer archived=include as candidate where candidate.kind==kind and lower(candidate.name)==lower(name)\n   examples seed=[test_worker,test_company] kind=company\n    as,name -> count(result)\n    customer_manager,\"example company\" -> 1\n    customer_manager,\"Different company\" -> 0\n  # Review exact contact-email candidates under current directory grants. @{nl=\"Beoordeel kandidaten met hetzelfde contactadres onder de huidige directoryrechten.\"}\n  export scenario duplicate_contacts(email:Contact.email) read=true -> Contact[] by=customer_manager\n   do return Contact archived=include as candidate where candidate.email==email\n   examples seed=[test_worker,test_contact]\n    as,email -> count(result)\n    customer_manager,\"customer@example.test\" -> 1\n    customer_manager,\"new@example.test\" -> 0\n  # Approve or revoke invoicing at explicitly reviewed customer locations. @{nl=\"Keur facturatie op expliciet beoordeelde klantlocaties goed of trek deze in.\"}\n  export scenario approve_account(profile:BillingProfile,approve:bool,locations:Location[],reason:text) by=finance label=\"Review on-account eligibility\"@{nl=\"Geschiktheid voor facturatie op rekening beoordelen\"}\n   require profile.parent.active and trim(reason)!=\"\" and customer_staff(actor,profile.parent)\n   require all(locations as location,location in profile.parent.locations and can_work(actor,location))\n   require all(profile.approved_locations as location,can_work(actor,location)) and (not approve or count(locations)>0)\n   do\n    if approve\n     set profile {on_account=true,approved_locations=locations,approval_reason=reason,approved_by=actor,approved_at=now}\n    else\n     set profile {on_account=false,approved_locations=[],approval_reason=reason,approved_by=actor,approved_at=now}\n   examples seed=[test_worker] profile=billing_profile locations=[test_site] reason=\"Finance reviewed\"\n    as,approve -> profile.on_account\n    finance,true -> true\n    finance,false -> false\n    customer_manager,true -> error(forbidden)\n  # Claim only a contact addressed to your own verified account. @{nl=\"Koppel alleen een contact dat aan je eigen geverifieerde account is gericht.\"}\n  export scenario claim(contact:Contact) by=authenticated label=\"Claim own contact\"@{nl=\"Eigen contact koppelen\"}\n   require actor.email_verified and contact.email==actor.email and contact.parent.active and contact.account==null\n   do set contact {account=actor,verified=true}\n   examples seed=[test_directory_employee,test_contact]\n    do\n     call Contact.update {record=test_contact,changes={name=\"Updated contact\",phone=\"+32000000000\"}} by=test_directory_manager\n     test_contact.account,test_contact.verified -> self,true\n     call Contact.update {record=test_contact,changes={email=\"replacement@example.test\"}} by=test_directory_manager\n     test_contact.account,test_contact.verified -> null,false\n     call claim {contact=test_contact} by=self -> error(rule_failed)\n     test_contact.account,test_contact.verified -> null,false\n  # Invite a colleague to an explicit company role without creating a paid seat. @{nl=\"Nodig een collega uit voor een expliciete bedrijfsrol zonder een betaalde plaats aan te maken.\"}\n  export scenario invite(org:Customer label=label_Customer_kind_company,email:email,role:CompanyRole.role label=label_CompanyRole_role,locations:Location[] label=label_Customer_locations) by=authenticated label=\"Invite company colleague\"@{nl=\"Bedrijfscollega uitnodigen\"}\n   require actor.email_verified and org.active and org.kind==company and has_role(actor,org,administrator)\n   require all(locations as location,location in org.locations and has_location_role(actor,org,administrator,location))\n   do\n    create Invitation {parent=org,email,role,locations,expires=now+7d} as invitation\n    schedule invitation.id at=invitation.expires event=InvitationExpiry {invitation}\n    send Mail.send {to=email,subject=format(notice_company_invitation,locale=null),body=format(\"Sign in with your verified email to review your company invitation.\"@{nl=\"Meld je aan met je geverifieerde e-mailadres om je bedrijfsuitnodiging te bekijken.\"},locale=null)} as notice\n  # Accept an addressed, unexpired invitation using the current verified account. @{nl=\"Accepteer een gerichte, niet-verlopen uitnodiging met het huidige geverifieerde account.\"}\n  export scenario accept(invitation:Invitation) by=authenticated label=\"Accept invitation\"@{nl=\"Uitnodiging accepteren\"}\n   require actor.email_verified and invitation.email==actor.email and invitation.status==open and invitation.expires>now and invitation.parent.active\n   require has_role(invitation.invited_by,invitation.parent,administrator) and all(invitation.locations as location,location in invitation.parent.locations and has_location_role(invitation.invited_by,invitation.parent,administrator,location))\n   require not any(invitation.parent.CompanyRole as grant,grant.account==actor and grant.role==invitation.role and grant.active)\n   do\n    let previous=first(invitation.parent.CompanyRole as grant where grant.account==actor and grant.role==invitation.role order=grant.id)\n    if previous==null\n     create CompanyRole {parent=invitation.parent,account=actor,role=invitation.role,locations=invitation.locations} as grant\n    else\n     set previous {active=true,locations=invitation.locations}\n    set invitation {status=accepted,accepted_by=actor}\n    emit CompanyAccessChanged {customer=invitation.parent,account=actor,revision=invitation.version+1}\n   examples seed=[test_admin] invitation=company_invitation\n    test_admin.active,invitation.status,invitation.expires -> invitation.status,count(test_company.CompanyRole as grant where grant.account==self and grant.role==booker and grant.active)\n    true,open,now+1d -> accepted,1\n    false,open,now+1d -> error(rule_failed)\n    true,accepted,now+1d -> error(rule_failed)\n    true,open,now -> error(rule_failed)\n   examples seed=[test_admin] invitation=company_invitation\n    test_admin.locations -> invitation.status\n    [] -> error(rule_failed)\n  # Remove a company role now, preserving paid bookings and owner review evidence. @{nl=\"Verwijder een bedrijfsrol direct met behoud van betaalde boekingen en beoordelingsbewijs bij de eigenaar.\"}\n  export scenario remove(grant:CompanyRole label=\"Company role grant\"@{nl=\"Bedrijfsroltoewijzing\"}) by=authenticated label=\"Remove company role\"@{nl=\"Bedrijfsrol verwijderen\"}\n   require grant.active and has_role(actor,grant.parent,administrator) and all(grant.locations as location,has_location_role(actor,grant.parent,administrator,location))\n   require grant.role!=administrator or count(grant.parent.CompanyRole as role where role.active and role.role==administrator)>1\n   do\n    set grant {active=false}\n    emit CompanyAccessChanged {customer=grant.parent,account=grant.account,revision=grant.version+1}\n   examples seed=[test_admin] grant=test_booker\n    grant.role -> grant.active\n    booker -> false\n  # Recover company administration through a scoped operator action with a reason. @{nl=\"Herstel bedrijfsbeheer via een beperkte exploitantactie met een reden.\"}\n  export scenario recover(org:Customer label=label_Customer_kind_company,account:user label=label_Contact_account,reason:text) by=customer_manager label=\"Recover company administration\"@{nl=\"Bedrijfsbeheer herstellen\"}\n   require customer_staff(actor,org) and trim(reason)!=\"\" and org.kind==company\n   do\n    let previous=first(org.CompanyRole as grant where grant.account==account and grant.role==administrator order=grant.id)\n    if previous==null\n     create CompanyRole {parent=org,account,role=administrator,locations=org.locations} as grant\n    else\n     set previous {active=true,locations=org.locations}\n  # Record an alias without transferring account grants or rewriting old documents. @{nl=\"Leg een alias vast zonder accountrechten over te dragen of oude documenten te herschrijven.\"}\n  export scenario alias(source:Customer label=\"Source reference\"@{nl=\"Bronreferentie\"},target:Customer label=label_Alias_to_customer,reason:text) by=customer_manager label=\"Record reviewed alias\"@{nl=\"Beoordeelde alias vastleggen\"}\n   require source!=target and customer_staff(actor,source) and customer_staff(actor,target) and trim(reason)!=\"\"\n   require not any(Alias as a,a.from_customer==source or a.to_customer==source or a.from_customer==target)\n   do create Alias {from_customer=source,to_customer=target,reason} as mapping\n   examples seed=[test_worker] source=duplicate_company target=test_company\n    as,source,reason -> count(Alias)\n    customer_manager,duplicate_company,\"Reviewed duplicate\" -> 1\n    customer_manager,test_company,\"Reviewed duplicate\" -> error(rule_failed)\n    customer_manager,duplicate_company,\"\" -> error(rule_failed)\n    members,duplicate_company,\"Reviewed duplicate\" -> error(forbidden)\n   examples seed=[test_worker,reviewed_alias] source=duplicate_company target=test_company reason=\"Reviewed duplicate\"\n    as -> count(Alias)\n    customer_manager -> error(rule_failed)\n  ## Recompute customer-wide access from current owner state; account=null invalidates all watches, not a synthetic person.\n  scenario customer_created_access on=Customer.created\n   do\n    for changed in Customer archived=include as row where row.id==event.id limit=1\n     emit CompanyAccessChanged {customer=changed,account=null,revision=event.version}\n  scenario customer_updated_access on=Customer.updated\n   do\n    for changed in Customer archived=include as row where row.id==event.id limit=1\n     emit CompanyAccessChanged {customer=changed,account=null,revision=event.version}\n  scenario customer_deleted_access on=Customer.deleted\n   do\n    for changed in Customer archived=include as row where row.id==event.id limit=1\n     emit CompanyAccessChanged {customer=changed,account=null,revision=event.version}\n  scenario contact_created_access on=Contact.created\n   do\n    for changed in Contact archived=include as row where row.id==event.id limit=1\n     emit CompanyAccessChanged {customer=changed.parent,account=null,revision=event.version}\n  scenario contact_updated_access on=Contact.updated\n   do\n    for changed in Contact archived=include as row where row.id==event.id limit=1\n     emit CompanyAccessChanged {customer=changed.parent,account=null,revision=event.version}\n  scenario contact_deleted_access on=Contact.deleted\n   do\n    for changed in Contact archived=include as row where row.id==event.id limit=1\n     emit CompanyAccessChanged {customer=changed.parent,account=null,revision=event.version}\n  scenario companyrole_created_access on=CompanyRole.created\n   do\n    for changed in CompanyRole archived=include as row where row.id==event.id limit=1\n     emit CompanyAccessChanged {customer=changed.parent,account=null,revision=event.version}\n  scenario companyrole_updated_access on=CompanyRole.updated\n   do\n    for changed in CompanyRole archived=include as row where row.id==event.id limit=1\n     emit CompanyAccessChanged {customer=changed.parent,account=null,revision=event.version}\n  scenario companyrole_deleted_access on=CompanyRole.deleted\n   do\n    for changed in CompanyRole archived=include as row where row.id==event.id limit=1\n     emit CompanyAccessChanged {customer=changed.parent,account=null,revision=event.version}\n  scenario expire on=InvitationExpiry\n   do\n    if event.invitation.status==open and event.invitation.expires<=now\n     set event.invitation {status=expired}\n\n Then\n  # Maintain customers and review duplicates under location scope. @{nl=\"Beheer klanten en beoordeel dubbelen binnen locatiebevoegdheden.\"}\n  page /customers title=\"Customers\"@{nl=\"Klanten\"}\n   breadcrumbs\n   require customer_manager\n   card \"Customer intake\"@{nl=\"Klant aanmaken\"}\n    form Customer.create import=csv review=duplicate_customers\n     input name\n     radio kind\n   list Customer columns=name,kind,locations,active search=name filter=kind,active defaults={kind=preferences.kind,active=preferences.active} display=split\n    pagination\n    card \"Canonical customer identity\"@{nl=\"Canonieke klantidentiteit\"}\n     status row.active\n     badge row.kind\n     edit\n      input name\n      checkbox active\n     ## Explicit forms bind the row record and place typed reason controls; same\n     ## canonical operations and guards as the former `actions` pair.\n     form alias arguments={source=row}\n      textarea reason\n     form recover arguments={org=row}\n      textarea reason\n    tabs\n     tab \"Contacts\"@{nl=\"Contactpersonen\"}\n      form Contact.create import=csv review=duplicate_contacts\n       input name\n       input email\n       input phone\n       input external_id\n      table row.Contact columns=name,email,phone,account,verified\n       pagination\n       status row.verified\n       edit\n     tab \"Billing profiles\"@{nl=\"Factuurprofielen\"}\n      form BillingProfile.create\n       textarea address\n       input tax_reference\n      table row.BillingProfile columns=contact,address,tax_reference,on_account\n       pagination\n       status row.on_account\n       edit\n    history\n  # Review invoicing eligibility without granting membership or recording payment. @{nl=\"Beoordeel facturatiegeschiktheid zonder lidmaatschap te verlenen of betaling vast te leggen.\"}\n  page /customers/billing-approvals title=\"Billing approvals\"@{nl=\"Facturatiegoedkeuringen\"}\n   breadcrumbs\n   require finance\n   table BillingProfile columns=parent,contact,on_account,approved_locations,approval_reason,approved_by,approved_at\n    pagination\n    status row.on_account\n    form approve_account arguments={profile=row}\n     checkbox approve\n     textarea reason\n    history\n  # Manage only your company's grants; paid seats are a separate operation. @{nl=\"Beheer uitsluitend de rechten van je bedrijf; betaalde plaatsen zijn een afzonderlijke operatie.\"}\n  page /companies/{Customer.id} title=\"Company people\"@{nl=\"Bedrijfsleden\"}\n   breadcrumbs\n   require authenticated and has_role(actor,row,administrator)\n   card \"Company role invitation\"@{nl=\"Uitnodiging bedrijfsrol\"}\n    text row.name\n    ## Fieldset caption reuses the zero-parameter message directly; literal\n    ## captions may be replaced by typed message references (DESIGN §9 intro).\n    ## Placed controls render first, then the generated org/locations controls\n    ## in owner order.\n    form invite\n     fieldset notice_company_invitation\n      input email\n      radio role\n   card \"Current company grants\"@{nl=\"Huidige bedrijfsrechten\"}\n    list row.CompanyRole columns=account,role,locations,active\n     pagination\n     badge row.role\n     status row.active\n     button action=remove arguments={grant=row}\n   card \"Invitation outcomes\"@{nl=\"Uitnodigingsuitkomsten\"}\n    list row.Invitation\n     pagination\n     badge row.status\n     text row.email,row.role,row.locations,row.expires\n   collapse \"Independent access reconciliation\"@{nl=\"Afzonderlijke toegangsafstemming\"}\n    text \"Company grants apply immediately. Paid seats and allowance review remain with Membership; visitor admission and credential confirmations remain with Reception.\"@{nl=\"Bedrijfsrechten gelden direct. Betaalde plaatsen en tegoedbeoordeling blijven bij Lidmaatschap; gasttoelating en sleutelbevestigingen blijven bij Receptie.\"}\n    text \"Use Membership access review and Reception access review when those services are available in your product. Unavailable services have no reported reconciliation outcome here.\"@{nl=\"Gebruik Beoordeling lidmaatschapstoegang en Beoordeling receptietoegang wanneer die diensten beschikbaar zijn in je product. Voor niet-beschikbare diensten wordt hier geen afstemmingsresultaat gemeld.\"}\n  # Review your addressed invitations without purchasing benefits or staff access. @{nl=\"Beoordeel je gerichte uitnodigingen zonder voordelen of personeelstoegang te kopen.\"}\n  page /company-invitations title=\"Invitations\"@{nl=\"Uitnodigingen\"}\n   breadcrumbs\n   require authenticated\n   card \"Own contact claim\"@{nl=\"Eigen contact koppelen\"}\n    list Contact\n     pagination\n     status row.verified\n     text row.name,row.email\n     button action=claim arguments={contact=row}\n   card \"Addressed company invitations\"@{nl=\"Gerichte bedrijfsuitnodigingen\"}\n    list Invitation as invitation where invitation.email==actor.email and invitation.status==open\n     pagination\n     badge row.status\n     text row.email,row.role,row.locations,row.expires\n     button action=accept arguments={invitation=row}\n"}}
