{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"b02fc8f903f847bb96620ca3ef3e104e1bd2bece0f14455f8f15cbe7611bb186","before_projection_sha256":"b02fc8f903f847bb96620ca3ef3e104e1bd2bece0f14455f8f15cbe7611bb186","changed":false,"idempotent":true,"structure_equal":true,"text":"# Optionally help workspace members advertise their services, request suppliers, and offer surplus office equipment within the member community. @{nl=\"Help werkplekleden desgewenst hun diensten aan te bieden, leveranciers te zoeken en overtollige kantoorapparatuur binnen de ledengemeenschap aan te bieden.\"}\napp CanTrade uses=[trade]\n\n# Publish owned wanted and offered listings with deliberate contact visibility and scoped moderation. @{nl=\"Publiceer eigen vraag- en aanbodadvertenties met bewuste contactzichtbaarheid en afgebakende moderatie.\"}\npackage trade\n use rent_catalog {Location}\n use member_terms {eligible_term,Term,paid_term as paid,allocated}\n use customer {test_admin,test_contact}\n Given\n  preferences { location:Location?, category:text? label=label_Post_category, kind:Post.kind?, view:enum(community,mine)=community label={text=\"Initial view\"@{nl=\"Beginweergave\"},values={community=\"Community listings\"@{nl=\"Communityadvertenties\"},mine=\"My listings\"@{nl=\"Mijn advertenties\"}}} }\n  message label_Post_author = \"Recorded by\"@{nl=\"Vastgelegd door\"}\n  message label_Post_category = \"Category\"@{nl=\"Categorie\"}\n  role moderator label=\"Moderator\"@{nl=\"Moderator\"}\n  Audience { key:text=\"community\" unique, allow_public:bool=false label=\"Allow public listings\"@{nl=\"Openbare advertenties toestaan\"} } label=\"Marketplace audience\"@{nl=\"Marktplaatsdoelgroep\"}\n  Post { author:user server=actor label=label_Post_author, location:Location?, kind:enum(wanted,offered) label={text=\"Kind\"@{nl=\"Soort\"},values={wanted=\"Wanted\"@{nl=\"Gezocht\"},offered=\"Offered\"@{nl=\"Aangeboden\"}}}, category:text label=label_Post_category, title:text trim min=1, description:text, amount:money?, contact:text label=\"Published contact\"@{nl=\"Gepubliceerd contact\"}, visibility:enum(member,public)=member label={text=\"Published audience\"@{nl=\"Publicatiedoelgroep\"},values={member=\"Members only\"@{nl=\"Alleen leden\"},public=\"Public\"@{nl=\"Openbaar\"}}}, state:enum(active,closed,removed)=active label={text=\"State\"@{nl=\"Status\"},values={active=\"Active\"@{nl=\"Actief\"},closed=\"Closed\"@{nl=\"Gesloten\"},removed=\"Removed\"@{nl=\"Verwijderd\"}}}, moderation_reason:text? label=\"Moderation reason\"@{nl=\"Moderatiereden\"} } label=\"Community listing\"@{nl=\"Communityadvertentie\"}\n  Report in Post { author:user server=actor label=label_Post_author, reason:text trim min=1, dismissed:bool=false label=\"Dismissed\"@{nl=\"Afgewezen\"}, decision:text? label=\"Decision\"@{nl=\"Besluit\"} } label=\"Listing report\"@{nl=\"Advertentiemelding\"}\n  derive eligible(account:user,location:Location?):bool = any(Term as term,eligible_term(account,term,now) and (location==null or (location.active and location in term.locations)))\n  derive Report.resolved:bool = row.dismissed or row.parent.state==removed label=\"Resolved\"@{nl=\"Afgehandeld\"}\n  policy Audience read=owner\n  invariant Audience: row.key==\"community\"\n  invariant Post: row.amount==null or row.amount.minor>=0\n  unique Report fields=author\n  lock Audience fields=key\n  policy Post read=public where=row.visibility==public and row.state==active and eligible(row.author,row.location) and any(Audience as audience,audience.allow_public) fields=location,kind,category,title,description,amount,contact,visibility,state\n  policy Post read=authenticated where=actor.email_verified and eligible(actor,row.location) and row.state==active and eligible(row.author,row.location) and (row.visibility==member or any(Audience as audience,audience.allow_public)) fields=location,kind,category,title,description,amount,contact,visibility,state\n  policy Post read=authenticated where=row.author==actor\n  policy Post read=moderator\n  policy Report read=authenticated where=row.author==actor\n  policy Report read=moderator\n  lock Post fields=author\n  lock Report fields=author,reason\n  fixture listing=Post {kind=offered,category=\"Services\",title=\"Accounting\",description=\"Accounting services\",contact=\"Published contact\"}\n  fixture complaint=Report {parent=listing,author=other,reason=\"Reported abuse\"}\n When\n  crud Audience by=owner fields=allow_public delete=none\n  crud Post by=authenticated fields=location,kind,category,title,description,amount,contact,visibility when=row.author==actor and actor.email_verified and eligible(actor,row.location) and row.state!=removed and count(Post archived=include as post where post.author==actor and post!=row and post.created>now-1d)<20 and (row.visibility!=public or any(Audience as audience,audience.allow_public))\n   examples delete seed=[test_admin,test_contact,allocated] record=listing\n    as,record.author,request.record.version -> record.archived_at!=null,record.contact\n    members,self,1 -> true,\"Published contact\"\n    members,other,1 -> error(rule_failed)\n    members,self,0 -> error(conflict)\n    public,self,1 -> error(forbidden)\n  crud Report by=authenticated fields=reason update=none delete=none when=actor.email_verified and eligible(actor,row.parent.location) and row.parent.state==active and row.parent.author!=actor and eligible(row.parent.author,row.parent.location) and (row.parent.visibility==member or any(Audience as audience,audience.allow_public)) and count(Report archived=include as report where report.author==actor and report.created>now-1d)<10\n  # Close or reopen your own listing without altering the published contact snapshot. @{nl=\"Sluit of heropen je eigen advertentie zonder de vastgelegde gepubliceerde contactgegevens te wijzigen.\"}\n  scenario status(post:Post,open:bool label=\"Open\"@{nl=\"Open\"}) by=authenticated label=\"Change listing status\"@{nl=\"Advertentiestatus wijzigen\"}\n   require post.author==actor and post.state in [active,closed] and (not open or (actor.email_verified and eligible(actor,post.location) and (post.visibility==member or any(Audience as audience,audience.allow_public))))\n   do\n    if open\n     set post {state=active}\n    else\n     set post {state=closed}\n   examples seed=[test_admin,test_contact,allocated] post=listing open=false\n    as,post.state,paid.paid,open -> post.state\n    members,active,true,false -> closed\n    members,active,false,false -> closed\n    members,closed,false,true -> error(rule_failed)\n    members,removed,true,false -> error(rule_failed)\n    public,active,true,false -> error(forbidden)\n  # Remove reported abuse with a reason, preserving authorship and moderation history. @{nl=\"Verwijder gemeld misbruik met een reden en behoud auteurschap en moderatiegeschiedenis.\"}\n  scenario moderate(post:Post,reason:text) by=moderator label=\"Remove reported listing\"@{nl=\"Gemelde advertentie verwijderen\"}\n   require trim(reason)!=\"\" and post.state!=removed and any(post.Report as report,not report.resolved)\n   do\n    set post {state=removed,moderation_reason=reason}\n   examples seed=[complaint] post=listing reason=\"Abusive publication\"\n    as,reason,complaint.dismissed -> post.state,post.moderation_reason,post.author,complaint.resolved\n    moderator,\"Abusive publication\",false -> removed,\"Abusive publication\",self,true\n    moderator,\" \",false -> error(rule_failed)\n    moderator,\"Abusive publication\",true -> error(rule_failed)\n    members,\"Abusive publication\",false -> error(forbidden)\n  # Dismiss an unfounded report while keeping its original report and decision history. @{nl=\"Wijs een ongegronde melding af met behoud van de oorspronkelijke melding en besluitgeschiedenis.\"}\n  scenario dismiss(report:Report,reason:text) by=moderator label=\"Dismiss report\"@{nl=\"Melding afwijzen\"}\n   require not report.resolved and trim(reason)!=\"\"\n   do set report {dismissed=true,decision=reason}\n   examples report=complaint reason=\"No abuse found\"\n    as,reason,report.dismissed -> report.resolved,report.reason,report.author,report.decision\n    moderator,\"No abuse found\",false -> true,\"Reported abuse\",other,\"No abuse found\"\n    moderator,\" \",false -> error(rule_failed)\n    moderator,\"No abuse found\",true -> error(rule_failed)\n    members,\"No abuse found\",false -> error(forbidden)\n Then\n  # Find active community listings and publish only contact details you deliberately choose. @{nl=\"Vind actieve communityadvertenties en publiceer alleen contactgegevens die je bewust kiest.\"}\n  page /marketplace title=\"Community marketplace\"@{nl=\"Communitymarktplaats\"}\n   breadcrumbs\n   card \"Publish a listing\"@{nl=\"Een advertentie publiceren\"}\n    require authenticated and actor.email_verified and eligible(actor,null)\n    form Post.create\n     fieldset \"Listing details\"@{nl=\"Advertentiegegevens\"}\n      radio kind\n      input title\n      textarea description\n      radio visibility\n      select location\n      input category\n      input amount\n      input contact\n   tabs preferences.view\n   card \"Community discovery\"@{nl=\"Communityaanbod ontdekken\"}\n    require preferences.view==community\n    table Post as post where post.state==active columns=kind,category,location,title,amount,contact filter=kind,category,location defaults={kind=preferences.kind,category=preferences.category,location=preferences.location} search=title display=split empty=\"No active listings match.\"@{nl=\"Geen actieve advertenties gevonden.\"}\n     pagination\n     badge row.state\n     content row.description\n     edit\n     ## Closing and reopening keep the owning status operation with its typed open control.\n     button opens=community_listing_status\n     modal \"Change listing status\"@{nl=\"Advertentiestatus wijzigen\"} id=community_listing_status\n      slot content\n       form status arguments={post=row} display=inline\n        checkbox open\n     collapse \"Published contact and reporting\"@{nl=\"Gepubliceerd contact en melden\"}\n      text row.visibility,row.state\n      form Report.create\n       textarea reason\n   card \"My listings\"@{nl=\"Mijn advertenties\"}\n    require authenticated and preferences.view==mine\n    table Post as post where post.author==actor columns=kind,title,visibility,state,moderation_reason filter=state display=split empty=\"No own listings yet.\"@{nl=\"Nog geen eigen advertenties.\"}\n     pagination\n     badge row.state\n     edit\n     delete\n     button opens=own_listing_status\n     modal \"Change listing status\"@{nl=\"Advertentiestatus wijzigen\"} id=own_listing_status\n      slot content\n       form status arguments={post=row} display=inline\n        checkbox open\n     history\n\n  # Resolve reported listings under a separate moderation grant. @{nl=\"Behandel gemelde advertenties onder een afzonderlijke moderatiebevoegdheid.\"}\n  page /marketplace/reports title=\"Listing reports\"@{nl=\"Advertentiemeldingen\"}\n   require moderator or owner\n   breadcrumbs\n   card \"Publication audience\"@{nl=\"Publicatiedoelgroep\"}\n    require owner\n    form Audience.create\n     checkbox allow_public\n    list Audience empty=\"No audience record yet.\"@{nl=\"Nog geen doelgroeprecord.\"}\n     pagination\n     edit\n   card \"Reported listings\"@{nl=\"Gemelde advertenties\"}\n    require moderator\n    ## The queue defaults to unresolved reports; dismissal keeps the original report and decision history.\n    alert \"Unresolved reports first; dismissed reports stay readable with their decision.\"@{nl=\"Eerst onopgeloste meldingen; afgewezen meldingen blijven leesbaar met hun besluit.\"}\n    table Report columns=parent,reason,resolved,decision filter=resolved defaults={resolved=false} empty=\"No reports match this filter.\"@{nl=\"Geen meldingen voor dit filter.\"}\n     pagination\n     text row.resolved\n     button opens=dismiss_report\n     modal \"Dismiss report\"@{nl=\"Melding afwijzen\"} id=dismiss_report\n      slot content\n       form dismiss arguments={report=row} display=inline\n        textarea reason\n   card \"Moderation decisions\"@{nl=\"Moderatiebesluiten\"}\n    require moderator\n    list Post as post where any(post.Report as report,not report.resolved) display=split empty=\"No listings awaiting moderation.\"@{nl=\"Geen advertenties te beoordelen.\"}\n     pagination\n     badge row.state\n     button opens=moderate_listing\n     modal \"Remove reported listing\"@{nl=\"Gemelde advertentie verwijderen\"} id=moderate_listing\n      slot content\n       form moderate arguments={post=row} display=inline\n        textarea reason\n     history\n"}}
