{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"988b4a3676e4860dd7ce57b2820c8dd7377c326badc9e682ae0663a25ae1ca29","before_projection_sha256":"988b4a3676e4860dd7ce57b2820c8dd7377c326badc9e682ae0663a25ae1ca29","changed":false,"idempotent":true,"structure_equal":true,"text":"# Help workspace marketing teams understand traffic and tracked inquiries on location, workspace, and event pages. @{nl=\"Help werkplekmarketingteams verkeer en gemeten aanvragen op locatie-, werkplek- en evenementpagina's te begrijpen.\"}\napp CanStats uses=[stats]\ncontext\n queue WebJobs type=stats.WebEvent\n analytics WebDimensions { site:text, name:text, path:text, location:text?, source:text?, medium:text?, workspace:text?, occurred:datetime, identified:text, value:decimal }\n\n# Report observed website events and identifier coverage without manufacturing confirmed business sales. @{nl=\"Rapporteer gemeten websitegebeurtenissen en identificatiedekking zonder bevestigde zakelijke verkopen te verzinnen.\"}\npackage stats\n use stats {DimensionsV1 as Dimensions} from=deployment.dimensions\n use stats {TrackerV1 as Tracker} from=deployment.tracker\n Given\n  preferences { site:Site? label=label_Site }\n  message health_title = \"Processing health\"@{nl=\"Verwerkingsstatus\"}\n  message label_Site = \"Website\"@{nl=\"Website\"}\n  role analyst label=\"Analyst\"@{nl=\"Analist\"}\n  Site { name:text, domain:text label=\"Domain\"@{nl=\"Domein\"}, timezone:timezone, goals:text[]! label=\"Tracked goals\"@{nl=\"Gemeten doelen\"}, viewers:user[], active:bool=true, quota:int=100000 min=1, key:secret server=random_secret() } label=label_Site\n  AcceptedEvent in Site { event_id:text unique label=\"Event reference\"@{nl=\"Gebeurtenisreferentie\"}, name:text, occurred:datetime, received:datetime server=now label=\"Received at\"@{nl=\"Ontvangen op\"}, path:text label=\"Page path\"@{nl=\"Paginapad\"}, location:text?, workspace:text? label=\"Workspace dimension\"@{nl=\"Werkplekdimensie\"}, source:text? label=\"Acquisition source\"@{nl=\"Acquisitiebron\"}, medium:text? label=\"Acquisition medium\"@{nl=\"Acquisitiemedium\"}, visitor:text?, session:text?, session_started:datetime? } label=\"Accepted website event\"@{nl=\"Geaccepteerde websitegebeurtenis\"}\n  Health in Site { revision:int=0, observed:datetime?, rejected:int=0, accepted:int=0 label=\"Accepted events\"@{nl=\"Geaccepteerde gebeurtenissen\"}, dropped:int=0 label=\"Dropped events\"@{nl=\"Verworpen gebeurtenissen\"}, last_processed:datetime? label=\"Last processed at\"@{nl=\"Laatst verwerkt op\"}, state:enum(fresh,lagging,unavailable)=unavailable label={text=\"State\"@{nl=\"Status\"},values={fresh=\"Up to date\"@{nl=\"Actueel\"},lagging=\"Delayed\"@{nl=\"Vertraagd\"},unavailable=\"Unavailable\"@{nl=\"Niet beschikbaar\"}}} } label=health_title\n  export contract WebEvent { site:Site, event_id:text, name:text, occurred:datetime, path:text, location:text?, workspace:text?, source:text?, medium:text?, visitor:text?, session:text?, session_started:datetime? }\n  export contract TrackerHealth { site:Site, revision:int min=1, observed:datetime, rejected:int min=0, dropped:int min=0, state:Health.state }\n  export contract DimensionRow { key:text?, events:decimal min=0, goals:decimal min=0, identified:decimal min=0 }\n  export contract DimensionResult { site:text, from:datetime, until:datetime, dimension:enum(path,location,source,medium,workspace) label={text=\"Dimension\"@{nl=\"Dimensie\"},values={path=\"Page path\"@{nl=\"Paginapad\"},location=\"Location\"@{nl=\"Locatie\"},source=\"Acquisition source\"@{nl=\"Acquisitiebron\"},medium=\"Acquisition medium\"@{nl=\"Acquisitiemedium\"},workspace=\"Workspace\"@{nl=\"Werkplek\"}}}, goal:text?, configured_goals:text[]!, rows:DimensionRow[] max=200, events:decimal min=0, goals:decimal min=0, identified:decimal min=0, sampled:bool, complete:bool, generated:datetime }\n  export capability DimensionsV1 version=1\n   read(site:text,from:datetime,until:datetime,dimension:DimensionResult.dimension,goals:text[],goal:text?) -> DimensionResult\n  Breakdown in Site { account:user server=actor, from:datetime, until:datetime, dimension:DimensionResult.dimension, goal:text?, configured_goals:text[]!, current:bool=true, delivery:text unique, state:enum(pending,fresh,partial,failed,unknown)=pending label={text=\"Report state\"@{nl=\"Rapportstatus\"},values={pending=\"Pending\"@{nl=\"In afwachting\"},fresh=\"Available\"@{nl=\"Beschikbaar\"},partial=\"Partial\"@{nl=\"Gedeeltelijk\"},failed=\"Unavailable\"@{nl=\"Niet beschikbaar\"},unknown=\"Unknown\"@{nl=\"Onbekend\"}}}, result:DimensionResult?, error:text?, requested:datetime server=now }\n  contract GoalCount { name:text, events:int }\n  export capability TrackerV1 version=1\n   event accepted { value:WebEvent }\n   event health { value:TrackerHealth }\n  contract Summary { goal_counts:GoalCount[]?, events:int? label=\"Accepted event count\"@{nl=\"Aantal geaccepteerde gebeurtenissen\"}, goals:int? label=\"Observed goal events\"@{nl=\"Gemeten doelgebeurtenissen\"}, goal_rate:decimal? label=\"Observed goal rate\"@{nl=\"Gemeten doelratio\"}, visitors:int? label=\"Identified visitors\"@{nl=\"Geïdentificeerde bezoekers\"}, sessions:int? label=\"Observed sessions\"@{nl=\"Gemeten sessies\"}, identified:int? label=\"Identified events\"@{nl=\"Geïdentificeerde gebeurtenissen\"}, identity_coverage:decimal? label=\"Identifier coverage\"@{nl=\"Identificatiedekking\"}, live:int? label=\"Recent identified visitors\"@{nl=\"Recente geïdentificeerde bezoekers\"}, state:Health.state, generated:datetime label=\"Generated at\"@{nl=\"Gegenereerd op\"} } label=\"Website traffic summary\"@{nl=\"Websiteverkeersoverzicht\"}\n  policy Site read=analyst where=actor in row.viewers fields=name,domain,timezone,goals,active\n  policy AcceptedEvent read=analyst where=actor in row.parent.viewers fields=event_id,name,occurred,received,path,location,workspace,source,medium\n  policy Health read=analyst where=actor in row.parent.viewers\n  policy Breakdown read=analyst where=row.account==actor and actor in row.parent.viewers\n  invariant Site: all(row.goals as goal,trim(goal)!=\"\") and count(group(row.goals as goal,goal))==count(row.goals)\n  unique Health fields=parent\n  unique Breakdown fields=parent,account where=row.current\n  lock Breakdown fields=account,from,until,dimension,goal,configured_goals,delivery,requested\n  retain Breakdown until=row.requested+1d\n  lock AcceptedEvent fields=event_id,name,occurred,received,path,location,workspace,source,medium,visitor,session,session_started\n  retain AcceptedEvent until=row.occurred+30d\n  fixture website=Site {name=\"Website\",domain=\"example.test\",timezone=\"Europe/Brussels\",goals=[\"tour_request\"],viewers=[self]}\n  fixture health=Health {parent=website,state=fresh,observed=now}\n  fixture seen=AcceptedEvent {parent=website,event_id=\"seen\",name=\"page_view\",occurred=now-1m,path=\"/\",visitor=\"visitor-1\",session=\"session-1\",session_started=now-2m}\n  fixture report=Breakdown {parent=website,from=now-1d,until=now,dimension=path,configured_goals=[\"tour_request\"],delivery=\"dimension-1\"}\n When\n  scenario intake on=Tracker.accepted\n   require event.value.site.active and event.value.occurred<=now+5m and event.value.occurred>now-30d\n   require (event.value.session==null and event.value.session_started==null) or (event.value.visitor!=null and event.value.session!=null and event.value.session_started!=null and event.value.session_started<=event.value.occurred)\n   do send WebJobs.publish {value=event.value} as queued\n   examples event={value=WebEvent {site=website,event_id=\"new\",name=\"page_view\",occurred=now,path=\"/\"}}\n    event.value.visitor,event.value.session,event.value.session_started -> website.active\n    null,null,null -> true\n    \"visitor\",\"session\",now -> true\n    null,\"session\",now -> error(rule_failed)\n    \"visitor\",null,now -> error(rule_failed)\n    \"visitor\",\"session\",now+1m -> error(rule_failed)\n  scenario process on=WebJobs\n   require event.site.active and event.occurred<=now+5m and event.occurred>now-30d\n   do\n    if not any(event.site.AcceptedEvent as accepted,accepted.event_id==event.event_id)\n     create AcceptedEvent {parent=event.site,event_id=event.event_id,name=event.name,occurred=event.occurred,path=event.path,location=event.location,workspace=event.workspace,source=event.source,medium=event.medium,visitor=event.visitor,session=event.session,session_started=event.session_started} as accepted\n     send WebDimensions.write {site=event.site.id,name=event.name,path=event.path,location=event.location,source=event.source,medium=event.medium,workspace=event.workspace,occurred=event.occurred,identified=format(\"{present}\",{present=event.visitor!=null}),value=1} as telemetry\n     let health=first(event.site.Health as health order=health.id)\n     if health==null\n      create Health {parent=event.site,accepted=1,last_processed=now} as created\n     else\n      set health {accepted=health.accepted+1,last_processed=now}\n   examples seed=[health] event=WebEvent {site=website,event_id=\"fresh\",name=\"page_view\",occurred=now,path=\"/\"}\n    website.active -> health.accepted\n    true -> 1\n    false -> error(rule_failed)\n   examples seed=[health] event=WebEvent {site=website,event_id=\"expired\",name=\"page_view\",occurred=now-30d,path=\"/\"}\n    website.active -> health.accepted\n    true -> error(rule_failed)\n   examples seed=[health,seen] event=WebEvent {site=website,event_id=\"seen\",name=\"page_view\",occurred=now-1m,path=\"/\",visitor=\"visitor-1\",session=\"session-1\",session_started=now-2m}\n    health.accepted,event.event_id -> count(website.AcceptedEvent),health.accepted\n    1,\"seen\" -> 1,1\n    1,\"another\" -> 2,2\n  # Expose exact accepted-event counts and identifier coverage for one reproducible local-day range. @{nl=\"Toon exacte aantallen geaccepteerde gebeurtenissen en identificatiedekking voor één reproduceerbaar bereik van lokale dagen.\"}\n  scenario summary(site:Site,from:date label=\"From\"@{nl=\"Van\"},until:date label=\"Until\"@{nl=\"Tot\"}) read=true scope=authority -> Summary by=analyst label=\"Show traffic summary\"@{nl=\"Verkeersoverzicht tonen\"}\n   require from<until and from>=add_days(local_date(now,site.timezone),-30) and until<=add_days(local_date(now,site.timezone),1) and site.active and actor in site.viewers\n   do\n    let start=local_instant(from,\"00:00\",site.timezone,fold=earlier)\n    let end=local_instant(until,\"00:00\",site.timezone,fold=earlier)\n    require start>=now-30d\n    let selected=site.AcceptedEvent as event where start<=event.occurred and event.occurred<end and event.occurred<=now\n    let health=first(site.Health as health order=health.id)\n    if health==null or health.observed==null or health.observed<now-5m or health.state==unavailable\n     return Summary {state=unavailable,generated=now}\n    let total=count(selected)\n    let identified=count(selected as event where event.visitor!=null)\n    let goals=count(selected as event where event.name in site.goals)\n    let goal_counts=site.goals as goal select GoalCount {name=goal,events=count(selected as event where event.name==goal)}\n    if total==0\n     return Summary {goal_counts,events=0,goals=0,visitors=0,sessions=0,identified=0,live=count(group((site.AcceptedEvent as event where event.visitor!=null and event.occurred>=now-5m and event.occurred<=now) as item,item.visitor)),state=health.state,generated=now}\n    return Summary {goal_counts,events=total,goals,goal_rate=goals/total,visitors=count(group((selected as event where event.visitor!=null) as item,item.visitor)),sessions=count(group((site.AcceptedEvent as event where event.session!=null and event.session_started!=null and start<=event.session_started and event.session_started<end and event.occurred<=now) as item,item.session)),identified,identity_coverage=identified/total,live=count(group((site.AcceptedEvent as event where event.visitor!=null and event.occurred>=now-5m and event.occurred<=now) as item,item.visitor)),state=health.state,generated=now}\n   examples seed=[health] site=website from=local_date(now,website.timezone) until=add_days(local_date(now,website.timezone),1)\n    as,health.state -> result.events,result.visitors,result.state\n    analyst,fresh -> 0,0,fresh\n    analyst,unavailable -> null,null,unavailable\n    members,fresh -> error(forbidden)\n   examples seed=[health] site=website from=local_date(now,website.timezone) until=add_days(local_date(now,website.timezone),1)\n    as,health.observed -> result.events,result.state\n    analyst,now-6m -> null,unavailable\n  scenario tracker_health on=Tracker.health\n   require event.value.site.active and event.value.observed<=now\n   do\n    let health=first(event.value.site.Health as health order=health.id)\n    if health==null\n     create Health {parent=event.value.site,revision=event.value.revision,observed=event.value.observed,rejected=event.value.rejected,dropped=event.value.dropped,state=event.value.state} as created\n    else\n     if event.value.revision>health.revision\n      require (health.observed==null or event.value.observed>=health.observed) and event.value.rejected>=health.rejected and event.value.dropped>=health.dropped\n      set health {revision=event.value.revision,observed=event.value.observed,rejected=event.value.rejected,dropped=event.value.dropped,state=event.value.state}\n     else\n      if event.value.revision==health.revision\n       require event.value.observed==health.observed and event.value.rejected==health.rejected and event.value.dropped==health.dropped and event.value.state==health.state\n  # Request a weighted dimension report without exposing tracker identities. @{nl=\"Vraag een gewogen dimensierapport op zonder trackeridentiteiten bloot te geven.\"}\n  scenario breakdown(site:Site,from:date,until:date,dimension:DimensionResult.dimension,goal:text?=null) by=analyst label=\"Request breakdown\"@{nl=\"Uitsplitsing aanvragen\"}\n   require site.active and actor in site.viewers and from<until and from>=add_days(local_date(now,site.timezone),-30) and until<=add_days(local_date(now,site.timezone),1) and (goal==null or goal in site.goals)\n   do\n    for previous in site.Breakdown as report where report.account==actor and report.current limit=1\n     set previous {current=false}\n    let start=local_instant(from,\"00:00\",site.timezone,fold=earlier)\n    let end=local_instant(until,\"00:00\",site.timezone,fold=earlier)\n    require start>=now-30d\n    send Dimensions.read {site=site.id,from=start,until=end,dimension,goals=site.goals,goal} as delivery\n    create Breakdown {parent=site,from=start,until=end,dimension,goal,configured_goals=site.goals,delivery=delivery.id} as report\n  scenario dimension_result on=Dimensions.read.completed\n   do\n    let report=first(Breakdown as report where report.delivery==event.delivery_id order=report.id)\n    if report!=null and report.current\n     if event.status==succeeded\n      if event.result!=null and event.result.site==report.parent.id and event.result.from==report.from and event.result.until==report.until and event.result.dimension==report.dimension and event.result.goal==report.goal and event.result.configured_goals==report.configured_goals and event.result.generated<=now and event.result.generated>=report.requested and event.result.goals<=event.result.events and event.result.identified<=event.result.events and all(event.result.rows as row,row.goals<=row.events and row.identified<=row.events) and count(group(event.result.rows as row,row.key))==count(event.result.rows) and sum(event.result.rows as row select row.events)<=event.result.events and sum(event.result.rows as row select row.goals)<=event.result.goals and sum(event.result.rows as row select row.identified)<=event.result.identified and (not event.result.complete or (sum(event.result.rows as row select row.events)==event.result.events and sum(event.result.rows as row select row.goals)==event.result.goals and sum(event.result.rows as row select row.identified)==event.result.identified))\n       if event.result.complete\n        set report {state=fresh,result=event.result,error=null}\n       else\n        set report {state=partial,result=event.result,error=null}\n      else\n       set report {state=failed,error=\"Invalid dimension report\"}\n     else\n      if event.status==unknown\n       set report {state=unknown,error=event.error?.message}\n      else\n       set report {state=failed,error=event.error?.message}\n   examples seed=[report] event={delivery_id=\"dimension-1\",status=succeeded,result=DimensionResult {site=website.id,from=report.from,until=report.until,dimension=path,goal=null,configured_goals=[\"tour_request\"],rows=[{key=\"/\",events=2,goals=1,identified=1}],events=2,goals=1,identified=1,sampled=true,complete=true,generated=now},error=null}\n    event.result.complete,event.result.events,event.result.site,report.current -> report.state,report.result==null\n    true,2,website.id,true -> fresh,false\n    false,3,website.id,true -> partial,false\n    true,3,website.id,true -> failed,true\n    true,2,\"foreign\",true -> failed,true\n    true,2,website.id,false -> pending,true\n Then\n  # Inspect configured sites and clearly labeled tracker-observed goals. @{nl=\"Bekijk ingestelde websites en duidelijk gelabelde doelen die de tracker heeft waargenomen.\"}\n  page /traffic title=\"Website traffic\"@{nl=\"Websiteverkeer\"} poll=5s\n   require analyst\n   breadcrumbs\n   card \"Configured site and reporting range\"@{nl=\"Ingestelde website en rapportagebereik\"}\n    list Site as site where preferences.site==null or site==preferences.site empty=\"No configured sites\"@{nl=\"Geen ingestelde websites\"}\n     text row.name,row.domain,row.timezone,row.active,row.goals\n     card \"Observed traffic and identifier coverage\"@{nl=\"Gemeten verkeer en identificatiedekking\"}\n      form summary display=inline\n       calendar from\n       calendar until\n       ## site binds the enclosing row.\n       badge result.state\n       text result.generated\n       stat result.events,result.goals,result.visitors,result.sessions\n       stat result.live,result.identified\n       progress result.goal_rate max=1\n       progress result.identity_coverage max=1\n       collapse \"Observed goals\"@{nl=\"Gemeten doelen\"}\n        require result.goal_counts!=null\n        table result.goal_counts columns=name,events empty=\"No observed goals\"@{nl=\"Geen gemeten doelen\"}\n         pagination\n     card \"Weighted dimension estimates\"@{nl=\"Gewogen dimensieschattingen\"}\n      button opens=request_breakdown\n      modal \"Request breakdown\"@{nl=\"Uitsplitsing aanvragen\"} id=request_breakdown\n       slot content\n        form breakdown arguments={site=row} display=inline\n         calendar from\n         calendar until\n         radio dimension\n         input goal\n      list row.Breakdown as report where report.account==actor and report.current empty=\"No current reports\"@{nl=\"Geen actuele rapporten\"}\n       badge row.state\n       text row.requested,row.goal,row.configured_goals,row.error\n       collapse \"Report result\"@{nl=\"Rapportresultaat\"}\n        require row.result!=null\n        text row.result.from,row.result.until,row.result.sampled,row.result.complete,row.result.generated\n        stat row.result.events,row.result.goals,row.result.identified\n        table row.result.rows columns=key,events,goals,identified empty=\"No report rows\"@{nl=\"Geen rapportrijen\"}\n         pagination\n       pagination\n     tabs\n      tab health_title\n       table row.Health columns=accepted,rejected,dropped,last_processed,observed,state empty=\"No health records\"@{nl=\"Geen statusrecords\"}\n        badge row.state\n        alert\n         require row.state==lagging\n         text \"Processing is delayed. Live activity excludes old queued events.\"@{nl=\"Verwerking is vertraagd. Live activiteit sluit oude gebeurtenissen in de wachtrij uit.\"}\n        pagination\n      tab \"Accepted event inspection\"@{nl=\"Geaccepteerde gebeurtenissen bekijken\"}\n       table row.AcceptedEvent columns=name,occurred,path,location,workspace,source,medium filter=name,location,path order=-occurred empty=\"No accepted events\"@{nl=\"Geen geaccepteerde gebeurtenissen\"}\n        pagination\n     pagination\n   footer\n    text \"Weighted breakdowns are sampled estimates; exact counts come from accepted D1 events.\"@{nl=\"Gewogen uitsplitsingen zijn geschatte steekproeven; exacte aantallen komen uit geaccepteerde D1-gebeurtenissen.\"}\n"}}
