{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"404b9b7a043ae8a02f42a8ecbb318fc220c387371caf8a34f4c7e83fad54df5b","before_projection_sha256":"404b9b7a043ae8a02f42a8ecbb318fc220c387371caf8a34f4c7e83fad54df5b","changed":true,"idempotent":true,"structure_equal":true,"text":"# Help workspace teams record time spent on customer services, facilities work, and location projects. @{nl=\"Help werkplekteams tijd voor klantdiensten, facilitair werk en locatieprojecten te registreren.\"}\napp CanTime uses=[time]\n\n# Record observed or manual employee time, freeze period reviews and preserve correction and billing evidence. @{nl=\"Registreer gemeten of handmatig ingevoerde medewerkerstijd, leg periodebeoordelingen vast en bewaar correctie- en facturatiebewijs.\"}\npackage time label=\"Time tracking\"@{nl=\"Tijdregistratie\"}\n use employee {Employee,can_work,test_worker}\n use customer {Customer,test_company}\n use field {Job}\n use rent_catalog {Location,test_site}\n use invoice {BillingV1 as Billing} from=deployment.billing\n Given\n  preferences { project:Project? label=label_Project, location:Location?, week:date?, billable_filter:bool? label=\"Initial billable filter\"@{nl=\"Eerste facturatiefilter\"} }\n  message label_Project = \"Time project\"@{nl=\"Tijdregistratieproject\"}\n  message label_Entry_from = \"Started at\"@{nl=\"Gestart op\"}\n  message label_Entry_until = \"Stopped at\"@{nl=\"Gestopt op\"}\n  message label_Entry_billable = \"Billable\"@{nl=\"Factureerbaar\"}\n  role project_manager label=\"Project manager\"@{nl=\"Projectmanager\"}\n  Project { name:text, location:Location, customer:Customer?, rate:money label=\"Current hourly rate\"@{nl=\"Huidig uurtarief\"}, active:bool=true } label=label_Project\n  Entry in Employee { project:Project, service:Job? label=\"Service visit\"@{nl=\"Servicebezoek\"}, description:text, from:datetime label=label_Entry_from, until:datetime? label=label_Entry_until, rate:money label=\"Frozen rate\"@{nl=\"Vastgelegd tarief\"}, billable:bool=true label=label_Entry_billable, origin:enum(timer,manual) label={text=\"Time origin\"@{nl=\"Herkomst tijdregistratie\"},values={timer=\"Observed timer\"@{nl=\"Gemeten timer\"},manual=\"Manual entry\"@{nl=\"Handmatige registratie\"}}}, reason:text?, author:user server=actor, overlap_reason:text? label=\"Overlap exception\"@{nl=\"Overlapuitzondering\"}, overlap_author:user?, state:enum(draft,submitted,approved,exported,superseded)=draft, review:PeriodReview?, correction:Correction?, decision:text?, exported_source:text?, delivery:text? } label=\"Time entry\"@{nl=\"Tijdregistratie\"}\n  PeriodReview in Employee { from:datetime, until:datetime, entries:Entry[]!, state:enum(submitted,approved,rejected,withdrawn)=submitted, submitted_by:user server=actor, decided_by:user?, reason:text? } label=\"Period review\"@{nl=\"Periodebeoordeling\"}\n  Correction in Entry { reason:text, replacement:Entry, author:user server=actor, original_source:text?, amount:money, cancel_delivery:text?, cancel_status:enum(pending,succeeded,failed,unknown)=pending, fenced:bool=false, fence_revision:int=0, absent:bool=false, revision:int=0, collected:money, refunded:money, collection_pending:bool=true, refund_pending:bool=false, refund_delivery:text?, refund_revision:int=0, refund_status:enum(pending,succeeded,failed,unknown)?, reconcile_delivery:text?, reconcile_status:enum(pending,succeeded,failed,unknown)? } label=\"Time correction\"@{nl=\"Tijdcorrectie\"}\n  derive Entry.duration:duration = (row.until??now)-row.from\n  derive Entry.amount:money = row.rate*(row.duration/1h)\n  derive Correction.ready:bool = row.fenced and (row.absent or (row.revision>0 and row.revision>=row.fence_revision and not row.collection_pending and not row.refund_pending and row.collected==row.refunded))\n  derive overlaps_work(employee:Employee,from:datetime,until:datetime,skip:Entry?):bool = any(employee.Entry as entry,entry!=skip and entry.state!=superseded and (entry.until==null and entry.from<until or (entry.until!=null and overlaps(from,until,entry.from,entry.until))))\n  policy Project read=members and can_work(actor,row.location)\n  policy Entry read=members where=row.parent.user==actor\n  policy Entry read=project_manager and can_work(actor,row.project.location)\n  policy PeriodReview read=members where=row.parent.user==actor\n  policy PeriodReview read=project_manager and all(row.entries as entry,can_work(actor,entry.project.location))\n  policy Correction read=members where=row.parent.parent.user==actor\n  policy Correction read=project_manager and can_work(actor,row.parent.project.location)\n  invariant Project: row.rate.minor>=0 and (row.customer==null or row.location in row.customer.locations)\n  invariant Entry: row.until==null or row.until>row.from\n  invariant PeriodReview: row.from<row.until and count(row.entries)>0 and all(row.entries as entry,entry.parent==row.parent and entry.until!=null and row.from<=entry.from and entry.until<=row.until)\n  unique Entry fields=parent where=row.until==null\n  unique Correction fields=parent\n  lock Entry fields=project,service,description,from,until,rate,billable,origin,reason,author,overlap_reason,overlap_author when=row.state in [submitted,approved,exported,superseded]\n  lock PeriodReview fields=from,until,entries,submitted_by\n  lock Correction fields=reason,replacement,author,original_source,amount\n  fixture time_manager=user {roles=[project_manager]}\n  fixture time_technician=user {}\n  fixture manager_employee=Employee {user=time_manager,home=test_site,locations=[test_site],start=date(\"2020-01-01\"),role=\"Project manager\"}\n  fixture technician_employee=Employee {user=time_technician,home=test_site,locations=[test_site],start=date(\"2020-01-01\"),role=\"Technician\"}\n  fixture project=Project {name=\"Repair\",location=test_site,customer=test_company,rate=money(30,\"EUR\")}\n  fixture stopped=Entry {parent=test_worker,project=project,description=\"Visit\",from=datetime(\"2026-10-01T22:00:00Z\"),until=datetime(\"2026-10-02T02:00:00Z\"),rate=money(30,\"EUR\"),origin=timer}\n  fixture prior=Entry {parent=test_worker,project=project,description=\"Original source\",from=datetime(\"2026-09-30T10:00:00Z\"),until=datetime(\"2026-09-30T14:00:00Z\"),rate=money(30,\"EUR\"),origin=timer,state=superseded,exported_source=\"prior-source\"}\n  fixture adjustment=Correction {parent=prior,reason=\"Corrected exported time\",replacement=stopped,original_source=\"prior-source\",amount=money(120,\"EUR\"),fenced=true,fence_revision=2,revision=2,collected=money(120,\"EUR\"),refunded=money(120,\"EUR\"),collection_pending=false}\n  fixture review=PeriodReview {parent=test_worker,from=datetime(\"2026-10-01T00:00:00Z\"),until=datetime(\"2026-10-03T00:00:00Z\"),entries=[stopped]}\n When\n  crud Project by=project_manager fields=name,rate,active create_fields=name,location,customer,rate when=can_work(actor,row.location) delete=none\n  # Return the current timer or begin observed work at server time with the current rate. @{nl=\"Geef de huidige timer terug of begin gemeten werk op servertijd met het huidige tarief.\"}\n  scenario start(employee:Employee,project:Project,description:text,billable:bool=true label=label_Entry_billable,service:Job?=null) -> Entry by=members\n   require employee.user==actor and employee.active and project.active and can_work(actor,project.location)\n   require service==null or (service.employee==employee and service.location==project.location and (project.customer==null or service.customer==project.customer))\n   do\n    let running=first(employee.Entry as entry where entry.until==null order=entry.id)\n    if running!=null\n     require running.project==project and running.description==description and running.billable==billable and running.service==service\n     return running\n    require not any(employee.Entry as entry,entry.state!=superseded and entry.until!=null and entry.until>now)\n    create Entry {parent=employee,project,service,description,from=now,rate=project.rate,billable,origin=timer} as entry\n    return entry\n  # Fix a running timer's end once while checking the final interval. @{nl=\"Leg de eindtijd van een lopende timer eenmaal vast en controleer het definitieve tijdvak.\"}\n  ## Closing already-started own work does not grant new work after employment/location revocation.\n  scenario stop(entry:Entry) by=members\n   require entry.parent.user==actor and entry.state==draft\n   do\n    if entry.until==null\n     require now>entry.from and (not overlaps_work(entry.parent,entry.from,now,entry) or entry.overlap_reason!=null)\n     set entry {until=now}\n   examples seed=[test_worker] entry=stopped\n    as,entry.state,test_worker.active,entry.until -> entry.until,entry.duration,entry.amount\n    members,draft,true,datetime(\"2026-10-02T02:00:00Z\") -> datetime(\"2026-10-02T02:00:00Z\"),4h,money(120,\"EUR\")\n    members,approved,true,datetime(\"2026-10-02T02:00:00Z\") -> error(rule_failed)\n    public,draft,true,datetime(\"2026-10-02T02:00:00Z\") -> error(forbidden)\n    members,draft,false,null -> now,now-datetime(\"2026-10-01T22:00:00Z\"),money(30,\"EUR\")*((now-datetime(\"2026-10-01T22:00:00Z\"))/1h)\n    members,draft,false,datetime(\"2026-10-02T02:00:00Z\") -> datetime(\"2026-10-02T02:00:00Z\"),4h,money(120,\"EUR\")\n  # Record forgotten work with its author and reason; only a manager can grant a recorded overlap exception. @{nl=\"Registreer vergeten werk met auteur en reden; alleen een manager mag een vastgelegde overlapuitzondering toestaan.\"}\n  scenario manual(employee:Employee,project:Project,description:text,from:datetime label=label_Entry_from,until:datetime label=label_Entry_until,billable:bool label=label_Entry_billable,reason:text,service:Job?=null,exception:text?=null) -> Entry by=members or project_manager\n   require (employee.user==actor or project_manager) and employee.active and project.active and can_work(actor,project.location) and from<until and until<=now and trim(reason)!=\"\"\n   require service==null or (service.employee==employee and service.location==project.location and (project.customer==null or service.customer==project.customer))\n   do\n    let overlap=overlaps_work(employee,from,until,null)\n    require not overlap or (project_manager and trim(exception??\"\")!=\"\")\n    create Entry {parent=employee,project,service,description,from,until,rate=project.rate,billable,origin=manual,reason} as entry\n    if overlap\n     set entry {overlap_reason=exception,overlap_author=actor}\n    return entry\n   examples seed=[stopped] employee=test_worker project=project description=\"Forgotten visit\" from=datetime(\"2026-10-02T03:00:00Z\") until=datetime(\"2026-10-02T04:00:00Z\") billable=true reason=\"Forgot timer\"\n    as,from,exception -> result.origin,result.amount,result.overlap_reason\n    members,datetime(\"2026-10-02T03:00:00Z\"),null -> manual,money(30,\"EUR\"),null\n    members,datetime(\"2026-10-02T01:00:00Z\"),null -> error(rule_failed)\n    project_manager,datetime(\"2026-10-02T01:00:00Z\"),\"Approved concurrent work\" -> manual,money(90,\"EUR\"),\"Approved concurrent work\"\n  # Revise own finished draft work without changing its frozen rate or service identity. @{nl=\"Wijzig eigen afgerond conceptwerk zonder het vastgelegde tarief of de service-identiteit te wijzigen.\"}\n  scenario revise(entry:Entry,description:text,from:datetime,until:datetime,billable:bool,reason:text,exception:text?=null) by=members or project_manager\n   require (entry.parent.user==actor or project_manager) and can_work(actor,entry.project.location) and entry.state==draft and entry.until!=null and from<until and until<=now and trim(reason)!=\"\"\n   do\n    let overlap=overlaps_work(entry.parent,from,until,entry)\n    require not overlap or (project_manager and trim(exception??\"\")!=\"\")\n    set entry {description,from,until,billable,origin=manual,reason,overlap_reason=null,overlap_author=null}\n    if overlap\n     set entry {overlap_reason=exception,overlap_author=actor}\n  # Freeze all finished draft entries wholly inside a period as one attributed submission. @{nl=\"Leg alle afgeronde conceptregistraties binnen een periode vast als één toegeschreven indiening.\"}\n  scenario submit(employee:Employee,from:datetime,until:datetime) -> PeriodReview by=members\n   require employee.user==actor and employee.active and from<until and until<=now\n   do\n    require not any(employee.Entry as entry,entry.state!=superseded and entry.from<until and (entry.until==null or entry.until>from) and (entry.until==null or entry.from<from or entry.until>until))\n    let entries=employee.Entry as entry where entry.state==draft and entry.until!=null and from<=entry.from and entry.until<=until order=entry.from\n    require count(entries)>0\n    create PeriodReview {parent=employee,from,until,entries} as review\n    for entry in entries limit=500\n     set entry {state=submitted,review=review,decision=null}\n    return review\n   examples employee=test_worker from=datetime(\"2026-10-01T00:00:00Z\") until=datetime(\"2026-10-03T00:00:00Z\") seed=[stopped]\n    stopped.state -> stopped.state,result.state,count(result.entries)\n    draft -> submitted,submitted,1\n    approved -> error(rule_failed)\n  # Decide the frozen period under every entry's current location grant, retaining the reviewer and reason. @{nl=\"Beoordeel de vastgelegde periode onder de actuele locatierechten van elke registratie en bewaar beoordelaar en reden.\"}\n  scenario decide(review:PeriodReview,approve:bool,reason:text) by=project_manager\n   require review.state==submitted and trim(reason)!=\"\" and all(review.entries as entry,entry.state==submitted and entry.review==review and can_work(actor,entry.project.location))\n   do\n    if approve\n     set review {state=approved,decided_by=actor,reason}\n    else\n     set review {state=rejected,decided_by=actor,reason}\n    for entry in review.entries limit=500\n     if approve\n      set entry {state=approved,decision=reason}\n     else\n      set entry {state=draft,decision=reason}\n   examples review=review reason=\"Reviewed period\"\n    as,approve,stopped.state,stopped.review -> review.state,stopped.state,review.decided_by\n    project_manager,true,submitted,review -> approved,approved,self\n    project_manager,false,submitted,review -> rejected,draft,self\n    members,true,submitted,review -> error(forbidden)\n  # Withdraw a submitted period with an attributed explanation and restore its editable drafts. @{nl=\"Trek een ingediende periode in met een toegeschreven toelichting en herstel bewerkbare concepten.\"}\n  scenario withdraw(review:PeriodReview,reason:text) by=members or project_manager\n   require review.state==submitted and trim(reason)!=\"\" and (review.parent.user==actor or project_manager) and all(review.entries as entry,entry.state==submitted and entry.review==review and can_work(actor,entry.project.location))\n   do\n    set review {state=withdrawn,decided_by=actor,reason}\n    for entry in review.entries limit=500\n     set entry {state=draft,decision=reason}\n  # Preserve approved evidence, retire its active interval and create an attributed replacement for a new review. @{nl=\"Bewaar goedgekeurd bewijs, beëindig het actieve tijdvak en maak een toegeschreven vervanging voor een nieuwe beoordeling.\"}\n  scenario correct(entry:Entry,from:datetime,until:datetime,reason:text,exception:text?=null) -> Entry by=project_manager\n   require can_work(actor,entry.project.location) and entry.state in [approved,exported] and (entry.correction==null or entry.correction.ready) and entry.until!=null and from<until and until<=now and trim(reason)!=\"\"\n   do\n    let overlap=overlaps_work(entry.parent,from,until,entry)\n    require not overlap or trim(exception??\"\")!=\"\"\n    create Entry {parent=entry.parent,project=entry.project,service=entry.service,description=entry.description,from,until,rate=entry.rate,billable=entry.billable,origin=manual,reason} as replacement\n    create Correction {parent=entry,reason,replacement,original_source=entry.exported_source,amount=entry.amount,collected=money(0,entry.rate.currency),refunded=money(0,entry.rate.currency)} as correction\n    set entry {state=superseded}\n    set replacement {correction=correction}\n    if overlap\n     set replacement {overlap_reason=exception,overlap_author=actor}\n    if correction.original_source!=null\n     send Billing.cancel {source=correction.original_source,reason} as cancellation\n     set correction {cancel_delivery=cancellation.id}\n    else\n     set correction {fenced=true,absent=true,collection_pending=false}\n    return replacement\n   examples entry=stopped from=datetime(\"2026-10-01T22:00:00Z\") until=datetime(\"2026-10-02T01:00:00Z\") reason=\"End time corrected\"\n    as,entry.state -> entry.state,entry.until,result.amount,result.correction.ready,result.correction.author\n    project_manager,approved -> superseded,datetime(\"2026-10-02T02:00:00Z\"),money(90,\"EUR\"),true,self\n    members,approved -> error(forbidden)\n    project_manager,draft -> error(rule_failed)\n   examples seed=[manager_employee,technician_employee,project]\n    do\n     call manual {employee=technician_employee,project=project,description=\"Forgotten overnight visit\",from=datetime(\"2026-10-01T22:00:00Z\"),until=datetime(\"2026-10-02T02:00:00Z\"),billable=true,reason=\"Forgot timer\"} by=time_technician as original\n     original.origin,original.duration,original.amount,original.author -> manual,4h,money(120,\"EUR\"),time_technician\n     call submit {employee=technician_employee,from=datetime(\"2026-10-01T00:00:00Z\"),until=datetime(\"2026-10-03T00:00:00Z\")} by=time_technician as submitted\n     let frozen=first(technician_employee.Entry as row where row.id==original.id order=row.id)\n     frozen!=null -> true\n     call revise {entry=frozen,description=\"Changed under review\",from=frozen.from,until=datetime(\"2026-10-02T01:00:00Z\"),billable=true,reason=\"Shorter visit\"} by=time_technician -> error(rule_failed)\n     call decide {review=submitted,approve=true,reason=\"Visit checked\"} by=time_manager\n     call Project.update {record=project,changes={rate=money(60,\"EUR\")}} by=time_manager\n     let approved_entry=first(technician_employee.Entry as row where row.id==original.id order=row.id)\n     approved_entry!=null -> true\n     approved_entry.state,approved_entry.rate,approved_entry.amount -> approved,money(30,\"EUR\"),money(120,\"EUR\")\n     call correct {entry=approved_entry,from=approved_entry.from,until=datetime(\"2026-10-02T01:00:00Z\"),reason=\"Actual visit ended earlier\"} by=time_manager as replacement\n     replacement.correction!=null -> true\n     replacement.rate,replacement.amount,replacement.correction.author,replacement.correction.ready -> money(30,\"EUR\"),money(90,\"EUR\"),time_manager,true\n     call bill {entry=replacement} by=time_manager -> error(rule_failed)\n     call submit {employee=technician_employee,from=datetime(\"2026-10-01T00:00:00Z\"),until=datetime(\"2026-10-03T00:00:00Z\")} by=time_technician as replacement_review\n     call decide {review=replacement_review,approve=true,reason=\"Correction checked\"} by=time_manager\n     let billable=first(technician_employee.Entry as row where row.id==replacement.id order=row.id)\n     billable!=null -> true\n     call bill {entry=billable} by=time_manager\n     let exported_entry=first(technician_employee.Entry as row where row.id==replacement.id order=row.id)\n     exported_entry!=null -> true\n     let preserved=first(technician_employee.Entry as row where row.id==original.id order=row.id)\n     preserved!=null -> true\n     preserved.state,preserved.until,preserved.amount,exported_entry.state,exported_entry.amount,exported_entry.exported_source,count(preserved.Correction) -> superseded,datetime(\"2026-10-02T02:00:00Z\"),money(120,\"EUR\"),exported,money(90,\"EUR\"),exported_entry.id,1\n  # Queue the approved frozen source once after any prior exported source is fenced and financially neutral. @{nl=\"Zet de goedgekeurde vastgelegde bron eenmaal in de wachtrij nadat een eerdere geëxporteerde bron is afgeschermd en financieel vereffend.\"}\n  scenario bill(entry:Entry) by=project_manager\n   require can_work(actor,entry.project.location) and entry.state==approved and entry.billable and entry.project.customer!=null and entry.amount.minor>0 and (entry.correction==null or entry.correction.ready)\n   do\n    send Billing.charge {value={source=entry.id,customer=entry.project.customer.id,location=entry.project.location.id,description=entry.description,amount=entry.amount,due=local_date(now,entry.project.location.timezone)}} as delivery\n    set entry {state=exported,exported_source=entry.id,delivery=delivery.id}\n   examples entry=stopped seed=[adjustment]\n    as,entry.state,entry.correction,adjustment.revision,adjustment.collection_pending,adjustment.refunded -> entry.state,entry.exported_source\n    project_manager,approved,adjustment,2,false,money(120,\"EUR\") -> exported,stopped.id\n    project_manager,approved,adjustment,1,false,money(120,\"EUR\") -> error(rule_failed)\n    project_manager,approved,adjustment,2,true,money(120,\"EUR\") -> error(rule_failed)\n    project_manager,approved,adjustment,2,false,money(0,\"EUR\") -> error(rule_failed)\n  # Retry a definite failed original-source cancellation without releasing the replacement. @{nl=\"Probeer een definitief mislukte annulering van de oorspronkelijke bron opnieuw zonder de vervanging vrij te geven.\"}\n  scenario retry_cancel(correction:Correction) by=project_manager\n   require can_work(actor,correction.parent.project.location) and correction.original_source!=null and correction.cancel_status==failed and not correction.fenced\n   do\n    send Billing.cancel {source=correction.original_source,reason=correction.reason} as delivery\n    set correction {cancel_delivery=delivery.id,cancel_status=pending}\n  # Refresh original-source balances without confusing delivery with settlement. @{nl=\"Ververs saldi van de oorspronkelijke bron zonder verzending met afwikkeling te verwarren.\"}\n  scenario reconcile(correction:Correction) by=project_manager\n   require can_work(actor,correction.parent.project.location) and correction.original_source!=null\n   do\n    send Billing.reconcile {source=correction.original_source} as delivery\n    set correction {reconcile_delivery=delivery.id,reconcile_status=pending}\n  # Ask the invoice owner to refund remaining original-source funds only after uncertainty has cleared. @{nl=\"Vraag de factuureigenaar resterende bronbedragen terug te betalen zodra onzekerheid is verdwenen.\"}\n  scenario refund(correction:Correction,reason:text) by=project_manager\n   require can_work(actor,correction.parent.project.location) and correction.original_source!=null and correction.fenced and correction.revision>0 and not correction.collection_pending and not correction.refund_pending and correction.collected>correction.refunded and (correction.refund_status==null or correction.refund_status==failed or (correction.refund_status==succeeded and correction.revision>correction.refund_revision)) and trim(reason)!=\"\"\n   do\n    send Billing.refund {source=correction.original_source,amount=correction.collected-correction.refunded,reason} as delivery\n    set correction {refund_delivery=delivery.id,refund_revision=correction.revision,refund_status=pending}\n  scenario cancelled on=Billing.cancel.completed\n   do\n    for correction in Correction as row where row.cancel_delivery==event.delivery_id limit=1\n     set correction {cancel_status=event.status}\n     if event.status==succeeded and event.result!=null and event.result.source==correction.original_source and event.result.state in [released,pending,unavailable]\n      set correction {fenced=true,fence_revision=event.result.revision}\n      if event.result.state==released and event.result.reference==null\n       set correction {absent=true,collection_pending=false}\n  scenario refunded on=Billing.refund.completed\n   do\n    for correction in Correction as row where row.refund_delivery==event.delivery_id limit=1\n     set correction {refund_status=event.status}\n     if event.status==succeeded and event.result!=null and event.result.source==correction.original_source and event.result.state==unavailable\n      set correction {refund_status=failed}\n  scenario reconciled on=Billing.reconcile.completed\n   do\n    for correction in Correction as row where row.reconcile_delivery==event.delivery_id limit=1\n     set correction {reconcile_status=event.status}\n     if event.status==succeeded and event.result!=null and event.result.source==correction.original_source and event.result.amount==correction.amount and event.result.revision>correction.revision\n      set correction {absent=false,revision=event.result.revision,collected=event.result.collected,refunded=event.result.refunded,collection_pending=event.result.collection_pending,refund_pending=event.result.refund_pending}\n  scenario settled on=Billing.settled\n   do\n    for correction in Correction as row where row.original_source==event.value.source limit=1\n     require event.value.amount==correction.amount\n     if event.value.revision>correction.revision\n      set correction {absent=false,revision=event.value.revision,collected=event.value.collected,refunded=event.value.refunded,collection_pending=event.value.collection_pending,refund_pending=event.value.refund_pending}\n Then\n  # Start, stop and submit your own time with separate observed and entered evidence. @{nl=\"Start, stop en dien je eigen tijd in met afzonderlijk gemeten en ingevoerd bewijs.\"}\n  page /time/mine title=\"My time\"@{nl=\"Mijn tijd\"}\n   require members\n   ## Breadcrumbs show current declared ancestry; the shared right-sidebar shell supplies navigation, no per-app menu.\n   breadcrumbs\n   card \"Timer and manual time intake\"@{nl=\"Timer- en handmatige tijdinvoer\"} layout=columns\n    form start display=inline\n     ## service keeps its generated control; instants come from server time.\n     fieldset \"Start timer\"@{nl=\"Timer starten\"}\n      select employee\n      select project\n      textarea description\n      toggle billable\n    form manual\n     ## instants, service and the manager-only exception keep generated controls.\n     fieldset \"Manual entry\"@{nl=\"Handmatige registratie\"}\n      select employee\n      select project\n      textarea description\n      toggle billable\n      textarea reason\n    form submit\n     select employee\n   list Entry as entry where entry.parent.user==actor and entry.until==null\n    stat row.duration\n    text row.project,row.from\n    button action=stop\n   table Entry as entry where entry.parent.user==actor and (preferences.location==null or entry.project.location==preferences.location) and (preferences.week==null or (local_date(entry.from,team.timezone)>=preferences.week and local_date(entry.from,team.timezone)<add_days(preferences.week,7))) columns=project,service,description,from,until,origin,duration,rate,amount,state filter=project,project.location,from,until,billable,state defaults={project=preferences.project,billable=preferences.billable_filter} order=-from display=split\n    pagination\n    actions stop,revise\n    status row.billable\n    collapse \"Observed, entered and review evidence\"@{nl=\"Gemeten, ingevoerd en beoordelingsbewijs\"}\n     text row.author,row.reason,row.overlap_reason,row.overlap_author,row.decision,row.review\n    history\n   list group((Entry as entry where entry.parent.user==actor and entry.until!=null and entry.state!=superseded and (preferences.project==null or entry.project==preferences.project) and (preferences.location==null or entry.project.location==preferences.location) and (preferences.billable_filter==null or entry.billable==preferences.billable_filter) and (preferences.week==null or (local_date(entry.from,team.timezone)>=preferences.week and local_date(entry.from,team.timezone)<add_days(preferences.week,7)))) as entry,entry.rate.currency)\n    stat row.key,sum(row.items as entry select entry.duration),sum(row.items as entry select entry.amount,row.key)\n   table PeriodReview as review where review.parent.user==actor columns=from,until,state,reason\n    pagination\n    action withdraw\n    ## A rejection returns entries to draft; the reason stays visible on the frozen review.\n    alert\n     require row.state==rejected\n     text row.reason\n    history\n  # Review fixed periods and preserve correction financial uncertainty until the invoice owner resolves it. @{nl=\"Beoordeel vastgelegde periodes en bewaar financiële correctieonzekerheid totdat de factuureigenaar deze oplost.\"}\n  page /time/review title=\"Time review\"@{nl=\"Tijdbeoordeling\"}\n   require project_manager\n   breadcrumbs\n   card \"Project rates\"@{nl=\"Projecttarieven\"}\n    form Project.create\n     ## rate keeps its generated money control.\n     fieldset \"New project\"@{nl=\"Nieuw project\"}\n      input name\n      select location\n      select customer\n    table Project columns=name,location,customer,rate,active\n     pagination\n     edit\n   table PeriodReview columns=parent,from,until,state,decided_by,reason filter=parent,from,until,state order=-from display=split\n    pagination\n    actions withdraw\n    button opens=decide_dialog\n    ## The dialog keeps the frozen review row; approval and reason are the entered inputs.\n    modal \"Decide period\"@{nl=\"Periode beoordelen\"} id=decide_dialog\n     slot content\n      form decide arguments={review=row} display=inline\n       toggle approve\n       textarea reason\n    alert\n     require row.state==rejected\n     text row.reason\n    table row.entries columns=project,from,until,rate,amount,overlap_reason,overlap_author,state\n     pagination\n    history\n   table Entry as entry where preferences.location==null or entry.project.location==preferences.location columns=parent,project,from,until,rate,amount,state filter=parent,project,project.location,from,until,state,billable defaults={project=preferences.project,billable=preferences.billable_filter} order=-from display=split\n    pagination\n    actions correct,bill\n    collapse \"Correction and billing evidence\"@{nl=\"Correctie- en facturatiebewijs\"}\n     text row.service,row.origin,row.billable,row.reason,row.decision,row.exported_source,row.delivery\n     table row.Correction columns=reason,replacement,author,original_source,cancel_status,collected,refunded,collection_pending,refund_pending,refund_status,reconcile_status,ready\n      pagination\n      actions retry_cancel,reconcile,refund\n    history\n   list group((Entry as entry where entry.state==approved and entry.billable and (preferences.project==null or entry.project==preferences.project) and (preferences.location==null or entry.project.location==preferences.location)) as entry,entry.rate.currency)\n    stat row.key,sum(row.items as entry select entry.amount,row.key)\n    table row.items columns=parent,project,duration,rate,amount,state\n     pagination\n     action bill\n"}}
