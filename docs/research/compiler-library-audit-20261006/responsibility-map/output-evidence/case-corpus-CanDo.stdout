{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"3392e8b5974ba29be8abe202bd376cc9b437067498902b211fe16b4571fb2e40","before_projection_sha256":"3392e8b5974ba29be8abe202bd376cc9b437067498902b211fe16b4571fb2e40","changed":false,"idempotent":true,"structure_equal":true,"text":"# Help workspace staff coordinate daily opening, closing, room preparation, and customer follow-up tasks. @{nl=\"Help werkplekpersoneel dagelijkse openings-, sluitings-, ruimtevoorbereidings- en klantopvolgingstaken coördineren.\"}\napp CanDo uses=[todo]\n\n# Track ordinary tasks and route federated work to its owning business operation. @{nl=\"Volg gewone taken en leid werk uit bronsystemen naar de eigen bedrijfsoperatie.\"}\npackage todo\n use rent_catalog {Location}\n use employee {can_work,staff,test_worker}\n use std {ErrorsV1 as Catch} from=deployment.errors\n use todo {WorkSourcesV1 as WorkSources} from=deployment.work_sources\n use maintain {inspect,work as maintenance_work,work_detail as maintenance_detail} from=deployment.maintenance\n use success {complete as complete_account,work as accounts_work,work_detail as accounts_detail} from=deployment.accounts\n use onboard {complete as complete_step,work as onboarding_work,work_detail as onboarding_detail} from=deployment.onboarding\n use board {complete as complete_board,work as board_work,work_detail as board_detail} from=deployment.board\n use volunteer {complete as complete_volunteer,work as volunteering_work,work_detail as volunteering_detail} from=deployment.volunteering\n Given\n  export contract WorkItem { source:text label=label_WorkItem_source, reference:text, revision:int, location:text?, title:text, detail:text? label=label_WorkItem_detail, due:datetime?, state:enum(open,done,stale,unavailable) label={text=label_WorkItem_state,values={open=\"Open\"@{nl=\"Open\"},done=\"Done\"@{nl=\"Gereed\"},stale=label_WorkItem_state_stale,unavailable=label_WorkItem_state_unavailable}}, action:action(inspect,complete_account,complete_step,complete_board,complete_volunteer)? label=\"Source action\"@{nl=\"Bronactie\"} } label=\"Source work item\"@{nl=\"Werk uit bronsysteem\"}\n  export contract WorkSourceState { source:text label=label_WorkItem_source, state:enum(fresh,stale,unavailable) label={text=label_WorkItem_state,values={stale=label_WorkItem_state_stale,unavailable=label_WorkItem_state_unavailable,fresh=label_WorkSourceState_state_fresh}}, detail:text? label=label_WorkItem_detail } label=source_freshness_caption\n  export contract WorkBatch { items:WorkItem[] max=500 label=label_WorkBatch_items, states:WorkSourceState[]! min=5 max=5 label=\"Source states\"@{nl=\"Bronstatussen\"} } label=\"Source work batch\"@{nl=\"Bundel werk uit bronsystemen\"}\n  derive source_names():text[] = [\"maintenance\",\"accounts\",\"onboarding\",\"board\",\"volunteering\"]\n  # Map the five imported owner work/detail reads explicitly under verified principal/team delegation; source names and action targets stay closed. @{nl=\"Koppel de vijf geïmporteerde bron- en detaillezingen expliciet met geverifieerde gebruiker-/teamdelegatie; bronnamen en actiedoelen blijven begrensd.\"}\n  export capability WorkSourcesV1 version=1\n   work(account:user,locations:text[]) -> WorkBatch\n  role task_manager label=\"Checklist manager\"@{nl=\"Checklistbeheerder\"}\n  export Task { location:Location?, title:text trim min=1, description:text?, due:datetime?, priority:enum(low,normal,high)=normal label={text=\"Task priority\"@{nl=\"Taakprioriteit\"},values={low=\"Low\"@{nl=\"Laag\"},normal=\"Normal\"@{nl=\"Normaal\"},high=\"High\"@{nl=\"Hoog\"}}}, assignee:user? label=\"Assignee\"@{nl=\"Toegewezen aan\"}, done:bool=false, completed_by:user? label=\"Completed by\"@{nl=\"Afgerond door\"}, completed_at:datetime? label=\"Completion time\"@{nl=\"Afgerond op\"} } label=\"Task\"@{nl=\"Taak\"}\n  Comment in Task { body:text trim min=1, author:user server=actor label=\"Author\"@{nl=\"Auteur\"} } label=\"Task comment\"@{nl=\"Taakreactie\"}\n  Template { name:text, location:Location? } label=label_Template\n  TemplateTask in Template { title:text, offset:duration=0m label=\"Due offset\"@{nl=\"Deadlineverschuiving\"}, priority:Task.priority=normal } label=\"Template task\"@{nl=\"Sjabloontaak\"}\n  Generation { template:Template label=label_Template, reference:text unique, due:datetime } label=\"Checklist generation\"@{nl=\"Checklistgeneratie\"}\n  WorkView { account:user label=\"Account\"@{nl=\"Account\"}, items:WorkItem[] label=label_WorkBatch_items, sources:WorkSourceState[] label=\"Sources\"@{nl=\"Bronnen\"}, state:enum(pending,fresh,partial,unavailable)=pending label={text=label_WorkItem_state,values={unavailable=label_WorkItem_state_unavailable,fresh=label_WorkSourceState_state_fresh,pending=\"Pending\"@{nl=\"In behandeling\"},partial=\"Partial\"@{nl=\"Gedeeltelijk\"}}}, current:bool=true label=\"Current projection\"@{nl=\"Actuele projectie\"}, expires:datetime=now+25h label=\"Projection expiry\"@{nl=\"Vervaltijd projectie\"}, requested:datetime label=\"Requested at\"@{nl=\"Aangevraagd op\"}, delivery:text unique label=\"Delivery reference\"@{nl=\"Afleverreferentie\"} } label=\"My work projection\"@{nl=\"Projectie mijn werk\"}\n  policy Task read=members and staff(actor) where=row.location==null or can_work(actor,row.location)\n  policy Comment read=members and staff(actor) where=row.parent.location==null or can_work(actor,row.parent.location)\n  policy Template read=task_manager and staff(actor) where=row.location==null or can_work(actor,row.location)\n  policy TemplateTask read=task_manager and staff(actor) where=row.parent.location==null or can_work(actor,row.parent.location)\n  policy Generation read=task_manager and staff(actor) where=row.template.location==null or can_work(actor,row.template.location)\n  policy WorkView read=members where=row.account==actor\n  unique WorkView fields=account where=row.current\n  retain WorkView until=row.expires\n  lock WorkView fields=account,requested,delivery\n  invariant Task: row.assignee==null or (active_member(row.assignee,team) and staff(row.assignee))\n  lock Comment fields=body,author\n  fixture open_task=Task {title=\"Opening checks\",assignee=self}\n  fixture work_view=WorkView {account=self,requested=datetime(\"2026-10-03T09:00:00Z\"),delivery=\"work-test\"}\n  preferences { location:Location?, done:bool?, view:enum(all,today,overdue)=all label={text=\"Task view\"@{nl=\"Taakweergave\"},values={all=\"All tasks\"@{nl=\"Alle taken\"},today=\"Due today\"@{nl=\"Vandaag verschuldigd\"},overdue=\"Overdue\"@{nl=\"Te laat\"}}} }\n  invariant preferences: row.location==null or can_work(actor,row.location)\n  message source_freshness_caption = \"Source freshness\"@{nl=\"Actualiteit bron\"}\n  message label_WorkItem_source = \"Source reference\"@{nl=\"Bronreferentie\"}\n  message label_WorkItem_detail = \"Details\"@{nl=\"Details\"}\n  message label_WorkItem_state = \"State\"@{nl=\"Status\"}\n  message label_WorkItem_state_stale = \"Stale\"@{nl=\"Verouderd\"}\n  message label_WorkItem_state_unavailable = \"Unavailable\"@{nl=\"Niet beschikbaar\"}\n  message label_WorkSourceState_state_fresh = \"Fresh\"@{nl=\"Actueel\"}\n  message label_WorkBatch_items = \"Items\"@{nl=\"Items\"}\n  message label_Template = \"Checklist template\"@{nl=\"Checklistsjabloon\"}\n When\n  crud Task by=members fields=location,title,description,due,priority,assignee when=staff(actor) and (row.location==null or can_work(actor,row.location))\n  crud Comment by=members fields=body update=none delete=none when=staff(actor) and (row.parent.location==null or can_work(actor,row.parent.location))\n  crud Template by=task_manager fields=name,location when=staff(actor) and (row.location==null or can_work(actor,row.location))\n  crud TemplateTask by=task_manager fields=title,offset,priority when=staff(actor) and (row.parent.location==null or can_work(actor,row.parent.location)) delete=remove\n  # Complete an ordinary task with actor and time. @{nl=\"Rond een gewone taak af met uitvoerder en tijd.\"}\n  export scenario complete(task:Task) by=members\n   require staff(actor) and (task.location==null or can_work(actor,task.location)) and not task.done\n   do set task {done=true,completed_by=actor,completed_at=now}\n   examples seed=[test_worker] task=open_task\n    task.done -> task.done,task.completed_by\n    false -> true,self\n    true -> error(rule_failed)\n  # Reopen ordinary work; federated approvals use their source operation. @{nl=\"Heropen gewoon werk; goedkeuringen uit bronsystemen gebruiken hun eigen operatie.\"}\n  scenario reopen(task:Task) by=members\n   require staff(actor) and task.done and (task.location==null or can_work(actor,task.location))\n   do set task {done=false,completed_by=null,completed_at=null}\n  # Copy a checklist once without changing existing generated tasks. @{nl=\"Kopieer een checklist één keer zonder bestaande gegenereerde taken te wijzigen.\"}\n  scenario generate(template:Template,due:datetime) by=task_manager label=\"Generate tasks from checklist\"@{nl=\"Taken uit checklist genereren\"}\n   require staff(actor) and (template.location==null or can_work(actor,template.location))\n   do\n    create Generation {template,reference=operation.id,due} as generation\n    for item in template.TemplateTask limit=100\n     create Task {location=template.location,title=item.title,due=due+item.offset,priority=item.priority} as task\n  # Request only work the current actor can perform at its source. @{nl=\"Vraag uitsluitend werk op dat de huidige uitvoerder bij de bron mag uitvoeren.\"}\n  scenario refresh(locations:text[] label=\"Locations\"@{nl=\"Locaties\"}) by=members\n   require staff(actor)\n   require not any(WorkView as view,view.account==actor and view.current and view.state==pending)\n   do\n    for previous in WorkView as view where view.account==actor and view.current limit=1\n     set previous {current=false,state=unavailable,items=[],sources=[]}\n    send WorkSources.work {account=actor,locations} as delivery\n    create WorkView {account=actor,requested=now,delivery=delivery.id} as view\n  scenario work_result on=WorkSources.work.completed\n   do\n    for view in WorkView as v where v.delivery==event.delivery_id and v.current and v.state==pending limit=1\n     set view {state=unavailable,items=[],sources=[],expires=now+1m}\n     if active_member(view.account,team) and staff(view.account) and event.status==succeeded and event.result!=null\n      let batch=event.result\n      let valid_sources=count(batch.states)==count(source_names()) and all(source_names() as source,count(batch.states as entry where entry.source==source)==1)\n      if valid_sources and all(batch.items as item,any(batch.states as entry,entry.source==item.source) and (item.action==null or (item.state==open and any(batch.states as entry,entry.source==item.source and entry.state==fresh))))\n       set view {items=batch.items,sources=batch.states}\n       if all(batch.states as entry,entry.state==fresh)\n        set view {state=fresh}\n       else\n        if not all(batch.states as entry,entry.state==unavailable)\n         set view {state=partial}\n   examples seed=[work_view,test_worker]\n    event -> work_view.state\n    {delivery_id=\"work-test\",status=succeeded,result=WorkBatch {states=[WorkSourceState {source=\"maintenance\",state=fresh},WorkSourceState {source=\"accounts\",state=fresh},WorkSourceState {source=\"onboarding\",state=fresh},WorkSourceState {source=\"board\",state=fresh},WorkSourceState {source=\"volunteering\",state=fresh}]},error=null} -> fresh\n    {delivery_id=\"work-test\",status=succeeded,result=WorkBatch {states=[WorkSourceState {source=\"maintenance\",state=fresh},WorkSourceState {source=\"accounts\",state=unavailable},WorkSourceState {source=\"onboarding\",state=fresh},WorkSourceState {source=\"board\",state=fresh},WorkSourceState {source=\"volunteering\",state=fresh}]},error=null} -> partial\n    {delivery_id=\"work-test\",status=succeeded,result=WorkBatch {states=[WorkSourceState {source=\"maintenance\",state=stale},WorkSourceState {source=\"accounts\",state=stale},WorkSourceState {source=\"onboarding\",state=stale},WorkSourceState {source=\"board\",state=stale},WorkSourceState {source=\"volunteering\",state=stale}]},error=null} -> partial\n    {delivery_id=\"work-test\",status=succeeded,result=WorkBatch {states=[WorkSourceState {source=\"maintenance\",state=unavailable},WorkSourceState {source=\"accounts\",state=unavailable},WorkSourceState {source=\"onboarding\",state=unavailable},WorkSourceState {source=\"board\",state=unavailable},WorkSourceState {source=\"volunteering\",state=unavailable}]},error=null} -> unavailable\n    {delivery_id=\"work-test\",status=succeeded,result=WorkBatch {states=[WorkSourceState {source=\"maintenance\",state=fresh},WorkSourceState {source=\"accounts\",state=fresh},WorkSourceState {source=\"onboarding\",state=fresh},WorkSourceState {source=\"board\",state=fresh},WorkSourceState {source=\"board\",state=fresh}]},error=null} -> unavailable\n    {delivery_id=\"work-test\",status=failed,result=null,error={code=\"unavailable\",message=\"Source unavailable\"}} -> unavailable\n    {delivery_id=\"other-work\",status=failed,result=null,error={code=\"unavailable\",message=\"Source unavailable\"}} -> pending\n  scenario removed on=teams.member_removed\n   do\n    for task in Task as t where t.assignee==event.user limit=500\n     set task {assignee=null}\n  scenario report_error on=instrumentation.error\n   do send Catch.report {event=event} as delivery\n Then\n  # Add tasks quickly and follow location, due date and ownership. @{nl=\"Voeg taken snel toe en volg locatie, deadline en eigenaarschap.\"}\n  page /tasks title=\"Tasks\"@{nl=\"Taken\"}\n   require members\n   breadcrumbs\n   card \"Quick task entry\"@{nl=\"Snel een taak toevoegen\"}\n    form Task.create display=inline\n     ## assignee:user keeps its generated entry: no user-picker vocabulary.\n     fieldset \"Task details\"@{nl=\"Taakgegevens\"}\n      input title\n      radio priority\n      select location\n      textarea description\n      input due\n   tabs preferences.view\n   table Task as task where preferences.view==all or (task.due!=null and ((preferences.view==today and local_date(task.due,team.timezone)==local_date(now,team.timezone)) or (preferences.view==overdue and task.due<now and not task.done))) columns=title,assignee,due,priority,done order={by=preferences.view,default=[due],cases={all=[-created]}} filter=location,assignee,priority,done defaults={location=preferences.location,done=preferences.done} search=title display=split empty=\"No tasks match these filters.\"@{nl=\"Geen taken voor deze filters.\"}\n    pagination\n    text row.done\n    badge row.priority\n    card \"Current task\"@{nl=\"Huidige taak\"}\n     text row.title,row.assignee,row.due,row.priority,row.done,row.completed_by,row.completed_at\n     content row.description\n     edit\n     ## Completion and reopening stay canonical operations presented as quick actions.\n     fab\n      button action=complete\n      button action=reopen\n    card \"Attributed comments\"@{nl=\"Toegeschreven reacties\"}\n     form Comment.create\n      textarea body\n     list row.Comment empty=\"No comments yet.\"@{nl=\"Nog geen reacties.\"}\n      pagination\n      ## Comments are read-only messages; the bubble presents body and author without messaging behavior.\n      chat_bubble\n       slot content\n        content row.body\n       slot header\n        text row.author\n    history\n\n  # Keep unavailable source work visible without granting source authority. @{nl=\"Houd niet-beschikbaar bronwerk zichtbaar zonder bronbevoegdheid te verlenen.\"}\n  page /tasks/my-work title=\"My work\"@{nl=\"Mijn werk\"} poll=5s refresh=refresh\n   require members\n   breadcrumbs\n   card \"Refresh source work\"@{nl=\"Werk uit bronsystemen vernieuwen\"}\n    form refresh display=inline\n   divider \"Current projection\"@{nl=\"Actuele projectie\"}\n   list WorkView as view where view.account==actor and view.current order=-view.requested empty=\"No work projection yet.\"@{nl=\"Nog geen werkprojectie.\"}\n    pagination\n    text row.requested\n    badge row.state\n    ## Partial or unavailable coverage keeps its own notice; task completion never implies source freshness.\n    alert\n     require row.state==partial or row.state==unavailable\n     text \"Some sources are stale or unavailable; affected actions stay withheld.\"@{nl=\"Sommige bronnen zijn verouderd of niet beschikbaar; getroffen acties blijven achtergehouden.\"}\n    card source_freshness_caption\n     table row.sources columns=source,state,detail empty=\"No sources reported.\"@{nl=\"Geen bronnen gemeld.\"}\n      pagination\n      badge row.state\n    card \"Authorized work and actions\"@{nl=\"Toegestaan werk en acties\"}\n     table row.items columns=title,source,location,due,state filter=source,location,due,state empty=\"No authorized work items.\"@{nl=\"Geen toegestaan werk.\"}\n      pagination\n      badge row.state\n      content row.detail\n      form row.action\n    text \"Submit refresh once to enable automatic source refresh while this page remains open.\"@{nl=\"Vernieuw één keer om automatisch bronwerk te vernieuwen zolang deze pagina geopend blijft.\"}\n\n  # Author scoped checklists and generate independent dated tasks. @{nl=\"Beheer toegestane checklists en genereer zelfstandige gedateerde taken.\"}\n  page /tasks/checklists title=\"Checklist templates\"@{nl=\"Checklistsjablonen\"}\n   require task_manager\n   breadcrumbs\n   card \"Template intake\"@{nl=\"Sjabloon aanmaken\"}\n    form Template.create\n     input name\n     select location\n   list Template columns=name,location search=name display=split empty=\"No templates yet.\"@{nl=\"Nog geen sjablonen.\"}\n    pagination\n    card \"Template and generation\"@{nl=\"Sjabloon en generatie\"}\n     text row.name,row.location\n     edit\n     delete\n     form generate\n    card \"Template items\"@{nl=\"Sjabloonitems\"}\n     form TemplateTask.create\n     table row.TemplateTask columns=title,offset,priority order=offset empty=\"No template items yet.\"@{nl=\"Nog geen sjabloonitems.\"}\n      pagination\n      edit\n      delete\n"}}
