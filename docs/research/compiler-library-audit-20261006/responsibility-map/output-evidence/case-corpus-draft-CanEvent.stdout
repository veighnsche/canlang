{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"6c9f88030c69b7181323e4fdb4a789728c0e69707230ae19d0001dff9c89f551","before_projection_sha256":"6c9f88030c69b7181323e4fdb4a789728c0e69707230ae19d0001dff9c89f551","changed":true,"idempotent":true,"structure_equal":true,"text":"# Help workspace community teams sell or allocate places at networking sessions, workshops, and customer events. @{nl=\"Help werkplekcommunityteams plaatsen voor netwerksessies, workshops en klantevenementen verkopen of toewijzen.\"}\napp CanEvent uses=[events,invoice]\n\n# Own event ticket capacity and admission, with separate venue and customer collection owners. @{nl=\"Beheer toegangscapaciteit en toelating met afzonderlijke eigenaren voor evenementlocatie en klantinning.\"}\npackage events\n use rent_catalog {Location,test_site}\n use employee {can_work,test_worker}\n use customer {Customer,owns,has_location_role,test_company,test_booker}\n use rent_reservations {Resource}\n use rent_reservations {RoomsV1 as Rooms} from=deployment.rooms\n use invoice {Settlement}\n use std {OperationOutcome,DeliveryResult}\n use std {EmailV1 as Mail} from=deployment.mail\n use invoice {BillingV1 as Billing} from=deployment.billing\n Given\n  role organizer label=\"Event organizer\"@{nl=\"Evenementorganisator\"}\n  role finance label=\"Event finance\"@{nl=\"Evenementfinanciën\"}\n  role check_in label=\"Admission staff\"@{nl=\"Toegangsmedewerker\"}\n  Program { name:text unique } label=\"Event program\"@{nl=\"Evenementprogramma\"}\n  Event in Program { location:Location, name:text, description:text, timezone:timezone, from:datetime label=\"From\"@{nl=\"Vanaf\"}, until:datetime label=\"Until\"@{nl=\"Tot\"}, capacity:int min=1 label=\"Capacity\"@{nl=\"Capaciteit\"}, price:money, sales_until:datetime label=\"Sales close at\"@{nl=\"Verkoop sluit op\"}, refund_before:datetime label=\"Refund cutoff\"@{nl=\"Terugbetalingsgrens\"}, terms:text label=\"Terms\"@{nl=\"Voorwaarden\"}, venue:Change? label=\"Selected venue reservation\"@{nl=\"Gekozen locatiereservering\"}, venue_name:text? label=\"Venue\"@{nl=\"Evenementlocatie\"}, pending_change:Change? label=\"Pending material change\"@{nl=\"Materiële wijziging in behandeling\"}, revision:int=1 min=1, organizer:user server=actor label=\"Created by\"@{nl=\"Aangemaakt door\"}, cancellation_reason:text? label=\"Event cancellation reason\"@{nl=\"Reden evenementannulering\"}, published:bool=false label=\"Published\"@{nl=\"Gepubliceerd\"}, cancelled:bool=false label=label_Event_cancelled } label=\"Event\"@{nl=\"Evenement\"}\n  Registration in Event { settlement_revision:int=0 min=0, event_revision:int=0 min=0 label=\"Last event update applied\"@{nl=\"Laatst toegepaste evenementwijziging\"}, account:user label=\"Account\"@{nl=\"Account\"}, location:Location label=\"Original billing location\"@{nl=\"Oorspronkelijke facturatielocatie\"}, name:text, email:email, source:text unique label=\"Source reference\"@{nl=\"Bronreferentie\"}, price:money, terms:text label=\"Frozen ticket terms\"@{nl=\"Vastgelegde toegangsbewijsvoorwaarden\"}, refund_before:datetime label=\"Frozen refund cutoff\"@{nl=\"Vastgelegde terugbetalingsgrens\"}, refund_required:bool=false label=\"Return unfulfilled funds\"@{nl=\"Niet uitgevoerde bedragen terugbetalen\"}, refund_reason:text? label=\"Refund reason\"@{nl=\"Terugbetalingsreden\"}, refund_state:enum(none,pending,unknown,refunded,review)=none label={text=\"Refund outcome\"@{nl=\"Terugbetalingsresultaat\"},values={none=\"No refund requested\"@{nl=\"Geen terugbetaling aangevraagd\"},pending=\"Refund requested\"@{nl=\"Terugbetaling aangevraagd\"},unknown=\"Refund uncertain\"@{nl=\"Terugbetaling onzeker\"},refunded=\"Funds resolved\"@{nl=\"Bedragen afgehandeld\"},review=\"Finance review\"@{nl=\"Financiële beoordeling\"}}}, collected:money label=\"Collected funds\"@{nl=\"Geïnde bedragen\"}, refunded:money label=\"Returned funds\"@{nl=\"Terugbetaalde bedragen\"}, collection_pending:bool=false label=\"Collection unresolved\"@{nl=\"Inning onopgelost\"}, refund_pending:bool=false label=\"Refund unresolved\"@{nl=\"Terugbetaling onopgelost\"}, cancel_reason:text? label=\"Frozen collection cancellation reason\"@{nl=\"Vastgelegde reden annulering inning\"}, cancel_delivery:text? label=\"Collection cancellation request\"@{nl=\"Aanvraag annulering inning\"}, cancel_status:DeliveryResult.status? label=\"Cancellation delivery state\"@{nl=\"Status annuleringsverzending\"}, fenced:bool=false label=\"Collection source fenced\"@{nl=\"Inningsbron afgeschermd\"}, fence_revision:int=0 label=\"Cancellation ledger fence\"@{nl=\"Afwikkelingsgrens annulering\"}, absent:bool=false label=\"Invoice authoritatively absent\"@{nl=\"Factuur aantoonbaar afwezig\"}, invoice_state:Settlement.state? label=\"Invoice state\"@{nl=\"Factuurstatus\"}, refund_delivery:text? label=\"Refund request\"@{nl=\"Terugbetalingsaanvraag\"}, refund_target:money? label=\"Requested cumulative return\"@{nl=\"Aangevraagde cumulatieve terugbetaling\"}, refund_status:DeliveryResult.status? label=\"Refund delivery state\"@{nl=\"Status terugbetalingsverzending\"}, reconcile_delivery:text? label=\"Settlement refresh request\"@{nl=\"Aanvraag afwikkelingsverversing\"}, reconcile_status:DeliveryResult.status? label=\"Settlement refresh state\"@{nl=\"Status afwikkelingsverversing\"}, expires:datetime label=\"Expires at\"@{nl=\"Verloopt op\"}, state:enum(held,pending,confirmed,expired,cancelled,review)=held label={text=\"State\"@{nl=\"Status\"},values={cancelled=label_Event_cancelled,held=\"Held\"@{nl=\"Gereserveerd\"},pending=label_Registration_state_pending,confirmed=\"Confirmed\"@{nl=\"Bevestigd\"},expired=\"Expired\"@{nl=\"Verlopen\"},review=\"Needs resolution\"@{nl=\"Vereist beoordeling\"}}}, payment:enum(free,unpaid,pending,paid,refunded,unknown)=unpaid label={text=\"Payment state\"@{nl=\"Betaalstatus\"},values={pending=label_Registration_state_pending,free=\"Free\"@{nl=\"Gratis\"},unpaid=\"Unpaid\"@{nl=\"Onbetaald\"},paid=\"Paid\"@{nl=\"Betaald\"},refunded=\"Refunded\"@{nl=\"Terugbetaald\"},unknown=\"Unknown\"@{nl=\"Onbekend\"}}}, ticket:text unique label=\"Ticket\"@{nl=\"Toegangsbewijs\"}, checked_in:datetime? label=\"Admission time\"@{nl=\"Toegelaten op\"}, checked_by:user? label=\"Admitted by\"@{nl=\"Toegelaten door\"}, invoice:text? label=\"Invoice reference\"@{nl=\"Factuurreferentie\"}, delivery:delivery(Billing.charge)? label=\"Delivery reference\"@{nl=\"Afleverreferentie\"} } label=\"Event registration\"@{nl=\"Evenementregistratie\"}\n  # Capture a proposed material change without mutating the selected event or its original venue. @{nl=\"Leg een voorgestelde materiële wijziging vast zonder het gekozen evenement of zijn oorspronkelijke locatie te wijzigen.\"}\n  Change in Event { source:text unique label=\"Venue request identity\"@{nl=\"Identiteit locatieaanvraag\"}, base_revision:int label=\"Selected event revision\"@{nl=\"Gekozen evenementrevisie\"}, location:Event.location, timezone:Event.timezone, from:Event.from, until:Event.until, capacity:Event.capacity, sales_until:datetime label=\"Proposed sales cutoff\"@{nl=\"Voorgestelde verkoopgrens\"}, reason:text, author:user server=actor label=\"Change proposed by\"@{nl=\"Wijziging voorgesteld door\"}, resource:Resource? label=\"Rentable venue\"@{nl=\"Verhuurbare locatie\"}, customer:Customer? label=\"Venue customer\"@{nl=\"Locatieklant\"}, account:user label=\"Venue allocation account\"@{nl=\"Account locatietoewijzing\"}, previous:Change? label=\"Retained original venue\"@{nl=\"Behouden oorspronkelijke locatie\"}, state:enum(holding,confirming,adopted,releasing,released,failed,review)=holding label={text=\"Change state\"@{nl=\"Wijzigingsstatus\"},values={holding=\"Candidate held or requested\"@{nl=\"Kandidaat gereserveerd of aangevraagd\"},confirming=\"Confirmation pending\"@{nl=\"Bevestiging in behandeling\"},adopted=\"Selected change\"@{nl=\"Gekozen wijziging\"},releasing=\"Cleanup pending\"@{nl=\"Opruiming in behandeling\"},released=\"Cleanup confirmed\"@{nl=\"Opruiming bevestigd\"},failed=\"Request failed\"@{nl=\"Aanvraag mislukt\"},review=\"Change needs review\"@{nl=\"Wijziging vereist beoordeling\"}}}, venue_state:OperationOutcome.state=pending label=\"Authoritative venue state\"@{nl=\"Gezaghebbende locatiestatus\"}, venue_revision:int=0 label=\"Venue owner revision\"@{nl=\"Revisie locatie-eigenaar\"}, reference:text? label=\"Venue reservation reference\"@{nl=\"Referentie locatiereservering\"}, hold_delivery:text? label=\"Candidate hold request\"@{nl=\"Aanvraag kandidaatlocatie\"}, confirm_delivery:text? label=\"Venue confirmation request\"@{nl=\"Aanvraag locatiebevestiging\"}, release_reason:text? label=\"Frozen venue release reason\"@{nl=\"Vastgelegde reden locatievrijgave\"}, release_delivery:text? label=\"Venue release request\"@{nl=\"Aanvraag locatievrijgave\"}, hold_status:DeliveryResult.status? label=\"Candidate hold delivery state\"@{nl=\"Verzendstatus kandidaatlocatie\"}, confirm_status:DeliveryResult.status? label=\"Confirmation delivery state\"@{nl=\"Verzendstatus bevestiging\"}, release_status:DeliveryResult.status? label=\"Release delivery state\"@{nl=\"Verzendstatus vrijgave\"} } label=\"Event schedule and venue change\"@{nl=\"Wijziging evenementplanning en locatie\"}\n  Notice in Registration { kind:enum(confirmation,change,cancellation) label={text=\"Notice kind\"@{nl=\"Berichtsoort\"},values={confirmation=\"Ticket confirmation\"@{nl=\"Bevestiging toegangsbewijs\"},change=\"Material event change\"@{nl=\"Materiële evenementwijziging\"},cancellation=\"Admission cancellation\"@{nl=\"Annulering toegang\"}}}, revision:int label=\"Event revision at notice\"@{nl=\"Evenementrevisie bij bericht\"}, subject:text label=\"Notice subject\"@{nl=\"Onderwerp bericht\"}, body:text label=\"Notice text\"@{nl=\"Berichttekst\"}, delivery:delivery(Mail.send) } label=\"Attendee notice outcome\"@{nl=\"Resultaat deelnemersbericht\"}\n  event HoldDue { registration:Registration }\n  event VenueObserved { value:OperationOutcome }\n  event ApplyChange { change:Change }\n  event AttendeeNotice { registration:Registration, kind:Notice.kind, revision:int, body:text }\n  event SettlementObserved { value:Settlement }\n  event RefundCheck { registration:Registration }\n  event AttendeeUpdate { event:Event, revision:int, kind:Notice.kind, reason:text }\n  event VenueCleanup { event:Event, revision:int, reason:text }\n  derive Event.available:int = row.capacity-count(row.Registration as registration where registration.state==confirmed or (registration.state in [held,pending] and now<registration.expires))\n  derive Registration.charge_status:DeliveryResult.status? = row.delivery?.status label={text=\"Invoice request delivery state\"@{nl=\"Verzendstatus factuuraanvraag\"},values={pending=\"Request pending\"@{nl=\"Aanvraag in behandeling\"},succeeded=\"Request completed\"@{nl=\"Aanvraag voltooid\"},failed=\"Delivery failed\"@{nl=\"Verzending mislukt\"},unknown=\"Delivery uncertain\"@{nl=\"Verzending onzeker\"},skipped=\"Request skipped\"@{nl=\"Aanvraag overgeslagen\"}}}\n  ## Notice state observes the Mail receipt instead of copying transport status.\n  derive Notice.state:DeliveryResult.status = row.delivery.status\n  policy Program read=organizer\n  policy Event read=public where=row.published and not row.cancelled fields=location,name,description,timezone,from,until,capacity,price,sales_until,refund_before,terms,venue_name,published,cancelled\n  policy Event read=authenticated where=any(row.Registration as registration,registration.account==actor) fields=location,name,description,timezone,from,until,venue_name,published,cancelled,revision,cancellation_reason\n  policy Event read=organizer or check_in or finance where=can_work(actor,row.location)\n  policy Registration read=organizer or finance where=can_work(actor,row.parent.location) fields=parent,settlement_revision,event_revision,account,location,name,email,source,price,terms,refund_before,refund_required,refund_reason,refund_state,collected,refunded,collection_pending,refund_pending,cancel_reason,cancel_delivery,cancel_status,fenced,fence_revision,absent,invoice_state,refund_delivery,refund_target,refund_status,reconcile_delivery,reconcile_status,expires,state,payment,ticket,checked_in,checked_by,invoice,delivery.id,delivery.status,charge_status,id,version,created,updated,created_by,updated_by,archived_at\n  policy Registration read=check_in where=can_work(actor,row.parent.location) fields=name,email,state,payment,ticket,checked_in,checked_by\n  policy Change read=organizer where=can_work(actor,row.parent.location)\n  policy Notice read=organizer where=can_work(actor,row.parent.parent.location) fields=parent,kind,revision,subject,body,delivery.id,delivery.status,state,created_by,created,updated_by,updated,archived_at\n  policy Notice read=authenticated where=row.parent.account==actor fields=parent,kind,revision,subject,body,delivery.id,delivery.status,state,created_by,created,updated_by,updated,archived_at\n  policy Registration read=authenticated where=row.account==actor fields=parent,settlement_revision,event_revision,account,location,name,email,source,price,terms,refund_before,refund_required,refund_reason,refund_state,collected,refunded,collection_pending,refund_pending,cancel_reason,cancel_delivery,cancel_status,fenced,fence_revision,absent,invoice_state,refund_delivery,refund_target,refund_status,reconcile_delivery,reconcile_status,expires,state,payment,ticket,checked_in,checked_by,invoice,delivery.id,delivery.status,charge_status,id,version,created,updated,created_by,updated_by,archived_at\n  invariant Event: row.from<row.until and row.sales_until<=row.from and row.price.minor>=0 and row.price.currency==row.location.currency and row.available>=0\n  invariant Change: row.from<row.until and row.sales_until<=row.from and (row.resource==null or row.resource.location==row.location)\n  lock Change fields=source,base_revision,location,timezone,from,until,capacity,sales_until,reason,author,resource,customer,account,previous\n  lock Notice fields=kind,revision,subject,body,delivery\n  lock Registration fields=account,location,name,email,source,price,terms,refund_before,ticket\n  fixture program=Program {name=\"Community\"}\n  fixture workshop=Event {parent=program,location=test_site,name=\"Workshop\",description=\"Networking\",timezone=\"Europe/Brussels\",from=datetime(\"2099-01-02T09:00:00Z\"),until=datetime(\"2099-01-02T10:00:00Z\"),capacity=1,price=money(0,\"EUR\"),sales_until=datetime(\"2099-01-02T08:00:00Z\"),refund_before=datetime(\"2099-01-01T09:00:00Z\"),terms=\"Free\",published=true}\n  fixture free_ticket=Registration {parent=workshop,account=other,location=test_site,name=\"Guest\",email=\"guest@example.test\",source=\"free\",price=money(0,\"EUR\"),terms=\"Free\",refund_before=datetime(\"2099-01-01T09:00:00Z\"),collected=money(0,\"EUR\"),refunded=money(0,\"EUR\"),expires=datetime(\"2099-01-02T08:00:00Z\"),state=confirmed,payment=free,ticket=\"ticket\"}\n  fixture competing_ticket=Registration {parent=workshop,account=self,location=test_site,name=\"Second attendee\",email=\"second@example.test\",source=\"second\",price=money(0,\"EUR\"),terms=\"Free\",refund_before=datetime(\"2099-01-01T09:00:00Z\"),collected=money(0,\"EUR\"),refunded=money(0,\"EUR\"),expires=datetime(\"2099-01-02T08:00:00Z\"),state=confirmed,payment=free,ticket=\"second-ticket\"}\n  ## Paid charge recipes freeze the complete Billing.charge request before row overrides.\n  fixture charge_attempt=Billing.charge {request={value={source=\"free\",customer=test_company.id,location=test_site.id,description=workshop.name,amount=money(10,\"EUR\"),due=local_date(now,workshop.timezone),issuer=null,terms=\"Free\",items=null,consent=null}}}\n  fixture other_charge_attempt=Billing.charge {request={value={source=\"free\",customer=test_company.id,location=test_site.id,description=workshop.name,amount=money(10,\"EUR\"),due=local_date(now,workshop.timezone),issuer=null,terms=\"Free\",items=null,consent=null}}}\n  fixture event_room=Resource {location=test_site,name=\"Event hall\",kind=event_space,party_limit=20,timezone=\"Europe/Brussels\",currency=\"EUR\",hourly=money(100,\"EUR\"),terms=\"Venue allocation\",refund_notice=1d,accessibility=\"Step-free\"}\n  fixture incumbent=Change {parent=workshop,source=\"original-venue\",base_revision=1,location=test_site,timezone=\"Europe/Brussels\",from=datetime(\"2099-01-02T09:00:00Z\"),until=datetime(\"2099-01-02T10:00:00Z\"),capacity=1,sales_until=datetime(\"2099-01-02T08:00:00Z\"),reason=\"Original confirmed venue\",resource=event_room,customer=test_company,account=self,previous=null,state=adopted,venue_state=confirmed,venue_revision=2,reference=\"original-reservation\"}\n  fixture proposed=Change {parent=workshop,source=\"candidate\",base_revision=1,location=test_site,timezone=\"Europe/Brussels\",from=datetime(\"2099-01-03T09:00:00Z\"),until=datetime(\"2099-01-03T10:00:00Z\"),capacity=1,sales_until=datetime(\"2099-01-03T08:00:00Z\"),reason=\"New schedule\",resource=null,customer=null,account=self,previous=null}\n  preferences { location:Location?, ticket_state:Registration.state? label=\"Initial ticket state filter\"@{nl=\"Eerste filter toegangsbewijsstatus\"} }\n  message notice_title(kind:Notice.kind) = \"{kind,select,confirmation{Event ticket confirmed}change{Event schedule or venue changed}cancellation{Event admission cancelled}other{Event ticket update}}\"@{nl=\"{kind,select,confirmation{Toegangsbewijs evenement bevestigd}change{Planning of locatie evenement gewijzigd}cancellation{Toegang tot evenement geannuleerd}other{Wijziging toegangsbewijs evenement}}\"}\n  message notice_details(name:text,location:text,from:datetime,until:datetime,zone:timezone,reason:text,ticket:text,revision:int) = \"{name} at {location}. Start: {from}; end: {until}. Event timezone: {zone}. Revision {revision}. {reason} Ticket: {ticket}.\"@{nl=\"{name} bij {location}. Begin: {from}; einde: {until}. Tijdzone evenement: {zone}. Revisie {revision}. {reason} Toegangsbewijs: {ticket}.\"}\n  message label_Event_cancelled = \"Cancelled\"@{nl=\"Geannuleerd\"}\n  message label_Registration_state_pending = \"Pending\"@{nl=\"In behandeling\"}\n When\n  crud Program by=organizer fields=name delete=none\n  crud Event by=organizer fields=name,description,price,sales_until,refund_before,terms create_fields=location,name,description,timezone,from,until,capacity,price,sales_until,refund_before,terms when=can_work(actor,row.location) and not row.cancelled delete=none\n  # Publish only a free-standing event or one whose canonical venue reservation is confirmed. @{nl=\"Publiceer uitsluitend een losstaand evenement of een evenement met bevestigde canonieke locatiereservering.\"}\n  scenario publish(event:Event) by=organizer\n   require can_work(actor,event.location) and not event.cancelled and event.from>now and (event.venue==null or event.venue.venue_state==confirmed) and event.pending_change==null\n   do set event {published=true}\n  # Reserve one ticket at the current frozen price; free tickets require no invented payment. @{nl=\"Reserveer één toegangsbewijs tegen de huidige vastgelegde prijs; gratis toegang vereist geen verzonnen betaling.\"}\n  scenario register(event:Event,name:text,email:email?=null,customer:Customer?=null,account:user?=null) -> Registration by=authenticated or organizer label=\"Register for event\"@{nl=\"Registreren voor evenement\"}\n   require event.published and not event.cancelled and now<event.sales_until and event.available>0 and trim(name)!=\"\"\n   require event.venue==null or event.venue.venue_state==confirmed\n   require account==null or account==actor or (organizer and can_work(actor,event.location))\n   require (account!=null and account!=actor and email!=null) or ((account==null or account==actor) and actor.email_verified and (email==null or email==actor.email))\n   require event.price.minor==0 or (customer!=null and customer.active and event.location in customer.locations and (owns(account??actor,customer) or has_location_role(account??actor,customer,booker,event.location) or has_location_role(account??actor,customer,administrator,event.location)))\n   do\n    create Registration {parent=event,account=account??actor,location=event.location,name,email=email??actor.email,source=operation.id,price=event.price,event_revision=event.revision,terms=event.terms,refund_before=event.refund_before,collected=money(0,event.price.currency),refunded=money(0,event.price.currency),expires=now+15m,ticket=operation.id} as registration\n    if event.price.minor==0\n     set registration {state=confirmed,payment=free}\n     emit AttendeeNotice {registration,kind=confirmation,revision=event.revision,body=registration.ticket}\n    else\n     require customer!=null\n     send Billing.charge {value={source=registration.source,customer=customer.id,location=registration.location.id,description=event.name,amount=registration.price,terms=registration.terms,due=local_date(now,event.timezone)}} as delivery\n     set registration {state=pending,payment=pending,delivery=delivery}\n     schedule registration.id at=registration.expires event=HoldDue {registration}\n    return registration\n   examples seed=[test_worker,test_company,test_booker] event=workshop name=\"Attendee\" email=\"guest@example.test\" customer=test_company account=other\n    as,event.price -> result.account,result.location,result.payment,result.state,result.charge_status\n    organizer,money(0,\"EUR\") -> other,test_site,free,confirmed,null\n    organizer,money(10,\"EUR\") -> other,test_site,pending,pending,pending\n    check_in,money(0,\"EUR\") -> error(rule_failed)\n   examples event=workshop name=\"Own attendee\"\n    as,event.price -> result.account,result.location,result.payment,result.state,result.charge_status\n    members,money(0,\"EUR\") -> self,test_site,free,confirmed,null\n    members,money(10,\"EUR\") -> error(rule_failed)\n   examples seed=[free_ticket] event=workshop name=\"Attendee\" email=\"guest@example.test\" customer=null\n    as -> count(workshop.Registration)\n    organizer -> error(rule_failed)\n  # Scan a fulfilled ticket once without modifying room occupancy. @{nl=\"Scan een voldaan toegangsbewijs één keer zonder ruimtebezetting te wijzigen.\"}\n  scenario admit(registration:Registration) by=check_in label=\"Admit ticket\"@{nl=\"Toegangsbewijs toelaten\"}\n   require can_work(actor,registration.parent.location) and not registration.parent.cancelled and registration.state==confirmed and registration.payment in [free,paid] and registration.checked_in==null and (registration.parent.venue==null or registration.parent.venue.venue_state==confirmed)\n   do set registration {checked_in=now,checked_by=actor}\n   examples seed=[test_worker] registration=free_ticket\n    as,registration.state,registration.checked_in -> registration.checked_by\n    check_in,confirmed,null -> self\n    check_in,cancelled,null -> error(rule_failed)\n    check_in,confirmed,datetime(\"2026-10-04T12:00:00Z\") -> error(rule_failed)\n    organizer,confirmed,null -> error(forbidden)\n  # Keep the original room until a replacement has committed; changing location rechecks current worker scope at both locations. @{nl=\"Behoud de oorspronkelijke ruimte totdat een vervanging is vastgelegd; controleer bij locatiewijziging actuele werkrechten op beide locaties.\"}\n  scenario change(event:Event,location:Event.location,timezone:Event.timezone,from:Event.from,until:Event.until,capacity:Event.capacity,sales_until:Event.sales_until,reason:text,resource:Change.resource=null,customer:Change.customer=null) -> Change by=organizer label=\"Change schedule or reserve venue\"@{nl=\"Planning wijzigen of locatie reserveren\"}\n   require can_work(actor,event.location) and can_work(actor,location) and not event.cancelled and event.pending_change==null and from>now and from<until and sales_until<=from and trim(reason)!=\"\" and not any(event.Registration as registration,registration.checked_in!=null)\n   require location.currency==event.price.currency and capacity>=count(event.Registration as registration where registration.state==confirmed or (registration.state in [held,pending] and now<registration.expires))\n   require resource==null or (resource.active and resource.location==location and resource.party_limit>=capacity and customer!=null and customer.active and location in customer.locations)\n   do\n    let retained=first(event.Change as prior where prior==event.venue and prior.resource==resource and resource!=null order=prior.id)\n    create Change {parent=event,source=operation.id,base_revision=event.revision,location,timezone,from,until,capacity,sales_until,reason,resource,customer,account=retained?.account??actor,previous=event.venue} as change\n    set event {pending_change=change}\n    if resource==null\n     emit ApplyChange {change}\n    else\n     require customer!=null\n     if event.venue!=null and event.venue.resource==resource\n      require event.venue.venue_state==confirmed and event.venue.customer==customer\n      send Rooms.stage {value={source=change.source,revision=1,resource=resource.id,customer=customer.id,account=change.account,from,until,quantity=1,price=null,terms=null},previous_source=event.venue.source,previous_revision=event.venue.venue_revision} as delivery\n      set change {hold_delivery=delivery.id,hold_status=pending}\n     else\n      send Rooms.hold {value={source=change.source,revision=1,resource=resource.id,customer=customer.id,account=actor,from,until,quantity=1,price=null,terms=null}} as delivery\n      set change {hold_delivery=delivery.id,hold_status=pending}\n    return change\n   examples seed=[test_worker,incumbent] event=workshop location=test_site timezone=\"Europe/Brussels\" from=datetime(\"2099-01-03T09:00:00Z\") until=datetime(\"2099-01-03T10:00:00Z\") capacity=1 sales_until=datetime(\"2099-01-03T08:00:00Z\") reason=\"Move workshop\" resource=event_room customer=test_company\n    as,event.venue -> result.previous,result.account,result.state,workshop.from\n    organizer,incumbent -> incumbent,self,holding,datetime(\"2099-01-02T09:00:00Z\")\n    check_in,incumbent -> error(forbidden)\n  # Abandon a candidate with its original source; a late hold or confirmation cannot select it again. @{nl=\"Verlaat een kandidaat met zijn oorspronkelijke bron; een late reservering of bevestiging kan hem niet opnieuw selecteren.\"}\n  scenario abandon(change:Change,reason:text) by=organizer label=\"Abandon proposed change\"@{nl=\"Voorgestelde wijziging verlaten\"}\n   require can_work(actor,change.parent.location) and change.parent.pending_change==change and change.state in [holding,confirming,failed,review] and trim(reason)!=\"\"\n   do\n    set change.parent {pending_change=null}\n    set change {state=releasing}\n    if change.resource!=null\n     send Rooms.release {source=change.source,resource=change.resource.id,reason} as delivery\n     set change {release_reason=reason,release_delivery=delivery.id,release_status=pending}\n    else\n     set change {state=released}\n   examples seed=[incumbent,test_worker] change=proposed reason=\"Keep original\"\n    as,workshop.venue,workshop.pending_change,proposed.resource,proposed.customer,proposed.previous -> workshop.venue,workshop.pending_change,proposed.state,incumbent.venue_state\n    organizer,incumbent,proposed,event_room,test_company,incumbent -> incumbent,null,releasing,confirmed\n    check_in,incumbent,proposed,event_room,test_company,incumbent -> error(forbidden)\n  # Repeat safe venue cleanup with exactly the captured source, resource and reason; earlier receipts remain in history. @{nl=\"Herhaal veilige locatieopruiming met exact de vastgelegde bron, voorziening en reden; eerdere ontvangsten blijven in de historie.\"}\n  scenario retry_release(change:Change) by=organizer label=\"Retry venue cleanup\"@{nl=\"Locatieopruiming opnieuw proberen\"}\n   require can_work(actor,change.parent.location) and change.resource!=null and change.state==releasing and change.release_status in [failed,unknown,skipped] and change.release_reason!=null\n   do\n    send Rooms.release {source=change.source,resource=change.resource.id,reason=change.release_reason} as delivery\n    set change {release_delivery=delivery.id,release_status=pending}\n  # Correlate the initial venue delivery before accepting its owner outcome. @{nl=\"Koppel de eerste locatieverzending voordat het eigenaarresultaat wordt aanvaard.\"}\n  scenario venue_held on=Rooms.hold.completed\n   do\n    for change in Change as row where row.hold_delivery==event.delivery_id limit=1\n     set change {hold_status=event.status}\n     if event.status==succeeded and event.result!=null\n      require event.result.source==change.source\n      emit VenueObserved {value=event.result}\n     if event.status in [failed,skipped] and change.state==holding\n      set change {state=failed}\n   examples seed=[proposed] event={delivery_id=\"hold-delivery\",status=succeeded,result=OperationOutcome {source=\"wrong-source\",revision=1,state=pending,reference=\"room\",detail=null},error=null}\n    proposed.hold_delivery -> proposed.hold_status\n    \"hold-delivery\" -> error(rule_failed)\n    \"other-delivery\" -> null\n  # Match the staged replacement delivery while retaining the original venue. @{nl=\"Koppel de verzending van de gefaseerde vervanging terwijl de oorspronkelijke locatie behouden blijft.\"}\n  scenario venue_staged on=Rooms.stage.completed\n   do\n    for change in Change as row where row.hold_delivery==event.delivery_id limit=1\n     set change {hold_status=event.status}\n     if event.status==succeeded and event.result!=null\n      require event.result.source==change.source\n      emit VenueObserved {value=event.result}\n     if event.status in [failed,skipped] and change.state==holding\n      set change {state=failed}\n  # Retain a correlated confirmation receipt without assuming transport success fulfills the venue. @{nl=\"Bewaar een gekoppelde bevestigingsontvangst zonder aan te nemen dat transportsucces de locatie vervult.\"}\n  scenario venue_confirmed on=Rooms.confirm.completed\n   do\n    for change in Change as row where row.confirm_delivery==event.delivery_id limit=1\n     set change {confirm_status=event.status}\n     if event.status==succeeded and event.result!=null\n      require event.result.source==change.source\n      emit VenueObserved {value=event.result}\n     if event.status in [failed,skipped] and change.state==confirming\n      set change {state=review}\n  # Record cleanup delivery separately and require the released owner outcome. @{nl=\"Registreer opruimverzending afzonderlijk en vereis het vrijgaveresultaat van de eigenaar.\"}\n  scenario venue_released on=Rooms.release.completed\n   do\n    for change in Change as row where row.release_delivery==event.delivery_id limit=1\n     set change {release_status=event.status}\n     if event.status==succeeded and event.result!=null\n      require event.result.source==change.source\n      emit VenueObserved {value=event.result}\n  # Forward authenticated venue observations into the one revision reducer. @{nl=\"Stuur geauthenticeerde locatiewaarnemingen naar de enige revisieverwerker.\"}\n  scenario venue_changed on=Rooms.changed\n   do emit VenueObserved {value=event.value}\n  # Accept increasing venue revisions and keep abandoned sources fenced from adoption. @{nl=\"Aanvaard stijgende locatierevisies en scherm verlaten bronnen af tegen overname.\"}\n  scenario observe_venue on=VenueObserved\n   do\n    for change in Change as row where row.source==event.value.source limit=1\n     if event.value.revision>change.venue_revision\n      set change {venue_revision=event.value.revision,reference=event.value.reference}\n      if change.state!=releasing and change.state!=released\n       set change {venue_state=event.value.state}\n      if change.parent.venue==change and event.value.state in [released,unavailable,failed,unknown]\n       set change.parent {published=false}\n      if event.value.state==released\n       set change {venue_state=released}\n       if change.state==releasing\n        set change {state=released}\n       if change.parent.venue==change\n        set change.parent {published=false}\n      if change.parent.pending_change==change and not change.parent.cancelled and change.base_revision==change.parent.revision\n       if event.value.state==pending and change.state==holding and change.resource!=null\n        send Rooms.confirm {source=change.source,resource=change.resource.id} when=change.parent.pending_change==change and not change.parent.cancelled and change.state==confirming as delivery\n        set change {state=confirming,confirm_delivery=delivery.id,confirm_status=pending}\n       if event.value.state==confirmed and change.state in [holding,confirming,review]\n        emit ApplyChange {change}\n       if event.value.state in [unavailable,failed,unknown]\n        set change {state=review}\n   examples seed=[proposed] event={value=OperationOutcome {source=\"candidate\",revision=2,state=confirmed,reference=\"room-candidate\",detail=null}}\n    proposed.state,proposed.venue_revision -> proposed.state,proposed.venue_state,proposed.venue_revision,workshop.from\n    released,1 -> released,pending,2,datetime(\"2099-01-02T09:00:00Z\")\n    releasing,1 -> releasing,pending,2,datetime(\"2099-01-02T09:00:00Z\")\n    holding,3 -> holding,pending,3,datetime(\"2099-01-02T09:00:00Z\")\n   examples seed=[proposed,incumbent] event={value=OperationOutcome {source=\"candidate\",revision=2,state=unavailable,reference=\"room-candidate\",detail=\"Venue unavailable\"}}\n    workshop.venue,workshop.pending_change,proposed.previous,proposed.resource,proposed.customer -> workshop.venue,incumbent.venue_state,proposed.state,workshop.from\n    incumbent,proposed,incumbent,event_room,test_company -> incumbent,confirmed,review,datetime(\"2099-01-02T09:00:00Z\")\n  # Adopt only the current revision and fresh capacity; predecessor cleanup is an independently visible outcome. @{nl=\"Neem uitsluitend de huidige revisie en actuele capaciteit over; opruiming van de voorganger is een afzonderlijk zichtbaar resultaat.\"}\n  scenario apply_change on=ApplyChange\n   require event.change.parent.pending_change==event.change and event.change.base_revision==event.change.parent.revision and not event.change.parent.cancelled and event.change.state in [holding,confirming,review]\n   require event.change.resource==null or event.change.venue_state==confirmed\n   do\n    let selected=event.change.parent\n    let occupied=count(selected.Registration as registration where registration.state==confirmed or (registration.state in [held,pending] and now<registration.expires))\n    if event.change.capacity<occupied or event.change.from<=now or not organizer(event.change.author) or not can_work(event.change.author,selected.location) or not can_work(event.change.author,event.change.location) or any(selected.Registration as registration,registration.checked_in!=null)\n     set event.change {state=review}\n    else\n     set selected {location=event.change.location,timezone=event.change.timezone,from=event.change.from,until=event.change.until,capacity=event.change.capacity,sales_until=event.change.sales_until,venue=null,venue_name=null,pending_change=null,revision=selected.revision+1}\n     set event.change {state=adopted}\n     if event.change.resource!=null\n      set selected {venue=event.change,venue_name=event.change.resource.name}\n     if event.change.previous!=null and event.change.previous.resource!=null\n      set event.change.previous {state=releasing}\n      send Rooms.release {source=event.change.previous.source,resource=event.change.previous.resource.id,reason=event.change.reason} as delivery\n      set event.change.previous {release_reason=event.change.reason,release_delivery=delivery.id,release_status=pending}\n     if selected.published\n      schedule format(\"{event}:attendees\",{event=selected.id}) at=now event=AttendeeUpdate {event=selected,revision=selected.revision,kind=change,reason=event.change.reason}\n   examples seed=[free_ticket,test_worker] event={change=proposed}\n    workshop.pending_change,proposed.capacity -> workshop.from,proposed.state,workshop.revision\n    proposed,1 -> datetime(\"2099-01-03T09:00:00Z\"),adopted,2\n    null,1 -> error(rule_failed)\n   examples seed=[free_ticket,test_worker] event={change=proposed}\n    workshop.pending_change,proposed.base_revision -> workshop.from,proposed.state\n    proposed,2 -> error(rule_failed)\n    proposed,1 -> datetime(\"2099-01-02T09:00:00Z\"),review\n  # Revoke unconsumed admission first, with the ticket's frozen cutoff governing automatic refund eligibility. @{nl=\"Trek ongebruikte toegang eerst in; de vastgelegde grens van het toegangsbewijs bepaalt automatische terugbetaling.\"}\n  scenario cancel(registration:Registration,reason:text) by=authenticated or organizer\n   require registration.account==actor or (organizer and can_work(actor,registration.parent.location))\n   require registration.state in [held,pending,confirmed,review] and registration.checked_in==null and trim(reason)!=\"\"\n   do\n    set registration {state=cancelled,refund_required=registration.refund_required or now<registration.refund_before,refund_reason=reason}\n    cancel registration.id\n    if registration.price.minor>0\n     if registration.cancel_delivery==null or registration.cancel_status in [failed,unknown,skipped]\n      send Billing.cancel {source=registration.source,reason=registration.cancel_reason??reason} as cancellation\n      set registration {cancel_reason=registration.cancel_reason??reason,cancel_delivery=cancellation.id,cancel_status=pending}\n     if registration.refund_required\n      set registration {refund_state=review}\n    emit AttendeeNotice {registration,kind=cancellation,revision=registration.parent.revision,body=reason}\n  # Release the elapsed ticket hold and reconcile any uncertain payment. @{nl=\"Geef de verstreken tijdelijke toegang vrij en reconcilieer onzekere betaling.\"}\n  scenario expired on=HoldDue\n   require event.registration.state in [held,pending] and event.registration.expires<=now\n   do\n    set event.registration {state=expired}\n    send Billing.reconcile {source=event.registration.source} as delivery\n    set event.registration {reconcile_delivery=delivery.id,reconcile_status=pending}\n  # Finance resolves an unfulfilled paid ticket through the same refund request path used by cancellation. @{nl=\"Financiën handelt een betaald maar niet uitgevoerd toegangsbewijs af via hetzelfde terugbetalingspad als annulering.\"}\n  scenario refund(registration:Registration,reason:text) by=finance label=\"Resolve ticket refund\"@{nl=\"Terugbetaling toegangsbewijs afhandelen\"}\n   require can_work(actor,registration.parent.location) and can_work(actor,registration.location) and registration.state in [cancelled,expired,review] and registration.price.minor>0 and trim(reason)!=\"\" and registration.refund_state!=refunded\n   do\n    set registration {refund_required=true,refund_reason=reason,refund_state=review}\n    if registration.cancel_delivery==null or registration.cancel_status in [failed,unknown,skipped]\n     send Billing.cancel {source=registration.source,reason=registration.cancel_reason??reason} as cancellation\n     set registration {cancel_reason=registration.cancel_reason??reason,cancel_delivery=cancellation.id,cancel_status=pending}\n    emit RefundCheck {registration}\n  scenario reconcile(registration:Registration) by=authenticated or organizer or finance label=\"Reconcile ticket payment\"@{nl=\"Betaling toegangsbewijs reconciliëren\"}\n   require registration.account==actor or ((organizer or finance) and can_work(actor,registration.parent.location))\n   require registration.price.minor>0\n   do\n    send Billing.reconcile {source=registration.source} as delivery\n    set registration {reconcile_delivery=delivery.id,reconcile_status=pending}\n  # Track invoice-request delivery without treating issuance or transport acceptance as a fulfilled ticket. @{nl=\"Volg de verzending van de factuuraanvraag zonder uitgifte of transportacceptatie als voldaan toegangsbewijs te behandelen.\"}\n  scenario charged_money on=Billing.charge.completed\n   do\n    for registration in Registration as row where row.delivery?.id==event.delivery_id limit=1\n     if event.status==succeeded and event.result!=null\n      require event.result.source==registration.source\n      if registration.invoice==null and event.result.reference!=null\n       set registration {invoice=event.result.reference}\n     if event.status in [failed,unknown,skipped] and registration.payment in [unpaid,pending,unknown]\n      set registration {payment=unknown}\n     send Billing.reconcile {source=registration.source} as delivery\n     set registration {reconcile_delivery=delivery.id,reconcile_status=pending}\n   examples seed=[charge_attempt] event={delivery_id=charge_attempt.id,status=succeeded,result=OperationOutcome {source=\"free\",revision=1,state=confirmed,reference=\"invoice\",detail=null},error=null}\n    free_ticket.price,free_ticket.state,free_ticket.payment,free_ticket.collected,free_ticket.delivery,charge_attempt.status,charge_attempt.result -> free_ticket.state,free_ticket.payment,free_ticket.charge_status,free_ticket.invoice,free_ticket.reconcile_status\n    money(10,\"EUR\"),pending,pending,money(0,\"EUR\"),charge_attempt,succeeded,OperationOutcome {source=\"free\",revision=1,state=confirmed,reference=\"invoice\",detail=null} -> pending,pending,succeeded,\"invoice\",pending\n    money(10,\"EUR\"),confirmed,paid,money(10,\"EUR\"),charge_attempt,succeeded,OperationOutcome {source=\"free\",revision=1,state=confirmed,reference=\"invoice\",detail=null} -> confirmed,paid,succeeded,\"invoice\",pending\n   examples seed=[charge_attempt] event={delivery_id=charge_attempt.id,status=unknown,result=null,error=null}\n    free_ticket.price,free_ticket.state,free_ticket.payment,free_ticket.collected,free_ticket.delivery,charge_attempt.status -> free_ticket.state,free_ticket.payment,free_ticket.charge_status,free_ticket.reconcile_status\n    money(10,\"EUR\"),pending,pending,money(0,\"EUR\"),charge_attempt,unknown -> pending,unknown,unknown,pending\n    money(10,\"EUR\"),confirmed,paid,money(10,\"EUR\"),charge_attempt,unknown -> confirmed,paid,unknown,pending\n    money(10,\"EUR\"),pending,pending,money(0,\"EUR\"),other_charge_attempt,unknown -> pending,pending,pending,null\n   examples seed=[charge_attempt] event={delivery_id=charge_attempt.id,status=failed,result=null,error={code=\"provider\",message=\"Invoice request rejected\"}}\n    free_ticket.price,free_ticket.state,free_ticket.payment,free_ticket.collected,free_ticket.delivery,event.status,event.error,charge_attempt.status,charge_attempt.error -> free_ticket.state,free_ticket.payment,free_ticket.charge_status,free_ticket.reconcile_status\n    money(10,\"EUR\"),pending,pending,money(0,\"EUR\"),charge_attempt,failed,{code=\"provider\",message=\"Invoice request rejected\"},failed,{code=\"provider\",message=\"Invoice request rejected\"} -> pending,unknown,failed,pending\n    money(10,\"EUR\"),confirmed,paid,money(10,\"EUR\"),charge_attempt,failed,{code=\"provider\",message=\"Invoice request rejected\"},failed,{code=\"provider\",message=\"Invoice request rejected\"} -> confirmed,paid,failed,pending\n    money(10,\"EUR\"),pending,pending,money(0,\"EUR\"),charge_attempt,skipped,null,skipped,null -> pending,unknown,skipped,pending\n   examples seed=[charge_attempt] event={delivery_id=charge_attempt.id,status=succeeded,result=OperationOutcome {source=\"wrong-source\",revision=1,state=confirmed,reference=\"invoice\",detail=null},error=null}\n    free_ticket.price,free_ticket.state,free_ticket.payment,free_ticket.delivery,charge_attempt.status,charge_attempt.result -> free_ticket.charge_status\n    money(10,\"EUR\"),pending,pending,charge_attempt,succeeded,OperationOutcome {source=\"wrong-source\",revision=1,state=confirmed,reference=\"invoice\",detail=null} -> error(rule_failed)\n  # Keep cancellation acknowledgement and ledger fence independent of returned money. @{nl=\"Bewaar annuleringsbevestiging en afwikkelingsgrens afzonderlijk van terugbetaalde bedragen.\"}\n  scenario cancelled_money on=Billing.cancel.completed\n   do\n    for registration in Registration as row where row.cancel_delivery==event.delivery_id limit=1\n     set registration {cancel_status=event.status}\n     if event.status==succeeded and event.result!=null\n      require event.result.source==registration.source\n      if event.result.state in [released,pending,unavailable]\n       set registration {fenced=true,fence_revision=event.result.revision}\n       if event.result.state==released and event.result.reference==null\n        set registration {absent=true,collection_pending=false}\n       send Billing.reconcile {source=registration.source} as delivery\n       set registration {reconcile_delivery=delivery.id,reconcile_status=pending}\n       emit RefundCheck {registration}\n  # Save the refund delivery outcome and request fresh cumulative money evidence. @{nl=\"Bewaar het verzendresultaat van de terugbetaling en vraag nieuw cumulatief geldbewijs.\"}\n  scenario refund_result on=Billing.refund.completed\n   do\n    for registration in Registration as row where row.refund_delivery==event.delivery_id limit=1\n     set registration {refund_status=event.status}\n     if event.status in [failed,unknown]\n      set registration {refund_state=unknown}\n     if event.status==skipped\n      set registration {refund_state=review}\n      emit RefundCheck {registration}\n     if event.status==succeeded and event.result!=null\n      require event.result.source==registration.source\n      if event.result.state in [failed,unavailable]\n       set registration {refund_status=failed,refund_state=review}\n      send Billing.reconcile {source=registration.source} as delivery\n      set registration {reconcile_delivery=delivery.id,reconcile_status=pending}\n   examples event={delivery_id=\"refund-delivery\",status=skipped,result=null,error=null}\n    free_ticket.price,free_ticket.state,free_ticket.collected,free_ticket.refund_required,free_ticket.refund_delivery,free_ticket.refund_state -> free_ticket.refund_status,free_ticket.refund_state\n    money(10,\"EUR\"),cancelled,money(10,\"EUR\"),true,\"refund-delivery\",pending -> skipped,review\n    money(10,\"EUR\"),cancelled,money(10,\"EUR\"),true,\"another-delivery\",pending -> null,pending\n  # Match settlement refresh delivery and feed nonnull evidence into canonical reconciliation. @{nl=\"Koppel afwikkelingsverversing en stuur niet-lege bewijsgegevens naar canonieke reconciliatie.\"}\n  scenario reconciled_money on=Billing.reconcile.completed\n   do\n    for registration in Registration as row where row.reconcile_delivery==event.delivery_id limit=1\n     set registration {reconcile_status=event.status}\n     if event.status==succeeded and event.result!=null\n      require event.result.source==registration.source\n      emit SettlementObserved {value=event.result}\n  # Process verified invoice snapshots through the same settlement path as explicit refresh. @{nl=\"Verwerk geverifieerde factuurmomentopnamen via hetzelfde afwikkelingspad als expliciete verversing.\"}\n  scenario money_received on=Billing.settled\n   do emit SettlementObserved {value=event.value}\n  # Preserve cumulative balances, terminal admission and fresh capacity under ordered invoice evidence. @{nl=\"Behoud cumulatieve saldi, beëindigde toegang en actuele capaciteit onder geordend factuurbewijs.\"}\n  scenario money on=SettlementObserved\n   do\n    for registration in Registration as row where row.source==event.value.source limit=1\n     require registration.price==event.value.amount and registration.price.currency==event.value.collected.currency and registration.price.currency==event.value.refunded.currency\n     if event.value.revision>registration.settlement_revision\n      let was_confirmed=registration.state==confirmed\n      set registration {absent=false,settlement_revision=event.value.revision,invoice=event.value.invoice,collected=event.value.collected,refunded=event.value.refunded,collection_pending=event.value.collection_pending,refund_pending=event.value.refund_pending,invoice_state=event.value.state}\n      if registration.refund_required and registration.collected>registration.refunded and registration.refund_state==refunded\n       set registration {refund_state=review}\n      if event.value.collection_pending or event.value.refund_pending\n       set registration {payment=unknown}\n      else\n       if event.value.collected==event.value.refunded and event.value.refunded>=registration.price and registration.price.minor>0\n        set registration {payment=refunded,state=cancelled,refund_state=refunded}\n       else\n        if event.value.collected-event.value.refunded>=registration.price and registration.price.minor>0\n         set registration {payment=paid}\n         if registration.checked_in==null\n          if not registration.parent.cancelled and registration.state in [held,pending,confirmed,expired] and registration.cancel_delivery==null and not registration.refund_required and event.value.state==issued and registration.parent.from>now and (registration.parent.venue==null or registration.parent.venue.venue_state==confirmed) and (registration.state==confirmed or (registration.state in [held,pending] and now<registration.expires) or registration.parent.available>0)\n           set registration {state=confirmed}\n          else\n           if registration.state!=cancelled\n            set registration {state=review,refund_required=true,refund_reason=\"Paid ticket cannot be fulfilled\",refund_state=review}\n           if registration.refund_required and registration.cancel_delivery==null\n            send Billing.cancel {source=registration.source,reason=registration.refund_reason??\"Unfulfilled ticket\"} as delivery\n            set registration {cancel_reason=registration.refund_reason??\"Unfulfilled ticket\",cancel_delivery=delivery.id,cancel_status=pending}\n         if registration.state==confirmed and not was_confirmed\n          emit AttendeeNotice {registration,kind=confirmation,revision=registration.parent.revision,body=registration.ticket}\n        else\n         if event.value.state==void\n          set registration {payment=unpaid}\n          if registration.state!=cancelled and registration.checked_in==null\n           set registration {state=expired}\n         else\n          if event.value.collected.minor>0 or event.value.refunded.minor>0\n           set registration {payment=unknown}\n           if registration.checked_in==null and registration.state!=cancelled and not (registration.state in [held,pending] and now<registration.expires)\n            set registration {state=review,refund_required=true,refund_reason=\"Unfulfilled partial ticket payment\",refund_state=review}\n           if registration.refund_required and registration.cancel_delivery==null\n            send Billing.cancel {source=registration.source,reason=registration.refund_reason??\"Unfulfilled ticket\"} as delivery\n            set registration {cancel_reason=registration.refund_reason??\"Unfulfilled ticket\",cancel_delivery=delivery.id,cancel_status=pending}\n      emit RefundCheck {registration}\n   examples seed=[free_ticket] event={value=Settlement {source=\"free\",invoice=\"invoice\",revision=2,amount=money(10,\"EUR\"),collected=money(10,\"EUR\"),refunded=money(0,\"EUR\"),collection_pending=false,refund_pending=false,state=issued,recorded_at=datetime(\"2026-10-04T12:00:00Z\")}}\n    free_ticket.price,free_ticket.state,free_ticket.cancel_delivery,free_ticket.settlement_revision,free_ticket.payment,event.value.refund_pending -> free_ticket.state,free_ticket.payment,free_ticket.settlement_revision\n    money(10,\"EUR\"),expired,null,0,pending,false -> confirmed,paid,2\n    money(10,\"EUR\"),cancelled,\"cancel-ticket\",0,pending,false -> cancelled,paid,2\n    money(10,\"EUR\"),expired,\"cancel-ticket\",0,pending,false -> review,paid,2\n    money(10,\"EUR\"),cancelled,\"cancel-ticket\",3,pending,false -> cancelled,pending,3\n    money(10,\"EUR\"),expired,null,0,pending,true -> expired,unknown,2\n   examples seed=[free_ticket,competing_ticket] event={value=Settlement {source=\"free\",invoice=\"invoice\",revision=2,amount=money(10,\"EUR\"),collected=money(10,\"EUR\"),refunded=money(0,\"EUR\"),collection_pending=false,refund_pending=false,state=issued,recorded_at=datetime(\"2026-10-04T12:00:00Z\")}}\n    free_ticket.price,free_ticket.state -> free_ticket.state,free_ticket.payment,workshop.available,free_ticket.refund_required\n    money(10,\"EUR\"),expired -> review,paid,0,true\n   examples seed=[free_ticket] event={value=Settlement {source=\"free\",invoice=\"invoice\",revision=2,amount=money(10,\"EUR\"),collected=money(10,\"EUR\"),refunded=money(0,\"EUR\"),collection_pending=false,refund_pending=false,state=issued,recorded_at=datetime(\"2026-10-04T12:00:00Z\")}}\n    event.value.amount -> free_ticket.payment\n    money(10,\"EUR\") -> error(rule_failed)\n  # Send only the outstanding evidenced full-ticket refund after the invoice cancellation fence and uncertainty clear. @{nl=\"Verzend uitsluitend de openstaande bewezen volledige terugbetaling nadat factuurafscherming en onzekerheid zijn afgehandeld.\"}\n  scenario refund_check on=RefundCheck\n   do\n    let registration=event.registration\n    if registration.refund_required and registration.fenced and registration.settlement_revision>=registration.fence_revision and registration.settlement_revision>0 and not registration.collection_pending and not registration.refund_pending and registration.collected>registration.refunded and registration.refund_state!=refunded and (registration.refund_delivery==null or registration.refund_status in [failed,skipped] or (registration.refund_target!=null and registration.refunded>=registration.refund_target))\n     send Billing.refund {source=registration.source,amount=registration.collected-registration.refunded,reason=registration.refund_reason??\"Ticket refund\"} as delivery\n     set registration {refund_delivery=delivery.id,refund_target=registration.collected,refund_status=pending,refund_state=pending}\n    if registration.refund_required and registration.fenced and (registration.absent or (registration.settlement_revision>=registration.fence_revision and not registration.collection_pending and not registration.refund_pending and registration.collected==registration.refunded and (registration.collected.minor>0 or registration.invoice_state==void)))\n     set registration {refund_state=refunded}\n     if registration.collected.minor>0\n      set registration {payment=refunded}\n     else\n      set registration {payment=unpaid}\n   examples event={registration=free_ticket}\n    free_ticket.price,free_ticket.state,free_ticket.refund_required,free_ticket.fenced,free_ticket.settlement_revision,free_ticket.fence_revision,free_ticket.collected,free_ticket.collection_pending -> free_ticket.refund_state,free_ticket.refund_target\n    money(10,\"EUR\"),cancelled,true,true,2,2,money(10,\"EUR\"),false -> pending,money(10,\"EUR\")\n    money(10,\"EUR\"),cancelled,true,true,1,2,money(10,\"EUR\"),false -> none,null\n    money(10,\"EUR\"),cancelled,true,true,2,2,money(10,\"EUR\"),true -> none,null\n    money(10,\"EUR\"),cancelled,true,false,2,2,money(10,\"EUR\"),false -> none,null\n   examples event={registration=free_ticket}\n    free_ticket.price,free_ticket.state,free_ticket.refund_required,free_ticket.fenced,free_ticket.settlement_revision,free_ticket.fence_revision,free_ticket.collected,free_ticket.refund_delivery,free_ticket.refund_status,free_ticket.refund_target -> free_ticket.refund_state,free_ticket.refund_status,free_ticket.refund_target\n    money(10,\"EUR\"),cancelled,true,true,2,2,money(10,\"EUR\"),\"skipped-refund\",skipped,money(10,\"EUR\") -> pending,pending,money(10,\"EUR\")\n    money(10,\"EUR\"),cancelled,true,true,2,2,money(10,\"EUR\"),\"uncertain-refund\",unknown,money(10,\"EUR\") -> none,unknown,money(10,\"EUR\")\n   examples event={registration=free_ticket}\n    free_ticket.price,free_ticket.state,free_ticket.refund_required,free_ticket.fenced,free_ticket.settlement_revision,free_ticket.fence_revision,free_ticket.collected,free_ticket.refunded,free_ticket.invoice_state,free_ticket.payment,free_ticket.refund_pending -> free_ticket.refund_state,free_ticket.payment\n    money(10,\"EUR\"),cancelled,true,true,2,2,money(5,\"EUR\"),money(5,\"EUR\"),issued,unknown,false -> refunded,refunded\n    money(10,\"EUR\"),cancelled,true,true,2,2,money(0,\"EUR\"),money(0,\"EUR\"),void,unknown,false -> refunded,unpaid\n    money(10,\"EUR\"),cancelled,true,true,2,2,money(5,\"EUR\"),money(5,\"EUR\"),issued,unknown,true -> none,unknown\n  # Cancel all ticket sales and candidates without converting money or mail delivery into success. @{nl=\"Annuleer alle toegangsbewijsverkoop en kandidaten zonder geld of berichtverzending als succes te beschouwen.\"}\n  scenario cancel_event(event:Event,reason:text) by=organizer label=\"Cancel event\"@{nl=\"Evenement annuleren\"}\n   require can_work(actor,event.location) and not event.cancelled and trim(reason)!=\"\"\n   do\n    set event {cancelled=true,cancellation_reason=reason,revision=event.revision+1,pending_change=null}\n    schedule format(\"{event}:venues\",{event=event.id}) at=now event=VenueCleanup {event,revision=event.revision,reason}\n    schedule format(\"{event}:attendees\",{event=event.id}) at=now event=AttendeeUpdate {event,revision=event.revision,kind=cancellation,reason}\n   examples seed=[test_worker,free_ticket] event=workshop reason=\"Event cancelled\"\n    as -> workshop.cancelled,free_ticket.state,free_ticket.checked_in\n    organizer -> true,confirmed,null\n    check_in -> error(forbidden)\n  # Apply one attendee revision at a time; event cancellation already blocks sales and admission before this work runs. @{nl=\"Pas één deelnemersrevisie tegelijk toe; evenementannulering blokkeert verkoop en toegang voordat dit werk loopt.\"}\n  scenario attendee_update on=AttendeeUpdate\n   require event.event.revision==event.revision\n   do\n    let registration=first(event.event.Registration as ticket where ticket.event_revision<event.revision and (event.kind==cancellation or ticket.state in [held,pending,confirmed,review]) order=ticket.id)\n    if registration!=null\n     set registration {event_revision=event.revision}\n     if event.kind==cancellation\n      require event.event.cancelled\n      set registration {state=cancelled,refund_required=registration.price.minor>0,refund_reason=event.reason}\n      cancel registration.id\n      if registration.price.minor>0\n       set registration {refund_state=review}\n       if registration.cancel_delivery==null or registration.cancel_status in [failed,unknown,skipped]\n        send Billing.cancel {source=registration.source,reason=registration.cancel_reason??event.reason} as cancellation\n        set registration {cancel_reason=registration.cancel_reason??event.reason,cancel_delivery=cancellation.id,cancel_status=pending}\n       emit RefundCheck {registration}\n     emit AttendeeNotice {registration,kind=event.kind,revision=event.revision,body=event.reason}\n     schedule format(\"{event}:attendees\",{event=event.event.id}) at=now event=AttendeeUpdate {event=event.event,revision=event.revision,kind=event.kind,reason=event.reason}\n   examples seed=[free_ticket] event={event=workshop,revision=2,kind=cancellation,reason=\"Workshop cancelled\"}\n    workshop.revision,workshop.cancelled -> free_ticket.state,free_ticket.event_revision\n    2,true -> cancelled,2\n    3,true -> error(rule_failed)\n  # Clean up one venue source per occurrence with explicit resource routing and release-before-arrival fences. @{nl=\"Ruim één locatiebron per uitvoering op met expliciete voorzieningsroutering en vrijgaveafscherming vóór aankomst.\"}\n  scenario venue_cleanup on=VenueCleanup\n   require event.event.cancelled and event.event.revision==event.revision\n   do\n    let change=first(event.event.Change as candidate where candidate.state in [holding,confirming,adopted,review,failed] order=candidate.id)\n    if change!=null\n     set change {state=releasing}\n     if change.resource!=null\n      send Rooms.release {source=change.source,resource=change.resource.id,reason=event.reason} as delivery\n      set change {release_reason=event.reason,release_delivery=delivery.id,release_status=pending}\n     else\n      set change {state=released}\n     schedule format(\"{event}:venues\",{event=event.event.id}) at=now event=VenueCleanup {event=event.event,revision=event.revision,reason=event.reason}\n  # Freeze current event details and track revision-bound delivery to the ticket contact. @{nl=\"Leg actuele evenementdetails vast en volg revisiegebonden verzending naar de contactpersoon van het toegangsbewijs.\"}\n  scenario attendee_notice on=AttendeeNotice\n   require event.registration.parent.revision==event.revision\n   do\n    let subject=format(notice_title(event.kind),locale=null)\n    let body=format(notice_details(event.registration.parent.name,event.registration.parent.location.name,event.registration.parent.from,event.registration.parent.until,event.registration.parent.timezone,event.body,event.registration.ticket,event.revision),locale=null)+\" \"+app_url(\"/events\")\n    send Mail.send {to=event.registration.email,subject,body} when=event.registration.parent.revision==event.revision and (event.kind!=confirmation or (event.registration.state==confirmed and not event.registration.parent.cancelled)) as delivery\n    create Notice {parent=event.registration,kind=event.kind,revision=event.revision,subject,body,delivery} as notice\n   examples event={registration=free_ticket,kind=confirmation,revision=1,body=\"ticket\"}\n    event.kind,free_ticket.state,event.revision -> count(free_ticket.Notice),first(free_ticket.Notice)?.state\n    confirmation,confirmed,1 -> 1,pending\n    change,held,1 -> 1,pending\n    confirmation,held,1 -> 1,skipped\n    confirmation,confirmed,2 -> error(rule_failed)\n  # Retry eligible current correspondence with a new receipt while history retains the earlier attempt. @{nl=\"Probeer geldig huidig berichtverkeer opnieuw met een nieuwe ontvangst terwijl historie de eerdere poging bewaart.\"}\n  scenario resend_notice(notice:Notice) by=organizer label=\"Retry attendee notice\"@{nl=\"Deelnemersbericht opnieuw proberen\"}\n   require can_work(actor,notice.parent.parent.location) and notice.parent.parent.revision==notice.revision and notice.state in [failed,unknown] and (notice.kind!=confirmation or (notice.parent.state==confirmed and not notice.parent.parent.cancelled))\n   do\n    send Mail.send {to=notice.parent.email,subject=notice.subject,body=notice.body} when=notice.parent.parent.revision==notice.revision and (notice.kind!=confirmation or (notice.parent.state==confirmed and not notice.parent.parent.cancelled)) as delivery\n    create Notice {parent=notice.parent,kind=notice.kind,revision=notice.revision,subject=notice.subject,body=notice.body,delivery} as retry\n Then\n  # Discover published events and retrieve only your own tickets. @{nl=\"Ontdek gepubliceerde evenementen en haal uitsluitend je eigen toegangsbewijzen op.\"}\n  page /events title=\"Events\"@{nl=\"Evenementen\"}\n   breadcrumbs\n   hero \"Published event discovery\"@{nl=\"Gepubliceerde evenementen ontdekken\"}\n    list (Event as offering where offering.published and not offering.cancelled) columns=name,location,from,until,price,available filter=location defaults={location=preferences.location} search=name order=from display=split\n     pagination\n     ## terms stay in the browse row (visitors review terms before registering)\n     ## and repeat once inside the register dialog at decision time.\n     text row.description,row.timezone,row.from,row.until,row.price,row.sales_until,row.refund_before,row.terms,row.venue_name\n     ## Seats progress: readable numerics with compatible count units and a finite\n     ## positive maximum (UI-COMPONENTS Navigation-and-shared-state; profile table).\n     ## Owner gap: available is not in the public Event fields and counts rows a\n     ## public caller cannot read; the seats display assumes an owner grant ruling.\n     progress row.available max=row.capacity\n     button opens=register_dialog\n     modal \"Register for event\"@{nl=\"Registreren voor evenement\"} id=register_dialog\n      slot content\n       alert\n        content row.terms\n       form register arguments={event=row} display=inline\n        input name\n        input email\n   card \"Own tickets and admission\"@{nl=\"Eigen toegangsbewijzen en toelating\"}\n    require authenticated\n    list (Registration as ticket where ticket.account==actor) filter=state defaults={state=preferences.ticket_state} display=split\n     pagination\n     badge row.state\n     badge row.payment\n     badge row.charge_status\n     badge row.refund_state\n     status row.parent.cancelled\n     text row.ticket,row.expires,row.checked_in,row.terms,row.refund_before,row.parent.name,row.parent.location,row.parent.from,row.parent.until,row.parent.timezone,row.parent.cancellation_reason\n     copy row.ticket\n     table row.Notice columns=kind,revision,state\n      pagination\n     form cancel arguments={registration=row}\n      textarea reason\n     button action=reconcile arguments={registration=row}\n  # Author events and perform scoped reception admission. @{nl=\"Beheer evenementen en voer beperkte receptietoelating uit.\"}\n  page /events/work title=\"Event operations\"@{nl=\"Evenementuitvoering\"}\n   breadcrumbs\n   require organizer or check_in or finance\n   card \"Event intake\"@{nl=\"Evenement aanmaken\"}\n    require organizer\n    form Program.create\n     input name\n    list Program columns=name\n     pagination\n     ## from/until/sales_until/refund_before are datetimes: no date-only\n     ## calendar control applies; they keep generated controls.\n     form Event.create\n      input name\n      textarea description\n      textarea terms\n   list Event columns=name,location,from filter=location defaults={location=preferences.location} display=split\n    pagination\n    card \"Event and venue outcome\"@{nl=\"Evenement en locatie-uitkomst\"}\n     status row.published\n     status row.cancelled\n     text row.timezone,row.capacity,row.sales_until,row.refund_before,row.terms\n     edit\n      input name\n      textarea description\n      textarea terms\n     button action=publish arguments={event=row}\n     form change\n      textarea reason\n     form cancel_event\n      textarea reason\n     form register arguments={event=row}\n      input name\n      input email\n    table row.Change columns=location,from,until,state,venue_state,venue_revision,hold_status,confirm_status,release_status\n     pagination\n     badge row.state\n     ## abandon keeps its generated reason form (reason is required).\n     action abandon\n     button action=retry_release arguments={change=row}\n     history\n    table row.Registration columns=name,email,state,payment,ticket,checked_in filter=state,payment search=name display=split\n     pagination\n     badge row.state\n     badge row.payment\n     button action=admit arguments={registration=row}\n     collapse \"Ticket finance and history\"@{nl=\"Financiën en historie toegangsbewijs\"}\n      require organizer or finance\n      badge row.refund_state\n      badge row.charge_status\n      text row.expires,row.price,row.checked_by,row.terms,row.refund_before,row.invoice,row.delivery?.id,row.collected,row.refunded,row.cancel_status,row.refund_status,row.reconcile_status\n      form cancel arguments={registration=row}\n       textarea reason\n      form refund arguments={registration=row}\n       textarea reason\n      button action=reconcile arguments={registration=row}\n      table row.Notice columns=kind,revision,state\n       pagination\n       button action=resend_notice arguments={notice=row}\n      history\n"}}
