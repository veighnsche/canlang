{"coverage":true,"parse_codes":[],"result":{"after_codes":[],"after_coverage":true,"after_projection_sha256":"4ae1ac25499b71abf2d881f223fe5d8f7f37d8cd73b7d1398eca541ef5b6e598","before_projection_sha256":"4ae1ac25499b71abf2d881f223fe5d8f7f37d8cd73b7d1398eca541ef5b6e598","changed":false,"idempotent":true,"structure_equal":true,"text":"# Help the workspace operator's leadership or advisory board prepare meetings about locations, investment, and operating performance, then retain their decisions. @{nl=\"Help het bestuur of de adviesraad van de werkplekexploitant vergaderingen over locaties, investeringen en bedrijfsresultaten voorbereiden en hun besluiten bewaren.\"}\napp CanBoard uses=[board]\n\n# Preserve finalized board papers and decisions with attributed amendments and separate action completion. @{nl=\"Bewaar definitieve bestuursstukken en besluiten met toegeschreven aanvullingen en afzonderlijke actieafronding.\"}\npackage board label=\"Governance\"@{nl=\"Bestuur\"}\n use rent_catalog {Location,test_site}\n Given\n  contract ActionOrigin { resolution:text, meeting:text } label=\"Action origin\"@{nl=\"Herkomst actie\"}\n  export contract WorkItem { reference:text, revision:int, location:text?, title:text, detail:text?, due:datetime?, action:action(complete) } label=\"Authorized work item\"@{nl=\"Toegestaan werkitem\"}\n  export contract WorkBatch { items:WorkItem[]! max=500 } label=\"Authorized work batch\"@{nl=\"Toegestane werkverzameling\"}\n  role board_member label=\"Board member\"@{nl=\"Bestuurslid\"}\n  role coordinator label=\"Coordinator\"@{nl=\"Coördinator\"}\n  role secretary label=\"Board recorder\"@{nl=\"Bestuurssecretaris\"}\n  Meeting { title:text, at:datetime, timezone:timezone, location:Location, attendance:user[] label=\"Attendance\"@{nl=\"Aanwezigheid\"}, minutes:text? label=\"Minutes\"@{nl=\"Notulen\"}, finalized:bool=false label=label_Meeting_finalized, finalized_by:user? label=\"Finalized by\"@{nl=\"Definitief gemaakt door\"}, finalized_at:datetime? label=\"Finalization time\"@{nl=\"Definitief gemaakt op\"} } label=\"Meeting\"@{nl=\"Vergadering\"}\n  Agenda in Meeting { title:text, position:int min=1 label=\"Position\"@{nl=\"Volgorde\"}, paper:file? label=label_Agenda_paper, discussion:text? label=\"Discussion\"@{nl=\"Bespreking\"} } label=\"Agenda item\"@{nl=\"Agendapunt\"}\n  Resolution in Meeting { title:text, outcome:enum(proposed,accepted,rejected)=proposed label={text=\"Outcome\"@{nl=\"Uitkomst\"},values={proposed=\"Proposed\"@{nl=\"Voorgesteld\"},accepted=\"Accepted\"@{nl=\"Geaccepteerd\"},rejected=\"Rejected\"@{nl=\"Afgewezen\"}}}, evidence:text?, decided_by:user? label=\"Decision maker\"@{nl=\"Beslist door\"}, decided_at:datetime? label=\"Decision time\"@{nl=\"Beslist op\"} } label=\"Resolution\"@{nl=\"Besluit\"}\n  Amendment in Meeting { text:text label=\"Text\"@{nl=\"Tekst\"}, paper:file? label=label_Agenda_paper, author:user server=actor label=\"Author\"@{nl=\"Auteur\"} } label=\"Amendment\"@{nl=\"Aanvulling\"}\n  export Action in Resolution { title:text, owner:user label=\"Responsible person\"@{nl=\"Verantwoordelijke\"}, due:date, done:bool=false, completed_by:user? label=\"Completed by\"@{nl=\"Afgerond door\"}, completed_at:datetime? label=\"Completion time\"@{nl=\"Afgerond op\"} } label=\"Board action\"@{nl=\"Bestuursactie\"}\n  policy Meeting read=board_member or coordinator or secretary\n  policy Agenda read=board_member or coordinator or secretary\n  policy Resolution read=board_member or coordinator or secretary\n  policy Amendment read=board_member or coordinator or secretary\n  policy Action read=board_member or coordinator or secretary\n  policy Action read=members where=row.owner==actor\n  lock Meeting fields=title,at,timezone,location,attendance,minutes,finalized,finalized_by,finalized_at when=row.finalized\n  lock Agenda fields=title,position,paper,discussion when=row.parent.finalized\n  lock Resolution fields=title,outcome,evidence,decided_by,decided_at when=row.parent.finalized\n  lock Amendment fields=text,paper,author\n  fixture prepared=Meeting {title=\"Expansion\",at=datetime(\"2099-01-01T09:00:00Z\"),timezone=\"Europe/Brussels\",location=test_site,minutes=\"Recorded discussion\"}\n  fixture presented=file {}\n  fixture replacement=file {}\n  fixture paper_item=Agenda {parent=prepared,title=\"Expansion plan\",position=1,paper=presented,discussion=\"Discussed location opening\"}\n  fixture decision=Resolution {parent=prepared,title=\"Open location\",outcome=accepted,evidence=\"Approved expansion budget\",decided_by=self,decided_at=now}\n  fixture correction=Amendment {parent=prepared,text=\"Recorded attendance correction\",paper=replacement,author=self}\n  fixture assigned=Action {parent=decision,title=\"Arrange opening\",owner=self,due=date(\"2099-01-02\")}\n  preferences { finalized:bool? label=label_Meeting_finalized, amendments_open:bool=false label=\"Expand meeting amendments\"@{nl=\"Vergaderaanvullingen uitklappen\"} }\n  message label_Meeting_finalized = \"Finalized\"@{nl=\"Definitief\"}\n  message label_Agenda_paper = \"Paper\"@{nl=\"Vergaderstuk\"}\n When\n  crud Meeting by=coordinator fields=title,at,timezone,location,attendance,minutes when=not row.finalized delete=none\n   examples update record=prepared changes={minutes=\"Corrected draft\"}\n    as,record.finalized -> prepared.minutes\n    coordinator,false -> \"Corrected draft\"\n    coordinator,true -> error(rule_failed)\n  crud Agenda by=coordinator fields=title,position,paper,discussion when=not row.parent.finalized delete=none\n   examples update record=paper_item changes={paper=replacement}\n    as,record.parent.finalized -> paper_item.paper\n    coordinator,false -> replacement\n    coordinator,true -> error(rule_failed)\n  crud Resolution by=coordinator fields=title when=not row.parent.finalized delete=none\n  crud Amendment by=secretary fields=text,paper update=none delete=none when=row.parent.finalized\n   examples create seed=[paper_item,decision] parent=prepared text=\"Correction to the recorded attendance\" paper=replacement\n    as,parent.finalized -> count(prepared.Amendment),prepared.minutes,paper_item.paper,decision.evidence\n    secretary,true -> 1,\"Recorded discussion\",presented,\"Approved expansion budget\"\n    secretary,false -> error(rule_failed)\n    board_member,true -> error(forbidden)\n  crud Action by=secretary fields=title,owner,due when=row.parent.outcome==accepted delete=none\n  # Record a manual resolution with evidence before finalizing the meeting. @{nl=\"Leg een handmatig besluit met bewijs vast voordat de vergadering definitief wordt.\"}\n  scenario decide(resolution:Resolution,accept:bool label=\"Accept\"@{nl=\"Accepteren\"},evidence:text) by=secretary label=\"Record decision\"@{nl=\"Besluit vastleggen\"}\n   require not resolution.parent.finalized and trim(evidence)!=\"\"\n   do\n    if accept\n     set resolution {outcome=accepted,evidence,decided_by=actor,decided_at=now}\n    else\n     set resolution {outcome=rejected,evidence,decided_by=actor,decided_at=now}\n   examples resolution=decision accept=true evidence=\"Recorded approval\"\n    as,resolution.parent.finalized,accept,evidence -> resolution.outcome,resolution.evidence,resolution.decided_by,resolution.decided_at\n    secretary,false,true,\"Recorded approval\" -> accepted,\"Recorded approval\",self,now\n    secretary,false,false,\"No funding\" -> rejected,\"No funding\",self,now\n    secretary,false,true,\" \" -> error(rule_failed)\n    secretary,true,true,\"Recorded approval\" -> error(rule_failed)\n    board_member,false,true,\"Recorded approval\" -> error(forbidden)\n  # Freeze the meeting record and its presented paper versions. @{nl=\"Maak het vergaderverslag en de gepresenteerde stukversies onveranderlijk.\"}\n  scenario finalize(meeting:Meeting) by=secretary label=\"Finalize minutes\"@{nl=\"Notulen definitief maken\"}\n   require not meeting.finalized and meeting.minutes!=null and all(meeting.Resolution as resolution,resolution.outcome!=proposed)\n   do set meeting {finalized=true,finalized_by=actor,finalized_at=now}\n   examples seed=[paper_item,decision] meeting=prepared\n    as,meeting.finalized,meeting.minutes,decision.outcome -> meeting.finalized,meeting.finalized_by,meeting.finalized_at,paper_item.paper,decision.evidence\n    secretary,false,\"Recorded discussion\",accepted -> true,self,now,presented,\"Approved expansion budget\"\n    secretary,true,\"Recorded discussion\",accepted -> error(rule_failed)\n    board_member,false,\"Recorded discussion\",accepted -> error(forbidden)\n    secretary,false,null,accepted -> error(rule_failed)\n    secretary,false,\"Recorded discussion\",proposed -> error(rule_failed)\n  # Retrieve the finalized meeting with its declared papers, decisions, and amendments for authorized printing. @{nl=\"Haal de definitieve vergadering met de gedeclareerde stukken, besluiten en aanvullingen op om bevoegd af te drukken.\"}\n  scenario finalized_record(meeting:Meeting) read=true -> Meeting by=board_member or coordinator or secretary label=\"Open printable minutes\"@{nl=\"Afdrukbare notulen openen\"}\n   require meeting.finalized\n   do return meeting\n   examples seed=[paper_item,decision,correction] meeting=prepared\n    as,meeting.finalized -> result.minutes,count(result.Agenda),count(result.Resolution),count(result.Amendment),paper_item.paper,correction.paper\n    board_member,true -> \"Recorded discussion\",1,1,1,presented,replacement\n    public,true -> error(forbidden)\n   examples meeting=prepared\n    as,meeting.finalized -> result.minutes\n    coordinator,false -> error(rule_failed)\n  # Complete only your assigned action without amending the board decision. @{nl=\"Rond alleen je toegewezen actie af zonder het bestuursbesluit te wijzigen.\"}\n  export scenario complete(action:Action) by=members or secretary\n   require (action.owner==actor or secretary) and not action.done and action.parent.outcome==accepted\n   do set action {done=true,completed_by=actor,completed_at=now}\n   examples action=assigned\n    as,action.owner,action.done,action.parent.outcome,action.parent.parent.finalized -> action.done,action.completed_by,action.completed_at,decision.evidence,prepared.finalized\n    members,self,false,accepted,true -> true,self,now,\"Approved expansion budget\",true\n    secretary,other,false,accepted,true -> true,self,now,\"Approved expansion budget\",true\n    members,other,false,accepted,true -> error(rule_failed)\n    members,self,true,accepted,true -> error(rule_failed)\n    members,self,false,rejected,true -> error(rule_failed)\n    public,self,false,accepted,true -> error(forbidden)\n  # Expose only source titles to an assigned member, never board papers or decision evidence. @{nl=\"Toon alleen brontitels aan een toegewezen lid, nooit bestuursstukken of besluitbewijs.\"}\n  scenario origin(action:Action) read=true scope=authority -> ActionOrigin by=members or secretary\n   require action.owner==actor or secretary\n   do return ActionOrigin {resolution=action.parent.title,meeting=action.parent.parent.title}\n   examples action=assigned\n    as,action.owner,action.done -> result.resolution,result.meeting\n    members,self,false -> \"Open location\",\"Expansion\"\n    members,self,true -> \"Open location\",\"Expansion\"\n    members,other,false -> error(rule_failed)\n    public,self,false -> error(forbidden)\n  # Return only current eligible work under the canonical completion authority. @{nl=\"Geef alleen actueel uitvoerbaar werk terug binnen de canonieke afrondingsbevoegdheid.\"}\n  export scenario work(locations:text[]) read=true scope=authority -> WorkBatch by=members or secretary\n   do return WorkBatch {items=Action as item where ((item.owner==actor or secretary) and not item.done and item.parent.outcome==accepted) and (count(locations)==0 or item.parent.parent.location.id in locations) select WorkItem {reference=item.id,revision=item.version,location=item.parent.parent.location.id,title=item.title,detail=item.parent.title,due=local_instant(item.due,\"00:00\",item.parent.parent.timezone,fold=earlier),action=action(complete,{action=item})}}\n  # Revalidate the selected item before presenting its protected canonical action. @{nl=\"Controleer het gekozen item opnieuw voordat de beschermde canonieke actie wordt getoond.\"}\n  export scenario work_detail(record:Action) read=true scope=authority -> WorkItem by=members or secretary\n   require (record.owner==actor or secretary) and not record.done and record.parent.outcome==accepted\n   do return WorkItem {reference=record.id,revision=record.version,location=record.parent.parent.location.id,title=record.title,detail=record.parent.title,due=local_instant(record.due,\"00:00\",record.parent.parent.timezone,fold=earlier),action=action(complete,{action=record})}\n Then\n  # Read ordered papers and retain the finalized minutes with amendments. @{nl=\"Lees stukken op volgorde en bewaar de definitieve notulen met aanvullingen.\"}\n  page /board title=\"Board records\"@{nl=\"Bestuursverslagen\"}\n   require board_member or coordinator or secretary\n   breadcrumbs\n   card \"Meeting intake\"@{nl=\"Vergadering aanmaken\"}\n    form Meeting.create\n   list Meeting columns=title,at,location,finalized order=-at filter=finalized defaults={finalized=preferences.finalized} search=title display=split empty=\"No meetings match this filter.\"@{nl=\"Geen vergaderingen voor dit filter.\"}\n    pagination\n    text row.finalized\n    card \"Meeting and attendance\"@{nl=\"Vergadering en aanwezigheid\"}\n     text row.at,row.timezone,row.location,row.attendance,row.minutes,row.finalized,row.finalized_by\n     ## Finalized meetings show an immutability notice; the gate omits the alert for drafts.\n     alert\n      require row.finalized\n      text \"Finalized minutes are immutable; later corrections use amendments.\"@{nl=\"Definitieve notulen zijn onveranderlijk; latere correcties gebruiken aanvullingen.\"}\n     edit\n     action finalize\n    tabs\n     tab \"Agenda and papers\"@{nl=\"Agenda en stukken\"}\n      form Agenda.create\n       input title\n       input position\n       file_input paper\n       textarea discussion\n      table row.Agenda columns=position,title,paper,discussion order=position empty=\"No agenda items yet.\"@{nl=\"Nog geen agendapunten.\"}\n       pagination\n       card\n        require row.paper!=null\n        button target=row.paper caption=\"Open paper\"@{nl=\"Stuk openen\"}\n       edit\n     tab \"Resolutions and actions\"@{nl=\"Besluiten en acties\"}\n      form Resolution.create\n      list row.Resolution columns=title,outcome,evidence empty=\"No resolutions yet.\"@{nl=\"Nog geen besluiten.\"}\n       pagination\n       badge row.outcome\n       button opens=decide_resolution\n       modal \"Record decision\"@{nl=\"Besluit vastleggen\"} id=decide_resolution\n        slot content\n         form decide arguments={resolution=row} display=inline\n          ## Decisions stay manual with evidence; the bound resolution is protected and accept/evidence keep typed controls.\n          fieldset \"Record decision\"@{nl=\"Besluit vastleggen\"}\n           checkbox accept\n           textarea evidence\n       form Action.create\n        ## owner:user keeps its generated entry: no user-picker vocabulary.\n        fieldset \"Action assignment\"@{nl=\"Actietoewijzing\"}\n         input title\n         calendar due\n       table row.Action columns=title,owner,due,done order=due filter=done empty=\"No actions assigned.\"@{nl=\"Geen acties toegewezen.\"}\n        pagination\n        text row.done\n        tooltip \"Complete this action\"@{nl=\"Deze actie afronden\"}\n         button action=complete\n        collapse \"Completion evidence\"@{nl=\"Bewijs afronding\"}\n         text row.completed_by,row.completed_at\n     tab \"Final minutes and amendments\"@{nl=\"Definitieve notulen en aanvullingen\"}\n      form finalized_record\n       text result.title,result.at,result.timezone,result.location,result.attendance,result.minutes,result.finalized_by,result.finalized_at\n       table result.Agenda columns=position,title,paper,discussion order=position empty=\"No agenda items recorded.\"@{nl=\"Geen agendapunten vastgelegd.\"}\n        pagination\n       list result.Resolution columns=title,outcome,evidence,decided_by,decided_at empty=\"No resolutions recorded.\"@{nl=\"Geen besluiten vastgelegd.\"}\n        pagination\n       collapse \"Recorded amendments\"@{nl=\"Vastgelegde aanvullingen\"} open=preferences.amendments_open\n        ## Amendments are ordered attributed entries; the timeline renders one item per admitted amendment in stable order.\n        timeline result.Amendment\n         slot item\n          content row.text\n          text row.paper,row.author\n      form Amendment.create\n       textarea text\n       file_input paper\n    history\n\n  # Follow assigned outstanding actions under their own operation. @{nl=\"Volg toegewezen openstaande acties via hun eigen operatie.\"}\n  page /board/actions title=\"Board actions\"@{nl=\"Bestuursacties\"}\n   require members\n   breadcrumbs\n   table Action columns=title,owner,due,done order=due filter=done display=split empty=\"No outstanding actions.\"@{nl=\"Geen openstaande acties.\"}\n    pagination\n    text row.done\n    form origin\n     text result.resolution,result.meeting\n    tooltip \"Complete this action\"@{nl=\"Deze actie afronden\"}\n     button action=complete\n    collapse \"Action evidence\"@{nl=\"Actiebewijs\"}\n     text row.completed_by,row.completed_at\n"}}
