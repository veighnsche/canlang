# Help the workspace operator's leadership or advisory board prepare meetings about locations, investment, and operating performance, then retain their decisions. @{nl="Help het bestuur of de adviesraad van de werkplekexploitant vergaderingen over locaties, investeringen en bedrijfsresultaten voorbereiden en hun besluiten bewaren."}
app CanBoard uses=[board]

# Preserve finalized board papers and decisions with attributed amendments and separate action completion. @{nl="Bewaar definitieve bestuursstukken en besluiten met toegeschreven aanvullingen en afzonderlijke actieafronding."}
package board label="Governance"@{nl="Bestuur"}
 use rent_catalog {Location,test_site}
 Given
  contract ActionOrigin { resolution:text, meeting:text } label="Action origin"@{nl="Herkomst actie"}
  export contract WorkItem { reference:text, revision:int, location:text?, title:text, detail:text?, due:datetime?, action:action(complete) } label="Authorized work item"@{nl="Toegestaan werkitem"}
  export contract WorkBatch { items:WorkItem[]! max=500 } label="Authorized work batch"@{nl="Toegestane werkverzameling"}
  role board_member label="Board member"@{nl="Bestuurslid"}
  role coordinator label="Coordinator"@{nl="Coördinator"}
  role secretary label="Board recorder"@{nl="Bestuurssecretaris"}
  Meeting { title:text, at:datetime, timezone:timezone, location:Location, attendance:user[] label="Attendance"@{nl="Aanwezigheid"}, minutes:text? label="Minutes"@{nl="Notulen"}, finalized:bool=false label=label_Meeting_finalized, finalized_by:user? label="Finalized by"@{nl="Definitief gemaakt door"}, finalized_at:datetime? label="Finalization time"@{nl="Definitief gemaakt op"} } label="Meeting"@{nl="Vergadering"}
  Agenda in Meeting { title:text, position:int min=1 label="Position"@{nl="Volgorde"}, paper:file? label=label_Agenda_paper, discussion:text? label="Discussion"@{nl="Bespreking"} } label="Agenda item"@{nl="Agendapunt"}
  Resolution in Meeting { title:text, outcome:enum(proposed,accepted,rejected)=proposed label={text="Outcome"@{nl="Uitkomst"},values={proposed="Proposed"@{nl="Voorgesteld"},accepted="Accepted"@{nl="Geaccepteerd"},rejected="Rejected"@{nl="Afgewezen"}}}, evidence:text?, decided_by:user? label="Decision maker"@{nl="Beslist door"}, decided_at:datetime? label="Decision time"@{nl="Beslist op"} } label="Resolution"@{nl="Besluit"}
  Amendment in Meeting { text:text label="Text"@{nl="Tekst"}, paper:file? label=label_Agenda_paper, author:user server=actor label="Author"@{nl="Auteur"} } label="Amendment"@{nl="Aanvulling"}
  export Action in Resolution { title:text, owner:user label="Responsible person"@{nl="Verantwoordelijke"}, due:date, done:bool=false, completed_by:user? label="Completed by"@{nl="Afgerond door"}, completed_at:datetime? label="Completion time"@{nl="Afgerond op"} } label="Board action"@{nl="Bestuursactie"}
  policy Meeting read=board_member or coordinator or secretary
  policy Agenda read=board_member or coordinator or secretary
  policy Resolution read=board_member or coordinator or secretary
  policy Amendment read=board_member or coordinator or secretary
  policy Action read=board_member or coordinator or secretary
  policy Action read=members where=row.owner==actor
  lock Meeting fields=title,at,timezone,location,attendance,minutes,finalized,finalized_by,finalized_at when=row.finalized
  lock Agenda fields=title,position,paper,discussion when=row.parent.finalized
  lock Resolution fields=title,outcome,evidence,decided_by,decided_at when=row.parent.finalized
  lock Amendment fields=text,paper,author
  fixture prepared=Meeting {title="Expansion",at=datetime("2099-01-01T09:00:00Z"),timezone="Europe/Brussels",location=test_site,minutes="Recorded discussion"}
  fixture presented=file {}
  fixture replacement=file {}
  fixture paper_item=Agenda {parent=prepared,title="Expansion plan",position=1,paper=presented,discussion="Discussed location opening"}
  fixture decision=Resolution {parent=prepared,title="Open location",outcome=accepted,evidence="Approved expansion budget",decided_by=self,decided_at=now}
  fixture correction=Amendment {parent=prepared,text="Recorded attendance correction",paper=replacement,author=self}
  fixture assigned=Action {parent=decision,title="Arrange opening",owner=self,due=date("2099-01-02")}
  preferences { finalized:bool? label=label_Meeting_finalized, amendments_open:bool=false label="Expand meeting amendments"@{nl="Vergaderaanvullingen uitklappen"} }
  message label_Meeting_finalized = "Finalized"@{nl="Definitief"}
  message label_Agenda_paper = "Paper"@{nl="Vergaderstuk"}
 When
  crud Meeting by=coordinator fields=title,at,timezone,location,attendance,minutes when=not row.finalized delete=none
   examples update record=prepared changes={minutes="Corrected draft"}
    as,record.finalized -> prepared.minutes
    coordinator,false -> "Corrected draft"
    coordinator,true -> error(rule_failed)
  crud Agenda by=coordinator fields=title,position,paper,discussion when=not row.parent.finalized delete=none
   examples update record=paper_item changes={paper=replacement}
    as,record.parent.finalized -> paper_item.paper
    coordinator,false -> replacement
    coordinator,true -> error(rule_failed)
  crud Resolution by=coordinator fields=title when=not row.parent.finalized delete=none
  crud Amendment by=secretary fields=text,paper update=none delete=none when=row.parent.finalized
   examples create seed=[paper_item,decision] parent=prepared text="Correction to the recorded attendance" paper=replacement
    as,parent.finalized -> count(prepared.Amendment),prepared.minutes,paper_item.paper,decision.evidence
    secretary,true -> 1,"Recorded discussion",presented,"Approved expansion budget"
    secretary,false -> error(rule_failed)
    board_member,true -> error(forbidden)
  crud Action by=secretary fields=title,owner,due when=row.parent.outcome==accepted delete=none
  # Record a manual resolution with evidence before finalizing the meeting. @{nl="Leg een handmatig besluit met bewijs vast voordat de vergadering definitief wordt."}
  scenario decide(resolution:Resolution,accept:bool label="Accept"@{nl="Accepteren"},evidence:text) by=secretary label="Record decision"@{nl="Besluit vastleggen"}
   require not resolution.parent.finalized and trim(evidence)!=""
   do
    if accept
     set resolution {outcome=accepted,evidence,decided_by=actor,decided_at=now}
    else
     set resolution {outcome=rejected,evidence,decided_by=actor,decided_at=now}
   examples resolution=decision accept=true evidence="Recorded approval"
    as,resolution.parent.finalized,accept,evidence -> resolution.outcome,resolution.evidence,resolution.decided_by,resolution.decided_at
    secretary,false,true,"Recorded approval" -> accepted,"Recorded approval",self,now
    secretary,false,false,"No funding" -> rejected,"No funding",self,now
    secretary,false,true," " -> error(rule_failed)
    secretary,true,true,"Recorded approval" -> error(rule_failed)
    board_member,false,true,"Recorded approval" -> error(forbidden)
  # Freeze the meeting record and its presented paper versions. @{nl="Maak het vergaderverslag en de gepresenteerde stukversies onveranderlijk."}
  scenario finalize(meeting:Meeting) by=secretary label="Finalize minutes"@{nl="Notulen definitief maken"}
   require not meeting.finalized and meeting.minutes!=null and all(meeting.Resolution as resolution,resolution.outcome!=proposed)
   do set meeting {finalized=true,finalized_by=actor,finalized_at=now}
   examples seed=[paper_item,decision] meeting=prepared
    as,meeting.finalized,meeting.minutes,decision.outcome -> meeting.finalized,meeting.finalized_by,meeting.finalized_at,paper_item.paper,decision.evidence
    secretary,false,"Recorded discussion",accepted -> true,self,now,presented,"Approved expansion budget"
    secretary,true,"Recorded discussion",accepted -> error(rule_failed)
    board_member,false,"Recorded discussion",accepted -> error(forbidden)
    secretary,false,null,accepted -> error(rule_failed)
    secretary,false,"Recorded discussion",proposed -> error(rule_failed)
  # Retrieve the finalized meeting with its declared papers, decisions, and amendments for authorized printing. @{nl="Haal de definitieve vergadering met de gedeclareerde stukken, besluiten en aanvullingen op om bevoegd af te drukken."}
  scenario finalized_record(meeting:Meeting) read=true -> Meeting by=board_member or coordinator or secretary label="Open printable minutes"@{nl="Afdrukbare notulen openen"}
   require meeting.finalized
   do return meeting
   examples seed=[paper_item,decision,correction] meeting=prepared
    as,meeting.finalized -> result.minutes,count(result.Agenda),count(result.Resolution),count(result.Amendment),paper_item.paper,correction.paper
    board_member,true -> "Recorded discussion",1,1,1,presented,replacement
    public,true -> error(forbidden)
   examples meeting=prepared
    as,meeting.finalized -> result.minutes
    coordinator,false -> error(rule_failed)
  # Complete only your assigned action without amending the board decision. @{nl="Rond alleen je toegewezen actie af zonder het bestuursbesluit te wijzigen."}
  export scenario complete(action:Action) by=members or secretary
   require (action.owner==actor or secretary) and not action.done and action.parent.outcome==accepted
   do set action {done=true,completed_by=actor,completed_at=now}
   examples action=assigned
    as,action.owner,action.done,action.parent.outcome,action.parent.parent.finalized -> action.done,action.completed_by,action.completed_at,decision.evidence,prepared.finalized
    members,self,false,accepted,true -> true,self,now,"Approved expansion budget",true
    secretary,other,false,accepted,true -> true,self,now,"Approved expansion budget",true
    members,other,false,accepted,true -> error(rule_failed)
    members,self,true,accepted,true -> error(rule_failed)
    members,self,false,rejected,true -> error(rule_failed)
    public,self,false,accepted,true -> error(forbidden)
  # Expose only source titles to an assigned member, never board papers or decision evidence. @{nl="Toon alleen brontitels aan een toegewezen lid, nooit bestuursstukken of besluitbewijs."}
  scenario origin(action:Action) read=true scope=authority -> ActionOrigin by=members or secretary
   require action.owner==actor or secretary
   do return ActionOrigin {resolution=action.parent.title,meeting=action.parent.parent.title}
   examples action=assigned
    as,action.owner,action.done -> result.resolution,result.meeting
    members,self,false -> "Open location","Expansion"
    members,self,true -> "Open location","Expansion"
    members,other,false -> error(rule_failed)
    public,self,false -> error(forbidden)
  # Return only current eligible work under the canonical completion authority. @{nl="Geef alleen actueel uitvoerbaar werk terug binnen de canonieke afrondingsbevoegdheid."}
  export scenario work(locations:text[]) read=true scope=authority -> WorkBatch by=members or secretary
   do return WorkBatch {items=Action as item where ((item.owner==actor or secretary) and not item.done and item.parent.outcome==accepted) and (count(locations)==0 or item.parent.parent.location.id in locations) select WorkItem {reference=item.id,revision=item.version,location=item.parent.parent.location.id,title=item.title,detail=item.parent.title,due=local_instant(item.due,"00:00",item.parent.parent.timezone,fold=earlier),action=action(complete,{action=item})}}
  # Revalidate the selected item before presenting its protected canonical action. @{nl="Controleer het gekozen item opnieuw voordat de beschermde canonieke actie wordt getoond."}
  export scenario work_detail(record:Action) read=true scope=authority -> WorkItem by=members or secretary
   require (record.owner==actor or secretary) and not record.done and record.parent.outcome==accepted
   do return WorkItem {reference=record.id,revision=record.version,location=record.parent.parent.location.id,title=record.title,detail=record.parent.title,due=local_instant(record.due,"00:00",record.parent.parent.timezone,fold=earlier),action=action(complete,{action=record})}
 Then
  # Read ordered papers and retain the finalized minutes with amendments. @{nl="Lees stukken op volgorde en bewaar de definitieve notulen met aanvullingen."}
  page /board title="Board records"@{nl="Bestuursverslagen"}
   require board_member or coordinator or secretary
   breadcrumbs
   card "Meeting intake"@{nl="Vergadering aanmaken"}
    form Meeting.create
   list Meeting columns=title,at,location,finalized order=-at filter=finalized defaults={finalized=preferences.finalized} search=title display=split empty="No meetings match this filter."@{nl="Geen vergaderingen voor dit filter."}
    pagination
    text row.finalized
    card "Meeting and attendance"@{nl="Vergadering en aanwezigheid"}
     text row.at,row.timezone,row.location,row.attendance,row.minutes,row.finalized,row.finalized_by
     ## Finalized meetings show an immutability notice; the gate omits the alert for drafts.
     alert
      require row.finalized
      text "Finalized minutes are immutable; later corrections use amendments."@{nl="Definitieve notulen zijn onveranderlijk; latere correcties gebruiken aanvullingen."}
     edit
     action finalize
    tabs
     tab "Agenda and papers"@{nl="Agenda en stukken"}
      form Agenda.create
       input title
       input position
       file_input paper
       textarea discussion
      table row.Agenda columns=position,title,paper,discussion order=position empty="No agenda items yet."@{nl="Nog geen agendapunten."}
       pagination
       card
        require row.paper!=null
        button target=row.paper caption="Open paper"@{nl="Stuk openen"}
       edit
     tab "Resolutions and actions"@{nl="Besluiten en acties"}
      form Resolution.create
      list row.Resolution columns=title,outcome,evidence empty="No resolutions yet."@{nl="Nog geen besluiten."}
       pagination
       badge row.outcome
       button opens=decide_resolution
       modal "Record decision"@{nl="Besluit vastleggen"} id=decide_resolution
        slot content
         form decide arguments={resolution=row} display=inline
          ## Decisions stay manual with evidence; the bound resolution is protected and accept/evidence keep typed controls.
          fieldset "Record decision"@{nl="Besluit vastleggen"}
           checkbox accept
           textarea evidence
       form Action.create
        ## owner:user keeps its generated entry: no user-picker vocabulary.
        fieldset "Action assignment"@{nl="Actietoewijzing"}
         input title
         calendar due
       table row.Action columns=title,owner,due,done order=due filter=done empty="No actions assigned."@{nl="Geen acties toegewezen."}
        pagination
        text row.done
        tooltip "Complete this action"@{nl="Deze actie afronden"}
         button action=complete
        collapse "Completion evidence"@{nl="Bewijs afronding"}
         text row.completed_by,row.completed_at
     tab "Final minutes and amendments"@{nl="Definitieve notulen en aanvullingen"}
      form finalized_record
       text result.title,result.at,result.timezone,result.location,result.attendance,result.minutes,result.finalized_by,result.finalized_at
       table result.Agenda columns=position,title,paper,discussion order=position empty="No agenda items recorded."@{nl="Geen agendapunten vastgelegd."}
        pagination
       list result.Resolution columns=title,outcome,evidence,decided_by,decided_at empty="No resolutions recorded."@{nl="Geen besluiten vastgelegd."}
        pagination
       collapse "Recorded amendments"@{nl="Vastgelegde aanvullingen"} open=preferences.amendments_open
        ## Amendments are ordered attributed entries; the timeline renders one item per admitted amendment in stable order.
        timeline result.Amendment
         slot item
          content row.text
          text row.paper,row.author
      form Amendment.create
       textarea text
       file_input paper
    history

  # Follow assigned outstanding actions under their own operation. @{nl="Volg toegewezen openstaande acties via hun eigen operatie."}
  page /board/actions title="Board actions"@{nl="Bestuursacties"}
   require members
   breadcrumbs
   table Action columns=title,owner,due,done order=due filter=done display=split empty="No outstanding actions."@{nl="Geen openstaande acties."}
    pagination
    text row.done
    form origin
     text result.resolution,result.meeting
    tooltip "Complete this action"@{nl="Deze actie afronden"}
     button action=complete
    collapse "Action evidence"@{nl="Actiebewijs"}
     text row.completed_by,row.completed_at
