# Help workspace members suggest improvements to facilities, amenities, and booking services and see the operator's response. @{nl="Help werkplekleden verbeteringen voorstellen voor faciliteiten, voorzieningen en boekingsdiensten en het antwoord van de exploitant bekijken."}
app CanFeedback uses=[feedback]

# Collect owned suggestions and votes while reserving moderation and roadmap decisions for product owners. @{nl="Verzamel eigen suggesties en stemmen en reserveer moderatie en roadmapbesluiten voor productverantwoordelijken."}
package feedback
 use rent_catalog {Location}
 use employee {can_work}
 use desk {open_request}
 Given
  role product_owner label="Product owner"@{nl="Productverantwoordelijke"}
  Product { name:text, location:Location?, owner:user label="Responsible person"@{nl="Verantwoordelijke"}, published:bool=true label="Published"@{nl="Gepubliceerd"} } label="Product"@{nl="Product"}
  Suggestion in Product { title:text trim min=1 max=300, description:text trim min=1 max=5000, category:text trim min=1 max=100 label="Category"@{nl="Categorie"}, author:user server=actor label="Author"@{nl="Auteur"}, status:enum(proposed,planned,shipped,declined)=proposed label={text=label_Suggestion_status,values={proposed="Proposed"@{nl="Voorgesteld"},planned="Planned"@{nl="Gepland"},shipped="Shipped"@{nl="Opgeleverd"},declined="Declined"@{nl="Afgewezen"}}}, hidden:bool=true label=label_Suggestion_hidden, moderation_reason:text? label="Moderation reason"@{nl="Moderatiegrond"}, response:text? label=label_Suggestion_response, duplicate:Suggestion? label=label_Suggestion_duplicate, current_decision:Decision? label="Current operator decision"@{nl="Huidig exploitantbesluit"} } label=label_Suggestion
  Vote in Suggestion { account:user server=actor label="Account"@{nl="Account"}, active:bool=true, cast_at:datetime server=now label="Last vote time"@{nl="Laatste stemtijd"} } label="Own vote"@{nl="Eigen stem"}
  Decision in Suggestion { status:Suggestion.status, response:text label=label_Suggestion_response, published_at:datetime? label="Released at"@{nl="Vrijgegeven op"}, withdrawn:bool=false label="Withdrawn"@{nl="Ingetrokken"}, withdrawal_reason:text? label="Withdrawal reason"@{nl="Reden van intrekking"} } label="Operator decision"@{nl="Exploitantbesluit"}
  contract Card { suggestion:Suggestion label=label_Suggestion, title:text, category:Suggestion.category, status:Suggestion.status, response:text? label=label_Suggestion_response, duplicate:Suggestion? label=label_Suggestion_duplicate, votes:int label="Votes"@{nl="Stemmen"} } label="Published suggestion"@{nl="Gepubliceerde suggestie"}
  contract Roadmap { items:Card[]! label="Items"@{nl="Items"} } label="Published roadmap"@{nl="Gepubliceerde roadmap"}
  contract DecisionCard { status:Suggestion.status, response:text label=label_Suggestion_response, published_at:datetime label="Released at"@{nl="Vrijgegeven op"} }
  contract DecisionHistory { items:DecisionCard[]! label="Released decisions"@{nl="Vrijgegeven besluiten"} }
  contract ProductChoice { product:Product label="Product"@{nl="Product"}, name:text, location:Location? }
  policy Product read=public where=row.published
  policy Product read=product_owner where=row.owner==actor
  policy Suggestion read=public where=row.parent.published and not row.hidden fields=title,description,category,status,response
  policy Suggestion read=authenticated where=row.author==actor
  policy Suggestion read=product_owner where=row.parent.owner==actor
  policy Vote read=authenticated where=row.account==actor
  policy Decision read=product_owner where=row.parent.parent.owner==actor
  unique Vote fields=account
  invariant Suggestion: row.duplicate==null or (row.duplicate!=row and row.duplicate.parent==row.parent and row.duplicate.duplicate==null)
  invariant Suggestion: row.current_decision==null or (row.current_decision.parent==row and row.current_decision.status==row.status and row.current_decision.response==row.response and not row.current_decision.withdrawn)
  lock Suggestion fields=author
  lock Vote fields=account
  lock Decision fields=status,response
  lock Decision fields=published_at when=row.published_at!=null
  lock Decision fields=withdrawn,withdrawal_reason when=row.withdrawn
  derive product_choices():ProductChoice[] = Product as product select ProductChoice {product,name=product.name,location=product.location}
  fixture product=Product {name="Facilities",owner=other}
  fixture suggestion=Suggestion {parent=product,title="Phone booths",description="Add booths",category="Amenity",hidden=false}
  fixture root=Suggestion {parent=product,title="Quiet calls",description="Improve call spaces",category="Amenity",hidden=false}
  fixture own_vote=Vote {parent=suggestion,cast_at=now-1m}
  fixture foreign_vote=Vote {parent=suggestion,account=other,cast_at=now-1m}
  fixture decision=Decision {parent=suggestion,status=planned,response="Two booths this quarter"}
  fixture recent=Suggestion {parent=product,title="Bike storage",description="Add a rack",category="Amenity"}
  fixture recent2=Suggestion {parent=product,title="Water",description="Add a fountain",category="Amenity"}
  fixture recent3=Suggestion {parent=product,title="Desks",description="Add sit-stand desks",category="Amenity"}
  fixture recent4=Suggestion {parent=product,title="Lighting",description="Adjust desk lights",category="Amenity"}
  fixture recent5=Suggestion {parent=product,title="Plants",description="Add greenery",category="Amenity"}
  fixture moderator=user {roles=[product_owner]}
  fixture journey_product=Product {name="Facilities",owner=moderator}
  preferences { product:Product? label="Product"@{nl="Product"}, location:Location?, category:Suggestion.category?, status:Suggestion.status? }
  message label_Suggestion = "Suggestion"@{nl="Suggestie"}
  message label_Suggestion_status = "Status"@{nl="Status"}
  message label_Suggestion_hidden = "Hidden"@{nl="Verborgen"}
  message label_Suggestion_response = "Staff response"@{nl="Antwoord medewerker"}
  message label_Suggestion_duplicate = "Duplicate suggestion"@{nl="Dubbele suggestie"}
 When
  crud Product by=product_owner fields=name,published create_fields=name,location,owner when=row.owner==actor and (row.location==null or can_work(actor,row.location)) delete=none
  crud Suggestion by=authenticated fields=title,description,category when=row.author==actor and row.parent.published and (not row.hidden or row.moderation_reason==null)
   examples create parent=product title="Air quality" description="Improve ventilation" category="Amenity"
    as,parent.published -> count(product.Suggestion),count(product.Suggestion as item where not item.hidden)
    members,true -> 1,0
    members,false -> error(rule_failed)
    public,true -> error(forbidden)
   examples create seed=[recent,recent2,recent3,recent4,recent5] parent=product title="Air quality" description="Improve ventilation" category="Amenity"
    as -> count(product.Suggestion)
    members -> error(rule_failed)
   examples update record=suggestion
    as,changes.title,record.author -> suggestion.title,suggestion.hidden
    members,"More booths",self -> "More booths",true
    members,"More booths",other -> error(rule_failed)
   examples delete record=suggestion
    as -> suggestion.archived_at!=null
    members -> true
  crud Vote by=authenticated fields=active create=none update=none delete=none
  crud Decision by=product_owner fields=status,response create=none update=none delete=none
  ## Only this canonical creation path creates suggestions; archived submissions remain in the hourly allowance.
  scenario contribution_limit on=Suggestion.create
   do require count(Suggestion archived=include as item where item.author==event.after.author and item.created>now-1h)<=5
  ## Contributor edits return previously public text to review; audit history retains the earlier moderation reason.
  scenario review_edited on=Suggestion.update
   do set event.after {hidden=true,moderation_reason=null}
  # Cast or restore your own vote after the account-wide ten-second cooldown; identities stay private. @{nl="Breng je eigen stem uit of herstel die na de accountbrede wachttijd van tien seconden; identiteiten blijven privé."}
  scenario vote(suggestion:Suggestion) -> Vote by=authenticated label="Vote"@{nl="Stemmen"}
   require suggestion.parent.published and not suggestion.hidden
   require not any(Vote archived=include as vote,vote.account==actor and vote.cast_at>now-10s)
   do
    let existing=first(suggestion.Vote as vote where vote.account==actor)
    if existing!=null
     set existing {active=true,cast_at=now}
     return existing
    create Vote {parent=suggestion} as vote
    return vote
   examples suggestion=suggestion
    as,suggestion.hidden -> count(suggestion.Vote as item where item.active)
    members,false -> 1
    members,true -> error(rule_failed)
    public,false -> error(forbidden)
   examples seed=[own_vote,foreign_vote] suggestion=suggestion
    as,own_vote.active,own_vote.cast_at -> count(suggestion.Vote),count(suggestion.Vote as item where item.active),result==own_vote,foreign_vote.account
    members,true,now-1m -> 2,2,true,other
    members,false,now-1m -> 2,2,true,other
    members,false,now -> error(rule_failed)
   examples seed=[journey_product]
    do
     call Suggestion.create {parent=journey_product,title="Phone booths",description="Add private call spaces",category="Amenity"} by=self
     let submitted=first(journey_product.Suggestion as item where item.author==self)
     submitted!=null -> true
     submitted.hidden,submitted.author,submitted.status -> true,self,proposed
     call published {product=journey_product} by=public as pending_roadmap
     count(pending_roadmap.items) -> 0
     call moderate {suggestion=submitted,hidden=false,reason="Reviewed for public roadmap"} by=moderator
     let reviewed=first(journey_product.Suggestion as item where item.id==submitted.id)
     reviewed!=null -> true
     call roadmap {suggestion=reviewed,status=planned,response="Two booths this quarter",duplicate=null} by=moderator
     let visible=first(journey_product.Suggestion as item where item.id==submitted.id)
     visible!=null -> true
     call published {product=journey_product} by=public as visible_roadmap
     count(visible_roadmap.items),first(visible_roadmap.items)?.category,first(visible_roadmap.items)?.status,first(visible_roadmap.items)?.response -> 1,"Amenity",planned,"Two booths this quarter"
     call decision_history {suggestion=visible} by=public as first_history
     count(first_history.items),first(first_history.items)?.response -> 1,"Two booths this quarter"
     call vote {suggestion=visible} by=self as cast_vote
     call unvote {vote=cast_vote} by=self
     let withdrawn=first(visible.Vote as item where item.account==self)
     withdrawn!=null -> true
     withdrawn==cast_vote,withdrawn.active,count(visible.Vote),count(visible.Vote as item where item.active) -> true,false,1,0
     call unvote {vote=withdrawn} by=self
     call vote {suggestion=visible} by=self -> error(rule_failed)
     count(visible.Vote),count(visible.Vote as item where item.active) -> 1,0
     call Suggestion.update {record=visible,changes={title="More phone booths"}} by=self
     let edited=first(journey_product.Suggestion as item where item.id==submitted.id)
     edited!=null -> true
     edited.title,edited.hidden,edited.moderation_reason,edited.author -> "More phone booths",true,null,self
     call published {product=journey_product} by=public as review_roadmap
     count(review_roadmap.items) -> 0
     call decision_history {suggestion=edited} by=public -> error(rule_failed)
     call moderate {suggestion=edited,hidden=true,reason="Private contact details"} by=moderator
     let blocked=first(journey_product.Suggestion as item where item.id==submitted.id)
     blocked!=null -> true
     call Suggestion.update {record=blocked,changes={title="Try again"}} by=self -> error(rule_failed)
     blocked.title,blocked.author,blocked.moderation_reason -> "More phone booths",self,"Private contact details"
     call moderate {suggestion=blocked,hidden=false,reason="Reviewed correction"} by=moderator
     let corrected=first(journey_product.Suggestion as item where item.id==submitted.id)
     corrected!=null -> true
     call roadmap {suggestion=corrected,status=shipped,response="Two booths installed",duplicate=null} by=moderator
     let approved=first(journey_product.Suggestion as item where item.id==submitted.id)
     approved!=null -> true
     call published {product=journey_product} by=public as shipped_roadmap
     first(shipped_roadmap.items)?.status,first(shipped_roadmap.items)?.response,first(shipped_roadmap.items)?.votes -> shipped,"Two booths installed",0
     call decision_history {suggestion=approved} by=public as shipped_history
     count(shipped_history.items) -> 2
     call Suggestion.delete {record=approved} by=self
     let archived=first(Suggestion archived=include as item where item.id==submitted.id)
     archived!=null -> true
     archived.archived_at!=null,archived.author -> true,self
     call published {product=journey_product} by=public as archived_roadmap
     count(archived_roadmap.items) -> 0
     call decision_history {suggestion=archived} by=public -> error(rule_failed)
  # Withdraw only your own vote, retaining its identity and cooldown across retries. @{nl="Trek uitsluitend je eigen stem in en behoud de identiteit en wachttijd bij herhaling."}
  scenario unvote(vote:Vote) by=authenticated label="Withdraw own vote"@{nl="Eigen stem intrekken"}
   require vote.account==actor
   do set vote {active=false}
   examples seed=[foreign_vote] vote=own_vote
    as,vote.active -> vote.active,count(suggestion.Vote as item where item.active),foreign_vote.active
    members,true -> false,1,true
    members,false -> false,1,true
   examples vote=foreign_vote
    as -> vote.active
    members -> error(rule_failed)
  # Record an operator roadmap decision without changing authorship or votes; visible decisions release to public history. @{nl="Leg een exploitantbesluit over de roadmap vast zonder auteurschap of stemmen te wijzigen; zichtbare besluiten worden vrijgegeven voor de openbare geschiedenis."}
  scenario roadmap(suggestion:Suggestion,status:Suggestion.status label=label_Suggestion_status,response:text label=label_Suggestion_response,duplicate:Suggestion? label=label_Suggestion_duplicate) by=product_owner label="Record roadmap decision"@{nl="Roadmapbesluit vastleggen"}
   require suggestion.parent.owner==actor and trim(response)!=""
   do
    create Decision {parent=suggestion,status,response} as decision
    if not suggestion.hidden
     set decision {published_at=now}
    set suggestion {status,response,duplicate,current_decision=decision}
   examples seed=[own_vote,foreign_vote] suggestion=suggestion status=planned response="Two booths this quarter" duplicate=root
    as,suggestion.parent.owner,duplicate.duplicate -> suggestion.status,suggestion.duplicate,suggestion.author,count(suggestion.Vote as item where item.active)
    product_owner,self,null -> planned,root,self,2
    members,self,null -> error(forbidden)
    product_owner,other,null -> error(rule_failed)
    product_owner,self,suggestion -> error(rule_failed)
  # Hide abusive content with a reason under product-owner moderation; approving releases the selected decision. @{nl="Verberg misbruik met een reden binnen moderatie door de productverantwoordelijke; bij goedkeuring wordt het geselecteerde besluit vrijgegeven."}
  scenario moderate(suggestion:Suggestion,hidden:bool label=label_Suggestion_hidden,reason:text) by=product_owner label="Moderate suggestion"@{nl="Suggestie modereren"}
   require suggestion.parent.owner==actor and trim(reason)!=""
   do
    if not hidden and suggestion.current_decision!=null and suggestion.current_decision.published_at==null
     set suggestion.current_decision {published_at=now}
    set suggestion {hidden,moderation_reason=reason}
   examples suggestion=suggestion hidden=true reason="Private contact details"
    as,suggestion.parent.owner -> suggestion.hidden,suggestion.moderation_reason,suggestion.author
    product_owner,self -> true,"Private contact details",self
    members,self -> error(forbidden)
   examples suggestion=suggestion hidden=false reason="Reviewed for public roadmap"
    as,suggestion.parent.owner -> suggestion.hidden,suggestion.moderation_reason
    product_owner,self -> false,"Reviewed for public roadmap"
  # Withdraw released or private staff text while retaining owner evidence. @{nl="Trek vrijgegeven of private medewerkerstekst in en behoud het bewijs voor de verantwoordelijke."}
  scenario withdraw_decision(decision:Decision,reason:text) by=product_owner label="Withdraw operator decision"@{nl="Exploitantbesluit intrekken"}
   require decision.parent.parent.owner==actor and trim(reason)!="" and not decision.withdrawn
   do
    if decision.parent.current_decision==decision
     set decision.parent {hidden=true,moderation_reason=reason,status=proposed,response=null,duplicate=null,current_decision=null}
    set decision {withdrawn=true,withdrawal_reason=reason}
   examples decision=decision reason="Response needs correction"
    as,decision.parent.parent.owner,reason,decision.withdrawn -> decision.withdrawn
    members,self,"Response needs correction",false -> error(forbidden)
    product_owner,other,"Response needs correction",false -> error(rule_failed)
    product_owner,self,"",false -> error(rule_failed)
    product_owner,self,"Response needs correction",true -> error(rule_failed)
  # Read released operator decisions without private revisions or account identities. @{nl="Lees vrijgegeven exploitantbesluiten zonder private revisies of accountidentiteiten."}
  scenario decision_history(suggestion:Suggestion) read=true scope=authority -> DecisionHistory by=public label="Read operator decision history"@{nl="Geschiedenis exploitantbesluiten lezen"}
   require suggestion.archived_at==null and suggestion.parent.archived_at==null and suggestion.parent.published and not suggestion.hidden
   do return DecisionHistory {items=suggestion.Decision as decision where decision.published_at!=null and not decision.withdrawn order=decision.published_at select DecisionCard {status=decision.status,response=decision.response,published_at=decision.published_at}}
   examples seed=[journey_product]
    do
     call Suggestion.create {parent=journey_product,title="Quiet spaces",description="More booths",category="Amenity"} by=self
     let submitted=first(journey_product.Suggestion as item where item.author==self)
     submitted!=null -> true
     call roadmap {suggestion=submitted,status=planned,response="Private draft containing a phone number",duplicate=null} by=moderator
     let drafted=first(journey_product.Suggestion as item where item.id==submitted.id)
     drafted!=null -> true
     call roadmap {suggestion=drafted,status=planned,response="Two booths this quarter",duplicate=null} by=moderator
     let ready=first(journey_product.Suggestion as item where item.id==submitted.id)
     ready!=null -> true
     call decision_history {suggestion=ready} by=public -> error(rule_failed)
     call moderate {suggestion=ready,hidden=false,reason="Reviewed current text and response"} by=moderator
     let visible=first(journey_product.Suggestion as item where item.id==submitted.id)
     visible!=null -> true
     call decision_history {suggestion=visible} by=public as released
     count(released.items),first(released.items)?.response -> 1,"Two booths this quarter"
     call roadmap {suggestion=visible,status=shipped,response="Two booths installed",duplicate=null} by=moderator
     let shipped=first(journey_product.Suggestion as item where item.id==submitted.id)
     shipped!=null -> true
     call decision_history {suggestion=shipped} by=public as history_before
     count(history_before.items),any(history_before.items as item,item.response=="Private draft containing a phone number") -> 2,false
     shipped.current_decision!=null -> true
     call withdraw_decision {decision=shipped.current_decision,reason="Response needs correction"} by=moderator
     let withdrawn=first(journey_product.Suggestion as item where item.id==submitted.id)
     withdrawn!=null -> true
     withdrawn.hidden,withdrawn.status,withdrawn.response,withdrawn.current_decision -> true,proposed,null,null
     call decision_history {suggestion=withdrawn} by=public -> error(rule_failed)
     call roadmap {suggestion=withdrawn,status=planned,response="Installation postponed",duplicate=null} by=moderator
     let corrected=first(journey_product.Suggestion as item where item.id==submitted.id)
     corrected!=null -> true
     call moderate {suggestion=corrected,hidden=false,reason="Reviewed replacement"} by=moderator
     let republished=first(journey_product.Suggestion as item where item.id==submitted.id)
     republished!=null -> true
     call decision_history {suggestion=republished} by=public as history_after
     count(history_after.items),any(history_after.items as item,item.response=="Two booths installed"),any(history_after.items as item,item.response=="Installation postponed") -> 2,false,true
  # Expose public aggregate counts, excluding voter identities and hidden content. @{nl="Toon openbare geaggregeerde aantallen zonder stemmeridentiteiten of verborgen inhoud."}
  scenario published(product:Product) read=true scope=authority -> Roadmap by=public label="Read published roadmap"@{nl="Gepubliceerde roadmap lezen"}
   require product.published
   do return Roadmap {items=product.Suggestion as suggestion where not suggestion.hidden select Card {suggestion,title=suggestion.title,category=suggestion.category,status=suggestion.status,response=suggestion.response,duplicate=first(product.Suggestion as item where item==suggestion.duplicate and not item.hidden),votes=count(suggestion.Vote as vote where vote.active)}}
   examples seed=[own_vote,foreign_vote] product=product
    as,suggestion.hidden,own_vote.active -> count(result.items),sum(result.items as item select item.votes)
    public,false,true -> 1,2
    public,false,false -> 1,1
    public,true,true -> 0,0
   examples seed=[suggestion,root] product=product
    as,suggestion.duplicate,root.hidden -> first(result.items)?.duplicate
    public,root,true -> null
 Then
  # Browse a public roadmap with counts that expose no voter records. @{nl="Bekijk een openbare roadmap met aantallen die geen stemmerrecords blootgeven."}
  page /feedback title="Suggestions"@{nl="Suggesties"}
   breadcrumbs
   hero "Improve your workspace"@{nl="Verbeter je werkplek"}
    text "Published ideas welcome your vote. New suggestions await owner review."@{nl="Gepubliceerde ideeën kun je steunen met je stem. Nieuwe suggesties wachten op beoordeling."}
   ## In-context saved default for the category/status filters below.
   filter preferences.status
   list product_choices() as choice filter=product,location defaults={product=preferences.product,location=preferences.location} search=name empty="No products yet."@{nl="Nog geen producten."}
    pagination
    text row.name,row.location
    card "Urgent private issue"@{nl="Dringend privéprobleem"}
     alert "Use private support for incidents. Never put access instructions or anyone’s contact details in a suggestion. New suggestions await owner review."@{nl="Gebruik privésupport voor incidenten. Zet nooit toegangsinstructies of contactgegevens van anderen in een suggestie. Nieuwe suggesties wachten op beoordeling door de verantwoordelijke."}
     form open_request arguments={priority=urgent}
    card "Contribution intake"@{nl="Bijdrage aanmaken"}
     form Suggestion.create arguments={parent=choice.product} display=inline
      fieldset "Your suggestion"@{nl="Je suggestie"}
       input title
       textarea description
       input category
    card "Published roadmap and aggregate votes"@{nl="Gepubliceerde roadmap en stemtotalen"}
     form published arguments={product=choice.product}
      table result.items columns=title,category,status,response,duplicate,votes filter=category,status defaults={category=preferences.category,status=preferences.status} order=-votes empty="No published ideas yet."@{nl="Nog geen gepubliceerde ideeën."}
       pagination
    collapse "Your submissions and review state"@{nl="Je bijdragen en beoordelingsstatus"}
     require authenticated
     list choice.product.Suggestion as suggestion where suggestion.author==actor filter=category,status defaults={category=preferences.category,status=preferences.status} empty="You have no submissions yet."@{nl="Je hebt nog geen bijdragen."}
      pagination
      ## swap selects display only off the readable hidden flag; slots are
      ## exclusive, so the status badge repeats in both without duplication.
      swap row.hidden
       slot off
        title row.title
        content row.description
        badge row.status
        text row.category,row.response,row.duplicate
       slot on
        badge row.status
        text row.title,row.moderation_reason
        alert "Awaiting owner review."@{nl="Wacht op beoordeling."}
      edit
      delete
      history
    collapse "Suggestions and your votes"@{nl="Suggesties en je eigen stemmen"}
     list choice.product.Suggestion filter=category,status defaults={category=preferences.category,status=preferences.status} empty="No suggestions yet."@{nl="Nog geen suggesties."}
      pagination
      badge row.status
      title row.title
      content row.description
      text row.category,row.response
      edit
      tooltip "Vote for this idea. Votes are spaced ten seconds apart."@{nl="Stem op dit idee. Stemmen volgen elkaar op met tien seconden ertussen."}
       action vote
      collapse "Operator decision history"@{nl="Geschiedenis exploitantbesluiten"}
       form decision_history
        table result.items columns=published_at,status,response
         pagination
      collapse "Your votes"@{nl="Je eigen stemmen"}
       require authenticated
       list row.Vote empty="No vote yet."@{nl="Nog geen stem."}
        pagination
        text row.active
        action unvote
  # Moderate suggestions and record only authorized roadmap commitments. @{nl="Modereer suggesties en leg uitsluitend toegestane roadmaptoezeggingen vast."}
  page /feedback/moderation title="Moderation and roadmap"@{nl="Moderatie en roadmap"}
   breadcrumbs
   require product_owner
   ## In-context saved default for the moderation status filter below.
   filter preferences.status
   card "Product intake"@{nl="Product aanmaken"}
    form Product.create display=inline
     input name
   list product_choices() as choice where choice.product.owner==actor filter=product,location defaults={product=preferences.product,location=preferences.location} search=name empty="No owned products."@{nl="Geen eigen producten."}
    pagination
    text row.name,row.location
    ## Explicit update form keeps its record binding (the row is a choice, not
    ## a Product record, so bare edit cannot bind); the suite only places name.
    form Product.update arguments={record=choice.product}
     input name
    list choice.product.Suggestion filter=hidden,status defaults={status=preferences.status} display=split search=title empty="No suggestions to review."@{nl="Geen suggesties te beoordelen."}
     pagination
     card "Suggestion and roadmap outcome"@{nl="Suggestie en roadmapuitkomst"}
      badge row.status
      title row.title
      content row.description
      text row.category,row.author,row.response,row.hidden,row.moderation_reason,row.duplicate
      divider "Decisions"@{nl="Besluiten"}
      button opens=roadmap_decision
      modal "Record roadmap decision"@{nl="Roadmapbesluit vastleggen"} id=roadmap_decision
       slot content
        form roadmap arguments={suggestion=row} display=inline
         fieldset "Roadmap outcome"@{nl="Roadmapuitkomst"}
          radio status
          textarea response
          select duplicate
      button opens=moderate_content
      modal "Moderate suggestion"@{nl="Suggestie modereren"} id=moderate_content
       slot content
        form moderate arguments={suggestion=row} display=inline
         fieldset "Moderation"@{nl="Moderatie"}
          toggle hidden
          textarea reason
     history
     collapse "Operator decisions and withdrawals"@{nl="Exploitantbesluiten en intrekkingen"}
      list row.Decision order=created
       pagination
       text row.status,row.response,row.published_at,row.withdrawn,row.withdrawal_reason
       action withdraw_decision
