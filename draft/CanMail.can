# Optionally help a workspace operator receive and deliver customer mail/parcels for on-site or virtual-office customers. @{nl="Help een werkplekbeheerder desgewenst post en pakketten te ontvangen en af te leveren voor klanten op locatie of met een virtueel kantoor."}
app CanMail uses=[mailroom]

# Receive and resolve physical mail under explicit recipient and delegate authority. @{nl="Ontvang en handel fysieke post af met expliciete ontvanger- en gemachtigderechten."}
package mailroom label="Mailroom"@{nl="Postkamer"}
 use customer {Customer,Contact,owns,has_role,test_company,test_contact,test_admin,test_directory_manager,test_directory_employee}
 use member_terms {Term,eligible_term,paid_term,allocated}
 use invoice {BillingV1 as Billing,Charge} from=deployment.billing
 use rent_catalog {Location,test_site}
 use employee {Employee,can_work,test_worker}
 use std {DeliveryResult}
 use std {EmailV1 as Mail} from=deployment.mail
 Given
  message label_Service_recipient = "Recipient"@{nl="Ontvanger"}
  message label_Service_source = "Source reference"@{nl="Bronreferentie"}
  message label_Delegate_account = "Account"@{nl="Account"}
  message label_Item_kind = "Kind"@{nl="Soort"}
  message label_Item_storage = "Storage location"@{nl="Opslaglocatie"}
  message label_Item_photo = "Photo"@{nl="Foto"}
  message label_Item_incident = "Handling incident"@{nl="Afhandelingsincident"}
  message label_Handling_carrier = "Carrier"@{nl="Vervoerder"}
  message label_Handling_fee = "Fee"@{nl="Kosten"}
  preferences { location:Location?, view:enum(all,collection,forwarding,history)=all label={text="Mail view"@{nl="Postweergave"},values={all="All mail"@{nl="Alle post"},collection="Collection queue"@{nl="Afhaalwachtrij"},forwarding="Forwarding queue"@{nl="Doorzendwachtrij"},history="Mail history"@{nl="Postgeschiedenis"}}} }
  role mail_staff label="Mailroom staff"@{nl="Postmedewerker"}
  Service in Customer { location:Location, recipient:Contact label=label_Service_recipient, from:datetime label="Start"@{nl="Begin"}, until:datetime label="End"@{nl="Einde"}, instructions:text, forwarding:text? label="Forwarding instructions"@{nl="Doorzendinstructies"}, revision:int=1, verified:bool=false label="Verified"@{nl="Geverifieerd"}, source:text unique label=label_Service_source, term:Term? label="Purchased paid term"@{nl="Gekochte betaalde termijn"}, paid_evidence:text? label="Paid-service evidence"@{nl="Bewijs betaalde dienst"}, currency:currency, billing:bool=false label="Invoice handling fees"@{nl="Afhandelingskosten factureren"}, active:bool=true } label="Mail service"@{nl="Postdienst"}
  Delegate in Service { contact:Contact label="Nominated contact"@{nl="Genomineerde contactpersoon"}, account:user label=label_Delegate_account, active:bool=true } label="Collection delegate"@{nl="Afhaalgemachtigde"}
  Item { location:Location, service:Service?, recipient:Contact? label=label_Service_recipient, source:text unique label=label_Service_source, kind:enum(letter,parcel) label={text=label_Item_kind,values={letter="Letter"@{nl="Brief"},parcel="Parcel"@{nl="Pakket"}}}, storage:text label=label_Item_storage, photo:file? label=label_Item_photo, state:enum(unmatched,received,notified,collection_ready,collected,forward_pending,forwarded,returned)=unmatched label={text="State"@{nl="Status"},values={unmatched="Unmatched"@{nl="Niet gekoppeld"},received="Received"@{nl="Ontvangen"},notified="Notified"@{nl="Gemeld"},collection_ready="Ready for collection"@{nl="Klaar om af te halen"},collected="Collected"@{nl="Afgehaald"},forward_pending="Forwarding pending"@{nl="Doorzending in afwachting"},forwarded="Forwarded"@{nl="Doorgestuurd"},returned="Returned"@{nl="Geretourneerd"}}}, notification:delivery(Mail.send)? label="Notification reference"@{nl="Meldingsreferentie"}, notice:Notice?, reminders:int=0, reminder_delay:duration=7d, reminder_limit:int=2 min=0 max=5, history_days:int=180 min=1, retention_until:datetime?, dispatch:Dispatch?, completed:datetime? label="Completed at"@{nl="Afgerond op"}, incident:text? label=label_Item_incident } label="Mail item"@{nl="Poststuk"}
  Handling in Item { kind:enum(collection,forward,return,correction) label={text=label_Item_kind,values={collection="Collection"@{nl="Afhalen"},forward="Forwarding"@{nl="Doorzending"},return="Return"@{nl="Retour"},correction="Correction"@{nl="Correctie"}}}, account:user? label=label_Delegate_account, instruction:text label="Recorded instruction"@{nl="Vastgelegde instructie"}, destination:text? label="Destination"@{nl="Bestemming"}, evidence:text, carrier:text? label=label_Handling_carrier, fee:money? label=label_Handling_fee, source:text unique label=label_Service_source, revision:int, dispatch:Dispatch?, author:user server=actor label="Author"@{nl="Auteur"} } label="Handling record"@{nl="Afhandelingsregistratie"}
  Dispatch in Item { source:text unique, instruction:text, instruction_revision:int label="Instruction version"@{nl="Instructieversie"}, destination:text label="Frozen postal destination"@{nl="Vastgelegde postbestemming"}, fee:money? label=label_Handling_fee, charge:Charge?, state:enum(pending,unknown,dispatched,cancelled)=pending label={text="Dispatch"@{nl="Verzending"},values={pending="Pending"@{nl="In afwachting"},unknown="Uncertain"@{nl="Onzeker"},dispatched="Evidenced dispatch"@{nl="Verzending met bewijs"},cancelled="No dispatch recorded"@{nl="Geen verzending vastgelegd"}}}, charge_state:enum(none,pending,confirmed,failed,unknown)=none label={text="Fee invoice"@{nl="Kostenfactuur"},values={none="No invoice requested"@{nl="Geen factuur aangevraagd"},pending="Invoice requested"@{nl="Factuur aangevraagd"},confirmed="Invoice created"@{nl="Factuur aangemaakt"},failed="Invoice failed"@{nl="Factuur mislukt"},unknown="Invoice uncertain"@{nl="Factuur onzeker"}}}, charge_delivery:text?, reconcile_delivery:text?, invoice:text?, revision:int=1 } label="Forwarding attempt"@{nl="Doorzendpoging"}
  ## Immutable staff-only notice history; one row per admitted notice intent.
  Notice in Item { account:user label="Frozen account", address:text label="Frozen address", subject:text, body:text, receipt:delivery(Mail.send)? label="Notice receipt", kind:enum(initial,reminder,additional), number:int, predecessor:Notice?, reason:text?, acknowledged:bool=false label="Possible duplicate accepted", author:user server=actor label="Author" } label="Notice attempt"
  policy Notice read=mail_staff and can_work(actor,row.parent.location)
  lock Notice fields=account,address,subject,body,receipt,kind,number,predecessor,reason,acknowledged,author
  event Reminder { item:Item, number:int }
  derive recipient(person:user,service:Service):bool = service.parent.active and service.parent.archived_at==null and service.recipient.archived_at==null and service.recipient.verified and service.recipient.account!=null and service.recipient.account==person
  derive manage(person:user,service:Service):bool = recipient(person,service) or has_role(person,service.parent,administrator)
  derive live(service:Service):bool = service.active and service.verified and service.parent.active and service.parent.archived_at==null and service.location.active and service.recipient.archived_at==null and service.recipient.verified and service.recipient.account!=null and service.from<=now and now<service.until and ((service.term!=null and service.term.parent.parent==service.parent and service.term.mail and service.location in service.term.locations and service.term.price.currency==service.currency and eligible_term(service.recipient.account,service.term,now)) or (service.term==null and service.paid_evidence!=null and trim(service.paid_evidence)!=""))
  derive fee_charge(item:Item,fee:money?):Charge? = first([Charge {source=format("mail-forward-{item}",{item=item.id}),customer=item.service.parent.id,location=item.location.id,description=format("Forwarding fee"@{nl="Doorzendkosten"},locale=null),amount=fee??money(0,item.service.currency),due=local_date(now,item.location.timezone)}] as value where item.service.billing and fee!=null and fee.minor>0)
  derive delegate_eligible(delegate:Delegate):bool = delegate.parent.parent.active and delegate.parent.parent.archived_at==null and delegate.contact.archived_at==null and delegate.contact.verified and delegate.contact.account==delegate.account
  derive permitted_collector(person:user,service:Service):bool = recipient(person,service) or any(service.Delegate as delegate,delegate.account==person and delegate.active and delegate_eligible(delegate))
  policy Service read=mail_staff and can_work(actor,row.location)
  policy Service read=authenticated where=manage(actor,row)
  policy Delegate read=authenticated where=row.account==actor or manage(actor,row.parent)
  derive Item.notice_state:DeliveryResult.status? = row.notification?.status label={text="Notification"@{nl="Melding"},values={pending="Sending"@{nl="Wordt verzonden"},succeeded="Accepted"@{nl="Geaccepteerd"},failed="Failed"@{nl="Mislukt"},unknown="Uncertain"@{nl="Onzeker"},skipped="Skipped"@{nl="Overgeslagen"}}}
  ## Item.notice:Notice? — staff-only current attempt; Item.notification keeps the existing status-only recipient projection.
  policy Item read=mail_staff and can_work(actor,row.location)
  policy Item read=authenticated where=row.service!=null and recipient(actor,row.service) fields=service,recipient,kind,state,notice_state,notification.status,completed,created
  policy Handling read=mail_staff and can_work(actor,row.parent.location)
  policy Handling read=authenticated where=row.parent.service!=null and recipient(actor,row.parent.service) fields=kind,account,instruction,revision,destination,evidence,carrier,fee,created
  policy Dispatch read=mail_staff and can_work(actor,row.parent.location)
  invariant Service: row.from<row.until and row.recipient.parent==row.parent and row.revision>0 and (row.term==null or (row.term.parent.parent==row.parent and row.location in row.term.locations and row.currency==row.term.price.currency))
  ## Keep the nominated relationship valid as history; current verification belongs at admission/use.
  invariant Delegate: row.contact.parent==row.parent.parent
  lock Delegate fields=parent,contact,account
  invariant Item: (row.service==null or (row.service.location==row.location and row.recipient==row.service.recipient)) and (row.dispatch==null or row.dispatch.parent==row)
  invariant Dispatch: (row.fee==null or (row.fee.minor>=0 and row.parent.service!=null and row.fee.currency==row.parent.service.currency)) and (row.charge==null or row.charge.source==row.source)
  retain Item until=row.retention_until
  lock Service fields=parent,location,recipient,source,term,currency,billing
  lock Dispatch fields=source,instruction,instruction_revision,destination,fee,charge
  lock Handling fields=kind,account,instruction,revision,destination,evidence,carrier,fee,source,dispatch,author
  unique Delegate fields=contact,account
  ## Typed isolated receipt snapshots include a valid frozen request; no provider send is performed.
  fixture attempt=Mail.send {request={to="recipient@example.test",subject="Notice",body="Recorded decision"}}
  ## A separately selected pending receipt exercises a superseded completion ID.
  fixture pending_notice=Mail.send {request={to="recipient@example.test",subject="Notice",body="Recorded decision"}}
  fixture service=Service {parent=test_company,location=test_site,recipient=test_contact,from=datetime("2020-01-01T00:00:00Z"),until=datetime("2099-01-01T00:00:00Z"),instructions="Collection by verified recipient",verified=true,source="mail-term",currency="EUR",term=paid_term}
  fixture nominee=user {}
  fixture unrelated=user {}
  fixture mail_operator=user {roles=[mail_staff]}
  fixture mail_employee=Employee {user=mail_operator,home=test_site,locations=[test_site],start=date("2026-10-01"),role="mail operator"}
  fixture delegate_contact=Contact {parent=test_company,name="Collection delegate",email="delegate@example.test",account=nominee,verified=true}
  fixture delegate=Delegate {parent=service,contact=delegate_contact,account=nominee}
  fixture prepared=Dispatch {parent=parcel,source="mail-forward-parcel",instruction="Collection by verified recipient",instruction_revision=1,destination="Original address",fee=money(5,"EUR"),charge={source="mail-forward-parcel",customer=test_company.id,location=test_site.id,description="Forwarding fee",amount=money(5,"EUR"),due=date("2090-01-01")},state=pending}
  fixture parcel=Item {location=test_site,service=service,recipient=test_contact,source="physical-parcel",kind=parcel,storage="Shelf A",state=collection_ready}
 When
  # Record the owning paid-service reference, without inventing a membership notification feed. @{nl="Leg de verwijzing naar de betaalde dienst vast zonder een lidmaatschapsmeldingsfeed te verzinnen."}
  scenario configure(customer:Customer,location:Location,recipient:Contact,from:datetime,until:datetime,source:text,term:Term?,paid_evidence:text?,currency:currency,billing:bool=false,instructions:text,forwarding:text?) by=mail_staff label="Configure mail service"@{nl="Postdienst instellen"}
   require can_work(actor,location) and customer.active and customer.archived_at==null and recipient.parent==customer and recipient.verified and recipient.account!=null and from<until and trim(source)!="" and trim(instructions)!="" and (forwarding==null or trim(forwarding)!="")
   require (term!=null and term.parent.parent==customer and term.mail and location in term.locations and term.price.currency==currency) or (term==null and paid_evidence!=null and trim(paid_evidence)!="")
   do create Service {parent=customer,location,recipient,from,until,source,term,paid_evidence,currency,billing,instructions,forwarding,verified=true} as service
  # Change future service availability without resolving or deleting held physical items. @{nl="Wijzig toekomstige dienstbeschikbaarheid zonder bewaarde fysieke items af te handelen of te verwijderen."}
  scenario service_status(service:Service,active:bool,until:datetime,paid_evidence:text?) by=mail_staff label="Review service availability"@{nl="Dienstbeschikbaarheid beoordelen"}
   require can_work(actor,service.location) and service.from<until and (service.term!=null or not active or (paid_evidence!=null and trim(paid_evidence)!=""))
   do set service {active,until,paid_evidence}
  ## Creation nominates one current contact/account; revocation preserves that immutable identity.
  crud Delegate by=authenticated fields=active create_fields=contact,account when=(owns(actor,row.parent.parent) or has_role(actor,row.parent.parent,administrator)) and (not row.active or delegate_eligible(row)) delete=none
   examples create seed=[test_admin] parent=service contact=delegate_contact account=nominee
    as,delegate_contact.verified,test_admin.active,test_company.active -> count(service.Delegate)
    members,true,true,true -> 1
    members,false,true,true -> error(rule_failed)
    members,true,false,true -> error(rule_failed)
    members,true,true,false -> error(rule_failed)
    unrelated,true,true,true -> error(rule_failed)
    public,true,true,true -> error(forbidden)
   examples update seed=[test_admin] record=delegate
    as,changes.active,delegate_contact.verified -> delegate.active,count(service.Delegate)
    members,false,false -> false,1
    members,true,false -> error(rule_failed)
    unrelated,false,true -> error(rule_failed)
  # Update authorized instructions without changing an existing forwarding snapshot. @{nl="Werk geautoriseerde instructies bij zonder een bestaande doorzendmomentopname te wijzigen."}
  scenario instructions(service:Service,instructions:text,forwarding:text?,revision:int) by=authenticated label="Update handling instructions"@{nl="Afhandelingsinstructies bijwerken"}
   require manage(actor,service) and revision==service.revision and trim(instructions)!="" and (forwarding==null or trim(forwarding)!="")
   do set service {instructions,forwarding,revision=service.revision+1}
   examples seed=[test_admin,allocated] service=service instructions="Collect at reception" forwarding="New address" revision=1
    as,revision -> service.forwarding,service.revision
    members,1 -> "New address",2
    members,0 -> error(rule_failed)
    unrelated,1 -> error(rule_failed)
    public,1 -> error(forbidden)
  # Receive one physical item; unmatched recipients remain a restricted review. @{nl="Ontvang één fysiek item; niet-gekoppelde ontvangers blijven in een afgeschermde beoordeling."}
  scenario receive(location:Location,source:text label=label_Service_source,kind:Item.kind,storage:text label=label_Item_storage,service:Service?,photo:file? label=label_Item_photo) by=mail_staff label="Record receipt"@{nl="Ontvangst registreren"}
   require can_work(actor,location) and trim(source)!="" and trim(storage)!="" and not any(Item as item,item.source==source)
   require service==null or (service.location==location and live(service))
   do
    create Item {location,source,kind,storage,photo} as item
    if service!=null
     set item {service,recipient=service.recipient,state=received}
     let subject=format("Mail received"@{nl="Post ontvangen"},locale=null)
     let body=format("An item is available for authorized collection."@{nl="Er ligt een item klaar dat door een bevoegde persoon kan worden afgehaald."},locale=null)
     send Mail.send {to=service.recipient.email,subject=subject,body=body} when=item.state in [received,notified,collection_ready] and recipient(service.recipient.account,service) as delivery
     create Notice {parent=item,account=service.recipient.account,address=service.recipient.email,subject=subject,body=body,receipt=delivery,kind=initial,number=0} as frozen
     set item {notification=delivery,notice=frozen}
     schedule format("mail-reminder-{item}",{item=item.id}) at=now+item.reminder_delay event=Reminder {item,number=1}
   examples seed=[test_worker,test_admin,allocated] location=test_site source="new-receipt" kind=parcel storage="Shelf A" service=service photo=null
    as,paid_term.mail,paid_term.paid,service.paid_evidence -> count(Item as item where item.source=="new-receipt")
    mail_staff,true,true,null -> 1
    mail_staff,false,true,null -> error(rule_failed)
    mail_staff,true,false,"Manual evidence cannot override linked term" -> error(rule_failed)
   ## Real commits revoke a nominee and preserve custody/history; no fixture patches or provider impersonation.
   examples seed=[test_admin,mail_employee,test_directory_employee,delegate_contact]
    do
     call configure {customer=test_company,location=test_site,recipient=test_contact,from=datetime("2020-01-01T00:00:00Z"),until=datetime("2099-01-01T00:00:00Z"),source="mail-journey-service",term=null,paid_evidence="Reviewed standalone mail purchase",currency="EUR",instructions="Collect at reception",forwarding=null} by=mail_operator
     let route=first(Service as row where row.source=="mail-journey-service" order=row.id)
     route!=null -> true
     call receive {location=test_site,source="mail-journey-receipt",kind=parcel,storage="Shelf B",service=route,photo=null} by=mail_operator
     let arrived=first(Item as row where row.source=="mail-journey-receipt" order=row.id)
     arrived!=null -> true
     arrived.state,arrived.notice_state,count(arrived.Handling),arrived.retention_until -> received,pending,0,null
     call Delegate.create {parent=route,contact=delegate_contact,account=nominee} by=self
     let nomination=first(route.Delegate as row where row.contact==delegate_contact and row.account==nominee order=row.id)
     nomination!=null -> true
     nomination.active,delegate_eligible(nomination) -> true,true
     call Contact.update {record=delegate_contact,changes={email="replacement@example.test"}} by=test_directory_manager
     delegate_contact.verified,delegate_contact.account -> false,null
     call collect {item=arrived,collector=nominee,evidence="Former nominee identity"} by=mail_operator -> error(rule_failed)
     let held=first(Item as row where row.source=="mail-journey-receipt" order=row.id)
     held!=null -> true
     held.state,count(held.Handling),held.retention_until -> received,0,null
     let current_nomination=first(route.Delegate as row where row.contact==delegate_contact and row.account==nominee order=row.id)
     current_nomination!=null -> true
     call Delegate.update {record=current_nomination,changes={active=false}} by=self
     call Contact.delete {record=delegate_contact} by=test_directory_manager
     let history=first(route.Delegate as row where row.account==nominee order=row.id)
     history!=null -> true
     history.active,history.contact,history.account,history.contact.archived_at!=null,delegate_eligible(history) -> false,delegate_contact,nominee,true,false
     call service_status {service=route,active=false,until=datetime("2021-01-01T00:00:00Z"),paid_evidence="Reviewed standalone mail purchase"} by=mail_operator
     let expired_route=first(Service as row where row.source=="mail-journey-service" order=row.id)
     expired_route!=null -> true
     expired_route.active,live(expired_route),recipient(self,expired_route) -> false,false,true
     let retained=first(Item as row where row.source=="mail-journey-receipt" order=row.id)
     retained!=null -> true
     call collect {item=retained,collector=self,evidence="Verified original recipient collected held property"} by=mail_operator
     let collected_item=first(Item as row where row.source=="mail-journey-receipt" order=row.id)
     collected_item!=null -> true
     collected_item.state,count(collected_item.Handling),any(collected_item.Handling as handling,handling.kind==collection and handling.account==self and handling.author==mail_operator),collected_item.retention_until -> collected,1,true,now+collected_item.history_days*1d
     call collect {item=collected_item,collector=self,evidence="Repeated collection"} by=mail_operator -> error(rule_failed)
     let final_item=first(Item as row where row.source=="mail-journey-receipt" order=row.id)
     final_item!=null -> true
     final_item.state,count(final_item.Handling),count(expired_route.Delegate),recipient(self,expired_route),recipient(nominee,expired_route) -> collected,1,1,true,false
  # Match an unresolved receipt against the current paid service and notify separately. @{nl="Koppel een onopgeloste ontvangst aan de huidige betaalde dienst en meld afzonderlijk."}
  scenario match(item:Item,service:Service) by=mail_staff label="Match recipient"@{nl="Ontvanger koppelen"}
   require can_work(actor,item.location) and item.state==unmatched and service.location==item.location and live(service)
   do
    set item {service,recipient=service.recipient,state=received}
    let subject=format("Mail received"@{nl="Post ontvangen"},locale=null)
    let body=format("An item is available for authorized collection."@{nl="Er ligt een item klaar dat door een bevoegde persoon kan worden afgehaald."},locale=null)
    send Mail.send {to=service.recipient.email,subject=subject,body=body} when=item.state in [received,notified,collection_ready] and recipient(service.recipient.account,service) as delivery
    create Notice {parent=item,account=service.recipient.account,address=service.recipient.email,subject=subject,body=body,receipt=delivery,kind=initial,number=0} as frozen
    set item {notification=delivery,notice=frozen}
    schedule format("mail-reminder-{item}",{item=item.id}) at=now+item.reminder_delay event=Reminder {item,number=1}
  # Record one evidenced collection by the currently verified recipient or delegate, including after service expiry. @{nl="Registreer één bewezen afhaling door de huidige geverifieerde ontvanger of gemachtigde, ook na het verlopen van de dienst."}
  scenario collect(item:Item,collector:user label="Collector"@{nl="Afhaler"},evidence:text) by=mail_staff label="Record collection"@{nl="Afhaling registreren"}
   require can_work(actor,item.location) and item.state in [received,notified,collection_ready] and trim(evidence)!="" and item.service!=null
   require permitted_collector(collector,item.service)
   do
    create Handling {parent=item,kind=collection,account=collector,instruction=item.service.instructions,revision=item.service.revision,evidence,source=operation.id} as handling
    set item {state=collected,completed=now,retention_until=now+item.history_days*1d}
    cancel format("mail-reminder-{item}",{item=item.id})
   examples seed=[test_worker,delegate] item=parcel evidence="Identity verified"
    as,collector,item.state,service.until,delegate.active,delegate_contact.verified -> item.state,count(parcel.Handling)
    mail_staff,self,collection_ready,datetime("2021-01-01T00:00:00Z"),true,true -> collected,1
    mail_staff,nominee,collection_ready,datetime("2099-01-01T00:00:00Z"),true,true -> collected,1
    mail_staff,nominee,collection_ready,datetime("2099-01-01T00:00:00Z"),false,true -> error(rule_failed)
    mail_staff,nominee,collection_ready,datetime("2099-01-01T00:00:00Z"),true,false -> error(rule_failed)
    mail_staff,self,collected,datetime("2099-01-01T00:00:00Z"),true,true -> error(rule_failed)
    unrelated,self,collection_ready,datetime("2099-01-01T00:00:00Z"),true,true -> error(forbidden)
   examples seed=[test_worker,delegate] item=parcel collector=nominee evidence="Identity verified"
    as,delegate_contact.account,test_company.active -> item.state
    mail_staff,null,true -> error(rule_failed)
    mail_staff,nominee,false -> error(rule_failed)
  # Freeze a unique forwarding attempt and optional same-currency invoice charge. @{nl="Leg een unieke doorzendpoging en optionele factuurkosten in dezelfde valuta vast."}
  scenario forward(item:Item,fee:money? label=label_Handling_fee,destination_verified:bool label="Postal destination verified"@{nl="Postbestemming geverifieerd"}) by=mail_staff label="Prepare forwarding"@{nl="Doorzending voorbereiden"}
   require can_work(actor,item.location) and item.service!=null and item.state in [received,notified,collection_ready] and item.dispatch==null and live(item.service) and item.service.forwarding!=null and trim(item.service.forwarding)!=""
   require destination_verified and (fee==null or (fee.minor>=0 and fee.currency==item.service.currency))
   do
    let source=format("mail-forward-{item}",{item=item.id})
    create Dispatch {parent=item,source,instruction=item.service.instructions,instruction_revision=item.service.revision,destination=item.service.forwarding,fee,charge=fee_charge(item,fee)} as dispatch
    set item {state=forward_pending,dispatch}
    cancel format("mail-reminder-{item}",{item=item.id})
    if dispatch.charge!=null
     send Billing.charge {value=dispatch.charge} as delivery
     set dispatch {charge_delivery=delivery.id,charge_state=pending}
   examples seed=[test_worker,test_admin,allocated] item=parcel fee=money(5,"EUR") destination_verified=true
    as,paid_term.mail,paid_term.paid,service.forwarding,destination_verified -> item.state,count(item.Dispatch)
    mail_staff,true,true,"Original address",true -> forward_pending,1
    mail_staff,true,true,"Original address",false -> error(rule_failed)
    mail_staff,false,true,"Original address",true -> error(rule_failed)
    mail_staff,true,false,"Original address",true -> error(rule_failed)
    mail_staff,true,true,null,true -> error(rule_failed)
  # Confirm the exact current forwarding attempt with carrier evidence, independently of billing. @{nl="Bevestig de exacte huidige doorzendpoging met vervoerdersbewijs, onafhankelijk van facturatie."}
  scenario dispatched(dispatch:Dispatch,revision:int,carrier:text label=label_Handling_carrier,evidence:text) by=mail_staff label="Record dispatch"@{nl="Verzending registreren"}
   require can_work(actor,dispatch.parent.location) and dispatch.parent.state==forward_pending and dispatch.parent.dispatch==dispatch and dispatch.state in [pending,unknown] and revision==dispatch.revision and trim(carrier)!="" and trim(evidence)!=""
   do
    create Handling {parent=dispatch.parent,kind=forward,instruction=dispatch.instruction,revision=dispatch.instruction_revision,destination=dispatch.destination,carrier,evidence,fee=dispatch.fee,dispatch,source=dispatch.source} as handling
    set dispatch {state=dispatched,revision=dispatch.revision+1}
    set dispatch.parent {state=forwarded,completed=now,retention_until=now+dispatch.parent.history_days*1d}
   examples seed=[test_worker] dispatch=prepared revision=1 carrier="Manual carrier" evidence="Tracking reference"
    as,parcel.state,parcel.dispatch,service.forwarding,dispatch.charge_state,revision -> parcel.state,max(parcel.Handling as row select row.destination)
    mail_staff,forward_pending,prepared,"Changed address",confirmed,1 -> forwarded,"Original address"
    mail_staff,forward_pending,prepared,"Original address",pending,0 -> error(rule_failed)
    mail_staff,forwarded,prepared,"Original address",confirmed,1 -> error(rule_failed)
  # Keep uncertain forwarding pending and append the attempted-dispatch evidence. @{nl="Houd onzekere doorzending in behandeling en voeg bewijs van de verzendpoging toe."}
  scenario uncertain(dispatch:Dispatch,revision:int,evidence:text) by=mail_staff label="Record uncertain dispatch"@{nl="Onzekere verzending registreren"}
   require can_work(actor,dispatch.parent.location) and dispatch.parent.state==forward_pending and dispatch.parent.dispatch==dispatch and dispatch.state in [pending,unknown] and dispatch.revision==revision and trim(evidence)!=""
   do
    create Handling {parent=dispatch.parent,kind=correction,instruction=dispatch.instruction,revision=dispatch.instruction_revision,destination=dispatch.destination,evidence,dispatch,source=operation.id} as handling
    set dispatch {state=unknown,revision=dispatch.revision+1}
    set dispatch.parent {incident=evidence}
  # Return only by an evidenced staff decision; an unresolved dispatch needs an explicit no-dispatch confirmation. @{nl="Retourneer alleen op basis van een bewezen personeelsbesluit; een onopgeloste verzending vereist expliciete bevestiging dat niet is verzonden."}
  scenario return_item(item:Item,evidence:text,no_dispatch:bool=false) by=mail_staff label="Record return"@{nl="Retour registreren"}
   require can_work(actor,item.location) and item.state in [unmatched,received,notified,collection_ready,forward_pending] and trim(evidence)!=""
   require item.state!=forward_pending or no_dispatch
   do
    create Handling {parent=item,kind=return,instruction="Recorded return",revision=item.service?.revision??0,evidence,dispatch=item.dispatch,source=operation.id} as handling
    if item.dispatch!=null
     set item.dispatch {state=cancelled,revision=item.dispatch.revision+1}
    set item {state=returned,completed=now,retention_until=now+item.history_days*1d}
    cancel format("mail-reminder-{item}",{item=item.id})
   examples seed=[test_worker] item=parcel evidence="Physical return recorded" no_dispatch=false
    as,item.state,no_dispatch -> item.state,item.retention_until
    mail_staff,received,false -> returned,now+item.history_days*1d
    mail_staff,forward_pending,false -> error(rule_failed)
    mail_staff,forward_pending,true -> returned,now+item.history_days*1d
  # Append corrections without rewriting receipt or handling evidence. @{nl="Voeg correcties toe zonder ontvangst- of afhandelingsbewijs te herschrijven."}
  scenario incident(item:Item,reason:text) by=mail_staff label=label_Item_incident
   require can_work(actor,item.location) and trim(reason)!=""
   do
    create Handling {parent=item,kind=correction,instruction="Staff correction",revision=item.service?.revision??0,evidence=reason,dispatch=item.dispatch,source=operation.id} as handling
    set item {incident=reason}
  # Re-submit only the frozen fee with its original billing source. @{nl="Dien uitsluitend de vastgelegde kosten opnieuw in met de oorspronkelijke facturatiebron."}
  scenario retry_fee(dispatch:Dispatch) by=mail_staff label="Retry forwarding invoice"@{nl="Doorzendfactuur opnieuw proberen"}
   require can_work(actor,dispatch.parent.location) and dispatch.charge!=null and dispatch.charge_state in [failed,unknown]
   do
    send Billing.reconcile {source=dispatch.source} as delivery
    set dispatch {reconcile_delivery=delivery.id,charge_delivery=null,charge_state=pending}
  scenario fee_result on=Billing.charge.completed
   do
    for dispatch in Dispatch as row where row.charge_delivery==event.delivery_id limit=1
     if event.status==succeeded and event.result!=null
      require event.result.source==dispatch.source
      if event.result.state==confirmed
       set dispatch {charge_state=confirmed,invoice=event.result.reference}
      else
       set dispatch {charge_state=failed}
     else
      if event.status==failed
       set dispatch {charge_state=failed}
      else
       if event.status==unknown
        set dispatch {charge_state=unknown}
   examples event={delivery_id="forward-fee",status=succeeded,result={source="mail-forward-parcel",revision=1,state=confirmed,reference="invoice-1",detail=null},error=null}
    prepared.charge_delivery,parcel.state,prepared.state -> parcel.state,prepared.charge_state
    "forward-fee",forward_pending,unknown -> forward_pending,confirmed
    "older-fee",forward_pending,unknown -> forward_pending,none
  scenario fee_reconciled on=Billing.reconcile.completed
   do
    for dispatch in Dispatch as row where row.reconcile_delivery==event.delivery_id limit=1
     if event.status==succeeded
      if event.result!=null
       require event.result.source==dispatch.source and event.result.amount==dispatch.fee
       set dispatch {charge_state=confirmed,invoice=event.result.invoice,reconcile_delivery=null}
      else
       send Billing.charge {value=dispatch.charge} as delivery
       set dispatch {charge_delivery=delivery.id,charge_state=pending,reconcile_delivery=null}
     else
      if event.status in [failed,unknown]
       set dispatch {charge_state=unknown,reconcile_delivery=null}
  # Bound uncollected reminders without changing physical custody or service entitlement. @{nl="Begrens herinneringen voor niet-afgehaalde post zonder fysieke bewaring of dienstrechten te wijzigen."}
  scenario remind on=Reminder
   do
    let item=event.item
    if item.state in [received,notified,collection_ready] and item.service!=null and event.number==item.reminders+1 and event.number<=item.reminder_limit and recipient(item.service.recipient.account,item.service)
     let subject=format("Mail awaiting collection"@{nl="Post wacht op afhaling"},locale=null)
     let body=format("Please arrange authorized collection of your item."@{nl="Regel bevoegde afhaling van je poststuk."},locale=null)
     send Mail.send {to=item.service.recipient.email,subject=subject,body=body} when=item.state in [received,notified,collection_ready] and recipient(item.service.recipient.account,item.service) as delivery
     create Notice {parent=item,account=item.service.recipient.account,address=item.service.recipient.email,subject=subject,body=body,receipt=delivery,kind=reminder,number=event.number} as frozen
     set item {notification=delivery,notice=frozen,reminders=event.number}
     if item.reminders<item.reminder_limit
      schedule format("mail-reminder-{item}",{item=item.id}) at=now+item.reminder_delay event=Reminder {item,number=item.reminders+1}
   examples event={item=parcel,number=1}
    parcel.state,parcel.reminders -> parcel.state,parcel.reminders,parcel.retention_until
    collection_ready,0 -> collection_ready,1,null
    collected,0 -> collected,0,null
    collection_ready,2 -> collection_ready,2,null
  # Send one additional frozen notice after a failed, uncertain or skipped attempt, keeping the old outcome. @{nl="Verzend één extra bevroren melding na een mislukte, onzekere of overgeslagen poging, met behoud van de oude uitkomst."}
  scenario send_another_notice(item:Item, reason:text, acknowledged:bool=false) by=mail_staff label="Send another notice"@{nl="Nog een melding verzenden"}
   require can_work(actor,item.location) and item.service!=null and item.state in [received,notified,collection_ready] and item.notice!=null and trim(reason)!=""
   require item.notice.receipt!=null and item.notice.receipt.status in [failed,unknown,skipped]
   require item.notice.receipt.status==skipped or acknowledged
   require recipient(item.service.recipient.account,item.service)
   ## Both frozen comparisons: account AND address must still match current verified contact.
   require item.notice.account==item.service.recipient.account and item.notice.address==item.service.recipient.email
   do
    send Mail.send {to=item.notice.address,subject=item.notice.subject,body=item.notice.body} when=item.state in [received,notified,collection_ready] and recipient(item.service.recipient.account,item.service) as delivery
    create Notice {parent=item,account=item.notice.account,address=item.notice.address,subject=item.notice.subject,body=item.notice.body,receipt=delivery,kind=additional,number=item.notice.number,predecessor=item.notice,reason,acknowledged} as next
    set item {notification=delivery,notice=next}
  # Reapply the current accepted notice outcome when its callback was missed. @{nl="Pas de huidige geaccepteerde meldingsuitkomst opnieuw toe als de callback is gemist."}
  scenario apply_notice_success(item:Item) by=mail_staff label="Apply accepted notice"@{nl="Geaccepteerde melding toepassen"}
   require can_work(actor,item.location) and item.state==received and item.notice!=null and item.notice.receipt!=null and item.notice.receipt.status==succeeded and item.notice.receipt.result!=null
   do
    set item {state=notified}
  scenario notice_result on=Mail.send.completed
   do
    for item in Item as row where row.notification?.id==event.delivery_id limit=1
     if event.status==succeeded and event.result!=null and item.state==received
      set item {state=notified}
   ## Provisioned receipts are snapshots; these handler calls test current-attempt correlation and custody preservation.
   examples event={delivery_id=attempt.id,status=succeeded,result={reference="accepted-mail"},error=null}
    parcel.notification,parcel.state,event.delivery_id,event.status,event.result,event.error,attempt.status,attempt.result,attempt.error -> parcel.state,parcel.notice_state
    attempt,received,attempt.id,succeeded,{reference="accepted-mail"},null,succeeded,{reference="accepted-mail"},null -> notified,succeeded
    pending_notice,received,attempt.id,succeeded,{reference="accepted-mail"},null,succeeded,{reference="accepted-mail"},null -> received,pending
    null,received,attempt.id,succeeded,{reference="accepted-mail"},null,succeeded,{reference="accepted-mail"},null -> received,null
    attempt,received,attempt.id,unknown,null,null,unknown,null,null -> received,unknown
    attempt,received,attempt.id,failed,null,{code="provider",message="Delivery rejected"},failed,null,{code="provider",message="Delivery rejected"} -> received,failed
    attempt,received,attempt.id,skipped,null,null,skipped,null,null -> received,skipped
    attempt,collected,attempt.id,succeeded,{reference="accepted-mail"},null,succeeded,{reference="accepted-mail"},null -> collected,succeeded
 Then
  # Receive, locate and resolve mail while restricting physical storage information. @{nl="Ontvang, lokaliseer en handel post af terwijl fysieke opslaginformatie afgeschermd blijft."}
  page /mailroom title="Mail and parcels"@{nl="Post en pakketten"} order=2
   require mail_staff
   ## Breadcrumbs show current declared ancestry; the shared right-sidebar shell supplies navigation, no per-app menu.
   breadcrumbs
   card "Service entitlement"@{nl="Dienstrecht"}
    form configure
     fieldset "Handling instructions"@{nl="Afhandelingsinstructies"}
      textarea instructions
      textarea forwarding
    list Service display=split empty="No mail services"@{nl="Geen postdiensten"}
     pagination
     text row.location,row.recipient,row.from,row.until,row.active,row.source,row.term,row.paid_evidence
     action service_status
   card "Mail receipt"@{nl="Post ontvangen"}
    form receive
     fieldset "Receipt"@{nl="Ontvangst"}
      radio kind
      input source
      input storage
      file_input photo
   card "Located items"@{nl="Gelokaliseerde post"}
    tabs preferences.view
    table Item as item where preferences.view==all or (preferences.view==collection and item.state in [received,notified,collection_ready]) or (preferences.view==forwarding and item.state in [forward_pending,forwarded]) or (preferences.view==history and item.state in [collected,forwarded,returned]) columns=location,recipient,kind,storage,state,notice_state,incident filter=location,state defaults={location=preferences.location} display=split empty="No mail items match these filters"@{nl="Geen poststukken voor deze filters"}
     pagination
     badge row.state
     status row.notice_state
     collapse label_Item_incident
      require row.incident!=null
      alert row.incident
     text row.service,row.photo,row.completed
     actions match,forward,return_item,incident
     button opens=collect_detail
     modal "Record collection"@{nl="Afhaling registreren"} id=collect_detail
      slot content
       form collect arguments={item=row} display=inline
        textarea evidence
     list row.Dispatch display=split empty="No forwarding attempts"@{nl="Geen doorzendpogingen"}
      pagination
      badge row.state
      badge row.charge_state
      text row.destination,row.instruction_revision,row.state,row.fee,row.charge_state,row.invoice
      dropdown
       slot trigger
        text "Forwarding follow-up"@{nl="Doorzendopvolging"}
       slot content
        form dispatched arguments={dispatch=row,revision=row.revision}
        form uncertain arguments={dispatch=row,revision=row.revision}
        action retry_fee
     table row.Handling columns=kind,instruction,revision,destination,evidence,carrier,fee empty="No handling records"@{nl="Geen afhandelingsregistraties"}
      pagination
     history
  # Follow only your own mail and authorized collection delegates. @{nl="Volg uitsluitend je eigen post en geautoriseerde afhaalgemachtigden."}
  page /mailroom/mine title="My mail"@{nl="Mijn post"} order=1
   require authenticated
   breadcrumbs
   card "Own service"@{nl="Eigen postdienst"}
    list Service display=split empty="No mail service yet"@{nl="Nog geen postdienst"}
     pagination
     text row.location,row.from,row.until,row.instructions,row.forwarding,row.revision
     form instructions arguments={service=row,revision=row.revision}
      textarea instructions
      textarea forwarding
     form Delegate.create
     list row.Delegate empty="No collection delegates"@{nl="Geen afhaalgemachtigden"}
      pagination
      text row.contact,row.account,row.active
      edit
   card "Own mail outcomes"@{nl="Eigen postresultaten"}
    tabs preferences.view
    table Item as item where preferences.view==all or (preferences.view==collection and item.state in [received,notified,collection_ready]) or (preferences.view==forwarding and item.state in [forward_pending,forwarded]) or (preferences.view==history and item.state in [collected,forwarded,returned]) columns=recipient,kind,state,notice_state,completed filter=state display=split empty="No own mail items"@{nl="Geen eigen poststukken"}
     pagination
     badge row.state
     status row.notice_state
     table row.Handling columns=kind,account,instruction,revision,destination,evidence,carrier,fee,created empty="No handling records"@{nl="Geen afhandelingsregistraties"}
      pagination
