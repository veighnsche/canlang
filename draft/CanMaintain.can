# Help workspace managers move facility faults in offices, meeting rooms, common areas, and equipment through repair and return to service. @{nl="Help werkplekmanagers storingen in kantoren, vergaderruimten, gemeenschappelijke ruimten en apparatuur te herstellen en voorzieningen terug in gebruik te nemen."}
app CanMaintain uses=[maintain]

# Maintain equipment, verify repairs, dispatch technicians and track consumable stock. @{nl="Onderhoud apparatuur, verifieer reparaties, plan technici en volg de verbruiksvoorraad."}
app Facilities uses=[CanMaintain,CanField,CanStock]

# Own equipment, immutable inspection evidence and manager-verified repairs. @{nl="Beheer apparatuur, onveranderlijk inspectiebewijs en door managers geverifieerde reparaties."}
package maintain
 use rent_catalog {Location,test_site}
 use supplier {Supplier}
 use employee {Employee,can_work,test_worker}
 use field {dispatch as dispatch_visit,ReportSubmitted}
 use std {EmailV1 as Mail} from=deployment.mail
 use rent_reservations {AffectedBookings,RoomsV1 as Rooms} from=deployment.rooms
 Given
  export contract WorkItem { reference:text, revision:int, location:text?, title:text, detail:text?, due:datetime?, action:action(inspect) } label="Authorized inspection"@{nl="Toegestane inspectie"}
  export contract WorkBatch { items:WorkItem[]! max=500 } label="Authorized inspections"@{nl="Toegestane inspecties"}
  message label_Plan_checklist = "Checklist"@{nl="Checklist"}
  message label_Inspection_answers = "Answers"@{nl="Antwoorden"}
  message label_Inspection_result_pending = "Pending"@{nl="In afwachting"}
  message label_Inspection_result_failed = "Failed"@{nl="Mislukt"}
  message label_Repair_photo = "Photo"@{nl="Foto"}
  preferences { location:Location?, severity:Repair.severity? }
  role maintenance_manager label="Maintenance manager"@{nl="Onderhoudsbeheerder"}
  role technician label="Technician"@{nl="Technicus"}
  export Asset { location:Location, identifier:text unique label="Identifier"@{nl="Identificatie"}, name:text, category:text label="Category"@{nl="Categorie"}, supplier:Supplier?, resource:text? label="Resource reference"@{nl="Referentie voorziening"}, serial:text? label="Serial number"@{nl="Serienummer"}, warranty:date? label="Warranty expiry"@{nl="Garantie-einddatum"}, manual:file? label="Manual"@{nl="Handleiding"}, inspection_epoch:int=0 min=0, retired:bool=false label="Retired"@{nl="Buiten gebruik"} } label="Asset"@{nl="Bedrijfsmiddel"}
  Plan in Asset { name:text, assignee:user label="Assignee"@{nl="Toegewezen persoon"}, assignee_email:email label="Reminder destination"@{nl="Bestemming herinnering"}, cadence_days:int min=1 label="Interval in days"@{nl="Interval in dagen"}, next_due:date label="Next inspection date"@{nl="Volgende inspectiedatum"}, checklist:text[]! label=label_Plan_checklist, revision:int=1, asset_epoch:int=0 min=0, active:bool=true } label="Inspection plan"@{nl="Inspectieplan"}
  export Inspection in Plan { cancelled:bool=false label="Cancelled"@{nl="Geannuleerd"}, cancellation:text? label="Cancellation reason"@{nl="Reden annulering"}, cancelled_by:user? label="Cancelled by"@{nl="Geannuleerd door"}, cancelled_at:datetime? label="Cancelled at"@{nl="Geannuleerd op"}, reminder_email:email label="Reminder destination"@{nl="Bestemming herinnering"}, reminded_at:datetime? label="Reminder queued at"@{nl="Herinnering klaargezet op"}, occurrence:text unique label="Occurrence reference"@{nl="Referentie uitvoering"}, due:date, checklist:text[]! label=label_Plan_checklist, asset_epoch:int=0 min=0, template_version:int label="Template version"@{nl="Templateversie"}, inspector:user label="Inspector"@{nl="Inspecteur"}, answers:text[] label=label_Inspection_answers, result:enum(pending,passed,failed,blocked)=pending label={text="Inspection result"@{nl="Inspectieresultaat"},values={pending=label_Inspection_result_pending,passed="Passed"@{nl="Goedgekeurd"},failed=label_Inspection_result_failed,blocked="Blocked"@{nl="Geblokkeerd"}}}, evidence:text?, inspected_at:datetime? label="Inspected at"@{nl="Geïnspecteerd op"}, repair:Repair? } label="Inspection"@{nl="Inspectie"}
  export Repair in Asset { affected:AffectedBookings? label="Affected bookings"@{nl="Getroffen boekingen"}, affected_delivery:text? label="Affected-booking lookup delivery"@{nl="Verzending opvraag getroffen boekingen"}, affected_state:enum(none,pending,fresh,failed,unknown)=none label={text="Booking review read"@{nl="Lezen boekingsbeoordeling"},values={none="Not requested"@{nl="Niet aangevraagd"},pending=label_Inspection_result_pending,fresh="Fresh snapshot"@{nl="Actuele momentopname"},failed=label_Inspection_result_failed,unknown="Unknown"@{nl="Onbekend"}}}, assignment:Assignment? label="Current assignment"@{nl="Huidige opdracht"}, block_from:datetime? label="Downtime start"@{nl="Begin uitval"}, block_until:datetime? label="Downtime end"@{nl="Einde uitval"}, block_action:enum(downtime,restore)=downtime label={text="Availability action"@{nl="Beschikbaarheidsactie"},values={downtime="Downtime"@{nl="Uitval"},restore="Restore"@{nl="Herstellen"}}}, block_revision:int=0, restore_evidence:text? label="Release evidence"@{nl="Vrijgavebewijs"}, visit_review:bool=false label="Visit report needs review"@{nl="Bezoekverslag vereist beoordeling"}, title:text trim min=1, description:text, severity:enum(low,normal,urgent)=normal label={text="Severity"@{nl="Ernst"},values={low="Low"@{nl="Laag"},normal="Normal"@{nl="Normaal"},urgent="Urgent"@{nl="Dringend"}}}, reporter:user? label="Reporter"@{nl="Melder"}, reporter_email:email? label="Reporter email"@{nl="E-mailadres melder"}, photo:file? label=label_Repair_photo, contractor:Supplier? label="Contractor"@{nl="Uitvoerder"}, due:date?, cost:money? label="Cost"@{nl="Kosten"}, state:enum(open,assigned,in_progress,awaiting_verification,fixed)=open label={text="State"@{nl="Status"},values={open="Open"@{nl="Open"},assigned="Assigned"@{nl="Toegewezen"},in_progress="In progress"@{nl="In uitvoering"},awaiting_verification="Awaiting verification"@{nl="Wacht op verificatie"},fixed="Fixed"@{nl="Hersteld"}}}, completion:text? label="Completion evidence"@{nl="Afrondingsbewijs"}, verified_by:user? label="Verified by"@{nl="Geverifieerd door"}, block_resource:text? label="Blocked resource"@{nl="Geblokkeerde voorziening"}, block_source:text? label="Downtime reference"@{nl="Uitvalreferentie"}, block_state:enum(none,pending,confirmed,failed,unknown,released)=none label={text="Downtime outcome"@{nl="Uitvalresultaat"},values={pending=label_Inspection_result_pending,failed=label_Inspection_result_failed,none="None"@{nl="Geen"},confirmed="Confirmed"@{nl="Bevestigd"},unknown="Unknown"@{nl="Onbekend"},released="Released"@{nl="Vrijgegeven"}}}, delivery:text? label="Delivery reference"@{nl="Verzendingsreferentie"} } label="Repair"@{nl="Reparatie"}
  Verification in Repair { completion:text, evidence:text, author:user server=actor, at:datetime server=now } label="Repair verification"@{nl="Reparatieverificatie"}
  Assignment in Repair { body:text label="Frozen assignment details"@{nl="Vastgelegde opdrachtdetails"}, supplier:Supplier, contact:email label="Contact"@{nl="Contact"}, reason:text, author:user server=actor label="Author"@{nl="Auteur"} } label="Contractor assignment"@{nl="Opdracht aan leverancier"}
  Notice in Assignment { delivery:text, state:enum(pending,succeeded,failed,unknown,skipped)=pending label={text="Delivery outcome"@{nl="Verzendingsresultaat"},values={pending=label_Inspection_result_pending,succeeded="Delivered"@{nl="Bezorgd"},failed=label_Inspection_result_failed,unknown="Unknown"@{nl="Onbekend"},skipped="Superseded"@{nl="Vervangen"}}} } label="Assignment delivery"@{nl="Opdrachtverzending"}
  Cancellation in Asset { plan:Plan?, through:int min=0, cutoff:date, reason:enum(plan_revised,asset_retired), author:user server=actor, at:datetime server=now, after:text?, phase:enum(plans,inspections,complete)=inspections } label="Inspection cancellation"@{nl="Inspectieannulering"}
  event CancellationStep { cancellation:Cancellation }
  derive plan_eligible(plan:Plan):bool = plan.active and not plan.parent.retired and plan.asset_epoch==plan.parent.inspection_epoch and technician(plan.assignee) and can_work(plan.assignee,plan.parent.location)
  derive matches_cancellation(change:Cancellation,inspection:Inspection):bool = change.parent==inspection.parent.parent and inspection.due>change.cutoff and ((change.reason==plan_revised and change.plan==inspection.parent and inspection.template_version<=change.through) or (change.reason==asset_retired and inspection.asset_epoch<=change.through))
  derive inspection_superseded(inspection:Inspection):bool = any(inspection.parent.parent.Cancellation as change,matches_cancellation(change,inspection))
  derive inspection_pending(inspection:Inspection):bool = inspection.result==pending and not inspection.cancelled and not inspection_superseded(inspection)
  event Reminder { inspection:Inspection, revision:int }
  event PlanDue { plan:Plan, revision:int, due:date }
  policy Asset read=authenticated where=not row.retired fields=location,identifier,name
  policy Asset read=maintenance_manager or technician where=can_work(actor,row.location)
  policy Plan read=maintenance_manager where=can_work(actor,row.parent.location)
  policy Plan read=technician where=can_work(actor,row.parent.location) fields=name
  policy Inspection read=maintenance_manager where=can_work(actor,row.parent.parent.location)
  policy Inspection read=technician where=row.inspector==actor and can_work(actor,row.parent.parent.location)
  policy Repair read=maintenance_manager or technician where=can_work(actor,row.parent.location)
  policy Repair read=authenticated where=row.reporter==actor fields=title,description,severity,state,due,completion,reporter
  policy Verification read=maintenance_manager or technician where=can_work(actor,row.parent.parent.location)
  policy Assignment read=maintenance_manager where=can_work(actor,row.parent.parent.location)
  policy Notice read=maintenance_manager where=can_work(actor,row.parent.parent.parent.location)
  policy Cancellation read=maintenance_manager where=can_work(actor,row.parent.location)
  invariant Cancellation: (row.reason==plan_revised and row.plan!=null and row.plan.parent==row.parent) or (row.reason==asset_retired and row.plan==null)
  invariant Plan: row.cadence_days>0 and count(row.checklist)>0
  invariant Inspection: row.result==pending or (row.evidence!=null and row.inspected_at!=null and count(row.answers)==count(row.checklist))
  invariant Repair: row.state!=fixed or (row.completion!=null and row.verified_by!=null)
  lock Cancellation fields=plan,through,cutoff,reason,author,at
  lock Inspection fields=occurrence,due,checklist,template_version,asset_epoch,inspector
  lock Inspection fields=answers,result,evidence,inspected_at when=row.result!=pending
  lock Inspection fields=cancelled,cancellation,cancelled_by,cancelled_at when=row.cancelled
  lock Verification fields=completion,evidence,author,at
  lock Assignment fields=supplier,contact,reason,author,body
  fixture fault_reporter=user {}
  fixture inspection_manager=user {roles=[maintenance_manager]}
  fixture inspection_technician=user {roles=[technician]}
  fixture manager_employee=Employee {user=inspection_manager,home=test_site,locations=[test_site],start=date("2020-01-01"),role="maintenance manager"}
  fixture technician_employee=Employee {user=inspection_technician,home=test_site,locations=[test_site],start=date("2020-01-01"),role="inspection technician"}
  fixture equipment=Asset {location=test_site,identifier="HVAC-1",name="Air conditioner",category="HVAC"}
  fixture recurring=Plan {parent=equipment,name="Cooling inspection",assignee=inspection_technician,assignee_email="technician@example.test",cadence_days=30,next_due=date("2099-12-01"),checklist=["Cooling works"],active=false}
  fixture check=Inspection {parent=recurring,occurrence="check",due=date("2099-12-01"),checklist=["Cooling works"],template_version=1,inspector=inspection_technician,reminder_email="technician@example.test"}
  fixture service_supplier=Supplier {name="Cooling service",contact="service@example.test",locations=[test_site]}
  fixture awaiting=Repair {parent=equipment,title="Fault",description="No cooling",state=awaiting_verification,completion="Repaired"}
  fixture superseded=Cancellation {parent=equipment,plan=recurring,through=1,cutoff=date("2020-01-01"),reason=plan_revised,author=inspection_manager,at=datetime("2020-01-01T12:00:00Z")}
  fixture retired_work=Cancellation {parent=equipment,plan=null,through=0,cutoff=date("2020-01-01"),reason=asset_retired,phase=plans,author=inspection_manager,at=datetime("2020-01-01T12:00:00Z")}
 When
  crud Asset by=maintenance_manager fields=name,category,supplier,resource,serial,warranty,manual,retired create_fields=location,identifier,name,category,supplier,resource,serial,warranty,manual when=can_work(actor,row.location) delete=none
  crud Plan by=maintenance_manager fields=name,assignee,assignee_email,cadence_days,next_due,checklist,active when=can_work(actor,row.parent.location) and (not row.active or (not row.parent.retired and technician(row.assignee) and can_work(row.assignee,row.parent.location))) delete=none
   examples update seed=[test_worker,check] record=recurring
    as,changes.name -> recurring.revision,check.cancelled,check.result,inspection_pending(check),count(equipment.Cancellation)
    maintenance_manager,"Revised cooling check" -> 2,false,pending,false,1
    technician,"Revised cooling check" -> error(forbidden)
   examples update seed=[test_worker,technician_employee] record=recurring
    as,changes.active,changes.assignee,equipment.retired -> recurring.revision,count(equipment.Cancellation)
    maintenance_manager,true,inspection_technician,false -> 2,1
    maintenance_manager,true,other,false -> error(rule_failed)
    maintenance_manager,true,inspection_technician,true -> error(rule_failed)
    maintenance_manager,false,other,true -> 2,1
  crud Repair by=maintenance_manager fields=title,description,severity,due,photo,cost when=can_work(actor,row.parent.location) and row.state==open delete=none
  scenario activate_plan on=Plan.create
   do
    set event.after {asset_epoch=event.after.parent.inspection_epoch}
    if plan_eligible(event.after)
     schedule event.after.id at=max([now,local_instant(event.after.next_due,"00:00",event.after.parent.location.timezone,fold=earlier)]) event=PlanDue {plan=event.after,revision=event.after.revision,due=event.after.next_due}
  ## Retain the exact supersession boundary before later edits or cleanup can obscure it.
  scenario revise_plan on=Plan.update
   do
    set event.after {revision=event.before.revision+1,asset_epoch=event.after.parent.inspection_epoch}
    create Cancellation {parent=event.after.parent,plan=event.after,through=event.before.revision,cutoff=local_date(now,event.after.parent.location.timezone),reason=plan_revised} as change
    emit CancellationStep {cancellation=change}
    cancel event.after.id
    if plan_eligible(event.after)
     schedule event.after.id at=max([now,local_instant(event.after.next_due,"00:00",event.after.parent.location.timezone,fold=earlier)]) event=PlanDue {plan=event.after,revision=event.after.revision,due=event.after.next_due}
  scenario retire_asset on=Asset.update
   do
    if event.after.retired and not event.before.retired
     set event.after {inspection_epoch=event.before.inspection_epoch+1}
     create Cancellation {parent=event.after,plan=null,through=event.before.inspection_epoch,cutoff=local_date(now,event.after.location.timezone),reason=asset_retired,phase=plans} as change
     emit CancellationStep {cancellation=change}
  ## Each committed continuation reads current state and advances at most one owner record.
  scenario cancel_inspection_step on=CancellationStep
   do
    let change=event.cancellation
    if change.phase==plans
     let plan=first(change.parent.Plan as row where row.asset_epoch<=change.through and (change.after==null or row.id>change.after) order=row.id)
     if plan!=null
      set plan {active=false,revision=plan.revision+1}
      cancel plan.id
      set change {after=plan.id}
      emit CancellationStep {cancellation=change}
     else
      set change {phase=inspections,after=null}
      emit CancellationStep {cancellation=change}
    else
     if change.phase==inspections
      let inspection=first(Inspection as row where row.result==pending and not row.cancelled and matches_cancellation(change,row) and (change.after==null or row.id>change.after) order=row.id)
      if inspection!=null
       set inspection {cancelled=true,cancellation="Plan revised",cancelled_by=change.author,cancelled_at=change.at}
       if change.reason==asset_retired
        set inspection {cancellation="Asset retired"}
       cancel inspection.id
       set change {after=inspection.id}
       emit CancellationStep {cancellation=change}
      else
       set change {phase=complete}
   examples seed=[check] event={cancellation=superseded}
    check.due,check.result,check.answers,check.evidence,check.inspected_at,superseded.phase -> check.cancelled,check.result,superseded.phase,check.cancelled_by,check.cancelled_at
    date("2099-12-01"),pending,[],null,null,inspections -> true,pending,inspections,inspection_manager,superseded.at
    date("2020-01-01"),pending,[],null,null,inspections -> false,pending,complete,null,null
    date("2019-12-31"),pending,[],null,null,inspections -> false,pending,complete,null,null
    date("2099-12-01"),passed,["Cooling works"],"Measured cooling",datetime("2019-12-31T12:00:00Z"),inspections -> false,passed,complete,null,null
    date("2099-12-01"),pending,[],null,null,complete -> false,pending,complete,null,null
   examples seed=[check] event={cancellation=retired_work}
    equipment.inspection_epoch,recurring.asset_epoch,check.asset_epoch,recurring.active -> recurring.active,recurring.revision,retired_work.phase,check.cancelled
    1,0,0,true -> false,2,plans,false
    1,1,1,true -> true,1,inspections,false
   examples seed=[check] event={cancellation=retired_work}
    retired_work.phase,equipment.inspection_epoch,check.asset_epoch -> check.cancelled,retired_work.phase
    inspections,1,0 -> true,inspections
    inspections,1,1 -> false,complete
  # Resume the retained cancellation without changing its original scope or attribution. @{nl="Hervat de vastgelegde annulering zonder haar oorspronkelijke bereik of toeschrijving te wijzigen."}
  scenario resume_cancellation(cancellation:Cancellation) by=maintenance_manager label="Resume inspection cancellation"@{nl="Inspectieannulering hervatten"}
   require can_work(actor,cancellation.parent.location) and cancellation.phase!=complete
   do emit CancellationStep {cancellation}
   examples seed=[manager_employee] cancellation=superseded
    as,cancellation.phase,manager_employee.active -> cancellation.phase
    inspection_manager,inspections,true -> inspections
    inspection_manager,complete,true -> error(rule_failed)
    inspection_manager,inspections,false -> error(rule_failed)
    inspection_technician,inspections,true -> error(forbidden)
    public,inspections,true -> error(forbidden)
  # Report your own facility fault without browsing unrelated repairs. @{nl="Meld je eigen facilitaire storing zonder niet-gerelateerde reparaties te bekijken."}
  export scenario report(asset:Asset,title:text,description:text,photo:file? label=label_Repair_photo) -> Repair by=authenticated label="Report fault"@{nl="Storing melden"}
   require actor.email_verified and not asset.retired and trim(title)!="" and trim(description)!=""
   do
    create Repair {parent=asset,title,description,photo,reporter=actor,reporter_email=actor.email} as repair
    return repair
   examples asset=equipment photo=null
    as,title,description -> result.title,result.reporter,result.state
    members,"Wi-Fi fault","Router is not responding" -> "Wi-Fi fault",self,open
    members,"Wi-Fi fault","" -> error(rule_failed)
    public,"Wi-Fi fault","Router is not responding" -> error(forbidden)
  # Assign an active supplier and freeze the notification destination. @{nl="Wijs een actieve leverancier toe en leg de meldingsbestemming vast."}
  scenario assign(repair:Repair,supplier:Supplier,reason:text) by=maintenance_manager
   require can_work(actor,repair.parent.location) and supplier.active and repair.parent.location in supplier.locations and repair.state!=fixed and trim(reason)!=""
   do
    create Assignment {parent=repair,supplier,contact=supplier.contact,reason,body=repair.description} as assignment
    set repair {contractor=supplier,assignment,state=assigned}
    send Mail.send {to=assignment.contact,subject=format("Repair assignment"@{nl="Reparatieopdracht"},locale=null),body=assignment.body} when=repair.assignment==assignment and supplier.active and repair.state in [assigned,in_progress] as notice
    create Notice {parent=assignment,delivery=notice.id} as receipt
  # Retry a definitely failed assignment notice only for its current active destination. @{nl="Probeer een definitief mislukte opdrachtmelding opnieuw voor de huidige actieve bestemming."}
  scenario retry_notice(notice:Notice) by=maintenance_manager label="Retry assignment notice"@{nl="Opdrachtmelding opnieuw sturen"}
   require can_work(actor,notice.parent.parent.parent.location) and notice.state==failed and not any(notice.parent.Notice as item,item.state in [pending,unknown,succeeded]) and notice.parent.parent.assignment==notice.parent and notice.parent.supplier.active and notice.parent.parent.state in [assigned,in_progress]
   do
    send Mail.send {to=notice.parent.contact,subject=format("Repair assignment"@{nl="Reparatieopdracht"},locale=null),body=notice.parent.body} when=notice.parent.parent.assignment==notice.parent and notice.parent.supplier.active and notice.parent.parent.state in [assigned,in_progress] as delivery
    create Notice {parent=notice.parent,delivery=delivery.id} as receipt
  scenario notice_result on=Mail.send.completed
   do
    for notice in Notice as item where item.delivery==event.delivery_id and item.state in [pending,unknown] limit=1
     set notice {state=event.status}
  # Start an assigned repair without claiming acceptance from assignment delivery. @{nl="Start een toegewezen reparatie zonder aanvaarding af te leiden uit de opdrachtverzending."}
  scenario start(repair:Repair) by=technician label="Start repair"@{nl="Reparatie starten"}
   require can_work(actor,repair.parent.location) and repair.state==assigned
   do set repair {state=in_progress}
   examples seed=[test_worker] repair=awaiting
    as,repair.state -> repair.state
    technician,assigned -> in_progress
    technician,open -> error(rule_failed)
    maintenance_manager,assigned -> error(forbidden)
  # Request canonical room downtime while preserving affected customer bookings. @{nl="Vraag canonieke ruimte-uitval aan en behoud de getroffen klantboekingen."}
  scenario block(repair:Repair,from:datetime label="Start"@{nl="Begin"},until:datetime? label="End"@{nl="Einde"}) by=maintenance_manager label="Record blocker"@{nl="Blokkade registreren"}
   require can_work(actor,repair.parent.location) and repair.parent.resource!=null and repair.state!=fixed and repair.block_state in [none,released] and (until==null or from<until)
   do
    send Rooms.downtime {source=operation.id,resource=repair.parent.resource,from,until} as delivery
    set repair {block_resource=repair.parent.resource,block_source=operation.id,block_from=from,block_until=until,block_action=downtime,block_revision=0,block_state=pending,delivery=delivery.id,affected=null,affected_state=none,affected_delivery=null}
  # Capture technician evidence for manager verification rather than automatic resale. @{nl="Leg technicusbewijs vast voor managerverificatie in plaats van automatische herverkoop."}
  scenario finish(repair:Repair,evidence:text) by=technician label="Submit repair evidence"@{nl="Reparatiebewijs indienen"}
   require can_work(actor,repair.parent.location) and repair.state in [assigned,in_progress] and trim(evidence)!=""
   do set repair {state=awaiting_verification,completion=evidence}
  # Verify a repair and request release of only its own downtime block. @{nl="Verifieer een reparatie en vraag vrijgave van uitsluitend haar eigen uitvalblokkade aan."}
  scenario verify(repair:Repair,evidence:text) by=maintenance_manager label="Verify repair"@{nl="Reparatie verifiëren"}
   require can_work(actor,repair.parent.location) and repair.state==awaiting_verification and repair.completion!=null and trim(evidence)!=""
   do
    create Verification {parent=repair,completion=repair.completion,evidence} as verification
    set repair {state=fixed,verified_by=actor,visit_review=false}
    if repair.block_source!=null and repair.block_state!=released
     require repair.block_resource!=null
     send Rooms.restore {source=repair.block_source,resource=repair.block_resource,evidence} as delivery
     set repair {block_action=restore,restore_evidence=evidence,block_state=pending,delivery=delivery.id}
   examples seed=[test_worker] repair=awaiting
    as,evidence -> repair.state,repair.verified_by,first(repair.Verification as row order=row.id)?.evidence
    maintenance_manager,"Checked cooling" -> fixed,self,"Checked cooling"
    maintenance_manager,"" -> error(rule_failed)
    technician,"Checked cooling" -> error(forbidden)
   examples seed=[manager_employee,technician_employee,service_supplier,fault_reporter]
    do
     call report {asset=equipment,title="Cooling fault",description="No cooling",photo=null} by=fault_reporter as initial_fault
     call assign {repair=initial_fault,supplier=service_supplier,reason="Repair cooling"} by=inspection_manager
     let first_assignment=first(Repair as row where row.id==initial_fault.id order=row.id)
     first_assignment!=null -> true
     call start {repair=first_assignment} by=inspection_technician
     let first_started=first(Repair as row where row.id==initial_fault.id order=row.id)
     first_started!=null -> true
     call finish {repair=first_started,evidence="Repaired"} by=inspection_technician
     let first_submitted=first(Repair as row where row.id==initial_fault.id order=row.id)
     first_submitted!=null -> true
     call verify {repair=first_submitted,evidence="Manager checked cooling"} by=inspection_manager
     let verified_repair=first(Repair as row where row.id==initial_fault.id order=row.id)
     verified_repair!=null -> true
     let initial=first(verified_repair.Verification as row order=row.id)
     initial!=null -> true
     verified_repair.state,verified_repair.block_state,initial.completion,initial.evidence,initial.author,initial.at -> fixed,none,"Repaired","Manager checked cooling",inspection_manager,now
     call reopen {repair=verified_repair,reason="Cooling failed again"} by=inspection_manager
     let reopened=first(Repair as row where row.id==initial_fault.id order=row.id)
     reopened!=null -> true
     call assign {repair=reopened,supplier=service_supplier,reason="Investigate recurrence"} by=inspection_manager
     let assigned=first(Repair as row where row.id==initial_fault.id order=row.id)
     assigned!=null -> true
     call start {repair=assigned} by=inspection_technician
     let started=first(Repair as row where row.id==initial_fault.id order=row.id)
     started!=null -> true
     call finish {repair=started,evidence="Replaced compressor"} by=inspection_technician
     let submitted=first(Repair as row where row.id==initial_fault.id order=row.id)
     submitted!=null -> true
     call verify {repair=submitted,evidence="Load test passed"} by=inspection_manager
     let final=first(Repair as row where row.id==initial_fault.id order=row.id)
     final!=null -> true
     let latest=first(final.Verification as row where row.evidence=="Load test passed" order=row.id)
     latest!=null -> true
     let previous=first(final.Verification as row where row.id==initial.id order=row.id)
     previous!=null -> true
     final.state,final.completion,final.block_state,final.block_source,count(final.Verification),previous.completion,previous.evidence,latest.completion,latest.evidence,latest.author,latest.at -> fixed,"Replaced compressor",none,null,2,"Repaired","Manager checked cooling","Replaced compressor","Load test passed",inspection_manager,now
  # Reopen a recurrence without erasing previous inspection or completion evidence. @{nl="Heropen een terugkerende storing zonder eerder inspectie- of afrondingsbewijs te wissen."}
  scenario reopen(repair:Repair,reason:text) by=maintenance_manager
   require can_work(actor,repair.parent.location) and repair.state==fixed and repair.block_state in [none,released,confirmed] and (repair.block_action==downtime or repair.block_state in [none,released]) and trim(reason)!=""
   do set repair {state=open,description=reason,verified_by=null}
   examples seed=[test_worker] repair=awaiting reason="Cooling failed again"
    as,repair.state,repair.verified_by,repair.block_state,repair.block_action -> repair.state,repair.completion
    maintenance_manager,fixed,self,released,restore -> open,"Repaired"
    maintenance_manager,fixed,self,unknown,restore -> error(rule_failed)
  # Record one attributable checklist result; a failed or blocked result opens a corrective repair. @{nl="Registreer één herleidbaar checklistresultaat; een mislukt of geblokkeerd resultaat opent een corrigerende reparatie."}
  export scenario inspect(inspection:Inspection,answers:text[] label=label_Inspection_answers,result:Inspection.result,evidence:text) by=technician label="Record inspection"@{nl="Inspectie registreren"}
   require can_work(actor,inspection.parent.parent.location) and inspection.inspector==actor and inspection_pending(inspection) and result in [passed,failed,blocked] and count(answers)==count(inspection.checklist) and trim(evidence)!=""
   do
    set inspection {answers,result,evidence,inspected_at=now}
    cancel inspection.id
    if result in [failed,blocked]
     create Repair {parent=inspection.parent.parent,title=inspection.parent.name,description=evidence,reporter=actor} as repair
     set inspection {repair}
   examples seed=[technician_employee] inspection=check answers=["No cooling"] evidence="Measured warm air"
    as,result,inspection.cancelled -> inspection.result,count(inspection.parent.parent.Repair)
    inspection_technician,failed,false -> failed,1
    inspection_technician,passed,false -> passed,0
    inspection_technician,failed,true -> error(rule_failed)
   examples seed=[manager_employee,technician_employee,check]
    do
     call Plan.update {record=recurring,changes={name="Revised cooling check"}} by=inspection_manager
     let future=first(Inspection as row where row.occurrence=="check" order=row.id)
     future!=null -> true
     future.result,future.cancelled,inspection_pending(future),count(equipment.Cancellation) -> pending,false,false,1
     call inspect {inspection=future,answers=["Cooling works"],result=passed,evidence="Superseded checklist"} by=inspection_technician -> error(rule_failed)
     let revised=first(Plan as row where row.id==recurring.id order=row.id)
     revised!=null -> true
     call Plan.update {record=revised,changes={checklist=["Replacement checklist"]}} by=inspection_manager
     call Asset.update {record=equipment,changes={retired=true}} by=inspection_manager
     let retired=first(Asset as row where row.id==equipment.id order=row.id)
     retired!=null -> true
     retired.retired,retired.inspection_epoch -> true,1
     call Asset.update {record=retired,changes={retired=false}} by=inspection_manager
     let configured=first(Plan as row where row.id==recurring.id order=row.id)
     configured!=null -> true
     call Plan.update {record=configured,changes={active=true}} by=inspection_manager
     let renewed=first(Plan as row where row.id==recurring.id order=row.id)
     renewed!=null -> true
     renewed.asset_epoch,plan_eligible(renewed),future.checklist,inspection_pending(future) -> 1,true,["Cooling works"],false
     call inspect {inspection=future,answers=["Cooling works"],result=passed,evidence="Old work after reinstatement"} by=inspection_technician -> error(rule_failed)
     call Plan.update {record=renewed,changes={name="Stale change"}} by=inspection_manager request={record={version=1}} -> error(conflict)
     let cancellation=first(equipment.Cancellation as row where row.reason==asset_retired order=row.id)
     cancellation!=null -> true
     call resume_cancellation {cancellation} by=inspection_manager
     let history=first(equipment.Cancellation as row where row.id==cancellation.id order=row.id)
     history!=null -> true
     history.phase,history.author,history.at,history.through,future.result,future.cancelled -> plans,inspection_manager,now,0,pending,false
   examples seed=[manager_employee,technician_employee,check]
    do
     call inspect {inspection=check,answers=["Cooling works"],result=passed,evidence="Measured cooling"} by=inspection_technician
     call Asset.update {record=equipment,changes={retired=true}} by=inspection_manager
     let completed_check=first(Inspection as row where row.occurrence=="check" order=row.id)
     completed_check!=null -> true
     completed_check.result,completed_check.answers,completed_check.evidence,completed_check.inspector,completed_check.inspected_at,completed_check.cancelled -> passed,["Cooling works"],"Measured cooling",inspection_technician,now,false
     call inspect {inspection=completed_check,answers=["Replacement"],result=failed,evidence="Overwrite result"} by=inspection_technician -> error(rule_failed)
   examples seed=[technician_employee] inspection=check answers=["Cooling works"] result=passed evidence="Measured cooling"
    as,technician_employee.active -> inspection.result
    inspection_technician,false -> error(rule_failed)
  ## A visit report is evidence for the owning repair, never permission to restore room availability.
  scenario visit_report on=ReportSubmitted
   do
    let job=event.report.parent
    if job.repair!=null
     require job.location==job.repair.parent.location and job.state==done
     if job.repair.state in [assigned,in_progress,awaiting_verification]
      set job.repair {state=awaiting_verification,completion=event.report.notes,visit_review=true}
     else
      set job.repair {visit_review=true}
  scenario generate on=PlanDue
   do
    let plan=event.plan
    if plan_eligible(plan) and plan.revision==event.revision and plan.next_due==event.due and plan.next_due<=local_date(now,plan.parent.location.timezone)
     let occurrence=format("{plan}:{due}:{revision}",{plan=plan.id,due=plan.next_due,revision=plan.revision})
     if not any(plan.Inspection as inspection,not inspection.cancelled and not (inspection.result==pending and inspection_superseded(inspection)) and inspection.due==plan.next_due)
      create Inspection {parent=plan,occurrence,due=plan.next_due,checklist=plan.checklist,template_version=plan.revision,asset_epoch=plan.asset_epoch,inspector=plan.assignee,reminder_email=plan.assignee_email} as inspection
      schedule inspection.id at=max([now,local_instant(inspection.due,"09:00",plan.parent.location.timezone,fold=earlier)]) event=Reminder {inspection,revision=inspection.template_version}
     set plan {next_due=add_days(plan.next_due,plan.cadence_days)}
     schedule plan.id at=max([now,local_instant(plan.next_due,"00:00",plan.parent.location.timezone,fold=earlier)]) event=PlanDue {plan,revision=plan.revision,due=plan.next_due}
   examples seed=[technician_employee,check,superseded] event={plan=recurring,revision=2,due=local_date(now,test_site.timezone)}
    superseded.cutoff,recurring.revision,recurring.active,recurring.next_due,check.due,check.result,check.answers,check.evidence,check.inspected_at -> count(recurring.Inspection)
    add_days(local_date(now,test_site.timezone),-1),2,true,local_date(now,test_site.timezone),local_date(now,test_site.timezone),pending,[],null,null -> 2
    add_days(local_date(now,test_site.timezone),-1),2,true,local_date(now,test_site.timezone),local_date(now,test_site.timezone),passed,["Cooling works"],"Already checked",now -> 1
   examples seed=[technician_employee] event={plan=recurring,revision=1,due=local_date(now,test_site.timezone)}
    recurring.active,recurring.next_due,technician_employee.active,equipment.inspection_epoch -> count(recurring.Inspection)
    true,local_date(now,test_site.timezone),false,0 -> 0
    true,local_date(now,test_site.timezone),true,1 -> 0
  scenario remind on=Reminder
   do
    let inspection=event.inspection
    if inspection_pending(inspection) and inspection.template_version==event.revision and inspection.parent.revision==event.revision and inspection.inspector==inspection.parent.assignee and local_instant(inspection.due,"09:00",inspection.parent.parent.location.timezone,fold=earlier)<=now and plan_eligible(inspection.parent) and inspection.asset_epoch==inspection.parent.asset_epoch
     send Mail.send {to=inspection.reminder_email,subject=format("Inspection due"@{nl="Inspectie gepland"},locale=null),body=inspection.parent.name} when=inspection_pending(inspection) and inspection.template_version==event.revision and inspection.parent.revision==event.revision and inspection.inspector==inspection.parent.assignee and local_instant(inspection.due,"09:00",inspection.parent.parent.location.timezone,fold=earlier)<=now and plan_eligible(inspection.parent) and inspection.asset_epoch==inspection.parent.asset_epoch as notice
     set inspection {reminded_at=now}
  # Recover an uncertain availability request using its original frozen business identity. @{nl="Herstel een onzekere beschikbaarheidsaanvraag met haar oorspronkelijke vastgelegde bedrijfsidentiteit."}
  scenario retry_availability(repair:Repair) by=maintenance_manager label="Retry availability request"@{nl="Beschikbaarheidsaanvraag opnieuw proberen"}
   require can_work(actor,repair.parent.location) and repair.block_state in [failed,unknown] and repair.block_source!=null and repair.block_resource!=null
   do
    if repair.block_action==downtime
     require repair.block_from!=null and repair.state!=fixed
     send Rooms.downtime {source=repair.block_source,resource=repair.block_resource,from=repair.block_from,until=repair.block_until} as delivery
     set repair {delivery=delivery.id,block_state=pending}
    else
     require repair.state==fixed and repair.restore_evidence!=null
     send Rooms.restore {source=repair.block_source,resource=repair.block_resource,evidence=repair.restore_evidence} as delivery
     set repair {delivery=delivery.id,block_state=pending}
  scenario downtime_result on=Rooms.downtime.completed
   do
    for repair in Repair as r where r.delivery==event.delivery_id and r.block_action==downtime and r.block_state in [pending,unknown] limit=1
     if event.status==succeeded and event.result!=null and event.result.source==repair.block_source and event.result.revision>=repair.block_revision
      if event.result.state==confirmed
       set repair {block_state=confirmed,block_revision=event.result.revision}
      else
       if event.result.state in [failed,unavailable]
        set repair {block_state=failed,block_revision=event.result.revision}
       else
        set repair {block_state=unknown}
     else
      if event.status==failed
       set repair {block_state=failed}
      else
       set repair {block_state=unknown}
   examples seed=[awaiting] event={delivery_id="block-delivery",status=succeeded,result={source="block-source",revision=1,state=confirmed,reference="block",detail=null},error=null}
    awaiting.delivery,awaiting.block_source,awaiting.block_state,event.result.source -> awaiting.block_state
    "block-delivery","block-source",pending,"block-source" -> confirmed
    "old-delivery","block-source",pending,"block-source" -> pending
    "block-delivery","block-source",pending,"other-source" -> unknown
  scenario restore_result on=Rooms.restore.completed
   do
    for repair in Repair as r where r.delivery==event.delivery_id and r.block_action==restore and r.block_state in [pending,unknown] limit=1
     if event.status==succeeded and event.result!=null and event.result.source==repair.block_source and event.result.revision>=repair.block_revision and event.result.state==released
      set repair {block_state=released,block_revision=event.result.revision}
     else
      if event.status==failed
       set repair {block_state=failed}
      else
       set repair {block_state=unknown}
  # Read the owning booking review references without copying customer contacts. @{nl="Lees de boekingsbeoordelingsreferenties van de eigenaar zonder klantcontacten te kopiëren."}
  scenario affected_bookings(repair:Repair) by=maintenance_manager label="Refresh affected bookings"@{nl="Getroffen boekingen vernieuwen"}
   require can_work(actor,repair.parent.location) and repair.block_source!=null and repair.block_resource!=null and repair.affected_state!=pending
   do
    send Rooms.affected {source=repair.block_source,resource=repair.block_resource} as delivery
    set repair {affected_delivery=delivery.id,affected_state=pending}
  scenario affected_result on=Rooms.affected.completed
   do
    for repair in Repair as r where r.affected_delivery==event.delivery_id limit=1
     if event.status==succeeded and event.result!=null and event.result.source==repair.block_source and event.result.resource==repair.block_resource
      set repair {affected=event.result,affected_state=fresh}
     else
      if event.status==failed
       set repair {affected_state=failed}
      else
       set repair {affected_state=unknown}
  ## Verified owning outcomes may reconcile lost transport responses; old block confirmation cannot undo a release request.
  scenario availability_changed on=Rooms.changed
   do
    for repair in Repair as r where r.block_source==event.value.source and event.value.revision>r.block_revision limit=1
     if repair.block_action==downtime and event.value.state==confirmed
      set repair {block_state=confirmed,block_revision=event.value.revision}
     if repair.block_action==restore and event.value.state==released
      set repair {block_state=released,block_revision=event.value.revision}
  # Expose only your pending inspection titles and authorized completion actions. @{nl="Toon alleen je openstaande inspectietitels en toegestane afrondingsacties."}
  export scenario work(locations:text[]) read=true scope=authority -> WorkBatch by=technician
   do return WorkBatch {items=Inspection as item where item.inspector==actor and inspection_pending(item) and can_work(actor,item.parent.parent.location) and (count(locations)==0 or item.parent.parent.location.id in locations) select WorkItem {reference=item.id,revision=item.version,location=item.parent.parent.location.id,title=item.parent.name,detail=item.parent.parent.name,due=local_instant(item.due,"00:00",item.parent.parent.location.timezone,fold=earlier),action=action(inspect,{inspection=item})}}
  # Recheck the selected inspection before showing its source-owned checklist form. @{nl="Controleer de gekozen inspectie opnieuw voordat het bronformulier met checklist wordt getoond."}
  export scenario work_detail(record:Inspection) read=true scope=authority -> WorkItem by=technician
   require record.inspector==actor and inspection_pending(record) and can_work(actor,record.parent.parent.location)
   do return WorkItem {reference=record.id,revision=record.version,location=record.parent.parent.location.id,title=record.parent.name,detail=record.parent.parent.name,due=local_instant(record.due,"00:00",record.parent.parent.location.timezone,fold=earlier),action=action(inspect,{inspection=record})}
 Then
  # Keep assets, overdue inspections and repair verification connected. @{nl="Houd bedrijfsmiddelen, achterstallige inspecties en reparatieverificatie met elkaar verbonden."}
  page /facilities title="Facilities"@{nl="Faciliteiten"}
   require maintenance_manager or technician
   card "Asset directory"@{nl="Bedrijfsmiddelenregister"}
    form Asset.create
    list Asset filter=location,category,retired search=name defaults={location=preferences.location} display=split
     edit
     tabs
      tab "Inspection plans and checklists"@{nl="Inspectieplannen en checklists"}
       table row.Cancellation columns=reason,cutoff,author,at,phase
        action resume_cancellation
       form Plan.create
       list row.Plan
        edit
        table row.Inspection columns=due,inspector,result,cancelled,evidence,repair,reminded_at
         text row.checklist
         form inspect
         form dispatch_visit arguments={inspection=row,location=row.parent.parent.location}
      tab "Repairs and verification"@{nl="Reparaties en verificatie"}
       form Repair.create
       table row.Repair columns=title,severity,due,state,contractor,block_action,block_state,affected_state,visit_review filter=state,severity defaults={severity=preferences.severity}
        edit
        actions assign,start,block,finish,verify,retry_availability,affected_bookings,reopen
        form dispatch_visit arguments={repair=row,location=row.parent.location}
        card "Affected bookings"@{nl="Getroffen boekingen"}
         require row.affected!=null
         text row.affected_state,row.affected.checked_at
         table row.affected.items columns=reference,from,until,quantity,status,conflict
        table row.Verification columns=completion,evidence,author,at
        list row.Assignment
         text row.reason,row.contact
         table row.Notice columns=state,delivery
          action retry_notice
        history

  # Submit and follow your own fault report. @{nl="Dien je eigen storingsmelding in en volg deze."}
  page /facilities/my-reports title="My facility reports"@{nl="Mijn storingsmeldingen"}
   require authenticated
   card "Own fault intake"@{nl="Eigen storing melden"}
    form report
   card "Own report outcomes"@{nl="Eigen meldingsresultaten"}
    table Repair as report where report.reporter==actor columns=title,description,state,due,completion filter=severity,state defaults={severity=preferences.severity}
