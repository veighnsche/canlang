app NominalFieldReuse
use std {DeliveryResult as Report,IncomingEmail}
use std {EmailV1 as Mail} from=deployment.mail
Given
 Entry {state:Report.status label="Delivery status",notification:delivery(Mail.send)?}
 policy Entry read=members fields=state,notification.status
 derive copy(value:Report.status):Report.status = value
 derive delivery_state(entry:Entry):Report.status? = entry.notification?.status
 derive received_copy(value:IncomingEmail.received):datetime = value
When
 scenario accept(state:Report.status) -> bool by=members
  do return true
 scenario received_equal(received:IncomingEmail.received) -> bool by=members
  do return received==datetime("2026-10-01T00:00:00Z")
Then
