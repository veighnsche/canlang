app PrivateSources
Given
 P {v:int}
 C in P {v:int}
 D {w:int}
 policy P read=members fields=v
 policy C read=members fields=parent
 policy D read=members fields=w
When
 crud P by=members fields=v
 crud C by=members fields=parent,v
 scenario go_or(p:P,n:int,m:int) -> int by=members
  do
   let c=first(p.C as c where c.v==n order=c.id)
   require c==null or c.v==m
   create D {w=n} as d
   return 1
Then
