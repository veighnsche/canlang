app ConjSources
Given
 P {v:int}
 C in P {v:int,role:text,tag:text}
 D {w:int}
 policy P read=members fields=v
 policy C read=members fields=parent,v,role,tag
 policy D read=members fields=w
When
 crud P by=members fields=v
 crud C by=members fields=parent,v,role,tag
 scenario go_conj(p:P,n:int,r:text) -> int by=members
  do
   let c=first(p.C as c where c.v==n and c.role==r order=c.id)
   require c!=null
   create D {w=n} as d
   return 1
 scenario go_conj3(p:P,n:int,r:text,t:text) -> int by=members
  do
   let c=first(p.C as c where c.v==n and c.role==r and c.tag==t order=c.id)
   require c!=null
   create D {w=n} as d
   return 1
 scenario go_conj_branch(p:P,n:int,r:text,m:int) -> int by=members
  do
   let c=first(p.C as c where c.v==n and c.role==r order=c.id)
   if c==null
    create D {w=n} as d
   else
    set c {v=m}
   set p {v=m}
   require m==0
   return 1
Then
